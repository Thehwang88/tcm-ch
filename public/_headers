/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://cdn-cookieyes.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com https://td.doubleclick.net; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://log.cookieyes.com https://directus.cookieyes.com; form-action 'self'

# Home: always revalidate so returning visitors never get a stale cached home after the SPA->Astro cutover.
/
  Cache-Control: no-cache

# Non-hashed CSS/JS change often (unlike content-hashed /_astro/*), so revalidate
# every load — ETag still yields cheap 304s, but edits show on a normal refresh
# instead of being stuck behind the default 4h browser cache.
/home.css
  Cache-Control: no-cache
/header.css
  Cache-Control: no-cache
/footer.css
  Cache-Control: no-cache
/home.js
  Cache-Control: no-cache
/header.js
  Cache-Control: no-cache
/styles/tokens.css
  Cache-Control: no-cache

# Preview-Deploys (*.pages.dev) nicht indexieren
https://:project.pages.dev/*
  X-Robots-Tag: noindex
