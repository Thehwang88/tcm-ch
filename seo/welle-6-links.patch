line></svg> Tuina Massage</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/tennisarm/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Tennisarm &amp; Golferarm mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Tennisarm &amp; Golferarm</div><div class="svc-tagline">Schmerz am Ellbogen, auch Mausarm</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/sehnenscheidenentzuendung/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Sehnenscheidenentzündung mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Sehnenscheidenentzündung</div><div class="svc-tagline">Überlastete Sehnen an Arm und Hand</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/nackenschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-p