lass="city-card location-card" onclick="event.preventDefault(); nav('standort','rorschach')" style="cursor:pointer"><span class="location-plz">9400</span><div class="location-city">Rorschach</div><div class="location-desc">Bodenseeregion</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/wil/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','wil')" style="cursor:pointer"><span class="location-plz">9500</span><div class="location-city">Wil</div><div class="location-desc">Fürstenland</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/zuerich-bellevue/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','zuerich-bellevue')" style="cursor:pointer"><span class="location-plz" style="font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--blue-dark)">In Vorbereitung</span><div class="location-city">Zürich City</div><div class="location-desc">Neuer Standort im Zentrum</div><span class="location-link">Standort ansehen →</span></a><a href="/standorte/basel/" class="city-card location-card" style="cursor:pointer"><span class="location-plz">4051</span><div class="location-city">Basel</div><div class="location-desc">Steinenvorstadt 73, mitten in der Innenstadt.</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/luzern/" class="city-card location-card" style="cursor:pointer"><span class="location-plz" style="font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--blue-dark)">Eröffnung 2027</span><div class="location-city">Luzern</div><div class="location-desc">Zentralschweiz · Warteliste offen</div><span class="location-link">Akupunktur Luzern →</span></a></div></div></section></div> <div id="symptom-recommended-therapies"><section class="also-for-section"><div class="wrap"> <div class="section-label">Häufig eingesetzte Methoden</div> <h2 class="section-title">Diese Behandlungen helfen <em>bei Bandscheibenvorfall</em></h2> <div class="sx-chips" style="margin-top:20px;gap:10px"><button class="sx-chip-link" onclick="nav('therapie','akupunktur')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"></line><path d="M9.5 5l2.5-3 2.5 3"></path><circle cx="12" cy="14.5" r="2.2"></circle></svg> Akupunktur</button><button class="sx-chip-link" onclick="nav('therapie','schroepfen')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9a5 5 0 0 1 10 0v1a5 5 0 0 1-10 0V9z"></path><line x1="12" y1="15" x2="12" y2="20"></line><line x1="9.5" y1="20" x2="14.5" y2="20"></line></svg> Schröpfen</button><button class="sx-chip-link" onclick="nav('therapie','tuina')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12a4.5 4.5 0 0 1 8 0v1.5a4.5 4.5 0 0 1-8 0V12z"></path><path d="M5.5 14.5c0 3.5 3 6.5 6.5 6.5s6.5-3 6.5-6.5"></path><line x1="12" y1="2" x2="12" y2="7.5"></line></svg> Tuina Massage</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/ischias/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-f7f113048735.webp" alt="Ischias mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Ischias</div><div class="svc-tagline">Wenn der Schmerz vom Rücken ins Bein zieht</div><