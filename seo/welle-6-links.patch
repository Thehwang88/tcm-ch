.preventDefault(); nav('standort','zuerich-bellevue')" style="cursor:pointer"><span class="location-plz" style="font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--blue-dark)">In Vorbereitung</span><div class="location-city">Zürich City</div><div class="location-desc">Neuer Standort im Zentrum</div><span class="location-link">Standort ansehen →</span></a><a href="/standorte/basel/" class="city-card location-card" style="cursor:pointer"><span class="location-plz">4051</span><div class="location-city">Basel</div><div class="location-desc">Steinenvorstadt 73, mitten in der Innenstadt.</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/luzern/" class="city-card location-card" style="cursor:pointer"><span class="location-plz" style="font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--blue-dark)">Eröffnung 2027</span><div class="location-city">Luzern</div><div class="location-desc">Zentralschweiz · Warteliste offen</div><span class="location-link">Akupunktur Luzern →</span></a></div></div></section></div> <div id="symptom-recommended-therapies"><section class="also-for-section"><div class="wrap"> <div class="section-label">Häufig eingesetzte Methoden</div> <h2 class="section-title">Diese Behandlungen helfen <em>bei Nervenschmerzen</em></h2> <div class="sx-chips" style="margin-top:20px;gap:10px"><button class="sx-chip-link" onclick="nav('therapie','akupunktur')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"></line><path d="M9.5 5l2.5-3 2.5 3"></path><circle cx="12" cy="14.5" r="2.2"></circle></svg> Akupunktur</button><button class="sx-chip-link" onclick="nav('therapie','elektroakupunktur')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4.5 13H11.5L11 22L19.5 11H12.5L13 2z"></path></svg> Elektroakupunktur</button><button class="sx-chip-link" onclick="nav('therapie','moxibustion')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c0 0-5 4.5-5 9a5 5 0 0 0 10 0c0-4.5-5-9-5-9z"></path><line x1="12" y1="11" x2="12" y2="14.5" stroke-width="1.5"></line></svg> Moxibustion</button><button class="sx-chip-link" onclick="nav('therapie','kraeutertherapie')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"></path><path d="M12 12C12 7.5 7.5 4 3.5 4c0 4.5 3.5 8 8.5 8z"></path><path d="M12 12c0-4.5 4.5-8 8.5-8c0 4.5-3.5 8-8.5 8z"></path></svg> Kräutertherapie</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/polyneuropathie/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-a8a0f2e64199.webp" alt="Polyneuropathie mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Polyneuropathie</div><div class="svc-tagline">Brennende Füsse und Kribbeln lindern</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/trigeminusneuralgie/" class="svc-card reveal"><div class="svc-photo-