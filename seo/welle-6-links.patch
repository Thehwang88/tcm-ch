ht="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9a5 5 0 0 1 10 0v1a5 5 0 0 1-10 0V9z"></path><line x1="12" y1="15" x2="12" y2="20"></line><line x1="9.5" y1="20" x2="14.5" y2="20"></line></svg> Schröpfen</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/tinnitus/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-a8a0f2e64199.webp" alt="Tinnitus mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Tinnitus</div><div class="svc-tagline">Ohrgeräusche und ihre Begleiter</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/hoersturz/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Hörsturz mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Hörsturz</div><div class="svc-tagline">Nach der akuten Phase begleiten</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/nackenschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-fce33d67fc98.webp" alt="Nackenschmerzen mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Nackenschmerzen</div><div class="svc-tagline">Verspannungen lösen, Beweglichkeit zurückgewinnen</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/migraene/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Migräne mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Migräne</div><div class="svc-tagline">Attacken mit Übelkeit und Lichtempfindlichkeit</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/uebelkeit/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-fce33d67fc98.webp" alt="Übelkeit mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Übelkeit</di