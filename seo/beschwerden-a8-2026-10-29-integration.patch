s="city-card location-card" style="cursor:pointer"><span class="location-plz" style="font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--blue-dark)">Eröffnung 2027</span><div class="location-city">Luzern</div><div class="location-desc">Zentralschweiz · Warteliste offen</div><span class="location-link">Akupunktur Luzern →</span></a></div></div></section></div> <div id="symptom-recommended-therapies"><section class="also-for-section"><div class="wrap"> <div class="section-label">Häufig eingesetzte Methoden</div> <h2 class="section-title">Diese Behandlungen helfen <em>bei PCOS</em></h2> <div class="sx-chips" style="margin-top:20px;gap:10px"><button class="sx-chip-link" onclick="nav('therapie','akupunktur')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"></line><path d="M9.5 5l2.5-3 2.5 3"></path><circle cx="12" cy="14.5" r="2.2"></circle></svg> Akupunktur</button><button class="sx-chip-link" onclick="nav('therapie','kraeutertherapie')"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"></path><path d="M12 12C12 7.5 7.5 4 3.5 4c0 4.5 3.5 8 8.5 8z"></path><path d="M12 12c0-4.5 4.5-8 8.5-8c0 4.5-3.5 8-8.5 8z"></path></svg> Kräutertherapie</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/kinderwunsch/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-778d4dd19d39.webp" alt="Kinderwunsch mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit: