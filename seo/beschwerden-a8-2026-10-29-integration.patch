p="round" stroke-linejoin="round"><path d="M7 9a5 5 0 0 1 10 0v1a5 5 0 0 1-10 0V9z"></path><line x1="12" y1="15" x2="12" y2="20"></line><line x1="9.5" y1="20" x2="14.5" y2="20"></line></svg> Schröpfen</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/schulterschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-49abc5b4795f.webp" alt="Schulterschmerzen mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Schulterschmerzen</div><div class="svc-tagline">Der breitere Blick auf die schmerzende Schulter</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/frozen-shoulder/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-49abc5b4795f.webp" alt="Frozen Shoulder mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Frozen Shoulder</div><div class="svc-tagline">Wenn die Schulter zunehmend einsteift</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/schleimbeutelentzuendung/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-778d4dd19d39.webp" alt="Schleimbeutelentzündung mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Schleimbeutelentzündung</div><div class="svc-tagline">Entzündung unter dem Schulterdach beruhigen</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/sehnenscheidenentzuendung/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Sehnenscheidenentzündung mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Sehnenscheidenentzündung</div><div class="svc-tagline">Überlastete Sehnen an Arm und Hand</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/nackenschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-fce33d67fc98.webp" alt="Nackenschmerzen mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Nackenschmerzen</div><div class="svc-tagline">Verspannungen, die in die Schulter ausstrahlen</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a></div></div></section></div> <div id="symptom-fallback-cta"><section class="fallback-cta-section"><div class="wrap"><div class="fallback-cta-inner"> <div class="fallback-cta-text"> <h3>Nicht sicher, was du brauchst?</h3> <p>Beschreibe kurz deine Situation, wir empfehlen dir die passende Therapie und Praxis.</p> </div> <div class="fallback-cta-btns"> <a href="https://wa.me/41775236122" class="btn-primary" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;flex-shrink:0"><path d="M13 2L4.5 13H11.5L11 22L19.5 11H12.5L13 2z"></path></svg>Per WhatsApp</a>  </div> </div></div></section></div> <section class="section" style="background:#fff;padding:8px 0 40px"><div class="wrap" style="max-width:820px"><p class="section-sub" style="margin:0">Wohnst du in der Region St. Gallen? Wir behandeln bei <a href="/standorte/st-gallen/">TCM St. Gallen</a> mit Akupunktur und Tuina.</p><p>Wohnst du in Kreuzlingen, Bottighofen oder Münsterlingen, ist die Praxis an der Romanshornerstrasse am nächsten: <a href="/standorte/kreuzlingen/">Akupunktur Kreuzlingen</a>.</p><p>Im Thurgau behandeln wir an der Rheinstrasse 25 in Frauenfeld, kurze Wege aus Weinfelden, Aadorf und Matzingen: <a href="/standorte/frauenfeld/">TCM Frauenfeld</a>.</p><p>Wohnst du zwischen Wil und Uzwil, ist unsere Praxis an der Oberen Bahnhofstrasse die kürzeste Anfahrt: <a href="/standorte/wil/">Akupunktur Wil</a>.</p><p>In Winterthur behandeln wir an der Marktgasse 78 mitten in der Altstadt,