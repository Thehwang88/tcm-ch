join="round"><line x1="12" y1="2" x2="12" y2="22"></line><path d="M9.5 5l2.5-3 2.5 3"></path><circle cx="12" cy="14.5" r="2.2"></circle></svg> Akupunktur</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/neurodermitis/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-f7f113048735.webp" alt="Neurodermitis mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Neurodermitis</div><div class="svc-tagline">Juckreiz und trockene Haut von innen beruhigen</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/akne/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-fce33d67fc98.webp" alt="Akne mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Akne</div><div class="svc-tagline">Unreine Haut von innen behandeln</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/stress-burnout/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-778d4dd19d39.webp" alt="Stress &amp; Burnout mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Stress &amp; Burnout</div><div class="svc-tagline">Wenn Anspannung zum Dauerzustand wird</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/arthrose/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-49abc5b4795f.webp" alt="Arthrose mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Arthrose</div><div class="svc-tagline">Gelenkbeschwerden begleitend entlasten</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a></div></div></section></div> <div id="symptom-fallback-cta"><section class="fallback-cta-section"><div class="wrap"><div class="fallback-cta-inner"> <div class="fallback-cta-text"> <h3>Nicht sicher, was du brauchst?</h3> <p>Beschreibe kurz deine Situation, wir empfehlen dir die passende Therapie und Praxis.</p> </div> <div class="fallback-cta-btns"> <a href="https://wa.me/41775236122" class="btn-primary" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" 