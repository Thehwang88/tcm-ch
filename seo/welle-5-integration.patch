7.5 7.5 4 3.5 4c0 4.5 3.5 8 8.5 8z"></path><path d="M12 12c0-4.5 4.5-8 8.5-8c0 4.5-3.5 8-8.5 8z"></path></svg></span> <div><div style="font-size:13.5px;font-weight:600;color:var(--black)">Kräutertherapie</div> <div style="font-size:12px;color:var(--muted)">Individuelle Kräuterformeln nach TCM-Diagnose</div></div> </div><div class="sidebar-row" style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)" onclick="nav('therapie','moxibustion')"> <span style="font-size:18px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c0 0-5 4.5-5 9a5 5 0 0 0 10 0c0-4.5-5-9-5-9z"></path><line x1="12" y1="11" x2="12" y2="14.5" stroke-width="1.5"></line></svg></span> <div><div style="font-size:13.5px;font-weight:600;color:var(--black)">Moxibustion</div> <div style="font-size:12px;color:var(--muted)">Wärmetherapie mit Beifuss, oft ergänzend eingesetzt</div></div> </div><div class="sidebar-row" style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)" onclick="nav('therapie','elektroakupunktur')"> <span style="font-size:18px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4.5 13H11.5L11 22L19.5 11H12.5L13 2z"></path></svg></span> <div><div style="font-size:13.5px;font-weight:600;color:var(--black)">Elektroakupunktur</div> <div style="font-size:12px;color:var(--muted)">Verstärkte Akupunktur durch elektrische Impulse, besonders bei Schmerzen</div></div> </div><div class="sidebar-row" style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)" onclick="nav('therapie','akupressur')"> <span style="font-size:18px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" strok