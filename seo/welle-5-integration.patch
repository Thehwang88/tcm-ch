('standort','winterthur-marktgasse')" style="cursor:pointer"><span class="location-plz">8400</span><div class="location-city">Winterthur Marktgasse</div><div class="location-desc">Altstadt</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/volketswil/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','volketswil')" style="cursor:pointer"><span class="location-plz">8604</span><div class="location-city">Volketswil</div><div class="location-desc">Zürich Glattal</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/st-gallen/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','st-gallen')" style="cursor:pointer"><span class="location-plz">9000</span><div class="location-city">St. Gallen</div><div class="location-desc">Ostschweiz</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/rorschach/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','rorschach')" style="cursor:pointer"><span class="location-plz">9400</span><div class="location-city">Rorschach</div><div class="location-desc">Bodenseeregion</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/wil/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','wil')" style="cursor:pointer"><span class="location-plz">9500</span><div class="location-city">Wil</div><div class="location-desc">Fürstenland</div><span class="location-link">Termin prüfen →</span></a><a href="/standorte/zuerich-bellevue/" class="city-card location-card" onclick="event.preventDefault(); nav('standort','zuerich-bellevue')" style="cursor:pointer"><span class="location-plz" style="font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--blue-dark)">In Vorbereitung</span><div class="location-city">Zürich City</div><div class="location-desc">Neuer Standort im Zentrum</div><span class="location-link">Sta