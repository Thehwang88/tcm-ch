-5-9z"></path><line x1="12" y1="11" x2="12" y2="14.5" stroke-width="1.5"></line></svg> Moxibustion</button></div> </div></section></div> <div id="symptom-related-section"><section style="background:#fff;padding:56px 0"><div class="wrap"><div class="section-label">Ähnliche Beschwerden</div><h2 class="section-title">Weitere Beschwerden</h2><div class="card-grid reveal"><a href="/beschwerden/hueftschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Hüftschmerzen mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Hüftschmerzen</div><div class="svc-tagline">Leisten- und Hüftschmerz konservativ</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/rueckenschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-f7f113048735.webp" alt="Rückenschmerzen mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Rückenschmerzen</div><div class="svc-tagline">Häufig bei Verspannungen, Bandscheibenproblemen und chronischen Beschwerden</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/nackenschmerzen/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-778d4dd19d39.webp" alt="Nackenschmerzen mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Nackenschmerzen</div><div class="svc-tagline">Verspannungen und Blockaden im Schulter-Nacken-Bereich</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/arthrose/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-5db981915fc8.webp" alt="Arthrose mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Arthrose</div><div class="svc-tagline">Gelenkverschleiss mit Schmerzen und Steifheit</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a class="content-card" href="/beschwerden/spinalkanalstenose/" style="text-decoration:none;color:inherit;cursor:pointer"> <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"></line><path d="M9 6h6"></path><path d="M9 10h6"></path><path d="M9 14h6"></path><path d="M9 18h6"></path></svg></div> <div class="card-name">Spinalkanalstenose</div> <div class="card-hint">Schwere Beine beim Gehen, konservativ begleiten</div> <div class="card-cta">Mehr erfahren <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </a><a href="/beschwerden/piriformis-syndrom/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-f7f113048735.webp" alt="Piriformis-Syndrom mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">Piriformis-Syndrom</div><div class="svc-tagline">Gesässschmerz mit Ausstrahlung ins Bein</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a><a href="/beschwerden/isg-blockade/" class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src="/images/img-f7f113048735.webp" alt="ISG-Blockade mit TCM behandeln | TCM.ch" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">ISG-Blockade</div><div class="svc-tagline">Tiefsitzender Kreuzschmerz, einseitig</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a></div></div></section></div> <div id="symptom-fallback-cta"><section class="fallback-cta-section"><div class="wrap"><div class="fallback-cta-inner"> <div class="fallback-cta-text"> <h3>Nicht sicher, was du brauchst?</h3> <p>Beschreibe kurz deine Situation, wir empfehlen dir die passende Therapie und Praxis.</p> </div> <div class="fallback-cta-btns"> <a href="https://wa.me/41775236122" class="btn-primary" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;flex-shrink:0"><path d="M13 2L4.5 13H11.5L11 22L19.5 11H12.5L13 2z"></path></svg>Per WhatsApp</a>  </div> </div></div></section></div> <section class="section" style="background:#fff;padding:8px 0 40px"><div class="wrap" style="max-width:820px"><p class="section-sub" style="margin:0">Für Ischias-Beschwerden in der Ostschweiz findest du <a href="/standorte/st-gallen/">TCM St. Gallen</a> zentral beim Bahnhof.</p><p>Rund um den Bodensee ist Kreuzlingen unser Hauptstandort, auch für Patient:innen aus Konstanz und Tägerwilen: <a href="/standorte/kreuzlingen/">TCM Kreuzlingen</a>.</p><p>Aus Weinfelden, Islikon oder Aadorf bist du in wenigen Minuten bei uns in der Kantonshauptstadt: <a href="/standorte/frauenfeld/">Akupunktur Frauenfeld</a>.</p><p>Im Fürstenland und rund um Wil findest du uns an der Oberen Bahnhofstrasse 35: <a href="/standorte/wil/">TCM Wil</a>.</p><p>Aus Winterthur und dem Tösstal erreichst du unsere Praxis an der Marktgasse in wenigen Minuten: <a href="/standorte/winterthur-marktgasse/">Akupunktur Winterthur</a>.</p></div></section> <section class="section contact-section-inline" style="background:var(--surface)"> <div class="wrap"> <div class="contact-inline-grid"> <div class="reveal"> <div class="section-label">Passende Hilfe finden</div> <h2 class="section-title">Jetzt passende <em>Hilfe anfragen.</em></h2> <p class="section-sub" style="margin-bottom:0">Kurz schildern, wir helfen dir beim passenden nächsten Schritt.</p> <div class="intake-trust-row"> <div class="intake-trust-item"><spa