---
// Responsives Bild für die Visual Library. String = einfaches <img> (SVG-Platzhalter),
// Objekt = <picture> mit AVIF/WebP-srcset + Fallback (finale Retina-Assets).
import type { VisualImage } from '../../data/visuals';

interface Props {
  image: VisualImage;
  alt: string;
  /** Intrinsische Grösse für String-Assets (Layout-Shift-Schutz). */
  width: number;
  height: number;
  loading?: 'eager' | 'lazy';
  /** sizes-Attribut, wenn srcsets vorhanden sind. */
  sizes?: string;
}
const { image, alt, width, height, loading = 'eager', sizes = '(max-width: 900px) 100vw, 40vw' } = Astro.props;
const simple = typeof image === 'string';
---
{simple ? (
  <img src={image} alt={alt} width={width} height={height} loading={loading} decoding="async" />
) : (
  <picture>
    {image.avif && <source type="image/avif" srcset={image.avif} sizes={image.sizes ?? sizes} />}
    {image.webp && <source type="image/webp" srcset={image.webp} sizes={image.sizes ?? sizes} />}
    <img
      src={image.src}
      srcset={image.srcset}
      sizes={image.srcset ? (image.sizes ?? sizes) : undefined}
      alt={alt}
      width={image.width}
      height={image.height}
      loading={loading}
      decoding="async"
    />
  </picture>
)}
