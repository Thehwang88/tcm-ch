---
// Single DE header used by EVERY German page (home + all LayoutDe subpages + longevity).
// Markup = the live SPA DE header verbatim: #mainNav (DE desktop nav via nav()) + the full
// rich #siteDrawer burger (grouped, DE sub-items) + #drawerOverlay. Styling lives in
// /header.css (subpages) or /home.css (home); behaviour in /header.js (nav + drawer + CTA).
// The EN header (Header.astro) is used ONLY by Layout.astro for /en/ pages.
// «Für Fachpersonen» (Desktop-Mega-Panel + Drawer-Akkordeons) wird aus PRO_NAV generiert
// (src/data/pro/architecture.ts): Kategorien statt Einzelseiten; geplante Routen = «bald», ohne Link.
import header from '../data/header.html?raw';
import { PRO_NAV, PRO_NAV_OVERVIEW, type NavItem } from '../data/pro/architecture';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const arrow = '<span class="drw-link-arrow"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>';
const chevron = '<div class="drw-acc-chevron"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"></polyline></svg></div>';

const deskItem = (i: NavItem) => i.planned
  ? `<span class="pro-soon" aria-disabled="true">${esc(i.label)} <em>bald</em></span>`
  : `<a href="${i.href}"${i.accent ? ' class="pro-accent"' : ''}>${esc(i.label)}${i.accent ? ' <span aria-hidden="true">→</span>' : ''}</a>`;
const desktop =
  `<div class="nav-more-group nav-more-group--pro" role="group" aria-labelledby="navProLabel">` +
  `<div class="nav-more-label" id="navProLabel">Für Fachpersonen</div>` +
  `<a class="pro-overview" href="${PRO_NAV_OVERVIEW.href}">${PRO_NAV_OVERVIEW.label}<span class="nav-more-desc">Alle Bereiche für TCM-Fachpersonen</span></a>` +
  `<div class="pro-grid">` +
  PRO_NAV.map((g) => `<div class="pro-col" role="group" aria-labelledby="navPro-${g.id}"><div class="pro-col-label" id="navPro-${g.id}">${esc(g.label)}</div>${g.items.map(deskItem).join('')}</div>`).join('') +
  `</div></div>`;

const drwItem = (i: NavItem) => i.planned
  ? `<li><span class="drw-pro-soon" aria-disabled="true">${esc(i.label)} <em>bald</em></span></li>`
  : `<li><a href="${i.href}" onclick="drawerClose()"${i.accent ? ' class="drw-pro-accent"' : ''}>${esc(i.label)}${arrow}</a></li>`;
const drawer =
  `<div class="drw-group" role="group" aria-labelledby="drwGrpPro"><div class="drw-group-label" id="drwGrpPro">Für Fachpersonen</div>` +
  `<div class="drw-section"><ul class="drw-plain-links"><li><a href="${PRO_NAV_OVERVIEW.href}" onclick="drawerClose()">Übersicht Fachpersonen${arrow}</a></li></ul></div>` +
  PRO_NAV.map((g) =>
    `<div class="drw-section"><button class="drw-acc-btn" onclick="drawerToggle(this)" aria-expanded="false" aria-controls="drwPro-${g.id}">` +
    `<div class="drw-acc-btn-inner"><span class="drw-acc-label">${esc(g.label)}</span></div>${chevron}</button>` +
    `<div class="drw-acc-body" id="drwPro-${g.id}"><ul class="drw-links">${g.items.map(drwItem).join('')}</ul></div></div>`).join('') +
  `</div>`;

// Preserve the complete legacy desktop drawer. Mobile gets a separate short
// patient-only view within the same #siteDrawer; all legacy hrefs/routes remain.
// Use ordinary anchors (not SPA onclick interception) for robust navigation.
const patientWa = header.match(/<a href="(https:\/\/wa\.me\/[^"]+)" target="_blank" rel="noopener" class="drw-cta-secondary drw-cta-wa"/)?.[1];
if (!patientWa) throw new Error('DE header: original WhatsApp destination not found');
const patientDrawer = `
<div class="drw-body drw-body--patient" aria-label="Patientennavigation">
  <div class="patient-drawer-nav" role="navigation" aria-label="Wichtige Bereiche für Patientinnen und Patienten">
    <div class="patient-drawer-kicker">DEINE BEHANDLUNG</div>
    <details class="patient-drawer-locations">
      <summary>Standorte &amp; Kliniken<span class="patient-drawer-chevron" aria-hidden="true">⌄</span></summary>
      <div class="patient-drawer-locations-inner">
        <div class="patient-drawer-subheading">ZÜRICH</div>
        <a href="/akupunktur-tcm-zuerich/" onclick="drawerClose()">Alle Zürcher Praxen</a>
        <a href="/standorte/zuerich-bahnhofstrasse/" onclick="drawerClose()">Bahnhofstrasse</a>
        <a href="/standorte/zuerich-oerlikon/" onclick="drawerClose()">Oerlikon</a>
        <a href="/standorte/zuerich-hoengg/" onclick="drawerClose()">Höngg</a>
        <div class="patient-drawer-subheading patient-drawer-subheading--other">ST. GALLEN</div>
        <a href="/standorte/st-gallen/" onclick="drawerClose()">St. Gallen · Klinik</a>
        <div class="patient-drawer-subheading patient-drawer-subheading--other">WEITERE STANDORTE</div>
        <a href="https://www.hwang.ch/standorte/winterthur" target="_blank" rel="noopener" onclick="drawerClose()">Winterthur · Praxis Hwang</a>
        <a href="/standorte/frauenfeld/" onclick="drawerClose()">Frauenfeld</a>
        <a href="/standorte/kreuzlingen/" onclick="drawerClose()">Kreuzlingen</a>
        <a href="/standorte/" class="patient-drawer-all" onclick="drawerClose()">Alle Standorte ansehen <span aria-hidden="true">→</span></a>
      </div>
    </details>
    <a class="patient-drawer-header-duplicate" href="/beschwerden/" onclick="drawerClose()">Beschwerden<span aria-hidden="true">›</span></a>
    <a class="patient-drawer-header-duplicate" href="/therapien/" onclick="drawerClose()">Therapien<span aria-hidden="true">›</span></a>
    <a href="/krankenkassen/" onclick="drawerClose()">Krankenkasse &amp; Kosten<span aria-hidden="true">›</span></a>
    <a href="/ueber-uns/" onclick="drawerClose()">Über TCM.ch<span aria-hidden="true">›</span></a>
        <div class="patient-drawer-desktop-extras" role="group" aria-label="Weitere Themen">
      <div class="patient-drawer-kicker">WEITERE THEMEN</div>
      <a href="/haut/" onclick="drawerClose()">Haut &amp; Gesicht<span aria-hidden="true">›</span></a>
      <a href="/longevity/" onclick="drawerClose()">Longevity Schweiz<span aria-hidden="true">›</span></a>
      <a href="/ergebnisse/" onclick="drawerClose()">Ergebnisse &amp; Transparenz<span aria-hidden="true">›</span></a>
      <a href="/fachpersonen/" onclick="drawerClose()">Für Fachpersonen<span aria-hidden="true">›</span></a>
    </div>
    <a class="patient-drawer-language" href="/en/" hreflang="en" onclick="drawerClose()">English / EN<span aria-hidden="true">↗</span></a>
  </div>
  <div class="drw-group drw-group--cta patient-drawer-actions">
    <div class="drw-cta-grid">
      <button type="button" class="drw-cta-primary" onclick="drawerClose();setTimeout(function(){var btn=document.getElementById('navCtaBtn');if(btn)btn.click();else window.location.href='/kontakt/';},300)">Termin finden</button>
      <div class="drw-cta-row">
        <a href="tel:+41775236122" class="drw-cta-secondary" onclick="drawerClose()">Anrufen</a>
        <a href="${patientWa}" target="_blank" rel="noopener" class="drw-cta-secondary drw-cta-wa" onclick="drawerClose()">WhatsApp</a>
      </div>
    </div>
  </div>
</div>`;
const drawerTail = '  </div> </div>\n<div id="drawerOverlay"';
const source = header.replace('<!--PRO_NAV_DESKTOP-->', desktop).replace('<!--PRO_NAV_DRAWER-->', drawer);
if (source.split('<div class="drw-body">').length !== 2 || source.split(drawerTail).length !== 2) {
  throw new Error('DE header: drawer wrapper changed');
}
const html = source.replace('<div class="drw-body">','<div class="drw-body drw-body--legacy">')
  .replace(drawerTail, '  </div>' + patientDrawer + ' </div>\n<div id="drawerOverlay"');
---
<Fragment set:html={html} />
<!-- Time-limited, global DE patient offer. Keep out of the fixed nav to avoid
     reintroducing a header spacer or affecting nav scroll-hide calculations. -->
<a id="tcm-nov-checkin" class="tcm-nov-checkin" href="/kontakt/" data-open-concern aria-label="Gratis 30-Minuten-Check-in bis 30. November sichern">
  <span><strong>Gratis 30-Min.-Check-in zum Kennenlernen</strong><span class="tcm-nov-checkin-deadline"> · Bis 30. November sichern</span></span>
  <span aria-hidden="true" class="tcm-nov-checkin-arrow">→</span>
</a>
<script is:inline>
(function(){
  var el=document.getElementById('tcm-nov-checkin');
  if(!el)return;
  var now=new Date();
  // Offer ends at the end of 30 November 2026, Swiss local time.
  var swiss=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Zurich',year:'numeric',month:'2-digit',day:'2-digit'}).format(now);
  if(swiss>'2026-11-30'){el.remove();return;}
  document.documentElement.classList.add('tcm-nov-offer-active');
  function position(){
    var nav=document.getElementById('mainNav');
    if(nav)el.style.top=Math.round(nav.getBoundingClientRect().bottom)+'px';
  }
  position();
  window.addEventListener('scroll',position,{passive:true});
  window.addEventListener('resize',position,{passive:true});
})();
</script>
<style is:global>
  .tcm-nov-checkin{
    position:fixed;left:0;right:0;top:68px;z-index:899;
    display:flex;align-items:center;justify-content:center;gap:12px;
    box-sizing:border-box;min-height:38px;padding:8px 18px;
    background:#EAF5FC;color:#142D40;text-decoration:none;
    border-bottom:1px solid #D5E8F4;font:600 13px/1.3 Figtree,Arial,sans-serif;
    text-align:center;transition:transform .2s ease,opacity .2s ease;
  }
  .tcm-nov-checkin strong{font-weight:800}
  .tcm-nov-checkin-arrow{font-size:19px;line-height:1}
  .tcm-nov-checkin:hover{background:#DFF0FA}
  .tcm-nov-checkin:focus-visible{outline:3px solid #1769B1;outline-offset:-3px}
  html.tcm-nov-offer-active body > main,
  html.tcm-nov-offer-active body > #home-content{padding-top:calc(var(--header-h,68px) + 38px)!important}
  @media(max-width:900px){
    .tcm-nov-checkin{min-height:38px;padding:7px 12px;font-size:12px}
    html.tcm-nov-offer-active body > main,
    html.tcm-nov-offer-active body > #home-content{padding-top:calc(60px + 38px)!important}
    body.tcm-nav-scrolled-away .tcm-nov-checkin{transform:translateY(-150%);opacity:0;pointer-events:none}
  }
  @media(max-width:370px){
    .tcm-nov-checkin{font-size:11px;gap:6px}
    .tcm-nov-checkin-deadline{font-size:10px}
  }
  @media(prefers-reduced-motion:reduce){.tcm-nov-checkin{transition:none}}
</style>

<style is:global>
  /* Shared DE mobile navigation: 68 → 64px, keeping logo proportions
     and all phone/menu touch targets unchanged (>=44px). */
  @media (max-width:768px) {
    :root { --header-h:64px; }
    nav#mainNav { height:64px; }
  }

  /* One streamlined drawer on phone and desktop. "Mehr" is redundant with
     the burger: the original mega-panel markup remains but is not presented. */
  #siteDrawer .drw-body--legacy{display:none!important}
  #siteDrawer .drw-body--patient{
    display:flex!important;flex:1 1 auto;min-height:0;flex-direction:column;
    overflow-y:auto!important;overscroll-behavior:contain;
    padding:0!important;background:#fff;
  }
  #mainNav .nav-more-li{display:none!important}
  #siteDrawer .patient-drawer-desktop-extras{display:none}
  @media(max-width:768px){
    #siteDrawer .drw-body--patient{
      display:flex!important;flex:1 1 auto;min-height:0;flex-direction:column;
      overflow-y:auto!important;overscroll-behavior:contain;
      padding:0!important;background:#fff;
    }
    #siteDrawer .patient-drawer-nav{display:block;padding:24px 20px 12px;flex:0 0 auto}
    #siteDrawer .patient-drawer-kicker,
    #siteDrawer .patient-drawer-subheading{
      color:#707472;font-weight:800;font-size:11px;letter-spacing:.13em;
    }
    #siteDrawer .patient-drawer-kicker{margin:2px 0 15px}
    #siteDrawer .patient-drawer-nav > a,
    #siteDrawer .patient-drawer-locations > summary{
      box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;
      width:100%;min-height:54px;padding:14px 0;
      border:0;border-bottom:1px solid #E8E6E3;
      background:transparent;color:#171B1A!important;
      text-decoration:none;font-family:var(--font-sans);font-weight:750;font-size:17px;
      cursor:pointer;list-style:none;
    }
    #siteDrawer .patient-drawer-locations > summary::-webkit-details-marker{display:none}
    #siteDrawer .patient-drawer-nav > a > span,
    #siteDrawer .patient-drawer-chevron{color:#707472;font-size:21px;font-weight:400}
    #siteDrawer .patient-drawer-locations[open] .patient-drawer-chevron{transform:rotate(180deg)}
    #siteDrawer .patient-drawer-locations-inner{
      padding:13px 14px 17px;border-bottom:1px solid #E8E6E3;
      background:#F4F2EF;border-radius:0 0 12px 12px;
    }
    #siteDrawer .patient-drawer-subheading{margin:9px 0 7px}
    #siteDrawer .patient-drawer-subheading--other{margin-top:21px}
    #siteDrawer .patient-drawer-locations-inner > a{
      display:flex;align-items:center;min-height:44px;padding:7px 2px;
      font-size:15px;font-weight:600;line-height:1.35;color:#353938!important;
      text-decoration:none;border:0;
    }
    #siteDrawer .patient-drawer-locations-inner > a.patient-drawer-all{
      color:#171B1A!important;font-weight:800;gap:7px;
    }
    #siteDrawer .patient-drawer-language{
      margin-top:8px;font-size:13px!important;font-weight:650!important;
      min-height:44px!important;color:#505453!important;border-bottom:0!important;
    }
    #siteDrawer .patient-drawer-actions{
      position:sticky;bottom:0;margin-top:auto;z-index:2;
      padding:12px 16px calc(12px + env(safe-area-inset-bottom));
      background:#fff;border-top:1px solid #D7D4D0;box-shadow:0 -8px 20px rgba(23,27,26,.05);
    }
    #siteDrawer .patient-drawer-actions .drw-cta-primary{
      background:#1769B1!important;border-color:#1769B1!important;
      color:#fff!important;min-height:50px!important;
    }
    #siteDrawer .patient-drawer-actions .drw-cta-primary:hover{
      background:#10558F!important;border-color:#10558F!important;color:#fff!important;
    }
    #siteDrawer .patient-drawer-actions .drw-cta-secondary{
      min-height:44px;border:1px solid #D7D4D0!important;color:#171B1A!important;
      background:#fff!important;
    }
    #siteDrawer .patient-drawer-nav a:focus-visible,
    #siteDrawer .patient-drawer-locations summary:focus-visible{
      outline:3px solid #1769B1;outline-offset:2px;border-radius:4px;
    }
  }

  /* Desktop burger: header already has Beschwerden, Therapien and Wissen.
     Keep the drawer for locations, insurance, About and occasional discovery. */
  @media(min-width:769px){
    #siteDrawer .patient-drawer-nav{display:block;padding:26px 26px 16px}
    #siteDrawer .patient-drawer-kicker,
    #siteDrawer .patient-drawer-subheading{
      color:#707472;font-weight:800;font-size:11px;letter-spacing:.13em;
    }
    #siteDrawer .patient-drawer-kicker{margin:2px 0 13px}
    #siteDrawer .patient-drawer-nav > a,
    #siteDrawer .patient-drawer-locations > summary,
    #siteDrawer .patient-drawer-desktop-extras > a{
      box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;
      min-height:50px;padding:12px 0;width:100%;
      color:#171B1A!important;background:transparent;
      text-decoration:none;font-size:16px;font-weight:700;
      border:0;border-bottom:1px solid #E8E6E3;cursor:pointer;
    }
    #siteDrawer .patient-drawer-locations > summary{list-style:none}
    #siteDrawer .patient-drawer-locations > summary::-webkit-details-marker{display:none}
    #siteDrawer .patient-drawer-header-duplicate{display:none!important}
    #siteDrawer .patient-drawer-nav > a > span,
    #siteDrawer .patient-drawer-desktop-extras > a > span,
    #siteDrawer .patient-drawer-chevron{font-weight:400;color:#707472;font-size:20px}
    #siteDrawer .patient-drawer-locations[open] .patient-drawer-chevron{transform:rotate(180deg)}
    #siteDrawer .patient-drawer-locations-inner{
      padding:13px 16px 17px;background:#F4F2EF;
      border-bottom:1px solid #E8E6E3;border-radius:0 0 12px 12px;
    }
    #siteDrawer .patient-drawer-subheading{margin:9px 0 8px}
    #siteDrawer .patient-drawer-subheading--other{margin-top:19px}
    #siteDrawer .patient-drawer-locations-inner > a{
      display:flex;align-items:center;min-height:40px;padding:7px 2px;
      font-size:14px;font-weight:600;line-height:1.35;
      color:#353938!important;text-decoration:none;
    }
    #siteDrawer .patient-drawer-locations-inner > a.patient-drawer-all{font-weight:800;color:#171B1A!important}
    #siteDrawer .patient-drawer-desktop-extras{display:block;margin-top:22px}
    #siteDrawer .patient-drawer-desktop-extras > a{font-size:14px;min-height:44px}
    #siteDrawer .patient-drawer-language{
      font-size:13px!important;min-height:44px!important;
      color:#505453!important;border-bottom:0!important;
      margin-top:13px;
    }
    #siteDrawer .patient-drawer-actions{
      position:sticky;bottom:0;z-index:2;margin-top:auto;
      background:#fff;border-top:1px solid #D7D4D0;
      padding:14px 20px 18px;box-shadow:0 -8px 20px rgba(23,27,26,.05);
    }
    #siteDrawer .patient-drawer-actions .drw-cta-primary{
      background:#1769B1!important;border-color:#1769B1!important;
      color:#fff!important;min-height:50px!important;
    }
    #siteDrawer .patient-drawer-actions .drw-cta-primary:hover{
      background:#10558F!important;border-color:#10558F!important;color:#fff!important;
    }
    #siteDrawer .patient-drawer-actions .drw-cta-secondary{
      min-height:44px;border:1px solid #D7D4D0!important;
      color:#171B1A!important;background:#fff!important;
    }
    #siteDrawer .patient-drawer-nav a:focus-visible,
    #siteDrawer .patient-drawer-locations summary:focus-visible{
      outline:3px solid #1769B1;outline-offset:2px;border-radius:4px;
    }
  }
</style>

