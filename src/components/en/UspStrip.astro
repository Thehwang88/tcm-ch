---
// Trust strip mirroring the DE Standort UspGrid. Status-aware: no availability claims pre-opening.
const { planned = false, review = false, partner = false } = Astro.props as { planned?: boolean; review?: boolean; partner?: boolean };
const shield = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 11 13 15 9"/></svg>`;
const clock = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
const chat = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;
const items = [
  { icon: shield, title: 'Supplementary insurance',
    sub: review ? 'At the practice we suggest: reimbursement may be available, depending on your policy and the practitioner\'s recognition.' : planned ? 'Once open, or at the partner practice today: reimbursement may be available, depending on your policy and the practitioner\'s recognition.' : 'Reimbursement may be available, depending on your policy, treatment and the practitioner\'s recognition.' },
  { icon: clock, title: planned ? 'Requests already possible' : 'Request an appointment directly',
    sub: review ? 'We suggest a suitable practice nearby.' : planned ? 'We contact you as soon as appointments open.' : partner ? 'TCM.ch coordinates your request with the practice.' : 'By WhatsApp, phone or the form below.' },
  { icon: chat, title: 'No referral needed', sub: 'Contact us in English or German; a personal reply, not a bot.' },
];
---
<section class="ev-usp"><div class="wrap"><div class="ev-usp__grid">
  {items.map((i) => (
    <div class="ev-usp__card">
      <div class="ev-usp__icon"><Fragment set:html={i.icon} /></div>
      <div><p class="ev-usp__title">{i.title}</p><p class="ev-usp__sub">{i.sub}</p></div>
    </div>
  ))}
</div></div></section>
