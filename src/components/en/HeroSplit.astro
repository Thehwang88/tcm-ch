---
// EN V2 split hero: Mint copy panel left, reused DE photo right (mirrors DE .lsr-hero / .sr-hero).
// Variants: 'split' (default, photo), 'home' (taller), 'hub' (compact, no photo).
interface Cta { href: string; label: string; kind?: 'solid' | 'outline' | 'wa'; external?: boolean }
interface Props {
  eyebrow?: string;
  h1: string;                 // may contain <em>
  lead: string;               // may contain <strong>
  sub?: string;
  ctas?: Cta[];
  trust?: string[];
  note?: string;              // may contain <b>
  image?: { src: string; alt: string; caption?: string; width?: number; height?: number };
  crumbs?: { href?: string; label: string }[];
  variant?: 'split' | 'home' | 'hub';
  /** Hero sizing family on spacious desktops (en-v2.css); derived from the route when omitted. */
  family?: 'city' | 'location' | 'hub' | 'detail' | 'editorial';
}
const { eyebrow, h1, lead, sub, ctas = [], trust = [], note, image, crumbs = [], variant = 'split', family } = Astro.props;
const path = Astro.url.pathname;
const heroFamily = family ?? (
  path === '/en/acupuncture-zurich/' ? 'city'
  : /^\/en\/locations\/[^/]+\/$/.test(path) ? 'location'
  : /^\/en\/(locations|therapies|conditions|knowledge|acupuncture-near-me)\/$/.test(path) ? 'hub'
  : /^\/en\/(therapies|conditions)\/[^/]+\/$/.test(path) || path === '/en/health-insurance-acupuncture/' ? 'detail'
  : 'editorial');
const wa = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;
const check = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
---
<section class={`ev-hero ev-hero--${variant}`} data-hero={variant === 'split' ? heroFamily : undefined}>
  <div class="ev-hero__inner">
    <div class="ev-hero__copy">
      {crumbs.length > 0 && (
        <ol class="ev-crumb" aria-label="Breadcrumb">
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      )}
      {eyebrow && <span class="ev-eyebrow">{eyebrow}</span>}
      <h1 set:html={h1} />
      <p class="ev-lead" set:html={lead} />
      {sub && <p class="ev-lead" set:html={sub} />}
      {ctas.length > 0 && (
        <div class="ev-ctas">
          {ctas.map((c) => (
            <a class={`ev-btn ev-btn--${c.kind ?? 'solid'}`} href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
              {c.kind === 'wa' && <Fragment set:html={wa} />}{c.label}
            </a>
          ))}
        </div>
      )}
      {trust.length > 0 && (
        <ul class="ev-trust" role="list">
          {trust.map((t) => <li><Fragment set:html={check} /><span>{t}</span></li>)}
        </ul>
      )}
      {note && <p class="ev-note" set:html={note} />}
    </div>
    {variant !== 'hub' && image && (
      <figure class="ev-hero__media">
        <img src={image.src} alt={image.alt} width={image.width ?? 1600} height={image.height ?? 1200} loading="eager" fetchpriority="high" decoding="async" />
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    )}
  </div>
</section>
