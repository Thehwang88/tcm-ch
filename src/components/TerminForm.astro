---
// Standard-Kontaktformular (/kontakt/, Wissen, Gesundheitsbibliothek, Körpersignale …). Seit 15.10.2026 rendert es
// das gemeinsame Kontaktformular (src/lib/kontakt-form.ts, Client public/kontakt-form.js) mit globaler
// Standortauswahl. Bestehende Verträge bleiben: Endpoint POST /api/anfrage, Turnstile (site.turnstileSitekey),
// Herkunfts-Prefill (Prop → ?von= → Referrer, clientseitig), formular / quelle_detail (+ CARE-CTA-Position),
// typ='termin', Formular-ID #terminform, Sektionsanker #formular und das Conversion-Event form_submit
// {form_id:'terminform', herkunft} — jetzt erst NACH Server-Bestätigung (nie bei Fehlern).
import { site } from '../data/site';
import { renderKontaktForm } from '../lib/kontakt-form';

interface Props {
  prefill?: string;
  standort?: string;
  /** Ältere Props (Überschrift/Intro/Button) bleiben akzeptiert; das gemeinsame Formular hat feste Texte. */
  heading?: string;
  intro?: string;
  submitLabel?: string;
  formular?: string;
  quelleDetail?: string;
}
const { prefill = '', standort = '', formular = '', quelleDetail = '' } = Astro.props;
const card = renderKontaktForm({
  instance: 'terminform', formId: 'terminform', conv: 'form_submit', autoprefill: 'terminform', typ: 'termin',
  anliegen: prefill || undefined, preselectStandort: standort || undefined,
  formular: formular || undefined, quelleDetail: quelleDetail || undefined,
  sitekey: site.turnstileSitekey, headingTag: 'h2',
});
---
<section class="tf-section" id="formular">
  <div class="tf-wrap" set:html={card} />
</section>

<style>
  .tf-section { padding: 48px 0; }
  .tf-wrap { max-width: 40rem; margin: 0 auto; padding: 0 16px; }
</style>
