---
// Mobile-only (≤768px) sticky bottom 3-CTA bar - shared sitewide (rendered once in Footer).
// Layout (matches hwang.ch mobile): full-width green primary on top, two outline
// buttons (WhatsApp + Anrufen) side by side below. Primary carries a gentle brand-green
// glow pulse (disabled under prefers-reduced-motion).
import { site } from '../data/site';
const { lang = 'de' } = Astro.props as { lang?: 'de' | 'en' };
const en = lang === 'en';
const WA = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(en ? 'Hello, I am interested in TCM and would like some quick help choosing the right treatment or clinic. Can you help?' : 'Hallo, ich interessiere mich für TCM und hätte gerne kurz Hilfe bei der passenden Behandlung oder Praxis. Können Sie mir weiterhelfen?')}`;
const TEL = `tel:+${site.whatsapp}`;
---
<div class="scb-bar" role="region" aria-label={en ? 'Contact' : 'Kontakt'}>
  <a class="scb-primary" href={en ? '/en/contact/' : '/kontakt/'}>
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{en ? '\nRequest an appointment\n' : '\nTermin anfragen\n'}</a>
  <div class="scb-row">
    <a class="scb-out" href={WA} target="_blank" rel="noopener" aria-label={en ? 'Ask on WhatsApp' : 'Per WhatsApp anfragen'}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg><span class="scb-lbl">WhatsApp</span></a>
    <a class="scb-out" href={TEL} aria-label={en ? 'Call' : 'Anrufen'}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.97-.97a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17z"/></svg><span class="scb-lbl">{en ? 'Call' : 'Anrufen'}</span></a>
  </div>
</div>
<style>
  /* Sprint 2B: EINE Zeile (Primaer + zwei 48px-Icon-Buttons) statt zwei Zeilen; ca. 64px + Safe-Area statt 125px. */
  .scb-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 540;
    display: none; flex-direction: row; align-items: stretch; gap: 8px;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
    background: rgba(255, 255, 255, .96); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border-top: 1px solid var(--border); box-shadow: 0 -4px 16px rgba(0, 0, 0, .07);
  }
  .scb-primary {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    flex: 1 1 auto; min-width: 0; min-height: 48px; box-sizing: border-box; padding: 0 14px; white-space: nowrap;
    background: var(--brand, #1AE288); color: var(--brand-black, #020B10); border-radius: var(--r-pill, 999px);
    font-family: var(--font-sans); font-size: 15px; font-weight: 700; letter-spacing: -.01em;
    text-decoration: none; box-shadow: 0 6px 18px rgba(26, 226, 136, .3);
    animation: scb-glow 2s ease-in-out infinite;
  }
  .scb-row { display: flex; gap: 8px; flex: 0 0 auto; }
  .scb-out {
    flex: 0 0 48px; width: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 0;
    min-height: 48px; box-sizing: border-box; padding: 0;
    background: #fff; color: var(--brand-black, #020B10); border: 1.5px solid rgba(2, 11, 16, .25); border-radius: var(--r-pill, 999px);
    font-family: var(--font-sans); font-size: 14px; font-weight: 600; text-decoration: none;
  }
  .scb-primary svg, .scb-out svg { flex-shrink: 0; }
  .scb-out svg { width: 19px; height: 19px; }
  /* Wave 0: sichtbarer Tastaturfokus (bisher nur der UA-Ring); Radius sitewide Pill statt 14px/999px je nach Seiten-Scope. */
  .scb-primary:focus-visible, .scb-out:focus-visible, :global(.scb-bar .scb-book:focus-visible) { outline: var(--focus-ring, 3px solid rgba(2, 11, 16, .55)); outline-offset: 2px; }
  /* Icon-Buttons: Text nur fuer Screenreader (aria-label bleibt zusaetzlich gesetzt). */
  .scb-lbl { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  /* Schmale Geraete (<=359px): Primaer ohne Icon und mit knapperem Innenabstand, Icon-Buttons 44px (Touch-Minimum). */
  @media (max-width: 359px) {
    .scb-primary { padding: 0 10px; font-size: 14.5px; }
    .scb-primary > svg { display: none; }
    .scb-out { flex-basis: 44px; width: 44px; min-height: 44px; }
    .scb-row { gap: 6px; }
    .scb-bar { gap: 6px; padding-left: 10px; padding-right: 10px; }
  }
  /* St. Gallen: Primaer mit zwei Zeilen (Pin + «Termin anfragen» / dezente Unterzeile «Auch als Gratis 360°-Check»),
     ca. 60px hoch, gleiche Pille, Farbe und Breite; Unterzeile kleiner, dunkel, zentriert, ohne Animation/Badge. */
  .scb-primary.scb-primary--sg { min-height: 60px; padding: 6px 14px; line-height: 1.15; }
  /* SG: Icon-Buttons als echte Kreise (48px, ≤359px 44px), vertikal mittig neben der 60px-Pille statt auf deren Hoehe gestreckt. */
  .scb-primary--sg ~ .scb-row { align-items: center; }
  /* Zwei :not(#id) > die 999px-Pillenregeln in home.css/de-special-rebrand.css (eine Id); ohne Astro-Scope, da global. */
  :global(body > .scb-bar .scb-primary--sg ~ .scb-row .scb-out:not(#w2):not(#w3)) { width: 48px; flex-basis: 48px; height: 48px; min-height: 0; aspect-ratio: 1 / 1; border-radius: 50%; }
  @media (max-width: 359px) { :global(body > .scb-bar .scb-primary--sg ~ .scb-row .scb-out:not(#w2):not(#w3)) { width: 44px; flex-basis: 44px; height: 44px; } }
  :global(.scb-primary--sg .scb-txt) { display: flex; flex-direction: column; align-items: center; min-width: 0; }
  :global(.scb-primary--sg .scb-l1) { font-size: 15px; font-weight: 700; letter-spacing: -.01em; }
  :global(.scb-primary--sg .scb-l2) { font-size: 11.5px; font-weight: 600; letter-spacing: 0; color: rgba(2, 11, 16, .78); }
  :global(.scb-primary--sg .scb-l2-short) { display: none; }
  @media (max-width: 359px) {
    :global(.scb-primary--sg .scb-l1) { font-size: 14.5px; }
    :global(.scb-primary--sg .scb-l2) { font-size: 11px; }
    :global(.scb-primary--sg .scb-l2-long) { display: none; }
    :global(.scb-primary--sg .scb-l2-short) { display: inline; }
  }
  @keyframes scb-glow {
    0%, 100% { box-shadow: 0 6px 18px rgba(26, 226, 136, .28); }
    50% { box-shadow: 0 6px 26px rgba(26, 226, 136, .55); }
  }
  @media (max-width: 768px) {
    /* Hidden at top of page; JS toggles .is-visible once the hero scrolls out. */
    .scb-bar {
      display: flex;
      transform: translateY(120%); opacity: 0; pointer-events: none;
      transition: transform .35s cubic-bezier(.16, 1, .3, 1), opacity .3s ease;
    }
    .scb-bar.is-visible { transform: translateY(0); opacity: 1; pointer-events: auto; }
    /* Platz unter dem Inhalt nur auf Seiten, auf denen die Leiste aktiv ist (Klasse setzt das Skript unten). */
    :global(body.scb-reserve) { padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px)); }
    /* SG: Primaer ca. 60px hoch → Leiste ca. 76px; Platz unter dem Inhalt entsprechend groesser. */
    :global(body.scb-reserve.scb-reserve--sg) { padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scb-primary { animation: none; }
    .scb-bar { transition: none; }
  }
  /* Offenes Drawer-Menue: Bar ausblenden (zusaetzlich zum Overlay, das sie ohnehin
     ueberdeckt); App-Flows koennen die Bar per [data-no-sticky-cta] deaktivieren. */
  :global(body.drawer-open) .scb-bar { opacity: 0 !important; pointer-events: none !important; }
  .scb-bar.scb-off { display: none !important; }
</style>
<script is:inline>
  (function () {
    var bar = document.querySelector('.scb-bar');
    if (!bar) return;
    // Opt-out fuer App-artige Buchungs-/Matching-Flows mit eigener persistenter
    // Aktionsleiste: beliebiges Element mit data-no-sticky-cta auf der Seite.
    if (document.querySelector('[data-no-sticky-cta]')) { bar.classList.add('scb-off'); return; }
    // Platz unter dem Inhalt nur reservieren, wenn die Leiste auf dieser Seite aktiv ist (siehe body.scb-reserve im CSS).
    // Seiten mit eigener Sticky-Aktion und B2B-Seiten setzen stickyCta={false} am LayoutDe (-> data-no-sticky-cta).
    document.body.classList.add('scb-reserve');
    var primary = bar.querySelector('.scb-primary');
    // SG-Seiten: EIN Funnel-Wording ("Ersttermin anfragen"); Primärziel bleibt das Lead-Formular. Alle anderen Seiten unberührt.
    var sgPage = /^\/(standorte\/st-gallen|akupunktur-tcm-st-gallen|akupunktur-st-gallen-kosten)\/?$/.test(location.pathname);
    // CARE-Seiten (Marker aus dem CARE-Adapter, z.B. Beschwerden): ruhigeres
    // Label + Ein-Event-Tracking (nur dataLayer); Ziel bleibt das On-Page-Formular
    // ueber den bestehenden Scroll-Handler unten. Alle anderen Seiten unberuehrt.
    var care = !sgPage && document.querySelector('[data-care-sticky]');
    if (primary && care) {
      for (var ci = 0; ci < primary.childNodes.length; ci++) {
        var ctn = primary.childNodes[ci];
        if (ctn.nodeType === 3 && ctn.textContent.trim()) ctn.textContent = ' Hilfe erhalten ';
      }
      primary.setAttribute('data-care-cta', 'sticky');
      primary.addEventListener('click', function () {
        var ct = care.getAttribute('data-care-sticky') || 'beschwerde';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'hilfeerhalten_click', quelle: ct + '_care', content_type: ct, cta_position: 'sticky', source_path: location.pathname });
      });
    }
    // SG-Seiten (21.10.2026, Konsolidierung TCM 360°): Hauptlabel «Termin anfragen» mit dezenter zweiter Zeile
    // «Auch als Gratis 360°-Check» (≤359px: «Gratis 360° möglich»); genau drei Bedienelemente (Primär, WhatsApp, Anrufen),
    // kein zweiter OneDoc-Button mehr in der Leiste (OneDoc bleibt im Hero, im Formular und als Widget erreichbar).
    if (primary && sgPage) {
      for (var i = 0; i < primary.childNodes.length; i++) {
        var tn = primary.childNodes[i];
        if (tn.nodeType === 3 && tn.textContent.trim()) {
          var txt = document.createElement('span'); txt.className = 'scb-txt';
          txt.innerHTML = '<span class="scb-l1">Termin anfragen</span><span class="scb-l2"><span class="scb-l2-long">Auch als Gratis 360°-Check</span><span class="scb-l2-short">Gratis 360° möglich</span></span>';
          primary.replaceChild(txt, tn); primary.classList.add('scb-primary--sg'); document.body.classList.add('scb-reserve--sg'); break;
        }
      }
    }
    // SG-Seiten mit OneDoc-Widget: Primär → #kontakt-Formular (Fallback: Widget). Der Formular-Scroll-Handler unten
    // entfällt, damit er den Anchor nicht hijackt; bestehende WA-/Tel-Links (Tracking-Hooks) unverändert.
    var toOnedoc = sgPage && document.getElementById('online-buchen');
    if (primary && toOnedoc) {
      primary.setAttribute('href', document.getElementById('kontakt') ? '#kontakt' : '#online-buchen');
    }
    if (primary && !toOnedoc) primary.addEventListener('click', function (e) {
      // No on-page contact form (e.g. wissen article) -> follow href to /kontakt/.
      var form = document.querySelector('#home-contact-form, .inline-form-card');
      if (!form) return;
      e.preventDefault();
      var ta = form.querySelector('textarea[name="anliegen"], textarea[name="behandlung"], textarea');
      if (ta && !ta.value.trim()) ta.value = 'Ich interessiere mich für einen Termin.';
      var f = form.querySelector('form') || form;
      var h = f.querySelector('input[name="quelle"]');
      if (!h) { h = document.createElement('input'); h.type = 'hidden'; h.name = 'quelle'; f.appendChild(h); }
      h.value = location.pathname || '/';
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Deutsche SG-Standortseite: Bar erst NACH der oberen Buchungsbox (deren tatsaechliches Ende, inkl. aufgeklappter
    // Felder/Fehler), aus sobald unteres Formular (#kontakt) oder OneDoc (#online-buchen) im Bild sind, bei fokussierten
    // Eingabefeldern bzw. offener Bildschirmtastatur. Verborgen = inert (nicht klick-/tabbar). Primaer → obere Box.
    // Gemeinsam (SG-Standortseite, DE-Homepage): Eingabefokus / Bildschirmtastatur halten die Bar verborgen.
    var typing = function () { var a = document.activeElement; return !!(a && a.matches && a.matches('input:not([type=radio]):not([type=checkbox]):not([type=hidden]):not([type=submit]):not([type=button]), textarea, select, [contenteditable="true"]')); };
    var keyboard = function () { var vv = window.visualViewport; return !!(vv && vv.height < window.innerHeight * 0.75); };
    var sgBox = /^\/standorte\/st-gallen\/?$/.test(location.pathname) && document.querySelector('[data-kf-instance="sg-hero"]');
    // Deutsche Standortseiten nach der SG-Vorlage: dieselbe Logik mit deren oberer Anfragebox ([data-std-box-oben]);
    // Primaer → #anfrage-box (der bestehende Klick-Handler oben scrollt dorthin und behaelt Prefill/Quelle).
    var stdBox = !sgBox && /^\/standorte\/[a-z-]+\/?$/.test(location.pathname) && document.querySelector('[data-std-box-oben]');
    if (stdBox) sgBox = stdBox;
    if (sgBox) {
      if (primary) primary.setAttribute('href', stdBox ? '#anfrage-box' : '#offer-form');
      var stops = [document.getElementById('kontakt'), document.getElementById('online-buchen')].filter(Boolean);
      var setVis = function (on) {
        if (bar.classList.contains('is-visible') !== on) bar.classList.toggle('is-visible', on);
        bar.inert = !on; if (on) bar.removeAttribute('aria-hidden'); else bar.setAttribute('aria-hidden', 'true');
      };
      var decide = function () {
        var vh = window.innerHeight;
        var past = sgBox.getBoundingClientRect().bottom <= 0;
        var inStop = stops.some(function (e) { var r = e.getBoundingClientRect(); return r.top < vh && r.bottom > 0; });
        setVis(past && !inStop && !typing() && !keyboard());
      };
      var raf = 0, sched = function () { if (!raf) raf = requestAnimationFrame(function () { raf = 0; decide(); }); };
      setVis(false); decide();
      if ('IntersectionObserver' in window) { var sio = new IntersectionObserver(sched, { threshold: [0, 1] }); sio.observe(sgBox); stops.forEach(function (e) { sio.observe(e); }); }
      if ('ResizeObserver' in window) new ResizeObserver(sched).observe(sgBox);
      window.addEventListener('scroll', sched, { passive: true });
      window.addEventListener('resize', sched);
      if (window.visualViewport) window.visualViewport.addEventListener('resize', sched);
      document.addEventListener('focusin', sched);
      document.addEventListener('focusout', function () { setTimeout(sched, 0); });
      window.addEventListener('pageshow', sched); window.addEventListener('load', sched); window.addEventListener('hashchange', sched);
      return;
    }

    // Sichtbarkeits-Logik: Sticky-CTA nur zeigen, wenn der normale Primaer-CTA
    // der Seite NICHT sichtbar ist (keine doppelten CTAs). Beobachtet wird der
    // erste Primaer-CTA im Above-the-fold-Bereich; Fallback bleibt der sichtbare
    // Hero (Leaves verstecken inaktive Hero-Varianten, und ein display:none-
    // Element wuerde nie intersecten -> Bar immer sichtbar).
    var hero = document.querySelector('.sg-active')          // therapie/symptom/standort leaf hero
      || document.querySelector('.hero-bg')                  // home
      || document.querySelector('.hero')                     // wissen + other LayoutDe pages
      || document.querySelector('[class*="-hero"]')
      || document.querySelector('main section, section');
    var target = null;
    var ctas = document.querySelectorAll('.hlsg-btn-primary, main .btn-primary, .hero .btn-primary, #home-content .btn-primary, .cta-card .btn--primary');
    for (var c = 0; c < ctas.length; c++) {
      var el = ctas[c];
      if (bar.contains(el) || el.closest('.scb-bar, footer, #siteDrawer')) continue;
      var r = el.getBoundingClientRect();
      if (r.width === 0 && r.height === 0) continue;        // versteckte Varianten
      // Nur ein CTA im oberen Seitenbereich zaehlt als "Hero-CTA"; ein erster
      // Primaerbutton weit unten (z.B. Formular-Submit) wuerde die Bar sonst
      // auf der ganzen Seite unterdruecken.
      if (r.top + (window.scrollY || 0) < window.innerHeight * 1.5) { target = el; }
      break;                                                 // nur den ersten sichtbaren pruefen
    }
    if (!target) target = hero;
    // Patientenformulare (DE: [data-kf]/[data-kf-huelle]; EN: form.ev-form): zusaetzlich verborgen, solange irgendein Teil einer Formularsektion im Bild ist (Homepage:
    // #home-contact-form wie bisher; sonst die Sektion jeder Karte des gemeinsamen Formulars bzw. der gemeinsamen Huelle
    // fuer Massage, Zuerich-Funnel, Vorbereitung und Wartelisten), bei Eingabefokus und offener Bildschirmtastatur;
    // verborgen = inert (nicht klick-/tabbar). Sonst gilt unveraendert die bisherige Hero-CTA-Logik (baseOn).
    var formSecs = location.pathname === '/'
      ? [document.getElementById('home-contact-form')].filter(Boolean)
      : [].slice.call(document.querySelectorAll('[data-kf], [data-kf-huelle], form.ev-form')).map(function (c) { return c.closest('section') || c; })
          .filter(function (e, i, a) { return a.indexOf(e) === i; });
    var homeForm = formSecs.length ? formSecs[0] : null;
    var inForm = function () { return formSecs.some(function (e) { var r = e.getBoundingClientRect(); return r.top < window.innerHeight && r.bottom > 0; }); };
    var baseOn = false;
    var apply = function () {
      var on = baseOn;
      if (homeForm) {
        on = on && !inForm() && !typing() && !keyboard();
        bar.inert = !on; if (on) bar.removeAttribute('aria-hidden'); else bar.setAttribute('aria-hidden', 'true');
      }
      if (bar.classList.contains('is-visible') !== on) bar.classList.toggle('is-visible', on);
    };
    if (homeForm) apply();
    if (!('IntersectionObserver' in window) || !target) { baseOn = true; apply(); return; }
    new IntersectionObserver(function (entries) {
      baseOn = !entries[0].isIntersecting; apply();
    }, { threshold: 0 }).observe(target);
    if (homeForm) {
      var hraf = 0, hsched = function () { if (!hraf) hraf = requestAnimationFrame(function () { hraf = 0; apply(); }); };
      var hio = new IntersectionObserver(hsched, { threshold: [0, 1] }); formSecs.forEach(function (e) { hio.observe(e); });
      if ('ResizeObserver' in window) { var hro = new ResizeObserver(hsched); formSecs.forEach(function (e) { hro.observe(e); }); }
      window.addEventListener('scroll', hsched, { passive: true });
      window.addEventListener('resize', hsched);
      if (window.visualViewport) window.visualViewport.addEventListener('resize', hsched);
      document.addEventListener('focusin', hsched);
      document.addEventListener('focusout', function () { setTimeout(hsched, 0); });
      window.addEventListener('pageshow', hsched); window.addEventListener('load', hsched); window.addEventListener('hashchange', hsched);
    }
  })();
</script>
