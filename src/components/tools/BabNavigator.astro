---
// BAB-Navigator (Wizard). Logik: src/lib/babNavigator.ts, Daten: src/data/regulatorik/. Design: tool-wizard.css.
// Alles lokal im Browser: keine API, keine Übertragung von Antworten.
import '../../styles/tool-wizard.css';
---
<div class="rn" id="bn" data-state="start">
  <section id="bn-start" aria-labelledby="bn-h1">
    <p class="rn-eyebrow">TCM.ch Tools</p>
    <h1 id="bn-h1" class="rn-h1">Brauchst du eine Berufsausübungsbewilligung?</h1>
    <p class="rn-sub">Wähle Kanton, Tätigkeit und Qualifikation. Wir zeigen dir, was du als Nächstes prüfen solltest.</p>
    <div class="rn-start-actions">
      <button type="button" class="rn-btn rn-btn--primary" id="bn-go">BAB-Check starten</button>
      <span class="rn-time">Dauert ca. 1 Minute</span>
    </div>
    <button type="button" class="rn-link" id="bn-resume" hidden>Letzten Check fortsetzen</button>
    <p class="rn-trust">Kostenlos · keine Anmeldung · keine Datenübertragung</p>
    <noscript><p class="rn-note">Der Navigator braucht JavaScript. Die Grundlagen findest du unter <a href="/regulatorik/berufsausuebungsbewilligung/">Berufsausübungsbewilligung</a>.</p></noscript>
  </section>

  <section id="bn-wizard" hidden aria-label="BAB-Check">
    <div class="rn-top">
      <button type="button" class="rn-link" id="bn-back">← Zurück</button>
      <span class="rn-count" id="bn-count" aria-live="polite"></span>
      <button type="button" class="rn-link" id="bn-ov-open" aria-haspopup="dialog" aria-controls="bn-ov">Übersicht</button>
    </div>
    <div class="rn-progress" role="progressbar" aria-label="Fortschritt" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="bn-progress"><span id="bn-bar"></span></div>
    <div class="rn-stage" id="bn-stage"></div>
  </section>

  <section class="rn-result" id="bn-result" hidden aria-live="polite" tabindex="-1"></section>

  <div class="rn-ov" id="bn-ov" role="dialog" aria-modal="true" aria-labelledby="bn-ov-h" hidden>
    <div class="rn-ov-panel">
      <div class="rn-ov-head"><p id="bn-ov-h" class="rn-ov-title">Übersicht</p><button type="button" class="rn-link" id="bn-ov-close" aria-label="Übersicht schliessen">Schliessen</button></div>
      <ol id="bn-ov-list"></ol>
    </div>
  </div>
</div>

<script>
  import {
    getBabSteps, isBabAnswered, getBabPlan, babPlanAsText, CANTONS, BAB_STEP_LABELS, BAB_METHOD_LABELS, BAB_STORAGE_KEY,
    type BabNavigatorAnswers, type BabStepId, type BabMethod, type BabItem, type BabSource,
  } from '../../lib/babNavigator';
  import { esc, track, store, swapCard, bindRadioKeys, bindCantonCombo, reducedMotion, CHECK_SVG } from '../../lib/wizardKit';

  const $ = (id: string) => document.getElementById(id)!;
  const root = $('bn'), start = $('bn-start'), wiz = $('bn-wizard'), stage = $('bn-stage'), result = $('bn-result');
  const st = store<{ answers: BabNavigatorAnswers; cur: BabStepId; finished?: boolean }>(BAB_STORAGE_KEY);
  let answers: BabNavigatorAnswers = {};
  let cur: BabStepId = 'canton';
  const save = (finished = false) => st.save({ answers, cur, finished });

  type Opt = { v: string; t: string; d?: string };
  const SINGLE: Partial<Record<BabStepId, { q: string; hint?: string; opts: Opt[] }>> = {
    qualification: { q: 'Welche Qualifikation hast du?', opts: [
      { v: 'diplom', t: 'Eidgenössisches Diplom', d: 'Naturheilpraktiker:in mit eidg. Diplom TCM' },
      { v: 'zertifikat', t: 'Zertifikat OdA AM', d: 'M1 bis M6 abgeschlossen' },
      { v: 'ausbildung', t: 'In Ausbildung', d: 'Mein Berufsweg ist noch nicht abgeschlossen' },
      { v: 'ausland', t: 'Ausländischer Abschluss', d: 'Meine Ausbildung stammt aus dem Ausland' },
      { v: 'andere', t: 'Andere Qualifikation', d: 'Mein Weg passt nicht genau in diese Auswahl' } ] },
    employment: { q: 'Arbeitest du selbstständig oder angestellt?', opts: [
      { v: 'selbststaendig', t: 'Selbstständig / eigene Praxis' }, { v: 'angestellt', t: 'Angestellt in einer Praxis' }, { v: 'beides', t: 'Beides' }, { v: 'offen', t: 'Noch offen' } ] },
    babStatus: { q: 'Hast du bereits eine BAB in diesem Kanton?', opts: [
      { v: 'ja', t: 'Ja' }, { v: 'nein', t: 'Nein' }, { v: 'antrag', t: 'Antrag läuft' }, { v: 'unbekannt', t: 'Weiss ich nicht' } ] },
    dispensesMedicine: { q: 'Gibst du Arzneimittel direkt an Patient:innen ab?', hint: 'Das ist eine eigene Frage, getrennt von der BAB.', opts: [
      { v: 'ja', t: 'Ja' }, { v: 'nein', t: 'Nein' }, { v: 'nicht_geplant', t: 'Noch nicht geplant' }, { v: 'unbekannt', t: 'Weiss ich nicht' } ] },
  };

  function stepHtml(step: BabStepId): string {
    const single = SINGLE[step];
    if (single) {
      const val = answers[step] as string | undefined;
      return `<fieldset class="rn-q"><legend class="rn-h2" tabindex="-1">${single.q}</legend>${single.hint ? `<p class="rn-hint">${single.hint}</p>` : ''}
        <div class="rn-opts" role="radiogroup" aria-label="${esc(single.q)}">${single.opts.map((o, i) => `
          <button type="button" class="rn-opt${val === o.v ? ' is-on' : ''}" role="radio" aria-checked="${val === o.v}" tabindex="${val === o.v || (!val && i === 0) ? 0 : -1}" data-single="${step}" data-v="${o.v}">
            <span class="rn-opt-t">${o.t}</span>${o.d ? `<span class="rn-opt-d">${o.d}</span>` : ''}${CHECK_SVG}</button>`).join('')}</div></fieldset>`;
    }
    if (step === 'methods') {
      const sel = answers.methods ?? [];
      return `<fieldset class="rn-q"><legend class="rn-h2" tabindex="-1">Welche Tätigkeit möchtest du anbieten?</legend><p class="rn-hint">Mehrfachauswahl möglich. Die Kantone regeln Methoden nicht zwingend gleich.</p>
        <div class="rn-opts rn-opts--grid">${(Object.keys(BAB_METHOD_LABELS) as BabMethod[]).map((m) => `
          <button type="button" class="rn-opt rn-opt--sm${sel.includes(m) ? ' is-on' : ''}" aria-pressed="${sel.includes(m)}" data-method="${m}"><span class="rn-opt-t">${BAB_METHOD_LABELS[m]}</span>${CHECK_SVG}</button>`).join('')}</div>
        <div class="rn-actions"><button type="button" class="rn-btn rn-btn--primary" data-next ${sel.length ? '' : 'disabled'}>Weiter</button></div></fieldset>`;
    }
    const c = CANTONS.find((k) => k.code === answers.canton);
    return `<div class="rn-q"><h2 class="rn-h2" tabindex="-1" id="bn-ct-h">In welchem Kanton möchtest du arbeiten?</h2>
      <div class="rn-combo"><input id="bn-ct" type="text" role="combobox" aria-labelledby="bn-ct-h" aria-autocomplete="list" aria-expanded="false" aria-controls="bn-ct-list" placeholder="Kanton suchen, z. B. Zürich" autocomplete="off"><ul id="bn-ct-list" role="listbox" hidden></ul></div>
      <p class="rn-picked" id="bn-picked">${c ? `<span class="rn-badge">${c.code}</span> ${esc(c.name)}` : ''}</p>
      <div class="rn-actions"><button type="button" class="rn-btn rn-btn--primary" data-next ${c ? '' : 'disabled'}>Weiter</button></div></div>`;
  }

  const steps = () => getBabSteps(answers);
  function chrome() {
    const s = steps(); const i = s.indexOf(cur);
    $('bn-count').textContent = `Schritt ${i + 1} von ${s.length}`;
    const pct = Math.round((i / s.length) * 100);
    $('bn-bar').style.width = pct + '%'; $('bn-progress').setAttribute('aria-valuenow', String(pct));
  }
  function show(step: BabStepId, dir: 1 | -1 = 1) {
    cur = step; save();
    swapCard(stage, stepHtml(step), dir, () => { chrome(); bind(); stage.querySelector<HTMLElement>('.rn-h2')?.focus({ preventScroll: true }); track('bab_navigator_step', { step: steps().indexOf(step) + 1 }); });
  }
  function next() { const s = steps(); const i = s.indexOf(cur); if (i < s.length - 1) show(s[i + 1], 1); else finish(); }
  function back() { const s = steps(); const i = s.indexOf(cur); if (i > 0) show(s[i - 1], -1); else { wiz.hidden = true; start.hidden = false; root.dataset.state = 'start'; $('bn-go').focus(); } }

  function bind() {
    stage.querySelectorAll<HTMLButtonElement>('[data-single]').forEach((b) => b.addEventListener('click', () => {
      (answers as Record<string, unknown>)[b.dataset.single!] = b.dataset.v;
      b.parentElement!.querySelectorAll('[role=radio]').forEach((x) => { x.classList.remove('is-on'); x.setAttribute('aria-checked', 'false'); });
      b.classList.add('is-on'); b.setAttribute('aria-checked', 'true'); save(); setTimeout(next, reducedMotion() ? 0 : 260);
    }));
    stage.querySelectorAll<HTMLButtonElement>('[data-method]').forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.method as BabMethod; const set = new Set(answers.methods ?? []);
      set.has(m) ? set.delete(m) : set.add(m); answers.methods = [...set];
      if (!set.has('arznei')) delete answers.dispensesMedicine;
      b.classList.toggle('is-on', set.has(m)); b.setAttribute('aria-pressed', String(set.has(m)));
      (stage.querySelector('[data-next]') as HTMLButtonElement).disabled = !set.size; save();
    }));
    stage.querySelector('[data-next]')?.addEventListener('click', next);
    bindRadioKeys(stage);
    if (cur === 'canton') bindCantonCombo($('bn-ct') as HTMLInputElement, $('bn-ct-list'), CANTONS, (code) => {
      answers.canton = code as BabNavigatorAnswers['canton']; save();
      const c = CANTONS.find((k) => k.code === code)!;
      $('bn-picked').innerHTML = `<span class="rn-badge">${c.code}</span> ${esc(c.name)}`;
      const n = stage.querySelector('[data-next]') as HTMLButtonElement; n.disabled = false; n.focus();
    });
  }

  // Übersicht
  const ov = $('bn-ov');
  function openOv() {
    const s = steps();
    $('bn-ov-list').innerHTML = s.map((x, i) => {
      const ok = isBabAnswered(answers, x); const reach = ok || x === cur || s.slice(0, i).every((y) => isBabAnswered(answers, y));
      return `<li>${reach ? `<button type="button" data-jump="${x}" ${x === cur ? 'aria-current="step"' : ''}>` : '<span class="is-locked">'}<span class="rn-ov-n" aria-hidden="true">${ok ? '✓' : i + 1}</span>${BAB_STEP_LABELS[x]}${ok ? '<span class="rn-sr"> (beantwortet)</span>' : ''}${reach ? '</button>' : '</span>'}</li>`;
    }).join('') + `<li><span class="is-locked"><span class="rn-ov-n" aria-hidden="true">${s.length + 1}</span>Ergebnis</span></li>`;
    ov.hidden = false; requestAnimationFrame(() => ov.classList.add('is-open')); ($('bn-ov-close') as HTMLButtonElement).focus();
    $('bn-ov-list').querySelectorAll<HTMLButtonElement>('[data-jump]').forEach((b) => b.addEventListener('click', () => { closeOv(); const t = b.dataset.jump as BabStepId; if (t !== cur) show(t, steps().indexOf(t) > steps().indexOf(cur) ? 1 : -1); }));
  }
  function closeOv() { ov.classList.remove('is-open'); setTimeout(() => (ov.hidden = true), reducedMotion() ? 0 : 200); ($('bn-ov-open') as HTMLButtonElement).focus(); }
  $('bn-ov-open').addEventListener('click', openOv); $('bn-ov-close').addEventListener('click', closeOv);
  ov.addEventListener('click', (e) => { if (e.target === ov) closeOv(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !ov.hidden) closeOv(); });

  // Ergebnis
  const fmt = (d: string) => d.split('-').reverse().join('.');
  const srcLine = (s: BabSource) => `<p class="rn-srcline"><a class="rn-src" data-src href="${s.url}" target="_blank" rel="noopener noreferrer">Quelle: ${esc(s.label.split(':')[0])} ↗</a>${s.checked ? ` · geprüft ${fmt(s.checked)}` : ''}${s.stale ? ' · <strong>Bitte aktuell gegenprüfen</strong>' : ''}</p>`;
  const card = (it: BabItem, i: number) => `
    <article class="rn-item" style="--d:${i * 70}ms"><span class="rn-item-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-12a7 7 0 0 1 14 0c0 6-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
      <div><h4>${esc(it.title)}</h4>${it.text ? `<p>${esc(it.text)}</p>` : ''}
        ${it.cta || it.secondary ? `<p class="rn-item-links">${it.cta ? `<a class="rn-btn rn-btn--sm" data-out href="${it.cta.href}"${it.cta.external ? ' target="_blank" rel="noopener noreferrer"' : ''}>${esc(it.cta.label)}</a>` : ''}${it.secondary ? `<a class="rn-link" data-out href="${it.secondary.href}">${esc(it.secondary.label)}</a>` : ''}</p>` : ''}
        ${it.source ? srcLine(it.source) : ''}</div></article>`;
  const STATE = { done: ['✓', 'erledigt'], todo: ['!', 'prüfen'], info: ['·', 'Angabe'] } as const;

  function finish(skipLoader = false) {
    save(true); wiz.hidden = true; result.hidden = false; root.dataset.state = 'result';
    const render = () => {
      const p = getBabPlan(answers);
      const grp = (h: string, items: BabItem[], cls = '') => items.length ? `<section class="rn-grp ${cls}"><h3>${h}</h3>${items.map(card).join('')}</section>` : '';
      result.innerHTML = `
        <div class="rn-res-head"><p class="rn-eyebrow">Dein BAB-Check</p><h2 class="rn-h1 rn-h1--res" tabindex="-1" id="bn-res-h">${esc(p.headline)}</h2><p class="rn-sub">${esc(p.sub)}</p></div>
        <dl class="rn-facts" aria-label="Zusammenfassung">${p.summary.map((r) => `<div class="is-${r.state}"><dt>${r.label}</dt><dd><span class="rn-facts-ico" aria-hidden="true">${STATE[r.state][0]}</span>${esc(r.value)}</dd></div>`).join('')}</dl>
        ${grp('Dein nächster Schritt', p.primaryActions, 'is-now')}
        ${grp('Was du bereithalten solltest', p.requirements)}
        ${grp('Für deine Methode', p.methodSpecific)}
        ${grp('Chinesische Arzneimittel', p.medicine)}
        ${grp('Hinweise', p.warnings, 'is-opt')}
        ${p.completed.length ? `<details class="rn-grp rn-done" open><summary>Bereits erledigt (${p.completed.length})</summary>${p.completed.map(card).join('')}</details>` : ''}
        ${p.checklist.length ? `<section class="rn-grp"><h3>Deine nächsten Schritte</h3><ul class="rn-check-list">${p.checklist.map((c) => `<li><span aria-hidden="true">□</span> ${esc(c)}</li>`).join('')}</ul></section>` : ''}
        <div class="rn-res-tools"><button type="button" class="rn-btn rn-btn--ghost" id="bn-copy">Checkliste kopieren</button><button type="button" class="rn-btn rn-btn--ghost" id="bn-print">Checkliste drucken</button><button type="button" class="rn-link" id="bn-edit">Antworten ändern</button><button type="button" class="rn-link" id="bn-restart">Neu starten</button></div>
        <p class="rn-copied" id="bn-copied" role="status"></p>
        <div class="rn-end"><h3>Weiter im System</h3><p>BAB ist eine Ebene. Registrierung, Versicherer und Abrechnung prüfst du im Anerkennungs-Navigator.</p>
          <p class="rn-item-links"><a class="rn-btn rn-btn--primary" data-out href="/tools/anerkennungs-navigator/">Anerkennung prüfen</a><a class="rn-link" data-out href="/regulatorik/kantone/">Kanton-Navigator →</a>${answers.babStatus === 'ja' && (answers.qualification === 'diplom' || answers.qualification === 'zertifikat') ? '<a class="rn-link" data-out href="/tools/praxis-checkliste/">Praxis eröffnen →</a>' : ''}</p></div>
        <p class="rn-disc">Der BAB-Navigator dient der Orientierung. Verbindlich sind die aktuellen Vorgaben der zuständigen kantonalen Behörden.</p>`;
      if (!reducedMotion()) result.classList.add('is-anim');
      ($('bn-res-h') as HTMLElement).focus({ preventScroll: true });
      result.scrollIntoView({ block: 'start', behavior: reducedMotion() ? 'auto' : 'smooth' });
      $('bn-copy').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(babPlanAsText(answers, p)); $('bn-copied').textContent = 'Checkliste kopiert.'; } catch (_) { $('bn-copied').textContent = 'Kopieren nicht möglich. Nutze «Checkliste drucken».'; }
      });
      $('bn-print').addEventListener('click', () => window.print());
      $('bn-edit').addEventListener('click', () => { result.hidden = true; wiz.hidden = false; root.dataset.state = 'wizard'; show(steps()[0], -1); });
      $('bn-restart').addEventListener('click', restart);
      result.querySelectorAll<HTMLAnchorElement>('[data-out]').forEach((a) => a.addEventListener('click', () => track('bab_navigator_result_click', { destination: a.getAttribute('href') || '' })));
      result.querySelectorAll<HTMLAnchorElement>('[data-src]').forEach((a) => a.addEventListener('click', () => track('bab_navigator_source_click', { destination: a.getAttribute('href') || '' })));
    };
    if (skipLoader || reducedMotion()) render();
    else { result.innerHTML = '<div class="rn-loading"><span class="rn-spin" aria-hidden="true"></span><p>Deinen Check zusammenstellen …</p></div>'; setTimeout(render, 600); }
    if (!skipLoader) track('bab_navigator_complete');
  }

  function begin() { start.hidden = true; wiz.hidden = false; root.dataset.state = 'wizard'; show(cur, 1); }
  function restart() { st.clear(); answers = {}; cur = 'canton'; result.hidden = true; result.classList.remove('is-anim'); stage.innerHTML = ''; track('bab_navigator_restart'); begin(); }
  $('bn-go').addEventListener('click', () => { answers = {}; cur = 'canton'; stage.innerHTML = ''; track('bab_navigator_start'); begin(); });
  $('bn-back').addEventListener('click', back);

  const saved = st.load();
  if (saved?.answers && Object.keys(saved.answers).length) {
    const r = $('bn-resume'); r.hidden = false;
    r.addEventListener('click', () => {
      answers = saved.answers; cur = getBabSteps(answers).includes(saved.cur) ? saved.cur : 'canton';
      start.hidden = true; root.dataset.state = 'wizard';
      if (saved.finished) finish(true); else begin();
    });
  }
</script>
