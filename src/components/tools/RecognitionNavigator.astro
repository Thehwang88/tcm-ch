---
// Anerkennungs-Navigator (Wizard). Logik: src/lib/recognitionNavigator.ts, Daten: src/data/regulatorik/.
// Alles lokal im Browser: keine API, keine Übertragung von Antworten. localStorage-Key versioniert.
import '../../styles/tool-wizard.css';
---
<div class="rn" id="rn" data-state="start">
  <section class="rn-start" id="rn-start" aria-labelledby="rn-h1">
    <p class="rn-eyebrow">TCM.ch Tools</p>
    <h1 id="rn-h1" class="rn-h1">Was brauchst du noch, um als TCM-Therapeut:in zu arbeiten und abzurechnen?</h1>
    <p class="rn-sub">Beantworte ein paar kurze Fragen. Wir zeigen dir danach deinen persönlichen nächsten Schritt.</p>
    <div class="rn-start-actions">
      <button type="button" class="rn-btn rn-btn--primary" id="rn-go">Check starten</button>
      <span class="rn-time">Dauert ca. 1 Minute</span>
    </div>
    <button type="button" class="rn-link" id="rn-resume" hidden>Letzten Check fortsetzen</button>
    <p class="rn-trust">Kostenlos · keine Anmeldung · keine Datenübertragung</p>
    <noscript><p class="rn-note">Der Navigator braucht JavaScript. Alle Inhalte findest du auch unter <a href="/regulatorik/">Regulatorik</a>.</p></noscript>
  </section>

  <section class="rn-wizard" id="rn-wizard" hidden aria-label="Anerkennungs-Check">
    <div class="rn-top">
      <button type="button" class="rn-link rn-back" id="rn-back">← Zurück</button>
      <span class="rn-count" id="rn-count" aria-live="polite"></span>
      <button type="button" class="rn-link" id="rn-ov-open" aria-haspopup="dialog" aria-controls="rn-ov">Übersicht</button>
    </div>
    <div class="rn-progress" role="progressbar" aria-label="Fortschritt" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="rn-progress"><span id="rn-bar"></span></div>
    <div class="rn-stage" id="rn-stage"></div>
  </section>

  <section class="rn-result" id="rn-result" hidden aria-live="polite" tabindex="-1"></section>

  <div class="rn-ov" id="rn-ov" role="dialog" aria-modal="true" aria-labelledby="rn-ov-h" hidden>
    <div class="rn-ov-panel">
      <div class="rn-ov-head"><p id="rn-ov-h" class="rn-ov-title">Übersicht</p><button type="button" class="rn-link" id="rn-ov-close" aria-label="Übersicht schliessen">Schliessen</button></div>
      <ol id="rn-ov-list"></ol>
    </div>
  </div>
</div>

<script>
  import {
    getSteps, isAnswered, getRecognitionPlan, planAsText, STEP_LABELS, METHOD_LABELS, CANTONS, STORAGE_KEY,
    type NavigatorAnswers, type StepId, type ActionItem, type Method,
  } from '../../lib/recognitionNavigator';

  const $ = (id: string) => document.getElementById(id)!;
  const root = $('rn'), start = $('rn-start'), wiz = $('rn-wizard'), stage = $('rn-stage'), result = $('rn-result');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const track = (event: string, extra: Record<string, string | number> = {}) => {
    const w = window as unknown as { dataLayer?: unknown[] };
    if (Array.isArray(w.dataLayer)) w.dataLayer.push({ event, ...extra });
  };

  let answers: NavigatorAnswers = {};
  let cur: StepId = 'qualification';

  const save = (finished = false) => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ answers, cur, finished })); } catch (_) {} };
  const load = () => { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch (_) { return null; } };

  // ── Schritte ──
  type Opt = { v: string; t: string; d?: string };
  const SINGLE: Partial<Record<StepId, { q: string; hint?: string; key: keyof NavigatorAnswers; opts: Opt[] }>> = {
    qualification: { q: 'Wo stehst du gerade?', key: 'qualification', opts: [
      { v: 'ausbildung', t: 'Ich bin in Ausbildung', d: 'Ich habe noch keinen abgeschlossenen TCM-Berufsweg.' },
      { v: 'zertifikat', t: 'Zertifikat OdA AM', d: 'M1 bis M6 abgeschlossen.' },
      { v: 'diplom', t: 'Eidgenössisches Diplom', d: 'Naturheilpraktiker:in mit eidg. Diplom TCM.' },
      { v: 'ausland', t: 'Ausländischer Abschluss', d: 'Meine TCM-Ausbildung stammt aus dem Ausland.' },
      { v: 'andere', t: 'Andere Qualifikation', d: 'Mein Weg passt nicht genau in diese Auswahl.' } ] },
    international: { q: 'Ist dein Abschluss für den Schweizer Berufsweg bereits geprüft?', key: 'international', opts: [
      { v: 'ja', t: 'Ja' }, { v: 'antrag', t: 'Verfahren läuft' }, { v: 'nein', t: 'Nein' }, { v: 'unbekannt', t: 'Weiss ich nicht' } ] },
    bab: { q: 'Hast du bereits eine Berufsausübungsbewilligung?', key: 'bab', opts: [
      { v: 'ja', t: 'Ja' }, { v: 'nein', t: 'Nein' }, { v: 'antrag', t: 'Antrag läuft' }, { v: 'unbekannt', t: 'Ich weiss es nicht' },
      { v: 'nicht_noetig', t: 'Für meine Tätigkeit scheint keine nötig zu sein' } ] },
    zsr: { q: 'Hast du bereits eine ZSR-Nummer?', hint: 'Die Nummer selbst brauchen wir nicht.', key: 'zsr', opts: [
      { v: 'ja', t: 'Ja' }, { v: 'nein', t: 'Nein' }, { v: 'antrag', t: 'Antrag läuft' }, { v: 'unbekannt', t: 'Weiss ich nicht' } ] },
    tariff590: { q: 'Rechnest du bereits über Tarif 590 ab?', key: 'tariff590', opts: [
      { v: 'ja', t: 'Ja' }, { v: 'nein', t: 'Nein' }, { v: 'nochnicht', t: 'Noch nicht' }, { v: 'unbekannt', t: 'Weiss ich nicht' } ] },
  };
  const REGS: { key: 'emr' | 'asca' | 'egk' | 'visana'; t: string; yes: string }[] = [
    { key: 'emr', t: 'EMR', yes: 'anerkannt' }, { key: 'asca', t: 'ASCA', yes: 'anerkannt' },
    { key: 'egk', t: 'EGK', yes: 'registriert' }, { key: 'visana', t: 'Visana', yes: 'anerkannt' },
  ];
  const CHECK = '<svg class="rn-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

  function stepHtml(step: StepId): string {
    const single = SINGLE[step];
    if (single) {
      const val = answers[single.key] as string | undefined;
      return `<fieldset class="rn-q"><legend class="rn-h2" tabindex="-1">${single.q}</legend>${single.hint ? `<p class="rn-hint">${single.hint}</p>` : ''}
        <div class="rn-opts" role="radiogroup" aria-label="${esc(single.q)}">${single.opts.map((o, i) => `
          <button type="button" class="rn-opt${val === o.v ? ' is-on' : ''}" role="radio" aria-checked="${val === o.v}" tabindex="${val === o.v || (!val && i === 0) ? 0 : -1}" data-single="${single.key}" data-v="${o.v}">
            <span class="rn-opt-t">${o.t}</span>${o.d ? `<span class="rn-opt-d">${o.d}</span>` : ''}${CHECK}</button>`).join('')}</div></fieldset>`;
    }
    if (step === 'methods') {
      const sel = answers.methods ?? [];
      return `<fieldset class="rn-q"><legend class="rn-h2" tabindex="-1">Was möchtest du anbieten?</legend><p class="rn-hint">Mehrfachauswahl möglich. Die kantonalen Regeln können je nach Methode unterschiedlich sein.</p>
        <div class="rn-opts rn-opts--grid">${(Object.keys(METHOD_LABELS) as Method[]).map((m) => `
          <button type="button" class="rn-opt rn-opt--sm${sel.includes(m) ? ' is-on' : ''}" aria-pressed="${sel.includes(m)}" data-method="${m}"><span class="rn-opt-t">${METHOD_LABELS[m]}</span>${CHECK}</button>`).join('')}</div>
        <div class="rn-actions"><button type="button" class="rn-btn rn-btn--primary" data-next ${sel.length ? '' : 'disabled'}>Weiter</button></div></fieldset>`;
    }
    if (step === 'canton') {
      const c = CANTONS.find((k) => k.code === answers.canton);
      return `<div class="rn-q"><h2 class="rn-h2" tabindex="-1" id="rn-ct-h">In welchem Kanton möchtest du arbeiten?</h2>
        <div class="rn-combo">
          <input id="rn-ct" type="text" role="combobox" aria-labelledby="rn-ct-h" aria-autocomplete="list" aria-expanded="false" aria-controls="rn-ct-list" placeholder="Kanton suchen, z. B. Zürich" autocomplete="off" value="">
          <ul id="rn-ct-list" role="listbox" hidden></ul>
        </div>
        <p class="rn-picked" id="rn-picked">${c ? `<span class="rn-badge">${c.code}</span> ${esc(c.name)}` : ''}</p>
        <div class="rn-actions"><button type="button" class="rn-btn rn-btn--primary" data-next ${c ? '' : 'disabled'}>Weiter</button></div></div>`;
    }
    if (step === 'regs') {
      return `<div class="rn-q"><h2 class="rn-h2" tabindex="-1">Welche Registrierungen hast du schon?</h2><p class="rn-hint">Wähle pro Stelle den Stand. Offen gelassen zählt als «weiss ich nicht».</p>
        <div class="rn-regs">${REGS.map((r) => { const v = answers[r.key]; return `
          <div class="rn-reg"><span class="rn-reg-t" id="rg-${r.key}">${r.t}</span>
            <div class="rn-seg" role="radiogroup" aria-labelledby="rg-${r.key}">${[['ja', r.yes], ['antrag', 'Antrag läuft'], ['nein', 'nein']].map(([k, l], i) => `
              <button type="button" role="radio" aria-checked="${v === k}" tabindex="${v === k || (!v && i === 0) ? 0 : -1}" class="${v === k ? 'is-on' : ''}" data-reg="${r.key}" data-v="${k}">${l}</button>`).join('')}</div></div>`; }).join('')}</div>
        <div class="rn-actions"><button type="button" class="rn-btn rn-btn--primary" data-next>Weiter</button><button type="button" class="rn-link" data-skip>Überspringen / weiss ich nicht</button></div></div>`;
    }
    return '';
  }

  // ── Navigation ──
  const steps = () => getSteps(answers);
  function updateChrome() {
    const s = steps(); const i = s.indexOf(cur);
    $('rn-count').textContent = `Schritt ${i + 1} von ${s.length}`;
    const pct = Math.round((i / s.length) * 100);
    $('rn-bar').style.width = pct + '%';
    $('rn-progress').setAttribute('aria-valuenow', String(pct));
  }
  function show(step: StepId, dir: 1 | -1 = 1) {
    cur = step; save();
    const html = stepHtml(step);
    const swap = () => {
      stage.innerHTML = `<div class="rn-card${reduce ? '' : dir > 0 ? ' in-right' : ' in-left'}">${html}</div>`;
      updateChrome(); bindStep();
      const h = stage.querySelector<HTMLElement>('.rn-h2'); h?.focus({ preventScroll: true });
      track('recognition_navigator_step', { step: steps().indexOf(step) + 1 });
    };
    const old = stage.firstElementChild as HTMLElement | null;
    if (old && !reduce) { old.classList.add(dir > 0 ? 'out-left' : 'out-right'); setTimeout(swap, 180); } else swap();
  }
  function next() {
    const s = steps(); const i = s.indexOf(cur);
    if (i < s.length - 1) show(s[i + 1], 1); else finish();
  }
  function back() {
    const s = steps(); const i = s.indexOf(cur);
    if (i > 0) show(s[i - 1], -1); else { wiz.hidden = true; start.hidden = false; root.dataset.state = 'start'; $('rn-go').focus(); }
  }

  // ── Bindings je Schritt ──
  function bindStep() {
    stage.querySelectorAll<HTMLButtonElement>('[data-single]').forEach((b) => b.addEventListener('click', () => {
      const key = b.dataset.single as keyof NavigatorAnswers;
      (answers as Record<string, unknown>)[key] = b.dataset.v;
      b.parentElement!.querySelectorAll('[role=radio]').forEach((x) => { x.classList.remove('is-on'); x.setAttribute('aria-checked', 'false'); });
      b.classList.add('is-on'); b.setAttribute('aria-checked', 'true');
      save(); setTimeout(next, reduce ? 0 : 260);
    }));
    stage.querySelectorAll<HTMLButtonElement>('[data-method]').forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.method as Method; const set = new Set(answers.methods ?? []);
      set.has(m) ? set.delete(m) : set.add(m); answers.methods = [...set];
      b.classList.toggle('is-on', set.has(m)); b.setAttribute('aria-pressed', String(set.has(m)));
      (stage.querySelector('[data-next]') as HTMLButtonElement).disabled = !set.size; save();
    }));
    stage.querySelectorAll<HTMLButtonElement>('[data-reg]').forEach((b) => b.addEventListener('click', () => {
      const key = b.dataset.reg as 'emr'; answers[key] = b.dataset.v as 'ja';
      b.parentElement!.querySelectorAll('button').forEach((x) => { x.classList.remove('is-on'); x.setAttribute('aria-checked', 'false'); x.tabIndex = -1; });
      b.classList.add('is-on'); b.setAttribute('aria-checked', 'true'); b.tabIndex = 0; save();
    }));
    stage.querySelector('[data-skip]')?.addEventListener('click', () => { REGS.forEach((r) => { answers[r.key] ??= 'unbekannt'; }); save(); next(); });
    stage.querySelector('[data-next]')?.addEventListener('click', () => {
      if (cur === 'regs') REGS.forEach((r) => { answers[r.key] ??= 'unbekannt'; });
      next();
    });
    // Pfeiltasten in Radiogroups
    stage.querySelectorAll<HTMLElement>('[role=radiogroup]').forEach((g) => g.addEventListener('keydown', (e) => {
      const items = [...g.querySelectorAll<HTMLButtonElement>('[role=radio]')]; const i = items.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const d = ['ArrowDown', 'ArrowRight'].includes(e.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(e.key) ? -1 : 0;
      if (!d) return; e.preventDefault();
      const n = items[(i + d + items.length) % items.length]; items.forEach((x) => (x.tabIndex = -1)); n.tabIndex = 0; n.focus();
    }));
    if (cur === 'canton') bindCombo();
  }

  function bindCombo() {
    const input = $('rn-ct') as HTMLInputElement, list = $('rn-ct-list');
    let active = -1, items = CANTONS;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const render = () => {
      const q = norm(input.value.trim());
      const rank = (c: { code: string; name: string }) => (c.code.toLowerCase() === q ? 0 : norm(c.name).startsWith(q) ? 1 : 2);
      items = CANTONS.filter((c) => !q || norm(c.name).includes(q) || c.code.toLowerCase() === q).sort((x, y) => rank(x) - rank(y));
      list.innerHTML = items.length ? items.map((c, i) => `<li role="option" id="ct-${c.code}" aria-selected="${i === active}" data-c="${c.code}"><span class="rn-badge">${c.code}</span>${esc(c.name)}</li>`).join('') : '<li class="rn-empty">Kein Kanton gefunden</li>';
      list.hidden = false; input.setAttribute('aria-expanded', 'true');
      input.setAttribute('aria-activedescendant', active >= 0 && items[active] ? `ct-${items[active].code}` : '');
    };
    const pick = (code: string) => {
      const c = CANTONS.find((k) => k.code === code)!; answers.canton = c.code; save();
      input.value = ''; list.hidden = true; input.setAttribute('aria-expanded', 'false');
      $('rn-picked').innerHTML = `<span class="rn-badge">${c.code}</span> ${esc(c.name)}`;
      (stage.querySelector('[data-next]') as HTMLButtonElement).disabled = false;
      (stage.querySelector('[data-next]') as HTMLButtonElement).focus();
    };
    input.addEventListener('focus', render);
    input.addEventListener('input', () => { active = 0; render(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, items.length - 1); render(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); render(); }
      else if (e.key === 'Enter' && items[Math.max(active, 0)]) { e.preventDefault(); pick(items[Math.max(active, 0)].code); }
      else if (e.key === 'Escape') { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }
    });
    list.addEventListener('mousedown', (e) => { const li = (e.target as HTMLElement).closest('li[data-c]') as HTMLElement | null; if (li) { e.preventDefault(); pick(li.dataset.c!); } });
    input.addEventListener('blur', () => setTimeout(() => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }, 120));
  }

  // ── Übersicht ──
  const ov = $('rn-ov');
  function openOv() {
    const s = steps();
    $('rn-ov-list').innerHTML = s.map((st, i) => {
      const ok = isAnswered(answers, st); const reachable = ok || st === cur || s.slice(0, i).every((x) => isAnswered(answers, x));
      return `<li>${reachable ? `<button type="button" data-jump="${st}" ${st === cur ? 'aria-current="step"' : ''}>` : '<span class="is-locked">'}<span class="rn-ov-n" aria-hidden="true">${ok ? '✓' : i + 1}</span>${STEP_LABELS[st]}${ok ? '<span class="rn-sr"> (beantwortet)</span>' : ''}${reachable ? '</button>' : '</span>'}</li>`;
    }).join('');
    ov.hidden = false; requestAnimationFrame(() => ov.classList.add('is-open'));
    ($('rn-ov-close') as HTMLButtonElement).focus();
    $('rn-ov-list').querySelectorAll<HTMLButtonElement>('[data-jump]').forEach((b) => b.addEventListener('click', () => { closeOv(); const t = b.dataset.jump as StepId; if (t !== cur) show(t, steps().indexOf(t) > steps().indexOf(cur) ? 1 : -1); }));
  }
  function closeOv() { ov.classList.remove('is-open'); setTimeout(() => (ov.hidden = true), reduce ? 0 : 200); ($('rn-ov-open') as HTMLButtonElement).focus(); }
  $('rn-ov-open').addEventListener('click', openOv);
  $('rn-ov-close').addEventListener('click', closeOv);
  ov.addEventListener('click', (e) => { if (e.target === ov) closeOv(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !ov.hidden) closeOv(); });

  // ── Ergebnis ──
  const ICONS: Record<ActionItem['icon'], string> = {
    path: '<path d="M4 19h16M6 15l4-8 4 5 4-7"/>', canton: '<path d="M12 21s-7-6-7-12a7 7 0 0 1 14 0c0 6-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
    reg: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>', insurer: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/>',
    bill: '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10h16"/>', meds: '<rect x="4" y="9" width="16" height="8" rx="4"/><path d="M12 9v8"/>',
    info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  };
  const card = (it: ActionItem, i: number) => `
    <article class="rn-item" style="--d:${i * 70}ms">
      <span class="rn-item-ico" aria-hidden="true"><svg viewBox="0 0 24 24">${ICONS[it.icon]}</svg></span>
      <div><h4>${esc(it.title)}</h4><p>${esc(it.text)}</p>
        ${it.cta || it.secondary || it.source ? `<p class="rn-item-links">${it.cta ? `<a class="rn-btn rn-btn--sm" data-out href="${it.cta.href}">${esc(it.cta.label)}</a>` : ''}${it.secondary ? `<a class="rn-link" data-out href="${it.secondary.href}">${esc(it.secondary.label)}</a>` : ''}${it.source ? `<a class="rn-src" data-out href="${it.source.url}" target="_blank" rel="noopener">${it.source.label} ↗</a>` : ''}</p>` : ''}
      </div></article>`;
  const SYM = { done: ['✓', 'erledigt'], todo: ['!', 'prüfen'], optional: ['○', 'optional'] } as const;

  function finish(skipLoader = false) {
    save(true);
    wiz.hidden = true; result.hidden = false; root.dataset.state = 'result';
    const render = () => {
      const p = getRecognitionPlan(answers);
      const grp = (h: string, items: ActionItem[], cls = '') => items.length ? `<section class="rn-grp ${cls}"><h3>${h}</h3>${items.map(card).join('')}</section>` : '';
      result.innerHTML = `
        <div class="rn-res-head"><p class="rn-eyebrow">Dein Status</p><h2 class="rn-h1 rn-h1--res" tabindex="-1" id="rn-res-h">${esc(p.headline)}</h2><p class="rn-sub">${esc(p.intro)}</p></div>
        <ul class="rn-sum" aria-label="Status-Übersicht">${p.summary.map((s) => `<li class="is-${s.state}"><span class="rn-sum-ico" aria-hidden="true">${SYM[s.state][0]}</span>${s.label}<span class="rn-sr">: ${SYM[s.state][1]}</span></li>`).join('')}</ul>
        <p class="rn-legend">✓ erledigt (laut deiner Angabe) · ! nächster Schritt / prüfen · ○ optional / situationsabhängig</p>
        ${grp('Jetzt erledigen', p.now, 'is-now')}${grp('Danach', p.next)}${grp('Kann relevant sein', p.optional, 'is-opt')}
        ${p.done.length ? `<details class="rn-grp rn-done"><summary>Bereits erledigt (${p.done.length})</summary>${p.done.map(card).join('')}</details>` : ''}
        <div class="rn-res-tools"><button type="button" class="rn-btn rn-btn--ghost" id="rn-copy">Meine Checkliste kopieren</button><button type="button" class="rn-btn rn-btn--ghost" id="rn-print">Checkliste drucken</button><button type="button" class="rn-link" id="rn-edit">Antworten ändern</button><button type="button" class="rn-link" id="rn-restart">Neu starten</button></div>
        <p class="rn-copied" id="rn-copied" role="status"></p>
        <div class="rn-end"><h3>Noch eine Frage offen?</h3><p>Die offiziellen Regeln ändern sich. Deshalb verlinken wir dir bei jedem Schritt die zuständige Stelle und unsere ausführliche Erklärung.</p>
          <p class="rn-item-links"><a class="rn-btn rn-btn--primary" data-out href="/regulatorik/">Regulatorik öffnen</a><a class="rn-btn rn-btn--ghost" data-out href="/praxiswissen/tcm-praxis-eroeffnen/">Praxis eröffnen</a></p></div>
        <p class="rn-disc">Der Navigator dient der Orientierung. Verbindlich sind die aktuellen Vorgaben der zuständigen Behörden, Register und Versicherer.</p>`;
      if (!reduce) result.classList.add('is-anim');
      ($('rn-res-h') as HTMLElement).focus({ preventScroll: true });
      result.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
      $('rn-copy').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(planAsText(p)); $('rn-copied').textContent = 'Checkliste kopiert.'; } catch (_) { $('rn-copied').textContent = 'Kopieren nicht möglich. Nutze «Checkliste drucken».'; }
      });
      $('rn-print').addEventListener('click', () => window.print());
      $('rn-edit').addEventListener('click', () => { result.hidden = true; wiz.hidden = false; root.dataset.state = 'wizard'; show(steps()[0], -1); });
      $('rn-restart').addEventListener('click', restart);
      result.querySelectorAll<HTMLAnchorElement>('[data-out]').forEach((a) => a.addEventListener('click', () => track('recognition_navigator_result_click', { destination: a.getAttribute('href') || '' })));
    };
    if (skipLoader || reduce) render();
    else { result.innerHTML = '<div class="rn-loading"><span class="rn-spin" aria-hidden="true"></span><p>Deinen Weg zusammenstellen …</p></div>'; setTimeout(render, 600); }
    if (!skipLoader) track('recognition_navigator_complete');
  }

  function begin() { start.hidden = true; wiz.hidden = false; root.dataset.state = 'wizard'; show(cur, 1); }
  function restart() {
    try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
    answers = {}; cur = 'qualification'; result.hidden = true; result.classList.remove('is-anim'); stage.innerHTML = '';
    track('recognition_navigator_restart'); begin();
  }
  $('rn-go').addEventListener('click', () => { answers = {}; cur = 'qualification'; stage.innerHTML = ''; track('recognition_navigator_start'); begin(); });
  $('rn-back').addEventListener('click', back);

  const saved = load();
  if (saved?.answers && Object.keys(saved.answers).length) {
    const r = $('rn-resume'); r.hidden = false;
    r.addEventListener('click', () => {
      answers = saved.answers; cur = getSteps(answers).includes(saved.cur) ? saved.cur : 'qualification';
      start.hidden = true; root.dataset.state = 'wizard';
      if (saved.finished) finish(true); else begin();
    });
  }
</script>
