---
import { PAIR_MAP, PAIR_MAP_EN, site } from '../data/site';
interface Props { currentPath: string; lang?: 'en' | 'de'; }
const { currentPath, lang = 'en' } = Astro.props;
const isDe = lang === 'de';

// ── Single source of truth for the whole site header. Same markup/classes/CSS/
// drawer for DE and EN; only labels + links differ. Order mirrors the DE SPA. ──
const logoHref = isDe ? '/' : '/en/';
const logoAria = isDe ? 'TCM.ch — Startseite' : 'TCM.ch — home';

const navLinks = isDe ? [
  { href: '/beschwerden/', label: 'Beschwerden' },
  { href: '/therapien/', label: 'Therapien' },
  { href: '/standorte/', label: 'Standorte' },
  { href: '/wissen/', label: 'Wissen' },
  { href: '/krankenkassen/', label: 'Krankenkasse' },
] : [
  { href: '/en/conditions/', label: 'Conditions' },
  { href: '/en/therapies/', label: 'Therapies' },
  { href: '/en/locations/', label: 'Locations' },
  { href: '/en/knowledge/', label: 'Knowledge' },
  { href: '/en/health-insurance-acupuncture/', label: 'Insurance & costs' },
];

// Language toggle: EN page → DE twin; DE page → EN twin (fallback to the other home).
const langHref = isDe ? (PAIR_MAP[currentPath] ?? '/en/') : (PAIR_MAP_EN[currentPath] ?? '/');
const langLabel = isDe ? 'EN' : 'DE';
const langAria = isDe ? 'Switch to English' : 'Zur deutschen Seite wechseln';
const langHreflang = isDe ? 'en' : 'de-CH';
const drawerLangLabel = isDe ? 'English / EN' : 'Deutsch / DE';

const ctaHref = isDe ? '/kontakt/' : '/en/contact/';
const ctaLabel = isDe ? 'Jetzt Hilfe erhalten' : 'Request an appointment';
const callLabel = isDe ? 'Anrufen' : 'Call';
const drawerUtilLabel = isDe ? 'Für Fachpersonen / Zuweiser' : 'For professionals — referral form in German';

const arrow = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
const cross = `<svg viewBox="0 0 32 32" width="1.15em" height="1.15em" style="display:inline-block;vertical-align:middle;margin-left:3px" aria-hidden="true"><rect width="32" height="32" rx="4" fill="#DA291C"/><rect x="6" y="13" width="20" height="6" fill="#fff"/><rect x="13" y="6" width="6" height="20" fill="#fff"/></svg>`;
const waHref = `https://wa.me/${site.whatsapp}`;

// EN drawer leaf lists — crawlable <a> for every EN hub child so leaves sit at
// depth 2 (drawer is on every page). DE uses its own header (DeHeader/header.html).
const enDrawer = [
  { label: 'Conditions', hubHref: '/en/conditions/', children: [
    { href: '/en/conditions/back-pain/', label: 'Back Pain' },
    { href: '/en/conditions/neck-pain/', label: 'Neck Pain' },
    { href: '/en/conditions/migraine-headaches/', label: 'Migraine & Headaches' },
    { href: '/en/conditions/sleep-problems/', label: 'Sleep Problems' },
    { href: '/en/conditions/stress-burnout/', label: 'Stress & Burnout' },
    { href: '/en/conditions/digestive-issues/', label: 'Digestive Issues' },
    { href: '/en/conditions/menstrual-issues/', label: 'Menstrual & Cycle Issues' },
    { href: '/en/conditions/fertility-support/', label: 'Fertility Support' },
  ] },
  { label: 'Therapies', hubHref: '/en/therapies/', children: [
    { href: '/en/therapies/acupuncture/', label: 'Acupuncture' },
    { href: '/en/therapies/acupressure/', label: 'Acupressure' },
    { href: '/en/therapies/cupping/', label: 'Cupping' },
    { href: '/en/therapies/tuina-massage/', label: 'Tuina Massage' },
    { href: '/en/therapies/chinese-herbal-medicine/', label: 'Chinese Herbal Medicine' },
    { href: '/en/therapies/moxibustion/', label: 'Moxibustion' },
    { href: '/en/therapies/electroacupuncture/', label: 'Electroacupuncture' },
    { href: '/en/therapies/facial-acupuncture/', label: 'Facial Acupuncture' },
    { href: '/en/therapies/gua-sha/', label: 'Gua Sha' },
    { href: '/en/therapies/shiatsu/', label: 'Shiatsu' },
    { href: '/en/therapies/physiotherapy/', label: 'Physiotherapy' },
  ] },
  { label: 'Locations', hubHref: '/en/locations/', children: [
    { href: '/en/locations/zuerich-oerlikon/', label: 'Zürich Oerlikon' },
    { href: '/en/locations/zuerich-hoengg/', label: 'Zürich Höngg' },
    { href: '/en/locations/zuerich-city/', label: 'Zürich City' },
    { href: '/en/locations/winterthur-muenzgasse/', label: 'Winterthur Münzgasse' },
    { href: '/en/locations/winterthur-marktgasse/', label: 'Winterthur Marktgasse' },
    { href: '/en/locations/st-gallen/', label: 'St. Gallen' },
    { href: '/en/locations/frauenfeld/', label: 'Frauenfeld' },
    { href: '/en/locations/kreuzlingen/', label: 'Kreuzlingen' },
    { href: '/en/locations/bottighofen/', label: 'Bottighofen' },
    { href: '/en/locations/rorschach/', label: 'Rorschach' },
    { href: '/en/locations/wil/', label: 'Wil' },
    { href: '/en/locations/volketswil/', label: 'Volketswil' },
    { href: '/en/locations/basel/', label: 'Basel' },
  ] },
  { label: 'Knowledge', hubHref: '/en/knowledge/', children: [
    { href: '/en/knowledge/what-to-expect-first-acupuncture-session/', label: 'Your First Session' },
    { href: '/en/knowledge/how-much-does-acupuncture-cost-in-switzerland/', label: 'Cost in Switzerland' },
    { href: '/en/knowledge/how-to-claim-acupuncture-on-swiss-insurance/', label: 'Claiming on Insurance' },
    { href: '/en/knowledge/is-acupuncture-safe-side-effects-explained/', label: 'Is Acupuncture Safe?' },
    { href: '/en/knowledge/english-speaking-acupuncturist-switzerland/', label: 'English-Speaking Acupuncturist' },
    { href: '/en/knowledge/acupuncture-for-back-pain-what-to-expect/', label: 'For Back Pain' },
    { href: '/en/knowledge/acupuncture-for-migraines-what-to-expect/', label: 'For Migraines' },
    { href: '/en/knowledge/acupuncture-for-stress-and-burnout/', label: 'For Stress & Burnout' },
    { href: '/en/knowledge/acupuncture-for-fertility-switzerland/', label: 'For Fertility' },
  ] },
];
const chev = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>`;
---
<!-- Header bar — mirrors the DE SPA #mainNav exactly (classes, spacing, typography, CTA, burger). -->
<nav id="mainNav">
  <div class="nav-inner">
    <a class="logo" href={logoHref} aria-label={logoAria}>
      <div class="logo-text-group">
        <div class="logo-wm">TCM<span class="ch">.ch</span></div>
        <span class="logo-sub">Kliniken<Fragment set:html={cross} /></span>
      </div>
    </a>
    <ul class="nav-links">
      {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="nav-right">
      {isDe
        ? <a class="nav-util" href="/zuweisen/">Für Fachpersonen</a>
        : <a class="nav-util" href="/zuweisen/" title="Online referral form (in German)">For professionals <span class="nav-util-lang">(DE)</span></a>}
      <a class="nav-lang" href={langHref} hreflang={langHreflang} aria-label={langAria}>{langLabel}</a>
      <a class="nav-cta" href={ctaHref}>{ctaLabel}</a>
      <button class="nav-menu-btn" id="enMenuBtn" aria-label="Open menu" aria-controls="siteDrawer" aria-expanded="false">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="15" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile drawer — mirrors the DE SPA #siteDrawer (right slide-in, overlay, header + plain links + CTA group). -->
<div id="drawerOverlay" aria-hidden="true"></div>
<aside id="siteDrawer" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drw-header">
    <div class="drw-logo">
      <div class="drw-logo-text">
        <div class="drw-logo-wm">TCM<span style="font-size:14px">.ch</span></div>
        <div class="drw-logo-sub">Kliniken<Fragment set:html={cross} /></div>
      </div>
    </div>
    <button class="drw-close" aria-label="Close menu">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="drw-body">
    <div class="drw-group">
      {isDe ? (
        <div class="drw-section">
          <ul class="drw-plain-links">
            {navLinks.map((l) => (
              <li><a href={l.href}>{l.label}<span class="drw-link-arrow" set:html={arrow} /></a></li>
            ))}
          </ul>
        </div>
      ) : enDrawer.map((sec) => (
        <div class="drw-section">
          <details class="drw-en-acc">
            <summary class="drw-en-sum">{sec.label}<span class="drw-en-chev" set:html={chev} /></summary>
            <ul class="drw-en-sub">
              <li><a class="drw-en-all" href={sec.hubHref}>All {sec.label.toLowerCase()}</a></li>
              {sec.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          </details>
        </div>
      ))}
      <div class="drw-section">
        <ul class="drw-plain-links">
          {!isDe && <li><a href="/en/health-insurance-acupuncture/">Insurance &amp; costs<span class="drw-link-arrow" set:html={arrow} /></a></li>}
          <li><a href={langHref} hreflang={langHreflang}>{drawerLangLabel}<span class="drw-link-arrow" set:html={arrow} /></a></li>
          <li><a href="/zuweisen/">{drawerUtilLabel}<span class="drw-link-arrow" set:html={arrow} /></a></li>
        </ul>
      </div>
    </div>
    <div class="drw-group drw-group--cta">
      <div class="drw-cta-grid">
        <a class="drw-cta-primary" href={ctaHref}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {ctaLabel}
        </a>
        <div class="drw-cta-row">
          <a class="drw-cta-secondary" href={`tel:+${site.whatsapp}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.59 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.08 6.08l1.62-.81a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2z"/></svg>
          {callLabel}
        </a>
        <a class="drw-cta-secondary drw-cta-wa" href={waHref} target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    var panel = document.getElementById('siteDrawer');
    var overlay = document.getElementById('drawerOverlay');
    var burger = document.getElementById('enMenuBtn');
    if (!panel || !overlay || !burger) return;
    var closeBtn = panel.querySelector('.drw-close');
    var scrollY = 0;
    function open() {
      panel.classList.add('open');
      overlay.classList.add('open');
      scrollY = window.scrollY || window.pageYOffset || 0;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + scrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      burger.setAttribute('aria-expanded', 'true');
      if (closeBtn) setTimeout(function () { closeBtn.focus(); }, 320);
    }
    function close() {
      panel.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, scrollY);
      burger.setAttribute('aria-expanded', 'false');
    }
    burger.addEventListener('click', open);
    overlay.addEventListener('click', close);
    if (closeBtn) closeBtn.addEventListener('click', close);
    panel.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel.classList.contains('open')) close();
    });
  })();
</script>

<style>
  /* ── Header bar: 1:1 with the DE SPA #mainNav (verified against its computed styles). ── */
  #mainNav { position: sticky; top: 0; z-index: 200; height: 68px; display: flex; align-items: center; background: var(--white); box-shadow: 0 2px 12px rgba(0,0,0,.06); padding: 0 40px; }
  .nav-inner { width: 100%; max-width: var(--max); margin: 0 auto; display: flex; align-items: center; gap: 16px; }

  .logo { display: flex; align-items: flex-start; gap: 10px; text-decoration: none; cursor: pointer; }
  .logo-text-group { display: flex; flex-direction: column; gap: 4px; }
  .logo-wm { font-family: var(--font-accent); font-weight: 900; font-style: italic; font-size: 24px; letter-spacing: -.5px; color: var(--black); line-height: 1; display: flex; align-items: baseline; }
  .logo-wm .ch { font-size: 19px; }
  .logo-sub { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: #666; line-height: 1; white-space: nowrap; text-transform: uppercase; }

  /* Desktop nav links: hidden below 1024px, pushed right via margin-left:auto (DE behaviour). */
  .nav-links { display: none; list-style: none; margin: 0 0 0 auto; padding: 0; align-items: center; gap: 20px; }
  .nav-links li { display: flex; }
  .nav-links a { display: inline-flex; align-items: center; height: 44px; line-height: normal; padding: 0 8px; font-family: var(--font-sans); font-size: 13.5px; font-weight: 500; color: var(--mid); text-decoration: none; white-space: nowrap; transition: color .2s ease; }
  .nav-links a:hover { color: var(--blue); }

  .nav-right { display: flex; align-items: center; flex-shrink: 0; }
  /* Secondary utility link (referrers / professionals) — not part of the 5-item patient nav. */
  .nav-util { font-size: 13px; font-weight: 600; color: var(--mid); text-decoration: none; white-space: nowrap; margin-right: 12px; transition: color .15s ease; }
  .nav-util:hover { color: var(--blue); }
  .nav-util-lang { color: var(--muted); font-weight: 500; }
  @media (max-width: 640px) { .nav-util { display: none; } }
  .nav-lang { font-size: 13px; font-weight: 700; line-height: normal; color: var(--mid); text-decoration: none; border: 1px solid var(--border); border-radius: 100px; padding: 5px 11px; margin-right: 4px; transition: color .15s ease, border-color .15s ease; }
  .nav-lang:hover { color: var(--blue); border-color: var(--blue); }
  /* CTA: black pill, white text (DE .nav-cta). */
  .nav-cta { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 18px; font-family: var(--font-sans); font-size: 13.5px; font-weight: 600; color: #0d0d0d; background: transparent; border: 1.5px solid rgba(13,13,13,.22); border-radius: var(--r-pill); text-decoration: none; white-space: nowrap; cursor: pointer; transition: background .2s ease, border-color .2s ease; }
  .nav-cta:hover { background: rgba(13,13,13,.06); border-color: rgba(13,13,13,.4); }
  /* Burger: 42px green-outlined, always visible (DE shows it at every width). */
  .nav-menu-btn { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: var(--radius-sm); background: var(--white); border: 1px solid var(--blue); color: var(--blue); cursor: pointer; padding: 0; margin-left: 10px; flex-shrink: 0; transition: background .15s ease; }
  .nav-menu-btn:hover { background: var(--blue-light); }

  @media (min-width: 1024px) { .nav-links { display: flex; } .nav-inner { gap: 32px; } }
  @media (max-width: 520px) {
    #mainNav { padding: 0 14px; }
    .nav-cta { padding: 0 12px; font-size: 12px; }
    .nav-menu-btn { margin-left: 6px; }
    .logo-wm { font-size: 20px; }
    .logo-wm .ch { font-size: 15px; }
    .logo-sub { font-size: 9px; letter-spacing: .14em; }
  }

  /* ── Drawer: 1:1 with the DE SPA #siteDrawer / #drawerOverlay. ── */
  #drawerOverlay { position: fixed; inset: 0; z-index: 900; background: rgba(8,8,8,.48); opacity: 0; pointer-events: none; transition: opacity var(--t-slow) var(--ease-in-out); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  #drawerOverlay.open { opacity: 1; pointer-events: all; }
  /* Closed: exactly translateX(100%) (left edge == viewport edge, no horizontal overflow;
     a position:fixed element peeking past 100% is NOT clipped by body overflow-x:hidden).
     Shadow only when open, so no sliver leaks at the right edge when closed. */
  #siteDrawer { position: fixed; top: 0; right: 0; height: 100vh; height: 100dvh; width: min(420px, 100vw); z-index: 901; background: #f9f9f9; box-shadow: none; transform: translateX(100%); transition: transform var(--t-slow) var(--ease-out); display: flex; flex-direction: column; }
  #siteDrawer.open { transform: translateX(0); box-shadow: -1px 0 0 rgba(0,0,0,.05), -20px 0 60px rgba(0,0,0,.12); }

  .drw-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 22px 18px; border-bottom: 1px solid rgba(0,0,0,.07); flex-shrink: 0; background: var(--white); }
  .drw-logo-text { display: flex; flex-direction: column; gap: 4px; }
  .drw-logo-wm { font-family: var(--font-accent); font-weight: 900; font-style: italic; font-size: 19px; letter-spacing: -.5px; color: var(--black); line-height: 1; display: block; }
  .drw-logo-sub { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: #666; text-transform: uppercase; line-height: 1; white-space: nowrap; }
  .drw-close { width: 30px; height: 30px; padding: 0; border-radius: 50%; background: rgba(0,0,0,.04); border: 1px solid rgba(0,0,0,.08); color: var(--muted); cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background .15s ease; }
  .drw-close:hover { background: rgba(0,0,0,.08); }

  .drw-body { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 4px 0 0; -webkit-overflow-scrolling: touch; }
  .drw-group + .drw-group { border-top: 1px solid rgba(0,0,0,.09); }
  .drw-section { border-bottom: 1px solid rgba(0,0,0,.06); }
  .drw-plain-links { list-style: none; padding: 6px 0; margin: 0; }
  .drw-plain-links a { display: flex; align-items: center; gap: 10px; width: 100%; padding: 11px 24px; line-height: normal; background: none; border: none; text-align: left; text-decoration: none; font-family: var(--font-sans); font-size: 14.5px; font-weight: 500; color: #1a1a1a; transition: color .2s ease, background .2s ease; }
  .drw-plain-links a:hover { color: var(--blue); background: rgba(45,155,111,.05); }
  .drw-link-arrow { margin-left: auto; display: inline-flex; opacity: 0; color: var(--blue); transition: opacity .15s ease, transform .15s var(--ease-out); }
  .drw-plain-links a:hover .drw-link-arrow { opacity: 1; transform: translateX(3px); }

  .drw-group--cta { padding: 14px 18px 16px; }
  .drw-cta-grid { display: flex; flex-direction: column; gap: 7px; }
  .drw-cta-primary { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--blue); color: #fff; padding: 12px 20px; line-height: normal; border-radius: var(--r-pill); font-family: var(--font-sans); font-size: 14px; font-weight: 600; text-decoration: none; transition: background .2s ease; }
  .drw-cta-primary:hover { background: var(--blue-dark); }
  .drw-cta-row { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .drw-cta-secondary { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 11px 14px; line-height: normal; border-radius: 9px; font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; text-decoration: none; color: #3a3a3a; border: 1px solid var(--border); background: var(--white); transition: border-color .15s ease, color .15s ease; }
