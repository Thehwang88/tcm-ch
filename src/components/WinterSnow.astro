---
/**
 * Subtle seasonal snowfall for major clinic landing-page heroes only.
 * Homepage uses its existing, stronger snowfall and Santa hat.
 * No form, booking, analytics or layout dependencies.
 */
const { target } = Astro.props as { target: string };
---
<style is:global>
  .tcm-winter-snow-host{position:relative}
  .tcm-winter-snow-layer{
    position:absolute;inset:0;z-index:3;overflow:hidden;pointer-events:none;
    contain:paint
  }
  .tcm-winter-snowflake{
    position:absolute;top:-22px;left:var(--winter-x);display:block;
    font-family:Arial,'Noto Sans Symbols 2',sans-serif;
    font-size:var(--winter-size);font-weight:400;line-height:1;
    font-variant-emoji:text;color:rgba(83,117,136,var(--winter-opacity));
    user-select:none;pointer-events:none;
    animation:tcm-winter-snow-fall var(--winter-duration) linear infinite;
    animation-delay:var(--winter-delay);animation-play-state:paused;
    will-change:transform
  }
  .tcm-winter-snow-layer.is-visible .tcm-winter-snowflake{animation-play-state:running}
  @keyframes tcm-winter-snow-fall{
    from{transform:translate3d(0,-20px,0)}
    to{transform:translate3d(var(--winter-drift),var(--winter-fall-distance),0)}
  }
  @media(max-width:767px){
    .tcm-winter-snowflake:nth-child(n+5){display:none!important}
  }
  @media(prefers-reduced-motion:reduce){
    .tcm-winter-snow-layer{display:none!important}
  }
</style>
<script is:inline data-tcm-winter-target={target}>
(function(){
  var script=document.currentScript;
  if(!script)return;
  var today=new Date(),mmdd=(today.getMonth()+1)*100+today.getDate();
  if(mmdd<1112||mmdd>1226)return;
  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  if(navigator.connection&&navigator.connection.saveData)return;
  var host=document.querySelector(script.getAttribute('data-tcm-winter-target'));
  if(!host||host.querySelector('.tcm-winter-snow-layer'))return;
  host.classList.add('tcm-winter-snow-host');
  var layer=document.createElement('div');
  layer.className='tcm-winter-snow-layer';
  layer.setAttribute('aria-hidden','true');
  // Seven very light flakes on desktop, four on mobile (~40% of home).
  for(var i=0;i<7;i++){
    var flake=document.createElement('span');
    flake.className='tcm-winter-snowflake';
    flake.textContent='❄︎';
    flake.style.setProperty('--winter-x',((i*47+13)%94+3)+'%');
    flake.style.setProperty('--winter-size',(9+i%3*2)+'px');
    flake.style.setProperty('--winter-opacity',(0.13+(i%4)*0.025).toFixed(3));
    flake.style.setProperty('--winter-duration',(21+(i*5)%12)+'s');
    flake.style.setProperty('--winter-delay',(-((i*9)%25))+'s');
    flake.style.setProperty('--winter-drift',((i%2?1:-1)*(10+(i*7)%27))+'px');
    layer.appendChild(flake);
  }
  host.appendChild(layer);
  function size(){layer.style.setProperty('--winter-fall-distance',Math.ceil(host.getBoundingClientRect().height+64)+'px');}
  size();
  if('ResizeObserver' in window)new ResizeObserver(size).observe(host);
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      layer.classList.toggle('is-visible',entries[entries.length-1].isIntersecting);
    },{threshold:0}).observe(host);
  }else{layer.classList.add('is-visible');}
})();
</script>
