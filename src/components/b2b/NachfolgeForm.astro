---
// Vertrauliches Erstgespräch Praxisnachfolge (/partner/praxisnachfolge/). POST JSON → /api/anfrage, quelle=praxisnachfolge.
// Bewusst kein Umsatzfeld, keine Patientendaten.
import { site } from '../../data/site';
const zeitraeume = ['In den nächsten 12 Monaten', 'In 1–3 Jahren', 'In 3–5 Jahren', 'Später / offen'];
const uebergaenge = ['Langsam reduzieren', 'Nachfolger:in finden', 'Verkaufen / übergeben', 'Partnerschaft ausloten', 'Noch unklar'];
---
<form class="form-card b2-form" id="nf-form" novalidate>
  <div class="hp" aria-hidden="true"><label>Dieses Feld leer lassen <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <fieldset>
    <legend>Kontakt</legend>
    <div class="form-row">
      <div class="field"><label for="nf-name">Name <span class="req">*</span></label><input id="nf-name" name="name" required autocomplete="name" /></div>
      <div class="field"><label for="nf-email">E-Mail <span class="req">*</span></label><input id="nf-email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
    </div>
    <div class="form-row">
      <div class="field"><label for="nf-tel">Telefon <span class="opt">(optional)</span></label><input id="nf-tel" name="telefon" type="tel" autocomplete="tel" inputmode="tel" /></div>
      <div class="field"><label for="nf-ort">Kanton / Ort der Praxis <span class="req">*</span></label><input id="nf-ort" name="standort" required /></div>
    </div>
  </fieldset>
  <fieldset>
    <legend>Deine Praxis</legend>
    <div class="form-row">
      <div class="field"><label for="nf-seit">Praxis aktiv seit <span class="opt">(optional)</span></label><input id="nf-seit" name="aktiv_seit" inputmode="numeric" placeholder="z. B. 2009" /></div>
      <div class="field"><label for="nf-zeit">Ungefährer Zeitraum <span class="req">*</span></label>
        <select id="nf-zeit" name="zeitraum" required><option value="">Bitte wählen</option>{zeitraeume.map((z) => <option>{z}</option>)}</select></div>
    </div>
    <div class="field"><label for="nf-weg">Gewünschter Übergang <span class="req">*</span></label>
      <select id="nf-weg" name="uebergang" required><option value="">Bitte wählen</option>{uebergaenge.map((u) => <option>{u}</option>)}</select></div>
    <div class="field"><label for="nf-msg">Nachricht</label><textarea id="nf-msg" name="nachricht" rows="4" placeholder="Was beschäftigt dich gerade? Keine Patientendaten."></textarea></div>
  </fieldset>
  <div class="cf-turnstile" data-sitekey={site.turnstileSitekey} style="margin:4px 0 14px"></div>
  <button class="btn btn--primary" type="submit"><span class="btn-label">Vertrauliches Erstgespräch</span></button>
  <div class="form-status" role="status" aria-live="polite" hidden></div>
  <p class="b2-privacy">Vertraulich. Keine Umsatzzahlen, keine Patientendaten nötig. Deine Angaben behandeln wir vertraulich. <a href="/datenschutz/">Datenschutz</a>.</p>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('nf-form');
    if (!form) return;
    var status = form.querySelector('.form-status');
    var label = form.querySelector('.btn-label');
    function show(state, msg) { status.hidden = false; status.setAttribute('data-state', state); status.textContent = msg; }
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (form.website.value.trim() !== '') return;
      if (!form.checkValidity()) { form.reportValidity(); return; }
      var tokenEl = form.querySelector('[name="cf-turnstile-response"]');
      var token = tokenEl && tokenEl.value ? tokenEl.value : '';
      if (!token) { show('error', 'Bitte bestätige kurz, dass du kein Roboter bist, und versuche es erneut.'); return; }
      var d = {};
      new FormData(form).forEach(function (v, k) { if (k !== 'cf-turnstile-response') d[k] = String(v).trim(); });
      d.quelle = 'praxisnachfolge';
      d.formular = 'Praxisnachfolge';
      d.seite = location.pathname;
      d.zeit = new Date().toISOString();
      d.turnstileToken = token;
      form.classList.add('is-sending');
      if (label) { label.dataset.orig = label.textContent; label.textContent = 'Wird gesendet…'; }
      try {
        var res = await fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) });
        var data = null; try { data = await res.json(); } catch (_) {}
        if (res.ok && data && data.ok) {
          form.reset();
          show('success', 'Danke. Deine Anfrage ist vertraulich bei uns eingegangen. Wir melden uns persönlich.');
          form.querySelectorAll('input,select,textarea,button').forEach(function (el) { el.disabled = true; });
          if (window.dataLayer) window.dataLayer.push({ event: 'form_submit', form_name: 'praxisnachfolge' });
        } else {
          var map = { missing_fields: 'Bitte fülle Name und E-Mail aus.', turnstile_failed: 'Sicherheitsprüfung fehlgeschlagen. Bitte erneut versuchen.' };
          show('error', map[data && data.error] || 'Anfrage konnte nicht gesendet werden. Bitte erneut versuchen.');
        }
      } catch (err) { show('error', 'Verbindungsfehler. Bitte erneut versuchen.'); }
      finally {
        form.classList.remove('is-sending');
        if (label && label.dataset.orig) label.textContent = label.dataset.orig;
        if (window.turnstile) { try { window.turnstile.reset(); } catch (_) {} }
      }
    });
  })();
</script>
