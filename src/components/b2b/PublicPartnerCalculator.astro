---
// Öffentlicher Modellrechner (Level 1): Umsatz → Marketing & Wachstum → Verteilungsbasis.
// Die Aufteilung der Verteilungsbasis wird öffentlich NICHT berechnet (Partner-Dossier / private
// Präsentation). An den Client geht nur weeksPerMonth + marketingShare. Keine Datenübertragung.
import { BASE_MODEL } from '../../data/partner-markets';
import { MODEL_DISCLAIMER } from '../../data/b2b';
const cfg = { weeksPerMonth: BASE_MODEL.weeksPerMonth, marketingShare: BASE_MODEL.marketingShare };
const pct = Math.round(BASE_MODEL.marketingShare * 100);
---
<section class="b2-sec" id="simulator">
  <div class="b2-wrap">
    <p class="b2-label">Modellrechnung</p>
    <h2 class="b2-h2">Rechne deinen Standort grob durch.</h2>
    <p class="b2-p">Alle Werte bleiben in deinem Browser.</p>
    <div class="b2-calc" data-pcalc={JSON.stringify(cfg)}>
      <form class="b2-calc__in" onsubmit="return false" aria-label="Eingaben">
        <div class="b2-ctl"><label for="pc-days">Arbeitstage / Woche</label><output for="pc-days" data-o="days"></output><input id="pc-days" type="range" min="1" max="6" step="1" value="4" data-i="days" /></div>
        <div class="b2-ctl"><label for="pc-pat">Patienten / Tag</label><output for="pc-pat" data-o="pat"></output><input id="pc-pat" type="range" min="2" max="15" step="1" value="8" data-i="pat" /></div>
        <div class="b2-ctl"><label for="pc-util">Auslastung</label><output for="pc-util" data-o="util"></output><input id="pc-util" type="range" min="10" max="100" step="5" value="80" data-i="util" /></div>
        <div class="b2-num"><label for="pc-rev">Ø Umsatz / Behandlung</label><span>CHF <input id="pc-rev" type="number" min="0" step="1" inputmode="numeric" value="130" data-i="rev" /></span></div>
        <button type="button" class="b2-reset" data-reset>Zurücksetzen</button>
      </form>
      <div class="b2-calc__out" aria-live="polite">
        <ul class="b2-kpi">
          <li class="is-hero"><span>≈ möglicher Standortumsatz / Monat</span><b data-o="revenue"></b></li>
          <li>Behandlungen / Monat <b data-o="treat"></b></li>
          <li>davon Marketing & Wachstum ({pct} %) <b data-o="mk"></b></li>
          <li class="is-green">Verteilungsbasis <b data-o="base"></b></li>
        </ul>
        <p class="b2-calc__note">Die konkrete Aufteilung der Verteilungsbasis zeigen wir dir im Partner-Dossier.</p>
        <p class="b2-calc__note"><strong>Modellrechnung zur Veranschaulichung. Keine Umsatz- oder Ergebnisgarantie.</strong> Beispielwerte, keine Erfahrungswerte.</p>
        <p class="b2-formula">Behandlungen = <code>Tage × Patienten × {cfg.weeksPerMonth} Wochen × Auslastung</code> · Umsatz = <code>Behandlungen × Ø Umsatz</code></p>
      </div>
    </div>

    <div class="b2-dossier" id="dossier">
      <h2 class="b2-h2">Wie sieht die konkrete Aufteilung aus?</h2>
      <p>Wenn das Grundmodell zu dir passt, zeigen wir dir im Partner-Dossier die vollständige wirtschaftliche Struktur, konkrete Aufteilung, Verantwortlichkeiten und Beispielrechnungen. Bevor du irgendeine Entscheidung triffst, kennst du selbstverständlich alle Konditionen.</p>
      <div class="b2-actions">
        <a class="btn btn--primary" href="/partner/?anliegen=dossier#partnerschaft">Partner-Dossier anfordern</a>
        <a class="b2-link" href="/partner/#partnerschaft">Partnerschaft unverbindlich prüfen</a>
      </div>
    </div>
  </div>
</section>
<script>
  import '../../scripts/partner-public-calc';
</script>
