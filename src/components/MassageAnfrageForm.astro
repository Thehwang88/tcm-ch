---
// Gemeinsames Anfrage-Formular für die Massage-Seiten (Superpage + alle Subpages).
// Nutzt denselben Submit-Handler (submitInlineFormGeneric aus home.js), dieselbe
// Turnstile-Validierung und dasselbe /api/anfrage-Backend wie die Therapie-Seiten.
// Sitekey zentral aus src/data/site.ts (keine Per-Seite-Ersetzung).
//
// Props (beide optional, default undefined -> bestehende Seiten unbetroffen):
//   anfrageTyp -> <input type="hidden" name="anfrage_typ">
//   quelle     -> <input type="hidden" name="quelle">
//   heading/sub -> Überschrift und Untertitel überschreiben (z. B. auf den
//                  Krankenkassen-Themenseiten, wo "Deine Massage anfragen" falsch wäre).
//                  Ohne Angabe bleibt der bisherige Text — bestehende Seiten unbetroffen.
import { site } from '../data/site';
interface Props {
  anfrageTyp?: string;
  quelle?: string;
  heading?: string;
  sub?: string;
}
const { anfrageTyp, quelle, heading, sub } = Astro.props;
---
<section id="anfrage" class="section contact-section-inline" style="background:var(--surface);border-top:1px solid var(--border)">
  <div class="wrap">
    <div style="text-align:center;max-width:620px;margin:0 auto 28px">
      <div class="section-label">Termin anfragen</div>
      {heading ? <h2 class="section-title" set:html={heading} /> : <h2 class="section-title">Deine Massage <em>anfragen.</em></h2>}
      <p class="section-sub" style="margin:0 auto">{sub ?? 'Kurz schildern, wir melden uns mit einem Vorschlag, meist innert 24 bis 48 Stunden.'}</p>
    </div>
    <div class="inline-form-card" style="max-width:620px;margin:0 auto">
      <div class="inline-form-header">
        <div class="inline-form-title">Passende Behandlung anfragen</div>
        <div class="inline-form-sub">Kostenlos &amp; unverbindlich, wir melden uns mit einem Vorschlag.</div>
      </div>
      <form class="inline-form" onsubmit="submitInlineFormGeneric(event, this)">
        {anfrageTyp && <input type="hidden" name="anfrage_typ" value={anfrageTyp} />}
        {quelle && <input type="hidden" name="quelle" value={quelle} />}
        <div class="form-group"><label class="form-label">Name *</label><input class="form-input" name="name" type="text" required /></div>
        <div class="form-row-2">
          <div class="form-group"><label class="form-label">E-Mail *</label><input class="form-input" name="email" type="email" required /></div>
          <div class="form-group"><label class="form-label">Telefon *</label><input class="form-input" name="telefon" type="tel" required /></div>
        </div>
        <div class="form-group"><label class="form-label">Standort</label>
          <select class="form-select" name="standort">
            <option value="">Standort auswählen</option>
            <option>Winterthur</option>
            <option>St. Gallen</option>
            <option>Zürich City</option>
            <option>Zürich Oerlikon</option>
            <option>Zürich Höngg</option>
            <option>Volketswil</option>
            <option>Frauenfeld</option>
            <option>Kreuzlingen</option>
            <option>Wil</option>
            <option>Rorschach</option>
            <option>Andere / in meiner Nähe</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Anliegen</label><textarea class="form-textarea" name="anliegen" placeholder="Kurz schildern, worum es geht" rows="4"></textarea></div>
        <div class="form-group cf-turnstile-wrap"><div class="cf-turnstile" data-sitekey={site.turnstileSitekey}></div></div>
        <button type="submit" class="btn-primary form-submit">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          Jetzt passende Hilfe anfragen
        </button>
        <div class="form-divider-quiet">Lieber direkt per WhatsApp?</div>
        <a href="https://wa.me/41775236122" class="form-wa-alt-new" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg> Jetzt per WhatsApp starten
        </a>
        <a href="tel:+41775236122" class="form-phone-alt"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.42 2 2 0 0 1 3.6 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.01z"></path></svg>oder anrufen <strong>+41 77 523 61 22</strong></a>
      </form>
    </div>
  </div>
</section>
