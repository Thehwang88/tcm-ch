---
// Geteilte CTA-Card der Bibliotheks-Leaves (Rebrand-Pilot 3).
// Markup + die 4 scoped Regeln verbatim aus wissen/[slug].astro und
// koerpersignale/[slug].astro (Stand 1bf13c9). Familien-Defaults, waHref
// und Tracking-onclick bleiben in den Seiten und kommen fertig als Props;
// waOnclick=undefined laesst das Attribut weg (wissen-Fall). Button-Styles
// (.btn, .btn--primary, .btn--ghost) sind global (src/styles/global.css).
//
// CARE-Erweiterung (Sprint #1, optional — ohne diese Props rendert die Karte
// exakt wie zuvor): eyebrow, Sekundaer-Link (Standorte), Trust-/Safety-Zeile,
// Tracking-onclick + data-care-cta auf dem Primaer-Button. Kein neues
// CTA-System: dieselbe Karte, dieselben Konsumenten.
export interface Props {
  title: string;
  text: string;
  primaryHref: string;
  primaryLabel: string;
  waHref: string;
  waOnclick?: string;
  eyebrow?: string;
  primaryOnclick?: string;
  primaryCtaPos?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  trustLine?: string;
  safetyNote?: string;
}
const {
  title, text, primaryHref, primaryLabel, waHref, waOnclick,
  eyebrow, primaryOnclick, primaryCtaPos, secondaryHref, secondaryLabel,
  trustLine, safetyNote,
} = Astro.props;
---
<div class="cta-card">
  {eyebrow && <div class="cta-eyebrow">{eyebrow}</div>}
  <div class="cta-card-title">{title}</div>
  <p>{text}</p>
  <div class="cta-row">
    <a class="btn btn--primary" href={primaryHref} onclick={primaryOnclick} data-care-cta={primaryCtaPos}>{primaryLabel}</a>
    {secondaryHref && secondaryLabel && <a class="btn btn--ghost" href={secondaryHref}>{secondaryLabel}</a>}
    <a class="btn btn--ghost" href={waHref} target="_blank" rel="noopener" onclick={waOnclick}>Per WhatsApp fragen</a>
  </div>
  {trustLine && <div class="cta-trust">{trustLine}</div>}
  {safetyNote && <div class="cta-safety">{safetyNote}</div>}
</div>
<style>
  .cta-card { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 24px; margin: 40px 0; }
  .cta-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 6px; }
  .cta-card-title { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 6px; }
  .cta-card p { font-size: 15.5px; color: var(--mid); margin: 0 0 16px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta-trust { font-size: 13px; font-weight: 600; color: var(--blue-dark); margin-top: 14px; }
  .cta-safety { font-size: 12.5px; color: var(--muted); margin: 6px 0 0; line-height: 1.5; }
</style>
