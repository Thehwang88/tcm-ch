---
// Fünf goldene Sterne als reine Deko über /qr/ und der Standortansicht (Test, Nutzerwunsch 10.11.2026).
// aria-hidden, kein Text, keine Aufforderung; nie über dem QR-Code. Animation: gestaffeltes
// Aufploppen, danach leises Funkeln mit Glanz. prefers-reduced-motion: statisch. Druck: ausgeblendet.
interface Props { size?: number; align?: 'center' | 'left' | 'right' }
const { size = 24, align = 'center' } = Astro.props;
const STAR = 'M12 2.6l2.83 6.07 6.67.73-4.96 4.5 1.38 6.55L12 17.1l-5.92 3.35 1.38-6.55-4.96-4.5 6.67-.73z';
---
<div class:list={['qr-stars', align === 'left' && 'qr-stars--left', align === 'right' && 'qr-stars--right']} aria-hidden="true" data-noprint style={`--s:${size}px`}>
  {[0, 1, 2, 3, 4].map((i) => (
    <svg class="qr-star" viewBox="0 0 24 24" width={size} height={size} style={`--i:${i}`} focusable="false">
      <defs>
        <linearGradient id={`qrg${i}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#FFE38A" />
          <stop offset=".45" stop-color="#F5B82E" />
          <stop offset="1" stop-color="#C98A06" />
        </linearGradient>
      </defs>
      <path d={STAR} fill={`url(#qrg${i})`} stroke="#B87D05" stroke-width=".6" stroke-linejoin="round" />
      <path class="qr-star-shine" d="M8.6 9.2l2-.22.9-1.95" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" opacity=".8" />
    </svg>
  ))}
</div>
<style is:global>
  .qr-stars{display:flex;justify-content:center;gap:calc(var(--s)*.22);margin:0 0 6px;line-height:0}
  .qr-stars--left{justify-content:flex-start;margin:4px 0 10px}
  .qr-stars--right{justify-content:flex-end;margin:0}
  .qr-star{display:block;filter:drop-shadow(0 1px 1.5px rgba(184,125,5,.35));transform-origin:50% 55%;
    animation:qr-star-pop .55s cubic-bezier(.2,1.6,.4,1) calc(var(--i)*90ms) both, qr-star-twinkle 3.6s ease-in-out calc(1s + var(--i)*180ms) infinite}
  @keyframes qr-star-pop{0%{opacity:0;transform:scale(.2) rotate(-25deg)}100%{opacity:1;transform:none}}
  @keyframes qr-star-twinkle{0%,70%,100%{filter:drop-shadow(0 1px 1.5px rgba(184,125,5,.35)) brightness(1);transform:none}
    80%{filter:drop-shadow(0 0 6px rgba(255,214,90,.9)) brightness(1.25);transform:scale(1.12) rotate(6deg)}}
  @media (prefers-reduced-motion:reduce){.qr-star{animation:none!important}}
  @media print{.qr-stars{display:none!important}}
</style>
