---
/**
 * St. Gallen-only CRO popup.
 * Temporary owner-review mode: appears 30s after every fresh page load.
 * Close leaves a floating reopen tab; popup hides the SG yellow offer banner while open.
 */
---
<div class="sgcp-backdrop" data-sgcp hidden>
  <section class="sgcp-card" role="dialog" aria-modal="true" aria-labelledby="sgcp-title" aria-describedby="sgcp-desc">
    <button class="sgcp-close" type="button" aria-label="Fenster schliessen" data-sgcp-close>×</button>
    <div class="sgcp-media">
      <img src="https://s3.amazonaws.com/webflow-prod-assets/67a5beedc0990dd5d83dd737/685c221ce7b36af7f377a96b_Team-scaled-e1710341469861-2048x1362-ezgif.com-jpg-to-webp-converter.webp" alt="Praxis Hwang Team" width="2048" height="1362" loading="eager" decoding="async">
    </div>
    <div class="sgcp-body">
      <div class="sgcp-kicker">St. Gallen · 30 Min kostenlos</div>
      <h2 id="sgcp-title">Dein kostenloser TCM 360°-Check-in</h2>
      <p id="sgcp-desc">Lerne TCM persönlich kennen – kostenlos und ohne Behandlung.</p>
      <ul>
        <li>Ganzheitlicher TCM-Kurzcheck</li>
        <li>Zungen- &amp; Pulsdiagnostik</li>
        <li>Persönliche Fragen + Krankenkassen-Check</li>
      </ul>
      <a class="sgcp-cta" href="#offer-form" data-sgcp-cta>
        Jetzt gratis Termin wählen <span aria-hidden="true">→</span>
      </a>
      <p class="sgcp-note">Kostenlos · unverbindlich · ohne Behandlung</p>
    </div>
  </section>
</div>

<button class="sgcp-reopen" type="button" data-sgcp-reopen hidden aria-label="Kostenlosen TCM 360°-Check-in anzeigen">
  <span class="sgcp-reopen-dot" aria-hidden="true">+</span>
  <span class="sgcp-reopen-label">Gratis Check-in</span>
</button>

<style>
  .sgcp-backdrop{
    position:fixed;inset:0;z-index:2147483000;
    display:flex;align-items:flex-end;justify-content:center;
    padding:0 16px 18px;
    background:rgba(2,11,16,.34);
    font-family:var(--font-sans,'Figtree',system-ui,sans-serif);
  }
  .sgcp-backdrop[hidden]{display:none!important}
  .sgcp-card{
    position:relative;
    width:min(100%,560px);
    max-height:min(650px,calc(100dvh - 28px));
    overflow:auto;
    box-sizing:border-box;
    background:#FFD84D;
    color:#07130E;
    border:1px solid rgba(7,19,14,.16);
    border-radius:26px;
    box-shadow:0 24px 70px rgba(2,11,16,.30);
  }
  .sgcp-media{
    aspect-ratio:16/6.9;
    overflow:hidden;
    border-radius:26px 26px 0 0;
    background:#e6c140;
  }
  .sgcp-media img{
    display:block;width:100%;height:100%;
    object-fit:cover;
    object-position:center 36%;
  }
  .sgcp-body{padding:16px 24px 18px}
  .sgcp-close{
    position:absolute;top:12px;right:12px;z-index:2;
    width:32px;height:32px;display:grid;place-items:center;
    border:0;border-radius:50%;background:rgba(255,255,255,.88);
    color:#07130E;font:700 22px/1 Arial,sans-serif;cursor:pointer;
    box-shadow:0 2px 8px rgba(2,11,16,.10)
  }
  .sgcp-close:hover{background:#fff}
  .sgcp-close:focus-visible,.sgcp-cta:focus-visible,.sgcp-reopen:focus-visible{outline:3px solid #07130E;outline-offset:3px}
  .sgcp-kicker{
    display:inline-flex;align-items:center;min-height:27px;padding:0 10px;
    border-radius:999px;background:#07130E;color:#fff;
    font-size:11px;font-weight:800;letter-spacing:.055em;text-transform:uppercase;
  }
  .sgcp-card h2{
    margin:10px 0 4px;
    font-size:clamp(24px,4.4vw,32px);
    line-height:1.03;letter-spacing:-.035em;font-weight:800;color:#07130E;
  }
  .sgcp-card>*,.sgcp-body>*{box-sizing:border-box}
  .sgcp-body>p#sgcp-desc{margin:0 0 10px;font-size:15px;line-height:1.4;font-weight:650}
  .sgcp-body ul{list-style:none;margin:0 0 13px;padding:0;display:grid;gap:4px}
  .sgcp-body li{font-size:14px;line-height:1.3;font-weight:680}
  .sgcp-body li::before{content:'✓';display:inline-block;margin-right:8px;font-weight:900}
  .sgcp-cta{
    display:flex;align-items:center;justify-content:center;gap:8px;
    width:100%;min-height:48px;padding:0 18px;
    border-radius:999px;background:#07130E;color:#fff;text-decoration:none;
    font-size:15.5px;font-weight:800;letter-spacing:-.01em;
    transition:transform .15s ease,background-color .15s ease;
  }
  .sgcp-cta:hover{background:#123028;transform:translateY(-1px)}
  .sgcp-note{margin:7px 0 0!important;text-align:center;font-size:11.5px!important;line-height:1.3!important;font-weight:650!important;opacity:.75}
  .sgcp-reopen{
    position:fixed;left:14px;bottom:112px;z-index:2147482999;
    display:inline-flex;align-items:center;gap:8px;
    width:52px;height:52px;padding:0;justify-content:center;
    border:1px solid rgba(7,19,14,.16);border-radius:999px;
    background:#FFD84D;color:#07130E;
    font:800 0/1 var(--font-sans,'Figtree',system-ui,sans-serif);
    box-shadow:0 8px 26px rgba(2,11,16,.18);cursor:pointer;
  }
  .sgcp-reopen[hidden]{display:none!important}
  .sgcp-reopen-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .sgcp-reopen-dot{
    width:32px;height:32px;border-radius:50%;display:grid;place-items:center;
    background:#07130E;color:#fff;font:800 21px/1 Arial,sans-serif;
  }
:global(html.sgcp-open .sgb-banner),
  :global(html.sgcp-open .sgb-spacer){display:none!important}
  @media(max-width:600px){
    .sgcp-backdrop{padding:0 10px 10px}
    .sgcp-card{width:min(100%,430px);border-radius:22px;max-height:calc(100dvh - 18px)}
    .sgcp-media{border-radius:22px 22px 0 0;aspect-ratio:16/6.6}
    .sgcp-body{padding:14px 18px 15px}
    .sgcp-card h2{font-size:24px;margin-top:8px}
    .sgcp-body>p#sgcp-desc{font-size:14px;margin-bottom:8px}
    .sgcp-body li{font-size:13px}
    .sgcp-body ul{margin-bottom:11px}
    .sgcp-cta{min-height:48px;font-size:15px}
    .sgcp-reopen{left:12px;bottom:108px;width:50px;height:50px}
  }
  @media(max-width:360px){
    .sgcp-body{padding:12px 15px 14px}
    .sgcp-card h2{font-size:22px}
    .sgcp-media{aspect-ratio:16/6.4}
  }
  @media(prefers-reduced-motion:reduce){.sgcp-cta{transition:none}}
</style>

<script is:inline>
(() => {
  const root = document.querySelector('[data-sgcp]');
  const reopen = document.querySelector('[data-sgcp-reopen]');
  if (!root || !reopen) return;

  const close = root.querySelector('[data-sgcp-close]');
  const cta = root.querySelector('[data-sgcp-cta]');
  let lastFocused = null;

  const push = (event, extra = {}) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event, page_path: location.pathname, ...extra });
  };

  const show = (source = 'auto') => {
    if (!root.hidden) return;
    lastFocused = document.activeElement;
    root.hidden = false;
    reopen.hidden = true;
    document.documentElement.classList.add('sgcp-open');
    document.documentElement.style.overflow = 'hidden';
    close?.focus({ preventScroll: true });
    push('sg_checkin_popup_view', { source });
  };

  const hide = (reason = 'close') => {
    if (root.hidden) return;
    root.hidden = true;
    reopen.hidden = false;
    document.documentElement.classList.remove('sgcp-open');
    document.documentElement.style.overflow = '';
    push('sg_checkin_popup_close', { reason });
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus({ preventScroll: true });
  };

  const timer = setTimeout(() => show('15s'), 15000);

  close?.addEventListener('click', () => hide('button'));
  root.addEventListener('click', (e) => { if (e.target === root) hide('backdrop'); });
  reopen.addEventListener('click', () => show('reopen'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden) hide('escape'); });

  cta?.addEventListener('click', (e) => {
    e.preventDefault();
    clearTimeout(timer);

    const card =
      document.querySelector('[data-kf-instance="sg-hero"]') ||
      document.getElementById('offer-form') ||
      document.querySelector('[data-kf][data-kf-standort-id="st-gallen"]');

    const radio = card?.querySelector('input[name="terminart"][value="checkin"]');
    if (radio && !radio.disabled) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    }

    root.hidden = true;
    reopen.hidden = false;
    document.documentElement.classList.remove('sgcp-open');
    document.documentElement.style.overflow = '';

    try {
      const url = new URL(location.href);
      url.searchParams.set('terminart', 'checkin');
      url.hash = 'offer-form';
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    } catch (_) {}

    push('sg_checkin_popup_click', { terminart: 'checkin', standort: 'st-gallen' });

    const target = document.getElementById('offer-form') || card || document.getElementById('termin');
    if (target) {
      requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    }
  });
})();
</script>
