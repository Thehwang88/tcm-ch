---
/**
 * Check-in CRO popup. St. Gallen is the master design; Zürich hub and Zürich clinics reuse it.
 * Engagement-gated auto-open on desktop and mobile: 45s AND 40% scroll.
 * Dismissals are respected for seven days; manual reopening remains available.
 */
---
<div class="sgcp-backdrop" data-sgcp hidden>
  <section class="sgcp-card" role="dialog" aria-modal="true" aria-labelledby="sgcp-title" aria-describedby="sgcp-desc">
    <button class="sgcp-close" type="button" aria-label="Fenster schliessen" data-sgcp-close>×</button>
    <div class="sgcp-media">
      <img data-sgcp-img src="https://s3.amazonaws.com/webflow-prod-assets/67a5beedc0990dd5d83dd737/685c221ce7b36af7f377a96b_Team-scaled-e1710341469861-2048x1362-ezgif.com-jpg-to-webp-converter.webp" alt="Praxis Hwang Team" width="2048" height="1362" loading="eager" decoding="async">
    </div>
    <div class="sgcp-body">
      <div class="sgcp-kicker" data-sgcp-kicker>St. Gallen · 30 Min kostenlos</div>
      <h2 id="sgcp-title">Dein kostenloser TCM 360°-Check-in</h2>
      <p id="sgcp-desc">Lerne TCM persönlich kennen – kostenlos und ohne Behandlung.</p>
      <ul>
        <li>Ganzheitlicher TCM-Kurzcheck</li>
        <li>Zungen- &amp; Pulsdiagnostik</li>
        <li>Persönliche Fragen + Krankenkassen-Check</li>
      </ul>
      <a class="sgcp-cta" href="#offer-form" data-sgcp-cta>
        Jetzt gratis Termin wählen <span aria-hidden="true">→</span>
      </a>
      <p class="sgcp-note">Kostenlos · unverbindlich · ohne Behandlung</p>
    </div>
  </section>
</div>

<button class="sgcp-reopen" type="button" data-sgcp-reopen hidden aria-label="Kostenlosen TCM 360°-Check-in anzeigen">
  <span class="sgcp-reopen-dot" aria-hidden="true">+</span>
  <span class="sgcp-reopen-label">Check-in</span>
</button>

<style>
  .sgcp-backdrop{
    position:fixed;inset:0;z-index:2147483000;
    display:flex;align-items:flex-end;justify-content:center;
    padding:0 16px 18px;
    background:rgba(2,11,16,.34);
    font-family:var(--font-sans,'Figtree',system-ui,sans-serif);
  }
  .sgcp-backdrop[hidden]{display:none!important}
  .sgcp-card{
    position:relative;
    width:min(100%,560px);
    max-height:min(650px,calc(100dvh - 28px));
    overflow:auto;
    box-sizing:border-box;
    background:#FFD84D;
    color:#07130E;
    border:1px solid rgba(7,19,14,.16);
    border-radius:26px;
    box-shadow:0 24px 70px rgba(2,11,16,.30);
  }
  .sgcp-media{
    aspect-ratio:16/6.9;
    overflow:hidden;
    border-radius:26px 26px 0 0;
    background:#e6c140;
  }
  .sgcp-media img{
    display:block;width:100%;height:100%;
    object-fit:cover;
    object-position:center 36%;
  }
  /* Teamfoto (6 Personen, 4:3): ganze Personen inkl. Köpfe sichtbar */
  .sgcp-media:has(img[src$="team-hero.jpg"]){aspect-ratio:16/9}
  .sgcp-media img[src$="team-hero.jpg"]{object-position:center 48%}
  .sgcp-body{padding:16px 24px 18px}
  .sgcp-close{
    position:absolute;top:12px;right:12px;z-index:2;
    width:32px;height:32px;min-width:32px;min-height:32px;aspect-ratio:1/1;padding:0;
    display:grid;place-items:center;box-sizing:border-box;
    border:0;border-radius:50%!important;background:rgba(255,255,255,.92);
    color:#07130E;font:700 22px/1 Arial,sans-serif;cursor:pointer;
    box-shadow:0 2px 8px rgba(2,11,16,.10)
  }
  .sgcp-close:hover{background:#fff}
  .sgcp-close:focus-visible,.sgcp-cta:focus-visible,.sgcp-reopen:focus-visible{outline:3px solid #07130E;outline-offset:3px}
  .sgcp-kicker{
    display:inline-flex;align-items:center;min-height:27px;padding:0 10px;
    border-radius:999px;background:#07130E;color:#fff;
    font-size:11px;font-weight:800;letter-spacing:.055em;text-transform:uppercase;
  }
  .sgcp-card h2{
    margin:10px 0 4px;
    font-size:clamp(24px,4.4vw,32px);
    line-height:1.03;letter-spacing:-.035em;font-weight:800;color:#07130E;
  }
  .sgcp-card>*,.sgcp-body>*{box-sizing:border-box}
  .sgcp-body>p#sgcp-desc{margin:0 0 10px;font-size:15px;line-height:1.4;font-weight:650}
  .sgcp-body ul{list-style:none;margin:0 0 13px;padding:0;display:grid;gap:4px}
  .sgcp-body li{font-size:14px;line-height:1.3;font-weight:680}
  .sgcp-body li::before{content:'✓';display:inline-block;margin-right:8px;font-weight:900}
  .sgcp-cta{
    display:flex;align-items:center;justify-content:center;gap:8px;
    width:100%;min-height:48px;padding:0 18px;
    border-radius:999px;background:#07130E;color:#fff;text-decoration:none;
    font-size:15.5px;font-weight:800;letter-spacing:-.01em;
    transition:transform .15s ease,background-color .15s ease;
  }
  .sgcp-cta:hover{background:#123028;transform:translateY(-1px)}
  .sgcp-note{margin:7px 0 0!important;text-align:center;font-size:11.5px!important;line-height:1.3!important;font-weight:650!important;opacity:.75}
  .sgcp-reopen{
    position:fixed;left:14px;bottom:112px;z-index:2147482999;
    display:inline-flex;align-items:center;gap:8px;
    width:58px;height:58px;min-width:58px;min-height:58px;aspect-ratio:1/1;padding:5px 4px 4px;
    justify-content:center;flex-direction:column;gap:2px;box-sizing:border-box;
    border:1px solid rgba(7,19,14,.16);border-radius:50%!important;
    background:#FFD84D;color:#07130E;
    font:800 9px/1 var(--font-sans,'Figtree',system-ui,sans-serif);
    box-shadow:0 8px 26px rgba(2,11,16,.18);cursor:pointer;
  }
  .sgcp-reopen[hidden]{display:none!important}
  /* Mobile: 44px Check-in circle, concentric with the 48px phone CTA
     (sticky bar right padding 12px + 24px phone radius = 36px from edge).
     14px right + 22px radius matches that centre; 8px visual gap above.
     Preserve a >=44px tap target even on narrow phones. */
  @media(max-width:768px){
    .sgcp-reopen{
      left:auto;right:14px;
      bottom:calc(64px + env(safe-area-inset-bottom, 0px));
      width:44px;height:44px;min-width:44px;min-height:44px;
      padding:3px 2px;gap:1px;
      box-shadow:0 3px 10px rgba(23,27,26,.16);
    }
    :global(body.scb-reserve--sg .sgcp-reopen){
      bottom:calc(70px + env(safe-area-inset-bottom, 0px));
    }
    .sgcp-reopen .sgcp-reopen-dot{width:23px;height:23px;font-size:16px}
    .sgcp-reopen .sgcp-reopen-label{font-size:7px;letter-spacing:0}
  }
  @media(max-width:359px){
    /* Narrow bottom bar uses 44px phone CTA and 10px horizontal padding:
       centre is 32px from the right edge. */
    .sgcp-reopen{right:10px}
  }
  @media(min-width:769px) and (max-width:900px){
    .sgcp-reopen{left:auto;right:14px}
  }
  .sgcp-reopen-label{position:static;width:auto;height:auto;overflow:visible;clip:auto;white-space:nowrap;text-transform:uppercase;letter-spacing:.04em}
  .sgcp-reopen-dot{
    width:29px;height:29px;border-radius:50%;display:grid;place-items:center;
    background:#07130E;color:#fff;font:800 19px/1 Arial,sans-serif;
  }
:global(html.sgcp-open .sgb-banner),
  :global(html.sgcp-open .sgb-spacer){display:none!important}
  @media(max-width:600px){
    .sgcp-backdrop{padding:0 10px 10px}
    .sgcp-card{width:min(100%,430px);border-radius:22px;max-height:calc(100dvh - 18px)}
    .sgcp-media{border-radius:22px 22px 0 0;aspect-ratio:16/9}
    .sgcp-body{padding:14px 18px 15px}
    .sgcp-card h2{font-size:24px;margin-top:8px}
    .sgcp-body>p#sgcp-desc{font-size:14px;margin-bottom:8px}
    .sgcp-body li{font-size:13px}
    .sgcp-body ul{margin-bottom:11px}
    .sgcp-cta{min-height:48px;font-size:15px}
    /* Position controlled by the mobile floating shortcut rules above. */
  }
  @media(max-width:360px){
    .sgcp-body{padding:12px 15px 14px}
    .sgcp-card h2{font-size:22px}
  }
  @media(prefers-reduced-motion:reduce){.sgcp-cta{transition:none}}
</style>

<script is:inline>
(() => {
  const root = document.querySelector('[data-sgcp]');
  const reopen = document.querySelector('[data-sgcp-reopen]');
  if (!root || !reopen) return;

  const qs = new URLSearchParams(location.search);
  const path = location.pathname;
  const CONFIG = {
    'st-gallen': { region:'sg', label:'St. Gallen', formId:'st-gallen', image:null, imageAlt:'Praxis Hwang Team' },
    'zuerich-bahnhofstrasse': { region:'zh', label:'Zürich Bahnhofstrasse', formId:'zuerich-bahnhofstrasse', image:'/images/team-hero.jpg', imageAlt:'Das Team von TCM.ch' },
    'zuerich-oerlikon': { region:'zh', label:'Zürich Oerlikon', formId:'zuerich-oerlikon', image:'/images/team-hero.jpg', imageAlt:'Das Team von TCM.ch' },
    'zuerich-hoengg': { region:'zh', label:'Zürich Höngg', formId:'zuerich-hoengg', image:'/images/team-hero.jpg', imageAlt:'Das Team von TCM.ch' },
    'zuerich-hub': { region:'zh', label:'Zürich', formId:null, image:'/images/team-hero.jpg', imageAlt:'Das Team von TCM.ch' },
    'home': { region:'home', label:'TCM.ch', formId:null, image:'/images/team-hero.jpg', imageAlt:'Das Team von TCM.ch' }
  };

  let savedContext = null;
  try { savedContext = sessionStorage.getItem('tcm_location_context'); } catch (_) {}

  // Current page always wins over stale session context.
  let contextId =
    /^\/$/.test(path) ? 'home' :
    /^\/akupunktur-tcm-zuerich\/?$/.test(path) ? 'zuerich-hub' :
    /^\/standorte\/zuerich-bahnhofstrasse\/?$/.test(path) ? 'zuerich-bahnhofstrasse' :
    /^\/standorte\/zuerich-oerlikon\/?$/.test(path) ? 'zuerich-oerlikon' :
    /^\/standorte\/zuerich-hoengg\/?$/.test(path) ? 'zuerich-hoengg' :
    /^\/standorte\/st-gallen\/?$/.test(path) ? 'st-gallen' :
    (qs.get('standort') && CONFIG[qs.get('standort')]) ? qs.get('standort') :
    (savedContext && CONFIG[savedContext] && !/^\/(therapien|beschwerden)\//.test(path)) ? savedContext : null;

  if (!contextId || !CONFIG[contextId]) {
    root.hidden = true;
    reopen.hidden = true;
    return;
  }
  const cfg = CONFIG[contextId];
  const AUTO_KEY = cfg.region === 'home'
    ? 'home_checkin_popup_auto_shown'
    : cfg.region === 'zh' ? 'zh_checkin_popup_auto_shown' : 'sg_checkin_popup_auto_shown';

  // Global seven-day dismissal across all TCM.ch pages (not reset per region).
  const DISMISSED_KEY = 'tcm_checkin_popup_dismissed_until_v2';
  const DISMISS_MS = 7 * 24 * 60 * 60 * 1000;
  const AUTO_DELAY_MS = 45_000;
  const MIN_SCROLL = 0.40;
  const dismissalActive = () => {
    try { return Number(localStorage.getItem(DISMISSED_KEY) || 0) > Date.now(); }
    catch (_) { return false; }
  };
  const rememberDismissal = () => {
    try { localStorage.setItem(DISMISSED_KEY, String(Date.now() + DISMISS_MS)); }
    catch (_) {}
  };

  const kicker = root.querySelector('[data-sgcp-kicker]');
  if (kicker) kicker.textContent = cfg.label + ' · 30 Min kostenlos';
  const img = root.querySelector('[data-sgcp-img]');
  if (img && cfg.image) {
    img.src = cfg.image;
    img.alt = cfg.imageAlt;
    img.width = 1536;
    img.height = 1024;
  }

  const close = root.querySelector('[data-sgcp-close]');
  const cta = root.querySelector('[data-sgcp-cta]');
  let lastFocused = null;

  const push = (event, extra = {}) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event, page_path: location.pathname, popup_context: contextId, ...extra });
  };

  const show = (source = 'auto') => {
    if (!root.hidden) return;
    if (source === 'engaged_45s') {
      try { sessionStorage.setItem(AUTO_KEY, '1'); } catch (_) {}
    }
    lastFocused = document.activeElement;
    root.hidden = false;
    reopen.hidden = true;
    document.documentElement.classList.add('sgcp-open');
    document.documentElement.style.overflow = 'hidden';
    close?.focus({ preventScroll: true });
    push(cfg.region === 'home' ? 'home_checkin_popup_view' : cfg.region === 'zh' ? 'zh_checkin_popup_view' : 'sg_checkin_popup_view', { source });
  };

  const hide = (reason = 'close') => {
    if (root.hidden) return;
    root.hidden = true;
    reopen.hidden = false;
    if (reason !== 'navigation') rememberDismissal();
    document.documentElement.classList.remove('sgcp-open');
    document.documentElement.style.overflow = '';
    push(cfg.region === 'home' ? 'home_checkin_popup_close' : cfg.region === 'zh' ? 'zh_checkin_popup_close' : 'sg_checkin_popup_close', { reason });
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus({ preventScroll: true });
  };

  let autoShown = false;
  try { autoShown = sessionStorage.getItem(AUTO_KEY) === '1'; } catch (_) {}

  // Floating Check-in shortcut is available before and after automatic display.
  reopen.hidden = false;
  let dwellReady = false;
  let bookingStarted = false;
  let timer = null;
  const bookingSurface = '[data-kf], .kf, .inline-form-card, #zh-funnel, #home-contact-form, #offer-form, #anfrage-box';
  const currentBookingHash = () => /^(#(?:zh-funnel|home-contact-form|offer-form|anfrage-box|termin|kontakt|online-buchen|kf-))/.test(location.hash);
  const bookingInProgress = () =>
    bookingStarted || currentBookingHash() ||
    !!document.activeElement?.closest?.(bookingSurface);
  // A booking field or CTA interaction cancels the automatic interruption for this page.
  const markBooking = (event) => {
    if (event.target?.closest?.(bookingSurface)) bookingStarted = true;
  };
  document.addEventListener('focusin', markBooking);
  document.addEventListener('input', markBooking);
  document.addEventListener('change', markBooking);
  document.addEventListener('click', (event) => {
    if (event.target?.closest?.(bookingSurface)) { bookingStarted = true; return; }
    const link = event.target?.closest?.('a[href]');
    if (link && /(?:#(?:zh-funnel|home-contact-form|offer-form|anfrage-box|termin|kontakt|online-buchen)|[?&]terminart=)/.test(link.getAttribute('href') || '')) bookingStarted = true;
  });

  const scrollProgress = () => {
    const doc = document.documentElement;
    const max = Math.max(0, doc.scrollHeight - window.innerHeight);
    return max > 0 ? Math.min(1, window.scrollY / max) : 0;
  };
  const maybeShow = () => {
    if (!dwellReady || autoShown || dismissalActive() || bookingInProgress()) return;
    if (document.visibilityState === 'hidden' || scrollProgress() < MIN_SCROLL) return;
    autoShown = true;
    show('engaged_45s');
    removeEventListener('scroll', maybeShow);
    document.removeEventListener('visibilitychange', maybeShow);
  };
  if (!autoShown && !dismissalActive()) {
    timer = setTimeout(() => { dwellReady = true; maybeShow(); }, AUTO_DELAY_MS);
    addEventListener('scroll', maybeShow, { passive:true });
    document.addEventListener('visibilitychange', maybeShow);
  }

  close?.addEventListener('click', () => hide('button'));
  root.addEventListener('click', (e) => { if (e.target === root) hide('backdrop'); });
  reopen.addEventListener('click', () => show('reopen'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden) hide('escape'); });

  cta?.addEventListener('click', (e) => {
    e.preventDefault();
    if (timer) clearTimeout(timer);
    bookingStarted = true;
    rememberDismissal();

    const card = contextId === 'home'
      ? (document.getElementById('home-contact-form')?.querySelector('.inline-form-card') || document.getElementById('home-contact-form'))
      : contextId === 'zuerich-hub'
      ? (document.getElementById('zh-funnel')?.querySelector('.inline-form-card') || document.getElementById('zh-funnel'))
      : (
        (contextId === 'st-gallen' ? document.querySelector('[data-kf-instance="sg-hero"]') : null) ||
        document.querySelector('[data-kf][data-kf-standort-id="' + cfg.formId + '"]') ||
        document.getElementById('offer-form') ||
        document.querySelector('[data-kf]') ||
        document.querySelector('.inline-form-card')
      );

    const radio = card?.querySelector('input[name="terminart"][value="checkin"]');
    if (radio && !radio.disabled) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    }

    root.hidden = true;
    reopen.hidden = false;
    document.documentElement.classList.remove('sgcp-open');
    document.documentElement.style.overflow = '';

    try {
      const url = new URL(location.href);
      url.searchParams.set('terminart', 'checkin');
      if (cfg.formId) url.searchParams.set('standort', cfg.formId);
      url.hash = contextId === 'home'
        ? 'home-contact-form'
        : contextId === 'zuerich-hub'
        ? 'zh-funnel'
        : document.getElementById('offer-form') ? 'offer-form'
        : document.getElementById('kontakt') ? 'kontakt' : 'termin';
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    } catch (_) {}

    push(
      cfg.region === 'home' ? 'home_checkin_popup_click' : cfg.region === 'zh' ? 'zh_checkin_popup_click' : 'sg_checkin_popup_click',
      { terminart: 'checkin', standort: cfg.formId || (contextId === 'zuerich-hub' ? 'zuerich-routing' : 'offen') }
    );

    const target = contextId === 'home'
      ? document.getElementById('home-contact-form')
      : contextId === 'zuerich-hub'
      ? document.getElementById('zh-funnel')
      : document.getElementById('offer-form') || document.getElementById('kontakt') || card || document.getElementById('termin');
    if (target) {
      requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    }
  });
})();
</script>
