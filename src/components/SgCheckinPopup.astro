---
/**
 * St. Gallen-only conversion popup.
 * Uses the existing SG contact flow; no duplicate form or booking logic.
 */
---
<div class="sgcp-backdrop" data-sgcp hidden>
  <section class="sgcp-card" role="dialog" aria-modal="true" aria-labelledby="sgcp-title" aria-describedby="sgcp-desc">
    <button class="sgcp-close" type="button" aria-label="Fenster schliessen" data-sgcp-close>×</button>
    <div class="sgcp-kicker">30 Minuten kostenlos</div>
    <h2 id="sgcp-title">Unsicher, ob TCM zu dir passt?</h2>
    <p id="sgcp-desc">Lerne uns in St. Gallen kostenlos kennen.</p>
    <ul>
      <li>Persönliche Einschätzung</li>
      <li>Zungen- &amp; Pulsdiagnostik</li>
      <li>Krankenkassen-Check</li>
    </ul>
    <a class="sgcp-cta" href="?terminart=checkin#termin" data-sgcp-cta>
      Gratis Check-in buchen <span aria-hidden="true">→</span>
    </a>
    <p class="sgcp-note">Kostenlos · unverbindlich · ohne Behandlung</p>
  </section>
</div>

<style>
  .sgcp-backdrop{
    position:fixed;inset:0;z-index:2147483000;
    display:grid;place-items:center;padding:18px;
    background:rgba(2,11,16,.48);
    font-family:var(--font-sans,'Figtree',system-ui,sans-serif);
  }
  .sgcp-backdrop[hidden]{display:none!important}
  .sgcp-card{
    position:relative;width:min(100%,620px);max-height:min(760px,calc(100dvh - 36px));
    overflow:auto;box-sizing:border-box;
    background:#F6C84A;color:#07130E;
    border:1px solid rgba(7,19,14,.16);border-radius:28px;
    padding:34px 34px 28px;
    box-shadow:0 28px 80px rgba(2,11,16,.28);
  }
  .sgcp-close{
    position:absolute;top:15px;right:16px;width:40px;height:40px;
    display:grid;place-items:center;border:0;border-radius:999px;
    background:rgba(255,255,255,.55);color:#07130E;
    font:700 28px/1 Arial,sans-serif;cursor:pointer;
  }
  .sgcp-close:hover{background:#fff}
  .sgcp-close:focus-visible,.sgcp-cta:focus-visible{outline:3px solid #07130E;outline-offset:3px}
  .sgcp-kicker{
    display:inline-flex;align-items:center;min-height:29px;padding:0 11px;
    border-radius:999px;background:#07130E;color:#fff;
    font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  }
  .sgcp-card h2{
    margin:17px 46px 8px 0;font-size:clamp(28px,5vw,42px);
    line-height:1.04;letter-spacing:-.035em;font-weight:800;color:#07130E;
  }
  .sgcp-card>p#sgcp-desc{margin:0 0 18px;font-size:18px;line-height:1.45;font-weight:650}
  .sgcp-card ul{list-style:none;margin:0 0 24px;padding:0;display:grid;gap:9px}
  .sgcp-card li{font-size:16px;line-height:1.35;font-weight:650}
  .sgcp-card li::before{content:'✓';display:inline-block;margin-right:10px;font-weight:900}
  .sgcp-cta{
    display:flex;align-items:center;justify-content:center;gap:9px;
    width:100%;min-height:56px;box-sizing:border-box;padding:0 22px;
    border-radius:999px;background:#07130E;color:#fff;text-decoration:none;
    font-size:17px;font-weight:800;letter-spacing:-.01em;
    transition:transform .15s ease,background-color .15s ease;
  }
  .sgcp-cta:hover{background:#123028;transform:translateY(-1px)}
  .sgcp-note{margin:12px 0 0!important;text-align:center;font-size:13px!important;line-height:1.35!important;font-weight:650!important;opacity:.78}
  @media(max-width:600px){
    .sgcp-backdrop{padding:14px}
    .sgcp-card{border-radius:24px;padding:28px 22px 22px}
    .sgcp-card h2{margin-top:14px;font-size:30px}
    .sgcp-card>p#sgcp-desc{font-size:16.5px;margin-bottom:15px}
    .sgcp-card ul{margin-bottom:20px;gap:8px}
    .sgcp-card li{font-size:15px}
    .sgcp-cta{min-height:54px;font-size:16px}
  }
  @media(max-width:360px){
    .sgcp-card{padding:25px 18px 20px}
    .sgcp-card h2{font-size:27px}
  }
  @media(prefers-reduced-motion:reduce){.sgcp-cta{transition:none}}
</style>

<script is:inline>
(() => {
  const root = document.querySelector('[data-sgcp]');
  if (!root) return;

  const close = root.querySelector('[data-sgcp-close]');
  const cta = root.querySelector('[data-sgcp-cta]');
  const storageKey = 'tcm_sg_checkin_popup_closed_v1';
  const clickKey = 'tcm_sg_checkin_popup_clicked_v1';
  const sevenDays = 7 * 24 * 60 * 60 * 1000;
  const thirtyDays = 30 * 24 * 60 * 60 * 1000;
  let shown = false;
  let lastFocused = null;

  const recent = (key, ttl) => {
    try {
      const t = Number(localStorage.getItem(key) || 0);
      return t > 0 && Date.now() - t < ttl;
    } catch (_) { return false; }
  };

  if (recent(storageKey, sevenDays) || recent(clickKey, thirtyDays)) return;

  const push = (event, extra = {}) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event, page_path: location.pathname, ...extra });
  };

  const show = () => {
    if (shown || !root.hidden) return;
    shown = true;
    lastFocused = document.activeElement;
    root.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    close?.focus({ preventScroll: true });
    push('sg_checkin_popup_view');
  };

  const hide = (remember = true, reason = 'close') => {
    if (root.hidden) return;
    root.hidden = true;
    document.documentElement.style.overflow = '';
    if (remember) {
      try { localStorage.setItem(storageKey, String(Date.now())); } catch (_) {}
    }
    push('sg_checkin_popup_close', { reason });
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus({ preventScroll: true });
  };

  const onScroll = () => {
    const doc = document.documentElement;
    const max = Math.max(1, doc.scrollHeight - innerHeight);
    if (scrollY / max >= 0.32) {
      show();
      removeEventListener('scroll', onScroll);
    }
  };

  const timer = setTimeout(show, 10000);
  addEventListener('scroll', onScroll, { passive: true });

  close?.addEventListener('click', () => hide(true, 'button'));
  root.addEventListener('click', (e) => { if (e.target === root) hide(true, 'backdrop'); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden) hide(true, 'escape'); });

  cta?.addEventListener('click', () => {
    clearTimeout(timer);
    try { localStorage.setItem(clickKey, String(Date.now())); } catch (_) {}
    push('sg_checkin_popup_click', { terminart: 'checkin', standort: 'st-gallen' });
    document.documentElement.style.overflow = '';
  });
})();
</script>
