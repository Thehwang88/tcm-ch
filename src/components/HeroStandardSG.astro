---
// SG-specific location-first pilot. Single canonical NAP/practice block,
// then shared patient enquiry form and existing OneDoc widget.
// Never change special campaign (HeroLaunchSG) or other clinic templates.
import { renderKontaktForm } from '../lib/kontakt-form';
import HeroMedia from './standort/HeroMedia.astro';
import { ONEDOC_SG_WIDGET, ONEDOC_SG_WIDGET_2, ONEDOC_SG_WIDGET_URL } from '../data/onedoc-sg';
import { locationTeamHtml } from '../lib/location-team';
import { tabsForm, NETWORK_REVIEW_STRIP as SG_NETWORK_REVIEW_STRIP } from '../lib/form-tabs';
import SgLayoutStyles from './standort/SgLayoutStyles.astro';

// teil: 'oben' (Hero, Formular, OneDoc-Popup, Team) oder 'ende' (Seitenende: offenes OneDoc-Widget + zweites Formular, slot body-insert).
const { sitekey, teil = 'oben' } = Astro.props;
const SG_WA = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen.';
// WhatsApp-Icon der Seite (identischer Pfad wie WA_ICON in lib/kontakt-form.ts), nur für den mobilen Hero-Button.
const WA_SVG = '<svg class="lsr-wa-ic" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>';
// «Über die Praxis» (Text, NAP, Foto, Karte, Anreise) steht seit 20.11.2026 unten auf der Seite
// (standorte/[slug].astro, nach dem FAQ) – hier nur Hero, Formular und OneDoc.
const SG_FORM = {
  standortId: 'st-gallen', quelle: 'launch-hero-sg', seite: '/standorte/st-gallen/',
  wunschzeit: true, sitekey, headingTag: 'h3',
  onedocBeideTerminarten: true, ohneOnedocAlternative: true,
  // 20.11.2026: Gratis-Termin (checkin) zuerst und vorausgewählt (checkinZuerst-Standard der Instanz); explizite
  // Auslöser (data-kf-terminart, ?terminart=, #first30) behalten Vorrang (kontakt-form.js). Angebots-IDs/Tracking unverändert.
  ruhig: true, zusatzOffen: true,
  kopfTitel: 'Termin anfragen',
};
// SG-Karte (20.11.2026, nur diese Instanz): Terminart-Tabs via src/lib/form-tabs.ts; Angebotstexte/Submit/Erfolgsmeldung St. Gallen.
const SG_PANEL_A = '<div class="sgf-panel sgf-panel--checkin"><p class="sgf-t">Dein erster Termin ist <em class="sgf-accent">gratis</em></p><p class="sgf-line">30 Minuten, kostenlos, für Neupatient:innen in St. Gallen.</p>' +
  '<ul class="sgf-list"><li>TCM-Check und ausführliches Erstgespräch</li><li>Einschätzung durch anerkannte Therapeut:innen (EMR/ASCA)</li><li>Erste Akupunktur noch in derselben Sitzung</li><li>Ehrliche Einschätzung, ob TCM bei dir hilft. Wenn nicht, sagen wir es dir.</li></ul></div>';
const SG_PANEL_B = '<div class="sgf-panel sgf-panel--behandlung"><p class="sgf-t">Ersttermin mit Behandlung</p><p class="sgf-line">90 Minuten: persönliches Gespräch, TCM-Diagnostik und erste Behandlung. Krankenkasse anerkannt, Zusatzversicherung je nach Police.</p></div>';
const sgForm = (raw: string, p: string, cardId: string) => tabsForm(raw, {
  p, cardId, panelA: SG_PANEL_A, panelB: SG_PANEL_B, submitCheckin: 'Gratis Erstgespräch anfragen',
  okCheckin: 'Deine Anfrage: Gratis-Ersttermin, 30 Min., inkl. erster Akupunktur in St. Gallen. Wir melden uns per WhatsApp oder Telefon zur Terminvereinbarung.',
});
// Oben: Hero-Formular (#offer-form, Instanz sg-hero, historische Anker). Ende: zweites Formular (#offer-form-ende, Instanz sg-ende),
// gleiche Tabs/Angebot/Pflichtfelder, eigene IDs und eigenes Turnstile; Versand/dataLayer wie oben (kontakt-form.js je Karte).
const card = teil === 'ende' ? '' : sgForm(renderKontaktForm({
  ...SG_FORM, instance: 'sg-hero', cardId: 'offer-form',
  // Both historical anchors must continue working, including legacy check-in links.
  compatAnchors: ['first30', 'termin-formular'],
  formName: 'Hero-Termin-StGallen', formular: 'Hero-Termin-StGallen', quelleDetail: 'Hero St. Gallen · reguläres Terminformular',
}), 'kf-sg-hero', 'offer-form');
const cardEnde = teil === 'ende' ? sgForm(renderKontaktForm({
  ...SG_FORM, instance: 'sg-ende', cardId: 'offer-form-ende',
  formName: 'Ende-Termin-StGallen', formular: 'Ende-Termin-StGallen', quelleDetail: 'Seitenende St. Gallen · Terminformular',
}), 'kf-sg-ende', 'offer-form-ende') : '';
---
{teil !== 'ende' && (<>
<section class="lsr-hero hlsg">
  <div class="lsr-inner">
    <div class="lsr-left">
      <span class="lsr-eyebrow">TCM.ch Praxis · St. Gallen</span>
      <h1 class="lsr-h1">Akupunktur &amp; TCM in <span class="lsr-accent">St. Gallen</span></h1>
      <p class="lsr-lead"><span class="lsr-lead-d">Persönliche TCM und Akupunktur am Oberen Graben, nahe dem Bahnhof St. Gallen.</span><span class="lsr-lead-m">Am Oberen Graben, nahe dem Bahnhof.</span></p>
      <div class="lsr-ctas">
        <a href="#termin-formular" class="lsr-btn-primary tcm-btn tcm-btn--primary tcm-btn--hero" data-booking-sheet="sg" data-booking-wish="checkin" data-kf-terminart="checkin" data-care-cta="hero-checkin">30 Min. gratis Termin anfragen ⚡️</a>
        <a href="#online-buchen" class="lsr-btn-ghost tcm-btn tcm-btn--outline tcm-btn--hero lsr-d" data-onedoc-sheet data-care-cta="hero-onedoc">Termin online buchen</a>
        {/* Mobile (bis 640px): WhatsApp als zweiter Button im Outline-Stil; «Online buchen» wandert in die Textlink-Zeile. */}
        <a href={SG_WA} target="_blank" rel="noopener noreferrer" class="lsr-btn-ghost tcm-btn tcm-btn--outline tcm-btn--hero lsr-m" data-care-cta="hero-wa"><Fragment set:html={WA_SVG} /> Per WhatsApp schreiben</a>
      </div>
      <p class="lsr-quick">
        <a href="#online-buchen" class="lsr-m" data-onedoc-sheet data-care-cta="hero-onedoc">Online buchen</a><span class="lsr-m" aria-hidden="true">·</span><a href="tel:+41775236122" data-kf-tel data-care-cta="hero-tel">Anrufen</a><span class="lsr-d" aria-hidden="true">·</span><a href={SG_WA} target="_blank" rel="noopener noreferrer" class="lsr-d" data-care-cta="hero-wa">WhatsApp</a><span aria-hidden="true">·</span><a href="#sg-standort" data-care-cta="hero-anfahrt">Anfahrt</a>
      </p>
      <ul class="lsr-usp">
        <li><span class="lsr-check" aria-hidden="true">✓</span>Krankenkassen anerkannt (EMR/ASCA)</li>
        <li><span class="lsr-check" aria-hidden="true">✓</span>Oberer Graben 22, St. Gallen</li>
        <li><span class="lsr-check" aria-hidden="true">✓</span>Kurzfristige Termine verfügbar</li>
      </ul>
      <a class="lsr-tlink" href="#sg-therapien" data-sg-therapie-link hidden></a>
    </div>
    <HeroMedia id="sg-hero-media" />
  </div>
</section>

{/* OneDoc-Popup (gleiche Dialog-Hülle wie #tcm-booking-sheet). Das bestehende Embed aus #online-buchen wird beim Öffnen
    hineinverschoben (Widget lädt erst dann, Listener/Tracking bleiben) und beim Schliessen zurückgestellt. */}
<dialog id="sg-onedoc-sheet" class="tcm-booking-sheet" aria-labelledby="sg-onedoc-sheet-title">
  <div class="tcm-booking-panel">
    <div class="tcm-booking-head">
      <span class="tcm-booking-grip" aria-hidden="true"></span>
      <div class="tcm-booking-heading">
        <span class="tcm-booking-overline">TCM.ch St. Gallen · OneDoc</span>
        <h2 id="sg-onedoc-sheet-title">Termin online buchen.</h2>
        <p>Freie Termine direkt im Kalender der Praxis wählen.</p>
      </div>
      <button type="button" class="tcm-booking-close" aria-label="Online-Buchung schliessen" data-onedoc-close autofocus>×</button>
    </div>
    <div class="tcm-booking-scroll" tabindex="-1">
      <div class="tcm-booking-content" data-onedoc-content></div>
    </div>
  </div>
</dialog>
<script is:inline>
(function(){
  var d=document.getElementById('sg-onedoc-sheet'),slot=d&&d.querySelector('[data-onedoc-content]');
  if(!d||!slot||!d.showModal)return;
  var origin=null,trigger=null,body=null;
  document.addEventListener('click',function(e){
    var btn=e.target&&e.target.closest?e.target.closest('[data-onedoc-sheet]'):null;
    if(!btn||e.defaultPrevented||e.button||e.ctrlKey||e.metaKey||e.altKey||e.shiftKey||d.open)return;
    body=document.querySelector('#online-buchen .sgt-onedoc-body');
    if(!body||!body.parentNode)return;
    e.preventDefault();
    origin=document.createComment('onedoc-sheet-origin');
    body.parentNode.insertBefore(origin,body);
    slot.appendChild(body);
    trigger=btn;
    try{d.showModal();}catch(err){origin.replaceWith(body);origin=null;trigger=null;return;}
    var s=d.querySelector('.tcm-booking-scroll');if(s)s.scrollTop=0;
    var c=d.querySelector('[data-onedoc-close]');if(c)c.focus({preventScroll:true});
  },true);
  d.addEventListener('click',function(e){if(e.target===d||e.target.closest('[data-onedoc-close]'))d.close();});
  d.addEventListener('close',function(){
    if(origin&&origin.parentNode&&body)origin.replaceWith(body);
    origin=null;body=null;
    if(trigger&&trigger.isConnected)trigger.focus({preventScroll:true});
    trigger=null;
  });
})();
</script>

{/* Formular allein direkt unter dem Hero (einspaltig, zentriert); Bewertungszeile direkt über der Karte. */}
<section class="sgt sgt--location-first sgt--formular" aria-label="Termin St. Gallen">
  <div class="sgt-wrap sgt-grid sgt-grid--single">
    <div class="sgt-main" aria-labelledby="sgt-h">
      <span id="termin" class="sgt-anchor" aria-hidden="true"></span>
      <div class="sgt-head">
        <h2 class="section-title" id="sgt-h">Termin in <em>St. Gallen</em></h2>
        <p class="sgt-sub">Gratis-Ersttermin mit erster Akupunktur (30 Minuten) oder Ersttermin mit Behandlung. Wir melden uns persönlich.</p>
      </div>
      <Fragment set:html={SG_NETWORK_REVIEW_STRIP} />
      <div class="sgt-form"><Fragment set:html={card} /></div>
      <details class="sgt-onedoc" id="online-buchen">
        <summary data-care-cta="termin-karte-checkin">
          <span>Oder direkt online buchen (OneDoc)</span>
          <span class="sgt-onedoc-arrow" aria-hidden="true">+</span>
        </summary>
        <div class="sgt-onedoc-body">
          <p class="sgt-od-sub">Wähle im Kalender den Gratis-Ersttermin (30 Min., inkl. erster Akupunktur) oder den passenden Behandlungstermin.</p>
          <Fragment set:html={ONEDOC_SG_WIDGET} />
          <p class="sgt-od-fallback">Kalender nicht sichtbar? <a href={ONEDOC_SG_WIDGET_URL} target="_blank" rel="noopener noreferrer">OneDoc direkt öffnen <span aria-hidden="true">↗</span></a></p>
        </div>
      </details>
    </div>
  </div>
</section>

<Fragment set:html={locationTeamHtml('st-gallen', 'St. Gallen')} />
</>)}

{teil === 'ende' && (<>
{/* Seitenende (slot body-insert, nach «Über die Praxis»/«Weiterlesen», vor dem CARE-Concierge): offenes OneDoc-Widget, dann das zweite Formular. */}
<section class="sgt sgt--location-first sgt--ende sgt--ende-onedoc" id="online-buchen-unten" aria-labelledby="sg-ob-h">
  <div class="sgt-wrap sgt-grid sgt-grid--single">
    <div class="sgt-main">
      <div class="sgt-head">
        <span class="sgt-eyebrow">Online-Buchung</span>
        <h2 class="section-title" id="sg-ob-h">Bereit für deinen Termin?</h2>
        <p class="sgt-sub">Wähle direkt einen freien Termin in St. Gallen, Bestätigung sofort per E-Mail. Frage vorher? <a href={SG_WA} target="_blank" rel="noopener noreferrer" data-care-cta="ende-wa">Per WhatsApp</a></p>
      </div>
      <div class="sgt-onedoc-open">
        <Fragment set:html={ONEDOC_SG_WIDGET_2} />
        <p class="sgt-od-fallback">Kalender nicht sichtbar? <a href={ONEDOC_SG_WIDGET_URL} target="_blank" rel="noopener noreferrer">OneDoc direkt öffnen <span aria-hidden="true">↗</span></a></p>
      </div>
    </div>
  </div>
</section>
<section class="sgt sgt--location-first sgt--ende sgt--ende-form" id="anfrage-unten" aria-labelledby="sg-ende-h">
  <div class="sgt-wrap sgt-grid sgt-grid--single">
    <div class="sgt-main">
      <div class="sgt-head">
        <span class="sgt-eyebrow">Anfrage senden</span>
        <h2 class="section-title" id="sg-ende-h">Gratis Ersttermin anfragen</h2>
        <p class="sgt-sub">Schick uns dein Anliegen und wir melden uns bei dir.</p>
      </div>
      <div class="sgt-form"><Fragment set:html={cardEnde} /></div>
    </div>
  </div>
</section>
</>)}

<SgLayoutStyles />
{teil !== 'ende' && (<>
<script is:inline>
  // Preserve old direct links (#online-buchen) used by OneDoc, FAQ, banners,
  // and clinic dropdowns, even though the embedded calendar is now optional.
  (function(){
    var panel=document.getElementById('online-buchen');
    if(!panel)return;
    var openForHash=function(){ if(location.hash==='#online-buchen') panel.open=true; };
    openForHash();
    window.addEventListener('hashchange',openForHash);
    document.addEventListener('click',function(e){
      // Hero-Links mit data-onedoc-sheet öffnen das Popup (Body wird dorthin verschoben), nicht die Karte.
      var link=e.target.closest&&e.target.closest('a[href="#online-buchen"]:not([data-onedoc-sheet])');
      if(link)panel.open=true;
    });
  })();
</script>
<script is:inline>
  // Ads-Parameter ?t=schroepfen|akupunktur|tuina|beschwerden (nur clientseitig; statischer Inhalt/Canonical bleibt «Akupunktur & TCM»):
  // H1 + Unterzeile je Therapie, Textlink unter den Buttons zur Therapie-/Beschwerden-Sektion, optional Hero-Bild (Bilder aus
  // /therapien/*, Video dann aus), «Dein Anliegen» vorbelegt, dataLayer-Variable therapy. Nur bekannte Werte, nie Nutzertext.
  (function () {
    var SG = '<span class="lsr-accent">St. Gallen</span>';
    var T = {
      schroepfen: { h1: 'Schröpfen in ' + SG, lead: 'Schröpfen und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Schröpfen bei uns', ziel: '#sg-therapien', anliegen: 'Schröpfen' },
      akupunktur: { h1: 'Akupunktur in ' + SG, lead: 'Akupunktur und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Akupunktur bei uns', ziel: '#sg-therapien', anliegen: 'Akupunktur' },
      tuina: { h1: 'Tuina in ' + SG, lead: 'Tuina und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Tuina bei uns', ziel: '#sg-therapien', anliegen: 'Tuina' },
      beschwerden: { lead: 'Rücken, Nacken, Migräne, Schlaf: wir schauen uns deine Beschwerden beim kostenlosen Check-in an.', link: 'Mehr zu Beschwerden bei uns', ziel: '#sg-beschwerden', anliegen: 'Beschwerden' }
    };
    var t = ''; try { t = (new URLSearchParams(location.search).get('t') || '').toLowerCase(); } catch (e) {}
    var c = T[t]; if (!c) return;
    try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ therapy: t }); } catch (e) {}
    var h1 = document.querySelector('.lsr-hero.hlsg .lsr-h1'); if (h1 && c.h1) h1.innerHTML = c.h1;
    var lead = document.querySelector('.lsr-hero.hlsg .lsr-lead'); if (lead) lead.textContent = c.lead;
    var link = document.querySelector('[data-sg-therapie-link]'); if (link) { link.textContent = c.link + ' \u2193'; link.setAttribute('href', c.ziel); link.hidden = false; }
    var ta = document.querySelector('[data-kf-instance="sg-hero"] textarea[name="anliegen"]');
    if (ta && !ta.value) { ta.value = c.anliegen; try { ta.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {} }
  })();
</script>
</>)}
