---
// SG-specific location-first pilot. Single canonical NAP/practice block,
// then shared patient enquiry form and existing OneDoc widget.
// Never change special campaign (HeroLaunchSG) or other clinic templates.
import { renderKontaktForm } from '../lib/kontakt-form';
import HeroMedia from './standort/HeroMedia.astro';
import { ONEDOC_SG_WIDGET, ONEDOC_SG_WIDGET_URL } from '../data/onedoc-sg';
import { locationTeamHtml } from '../lib/location-team';
import { clinics } from '../data/locations';

const { sitekey } = Astro.props;
const SG_WA = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen.';
// Hero-Infozeile aus den Standortdaten (locations.ts), nicht hart codiert.
const SG = clinics.find((c) => c.id === 'st-gallen');
if (!SG) throw new Error('HeroStandardSG: Standortdaten st-gallen fehlen');
const SG_INFO = `${SG.street}, ${SG.postalCode} ${SG.city} · ${SG.openingHours.join(' · ')}`;
// «Über die Praxis» (Text, NAP, Foto, Karte, Anreise) steht seit 20.11.2026 unten auf der Seite
// (standorte/[slug].astro, nach dem FAQ) – hier nur Hero, Formular und OneDoc.
// Reuse the exact *network-wide* aggregate figures currently published on
// /kontakt/. Do not label these as reviews of St. Gallen alone.
const SG_NETWORK_REVIEW_STRIP = `
  <div class="sgt-network-proof" aria-label="TCM.ch Netzwerk: 4.89 von 5 Sternen aus über tausend Rezensionen">
    <div class="sgt-network-proof-label">
      <strong>Patientenbewertungen</strong>
      <span>TCM.ch Netzwerk · standortübergreifend</span>
    </div>
    <div class="sgt-network-proof-metrics">
      <div class="sgt-network-proof-metric">
        <strong>4.89</strong>
        <span class="sgt-network-proof-stars" aria-label="4.89 von 5 Sternen">★★★★★</span>
      </div>
      <div class="sgt-network-proof-metric sgt-network-proof-count">
        <strong>1'000+</strong>
        <span>Rezensionen</span>
      </div>
    </div>
  </div>`;
const cardRaw = renderKontaktForm({
  instance: 'sg-hero', standortId: 'st-gallen', cardId: 'offer-form',
  // Both historical anchors must continue working, including legacy check-in links.
  compatAnchors: ['first30', 'termin-formular'],
  quelle: 'launch-hero-sg', formName: 'Hero-Termin-StGallen', formular: 'Hero-Termin-StGallen',
  quelleDetail: 'Hero St. Gallen · reguläres Terminformular', seite: '/standorte/st-gallen/',
  wunschzeit: true, sitekey, headingTag: 'h3',
  onedocBeideTerminarten: true, ohneOnedocAlternative: true,
  // 20.11.2026: Gratis-Termin (checkin) zuerst und vorausgewählt (checkinZuerst-Standard der Instanz); explizite
  // Auslöser (data-kf-terminart, ?terminart=, #first30) behalten Vorrang (kontakt-form.js). Angebots-IDs/Tracking unverändert.
  ruhig: true, zusatzOffen: true,
  kopfTitel: 'Termin anfragen',
});
// SG-Karte (20.11.2026, nur diese Instanz): Terminart-Radios als zwei Tabs, Angebotstext je Tab, vier Felder mit
// Platzhaltern (Labels nur für Screenreader), ohne Anliegen/Hinweise, Turnstile nur bei Bedarf sichtbar.
// Reine String-Anpassung der gerenderten Karte; die geteilte Komponente und ihr JS bleiben unverändert. Guards statt stiller Fallbacks.
const sub = (from: string | RegExp, to: string, name: string) => {
  const n = typeof from === 'string' ? card.split(from).length - 1 : (card.match(from) || []).length;
  if (n !== 1) throw new Error(`HeroStandardSG: SG-Formular «${name}» ${n === 0 ? 'nicht' : 'mehrfach'} gefunden - kontakt-form.ts geändert?`);
  card = card.replace(from, to);
};
let card = cardRaw;
// SSR lässt die Radios ungesetzt (JS wählt den Standard checkin), damit ?terminart=behandlung / #first30 / data-kf-terminart Vorrang haben.
sub('value="checkin" checked data-kf-angebot="TCM_CHECKIN"', 'value="checkin" data-kf-angebot="TCM_CHECKIN"', 'Check-in-Radio');
sub('class="inline-form-card kf kf--ruhig kf--gelb" id="offer-form"', 'class="inline-form-card kf kf--ruhig kf--gelb kf--checkin sgf" id="offer-form"', 'Karte');
sub('data-kf-default="checkin" data-kf-submit-checkin="Gratis Check-in anfragen"',
  'data-kf-default="checkin" data-kf-ok-checkin="Deine Anfrage: Gratis-Ersttermin, 30 Min., inkl. erster Akupunktur in St. Gallen. Wir melden uns per WhatsApp oder Telefon zur Terminvereinbarung." data-kf-submit-checkin="Gratis Erstgespräch anfragen"', 'Submit-Label Check-in');
sub('<p class="kf-kopf-sub">TCM zuerst kennenlernen oder direkt starten.</p>', '', 'Kopf-Subline');
sub('<span class="kf-opt-t">Kostenloser TCM 360°-Check-in</span><span class="kf-opt-gueltig" data-kf-gueltig hidden>Buchung bis <span data-kf-gueltig-bis></span>, Termin auch später möglich.</span><span class="kf-opt-dur">30 Minuten</span><span class="kf-opt-d">Persönlicher TCM-Kurzcheck mit Zungen- und Pulsdiagnostik, Zeit für deine Fragen und Krankenkassen-Check.</span><span class="kf-opt-note">Ohne Behandlung. Unverbindlich.</span>',
  '<span class="kf-opt-t">30 Min. gratis</span>', 'Tab A');
sub('<span class="kf-opt-t">Ersttermin mit Behandlung</span><span class="kf-opt-dur">90 Minuten · Krankenkasse anerkannt (Zusatzversicherung)</span><span class="kf-opt-d">Persönliches Gespräch, TCM-Diagnostik und erste Behandlung.</span>',
  '<span class="kf-opt-t">Ersttermin mit Behandlung</span>', 'Tab B');
sub('</fieldset>',
  '</fieldset>' +
  '<div class="sgf-panel sgf-panel--checkin"><p class="sgf-t">Dein erster Termin ist <em class="sgf-accent">gratis</em></p><p class="sgf-line">30 Minuten, kostenlos, für Neupatient:innen in St. Gallen.</p>' +
  '<ul class="sgf-list"><li>TCM-Check und ausführliches Erstgespräch</li><li>Einschätzung durch anerkannte Therapeut:innen (EMR/ASCA)</li><li>Erste Akupunktur noch in derselben Sitzung</li><li>Ehrliche Einschätzung, ob TCM bei dir hilft. Wenn nicht, sagen wir es dir.</li></ul></div>' +
  '<div class="sgf-panel sgf-panel--behandlung"><p class="sgf-t">Ersttermin mit Behandlung</p><p class="sgf-line">90 Minuten: persönliches Gespräch, TCM-Diagnostik und erste Behandlung. Krankenkasse anerkannt, Zusatzversicherung je nach Police.</p></div>', 'Tab-Inhalte');
sub('for="kf-sg-hero-name">Dein Name <span', 'for="kf-sg-hero-name">Name <span', 'Label Name');
sub('placeholder="Vor- und Nachname"', 'placeholder="Name"', 'Platzhalter Name');
sub('for="kf-sg-hero-tel">Telefonnummer <span', 'for="kf-sg-hero-tel">Handynummer <span', 'Label Handynummer');
sub('placeholder="Deine Telefonnummer" required aria-required="true" aria-describedby="kf-sg-hero-tel-hint kf-sg-hero-tel-err"', 'placeholder="Handynummer" required aria-required="true" aria-describedby="kf-sg-hero-tel-err"', 'Platzhalter Handynummer');
sub('<p class="kf-fhint" id="kf-sg-hero-tel-hint">Wir rufen dich zur Terminvereinbarung zurück.</p>', '', 'Telefon-Hinweis');
sub('placeholder="name@beispiel.ch"', 'placeholder="E-Mail"', 'Platzhalter E-Mail');
sub(/<div class="kf-field"><label class="kf-label" for="kf-sg-hero-anliegen">[\s\S]*?<p class="kf-ferr" id="kf-sg-hero-anliegen-err" hidden><\/p><\/div>/, '', 'Feld Anliegen');
sub('placeholder="z. B. Do Nachmittag"', 'placeholder="Wunschzeit (z. B. Do Nachmittag)"', 'Platzhalter Wunschzeit');
sub('<p class="kf-req"><span aria-hidden="true">*</span> Pflichtfeld</p>', '', 'Pflichtfeld-Hinweis');
sub('data-appearance="always"', 'data-appearance="interaction-only"', 'Turnstile');
sub('data-kf-submit>Gratis Check-in anfragen <span', 'data-kf-submit>Gratis Erstgespräch anfragen <span', 'Submit-Text');
sub('<p class="kf-legal kf-legal--kurz">', '<p class="sgf-note">Unverbindlich. Bestätigung per WhatsApp oder Telefon.</p><p class="kf-legal kf-legal--kurz">', 'Hinweis unter dem Button');
---
<section class="lsr-hero hlsg">
  <div class="lsr-inner">
    <div class="lsr-left">
      <span class="lsr-eyebrow">TCM.ch Praxis · St. Gallen</span>
      <h1 class="lsr-h1">Akupunktur &amp; TCM in <span class="lsr-accent">St. Gallen</span></h1>
      <p class="lsr-lead">Persönliche TCM und Akupunktur am Oberen Graben, nahe dem Bahnhof St. Gallen.</p>
      <div class="lsr-trust">
        <div><span class="lsr-check" aria-hidden="true">✓</span> EMR-/ASCA-anerkannte Fachpersonen · Zusatzversicherung je nach Police</div>
      </div>
      <div class="lsr-ctas">
        <a href="#termin-formular" class="lsr-btn-primary tcm-btn tcm-btn--primary tcm-btn--hero" data-booking-sheet="sg" data-booking-wish="checkin" data-kf-terminart="checkin" data-care-cta="hero-checkin">30 Min. gratis Termin anfragen ⚡️</a>
        <a href="#online-buchen" class="lsr-btn-ghost tcm-btn tcm-btn--outline tcm-btn--hero" data-onedoc-sheet data-care-cta="hero-onedoc">Termin online buchen</a>
      </div>
      <p class="lsr-quick">
        <a href="tel:+41775236122" data-kf-tel data-care-cta="hero-tel">Anrufen</a><span aria-hidden="true">·</span><a href={SG_WA} target="_blank" rel="noopener noreferrer" data-care-cta="hero-wa">WhatsApp</a><span aria-hidden="true">·</span><a href="#sg-standort" data-care-cta="hero-anfahrt">Anfahrt</a>
      </p>
      <p class="lsr-info">{SG_INFO}</p>
      <a class="lsr-tlink" href="#sg-therapien" data-sg-therapie-link hidden></a>
    </div>
    <HeroMedia id="sg-hero-media" />
  </div>
</section>

{/* OneDoc-Popup (gleiche Dialog-Hülle wie #tcm-booking-sheet). Das bestehende Embed aus #online-buchen wird beim Öffnen
    hineinverschoben (Widget lädt erst dann, Listener/Tracking bleiben) und beim Schliessen zurückgestellt. */}
<dialog id="sg-onedoc-sheet" class="tcm-booking-sheet" aria-labelledby="sg-onedoc-sheet-title">
  <div class="tcm-booking-panel">
    <div class="tcm-booking-head">
      <span class="tcm-booking-grip" aria-hidden="true"></span>
      <div class="tcm-booking-heading">
        <span class="tcm-booking-overline">TCM.ch St. Gallen · OneDoc</span>
        <h2 id="sg-onedoc-sheet-title">Termin online buchen.</h2>
        <p>Freie Termine direkt im Kalender der Praxis wählen.</p>
      </div>
      <button type="button" class="tcm-booking-close" aria-label="Online-Buchung schliessen" data-onedoc-close autofocus>×</button>
    </div>
    <div class="tcm-booking-scroll" tabindex="-1">
      <div class="tcm-booking-content" data-onedoc-content></div>
    </div>
  </div>
</dialog>
<script is:inline>
(function(){
  var d=document.getElementById('sg-onedoc-sheet'),slot=d&&d.querySelector('[data-onedoc-content]');
  if(!d||!slot||!d.showModal)return;
  var origin=null,trigger=null,body=null;
  document.addEventListener('click',function(e){
    var btn=e.target&&e.target.closest?e.target.closest('[data-onedoc-sheet]'):null;
    if(!btn||e.defaultPrevented||e.button||e.ctrlKey||e.metaKey||e.altKey||e.shiftKey||d.open)return;
    body=document.querySelector('#online-buchen .sgt-onedoc-body');
    if(!body||!body.parentNode)return;
    e.preventDefault();
    origin=document.createComment('onedoc-sheet-origin');
    body.parentNode.insertBefore(origin,body);
    slot.appendChild(body);
    trigger=btn;
    try{d.showModal();}catch(err){origin.replaceWith(body);origin=null;trigger=null;return;}
    var s=d.querySelector('.tcm-booking-scroll');if(s)s.scrollTop=0;
    var c=d.querySelector('[data-onedoc-close]');if(c)c.focus({preventScroll:true});
  },true);
  d.addEventListener('click',function(e){if(e.target===d||e.target.closest('[data-onedoc-close]'))d.close();});
  d.addEventListener('close',function(){
    if(origin&&origin.parentNode&&body)origin.replaceWith(body);
    origin=null;body=null;
    if(trigger&&trigger.isConnected)trigger.focus({preventScroll:true});
    trigger=null;
  });
})();
</script>

{/* Formular allein direkt unter dem Hero (einspaltig, zentriert); Bewertungszeile direkt über der Karte. */}
<section class="sgt sgt--location-first sgt--formular" aria-label="Termin St. Gallen">
  <div class="sgt-wrap sgt-grid sgt-grid--single">
    <div class="sgt-main" aria-labelledby="sgt-h">
      <span id="termin" class="sgt-anchor" aria-hidden="true"></span>
      <div class="sgt-head">
        <h2 class="section-title" id="sgt-h">Termin in <em>St. Gallen</em></h2>
        <p class="sgt-sub">Gratis-Ersttermin mit erster Akupunktur (30 Minuten) oder Ersttermin mit Behandlung. Wir melden uns persönlich.</p>
      </div>
      <Fragment set:html={SG_NETWORK_REVIEW_STRIP} />
      <div class="sgt-form"><Fragment set:html={card} /></div>
      <details class="sgt-onedoc" id="online-buchen">
        <summary data-care-cta="termin-karte-checkin">
          <span>Oder direkt online buchen (OneDoc)</span>
          <span class="sgt-onedoc-arrow" aria-hidden="true">+</span>
        </summary>
        <div class="sgt-onedoc-body">
          <p class="sgt-od-sub">Wähle im Kalender den Gratis-Ersttermin (30 Min., inkl. erster Akupunktur) oder den passenden Behandlungstermin.</p>
          <Fragment set:html={ONEDOC_SG_WIDGET} />
          <p class="sgt-od-fallback">Kalender nicht sichtbar? <a href={ONEDOC_SG_WIDGET_URL} target="_blank" rel="noopener noreferrer">OneDoc direkt öffnen <span aria-hidden="true">↗</span></a></p>
        </div>
      </details>
    </div>
  </div>
</section>

<Fragment set:html={locationTeamHtml('st-gallen', 'St. Gallen')} />

<style is:global>
  /* SG-only. Other data-driven clinic templates stay untouched. */
  /* Visual balance: center the copy BLOCK inside the left hero half while
     keeping its typography left-aligned. Match video center vertically. */
