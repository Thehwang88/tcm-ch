---
// Regulärer St.-Gallen-Hero. Linke Hälfte: Original-Text vor der FIRST-30-Kampagne aus Commit 4adc79c8 (ohne die
// Hinweise «Unverbindliche Anfrage…» und «Geöffnet: …», entfernt auf Inhaber-Wunsch; Öffnungszeiten stehen in «Über
// die Praxis» und im Schema). Rechts: kompakte Karte (heroKompakt).
// (HeroLaunchSG.astro, «fix(st-gallen): first-treatment bullet …», 12.10.2026). Rechte Hälfte (seit 15.10.2026):
// gemeinsames Kontaktformular (src/lib/kontakt-form.ts) mit kostenlosem TCM-Check-in (SG freigegeben) und
// «Ersttermin mit Behandlung» (OneDoc). Anker-Kompatibilität: #offer-form (Karte), #first30 (alte Kampagnenlinks).
// Bestehende Identifier bleiben: quelle=launch-hero-sg, Formularname, Quelle/Seite-Felder (Messplan docs/cro/04).
import { renderKontaktForm } from '../lib/kontakt-form';
const { sitekey } = Astro.props;
const card = renderKontaktForm({
  instance: 'sg-hero', standortId: 'st-gallen', cardId: 'offer-form', compatAnchors: ['first30'],
  quelle: 'launch-hero-sg', formName: 'Hero-Gratis-30min-StGallen', formular: 'Hero-Gratis-30min-StGallen',
  quelleDetail: 'Hero St. Gallen Neueroeffnung', seite: '/standort/st-gallen',
  wunschzeit: true, sitekey, headingTag: 'h2', onedocBeideTerminarten: true, heroKompakt: true,
});
---
<section class="lsr-hero hlsg">
  <div class="lsr-inner">
    <div class="lsr-left">
      <span class="lsr-eyebrow">TCM.ch Praxis · St. Gallen</span>
      <h1 class="lsr-h1">Akupunktur &amp; TCM in <span class="lsr-accent">St. Gallen</span></h1>
      <p class="lsr-lead">Medizinisch fundierte TCM wenige Gehminuten vom Bahnhof St. Gallen. Wir begleiten dich persönlich, egal worum es geht.</p>
      <div class="lsr-trust">
        <div><span class="lsr-check">✓</span> Krankenkassen anerkannt (EMR/ASCA)</div>
        <div><span class="lsr-check">✓</span> Oberer Graben 22, St. Gallen</div>
        <div><span class="lsr-check">✓</span> Termin direkt anfragen</div>
      </div>
      <div class="lsr-ctas">
        <a href="#offer-form" class="lsr-btn-primary">Ersttermin anfragen</a>
        <a href="#online-buchen" class="lsr-btn-ghost">Termin direkt online buchen</a>
      </div>
      <p class="lsr-tert"><a href="tel:+41775236122">Anrufen</a> · <a href="https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen." target="_blank" rel="noopener">WhatsApp</a></p>
    </div>
    <div class="hlsg-formcol" set:html={card} />
  </div>
</section>

<style is:global>
  .hlsg .hlsg-formcol { display: flex; align-items: center; justify-content: center; min-width: 0;
    padding: clamp(28px, 4vw, 56px) clamp(16px, 4vw, 56px); }
  .hlsg .hlsg-formcol .kf { width: 100%; max-width: 560px; box-shadow: 0 24px 60px -24px rgba(2, 11, 16, .35); }
  @media (min-width: 901px) {
    .hlsg .lsr-left { align-self: start; position: sticky; top: calc(var(--header-h, 76px) + 24px); }
  }
  @media (max-width: 900px) {
    .hlsg .lsr-inner { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .hlsg .hlsg-formcol { padding: 0 16px 32px; }
  }
</style>
