---
// SG-specific location-first pilot. Single canonical NAP/practice block,
// then shared patient enquiry form and existing OneDoc widget.
// Never change special campaign (HeroLaunchSG) or other clinic templates.
import { renderKontaktForm } from '../lib/kontakt-form';
import HeroMedia from './standort/HeroMedia.astro';
import { ONEDOC_SG_WIDGET, ONEDOC_SG_WIDGET_URL } from '../data/onedoc-sg';
import { getTherapeut, getPublicTherapistProfile, teamCardHtml } from '../data/therapeuten';

const { sitekey, praxisHtml = '' } = Astro.props;
const SG_WA = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen.';
const SG_MAPS = 'https://www.google.com/maps/place/TCM.ch+St+Gallen/@47.423225,9.3740224,17z/data=!4m8!3m7!1s0x479b1fa8422eee23:0x4d9e5b1cb4999c7!8m2!3d47.423225!4d9.3740224!9m1!1b1';

// Build-time guard: preserve the leaf's real NAP, hours, image, map and routes.
// The long prose is redundant after the hero; remove only that single intro paragraph.
if (!praxisHtml.includes('<h2 class="up-h2">Über die Praxis</h2>') ||
    !praxisHtml.includes('Oberer Graben 22, 9000 St. Gallen') ||
    !praxisHtml.includes('id=') && !praxisHtml.includes('class="up-map"') ||
    !praxisHtml.includes('sgt-practice-photo')) {
  throw new Error('HeroStandardSG: canonical clinic facts/map/photo not found');
}
const pra = praxisHtml
  .replace(/<div class="content-body" style="margin-bottom:18px"><p>[\s\S]*?<\/p><\/div>/, '')
  .replace('href="tel:+41775236122"', 'href="tel:+41775236122" data-kf-tel data-care-cta="termin-karte-tel"');

const teamSlugs = ['corinna-reinhart', 'astrid-lenggenhager'];
const localTeam = teamSlugs.map((slug) => {
  const person = getTherapeut(slug);
  if (!person || !person.standorte?.includes('st-gallen')) {
    throw new Error('HeroStandardSG: therapist not assigned to St. Gallen: ' + slug);
  }
  return teamCardHtml(getPublicTherapistProfile(person));
}).join('');

const card = renderKontaktForm({
  instance: 'sg-hero', standortId: 'st-gallen', cardId: 'offer-form',
  // Both historical anchors must continue working, including legacy check-in links.
  compatAnchors: ['first30', 'termin-formular'],
  quelle: 'launch-hero-sg', formName: 'Hero-Termin-StGallen', formular: 'Hero-Termin-StGallen',
  quelleDetail: 'Hero St. Gallen · reguläres Terminformular', seite: '/standorte/st-gallen/',
  wunschzeit: true, sitekey, headingTag: 'h3',
  onedocBeideTerminarten: true, ohneOnedocAlternative: true,
  checkinZuerst: true, ruhig: true, zusatzOffen: true,
  kopfTitel: 'Termin anfragen',
});
---
<section class="lsr-hero hlsg">
  <div class="lsr-inner">
    <div class="lsr-left">
      <span class="lsr-eyebrow">TCM.ch Praxis · St. Gallen</span>
      <h1 class="lsr-h1">Akupunktur &amp; TCM in <span class="lsr-accent">St. Gallen</span></h1>
      <p class="lsr-lead">Persönliche TCM und Akupunktur am Oberen Graben, nahe dem Bahnhof St. Gallen.</p>
      <div class="lsr-trust">
        <div><span class="lsr-check" aria-hidden="true">✓</span> EMR-/ASCA-anerkannte Fachpersonen · Zusatzversicherung je nach Police</div>
      </div>
      <div class="lsr-ctas">
        <a href="#termin-formular" class="lsr-btn-primary tcm-btn tcm-btn--primary tcm-btn--hero" data-booking-sheet="sg" data-booking-wish="behandlung" data-kf-terminart="behandlung" data-care-cta="hero-ersttermin">Termin anfragen</a>
        <a href="#sg-standort" class="lsr-btn-ghost tcm-btn tcm-btn--outline tcm-btn--hero" data-care-cta="hero-anfahrt">Praxis &amp; Anfahrt</a>
      </div>
      <a class="lsr-tlink" href="#sg-therapien" data-sg-therapie-link hidden></a>
    </div>
    <HeroMedia id="sg-hero-media" />
  </div>
</section>

{/* Hwang-inspired: real clinic information first (exactly once), booking alongside.
    On mobile the location facts lead; the Hero booking CTA still jumps to the form. */}
<section class="sgt sgt--location-first" aria-label="Praxis und Termin St. Gallen">
  <div class="sgt-wrap sgt-grid">
    <div class="sgt-practice" id="sg-standort">
      <Fragment set:html={pra} />
      <div class="sgt-location-actions">
        <a href={SG_MAPS} target="_blank" rel="noopener noreferrer" data-care-cta="sg-route"><span aria-hidden="true">↗</span> Route planen</a>
        <a href={SG_WA} target="_blank" rel="noopener noreferrer" data-care-cta="termin-karte-wa"><span aria-hidden="true">↗</span> WhatsApp</a>
      </div>
    </div>
    <div class="sgt-main" aria-labelledby="sgt-h">
      <span id="termin" class="sgt-anchor" aria-hidden="true"></span>
      <div class="sgt-head">
        <h2 class="section-title" id="sgt-h">Termin in <em>St. Gallen</em></h2>
        <p class="sgt-sub">Gratis kennenlernen oder direkt behandeln lassen – wir melden uns persönlich.</p>
      </div>
      <div class="sgt-form"><Fragment set:html={card} /></div>
      <details class="sgt-onedoc" id="online-buchen">
        <summary data-care-cta="termin-karte-checkin">
          <span>Oder direkt online buchen (OneDoc)</span>
          <span class="sgt-onedoc-arrow" aria-hidden="true">+</span>
        </summary>
        <div class="sgt-onedoc-body">
          <p class="sgt-od-sub">Wähle im Kalender den kostenlosen TCM-Check-in oder den passenden Behandlungstermin.</p>
          <Fragment set:html={ONEDOC_SG_WIDGET} />
          <p class="sgt-od-fallback">Kalender nicht sichtbar? <a href={ONEDOC_SG_WIDGET_URL} target="_blank" rel="noopener noreferrer">OneDoc direkt öffnen <span aria-hidden="true">↗</span></a></p>
        </div>
      </details>
    </div>
  </div>
</section>

<section class="section sg-location-team" id="sg-team" aria-labelledby="sg-team-h">
  <div class="wrap">
    <div class="section-label">Unser Team vor Ort</div>
    <h2 class="section-title" id="sg-team-h">Dein Team in <em>St. Gallen</em></h2>
    <div class="team-grid sg-team-grid"><Fragment set:html={localTeam} /></div>
    <div class="sg-team-testimonial">
      <blockquote>«Das Team ist freundlich, nimmt sich Zeit und hört aufmerksam zu. Die Atmosphäre ist angenehm und professionell.»</blockquote>
      <p>Maria C. · Google-Rezension <a href={SG_MAPS} target="_blank" rel="noopener noreferrer">Bewertungen ansehen <span aria-hidden="true">↗</span></a></p>
    </div>
  </div>
</section>
<style is:global>
  /* SG-only. Other data-driven clinic templates stay untouched. */
  .lsr-hero.hlsg .lsr-trust{margin:0 0 19px}
  .lsr-hero.hlsg .lsr-trust>div{font-size:13.5px;line-height:1.5}
  .lsr-hero.hlsg .lsr-tert{display:none!important}
  .lsr-hero.hlsg .lsr-tlink{display:inline-block;font-size:14px;font-weight:700;color:var(--blue,#1769B1);margin-top:9px}
  .lsr-hero.hlsg .lsr-tlink[hidden]{display:none!important}

  .sgt--location-first{font-family:var(--font-sans,'Figtree',system-ui,sans-serif);background:#F7F8F8;padding:clamp(32px,4.4vw,60px) 16px}
  .sgt--location-first .sgt-wrap{max-width:var(--max,1280px);margin:0 auto}
  .sgt--location-first .sgt-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,525px);gap:clamp(28px,4vw,58px);align-items:start}
  .sgt--location-first .sgt-practice{min-width:0;scroll-margin-top:calc(var(--header-h,76px) + 14px)}
  .sgt--location-first .sgt-practice .up-h2{margin:0 0 18px;font-size:clamp(28px,2.7vw,39px);line-height:1.16}
  .sgt--location-first .sgt-practice .up-grid{margin-top:0}
  .sgt--location-first .sgt-practice .up-item{min-width:0}
  .sgt--location-first .sgt-practice .up-val{overflow-wrap:anywhere}
  .sgt--location-first .sgt-practice-photo{display:block;overflow:hidden;margin:22px 0 20px;border-radius:18px;border:1px solid #E0E6E9}
  .sgt--location-first .sgt-practice-photo img{display:block;width:100%;height:auto;aspect-ratio:16/9;max-height:285px;object-fit:cover}
  .sgt--location-first .sgt-practice .up-map{overflow:hidden;border-radius:16px}
  .sgt--location-first .sgt-practice .up-map iframe{height:250px}
  .sgt--location-first .sgt-practice .sg-hub-xlink,.sgt--location-first .sgt-practice .sg-wissen-xlink{margin:12px 0 0!important;font-size:13px!important}
  .sgt--location-first .sgt-practice .sg-wissen-xlink span{display:none!important}
  .sgt--location-first .sgt-location-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
  .sgt--location-first .sgt-location-actions a{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:9px 17px;background:#fff;border:1px solid #CDDCE6;border-radius:999px;color:#1769B1!important;text-decoration:none;font-size:14px;font-weight:750}
  .sgt--location-first .sgt-location-actions a:hover{background:#E8F2FA;border-color:#A7C7DE}
  .sgt--location-first .sgt-location-actions a:focus-visible,.sgt--location-first .sgt-onedoc summary:focus-visible{outline:3px solid #1769B1;outline-offset:3px}
  .sgt--location-first .sgt-main{min-width:0;max-width:525px;width:100%}
  .sgt--location-first .sgt-head{margin:0 0 19px}
  .sgt--location-first .sgt-head .section-title{margin:0 0 8px;font-size:clamp(25px,2.6vw,34px)}
  .sgt--location-first .sgt-sub{font-size:14.5px;line-height:1.5;color:#61717A;margin:0}
  .sgt--location-first .sgt-anchor{display:block;height:0;scroll-margin-top:calc(var(--header-h,76px) + 12px)}
  .sgt--location-first .sgt-form .kf{width:100%;max-width:none!important;margin:0}
  .sgt--location-first .sgt-onedoc{background:#fff;border:1px solid #DDE6EC;border-radius:17px;margin:14px 0 0;scroll-margin-top:calc(var(--header-h,76px) + 12px);overflow:hidden}
  .sgt--location-first .sgt-onedoc summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;font-size:14.5px;font-weight:750;color:#1769B1}
  .sgt--location-first .sgt-onedoc summary::-webkit-details-marker{display:none}
  .sgt--location-first .sgt-onedoc[open] summary{border-bottom:1px solid #E5EBEF}
  .sgt--location-first .sgt-onedoc-arrow{font-size:23px;font-weight:400;line-height:1;transition:transform .15s ease}
  .sgt--location-first .sgt-onedoc[open] .sgt-onedoc-arrow{transform:rotate(45deg)}
  .sgt--location-first .sgt-onedoc-body{padding:16px 18px 18px}
  .sgt--location-first .sgt-od-sub{margin:0 0 12px;color:#61717A;font-size:13.5px;line-height:1.5}
  .sgt--location-first .sgt-onedoc .od-widget{display:block;width:100%;min-height:400px}
  .sgt--location-first .sgt-od-fallback{margin:10px 0 0;font-size:13px;color:#61717A}
  .sgt--location-first .sgt-od-fallback a{color:#1769B1;font-weight:700;text-decoration:none}
  .sg-location-team{background:#fff;padding:clamp(38px,4vw,60px) 16px}
  .sg-location-team .section-title{margin:7px 0 21px}
  .sg-location-team .sg-team-grid{margin:0}
  .sg-location-team .sg-team-testimonial{max-width:780px;margin-top:26px;padding:17px 21px;background:#F4F8FB;border:1px solid #E0EBF4;border-radius:16px}
  .sg-location-team .sg-team-testimonial blockquote{font-size:15px;line-height:1.6;color:#263C4A;margin:0 0 9px}
  .sg-location-team .sg-team-testimonial p{margin:0;color:#60717B;font-size:13px}
  .sg-location-team .sg-team-testimonial a{margin-left:8px;color:#1769B1;text-decoration:none;font-weight:700}
  @media(max-width:900px){
    .sgt--location-first .sgt-grid{grid-template-columns:minmax(0,1fr);gap:28px;max-width:660px;margin:0 auto}
    .sgt--location-first .sgt-main{max-width:none}
    .sgt--location-first .sgt-practice .up-map iframe{height:245px}
  }
  @media(max-width:767px){
    .lsr-hero.hlsg .lsr-ctas{display:flex;flex-direction:column;gap:9px}
    .lsr-hero.hlsg .lsr-ctas a{display:flex;width:100%;min-height:50px;justify-content:center}
    .lsr-hero.hlsg .lsr-btn-primary{background:var(--tcm-primary,#1769B1)!important;color:#fff!important;border-color:var(--tcm-primary,#1769B1)!important}
    .lsr-hero.hlsg .lsr-trust>div{font-size:12.5px}
    .sgt--location-first{padding:30px 16px 38px}
    .sgt--location-first .sgt-grid{gap:26px}
    .sgt--location-first .sgt-practice .up-h2{font-size:29px;margin-bottom:16px}
    .sgt--location-first .sgt-practice-photo{margin:15px 0 12px}
    .sgt--location-first .sgt-practice-photo img{aspect-ratio:16/9;max-height:220px}
    /* Google Maps opens externally on mobile; do not push the booking form
       another 250px down just to repeat a map. The address remains clickable. */
    .sgt--location-first .sgt-practice .up-map{display:none}
    .sgt--location-first .sgt-location-actions a{flex:1 1 auto}
    .sgt--location-first .sgt-onedoc-body{padding:12px}
    .sg-location-team{padding:32px 16px}
    .sg-location-team .sg-team-testimonial{margin-top:20px}
  }
  @media(prefers-reduced-motion:reduce){.sgt--location-first .sgt-onedoc-arrow{transition:none}}
</style>
<script is:inline>
  // Preserve old direct links (#online-buchen) used by OneDoc, FAQ, banners,
  // and clinic dropdowns, even though the embedded calendar is now optional.
  (function(){
    var panel=document.getElementById('online-buchen');
    if(!panel)return;
    var openForHash=function(){ if(location.hash==='#online-buchen') panel.open=true; };
    openForHash();
    window.addEventListener('hashchange',openForHash);
    document.addEventListener('click',function(e){
      var link=e.target.closest&&e.target.closest('a[href="#online-buchen"]');
      if(link)panel.open=true;
    });
  })();
</script>
<script is:inline>
  // Ads-Parameter ?t=schroepfen|akupunktur|tuina|beschwerden (nur clientseitig; statischer Inhalt/Canonical bleibt «Akupunktur & TCM»):
  // H1 + Unterzeile je Therapie, Textlink unter den Buttons zur Therapie-/Beschwerden-Sektion, optional Hero-Bild (Bilder aus
  // /therapien/*, Video dann aus), «Dein Anliegen» vorbelegt, dataLayer-Variable therapy. Nur bekannte Werte, nie Nutzertext.
  (function () {
    var SG = '<span class="lsr-accent">St. Gallen</span>';
    var T = {
      schroepfen: { h1: 'Schröpfen in ' + SG, lead: 'Schröpfen und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Schröpfen bei uns', ziel: '#sg-therapien', anliegen: 'Schröpfen' },
      akupunktur: { h1: 'Akupunktur in ' + SG, lead: 'Akupunktur und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Akupunktur bei uns', ziel: '#sg-therapien', anliegen: 'Akupunktur' },
      tuina: { h1: 'Tuina in ' + SG, lead: 'Tuina und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Tuina bei uns', ziel: '#sg-therapien', anliegen: 'Tuina' },
      beschwerden: { lead: 'Rücken, Nacken, Migräne, Schlaf: wir schauen uns deine Beschwerden beim kostenlosen Check-in an.', link: 'Mehr zu Beschwerden bei uns', ziel: '#sg-beschwerden', anliegen: 'Beschwerden' }
    };
    var t = ''; try { t = (new URLSearchParams(location.search).get('t') || '').toLowerCase(); } catch (e) {}
    var c = T[t]; if (!c) return;
    try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ therapy: t }); } catch (e) {}
    var h1 = document.querySelector('.lsr-hero.hlsg .lsr-h1'); if (h1 && c.h1) h1.innerHTML = c.h1;
    var lead = document.querySelector('.lsr-hero.hlsg .lsr-lead'); if (lead) lead.textContent = c.lead;
    var link = document.querySelector('[data-sg-therapie-link]'); if (link) { link.textContent = c.link + ' \u2193'; link.setAttribute('href', c.ziel); link.hidden = false; }
    var ta = document.querySelector('[data-kf-instance="sg-hero"] textarea[name="anliegen"]');
    if (ta && !ta.value) { ta.value = c.anliegen; try { ta.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {} }
  })();
</script>
