---
// Regulärer St.-Gallen-Hero (Angebotsausrichtung 05.11.2026: kostenloser TCM 360°-Check-in wie vor dem 1.10.).
// Reihenfolge: gelber Angebotsbanner → Hero (Text links, gemeinsames Hero-Video rechts) → Kontaktsektion #termin nach dem
// Muster von /kontakt/ (Titel, drei Karten, OneDoc-Widget, gemeinsames Kontaktformular) → USP-Reihe + Praxisangaben
// («Über die Praxis» aus dem Leaf, standorte/[slug].astro). Die untere Leaf-Kontaktkarte und die separate OneDoc-Sektion
// entfallen; #offer-form (Formularkarte) und #online-buchen (Widget) bleiben als Alias-Anker innerhalb von #termin.
// Bestehende Identifier bleiben: quelle=launch-hero-sg, Instanz sg-hero, Anker #first30 (alte Kampagnenlinks), #kf-sg-hero-fields;
// Tracking (dataLayer-Events, OneDoc-GA4-Embed, phone_click/wa_click-Hooks) unverändert.
import { renderKontaktForm } from '../lib/kontakt-form';
import KontaktPraxis from './standort/KontaktPraxis.astro';
import HeroMedia from './standort/HeroMedia.astro';
import { ONEDOC_SG_WIDGET, ONEDOC_SG_WIDGET_URL } from '../data/onedoc-sg';
const { sitekey, uspHtml = '', praxisHtml = '' } = Astro.props;
// Kanonisches SG-WhatsApp-Ziel mit neutralem Nachrichtentext (Hero-Textlink und Kontaktkarte).
const SG_WA = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen.';
const SG_TEL = '+41 77 523 61 22';
const SG_MAPS = 'https://www.google.com/maps/place/TCM.ch+St+Gallen/@47.423225,9.3740224,17z/data=!3m1!4b1!4m6!3m5!1s0x479b1fa8422eee23:0x4d9e5b1cb4999c7!8m2!3d47.423225!4d9.3740224!16s%2Fg%2F11npmqv34r';
// Google-Bewertungen aus dem GBP «TCM.ch St. Gallen»: Werte MANUELL aus dem Profil übernehmen (nie schätzen), mit Stand-Datum.
// Solange rating/count null sind, wird die Sternezeile im Hero nicht gerendert (SEO-Audit 11.10.2026: nur mit live verifiziertem Wert).
const SG_GOOGLE = { rating: null as number | null, count: null as number | null, stand: '' };
// 1 bis 2 kurze Zitate aus echten Google-Bewertungen (Vorname oder Initialen). Leer = keine Zitate in der Kontaktsektion.
// Nur Wortlaut aus dem GBP übernehmen, nie formulieren.
const SG_ZITATE: { text: string; name: string }[] = [];
const fmtRating = (r: number) => r.toLocaleString('de-CH', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const card = renderKontaktForm({
  instance: 'sg-hero', standortId: 'st-gallen', cardId: 'offer-form', compatAnchors: ['first30'],
  // Neutraler Formular-Identifier (21.10.2026): beide Terminarten (Check-in 30 Min. kostenlos, Ersttermin 60 Min. kostenpflichtig);
  // Terminart/Dauer/Kosten kommen ausschliesslich aus der serverseitigen Angebots-ID (anfrage.js), nie aus dem Formularnamen.
  quelle: 'launch-hero-sg', formName: 'Hero-Termin-StGallen', formular: 'Hero-Termin-StGallen',
  quelleDetail: 'Hero St. Gallen · reguläres Terminformular', seite: '/standorte/st-gallen/',
  // Check-in zuerst + vorausgewählt, Button «Gratis Check-in anfragen» / «Ersttermin anfragen». OneDoc-Panel unter dem
  // Formular entfällt (Widget steht direkt darüber); Anrufen/WhatsApp stehen in den Karten.
  wunschzeit: true, sitekey, headingTag: 'h3', onedocBeideTerminarten: true, ohneOnedocAlternative: true, checkinZuerst: true, ruhig: true, zusatzOffen: true,
});
---
<section class="sgb-banner" id="sg-angebot-banner" aria-label="Kostenloser TCM 360°-Check-in">
  <a href="#termin" class="sgb-in">
    <span class="sgb-txt"><strong>Kostenloser TCM 360°-Check-in</strong><span class="sgb-sep" aria-hidden="true"> · </span>30 Min<span class="sgb-sep" aria-hidden="true"> · </span>CHF 0</span>
    <span class="sgb-cta">Jetzt Termin wählen <span aria-hidden="true">→</span></span>
  </a>
</section>
<section class="lsr-hero hlsg">
  <div class="lsr-inner">
    <div class="lsr-left">
      <span class="lsr-eyebrow">TCM.ch Praxis · St. Gallen</span>
      <h1 class="lsr-h1">Akupunktur &amp; TCM in <span class="lsr-accent">St. Gallen</span></h1>
      <p class="lsr-lead">Medizinisch fundierte TCM wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen, bevor du dich entscheidest.</p>
      <div class="lsr-trust">
        {SG_GOOGLE.rating != null && SG_GOOGLE.count != null && (
          <div class="lsr-google"><a href={SG_MAPS} target="_blank" rel="noopener noreferrer" title={`Google-Bewertungen, Stand ${SG_GOOGLE.stand}`}><span class="lsr-stars" aria-hidden="true">★★★★★</span> <strong>{fmtRating(SG_GOOGLE.rating)}</strong> · {SG_GOOGLE.count} Google-Bewertungen</a></div>
        )}
        <div><span class="lsr-check">✓</span> Krankenkassen anerkannt (EMR/ASCA)</div>
        <div><span class="lsr-check">✓</span> Oberer Graben 22, St. Gallen</div>
        <div><span class="lsr-check">✓</span> Check-in kostenlos, ohne Behandlungspflicht</div>
      </div>
      <div class="lsr-ctas">
        <a href="#termin" class="lsr-btn-primary tcm-btn tcm-btn--primary tcm-btn--hero" data-care-cta="hero-checkin">Gratis Check-in buchen</a>
        <a href="#termin" class="lsr-btn-ghost tcm-btn tcm-btn--outline tcm-btn--hero" data-kf-terminart="behandlung" data-care-cta="hero-ersttermin">Ersttermin anfragen</a>
      </div>
      <p class="lsr-tert"><a href="tel:+41775236122" class="tcm-link tcm-link--on-brand">Anrufen</a> · <a href={SG_WA} target="_blank" rel="noopener" class="tcm-link tcm-link--on-brand">WhatsApp</a></p>
    </div>
    <HeroMedia id="sg-hero-media" />
  </div>
</section>
{/* Ads-Parameter ?t=schroepfen|akupunktur|tuina|beschwerden (nur clientseitig, Canonical/Title/Indexierung unverändert):
    Zeile unter dem Hero mit Link auf die Therapie-/Beschwerden-Sektion, «Dein Anliegen» vorbelegt, dataLayer-Variable therapy. */}
<div class="sgp-line" data-sg-therapie hidden>
  <div class="sgp-in"><a href="#sg-therapien" data-sg-therapie-link><span data-sg-therapie-txt></span> · krankenkassenanerkannt <span aria-hidden="true">→</span></a></div>
</div>
{/* Kontaktsektion nach dem Muster von /kontakt/: ein geschlossener Block. #termin liegt auf einem Vor-Anker (kein Vorfahre der
    Formularkarte), damit kontakt-form.js den Hash nicht als Formular-Anker übernimmt und Links auf #termin oben am Block landen. */}
<span id="termin" class="sgt-anchor" aria-hidden="true"></span>
<section class="sgt" aria-labelledby="sgt-h">
  <div class="sgt-wrap">
    <div class="sgt-head">
      <h2 class="section-title" id="sgt-h">Termin in <em>St. Gallen</em></h2>
      <p class="sgt-sub">Wir melden uns persönlich. EMR-/ASCA-anerkannt.</p>
    </div>
    <div class="sgt-channels">
      <a class="sgt-ch sgt-ch--primary" href="#online-buchen" data-care-cta="termin-karte-checkin">
        <span class="sgt-ch-label">Am schnellsten</span>
        <span class="sgt-ch-title">Gratis Check-in buchen</span>
        <span class="sgt-ch-sub">30 Min, CHF 0, Termin bei Corinna sofort sichtbar.</span>
        <span class="sgt-ch-go">Termin wählen <span aria-hidden="true">→</span></span>
      </a>
      <a class="sgt-ch" href="tel:+41775236122" data-kf-tel data-care-cta="termin-karte-tel">
        <span class="sgt-ch-label">Anrufen</span>
        <span class="sgt-ch-title">{SG_TEL}</span>
        <span class="sgt-ch-sub">Mo–Sa erreichbar. Wir finden gemeinsam den passenden Termin.</span>
        <span class="sgt-ch-go">Anrufen <span aria-hidden="true">→</span></span>
      </a>
      <a class="sgt-ch" href={SG_WA} target="_blank" rel="noopener" data-care-cta="termin-karte-wa">
        <span class="sgt-ch-label">WhatsApp</span>
        <span class="sgt-ch-title">Kurz schreiben</span>
        <span class="sgt-ch-sub">Schildere dein Anliegen, wir antworten persönlich.</span>
        <span class="sgt-ch-go">WhatsApp öffnen <span aria-hidden="true">→</span></span>
      </a>
    </div>
    <div class="sgt-onedoc" id="online-buchen">
      <div class="sgt-od-head">
        <h3 class="sgt-od-h">Online buchen</h3>
        <p class="sgt-od-sub">Wähle im Buchungsfenster «Kostenloser TCM 360°-Check-in» als Behandlungsgrund. Bestätigung sofort per E-Mail.</p>
      </div>
      <Fragment set:html={ONEDOC_SG_WIDGET} />
      <p class="sgt-od-fallback">Buchungsfenster bleibt leer? <a href={ONEDOC_SG_WIDGET_URL} target="_blank" rel="noopener">Direkt bei OneDoc öffnen <span aria-hidden="true">→</span></a></p>
    </div>
    {SG_ZITATE.length > 0 && (
      <ul class="sgt-quotes" aria-label="Google-Bewertungen">
        {SG_ZITATE.slice(0, 2).map((z) => <li><span class="lsr-stars" aria-hidden="true">★★★★★</span><q>{z.text}</q><span class="sgt-q-name">{z.name}, Google</span></li>)}
      </ul>
    )}
    <div class="sgt-form"><Fragment set:html={card} /></div>
  </div>
</section>
<KontaktPraxis>
  {uspHtml && <Fragment slot="usp" set:html={uspHtml} />}
  {praxisHtml && <Fragment slot="info" set:html={praxisHtml} />}
</KontaktPraxis>
<style is:global>
  /* Angebotsbanner unter dem fixen Header (gelb); der Hero verliert dafür sein Header-Padding. */
  .sgb-banner{margin-top:var(--header-h,76px);background:#FFD84D;color:#111;font-family:var(--font-sans,'Figtree',system-ui,sans-serif);border-bottom:2px solid rgba(2,11,16,.14)}
  .sgb-banner + .lsr-hero.hlsg{padding-top:0!important}
  @media (max-width:900px){.sgb-banner{margin-top:80px}}
  .sgb-in{max-width:var(--max,1280px);margin:0 auto;padding:12px 16px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px 18px;text-decoration:none;color:inherit}
  .sgb-txt{font-size:clamp(15px,1.4vw,17px);font-weight:600;letter-spacing:-.01em;line-height:1.3}
  .sgb-txt strong{font-weight:800}
  .sgb-cta{display:inline-flex;align-items:center;gap:6px;background:var(--brand-black,#020B10);color:#fff;border-radius:999px;padding:8px 16px;font-size:14.5px;font-weight:800;line-height:1.2;white-space:nowrap}
  .sgb-in:hover .sgb-cta{background:#0B1F27}
  .sgb-in:focus-visible{outline:3px solid var(--brand-black,#020B10);outline-offset:-3px}
  @media (max-width:479px){.sgb-in{flex-direction:column;gap:8px;padding:10px 14px 12px;text-align:center}.sgb-sep{display:inline}}

  /* Therapie-Zeile (?t=) unter dem Hero. */
  .sgp-line{background:#fff;border-bottom:1px solid var(--border);font-family:var(--font-sans,'Figtree',system-ui,sans-serif)}
  .sgp-in{max-width:var(--max,1280px);margin:0 auto;padding:12px 16px;font-size:15.5px;font-weight:700}
  .sgp-in a{color:var(--black);text-decoration:none}
  .sgp-in a:hover{color:var(--blue)}

  /* Hero: Google-Zeile vor den Trust-Punkten. */
  .lsr-google{flex-basis:100%}
  .lsr-google a{color:var(--brand-black,#020B10);text-decoration:none;display:inline-flex;align-items:center;gap:6px}
  .lsr-google a:hover{text-decoration:underline}
  .lsr-stars{color:#F4B400;letter-spacing:.04em;font-size:15px}

  /* Kontaktsektion #termin (Muster /kontakt/): Titel, drei Karten, OneDoc, Formular. */
  .sgt-anchor{display:block;height:0;scroll-margin-top:var(--header-h,76px)}
  .sgt{background:var(--surface,#F4F6F5);padding:clamp(28px,4vw,56px) 16px;font-family:var(--font-sans,'Figtree',system-ui,sans-serif)}
  .sgt-wrap{max-width:1024px;margin:0 auto}
  .sgt-head{margin-bottom:22px}
  .sgt-head .section-title{margin:0 0 6px}
  .sgt-sub{margin:0;font-size:16px;color:var(--mid);line-height:1.5}
  .sgt-channels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:24px}
  .sgt-ch{display:flex;flex-direction:column;height:100%;border:1px solid var(--border);border-radius:var(--r-card,16px);padding:22px;text-decoration:none;background:#fff;transition:border-color .15s ease,box-shadow .15s ease,transform .15s ease}
  .sgt-ch:hover{border-color:var(--blue);box-shadow:var(--sh-card);transform:translateY(-2px)}
  .sgt-ch-label{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--blue)}
  .sgt-ch-title{font-size:19px;font-weight:800;color:var(--black);margin:6px 0 8px;line-height:1.2;letter-spacing:-.01em}
  .sgt-ch-sub{font-size:14.5px;line-height:1.5;color:var(--mid);flex:1}
  .sgt-ch-go{margin-top:16px;font-size:14px;font-weight:700;color:var(--blue)}
  .sgt-ch--primary{background:var(--brand-black,#020B10);border-color:var(--brand-black,#020B10)}
  .sgt-ch--primary .sgt-ch-label{color:var(--brand,#1AE288)}
  .sgt-ch--primary .sgt-ch-title{color:#fff}
  .sgt-ch--primary .sgt-ch-sub{color:rgba(255,255,255,.82)}
  .sgt-ch--primary .sgt-ch-go{color:var(--brand,#1AE288)}
  .sgt-ch--primary:hover{border-color:var(--brand,#1AE288)}
  .sgt-onedoc{background:#fff;border:1px solid var(--border);border-radius:var(--r-card,16px);padding:20px 20px 12px;margin-bottom:24px;scroll-margin-top:calc(var(--header-h,76px) + 12px)}
  .sgt-od-head{margin-bottom:10px}
  .sgt-od-h{margin:0 0 4px;font-size:20px;font-weight:800;letter-spacing:-.01em;color:var(--black)}
  .sgt-od-sub{margin:0;font-size:14.5px;line-height:1.5;color:var(--mid)}
  .sgt-onedoc .od-widget{display:block;min-height:400px}
  .sgt-od-fallback{margin:8px 0 0;font-size:14px;color:var(--mid)}
  .sgt-od-fallback a{color:var(--blue);font-weight:700;text-decoration:none}
  .sgt-quotes{list-style:none;margin:0 0 24px;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
  .sgt-quotes li{background:#fff;border:1px solid var(--border);border-radius:var(--r-card,16px);padding:16px 18px;font-size:15px;line-height:1.55;color:var(--black)}
  .sgt-quotes .lsr-stars{display:block;margin-bottom:6px}
  .sgt-quotes q{quotes:'«' '»'}
  .sgt-q-name{display:block;margin-top:8px;font-size:13.5px;font-weight:700;color:var(--mid)}
  .sgt-form .kf{width:100%;max-width:560px;margin:0 auto}
  /* Generische Trust-Zeile aus home.js (form-trust-checklist) nicht über dem SG-Formular: dupliziert die Karten. */
  .sgt-form .form-trust-checklist{display:none}
  /* Check-in ist die erste Kachel: dezentes Mint dort statt bei der Erstbehandlung. */
  .sgt .kf--ruhig .kf-opt--behandlung,.sgt .kf--ruhig .kf-opt--behandlung.is-checked{background:#fff}
  .sgt .kf--ruhig .kf-opt--checkin,.sgt .kf--ruhig .kf-opt--checkin.is-checked{background:#F7FCF9}
  @media (max-width:760px){.sgt-channels{grid-template-columns:minmax(0,1fr);gap:10px}.sgt-ch{padding:16px 18px}.sgt-ch-title{font-size:17px}.sgt-onedoc{padding:14px 12px 10px}}
</style>
<script is:inline>
  // Ads-Parameter ?t=…: Zeile unter dem Hero, Anliegen-Vorbelegung, dataLayer-Variable therapy (nur bekannte Werte; nie Nutzertext).
  (function () {
    var T = { schroepfen: ['Schröpfen', '#sg-therapien'], akupunktur: ['Akupunktur', '#sg-therapien'], tuina: ['Tuina', '#sg-therapien'], beschwerden: ['Beschwerden', '#sg-beschwerden'] };
    var t = ''; try { t = (new URLSearchParams(location.search).get('t') || '').toLowerCase(); } catch (e) {}
    if (!T[t]) return;
    try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ therapy: t }); } catch (e) {}
    var box = document.querySelector('[data-sg-therapie]');
    if (box) { box.querySelector('[data-sg-therapie-txt]').textContent = T[t][0] + ' in St. Gallen'; box.querySelector('[data-sg-therapie-link]').setAttribute('href', T[t][1]); box.hidden = false; }
    var ta = document.querySelector('[data-kf-instance="sg-hero"] textarea[name="anliegen"]');
    if (ta && !ta.value) { ta.value = T[t][0]; try { ta.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {} }
  })();
</script>
