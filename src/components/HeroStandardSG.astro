      akupunktur: { h1: 'Akupunktur in ' + SG, lead: 'Akupunktur und TCM, wenige Gehminuten vom Bahnhof St. Gallen. Lerne uns beim kostenlosen Check-in kennen.', link: 'Mehr zu Akupunktur bei uns', ziel: '#sg-therapien', anliegen: 'Akupunktur' },
