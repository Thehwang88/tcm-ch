  .lsr-hero.hlsg .lsr-left{
    box-sizing:border-box;width:100%;max-width:620px;margin-inline:auto;
    min-width:0;padding:clamp(36px,4.3vw,68px) clamp(24px,3vw,48px);
    display:flex;flex-direction:column;justify-content:center;
    align-items:flex-start;text-align:left;
  }
  .lsr-hero.hlsg .lsr-h1{max-width:580px}
  .lsr-hero.hlsg .lsr-lead{max-width:510px}
  .lsr-hero.hlsg .lsr-trust{margin:0 0 19px}
  .lsr-hero.hlsg .lsr-trust>div{font-size:13.5px;line-height:1.5}
  .lsr-hero.hlsg .lsr-tert{display:none!important}
  .lsr-hero.hlsg .lsr-tlink{display:inline-block;font-size:14px;font-weight:700;color:var(--blue,#1769B1);margin-top:9px}
  .lsr-hero.hlsg .lsr-tlink[hidden]{display:none!important}
  .lsr-hero.hlsg .lsr-quick{display:flex;flex-wrap:wrap;align-items:center;gap:0 10px;margin:-2px 0 0;font-size:14px;font-weight:700;line-height:1.5;color:#61717A}
  .lsr-hero.hlsg .lsr-quick a{color:var(--blue,#1769B1);text-decoration:none}
  .lsr-hero.hlsg .lsr-quick a:hover{text-decoration:underline}
  #sg-onedoc-sheet .sgt-onedoc-body{padding:4px 0 0}
  #sg-onedoc-sheet .sgt-od-sub{margin:0 0 12px;color:#61717A;font-size:13.5px;line-height:1.5}
  #sg-onedoc-sheet .od-widget{display:block;width:100%;min-height:400px}
  #sg-onedoc-sheet .sgt-od-fallback{margin:10px 0 0;font-size:13px;color:#61717A}
  #sg-onedoc-sheet .sgt-od-fallback a{color:#1769B1;font-weight:700;text-decoration:none}

  .sgt--location-first{font-family:var(--font-sans,'Figtree',system-ui,sans-serif);background:#F7F8F8;padding:clamp(24px,3.5vw,42px) 16px}
