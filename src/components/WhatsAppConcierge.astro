---
// Desktop-only WhatsApp concierge widget (Yuna). Rendered once site-wide via Footer.
// Hidden below 1024px (mobile/tablet keep the bottom-bar / FAB). The wa.me prefill is
// built client-side from the page title, so no prop threading is needed.
const WA_NUMBER = '41775236122';
const WA_PATH = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';
---
<div class="wac" id="wac">
  <div class="wac-greet" id="wac-greet" role="button" tabindex="0" aria-label="Chat mit Yuna öffnen">
    <button class="wac-greet-x" id="wac-greet-x" type="button" aria-label="Hinweis schliessen">×</button>
    <span>Hallo, hast du eine Frage? Schreib mir kurz. Yuna</span>
  </div>

  <div class="wac-card" id="wac-card" role="dialog" aria-modal="false" aria-label="WhatsApp Concierge mit Yuna">
    <div class="wac-head">
      <img class="wac-avatar" src="/images/yuna-concierge.webp" width="44" height="44" alt="Yuna, TCM.ch Concierge" loading="lazy" decoding="async" />
      <div class="wac-head-text">
        <div class="wac-name">Yuna</div>
        <div class="wac-sub">TCM.ch Concierge</div>
        <div class="wac-status"><span class="wac-dot" aria-hidden="true"></span>Antwortet &lt; 2 Min</div>
      </div>
      <button class="wac-close" id="wac-close" type="button" aria-label="Chat schliessen">×</button>
    </div>
    <div class="wac-body">
      <div class="wac-bubble">Hallo, ich bin Yuna vom TCM.ch Concierge. Hast du eine Frage zu Behandlung, Termin oder Krankenkasse? Schreib mir kurz.</div>
      <a class="wac-cta" id="wac-cta" href={`https://wa.me/${WA_NUMBER}`} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_PATH}></path></svg>
        Chat auf WhatsApp starten
      </a>
      <div class="wac-reassure">Kostenlos und unverbindlich</div>
    </div>
  </div>

  <button class="wac-launch" id="wac-launch" type="button" aria-label="WhatsApp Concierge mit Yuna" aria-expanded="false" aria-haspopup="dialog">
    <span class="wac-ring" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_PATH}></path></svg>
  </button>
</div>

<style>
  .wac { position: fixed; right: 24px; bottom: 24px; z-index: 540; display: none; font-family: var(--font-sans); }
  @media (min-width: 1024px) { .wac { display: block; } }

  /* Launcher */
  .wac-launch { position: relative; width: 60px; height: 60px; border-radius: 50%; border: none; cursor: pointer;
    background: var(--green, #2D9B6F); color: #fff; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(45,155,111,.32), 0 2px 6px rgba(0,0,0,.14); transition: transform .2s ease, box-shadow .2s ease; }
  .wac-launch:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(45,155,111,.42), 0 2px 6px rgba(0,0,0,.14); }
  .wac-launch:active { transform: scale(.96); }
  .wac-launch:focus-visible { outline: 3px solid rgba(45,155,111,.5); outline-offset: 3px; }
  .wac-launch svg { width: 32px; height: 32px; display: block; position: relative; z-index: 1; }
  .wac-ring { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; animation: wac-pulse 2.4s ease-out infinite; }
  @keyframes wac-pulse { 0% { box-shadow: 0 0 0 0 rgba(45,155,111,.45); } 70% { box-shadow: 0 0 0 16px rgba(45,155,111,0); } 100% { box-shadow: 0 0 0 0 rgba(45,155,111,0); } }

  /* Greeting bubble */
  .wac-greet { display: none; position: absolute; right: 74px; bottom: 8px; width: max-content; max-width: 240px;
    background: #fff; color: var(--black, #0d0d0d); font-size: 13.5px; line-height: 1.45; cursor: pointer;
    padding: 12px 32px 12px 14px; border-radius: 14px; box-shadow: var(--sh-md, 0 8px 24px rgba(0,0,0,.14)); }
  .wac.is-greeting .wac-greet { display: block; animation: wac-fade .25s ease both; }
  .wac-greet::after { content: ""; position: absolute; right: -5px; bottom: 18px; width: 11px; height: 11px; background: #fff; transform: rotate(45deg); }
  .wac-greet-x { position: absolute; top: 5px; right: 7px; border: none; background: none; font-size: 17px; line-height: 1; color: #9aa0a6; cursor: pointer; padding: 2px 4px; }

  /* Chat card */
  .wac-card { display: none; position: absolute; right: 0; bottom: 74px; width: 340px; max-width: calc(100vw - 48px);
    border-radius: 16px; overflow: hidden; background: #fff; box-shadow: var(--sh-md, 0 14px 44px rgba(0,0,0,.18)); }
  .wac.is-open .wac-card { display: block; animation: wac-in .22s cubic-bezier(.16,1,.3,1) both; }
  @keyframes wac-in { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
  @keyframes wac-fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .wac-head { display: flex; align-items: center; gap: 12px; background: var(--green, #2D9B6F); color: #fff; padding: 16px; position: relative; }
  .wac-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid rgba(255,255,255,.45); }
  .wac-head-text { flex: 1; min-width: 0; }
  .wac-name { font-weight: 700; font-size: 16px; line-height: 1.2; }
  .wac-sub { font-size: 12.5px; opacity: .92; line-height: 1.3; }
  .wac-status { display: flex; align-items: center; gap: 6px; font-size: 11.5px; opacity: .95; margin-top: 3px; }
  .wac-dot { width: 7px; height: 7px; border-radius: 50%; background: #9fffc7; flex-shrink: 0; animation: wac-dot 1.8s ease-out infinite; }
  @keyframes wac-dot { 0% { box-shadow: 0 0 0 0 rgba(159,255,199,.7); } 70% { box-shadow: 0 0 0 6px rgba(159,255,199,0); } 100% { box-shadow: 0 0 0 0 rgba(159,255,199,0); } }
  .wac-close { position: absolute; top: 10px; right: 10px; border: none; background: rgba(255,255,255,.18); color: #fff;
    width: 26px; height: 26px; border-radius: 50%; font-size: 16px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .wac-close:hover { background: rgba(255,255,255,.3); }
  .wac-body { padding: 18px 16px 16px; }
  .wac-bubble { position: relative; background: #f0f2f5; color: #1c1e21; font-size: 14px; line-height: 1.5;
    padding: 12px 14px; border-radius: 12px; border-top-left-radius: 3px; margin-bottom: 16px; }
  .wac-bubble::before { content: ""; position: absolute; left: -5px; top: 0; width: 10px; height: 10px; background: #f0f2f5; clip-path: polygon(100% 0, 0 0, 100% 100%); }
  .wac-cta { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; box-sizing: border-box;
    background: var(--green, #2D9B6F); color: #fff; text-decoration: none; font-weight: 700; font-size: 14.5px; padding: 13px; border-radius: 12px; }
  .wac-cta:hover { background: var(--green-dark, #1F7A54); }
  .wac-cta svg { width: 18px; height: 18px; }
  .wac-reassure { text-align: center; font-size: 12px; color: #8a9299; margin-top: 10px; }

  @media (prefers-reduced-motion: reduce) {
    .wac-ring, .wac-dot { animation: none; }
    .wac.is-open .wac-card, .wac.is-greeting .wac-greet { animation: none; }
    .wac-launch { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('wac');
    if (!root) return;
    var launch = document.getElementById('wac-launch');
    var card = document.getElementById('wac-card');
    var closeBtn = document.getElementById('wac-close');
    var greet = document.getElementById('wac-greet');
    var greetX = document.getElementById('wac-greet-x');
    var cta = document.getElementById('wac-cta');
    var WA = 'https://wa.me/41775236122';
    function ss(fn, d) { try { return fn(); } catch (e) { return d; } }

    // Per-page wa.me prefill from the page title (same source-context idea as the form).
    var t = (document.title || '').replace(/\s*[|–-]\s*TCM\.ch.*$/i, '').trim() || 'TCM.ch';
    cta.href = WA + '?text=' + encodeURIComponent('Hallo, ich komme von der Seite ' + t + ' auf tcm.ch und habe eine Frage.');

    var open = false;
    function setOpen(v) {
      open = v;
      root.classList.toggle('is-open', v);
      launch.setAttribute('aria-expanded', v ? 'true' : 'false');
      if (v) { root.classList.remove('is-greeting'); cta.focus(); }
      else { launch.focus(); }
    }
    launch.addEventListener('click', function () { setOpen(!open); });
    closeBtn.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) { if ((e.key === 'Escape' || e.key === 'Esc') && open) setOpen(false); });

    function openFromGreet() { setOpen(true); }
    greet.addEventListener('click', openFromGreet);
    greet.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openFromGreet(); } });
    greetX.addEventListener('click', function (e) {
      e.stopPropagation();
      root.classList.remove('is-greeting');
      ss(function () { sessionStorage.setItem('wac-dismissed', '1'); });
    });

    // Auto-expand the greeting once per session after ~15s, unless already shown/dismissed.
    var greeted = ss(function () { return sessionStorage.getItem('wac-greeted'); });
    var dismissed = ss(function () { return sessionStorage.getItem('wac-dismissed'); });
    if (!greeted && !dismissed) {
      setTimeout(function () {
        if (!open && !ss(function () { return sessionStorage.getItem('wac-dismissed'); })) {
          root.classList.add('is-greeting');
          ss(function () { sessionStorage.setItem('wac-greeted', '1'); });
        }
      }, 15000);
    }
  })();
</script>
