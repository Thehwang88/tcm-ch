---
// Warteliste-Formular für die Pre-Opening-Massage-Stadtseiten (Luzern, Basel).
// Ersetzt dort MassageAnfrageForm: es gibt noch keinen Termin zu buchen, also
// sammeln wir E-Mails wie auf /standorte/luzern/ und /standorte/basel/.
// Gleiches Backend (/api/anfrage), gleiche Turnstile-Validierung, gleiches
// dataLayer-Event (form_type: warteliste) wie die Standort-Formulare.
//
// Props:
//   stadt  -> Anzeigename + <input name="standort">
//   jahr   -> Eröffnungsjahr, erscheint im Ribbon
//   quelle -> <input name="quelle">, z.B. "warteliste-luzern-massage"
import { site } from '../data/site';
interface Props {
  stadt: string;
  jahr: string;
  quelle: string;
}
const { stadt, jahr, quelle } = Astro.props;
---
<section id="warteliste" class="mw-sec" style="scroll-margin-top:88px">
  <div class="wrap">
    <div class="mw-grid">
      <div class="mw-text">
        <div class="section-label">Warteliste</div>
        <h2 class="section-title">Als Erste:r einen Termin in <em>{stadt}</em>.</h2>
        <p class="section-sub">Wir eröffnen {jahr}. Trag deine E-Mail ein, dann melden wir uns, sobald die Terminvergabe startet. Du wählst deinen Platz vor der offiziellen Freigabe.</p>
        <ul class="mw-list">
          <li>Du hörst als Erstes vom Eröffnungstermin</li>
          <li>Terminwahl vor der offiziellen Freigabe</li>
          <li>Keine Anzahlung, keine Verpflichtung</li>
        </ul>
        <p class="mw-alt">Du brauchst früher eine Behandlung? An unseren bestehenden Standorten bekommst du meist innert 48 Stunden einen Termin. <a href="/standorte/">Alle Standorte ansehen</a>.</p>
      </div>
      <div class="mw-card">
        <div class="mw-ribbon">{jahr}</div>
        <div class="mw-card-h">Auf die Warteliste</div>
        <p class="mw-note">Eine E-Mail genügt. Keine Werbung, keine Weitergabe.</p>
        <form class="mw-form" data-mw-waitlist novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
          <input type="hidden" name="quelle" value={quelle} />
          <input type="hidden" name="standort" value={stadt} />
          <input name="email" type="email" autocomplete="email" required placeholder="deine@email.ch" aria-label="E-Mail-Adresse" />
          <div class="cf-turnstile mw-ts" data-sitekey={site.turnstileSitekey} data-appearance="interaction-only"></div>
          <button type="submit">Auf die Warteliste</button>
          <p class="mw-rule">Nur eine Nachricht, wenn {stadt} startet.</p>
          <p class="mw-err" role="alert" hidden></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .mw-sec{padding:56px 0;background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .mw-grid{display:grid;grid-template-columns:1fr 380px;gap:40px;align-items:start}
  .mw-list{margin:18px 0 0;padding:0;list-style:none;display:grid;gap:9px}
  .mw-list li{position:relative;padding-left:26px;font-size:15px;line-height:1.55;color:var(--mid)}
  .mw-list li::before{content:"✓";position:absolute;left:0;top:0;color:var(--green-dark);font-weight:800}
  .mw-alt{margin:20px 0 0;font-size:14px;line-height:1.6;color:var(--muted)}
  .mw-alt a{color:var(--green-dark)}
  .mw-card{position:relative;background:#fff;border:1px solid var(--green-mid);border-radius:var(--r-card,16px);padding:26px 24px;box-shadow:var(--sh-md)}
  .mw-ribbon{position:absolute;top:-11px;right:22px;background:var(--green-mint);border:1px solid var(--green-mid);color:var(--green-dark);font-family:var(--font-sans);font-weight:800;font-size:12px;letter-spacing:.04em;padding:4px 11px;border-radius:100px}
  .mw-card-h{font-family:var(--font-sans);font-weight:800;font-size:20px;color:var(--black);letter-spacing:-.02em;margin-bottom:6px}
  .mw-note{font-size:13.5px;color:var(--muted);line-height:1.55;margin:0 0 16px}
  .mw-form input[type=email]{width:100%;padding:13px 14px;border:1px solid var(--border);border-radius:12px;font-size:15px;font-family:inherit;color:var(--black)}
  .mw-form input[type=email]:focus{outline:none;border-color:var(--green-mid)}
  .mw-ts{margin:12px 0}
  .mw-form button{width:100%;margin-top:4px;padding:14px 18px;border:0;border-radius:12px;background:var(--blue);color:#fff;font-family:var(--font-sans);font-weight:700;font-size:15px;cursor:pointer}
  .mw-form button:disabled{opacity:.6;cursor:default}
  .mw-rule{font-size:12.5px;color:var(--muted);line-height:1.5;margin:12px 0 0;text-align:center}
  .mw-err{font-size:13px;color:#b3261e;margin:10px 0 0}
  @media(max-width:820px){.mw-grid{grid-template-columns:1fr;gap:28px}}
</style>

<script is:inline>
  (function () {
    var f = document.querySelector('[data-mw-waitlist]');
    if (!f) return;
    var btn = f.querySelector('button[type="submit"]');
    var errEl = f.querySelector('.mw-err');
    var showErr = function (m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } };
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      if (errEl) errEl.hidden = true;
      var emailEl = f.querySelector('[name="email"]');
      var email = emailEl ? emailEl.value.trim() : '';
      if (!email || email.indexOf('@') < 1) { showErr('Bitte eine gültige E-Mail-Adresse angeben.'); return; }
      var ts = window.tcmTsToken ? window.tcmTsToken(f)
        : { el: f.querySelector('.cf-turnstile'), token: (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '' };
      if (ts.el && !ts.token) { showErr('Kurz bestätigen, dass du kein Roboter bist, dann nochmal senden.'); return; }
      var val = function (n) { var el = f.querySelector('[name="' + n + '"]'); return el ? el.value : ''; };
      var quelle = val('quelle');
      var data = {
        email: email, standort: val('standort'), quelle: quelle,
        website: val('website'), zeit: new Date().toISOString(), turnstileToken: ts.token,
      };
      if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'Wird gesendet…'; }
      fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) { if (!r.ok) throw new Error('bad_status'); return r.json().catch(function () { return {}; }); })
        .then(function () {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'formular_senden', form_type: 'warteliste', quelle: quelle });
          var ok = document.createElement('div');
          ok.style.cssText = 'text-align:center;padding:14px 4px';
          ok.innerHTML = '<div aria-hidden="true" style="width:44px;height:44px;margin:0 auto 12px;border-radius:50%;background:var(--blue-light);color:var(--blue-dark);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800">✓</div>' +
            '<h3 style="font-size:19px;font-weight:800;color:var(--black);margin:0 0 8px;letter-spacing:-.01em">Danke, du stehst auf der Liste.</h3>' +
            '<p style="font-size:14.5px;color:var(--mid);line-height:1.55">Wir melden uns per E-Mail, sobald die Termine freigegeben sind.</p>';
          f.replaceWith(ok);
        })
        .catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || 'Auf die Warteliste'; }
          if (window.turnstile && ts.el) { try { window.turnstile.reset(ts.el); } catch (_) {} }
          showErr('Senden fehlgeschlagen. Bitte später nochmal versuchen oder an termine@tcm.ch schreiben.');
        });
    });
  })();
</script>
