---
/**
 * End-of-page CARE / Yuna concierge for DE clinic pages and Zürich hub.
 * Enquiry opens the existing central TCM.ch WhatsApp number with local context.
 * No extra API form, no false availability, no symptom text in analytics.
 */
interface Props {
  locationName?: string;
  status?: 'operational' | 'planned' | 'review';
  isZurichHub?: boolean;
  lang?: 'de' | 'en';
}
const { locationName = '', status = 'operational', isZurichHub = false, lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const limited = status !== 'operational';
const location = isZurichHub ? 'Zürich' : locationName;
const lead = isEn
  ? isZurichHub
    ? 'Tell us what you need. We help you find a suitable Zürich clinic and request an appointment.'
    : limited
      ? 'Questions about this location? We clarify its status and discuss suitable alternatives.'
      : 'Tell us about your concerns. We can help with treatment questions and an appointment enquiry at this location.'
  : isZurichHub
    ? 'Schilder uns dein Anliegen. Wir helfen dir, eine passende Zürcher Praxis und einen Termin anzufragen.'
    : limited
      ? 'Du hast Fragen zu diesem Standort? Wir erklären dir den aktuellen Stand und mögliche Alternativen.'
      : 'Schilder uns dein Anliegen. Wir helfen dir bei der Behandlung und Terminanfrage an diesem Standort.';
---
<section class="cc-section" id="care-concierge" aria-labelledby="cc-title" data-cc-location={location} data-cc-status={status} data-cc-hub={isZurichHub ? 'true' : 'false'} data-cc-lang={lang}>
  <div class="cc-wrap">
    <div class="cc-intro">
      <div class="cc-eyebrow">CARE Concierge · TCM.ch</div>
      <h2 id="cc-title">{isEn ? 'The right clinic.' : 'Die passende Praxis.'}<br><em>{isEn ? 'Personal guidance.' : 'Persönlich empfohlen.'}</em></h2>
      <p class="cc-lead">{lead}</p>
      <div class="cc-yuna-card home-cta-merged">
        <img src="/images/Yuna.jpg" width="1875" height="2500" alt="Yuna – TCM.ch Concierge" loading="lazy" decoding="async" />
        <div class="cc-yuna-copy">
          <strong>{isEn ? 'Personal support from our team' : 'Persönlich für dich da'}</strong>
          <span>{isEn ? 'We read your enquiry and help you choose a clinic or appointment.' : 'Wir lesen deine Anfrage und helfen dir bei der Praxis- und Terminwahl.'}</span>
        </div>
      </div>
    </div>
    <div class="cc-card">
      <div class="cc-card-head">
        <div class="cc-card-symbol" aria-hidden="true">✦</div>
        <div><strong>CARE Concierge</strong><span>{isEn ? 'Personal help with your enquiry' : 'Persönliche Unterstützung bei deiner Anfrage'}</span></div>
      </div>
      <form class="cc-enquiry" autocomplete="off">
        <label for="cc-complaint-field">{isEn ? 'Briefly describe your concern or question' : 'Beschwerden oder Frage kurz schildern'}</label>
        <p>{isEn ? 'One or two sentences are enough. ' : 'Ein bis zwei Sätze genügen. '}{isEn ? isZurichHub ? 'We help you choose a Zürich clinic.' : limited ? 'We check the options for this location.' : 'We consider your preferred location.' : isZurichHub ? 'Wir helfen dir, eine Zürcher Praxis auszuwählen.' : limited ? 'Wir prüfen die Möglichkeiten für diesen Standort.' : 'Wir berücksichtigen deinen gewünschten Standort.'}</p>
        <textarea id="cc-complaint-field" rows="3" maxlength="600" placeholder={isEn ? "e.g. I have had back pain for several weeks …" : "z. B. Ich habe seit einigen Wochen Rückenschmerzen …"}></textarea>
        <div class="cc-pills" aria-label={isEn ? "Common concerns" : "Häufige Anliegen"}>
          <button type="button" data-cc-preset={isEn ? "I have neck pain since " : "Ich habe Nackenschmerzen seit "}>{isEn ? "Neck pain" : "Nackenschmerzen"}</button>
          <button type="button" data-cc-preset={isEn ? "I have back pain since " : "Ich habe Rückenschmerzen seit "}>{isEn ? "Back pain" : "Rückenschmerzen"}</button>
          <button type="button" data-cc-preset={isEn ? "I have migraines since " : "Ich habe Migräne seit "}>{isEn ? "Migraine" : "Migräne"}</button>
          <button type="button" data-cc-preset={isEn ? "I have stress or sleep problems since " : "Ich habe Stress oder Schlafprobleme seit "}>{isEn ? "Stress & sleep" : "Stress & Schlaf"}</button>
          <button type="button" data-cc-preset={isEn ? "I have digestive symptoms since " : "Ich habe Verdauungsprobleme seit "}>{isEn ? "Digestion" : "Verdauung"}</button>
          <button type="button" data-cc-preset={isEn ? "I have questions about my cycle or hormones: " : "Ich habe Fragen zu Zyklus oder Hormonen: "}>{isEn ? "Cycle / hormones" : "Zyklus / Hormone"}</button>
        </div>
        <button type="submit" class="cc-submit">{isEn ? 'Send enquiry via WhatsApp' : 'Anfrage per WhatsApp senden'} <span aria-hidden="true">→</span></button>
        <p class="cc-disclaimer">{isEn ? 'Opens WhatsApp. No treatment or appointment is booked automatically.' : 'Öffnet WhatsApp. Eine Behandlung oder ein Termin wird nicht automatisch gebucht.'}</p>
      </form>
    </div>
  </div>
</section>
<style is:global>
  body .cc-section {
    display:block!important;min-height:0!important;
    background:var(--tcm-ink,#171B1A)!important;color:#fff!important;
    padding:clamp(44px,5vw,76px) 20px!important;
    overflow:hidden;
  }
  body .cc-wrap {
    max-width:1120px;margin:auto;display:grid;
    grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);
    gap:clamp(24px,4vw,56px);align-items:center;
  }
  body .cc-intro{min-width:0}
  body .cc-eyebrow{
    font-size:11px;font-weight:750;letter-spacing:.13em;
    color:rgba(255,255,255,.75);margin-bottom:13px;
  }
  body .cc-intro h2{
    font-size:clamp(28px,3.3vw,42px);line-height:1.15;
    letter-spacing:-.035em;font-weight:800;color:#fff!important;margin:0 0 16px;
  }
  body .cc-intro h2 em{color:#fff!important;font-weight:700}
  body .cc-lead{
    font-size:15px;line-height:1.65;color:rgba(255,255,255,.82)!important;
    max-width:48ch;margin:0 0 22px;
  }
  body .cc-yuna-card{
    display:flex;align-items:center;gap:14px;padding:11px;
    max-width:475px;border-radius:16px;
    border:1px solid rgba(255,255,255,.18);
    background:rgba(255,255,255,.055);
  }
  body .cc-yuna-card img{
    display:block;width:100px;height:130px;flex:0 0 100px;
    object-fit:cover;object-position:50% 15%;
    border-radius:11px;background:#d9d5d0;
  }
  body .cc-yuna-copy{
    display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0;
    color:#fff!important;
  }
  body .cc-yuna-copy strong{
    font-size:14.5px;line-height:1.35;color:#fff!important;
  }
  body .cc-yuna-copy>span{
    font-size:12.5px;line-height:1.45;color:rgba(255,255,255,.88)!important;
  }
  body .cc-yuna-link{
    display:inline-flex;align-items:center;gap:7px;
    text-decoration:none!important;font-size:12.5px;line-height:1.35;
    font-weight:700;color:#fff!important;
    background:transparent!important;min-height:40px;
    border:1px solid rgba(255,255,255,.42);
    border-radius:999px;padding:8px 13px;margin-top:3px;
    white-space:normal;
  }
  body .cc-yuna-link:hover{
    background:rgba(255,255,255,.12)!important;
    border-color:rgba(255,255,255,.8);
  }
  body .cc-card{
    border:1px solid var(--tcm-border,#D7D4D0);
    border-radius:19px;background:#fff;color:var(--tcm-ink,#171B1A)!important;
    padding:22px;min-width:0;
    box-shadow:0 10px 28px rgba(0,0,0,.12);
  }
  body .cc-card-head{
    display:flex;align-items:center;gap:10px;padding:0 0 14px;
    margin-bottom:14px;border-bottom:1px solid var(--tcm-border,#D7D4D0);
  }
  body .cc-card-symbol{
    width:35px;height:35px;border-radius:50%;
    background:var(--tcm-surface-strong,#E8E6E3);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  body .cc-card-head>div:last-child{display:flex;flex-direction:column;gap:2px}
  body .cc-card-head strong{
    color:var(--tcm-ink,#171B1A)!important;font-size:13.5px;
  }
  body .cc-card-head span{
    font-size:11px;color:var(--tcm-text-soft,#505453)!important;
  }
  body .cc-enquiry{
    display:flex;flex-direction:column;gap:9px;margin:0;
  }
  body .cc-enquiry label{
    font-size:11px;text-transform:uppercase;letter-spacing:.09em;font-weight:750;
    color:var(--tcm-text-soft,#505453);
  }
  body .cc-enquiry>p:not(.cc-disclaimer){
    font-size:12.5px;line-height:1.45;color:var(--tcm-text-soft,#505453);
    margin:0 0 2px;
  }
  body .cc-enquiry textarea{
    box-sizing:border-box;display:block;width:100%;resize:vertical;min-height:92px;
    padding:13px 14px;border:1px solid var(--tcm-border,#D7D4D0);
    border-radius:12px;font:inherit;font-size:14px;line-height:1.5;
    background:#fff;color:var(--tcm-ink,#171B1A);outline:none;
  }
  body .cc-enquiry textarea:focus{
    border-color:var(--tcm-primary,#1769B1)!important;
    box-shadow:0 0 0 3px rgba(23,105,177,.14)!important;
  }
  body .cc-pills{
    display:flex;flex-wrap:wrap;gap:7px;margin:3px 0 4px;
  }
  body .cc-pills button{
    min-height:32px;padding:6px 11px;border-radius:999px;cursor:pointer;
    border:1px solid var(--tcm-border,#D7D4D0);
    background:var(--tcm-surface,#F4F2EF);color:var(--tcm-ink,#171B1A);
    font-size:12px;line-height:1.2;font-weight:600;
  }
  body .cc-pills button:hover{
    background:#fff;border-color:var(--tcm-ink,#171B1A);
  }
  body .cc-submit{
    display:flex;align-items:center;justify-content:center;gap:8px;
    width:100%;min-height:48px;margin-top:4px;cursor:pointer;
    border:1px solid var(--tcm-primary,#1769B1);
    border-radius:999px;background:var(--tcm-primary,#1769B1)!important;
    color:#fff!important;font-size:14px;font-weight:750;
    box-shadow:none!important;
  }
  body .cc-submit:hover{
    background:var(--tcm-primary-hover,#10558F)!important;
    border-color:var(--tcm-primary-hover,#10558F)!important;
  }
  body .cc-disclaimer{
    color:var(--tcm-text-soft,#505453)!important;
    text-align:center;font-size:11px;line-height:1.5;margin:0!important;
  }
  body .cc-section :is(button,a):focus-visible{
    outline:3px solid var(--tcm-primary,#1769B1);
    outline-offset:3px;
  }
  @media(max-width:900px){
    body .cc-section{padding:42px 16px!important}
    body .cc-wrap{
      grid-template-columns:minmax(0,1fr);gap:18px;
    }
    body .cc-intro h2{font-size:clamp(25px,7vw,34px);margin-bottom:10px}
    body .cc-lead{font-size:14px;line-height:1.5;margin-bottom:15px}
    body .cc-yuna-card{max-width:none;padding:10px;gap:12px}
    body .cc-yuna-card img{
      width:74px;height:94px;flex-basis:74px;
    }
    body .cc-card{padding:17px}
  }
  @media(max-width:360px){
    body .cc-yuna-card img{width:64px;height:89px;flex-basis:64px}
    body .cc-yuna-link{font-size:11.5px;padding:7px 10px}
  }
</style>
<script is:inline>
  (function(){
    var root=document.getElementById('care-concierge');
    if(!root || root.dataset.ccReady==='1') return;
    root.dataset.ccReady='1';
    var field=root.querySelector('#cc-complaint-field');
    var form=root.querySelector('.cc-enquiry');
    root.querySelectorAll('[data-cc-preset]').forEach(function(btn){
      btn.addEventListener('click',function(){
        field.value=btn.getAttribute('data-cc-preset')||'';
        field.focus();field.setSelectionRange(field.value.length,field.value.length);
      });
    });
    form.addEventListener('submit',function(event){
      event.preventDefault();
      var issue=(field.value||'').trim();
      var loc=root.getAttribute('data-cc-location')||'';
      var status=root.getAttribute('data-cc-status')||'operational';
      var english=root.getAttribute('data-cc-lang')==='en';
      var context=root.getAttribute('data-cc-hub')==='true'
        ? (english ? 'a TCM.ch clinic in Zürich' : 'Zürich')
        : (english ? 'the TCM.ch clinic in '+loc : loc);
      var prefix=english
        ? status==='operational'
          ? 'Hello, I would like to enquire about an appointment at '+context+'.'
          : 'Hello, I have a question about the current status of '+context+'.'
        : status==='operational'
          ? 'Hallo, ich möchte einen passenden Termin bei TCM.ch in '+context+' anfragen.'
          : 'Hallo, ich habe eine Frage zum TCM.ch Standort '+context+'.';
      var msg=prefix+(issue ? (english ? ' My concern: ' : ' Mein Anliegen: ')+issue+'.' : '')+
        (english ? ' Could you advise me personally?' : ' Könnt ihr mich persönlich beraten?');
      try{
        window.dataLayer=window.dataLayer||[];
        window.dataLayer.push({
          event:'wa_click',
          quelle:root.getAttribute('data-cc-hub')==='true' ? 'zh_concierge' : 'standort_concierge',
          prefilled:issue.length>0
        });
      }catch(e){}
      window.open('https://wa.me/41775236122?text='+encodeURIComponent(msg),'_blank','noopener,noreferrer');
    });
  })();
</script>
