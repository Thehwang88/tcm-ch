---
// Shared English compact footer. Clinics and therapies remain accessible via the hubs.
import { site } from '../data/site';
import { enLocationPath } from '../data/locations';
import '../styles/footer-compact.css';
import WhatsAppFab from './WhatsAppFab.astro';
import WhatsAppConcierge from './WhatsAppConcierge.astro';
import StickyCtaBar from './StickyCtaBar.astro';

const year = new Date().getFullYear();
const treatments = [
  ['/en/therapies/acupuncture/', 'Acupuncture'],
  ['/en/therapies/tuina-massage/', 'Tuina Massage'],
  ['/en/therapies/cupping/', 'Cupping'],
  ['/en/therapies/chinese-herbal-medicine/', 'Herbal Medicine'],
  ['/en/conditions/', 'Conditions & Symptoms'],
  ['/en/therapies/', 'All Treatments'],
] as const;
const clinics = [
  ['/en/acupuncture-zurich/', 'Zürich · All Clinics'],
  [enLocationPath('st-gallen'), 'St. Gallen'],
  [enLocationPath('winterthur-marktgasse'), 'Winterthur'],
  [enLocationPath('basel'), 'Basel'],
  [enLocationPath('bern'), 'Bern'],
  ['/en/locations/', 'All Locations'],
] as const;
const information = [
  ['/en/contact/', 'Contact'],
  ['/en/health-insurance-acupuncture/', 'Insurance & Costs'],
  ['/en/knowledge/', 'Knowledge & Guides'],
  ['/en/acupuncture-near-me/', 'Acupuncture Near Me'],
  ['/ueber-uns/', 'About TCM.ch (German)'],
] as const;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-inner footer-inner--tidy">
      <div class="footer-brand-col">
        <a href="/en/" class="footer-logo" aria-label="TCM.ch Clinics – home">
          <img src="/images/logo/tcm-ch-logo-kliniken-mint.svg" alt="TCM.ch Clinics" width="168" height="57" loading="lazy">
        </a>
        <p class="footer-tagline">Acupuncture &amp; Traditional Chinese Medicine in Switzerland.<br>Clinics and partner practices.</p>
        <a href="/en/contact/" class="footer-contact-cta">Request an appointment <span aria-hidden="true">→</span></a>
        <a href={"mailto:"+site.email} class="footer-mail">{site.email}</a>
      </div>
      <div class="footer-col">
        <h4>Treatments</h4>
        <ul id="footer-therapies">{treatments.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div class="footer-col">
        <h4>Locations</h4>
        <ul id="footer-locations">{clinics.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div class="footer-col footer-col--info">
        <h4>Information</h4>
        <ul id="footer-info-links">{information.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">© {year} TCM.ch · Switzerland</div>
      <div class="footer-legal">
        <a href="/datenschutz/">Privacy</a>
        <a href="/impressum/">Legal notice</a>
        <a href="/agb/">Terms</a>
        <a href="#" data-cky-tag="revisit-consent" onclick="event.preventDefault();if(window.revisitCkyConsent)window.revisitCkyConsent();">Cookie settings</a>
        <a href="/karriere/">Careers</a>
      </div>
    </div>
  </div>
</footer>
<WhatsAppFab lang="en" />
<WhatsAppConcierge lang="en" />
<StickyCtaBar lang="en" />
<script is:inline>
  // EN prefill for the concierge CTA (the shared widget builds a German prefill from the page title).
  (function () {
    var cta = document.getElementById('wac-cta');
    if (!cta) return;
    var t = (document.title || '').replace(/\s*[|–-]\s*TCM\.ch.*$/i, '').trim() || 'TCM.ch';
    cta.href = 'https://wa.me/41775236122?text=' + encodeURIComponent('Hello, I am on the page "' + t + '" on tcm.ch and have a question.');
  })();
</script>
