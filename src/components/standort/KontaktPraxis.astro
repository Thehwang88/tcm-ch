---
// Gemeinsamer Kontakt-/Praxisbereich der Standortseiten nach der St.-Gallen-Vorlage (aus HeroStandardSG ausgelagert,
// 16.10.2026): kompakte USP-Reihe, darunter Praxisangaben links und Anfragebox rechts (Desktop, Box oben bündig,
// optional sticky); mobil Box vor Praxisangaben (= DOM-Reihenfolge). Inhalte kommen per Slot (usp, form, info).
// St. Gallen: HeroStandardSG (Leaf-Inhalte als HTML), übrige Standorte: standorte/[slug].astro (Datenkomponenten).
const { id = 'sg-kontakt-praxis', uspLabel = 'Darum TCM.ch St. Gallen' } = Astro.props as { id?: string; uspLabel?: string };
const hasUsp = Astro.slots.has('usp');
const hasInfo = Astro.slots.has('info');
---
{hasUsp && <section class="sgu" aria-label={uspLabel}><div class="sgu-wrap"><slot name="usp" /></div></section>}
<section class="sgk" id={id}>
  <div class="sgk-inner">
    <div class="sgk-formcol"><slot name="form" /></div>
    {hasInfo && <div class="sgk-info"><slot name="info" /></div>}
  </div>
</section>

<style is:global>
  /* Hero: Höhen, Abstände und Foto-Ausschnitt aus den regulären Standort-Heros (.lsr-* in home.css), keine SG-Ausnahme. */

  /* USP-Reihe: Desktop drei nebeneinander, Mobile kompakte Zeilen statt hoher Karten. */
  .sgu { background: #fff; border-bottom: 1px solid var(--border); padding: 20px 16px; }
  .sgu-wrap { max-width: var(--max, 1280px); margin: 0 auto; }
  .sgu .usp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; max-width: none; }
  .sgu .usp-card { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; row-gap: 0; align-items: center; padding: 14px 16px; }
  .sgu .usp-icon { grid-row: 1 / span 2; }
  .sgu .usp-card:hover { transform: none; box-shadow: none; }
  .sgu .usp-icon { flex-shrink: 0; width: 40px; height: 40px; margin: 0; }
  .sgu .usp-title { margin: 0; }
  .sgu .usp-sub { margin: 2px 0 0; }
  @media (max-width: 760px) {
    .sgu { padding: 8px 16px; }
    .sgu .usp-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .sgu .usp-card { background: none; border: 0; border-radius: 0; padding: 10px 0; column-gap: 12px; row-gap: 0; }
    .sgu .usp-card + .usp-card { border-top: 1px solid var(--border); }
    .sgu .usp-icon { width: 32px; height: 32px; }
    .sgu .usp-icon svg { width: 18px; height: 18px; }
  }

  /* Kontaktsektion: Desktop Praxisangaben links, Buchungsbox rechts (oben bündig); darunter gestapelt, Box zuerst. */
  .sgk { background: var(--surface); padding: clamp(24px, 4vw, 56px) 16px; }
  .sgk-inner { max-width: var(--max, 1280px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .sgk-formcol { min-width: 0; }
  .sgk-formcol .kf { width: 100%; max-width: 560px; margin: 0 auto; }
  .sgk-info { min-width: 0; max-width: 720px; width: 100%; margin: 0 auto; }
  .sgk-info .up-h2 { margin-top: 0; }
  @media (min-width: 1024px) {
    .sgk-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 520px); grid-template-areas: "info form"; gap: clamp(32px, 4vw, 64px); align-items: start; padding: 0 clamp(8px, 2vw, 40px); }
    .sgk-info { grid-area: info; max-width: none; margin: 0; }
    .sgk-formcol { grid-area: form; }
    .sgk-formcol .kf { margin: 0; }
    /* Nur per JS gesetzt, wenn die ganze Box ins Fenster passt und die Sektion Scrollstrecke bietet. */
    .sgk-formcol.is-sticky { position: sticky; top: var(--sgk-top, 92px); }
  }
</style>
<script is:inline>
  // Sticky-Box nur ab 1024 px, nur wenn die komplette Box (inkl. aufgeklappter Bereiche/Fehler) unter dem fixen Header
  // ins Fenster passt und die Praxisspalte eine sinnvolle Scrollstrecke bietet; sonst normales Mitscrollen.
  (function () {
    var col = document.querySelector('.sgk-formcol'), info = document.querySelector('.sgk-info');
    if (!col || !info || !window.matchMedia) return;
    var mq = window.matchMedia('(min-width: 1024px)');
    var headerH = function () {
      var h = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 76;
      var nav = document.querySelector('nav');
      if (nav && getComputedStyle(nav).position === 'fixed') h = Math.max(h, nav.getBoundingClientRect().bottom);
      return h;
    };
    var update = function () {
      var top = Math.round(headerH() + 16), box = col.querySelector('.kf');
      var fits = box && box.offsetHeight <= window.innerHeight - top - 16;
      var room = info.offsetHeight - col.offsetHeight >= 120;
      var on = mq.matches && fits && room;
      col.style.setProperty('--sgk-top', top + 'px');
      col.classList.toggle('is-sticky', !!on);
    };
    update();
    window.addEventListener('resize', update);
    if (mq.addEventListener) mq.addEventListener('change', update);
    if (window.ResizeObserver) { var ro = new ResizeObserver(update); ro.observe(col); ro.observe(info); }
    window.addEventListener('load', update);
  })();
</script>
