---
import type { Standort } from '../../data/standorte';
import { telHref } from '../../data/standorte';
const { data } = Astro.props as { data: Standort };
const address = `${data.nap.strasse}, ${data.nap.plz} ${data.nap.ort}`;
// Intro prose only (intro + optional Einzugsgebiet). Anfahrt is deliberately NOT here —
// it lives once, in <UeberPraxis/>.
const introHtml = data.intro.body + (data.intro.einzugsgebiet ?? '');
---
<section class="section"><div class="wrap"> <div class="subpage-content-grid" style="display:grid;grid-template-columns:1fr 340px;gap:56px;align-items:start"> <div>
<div class="content-body" set:html={introHtml}></div>
</div> <div>
<div class="subpage-sidebar" style="background:var(--blue-light);border:1px solid rgba(45,155,111,.2);border-radius:20px;padding:24px;margin-bottom:16px;position:sticky;top:80px"> <div style="font-size:13px;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px">TCM-Praxis {data.stadt}</div> <div style="font-size:13px;color:var(--mid);margin-bottom:18px">{address}</div> <a href="#kontakt" class="btn-primary" style="width:100%;justify-content:center;margin-bottom:10px;display:flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;flex-shrink:0"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> Termin anfragen</a> <a href={telHref(data.nap.telefon)} class="btn-secondary" style="width:100%;justify-content:center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;flex-shrink:0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.97-.97a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17z"></path></svg> Anrufen</a> <div style="margin-top:18px;padding-top:18px;border-top:1px solid rgba(45,155,111,.15)"> <div style="font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:500">ÖFFNUNGSZEITEN</div> <div style="font-size:13px;color:var(--mid);line-height:1.8">{data.nap.oeffnungszeiten.map((o, i) => (<Fragment>{i > 0 && <br />}{o.tag} {o.zeit}</Fragment>))}</div> </div> </div></div> </div> </div></section>
