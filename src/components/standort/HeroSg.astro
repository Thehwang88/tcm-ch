---
// Zürich-Pilot (20.11.2026): Hero nach der St.-Gallen-Vorlage (HeroStandardSG) für datengetriebene Standortseiten.
// Hauptbutton öffnet das Termin-Popup (booking-sheet.js, Typ clinic → #anfrage-box) mit vorgewähltem Gratis-Check-in,
// Zweitbutton WhatsApp (kein OneDoc in Zürich), Linkzeile Anrufen · Anfahrt, drei Häkchen. Styles: SgLayoutStyles (.lsr-hero.hlsg).
import type { Standort } from '../../data/standorte';
import { telHref, waHref } from '../../data/standorte';
import HeroMedia from './HeroMedia.astro';
import SgLayoutStyles from './SgLayoutStyles.astro';
const { data } = Astro.props as { data: Standort };
const eyebrow = data.betreiber ? `${data.betreiber.name} · Partnerpraxis im TCM.ch Netzwerk` : `TCM.ch Praxis · ${data.stadt}`;
const h1 = data.seo?.h1 ?? `Akupunktur &amp; TCM in <em>${data.stadt}</em>`;
const wa = waHref(data.nap.telefon, `Hallo, ich habe eine Frage zur Behandlung in ${data.stadt}.`);
const adresse = `${data.nap.strasse}, ${data.nap.plz} ${data.nap.ort}`;
// Mobile Kurzzeile: Standort-Hook, sofern kurz; sonst Adresse.
const kurz = data.hero.locationHook && data.hero.locationHook.length <= 60 ? data.hero.locationHook : `${data.nap.strasse} · ${data.nap.plz} ${data.nap.ort}`;
// WhatsApp-Icon der Seite (identischer Pfad wie WA_ICON in lib/kontakt-form.ts).
const WA_SVG = '<svg class="lsr-wa-ic" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>';
---
<section class="lsr-hero hlsg std-sg-hero">
  <div class="lsr-inner">
    <div class="lsr-left">
      <span class="lsr-eyebrow">{eyebrow}</span>
      <h1 class="lsr-h1" set:html={h1}></h1>
      <p class="lsr-lead"><span class="lsr-lead-d" set:html={data.hero.lead}></span><span class="lsr-lead-m">{kurz}</span></p>
      <div class="lsr-ctas">
        <a href="#termin-formular" class="lsr-btn-primary tcm-btn tcm-btn--primary tcm-btn--hero" data-booking-sheet="clinic" data-booking-wish="checkin" data-kf-terminart="checkin" data-care-cta="hero-checkin">30 Min. gratis Termin anfragen ⚡️</a>
        <a href={wa} target="_blank" rel="noopener noreferrer" class="lsr-btn-ghost tcm-btn tcm-btn--outline tcm-btn--hero" data-care-cta="hero-wa"><Fragment set:html={WA_SVG} /> Per WhatsApp schreiben</a>
      </div>
      <p class="lsr-quick">
        <a href={telHref(data.nap.telefon)} data-kf-tel data-care-cta="hero-tel">Anrufen</a><span aria-hidden="true">·</span><a href="#sg-standort" data-care-cta="hero-anfahrt">Anfahrt</a>
      </p>
      <ul class="lsr-usp">
        <li><span class="lsr-check" aria-hidden="true">✓</span>Krankenkassen anerkannt (EMR/ASCA)</li>
        <li><span class="lsr-check" aria-hidden="true">✓</span>{adresse}</li>
        <li><span class="lsr-check" aria-hidden="true">✓</span>Kurzfristige Termine verfügbar</li>
      </ul>
    </div>
    <HeroMedia />
  </div>
</section>
<SgLayoutStyles />
