---
import type { Standort } from '../../data/standorte';
import { telHref } from '../../data/standorte';
const { data } = Astro.props as { data: Standort };
const address = `${data.nap.strasse}, ${data.nap.plz} ${data.nap.ort}`;
// This is the SINGLE source of Anfahrt on the page (oev + autoParken). IntroNap holds no
// Anfahrt.
---
<section class="up-sec"><div class="up-wrap"><h2 class="up-h2">Über die Praxis</h2><div class="up-grid"><div class="up-item"><div class="up-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></div><div class="up-body"><div class="up-label">Email</div><a class="up-val" href={`mailto:${data.nap.email}`}>{data.nap.email}</a></div></div><div class="up-item"><div class="up-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92V21a1 1 0 0 1-1.09 1 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 3.21 4.09 1 1 0 0 1 4.2 3h4.09a1 1 0 0 1 1 .75 12.13 12.13 0 0 0 .66 2.81 1 1 0 0 1-.22 1L8.09 9.91a16 16 0 0 0 6 6l2.35-1.64a1 1 0 0 1 1-.22 12.13 12.13 0 0 0 2.81.66 1 1 0 0 1 .75 1z"></path></svg></div><div class="up-body"><div class="up-label">Mobil</div><a class="up-val" href={telHref(data.nap.telefon)}>{data.nap.telefon}</a></div></div><div class="up-item"><div class="up-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div><div class="up-body"><div class="up-label">Adresse</div><div class="up-val">{address}</div></div></div><div class="up-item"><div class="up-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div><div class="up-body"><div class="up-label">Öffnungszeiten</div><div class="up-val">{data.nap.oeffnungszeiten.map((o) => (<div>{o.tag} {o.zeit}</div>))}</div></div></div></div><div class="up-map">{data.nap.mapEmbed && <iframe src={data.nap.mapEmbed} width="100%" height="320" style="border:0;display:block" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Karte: TCM.ch ${data.stadt}, ${data.nap.strasse}`}></iframe>}</div><div class="up-transit"><h3 class="up-transit-h">Lage &amp; Anfahrt</h3>{data.anfahrt.oev && <p class="up-transit-area"><strong>Mit dem Zug &amp; ÖV:</strong> <span set:html={data.anfahrt.oev}></span></p>}{data.anfahrt.autoParken && <p class="up-transit-area"><strong>Mit dem Auto &amp; Parken:</strong> <span set:html={data.anfahrt.autoParken}></span></p>}</div></div></section>
