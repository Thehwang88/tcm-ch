---
import type { Standort } from '../../data/standorte';
import { telHref } from '../../data/standorte';
import { heroVideo, isSymbolbild } from '../../data/hero-video';
import { clinics } from '../../data/locations';
// SG-Vorlage: ohne eigene <section>-Hülle, als Praxisspalte im Kontaktbereich (Slot info in KontaktPraxis.astro), wie in
// St. Gallen mit Telefon und E-Mail und voller Kartenhöhe.
const { data, sg = false } = Astro.props as { data: Standort; sg?: boolean };
/* Same local clinic image used in the desktop appointment sidebar.
   Present it below "Über die Praxis" on mobile instead of before the booking form. */
const mobileClinicPhoto = sg && !data.planned
  ? (clinics.find((c) => c.id === data.slug)?.bild ?? data.praxisBilder?.[0])
  : undefined;
// sg (SG-Vorlage, 08.11.2026): Einleitung immer, keine Praxisfotos (das Foto steht links im Termin-Bereich, TerminSektion);
// der lokale Intro-Text (intro.body ohne eigene H2) folgt als Prosa unter der Einleitung, wie in St. Gallen.
const introProsa = sg ? (data.intro?.body ?? '').replace(/^\s*<h2[^>]*>[\s\S]*?<\/h2>/, '') : '';
const address = data.nap.strasse ? `${data.nap.strasse}, ${data.nap.plz} ${data.nap.ort}` : data.nap.ort; // ohne Strasse (vorVertrag): nur Ort
// This is the SINGLE source of Anfahrt on the page (oev + autoParken). IntroNap holds no
// Anfahrt. CRO-Layout: Kontakt-Reihenfolge Adresse → Öffnungszeiten → Telefon → E-Mail,
// Anfahrt-Text im "Anreise & Parkieren"-Accordion (server-gerendert, crawlbar).
const icons = {
  mail: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>',
  tel: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92V21a1 1 0 0 1-1.09 1 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 3.21 4.09 1 1 0 0 1 4.2 3h4.09a1 1 0 0 1 1 .75 12.13 12.13 0 0 0 .66 2.81 1 1 0 0 1-.22 1L8.09 9.91a16 16 0 0 0 6 6l2.35-1.64a1 1 0 0 1 1-.22 12.13 12.13 0 0 0 2.81.66 1 1 0 0 1 .75 1z"></path></svg>',
  pin: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>',
  clock: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>',
};
const key = (k: 'mail' | 'tel' | 'pin' | 'clock') => icons[k];
type Item = { icon: string; label: string; kind: 'mail' | 'tel' | 'text' | 'hours' };
const orderAll: Item[] = data.cro
  ? [
      { icon: key('pin'), label: 'Adresse', kind: 'text' },
      { icon: key('clock'), label: 'Öffnungszeiten', kind: 'hours' },
      { icon: key('tel'), label: 'Telefon', kind: 'tel' },
      { icon: key('mail'), label: 'E-Mail', kind: 'mail' },
    ]
  : [
      { icon: key('mail'), label: 'Email', kind: 'mail' },
      { icon: key('tel'), label: 'Mobil', kind: 'tel' },
      { icon: key('pin'), label: 'Adresse', kind: 'text' },
      { icon: key('clock'), label: 'Öffnungszeiten', kind: 'hours' },
    ];
// Standorte ohne bestätigte Öffnungszeiten (leeres Array) zeigen die Zeile nicht.
// CRO-L3.3 (operative v2-Piloten, slim): Intro-Satz entfällt (dupliziert Hero/IntroNap,
// trug einen unbelegten Verfügbarkeits-Claim). Tel/Mail stehen seit der SG-Vorlage wieder für alle im up-grid
// (Praxisspalte neben der Anfragebox, die Kontaktkacheln unten entfallen).
const slim = Boolean(data.v2 && !data.planned);
const order = orderAll.filter((it) => it.kind !== 'hours' || data.nap.oeffnungszeiten.length > 0);
const hasAnfahrt = Boolean(data.anfahrt.oev || data.anfahrt.autoParken);
// CRO-L3-Images: Praxisbilder, die dasselbe Asset wie der Hero zeigen, nicht wiederholen
// (normalisierter Pfadvergleich; Asset-Dateien bleiben unangetastet).
const norm = (p: string) => (p || '').replace(/^https?:\/\/[^/]+/, '').split(/[?#]/)[0].replace(/\/{2,}/g, '/');
// Geplante Standorte: keine Praxisfotos (es gibt noch keine Praxis, die sie zeigen könnten).
// Hero-Video (hero-video.ts): das Praxisfoto ist nur noch Poster, also hier zeigen (echte Praxisfotos, nie Symbolbilder).
const praxisBilder = (data.planned || sg ? [] : data.praxisBilder ?? []).filter((b) => heroVideo(data) ? !isSymbolbild(b.src) : norm(b.src) !== norm(data.hero.image));
// Paar quer + hoch (z. B. Basel): Spalten im Verhältnis der Seitenverhältnisse → gleiche Bildhöhe; mobil untereinander.
const paar = praxisBilder.length === 2 && praxisBilder.every((b) => b.ratio);
const paarCols = praxisBilder.map((b) => { const [w, h] = (b.ratio ?? '4/3').split('/').map(Number); return (w / h).toFixed(3) + 'fr'; }).join(' ');
---
<h2 class="up-h2">Über die Praxis</h2>
{mobileClinicPhoto && (
  <figure class="up-mobile-clinic-photo">
    <img src={mobileClinicPhoto.src} alt={mobileClinicPhoto.alt} width="1200" height="900" loading="lazy" decoding="async" />
  </figure>
)}
{(sg || ((data.cro || data.praxisBilder) && !slim)) && (
  <div class="content-body" style="margin-bottom:18px"><p>{data.review && !data.nap.strasse ? 'Termine in Zürich vergeben wir aktuell in unseren Praxen in Oerlikon und Höngg. Deine Anfrage nehmen wir gern entgegen und schlagen dir die passende Praxis vor.' : data.review ? `Ob an der ${data.nap.strasse} in ${data.nap.ort} Termine möglich sind, ist noch nicht bestätigt. Deine Anfrage nehmen wir gern entgegen und schlagen dir eine passende Praxis in der Nähe vor.` : data.planned ? `Unsere neue Praxis an der ${data.nap.strasse} in ${data.nap.ort} ist in Vorbereitung. Anfragen für die Zeit nach der Eröffnung sind bereits möglich.` : `${data.betreiber ? `Die ${data.betreiber.name} (Partnerpraxis im TCM.ch Netzwerk)` : 'Unsere Praxis'} an der ${data.nap.strasse} in ${data.nap.ort} verbindet klassische TCM mit moderner Diagnostik. Termine fragst du direkt über das Formular, per WhatsApp oder Telefon an.`}</p>{introProsa && <Fragment set:html={introProsa} />}</div>
)}
{praxisBilder.length > 0 && (
  <div class={paar ? 'up-bilder-paar' : undefined} style={paar ? `--up-cols:${paarCols}` : 'display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin:0 0 22px' + (data.v2 ? ';max-width:440px' : '')}>
  {praxisBilder.map((b) => (
    <figure style="margin:0;border-radius:var(--r-card);overflow:hidden;box-shadow:var(--sh-md);position:relative">
      <img src={b.src} srcset={b.srcset} sizes={b.srcset ? (paar ? '(max-width:639px) 100vw, 480px' : '(max-width:1023px) 100vw, 720px') : undefined} alt={b.alt} width={b.width ?? 1448} height={b.height ?? 1086} loading="lazy" decoding="async" style={`width:100%;height:auto;aspect-ratio:${b.ratio ?? '4/3'};object-fit:cover;object-position:${b.pos ?? 'center'};display:block`} />
      <figcaption style="position:absolute;left:10px;bottom:10px;max-width:calc(100% - 20px);background:rgba(255,255,255,.92);color:var(--charcoal);font-family:var(--font-sans);font-size:12.5px;font-weight:700;line-height:1.35;padding:5px 11px;border-radius:999px">{b.label}</figcaption>
    </figure>
  ))}
  </div>
)}
<div class="up-grid">
{order.map((it) => (
  <div class="up-item"><div class="up-ico"><Fragment set:html={it.icon} /></div><div class="up-body"><div class="up-label">{it.label}</div>
    {it.kind === 'mail' && <a class="up-val" href={`mailto:${data.nap.email}`}>{data.nap.email}</a>}
    {it.kind === 'tel' && <a class="up-val" href={telHref(data.nap.telefon)}>{data.nap.telefon}</a>}
    {it.kind === 'text' && <div class="up-val">{address}</div>}
    {it.kind === 'hours' && <div class="up-val">{data.nap.oeffnungszeiten.map((o) => (<div>{o.tag} {o.zeit}</div>))}</div>}
  </div></div>
))}
</div><div class="up-map">{data.nap.mapEmbed && <iframe src={data.nap.mapEmbed} width="100%" height="320" style="border:0;display:block" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Karte: TCM.ch ${data.stadt}, ${data.nap.strasse}`}></iframe>}</div>
{data.nap.mapsPlace && <p class="up-maplinks" style="margin:8px 0 0;font-size:13.5px;color:var(--mid)"><a href={data.nap.mapsPlace} target="_blank" rel="noopener" style="color:var(--blue-dark);font-weight:600">In Google Maps öffnen</a>{data.nap.mapsDirections && <> · <a href={data.nap.mapsDirections} target="_blank" rel="noopener" style="color:var(--blue-dark);font-weight:600">Route planen</a></>}</p>}
{data.cro && hasAnfahrt ? (
  <details class="up-transit-acc" style="margin-top:18px;border:1px solid var(--border);border-radius:12px;padding:0 16px;background:#fff">
    <summary style="cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 0;font-family:var(--font-sans);font-size:15.5px;font-weight:700;color:var(--charcoal)">Anreise &amp; Parkieren<span aria-hidden="true" style="font-size:20px;color:var(--blue);font-weight:600">+</span></summary>
    <div style="padding-bottom:16px" class="up-transit">{data.anfahrt.oev && <p class="up-transit-area"><strong>Mit dem Zug &amp; ÖV:</strong> <span set:html={data.anfahrt.oev}></span></p>}{data.anfahrt.autoParken && <p class="up-transit-area"><strong>Mit dem Auto &amp; Parken:</strong> <span set:html={data.anfahrt.autoParken}></span></p>}</div>
  </details>
) : hasAnfahrt ? (
  <div class="up-transit"><h3 class="up-transit-h">Lage &amp; Anfahrt</h3>{data.anfahrt.oev && <p class="up-transit-area"><strong>Mit dem Zug &amp; ÖV:</strong> <span set:html={data.anfahrt.oev}></span></p>}{data.anfahrt.autoParken && <p class="up-transit-area"><strong>Mit dem Auto &amp; Parken:</strong> <span set:html={data.anfahrt.autoParken}></span></p>}</div>
) : null}
{data.wissenLink && (<p class="sg-wissen-xlink" style="margin:20px 0 0;font-size:15px;line-height:1.55"><a href={data.wissenLink.href} style="color:var(--blue);font-weight:700;text-decoration:none">{data.wissenLink.label} →</a><span style="display:block;color:#4a4a4a;font-size:13.5px;margin-top:3px">{data.wissenLink.sub}</span></p>)}
<style is:global>
  .up-mobile-clinic-photo{display:none}
  @media(max-width:1023px){
    .up-mobile-clinic-photo{display:block;margin:0 0 22px;border-radius:var(--r-card,16px);overflow:hidden;box-shadow:var(--sh-md)}
    .up-mobile-clinic-photo img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}
  }
  .up-bilder-paar{display:grid;grid-template-columns:1fr;gap:16px;margin:0 0 22px}
  @media (min-width:640px){.up-bilder-paar{grid-template-columns:var(--up-cols)}}
</style>
