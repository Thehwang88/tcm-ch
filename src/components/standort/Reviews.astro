---
import type { Standort } from '../../data/standorte';
const { data } = Astro.props as { data: Standort };
const r = data.reviews!;
const heading = r.heading ?? `Erfahrungen in ${data.stadt}.`;
const first = r.items.slice(0, 3);
const extra = r.items.slice(3);
const base = `sub_${data.slug}`;
---
<section class="subpage-reviews"> <div class="wrap"> <div class="reviews-header"> <div> <div class="section-label">Erfahrungen</div> <h2 class="section-title">{heading}</h2> </div> <div class="google-badge">
<svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path></svg>
<span class="google-stars">★★★★★</span> <span class="google-score">4.9</span> <span class="google-count">(Google Reviews)</span> </div> </div> <div class="reviews-grid reveal">
{first.map((it) => (
  <div class="review-card"> <div class="review-stars">{Array.from({ length: it.stern }).map(() => (<svg width="14" height="14" viewBox="0 0 24 24" fill="#2D9B6F" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>))}</div> <p class="review-text">«{it.text}»</p> <div class="review-author"> <div class="review-avatar">{it.autor.charAt(0)}</div> <div> <div class="review-name">{it.autor}</div> <div class="review-city">{it.kontext}</div> </div> </div> </div>
))}
</div>
{extra.length > 0 && (
  <Fragment>
    <div style="text-align:center;margin-top:32px"><button id={`${base}_btn`} onclick={`subReviewsToggle('${base}')`} class="reviews-expand-btn" aria-expanded="false" style="display:inline-flex;align-items:center;gap:10px;padding:14px 28px;background:#fff;border:1px solid #E5E7EB;border-radius:999px;font-family:var(--font-sans);font-size:14.5px;font-weight:600;color:#0d0d0d;cursor:pointer;transition:all .2s ease;box-shadow:0 1px 3px rgba(0,0,0,.04)"><span id={`${base}_icon`} style="display:inline-block;width:14px;height:14px;position:relative;transition:transform .3s ease"><span style="position:absolute;top:50%;left:0;width:100%;height:1.5px;background:#0d0d0d;transform:translateY(-50%)"></span><span style="position:absolute;top:0;left:50%;width:1.5px;height:100%;background:#0d0d0d;transform:translateX(-50%)"></span></span><span id={`${base}_lbl`}>{extra.length} weitere 5-Sterne Erfahrungen ansehen</span></button></div>
    <div id={`${base}_extra`} style="overflow:hidden;max-height:0;opacity:0;transition:max-height .5s ease,opacity .4s ease,margin .3s ease"><div class="reviews-grid" style="margin-top:32px">
    {extra.map((it) => (
      <div class="review-card"> <div class="review-stars">{Array.from({ length: it.stern }).map(() => (<svg width="14" height="14" viewBox="0 0 24 24" fill="#2D9B6F" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>))}</div> <p class="review-text">«{it.text}»</p> <div class="review-author"> <div class="review-avatar">{it.autor.charAt(0)}</div> <div> <div class="review-name">{it.autor}</div> <div class="review-city">{it.kontext}</div> </div> </div> </div>
    ))}
    </div></div>
  </Fragment>
)}
</div> </section>
