---
import type { Standort } from '../../data/standorte';
import { waHref } from '../../data/standorte';
import { heroVideo } from '../../data/hero-video';
import HeroMedia from './HeroMedia.astro';
// SG-Vorlage: Reihenfolge wie der St.-Galler Hero (Vertrauenspunkte vor den Buttons), Hauptbutton springt zur
// Anfragebox direkt unter dem Hero (#anfrage-box), Beschriftung nach Betriebsstatus.
const { data } = Astro.props as { data: Standort };
// Generische Bildwelt (keine Fotos des jeweiligen Standorts): Bildunterschrift «Symbolbild» statt Adresse.
const symbolbild = data.planned || /\/(hero-main\.webp|basel-reception\.webp)$/.test(data.hero.image);
const eyebrow = data.hero.eyebrow ?? (data.betreiber ? `${data.betreiber.name} · Partnerpraxis im TCM.ch Netzwerk` : data.review ? `Standort in Prüfung · ${data.stadt}` : data.planned ? `Geplanter Standort · ${data.stadt}` : `TCM.ch Klinik · ${data.stadt}`);
const heroH1 = data.seo?.h1 ?? (data.slug === 'zuerich-hoengg' ? 'TCM.ch <em>Zürich Höngg</em> – Akupunktur' : `Akupunktur & TCM in <em>${data.stadt}</em>`);
// Softriver lsr-Hero: Opt-in je Standort (Rollout L3 basel, L4 restliche neun).
const LSR_SLUGS = new Set(['basel', 'zuerich-oerlikon', 'zuerich-bahnhofstrasse', 'winterthur-marktgasse', 'winterthur-muenzgasse', 'kreuzlingen', 'frauenfeld', 'rorschach', 'volketswil', 'wil', 'zuerich-hoengg']);
const waTermin = waHref(data.nap.telefon, `Hallo, ich möchte einen Termin in ${data.stadt} anfragen.`);
// Zürcher Standorte hängen unter dem Stadt-Hub /akupunktur-tcm-zuerich/ (Hub-&-Spoke, wie /standorte/zuerich/kosten/).
const zh = data.slug.startsWith('zuerich-');
const zhCRO = zh && !data.planned && !data.review && !data.partnerUmleitung;
// Gemeinsames Hero-Video (src/data/hero-video.ts): bisheriges Hero-Bild bleibt Poster/Fallback, keine Caption.
const video = heroVideo(data);
---
<div id="standort-flagship-hero" style="display:none"></div><div id="sg-premium-hero"></div><div id="zh-premium-hero"></div><div id="win-premium-hero"></div>
{LSR_SLUGS.has(data.slug) ? (
<section class={`lsr-hero std-location-hero${data.planned || data.review ? " std-location-hero--pending" : ""}${data.partnerUmleitung ? " std-location-hero--partner" : ""}${zhCRO ? " zh-cro-hero" : ""}`}>
  <div class="lsr-inner">
    <div class="lsr-left">
      <div class="tsr-crumb" style="color:rgba(2,11,16,.72)"><button onclick="nav('home')">TCM.ch</button><span class="tsr-sep">›</span><button onclick="nav('standorte')">Standorte</button><span class="tsr-sep">›</span>{zh && <Fragment><a href="/akupunktur-tcm-zuerich/" style="color:inherit">Zürich</a><span class="tsr-sep">›</span></Fragment>}<span>{data.stadt}</span></div>
      {(data.planned || data.review || data.partnerUmleitung) && <span class="lsr-eyebrow">{eyebrow}</span>}
      <h1 class="lsr-h1" set:html={heroH1}></h1>
      <p class="lsr-lead std-hero-summary" set:html={data.hero.lead}></p>
      {zhCRO && <p class="zh-cro-lead">Lass dir einen passenden Ersttermin vorschlagen. Wir melden uns persönlich bei dir.</p>}
      <p class="lsr-lead std-hero-detail" style="margin-bottom:22px" set:html={data.hero.sub}></p>
      {data.partnerUmleitung ? (
      <Fragment>
        <p class="lsr-lead lsr-umleitung" style="margin-bottom:22px"><strong>{data.partnerUmleitung.hinweis}</strong></p>
        <div class="lsr-ctas">
          <a href={data.partnerUmleitung.href} class="lsr-btn-primary" target="_blank" rel="noopener">{data.partnerUmleitung.cta}</a>
        </div>
      </Fragment>
      ) : (
      <Fragment>
      <div class="lsr-trust std-hero-trust"><div><span class="lsr-check">✓</span> {data.planned && !data.vorVertrag ? 'Anfragen bereits möglich' : 'Anfrage per WhatsApp oder Telefon'}</div><div><span class="lsr-check">✓</span> {data.planned ? 'Abrechnung über Zusatzversicherung' : zhCRO ? 'Zusatzversicherung je nach Police' : 'Zusatzversicherung anerkannt'}</div><div><span class="lsr-check">✓</span> Persönliche Begleitung</div></div>
      <div class="lsr-ctas">
        <a href="#anfrage-box" class="lsr-btn-primary" data-booking-sheet="clinic">{data.review ? 'Passende Praxis anfragen' : data.planned ? 'Anfrage stellen' : 'Termin anfragen'}</a>
        <a href="/kontakt/" class="lsr-btn-ghost std-hero-phone" data-open-concern data-concern-location={data.stadt} data-concern-location-slug={data.slug}>Anliegen kostenlos schildern</a>
      </div>
      </Fragment>
      )}
      <p class="lsr-note std-hero-note">{data.hero.locationHook}</p>
      {!data.hero.lead.includes(data.nap.strasse) && <p class="std-hero-mobile-address">{data.nap.strasse} · {data.nap.plz} {data.nap.ort}</p>}
    </div>
    {video ? (
    <HeroMedia />
    ) : (
    <figure class={symbolbild ? 'lsr-right' : 'lsr-right lsr-right--foto'}>
      <img src={data.hero.image} alt={data.hero.imageAlt ?? 'Symbolbild: Empfangsbereich einer TCM.ch Praxis'} loading="eager" fetchpriority="high" decoding="async">
      <figcaption>{symbolbild ? 'Symbolbild' : data.hero.locationHook}</figcaption>
    </figure>
    )}
  </div>
</section>
) : (
<div id="generic-premium-hero" class={`sg-active sg-city-${data.slug}`}>
  <div class="sg-city-banner"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><strong>{data.hero.banner}</strong><span class="sg-city-banner-sep">·</span><span class="sg-city-banner-sub">Ihre TCM.ch Klinik vor Ort</span></div>
  <div class="sg-inner">
    <div class="sg-text">
      <div class="sg-crumb"><button onclick="nav('home')">TCM.ch</button><span class="sg-sep">›</span><button onclick="nav('standorte')">Standorte</button><span class="sg-sep">›</span>{zh && <Fragment><a href="/akupunktur-tcm-zuerich/" style="color:inherit">Zürich</a><span class="sg-sep">›</span></Fragment>}<span>{data.stadt}</span></div>
      <span class="sg-eyebrow">{eyebrow}</span>
      <p class="sg-title" set:html={heroH1}></p>
      <p class="sg-sub" set:html={data.hero.lead}></p>
      <span class="sg-m-eyebrow">{eyebrow.toUpperCase()}</span>
      <h1 class="sg-m-title" set:html={heroH1}></h1>
      <p class="sg-mobile-sub" set:html={data.hero.lead}></p>
      <p class="sg-mobile-sub" set:html={data.hero.sub}></p>
      <div class="sg-mobile-hero-actions"><button class="sg-m-primary" onclick="openContactForm()" data-booking-sheet="clinic">{data.planned || data.review ? "Anfrage stellen" : "Termin anfragen"}</button><a class="sg-m-phone" href="/kontakt/" data-open-concern data-concern-location={data.stadt} data-concern-location-slug={data.slug}>Anliegen kostenlos schildern</a></div>
      <div class="sg-mobile-wa"><div class="sg-mobile-wa-head"><div class="sg-mobile-wa-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div><div class="sg-mobile-wa-text"><strong>Fragen zur Behandlung?</strong><span>Yuna hilft dir direkt per WhatsApp weiter.</span></div></div><a href={waTermin} class="sg-mobile-wa-cta" target="_blank" rel="noopener">Schreib uns einfach</a></div>
      <button class="sg-mobile-secondary" onclick="openContactForm()">Termin anfragen</button>
      <p class="sg-location">{data.hero.locationHook}</p>
      <p class="sg-sub" set:html={data.hero.sub}></p>
      <div class="sg-ctas"><button class="btn-primary" onclick="openContactForm()">Termin anfragen</button><a href={waTermin} class="btn-secondary" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:7px"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>Per WhatsApp</a></div>
      <div class="sg-trust"><span class="sg-trust-item"><span class="sg-trust-dot"></span>Anfrage per WhatsApp oder Telefon</span><span class="sg-trust-item"><span class="sg-trust-dot"></span>Zusatzversicherung anerkannt</span><span class="sg-trust-item"><span class="sg-trust-dot"></span>Persönliche Begleitung</span></div>
    </div>
    <div class="sg-media"><img src={data.hero.image} alt={data.hero.imageAlt ?? 'Symbolbild: Empfangsbereich einer TCM.ch Praxis'} loading="lazy" decoding="async"></div>
    <div class="sg-mobile-trust">Krankenkassen anerkannt <span class="sg-tsep">·</span> Zentral in {data.stadt} <span class="sg-tsep">·</span> Anfrage per WhatsApp oder Telefon</div>
  </div>
</div>
)}

<style is:global>
  /* Shared LSR location heroes: place header clearance OUTSIDE the media panel.
     The former 76px padding on .lsr-hero pushed the right video/photo down.
     The ID-qualified rule beats the legacy #sg-premium-hero sibling override. */
  #sg-premium-hero ~ .lsr-hero.std-location-hero{
    padding-top:0!important;
    margin-top:var(--header-h,76px);
  }
  /* With a Check-in banner, that banner (or its mobile spacer) already clears
     the fixed header; do not add the clearance a second time. */
  body:has(.sgb-banner) #sg-premium-hero ~ .lsr-hero.std-location-hero{
    padding-top:0!important;
    margin-top:0;
  }
  @media(max-width:900px){
    body:not(:has(.sgb-banner)) #sg-premium-hero ~ .lsr-hero.std-location-hero{
      margin-top:80px;
    }
  }

  /* The shared hero has its own 80px margin-top rule, independent of the
     page wrapper. Previous wrapper/inner-padding patches did not move its
     visible top edge below the fixed offer banner. Offset the hero itself. */
  @media(max-width:900px){
    html.tcm-nov-offer-active body #sg-premium-hero ~ .lsr-hero.std-location-hero{
      margin-top:calc(80px + 42px + 20px)!important;
    }
  }
  .std-location-hero .std-hero-mobile-address{display:none}
  /* Mobile first: homepage-like hierarchy on the shared operational location
     heroes only. Desktop, copy, schema, form routing and clinic status stay intact. */
  @media (max-width:767px){
    .std-location-hero .lsr-left{
      display:flex;flex-direction:column;
      padding:24px 20px 22px;
    }
    .std-location-hero .tsr-crumb{display:none!important}
    .std-location-hero .lsr-eyebrow{margin-bottom:12px}
    .std-location-hero .lsr-h1{margin-bottom:16px}
    .std-location-hero .std-hero-summary{
      margin-bottom:20px;line-height:1.55;
    }
    /* Supporting explanations remain in DOM / desktop and the clinic detail
       sections; pending/partner pages retain warnings and redirections. */
    .std-location-hero:not(.std-location-hero--pending):not(.std-location-hero--partner) .std-hero-detail{
      display:none!important;
    }
    .std-location-hero .lsr-ctas{order:4;margin:0 0 12px;gap:8px}
    .std-location-hero .lsr-ctas .lsr-btn-primary{
      width:100%;min-height:52px;justify-content:center;
    }
    .std-location-hero .std-hero-trust{order:5;margin:0 0 9px;font-size:13px;line-height:1.35}
    .std-location-hero:not(.std-location-hero--pending) .std-hero-trust > div:first-child,
    .std-location-hero:not(.std-location-hero--pending) .std-hero-trust > div:last-child{
      display:none!important;
    }
    .std-location-hero .lsr-ctas .lsr-btn-ghost{
      /* Keep WhatsApp functional and accessible, but stop presenting it
         as a second competing large pill. */
      min-height:44px;width:auto;margin:0 auto;
      padding:8px 14px;border:0!important;background:transparent!important;
      color:var(--tcm-ink,#171B1A)!important;
      box-shadow:none!important;text-decoration:underline;text-underline-offset:3px;
    }
    .std-location-hero .std-hero-note{order:6;margin:0;font-size:13px;line-height:1.4}
    .std-location-hero .std-hero-mobile-address{
      display:block;order:7;margin:3px 0 0;
      font-size:13px;line-height:1.4;color:var(--tcm-text-soft,#505453);
    }
    .std-location-hero:not(.std-location-hero--pending):not(.std-location-hero--partner) .std-hero-note{
      display:none!important;
    }
  }
</style>
