---
import type { Standort } from '../../data/standorte';
import { waHref } from '../../data/standorte';
const { data } = Astro.props as { data: Standort };
const eyebrow = `TCM.ch Klinik · ${data.stadt}`;
const waTermin = waHref(data.nap.telefon, `Hallo, ich möchte einen Termin in ${data.stadt} anfragen.`);
---
<div id="standort-flagship-hero" style="display:none"></div><div id="sg-premium-hero"></div><div id="zh-premium-hero"></div><div id="win-premium-hero"></div>
<div id="generic-premium-hero" class={`sg-active sg-city-${data.slug}`}>
  <div class="sg-city-banner"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><strong>{data.hero.banner}</strong><span class="sg-city-banner-sep">·</span><span class="sg-city-banner-sub">Ihre TCM.ch Klinik vor Ort</span></div>
  <div class="sg-inner">
    <div class="sg-text">
      <div class="sg-crumb"><button onclick="nav('home')">TCM.ch</button><span class="sg-sep">›</span><button onclick="nav('standorte')">Standorte</button><span class="sg-sep">›</span><span>{data.stadt}</span></div>
      <span class="sg-eyebrow">{eyebrow}</span>
      <h1 class="sg-title" set:html={data.hero.h1}></h1>
      <span class="sg-m-eyebrow">{eyebrow.toUpperCase()}</span>
      <h1 class="sg-m-title" set:html={data.hero.h1}></h1>
      <p class="sg-mobile-sub" set:html={data.hero.sub}></p>
      <button class="sg-m-primary" onclick="openContactForm()">Verfügbarkeit in {data.stadt} prüfen</button>
      <div class="sg-mobile-wa"><div class="sg-mobile-wa-head"><div class="sg-mobile-wa-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div><div class="sg-mobile-wa-text"><strong>Fragen zur Behandlung?</strong><span>Yuna hilft Ihnen direkt per WhatsApp weiter.</span></div></div><a href={waTermin} class="sg-mobile-wa-cta" target="_blank" rel="noopener">Per WhatsApp fragen</a></div>
      <button class="sg-mobile-secondary" onclick="openContactForm()">Termin anfragen</button>
      <p class="sg-location">{data.hero.locationHook}</p>
      <p class="sg-sub" set:html={data.hero.sub}></p>
      <div class="sg-ctas"><button class="btn-primary" onclick="openContactForm()">Termin anfragen</button><a href={waTermin} class="btn-secondary" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:7px"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>Per WhatsApp</a></div>
      <div class="sg-trust"><span class="sg-trust-item"><span class="sg-trust-dot"></span>Termine oft innert 24h</span><span class="sg-trust-item"><span class="sg-trust-dot"></span>Zusatzversicherung anerkannt</span><span class="sg-trust-item"><span class="sg-trust-dot"></span>Persönliche Begleitung</span></div>
    </div>
    <div class="sg-media"><img src={data.hero.image} alt="TCM.ch Behandlungsteam in der Klinik" loading="lazy" decoding="async"></div>
    <div class="sg-mobile-trust">Krankenkassen anerkannt <span class="sg-tsep">·</span> Zentral in {data.stadt} <span class="sg-tsep">·</span> Termine oft innert 24h</div>
  </div>
</div>
