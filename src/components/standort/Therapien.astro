---
import type { Standort } from '../../data/standorte';
import { therapyCards } from '../../data/therapy-cards';
const { data } = Astro.props as { data: Standort };
const cards = data.therapien.map((slug) => ({ slug, c: therapyCards[slug] })).filter((x) => x.c);
---
<section class="section svc-section"> <div class="wrap"> <div class="svc-header reveal"> <div> <div class="section-label">Unsere Therapien</div> <h2 class="section-title">Unsere <em>Therapien</em> in {data.stadt}</h2> </div> <p class="svc-sub">Über 10 medizinisch anerkannte TCM-Methoden für Vitalität, Prävention und langfristige Gesundheit. Krankenkassenzertifiziert, an 13 Standorten.</p> </div> <div class="svc-grid">
{cards.map(({ slug, c }) => (
  <div class="svc-card reveal" onclick={`nav('therapie','${slug}')`} role="button" tabindex="0"> <div class="svc-photo-wrap"> <img width={c.w} height={c.h} id={`svc-img-${slug}`} src={c.img} alt={c.name} class="svc-photo" loading="lazy" style={`object-position:${c.objectPos}`}> <div class="svc-photo-top-bar"></div> </div> <div class="svc-body"> <div class="svc-name">{c.name}</div> <div class="svc-tagline">{c.tagline}</div> <div class="svc-meta"> <span class="svc-badge svc-badge--time"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15.5 14"></polyline></svg>{c.time}</span> <span class="svc-badge svc-badge--ins">{c.ins}</span> </div> <div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </div> </div>
))}
</div> </div> </section>
