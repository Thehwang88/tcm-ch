---
import type { Standort } from '../../data/standorte';
import { therapyCards } from '../../data/therapy-cards';
const { data } = Astro.props as { data: Standort };
const all = data.therapien.map((slug) => ({ slug, c: therapyCards[slug] })).filter((x) => x.c);
// CRO-Layout: 4 Kern-Cards sichtbar, Rest server-gerendert hinter "Alle Therapien ansehen".
const cards = data.cro ? all.slice(0, 4) : all;
const extra = data.cro ? all.slice(4) : [];
const moreId = `more-therapien-${data.slug}`;
const sub = data.cro
  ? 'Medizinisch anerkannte TCM-Methoden, krankenkassenzertifiziert.'
  : 'Über 10 medizinisch anerkannte TCM-Methoden für Vitalität, Prävention und langfristige Gesundheit. Krankenkassenzertifiziert, an 14 Standorten.';
---
<section class="section svc-section"> <div class="wrap"> <div class="svc-header reveal"> <div> <div class="section-label">Unsere Therapien</div> <h2 class="section-title">Unsere <em>Therapien</em> in {data.stadt}</h2> </div> <p class="svc-sub">{sub}</p> </div> <div class="svc-grid">
{cards.map(({ slug, c }) => (
  <a href={`/therapien/${slug}/`} class="svc-card reveal" onclick={`event.preventDefault(); nav('therapie','${slug}')`}> <div class="svc-photo-wrap"> <img width={c.w} height={c.h} id={`svc-img-${slug}`} src={c.img} alt={c.name} class="svc-photo" loading="lazy" style={`object-position:${c.objectPos}`}> <div class="svc-photo-top-bar"></div> </div> <div class="svc-body"> <div class="svc-name">{c.name}</div> <div class="svc-tagline">{c.tagline}</div> <div class="svc-meta"> <span class="svc-badge svc-badge--time"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15.5 14"></polyline></svg>{c.time}</span> <span class="svc-badge svc-badge--ins">{c.ins}</span> </div> <div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </div> </a>
))}
</div>
{extra.length > 0 && (
  <Fragment>
    <div class="svc-grid" id={moreId} style="display:none;margin-top:18px">
    {extra.map(({ slug, c }) => (
      <a href={`/therapien/${slug}/`} class="svc-card reveal" onclick={`event.preventDefault(); nav('therapie','${slug}')`}> <div class="svc-photo-wrap"> <img width={c.w} height={c.h} id={`svc-img-${slug}`} src={c.img} alt={c.name} class="svc-photo" loading="lazy" style={`object-position:${c.objectPos}`}> <div class="svc-photo-top-bar"></div> </div> <div class="svc-body"> <div class="svc-name">{c.name}</div> <div class="svc-tagline">{c.tagline}</div> <div class="svc-meta"> <span class="svc-badge svc-badge--time"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15.5 14"></polyline></svg>{c.time}</span> <span class="svc-badge svc-badge--ins">{c.ins}</span> </div> <div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </div> </a>
    ))}
    </div>
    <div style="text-align:center;margin-top:22px"><button type="button" id={`${moreId}-btn`} aria-expanded="false" aria-controls={moreId} onclick={`var g=document.getElementById('${moreId}');var o=g.style.display!=='none';g.style.display=o?'none':'grid';this.setAttribute('aria-expanded',String(!o));this.firstElementChild.textContent=o?'Alle Therapien ansehen':'Weniger anzeigen'`} style="display:inline-flex;align-items:center;gap:10px;padding:14px 28px;background:#fff;border:1px solid #E5E7EB;border-radius:999px;font-family:var(--font-sans);font-size:14.5px;font-weight:600;color:#0d0d0d;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.04)"><span>Alle Therapien ansehen</span></button></div>
  </Fragment>
)}
{data.massageLink && (<p style="margin:22px 0 0;font-size:15px;line-height:1.6;color:var(--mid);max-width:72ch">{data.massageLink.text} <a href={data.massageLink.href} style="color:var(--blue);font-weight:700">{data.massageLink.anchor}</a>.</p>)} </div> </section>
