---
// Termin-Bereich der Standortseiten nach der St.-Galler Vorlage (HeroStandardSG, Sektion .sgt), ohne OneDoc (nur SG):
// links Praxisfoto, Adresse, Öffnungszeiten, Team, Google-Link; rechts Titel «Termin in <Stadt>», drei Kanalkarten
// (Formular / Anrufen / WhatsApp) und die gemeinsame Anfragekarte (#anfrage-box, Anker #termin-formular).
// Partner-Umleitung (Marktgasse): Umleitungskarte statt Formular, Primärkarte verlinkt auf die Partnerpraxis.
// Styles 1:1 aus HeroStandardSG (.sgt-*), damit SG und die übrigen Standorte identisch aussehen.
import type { Standort } from '../../data/standorte';
import { telHref, waHref } from '../../data/standorte';
import { clinics, mapsPlaceUrl } from '../../data/locations';
import { therapeuten } from '../../data/therapeuten';
import { clinicalLeadContext, clinicalLeadCopy, CLINICAL_LEAD_SLUG } from '../../data/clinical-lead';
import AnfrageKarte from './AnfrageKarte.astro';
const { data, sitekey, umleitungCard = '' } = Astro.props as { data: Standort; sitekey: string; umleitungCard?: string };
const clinic = clinics.find((c) => c.id === data.slug);
const PU = data.partnerUmleitung;
const tel = data.nap.telefon;
const wa = waHref(tel, `Hallo, ich habe eine Frage zur Behandlung in ${data.stadt}.`);
const place = clinic ? mapsPlaceUrl(clinic) : null;
const foto = !data.planned ? (clinic?.bild ?? data.praxisBilder?.[0]) : undefined;
const addr = data.nap.strasse ? `${data.nap.strasse}, ${data.nap.plz} ${data.nap.ort}` : data.nap.ort;
const hinweis = clinic?.hinweis?.split(' · ')[1];
const hours = data.nap.oeffnungszeiten;
// Team wie Team.astro: kanonische Zuordnung therapeuten[].standorte[] (Gate check-clinic-status 4i: Links /team/<slug>/ mit class tmc…).
const team = data.planned || data.review ? [] : therapeuten.filter((t) => t.standorte?.includes(data.slug));
const initialen = (n: string) => n.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
const rolle = (t: string) => t.split(' · ')[0];
// Klinische Leitung (netzwerkweit) als letzte Zeile der Teamliste, mit demselben Marker wie die ClinicalLead-Sektion (Gate 4h).
const leadCtx = clinicalLeadContext(data.slug);
const leadLokal = team.some((t) => t.slug === CLINICAL_LEAD_SLUG); // z. B. Frauenfeld: Leitung ist dort lokale Teamkarte → Marker auf dieser Zeile
const lead = leadCtx && !leadLokal ? clinicalLeadCopy('de', leadCtx) : undefined;
const ctaTitle = data.review ? 'Passende Praxis anfragen' : data.planned ? 'Anfrage stellen' : 'Termin anfragen';
---
<section class="sgt std-termin" aria-labelledby="sgt-h">
  <div class="sgt-wrap sgt-grid">
    <aside class="sgt-aside" aria-label={`Praxis ${data.stadt}`}>
      <div class="sgt-aside-top">
        {foto && <figure class="sgt-foto"><img src={foto.src} alt={foto.alt} width="1200" height="900" loading="lazy" decoding="async"></figure>}
        <p class="sgt-addr"><strong>{addr}</strong>{hinweis && <Fragment> · {hinweis}</Fragment>}</p>
        {hours.length > 0 && <dl class="sgt-hours">{hours.map((o) => <Fragment><dt>{o.tag}</dt><dd>{o.zeit}</dd></Fragment>)}</dl>}
      </div>
      <div class="sgt-aside-bottom">
        {(team.length > 0 || lead) && (
        <ul class="sgt-team" aria-label={`Team ${data.stadt}`}>
          {team.map((t) => <li id={t.slug === CLINICAL_LEAD_SLUG && leadCtx ? 'clinical-lead' : undefined} data-clinical-lead={t.slug === CLINICAL_LEAD_SLUG && leadCtx ? leadCtx.status : undefined}><a href={`/team/${t.slug}/`} class="tmc-mini">{t.bild ? <img src={t.bild} alt={t.name} width="72" height="72" loading="lazy" decoding="async"> : <span class="sgt-team-init" aria-hidden="true">{initialen(t.name)}</span>}<span><strong>{t.name}</strong><small>{rolle(t.titel)}</small></span></a></li>)}
          {lead && <li id="clinical-lead" data-clinical-lead={leadCtx!.status}><a href={lead.href}>{lead.img ? <img src={lead.img.src} alt={lead.img.alt} width="72" height="72" loading="lazy" decoding="async"> : <span class="sgt-team-init" aria-hidden="true">{initialen(lead.name)}</span>}<span><strong>{lead.name}</strong><small>{lead.role}</small></span></a></li>}
        </ul>
        )}
        {place && <p class="sgt-gbp"><a href={place} target="_blank" rel="noopener">Bewertungen auf Google ansehen <span aria-hidden="true">→</span></a></p>}
      </div>
    </aside>
    <div class="sgt-main">
      <div class="sgt-head">
        <h2 class="section-title" id="sgt-h">Termin in <em>{data.stadt}</em></h2>
        <p class="sgt-sub">Wir melden uns persönlich. EMR-/ASCA-anerkannt.{place && <Fragment> <a href={place} target="_blank" rel="noopener noreferrer" class="sgt-google">Bewertungen auf Google ansehen <span aria-hidden="true">→</span></a></Fragment>}</p>
      </div>
      <span id="termin" class="sgt-anchor" aria-hidden="true"></span>
      <div class="sgt-channels">
        {PU ? (
          <a class="sgt-ch sgt-ch--primary" href={PU.href} target="_blank" rel="noopener">
            <span class="sgt-ch-label">Am schnellsten</span>
            <span class="sgt-ch-title">{PU.cta}</span>
            <span class="sgt-ch-sub">{PU.hinweis}</span>
            <span class="sgt-ch-go">Termin buchen <span aria-hidden="true">→</span></span>
          </a>
        ) : (
          <a class="sgt-ch sgt-ch--primary" href="#anfrage-box">
            <span class="sgt-ch-label">Am schnellsten</span>
            <span class="sgt-ch-title">{ctaTitle}</span>
            <span class="sgt-ch-sub">{data.planned ? 'Wir melden uns, sobald Termine möglich sind.' : 'Kurz das Formular ausfüllen, wir melden uns persönlich mit einem Terminvorschlag.'}</span>
            <span class="sgt-ch-go">Zum Formular <span aria-hidden="true">→</span></span>
          </a>
        )}
        <a class="sgt-ch" href={telHref(tel)} data-kf-tel>
          <span class="sgt-ch-label">Anrufen</span>
          <span class="sgt-ch-title">{tel}</span>
          <span class="sgt-ch-sub">Wir finden gemeinsam den passenden Termin.</span>
          <span class="sgt-ch-go">Anrufen <span aria-hidden="true">→</span></span>
        </a>
        <a class="sgt-ch" href={wa} target="_blank" rel="noopener">
          <span class="sgt-ch-label">WhatsApp</span>
          <span class="sgt-ch-title">Kurz schreiben</span>
          <span class="sgt-ch-sub">Schildere dein Anliegen, wir antworten persönlich.</span>
          <span class="sgt-ch-go">WhatsApp öffnen <span aria-hidden="true">→</span></span>
        </a>
      </div>
      <span id="termin-formular" class="sgt-anchor" aria-hidden="true"></span>
      <div class="sgt-form" data-std-box-oben>{PU ? <Fragment set:html={umleitungCard} /> : <AnfrageKarte data={data} sitekey={sitekey} oben />}</div>
    </div>
  </div>
</section>
<style is:global>
  .sgt-anchor{display:block;height:0;scroll-margin-top:calc(var(--header-h,76px) + 12px)}
  .sgt{background:var(--surface,#F4F6F5);padding:clamp(28px,4vw,56px) 16px;font-family:var(--font-sans,'Figtree',system-ui,sans-serif)}
  .sgt-wrap{max-width:var(--max,1280px);margin:0 auto}
  .sgt-grid{display:flex;flex-direction:column;gap:20px}
  .sgt-aside{display:contents}
  /* Mobil/Tablet (06.11.2026): Adresse und Zeiten nicht vor dem Formular; «Über die Praxis» hat dieselben Angaben. Desktop: Seitenspalte.
     Inhaber 10.11.2026: das Praxisfoto mobil zeigen – oben im Termin-Bereich, 16:9 wie die Standortkarten; ohne Foto bleibt der Block aus. */
  @media (max-width:1023px){
    /* The clinic photo now appears below "Über die Praxis" on mobile.
       Preserve the aside, address and team ordering on desktop. */
    .std-termin .sgt-aside-top{display:none!important}
    .sgt-aside-top{order:1}
    .sgt-aside-top:not(:has(.sgt-foto)){display:none}
    .sgt-aside-top .sgt-addr,.sgt-aside-top .sgt-hours{display:none}
    .sgt-aside-top .sgt-foto{margin:0}
    .sgt-aside-top .sgt-foto img{aspect-ratio:16/9}
  }
  .sgt-main{order:2;min-width:0}
  .sgt-aside-bottom{order:3}
  .sgt-foto{margin:0 0 12px;border-radius:var(--r-card,16px);overflow:hidden;box-shadow:var(--sh-md)}
  .sgt-foto img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}
  .sgt-addr{margin:0 0 8px;font-size:15.5px;color:var(--mid)}
  .sgt-addr strong{color:var(--black)}
  .sgt-hours{margin:0;display:grid;grid-template-columns:auto 1fr;gap:2px 12px;font-size:14.5px;color:var(--mid)}
  .sgt-hours dt{font-weight:700;color:var(--black)}
  .sgt-hours dd{margin:0}
  .sgt-team{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-wrap:wrap;gap:12px 22px}
  .sgt-team li{display:flex;align-items:center;gap:10px}
  /* Use native therapist portraits (not small thumbnail assets).
     Desktop 72px; mobile 56px; actual quality still depends on source pixels. */
  .sgt-team img,.sgt-team-init{width:72px;height:72px;border-radius:50%;object-fit:cover;object-position:center 24%;flex-shrink:0}
  @media(max-width:767px){
    .sgt-team img,.sgt-team-init{width:56px;height:56px}
    .sgt-team{gap:12px 16px}
  }
  .sgt-team-init{display:inline-flex!important;align-items:center;justify-content:center;background:var(--brand-black,#020B10);color:var(--brand,#1AE288);font-weight:800;font-size:15px;letter-spacing:.02em;flex-direction:row!important}
  .sgt-team span{display:flex;flex-direction:column;line-height:1.25}
  .sgt-team strong{font-size:15px;color:var(--black)}
  .sgt-team small{font-size:12.5px;color:var(--mid)}
  @media (min-width:1024px){
    .sgt-grid{display:grid;grid-template-columns:minmax(0,380px) minmax(0,1fr);gap:clamp(32px,4vw,56px);align-items:start}
    .sgt-aside{display:block;position:sticky;top:calc(var(--header-h,76px) + 16px)}
    .sgt-aside-top{display:block}
    .sgt-aside-top{margin-bottom:18px}
    .sgt-main{max-width:820px}
  }
  .sgt-head{margin-bottom:22px}
  .sgt-head .section-title{margin:0 0 6px}
  .sgt-sub{margin:0;font-size:16px;color:var(--mid);line-height:1.5}
  .sgt-google{color:var(--blue);font-weight:700;text-decoration:none;white-space:nowrap}
  .sgt-google:hover{text-decoration:underline}
  .sgt-channels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:24px}
  .sgt-ch{display:flex;flex-direction:column;height:100%;border:1px solid var(--border);border-radius:var(--r-card,16px);padding:22px;text-decoration:none;background:#fff;transition:border-color .15s ease,box-shadow .15s ease,transform .15s ease}
  .sgt-ch:hover{border-color:var(--blue);box-shadow:var(--sh-card);transform:translateY(-2px)}
  .sgt-ch-label{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--blue)}
  .sgt-ch-title{font-size:19px;font-weight:800;color:var(--black);margin:6px 0 8px;line-height:1.2;letter-spacing:-.01em}
  .sgt-ch-sub{font-size:14.5px;line-height:1.5;color:var(--mid);flex:1}
  .sgt-ch-go{margin-top:16px;font-size:14px;font-weight:700;color:var(--blue)}
  .sgt-ch--primary{background:var(--brand-black,#020B10);border-color:var(--brand-black,#020B10)}
  .sgt-ch--primary .sgt-ch-label{color:#FFD84D}
  .sgt-ch--primary .sgt-ch-title{color:#fff}
  .sgt-ch--primary .sgt-ch-sub{color:rgba(255,255,255,.82)}
  .sgt-ch--primary .sgt-ch-go{color:#FFD84D}
  .sgt-ch--primary:hover{border-color:var(--brand,#1AE288)}
  .sgt-quotes{list-style:none;margin:0 0 10px;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:10px}
  .sgt-quotes li{background:#fff;border:1px solid var(--border);border-radius:var(--r-card,16px);padding:14px 16px;font-size:14.5px;line-height:1.5;color:var(--black)}
  .sgt-gbp{margin:0;font-size:14.5px}
  .sgt-gbp a{color:var(--black);font-weight:700;text-decoration:none}
  .sgt-gbp a:hover{text-decoration:underline}
  .sgt-quotes q{quotes:'«' '»'}
  .sgt-q-name{display:block;margin-top:8px;font-size:13.5px;font-weight:700;color:var(--mid)}
  .sgt-form .kf{width:100%;max-width:560px;margin:0 auto}
  /* Generische Trust-Zeile aus home.js (form-trust-checklist) nicht über dem SG-Formular: dupliziert die Karten. */
  .sgt-form .form-trust-checklist{display:none}
  /* Gelbe Terminart-Auswahl: seit 06.11.2026 gemeinsam in kontakt-form.css (.kf--gelb). */
  @media (max-width:760px){.sgt-channels{grid-template-columns:minmax(0,1fr);gap:10px}.sgt-ch{padding:16px 18px}.sgt-ch-title{font-size:17px}}
  .sgt-team a{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit}
  .sgt-team a:hover strong{text-decoration:underline}
</style>
