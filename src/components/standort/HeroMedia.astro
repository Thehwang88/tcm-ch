---
// Rechte Hero-Hälfte als Video (gemeinsames hwang.ch-Footage, src/data/hero-video.ts) statt Foto. Geometrie bleibt die
// der .lsr-right-Fotohälfte (home.css), d. h. keine Höhen-/Layoutänderung. Poster = Standbild des ersten Video-Frames
// (HERO_VIDEO_POSTER): dasselbe Bild als Fallback-<img> (LCP-Element, eager) und als <video poster>, damit zwischen Poster
// und erstem bewegten Frame kein Bildwechsel sichtbar ist (bisher: Standortfoto → Video = sichtbarer «Flash»). Das
// Standortfoto bleibt in «Über die Praxis». Kein autoplay-Attribut + preload="none" im initialen HTML.
// Das Script lädt die Video-Daten nur bei Annäherung an den Viewport, ohne auf window.load zu warten; die Wiedergabe
// startet bei Sichtbarkeit bzw. erstem Scroll. Mobile ≤900px bekommt die 640er-Rendition.
// Fallback (Autoplay-Block, Save-Data, prefers-reduced-motion): Poster bleibt stehen. Keine Caption: das Footage stammt
// nicht aus dem jeweiligen Standort. Bild und Video teilen Fokus (--hv-pos/--hv-pos-m), damit der Übergang deckungsgleich ist.
import { HERO_VIDEO_BASE, HERO_VIDEO_POSTER } from '../../data/hero-video';
const { posterSizes = '(max-width:900px) 100vw, 50vw', objectPositionDesktop = 'center 50%', objectPositionMobile = 'center 40%', id = 'std-hero-media' } = Astro.props as {
  posterSizes?: string; objectPositionDesktop?: string; objectPositionMobile?: string; id?: string;
};
const V = HERO_VIDEO_BASE; const P = HERO_VIDEO_POSTER;
---
<figure class="lsr-right lsr-right--video" id={id} data-hero-video style={`--hv-pos:${objectPositionDesktop};--hv-pos-m:${objectPositionMobile}`}>
  <img src={P.src} srcset={P.srcset} sizes={posterSizes} alt={P.alt} width={P.width} height={P.height} loading="eager" fetchpriority="high" decoding="async" data-hero-poster>
  <video muted playsinline loop preload="none" poster={P.src} aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback width="1280" height="720">
    <source src={`${V}-640.webm`} type="video/webm" media="(max-width:900px)">
    <source src={`${V}-640.mp4`} type="video/mp4" media="(max-width:900px)">
    <source src={`${V}-1280.webm`} type="video/webm">
    <source src={`${V}-1280.mp4`} type="video/mp4">
  </video>
</figure>
<script is:inline>(function(){
var f=document.querySelector('[data-hero-video]'),v=f&&f.querySelector('video');if(!v)return;
var c=navigator.connection;
if((window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)||(c&&c.saveData))return;
/* Preserve the first-frame poster as the LCP image. Warm video when the hero is
   near the viewport, rather than waiting for every page asset and font to load. */
var warmed=false,armed=false,inView=false;
function warm(){if(warmed)return;warmed=true;v.preload='auto';v.load();}
function play(){warm();var p=v.play();if(p&&p.catch)p.catch(function(){});}
function tick(){if(armed&&inView){if(v.paused)play();}else if(!v.paused)v.pause();}
v.addEventListener('playing',function(){f.classList.add('is-playing');},{once:true});
addEventListener('scroll',function(){armed=true;tick();},{once:true,passive:true});
if('IntersectionObserver' in window){
  new IntersectionObserver(function(es){if(es[es.length-1].isIntersecting)warm();},
    {rootMargin:'180px 0px',threshold:0}).observe(f);
  new IntersectionObserver(function(es){
    var e=es[es.length-1];inView=e.isIntersecting;
    if(e.intersectionRatio>=.9)armed=true;
    tick();
  },{threshold:[0,.25,.5,.9,1]}).observe(f);
}else{inView=true;armed=true;warm();tick();}
})();</script>
