---
// «Praxen in der Nähe» (05.11.2026): max. 3 buchbare Standorte (live/partner) nach Luftlinie (locations.ts geo), nie 2027/Einzugsgebiet.
// Rendering über die zentrale Standortkarte (src/lib/standort-card.ts), Variante kompakt, ohne Foto. Keine nearby[]-Listen mehr.
import type { Standort } from '../../data/standorte';
import { nearbyClinics, standortGridHtml } from '../../lib/standort-card';
const { data } = Astro.props as { data: Standort };
const items = nearbyClinics(data.slug, 3);
const grid = items.length ? standortGridHtml(items, { variant: 'kompakt', cols: 3 }) : '';
---
{grid && (
<section class="related-section"><div class="wrap"><div class="section-label">Weitere Standorte</div><h2 class="section-title">Praxen <em>in der Nähe</em></h2><div class="reveal"><Fragment set:html={grid} /></div></div></section>
)}
