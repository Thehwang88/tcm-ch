---
// Anfragekarte einer Standortseite (EIN Renderer je Status): operative Standorte = gemeinsames Kontaktformular
// (src/lib/kontakt-form.ts); geplante / in Prüfung stehende Standorte = status-geführte Vormerk-/Anfrage-Hülle
// (keine Behandlungs- oder Check-in-Zusage für nicht offene Praxen). Verwendet unten (KontaktForm, #kontakt,
// unveränderte IDs) und oben in der SG-Vorlage (KontaktPraxis, Box #anfrage-box, eigene Instanz bzw. ID-Präfix).
import type { Standort } from '../../data/standorte';
import { waHref } from '../../data/standorte';
import { expandStandort, PLANNED_PRESELECT } from '../../data/standort-optionen';
import { renderKontaktForm } from '../../lib/kontakt-form';
const { data, sitekey, oben = false } = Astro.props as { data: Standort; sitekey: string; oben?: boolean };
const wa = waHref(data.nap.telefon);
// Standort <select>: preselect the option matching this location (prefix match, so
// "Winterthur Marktgasse" -> "Winterthur"), mirroring prefillStandort().
const options = ['Zürich Oerlikon', 'Zürich Höngg', 'Winterthur', 'Volketswil', 'Frauenfeld', 'Kreuzlingen', 'St. Gallen', 'Wil', 'Rorschach', 'Basel', 'Andere / in meiner Nähe'].flatMap(expandStandort);
// Geplante Standorte wählen ihre Vormerk-Option vor (src/data/standort-optionen.ts).
const planned = PLANNED_PRESELECT[data.slug];
let selIdx = planned ? options.findIndex((o) => o.value === planned) : -1;
options.forEach((o, i) => { if (selIdx < 0 && (data.stadt === o.value || data.stadt.startsWith(o.value))) selIdx = i; });
// Obere Box wie der SG-Hero: kompakte Karte, Rückrufbereich offen, Wunschzeit unter «Weitere Angaben · optional».
// Kein OneDoc, kein Check-in (beides nur mit Freigabe in src/data/kontakt-angebote.mjs); Quelle bleibt der Seitenpfad.
const kfCard = !data.planned && !data.review
  ? renderKontaktForm(oben
    ? { instance: 'standort-oben', standortId: data.slug, cardId: 'anfrage-box', quelleDetail: 'Anfragebox oben', wunschzeit: true, headingTag: 'h2', heroKompakt: true, rueckrufOffen: true, sitekey, waHref: wa }
    : { instance: 'standort', standortId: data.slug, sitekey, waHref: wa })
  : '';
const idp = oben ? 'kto-' : 'kt-';
const cardId = oben ? 'anfrage-box' : undefined;
const H = oben ? 'h2' : 'h3';
---
{kfCard ? <Fragment set:html={kfCard} /> : (<div class="inline-form-card kf kf--ruhig kf-huelle" id={cardId} data-kf-huelle={data.review ? 'pruefung' : 'vorbereitung'}><link rel="stylesheet" href="/kontakt-form.css" /><div class="kf-kopf"><H class="kf-h">{data.review ? 'Passende Praxis anfragen' : data.planned ? `Anfrage für ${data.stadt}` : 'Termin anfragen'}</H><p class="kf-kopf-sub">{data.review ? 'Wir schlagen dir eine passende Praxis in der Nähe vor.' : data.planned ? 'Anfrage für den geplanten Start – wir melden uns bei dir.' : 'Wir melden uns mit einem Terminvorschlag.'}</p></div><form class="inline-form" data-contact-form novalidate=""><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"><div class="form-group"><label class="form-label" for={`${idp}name`}>Name <span class="kf-star" aria-hidden="true">*</span></label><input class="form-input" id={`${idp}name`} name="name" type="text" autocomplete="name" required=""></div><div class="form-row-2"><div class="form-group"><label class="form-label" for={`${idp}tel`}>Telefon <span class="kf-star" aria-hidden="true">*</span></label><input class="form-input" id={`${idp}tel`} name="telefon" type="tel" autocomplete="tel" required=""></div><div class="form-group"><label class="form-label" for={`${idp}email`}>E-Mail <span class="termin-opt">(für die Bestätigung)</span> <span class="kf-star" aria-hidden="true">*</span></label><input class="form-input" id={`${idp}email`} name="email" type="email" autocomplete="email" required=""></div></div><div class="form-group"><label class="form-label" for={`${idp}standort`}>Standort</label><select class="form-select" id={`${idp}standort`} name="standort"><option value="">Standort auswählen</option>{options.map((o, i) => (i === selIdx ? <option value={o.value} selected>{o.label}</option> : <option value={o.value}>{o.label}</option>))}</select></div><div class="form-group"><label class="form-label" for={`${idp}anliegen`}>Behandlung / Anliegen <span class="termin-opt">(optional)</span></label><textarea class="form-textarea" id={`${idp}anliegen`} name="behandlung" rows="2" placeholder="Was liegt an? (musst du nicht genau wissen)"></textarea></div><div class="form-group cf-turnstile-wrap"><div class="cf-turnstile" data-sitekey={sitekey} data-ts-mounted="1"></div></div><button type="submit" class="btn-primary form-submit" style="width:100%;justify-content:center">Anfrage senden <span aria-hidden="true">→</span></button><p class="termin-under-btn">Wir melden uns bei dir. Du musst nichts weiter tun.</p><p class="kf-od-sep"><span>Oder direkt Kontakt aufnehmen</span></p><p class="kf-alt"><a href={wa} class="form-wa-alt-new" target="_blank" rel="noopener"><svg width="17" height="17" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg><span>WhatsApp</span></a></p></form><script is:inline>(function(c){var e=c&&c.querySelector('.cf-turnstile');if(e&&e.clientWidth&&e.clientWidth<300)e.setAttribute('data-size','compact')})(document.currentScript.parentNode)</script></div>)}
