---
import type { Standort } from '../../data/standorte';
import { telHref, waHref } from '../../data/standorte';
import { expandStandort, PLANNED_PRESELECT } from '../../data/standort-optionen';
import { renderKontaktForm } from '../../lib/kontakt-form';
const { data, sitekey } = Astro.props as { data: Standort; sitekey: string };
const wa = waHref(data.nap.telefon);
const tel = telHref(data.nap.telefon);
// Standort <select>: preselect the option matching this location (prefix match, so
// "Winterthur Marktgasse" -> "Winterthur"), mirroring prefillStandort().
const options = ['Zürich Oerlikon', 'Zürich Höngg', 'Winterthur', 'Volketswil', 'Frauenfeld', 'Kreuzlingen', 'St. Gallen', 'Wil', 'Rorschach', 'Basel', 'Andere / in meiner Nähe'].flatMap(expandStandort);
// Geplante Standorte wählen ihre Vormerk-Option vor (src/data/standort-optionen.ts).
const planned = PLANNED_PRESELECT[data.slug];
let selIdx = planned ? options.findIndex((o) => o.value === planned) : -1;
options.forEach((o, i) => { if (selIdx < 0 && (data.stadt === o.value || data.stadt.startsWith(o.value))) selIdx = i; });
// CRO-L3.2: konsolidierte Form-Trust-Zeile nur für operative v2-Standorte (geplante
// behalten die bestehende Statusführung; keine Verfügbarkeits-/Scarcity-Claims).
const trustV2 = Boolean(data.v2 && !data.planned);
// Gemeinsames Kontaktformular (15.10.2026) für operative Standorte; geplante/in Prüfung stehende Standorte behalten
// ihre status-geführte Vormerk-Anfrage (keine Behandlungs- oder Check-in-Zusage für nicht offene Praxen).
const kfCard = !data.planned && !data.review ? renderKontaktForm({ instance: 'standort', standortId: data.slug, sitekey, waHref: wa }) : '';
---
<section id="kontakt" class="section contact-section-inline" data-planned={data.planned ? '1' : undefined} style="scroll-margin-top:68px;background:var(--surface)"> <div class="wrap"> <div class="contact-inline-grid"> <div class="reveal"> <div class="section-label">Passende Hilfe finden</div> <h2 class="section-title">Termin in <em>{data.stadt}</em> anfragen.</h2> {data.review ? <p class="section-sub" style="margin-bottom:0">Der Betrieb an diesem Standort ist noch nicht bestätigt. Schick uns deine Anfrage, wir schlagen dir eine passende Praxis in der Nähe vor.</p> : data.planned ? <p class="section-sub" style="margin-bottom:0">Der Standort ist in Vorbereitung. Deine Nachricht gilt als Anfrage für den geplanten Start – wir melden uns, sobald Termine in {data.stadt} möglich sind.</p> : <p class="section-sub" style="margin-bottom:0">Sag uns kurz Wunschtage und Tageszeit, wir melden uns mit einem Terminvorschlag.</p>} {!trustV2 && <div class="intake-trust-row"> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Passende Praxis statt langem Suchen</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Standorte in der Deutschschweiz</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Krankenkassenanerkannt (Zusatzversicherung)</div> </div>} <div class="contact-methods-mini" style="gap:8px"> <a href={wa} class="contact-method-mini" target="_blank"> <div class="cm-icon-mini cm-wa"><svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg></div> <div><strong>WhatsApp, sofort starten</strong><span>Persönliche Antwort vom Team</span></div> </a> <a href={tel} class="contact-method-mini phone-quiet"> <div class="cm-icon-mini cm-phone"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.42 2 2 0 0 1 3.6 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.01z"></path></svg></div> <div><strong>Terminkoordination TCM.ch (Mo–Fr)</strong><span>{data.nap.telefon}</span></div> </a> <a href={`mailto:${data.nap.email}`} class="contact-method-mini"> <div class="cm-icon-mini cm-mail"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg></div> <div><strong>E-Mail</strong><span>{data.nap.email}</span></div> </a> </div> </div> <div class="reveal"> {trustV2 && <div class="form-trust-checklist"><span class="ftc-item"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Krankenkassenanerkannt (Zusatzversicherung)</span><span class="ftc-item"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Passende Praxis statt langem Suchen</span><span class="ftc-item"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Persönliche Begleitung</span></div>}{kfCard ? <Fragment set:html={kfCard} /> : (<div class="inline-form-card kf kf--ruhig kf-huelle" data-kf-huelle={data.review ? 'pruefung' : 'vorbereitung'}><link rel="stylesheet" href="/kontakt-form.css" /><div class="kf-kopf"><h3 class="kf-h">{data.review ? 'Passende Praxis anfragen' : data.planned ? `Anfrage für ${data.stadt}` : 'Termin anfragen'}</h3><p class="kf-kopf-sub">{data.review ? 'Wir schlagen dir eine passende Praxis in der Nähe vor.' : data.planned ? 'Anfrage für den geplanten Start – wir melden uns bei dir.' : 'Wir melden uns mit einem Terminvorschlag.'}</p></div><form class="inline-form" data-contact-form novalidate=""><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"><div class="form-group"><label class="form-label" for="kt-name">Name <span class="kf-star" aria-hidden="true">*</span></label><input class="form-input" id="kt-name" name="name" type="text" autocomplete="name" required=""></div><div class="form-row-2"><div class="form-group"><label class="form-label" for="kt-tel">Telefon <span class="kf-star" aria-hidden="true">*</span></label><input class="form-input" id="kt-tel" name="telefon" type="tel" autocomplete="tel" required=""></div><div class="form-group"><label class="form-label" for="kt-email">E-Mail <span class="termin-opt">(für die Bestätigung)</span> <span class="kf-star" aria-hidden="true">*</span></label><input class="form-input" id="kt-email" name="email" type="email" autocomplete="email" required=""></div></div><div class="form-group"><label class="form-label" for="kt-standort">Standort</label><select class="form-select" id="kt-standort" name="standort"><option value="">Standort auswählen</option>{options.map((o, i) => (i === selIdx ? <option value={o.value} selected>{o.label}</option> : <option value={o.value}>{o.label}</option>))}</select></div><div class="form-group"><label class="form-label" for="kt-anliegen">Behandlung / Anliegen <span class="termin-opt">(optional)</span></label><textarea class="form-textarea" id="kt-anliegen" name="behandlung" rows="2" placeholder="Was liegt an? (musst du nicht genau wissen)"></textarea></div><div class="form-group cf-turnstile-wrap"><div class="cf-turnstile" data-sitekey={sitekey} data-ts-mounted="1"></div></div><button type="submit" class="btn-primary form-submit" style="width:100%;justify-content:center">Anfrage senden <span aria-hidden="true">→</span></button><p class="termin-under-btn">Wir melden uns bei dir. Du musst nichts weiter tun.</p><p class="kf-od-sep"><span>Oder direkt Kontakt aufnehmen</span></p><p class="kf-alt"><a href={wa} class="form-wa-alt-new" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366" style="display:inline-block;vertical-align:middle;margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"></path></svg><span>WhatsApp</span></a></p></form><script is:inline>(function(c){var e=c&&c.querySelector('.cf-turnstile');if(e&&e.clientWidth&&e.clientWidth<300)e.setAttribute('data-size','compact')})(document.currentScript.parentNode)</script></div>)} </div> </div> </div> </section>
