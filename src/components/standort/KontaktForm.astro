---
import type { Standort } from '../../data/standorte';
import { telHref, waHref } from '../../data/standorte';
import AnfrageKarte from './AnfrageKarte.astro';
// SG-Vorlage: eine zentrierte Spalte wie «Termin in St. Gallen anfragen», Kontaktwege als kompakte Textzeile statt
// Kachelliste. Karte (IDs, Instanz, Quelle) unverändert aus AnfrageKarte.astro.
const { data, sitekey } = Astro.props as { data: Standort; sitekey: string };
const wa = waHref(data.nap.telefon);
const tel = telHref(data.nap.telefon);
// CRO-L3.2: konsolidierte Form-Trust-Zeile nur für operative v2-Standorte (geplante
// behalten die bestehende Statusführung; keine Verfügbarkeits-/Scarcity-Claims).
const trustV2 = Boolean(data.v2 && !data.planned);
const CHK = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
const sub = data.review ? 'Der Betrieb an diesem Standort ist noch nicht bestätigt. Schick uns deine Anfrage, wir schlagen dir eine passende Praxis in der Nähe vor.'
  : data.planned ? `Der Standort ist in Vorbereitung. Deine Nachricht gilt als Anfrage für den geplanten Start – wir melden uns, sobald Termine in ${data.stadt} möglich sind.`
  : 'Sag uns kurz Wunschtage und Tageszeit, wir melden uns mit einem Terminvorschlag.';
---
<section id="kontakt" class="section contact-section-inline std-kontakt" data-planned={data.planned ? '1' : undefined} style="scroll-margin-top:68px;background:var(--surface)"><div class="wrap"><div class="reveal std-kontakt-col"><div class="section-label">Passende Hilfe finden</div><h2 class="section-title std-kontakt-h">Termin in <em>{data.stadt}</em> anfragen.</h2><p class="section-sub std-kontakt-sub">{sub}</p>{trustV2 && <div class="form-trust-checklist"><span class="ftc-item"><Fragment set:html={CHK} />Krankenkassenanerkannt (Zusatzversicherung)</span><span class="ftc-item"><Fragment set:html={CHK} />Passende Praxis statt langem Suchen</span><span class="ftc-item"><Fragment set:html={CHK} />Persönliche Begleitung</span></div>}<AnfrageKarte data={data} sitekey={sitekey} /><p class="std-kontakt-alt">Oder direkt über die Terminkoordination TCM.ch (Mo–Fr): <a href={tel}>Anrufen</a> · <a href={wa} target="_blank" rel="noopener">WhatsApp</a> · <a href={`mailto:${data.nap.email}`}>E-Mail</a></p></div></div></section>
