---
/**
 * Reusable editorial brand signature. Replace imageSrc with approved team
 * photography after the Zürich shoot; keep the copy/layout consistent.
 */
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
  reverse?: boolean;
}
const {
  imageSrc,
  imageAlt = 'Das TCM.ch Team',
  eyebrow = 'DAS IST TCM.CH',
  heading = 'Mehr als eine Praxis.',
  description = 'Menschen, die moderne TCM gemeinsam gestalten.',
  ctaHref = '/ueber-uns/',
  ctaLabel = 'TCM.ch kennenlernen',
  reverse = false,
} = Astro.props;
---
<section class:list={['brand-signature', { 'brand-signature--reverse': reverse }]} aria-labelledby="brand-signature-title">
  <div class="brand-signature__media">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    ) : (
      <div class="brand-signature__placeholder">
        <img src="/images/logo/tcm-ch-logo-kliniken-black.svg" alt="TCM.ch Kliniken" width="846" height="289" loading="lazy" decoding="async" />
      </div>
    )}
  </div>
  <div class="brand-signature__content">
    <div class="brand-signature__inner">
      <span class="brand-signature__eyebrow">{eyebrow}</span>
      <h2 id="brand-signature-title">{heading}</h2>
      <p>{description}</p>
      <a href={ctaHref} class="brand-signature__link">{ctaLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
  .brand-signature{display:grid;grid-template-columns:1fr 1fr;width:100%;min-height:clamp(480px,40vw,620px);background:#14532d;color:#fff;overflow:hidden}
  .brand-signature--reverse .brand-signature__media{order:2}
  .brand-signature__media{position:relative;overflow:hidden;background:#1ae288}
  .brand-signature__media > img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}
  .brand-signature__placeholder{position:absolute;inset:0;display:flex;align-items:flex-end;padding:clamp(32px,4.5vw,72px)}
  .brand-signature__placeholder img{display:block;width:clamp(132px,13vw,200px);height:auto}
  .brand-signature__content{display:flex;align-items:center;padding:clamp(48px,6vw,104px)}
  .brand-signature__inner{max-width:560px}
  .brand-signature__eyebrow{display:block;font-size:12px;font-weight:700;letter-spacing:.2em;color:#1ae288;margin-bottom:clamp(20px,2.2vw,32px)}
  .brand-signature h2{font-family:Figtree,Arial,sans-serif;font-size:clamp(44px,5.4vw,84px);font-weight:800;letter-spacing:-.045em;line-height:.98;margin:0 0 clamp(20px,2vw,28px);color:#fff}
  .brand-signature p{font-size:clamp(17px,1.45vw,21px);line-height:1.55;max-width:24ch;color:rgba(255,255,255,.86);margin:0 0 clamp(32px,3.2vw,48px)}
  .brand-signature__link{display:inline-flex;gap:14px;align-items:center;border-bottom:2px solid #1ae288;padding-bottom:8px;text-decoration:none;color:#fff;font-size:16px;font-weight:700}
  .brand-signature__link:hover{color:#1ae288}
  .brand-signature__link:focus-visible{color:#1ae288;outline:2px solid #1ae288;outline-offset:6px}
  @media(max-width:760px){.brand-signature{grid-template-columns:1fr;min-height:0}.brand-signature__media{aspect-ratio:4/3}.brand-signature--reverse .brand-signature__media{order:0}.brand-signature__content{padding:48px 24px 56px}.brand-signature h2{font-size:clamp(42px,12vw,56px)}}
</style>
