---
// Home hero — green app-style variant. Deep-green gradient, white text (kept ≥AA:
// gradient stays dark enough that flat #2D9B6F body-text failure doesn't apply).
// Reuses existing behaviour: primary -> openContactForm() (scroll to #kontakt form,
// defined in /home.js); secondary -> shared wa.me link from site config.
import { site } from '../data/site';
const WA = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich möchte gerne einen Termin anfragen.')}`;
---
<section class="gh-hero">
  <div class="gh-wrap">
    <div class="gh-inner">
      <div class="gh-eyebrow">Medizinische TCM · Schweizweit</div>
      <h1 class="gh-title">Endlich wieder gesund werden.<br><span class="gh-thin">An der Ursache.</span></h1>
      <p class="gh-lead">Du hast vieles probiert, geholfen hat wenig. Wir setzen an der Ursache an – natürlich und ärztlich begleitet.</p>

      <div class="gh-chips">
        <span class="gh-chip"><span class="gh-dot"></span>13 Standorte</span>
        <span class="gh-chip"><span class="gh-dot"></span>Antwort in ~1h</span>
        <span class="gh-chip"><span class="gh-dot"></span>Zusatzversicherung</span>
      </div>

      <a class="gh-promo" href="/standorte/st-gallen/">
        <span class="gh-promo-tag">Neu</span>
        <span class="gh-promo-txt">St.&nbsp;Gallen eröffnet 9.&nbsp;Juli · kostenloses Erstgespräch</span>
        <span class="gh-promo-arrow" aria-hidden="true">→</span>
      </a>

      <div class="gh-ctas">
        <button type="button" class="gh-btn gh-btn--primary" onclick="openContactForm()">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Kostenlos anfragen
        </button>
        <a class="gh-btn gh-btn--secondary" href={WA} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
          WhatsApp · meist in Minuten
        </a>
      </div>
      <div class="gh-subline"><span class="gh-star">★</span> 4.9 Google · kostenloses Erstgespräch, unverbindlich</div>
    </div>

    <div class="gh-proof">
      <div class="gh-proof-item"><div class="gh-proof-n">13</div><div class="gh-proof-l">Standorte<br>schweizweit</div></div>
      <div class="gh-proof-item"><div class="gh-proof-n">12'500+</div><div class="gh-proof-l">Patienten<br>behandelt</div></div>
      <div class="gh-proof-item"><div class="gh-proof-n">~1h</div><div class="gh-proof-l">Ø Antwort<br>auf Anfrage</div></div>
    </div>
  </div>
</section>

<style>
  .gh-hero {
    position: relative; overflow: hidden;
    background: linear-gradient(158deg, #17714B 0%, #0F5233 56%, #0A3A24 100%);
    color: #fff; font-family: var(--font-sans);
  }
  /* decorative glow orb, top-right, over non-text area */
  .gh-hero::after {
    content: ""; position: absolute; right: -140px; top: -120px; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(255, 255, 255, .14), transparent 70%);
    pointer-events: none;
  }
  .gh-wrap { position: relative; z-index: 1; max-width: var(--max); margin: 0 auto; padding: 0 var(--pad-x); }
  .gh-inner { max-width: 760px; padding: 72px 0 0; }

  .gh-eyebrow {
    font-size: 12.5px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    color: rgba(255, 255, 255, .9); margin-bottom: 20px;
  }
  .gh-title {
    font-size: clamp(34px, 5vw, 60px); line-height: 1.05; font-weight: 800;
    letter-spacing: var(--tracking-hero); margin: 0 0 18px;
  }
  .gh-title .gh-thin { font-weight: 500; color: rgba(255, 255, 255, .9); }
  .gh-lead {
    font-size: clamp(16px, 1.5vw, 19px); line-height: 1.55; color: rgba(255, 255, 255, .92);
    max-width: 48ch; margin: 0 0 26px;
  }

  .gh-chips { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 30px; }
  .gh-chip {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .25);
    padding: 8px 14px; border-radius: var(--r-pill); font-size: 13px; font-weight: 600;
  }
  .gh-dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; opacity: .9; }

  /* St. Gallen opening promo — slim on-brand pill above the CTAs. */
  .gh-promo {
    display: inline-flex; align-items: center; gap: 9px;
    background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .22);
    padding: 6px 12px 6px 7px; border-radius: var(--r-btn);
    font-size: 13px; font-weight: 600; color: #fff; text-decoration: none;
    margin-bottom: 22px; transition: background var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .gh-promo:hover { background: rgba(255, 255, 255, .16); border-color: rgba(255, 255, 255, .35); }
  .gh-promo-tag {
    flex-shrink: 0; background: #FFC93C; color: #0A3A24;
    font-size: 10.5px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase;
    padding: 2px 8px; border-radius: var(--r-pill);
  }
  .gh-promo-txt { color: rgba(255, 255, 255, .92); }
  .gh-promo-arrow { color: rgba(255, 255, 255, .7); font-weight: 700; }

  .gh-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .gh-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    min-height: 54px; padding: 0 26px; border-radius: var(--r-btn);
    font-family: var(--font-sans); font-size: 16px; font-weight: 800; text-decoration: none;
    cursor: pointer; transition: transform var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out);
  }
  .gh-btn svg { flex-shrink: 0; }
  .gh-btn--primary { background: #fff; color: #0F5233; border: none; box-shadow: 0 8px 24px rgba(0, 0, 0, .18); }
  .gh-btn--primary:hover { transform: translateY(-1px); box-shadow: 0 12px 30px rgba(0, 0, 0, .24); }
  .gh-btn--secondary { background: transparent; color: #fff; border: 1.5px solid rgba(255, 255, 255, .55); font-weight: 700; }
  .gh-btn--secondary:hover { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .8); }
  .gh-subline { font-size: 12.5px; color: rgba(255, 255, 255, .82); margin-top: 16px; }
  .gh-star { color: #FFC93C; }

  .gh-proof {
    margin-top: 52px; display: flex; gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, .16); padding: 26px 0 40px;
  }
  .gh-proof-item { flex: 1; }
  .gh-proof-n { font-size: clamp(26px, 3vw, 34px); font-weight: 800; letter-spacing: -.02em; }
  .gh-proof-l { font-size: 13px; line-height: 1.35; color: rgba(255, 255, 255, .8); margin-top: 4px; }

  @media (max-width: 768px) {
    .gh-inner { padding-top: 36px; }
    .gh-title { font-size: clamp(32px, 8.5vw, 44px); }
    .gh-lead { max-width: 36ch; }
    .gh-ctas { flex-direction: column; align-items: stretch; }
    .gh-btn { width: 100%; }
    .gh-promo { font-size: 12px; }
    .gh-proof { margin-top: 34px; gap: 10px; padding-bottom: 32px; }
    .gh-proof-l { font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) { .gh-btn { transition: none; } }
</style>
