    var mobileFloat = document.querySelector('[data-f30-float="mobile"]');
    var cardEl = document.getElementById('offer-form'), kEl = document.getElementById('kontakt');
    var dismissed = false; try { dismissed = sessionStorage.getItem('f30-float-dismissed') === '1'; } catch (_) {}
