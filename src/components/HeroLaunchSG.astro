---
// Launch hero for the St. Gallen standort page only. Uses existing brand tokens
// (green = --blue, green-deep = --blue-dark, ink = --charcoal, gold = #FFC107 as
// already used on this page's cta-band). Renders via SpaPage's <slot/>, above the
// (hero-stripped) standort body. The mini-form posts DIRECTLY to /api/anfrage with
// quelle=launch-hero-sg (worker allows no-email for that source) via a managed,
// interaction-only Turnstile widget, then shows an inline success/error state.
const { sitekey } = Astro.props;
---
<section class="hlsg">
  <div class="hlsg-inner">
    <div class="hlsg-copy">
      <span class="hlsg-badge">Jetzt offen · St. Gallen · Neupatient:innen</span>
      <h1 class="hlsg-h1">TCM <span class="hlsg-accent">St. Gallen</span>: Probier Akupunktur, deine erste Behandlung ist gratis.</h1>
      <p class="hlsg-sub">Unsere Praxis liegt wenige Gehminuten vom Bahnhof St. Gallen und ist seit dem 9. Juli offen. Lern uns unverbindlich kennen, deine erste Behandlung ist gratis. Unser Team aus der Schweiz und Südkorea begleitet dich persönlich, egal worum es geht. Von den Krankenkassen anerkannt (EMR/ASCA).</p>
      <div class="hlsg-cta-row">
        <a href="#online-buchen" class="hlsg-btn-primary">Termin online buchen</a>
      </div>
      <div class="hlsg-trust">
        <div><span class="hlsg-check">✓</span> Kein Risiko, keine Verpflichtung</div>
        <div><span class="hlsg-check">✓</span> Anerkannte Therapeut:innen</div>
        <div><span class="hlsg-check">✓</span> Termine ab dieser Woche verfügbar</div>
      </div>
      <p style="margin-top:14px;font-size:14px;font-weight:600;color:var(--mid)"><b style="color:var(--charcoal)">Geöffnet:</b> Mo–Sa 07:30–19:30 Uhr · So 08:00–17:00 Uhr</p>
    </div>

    <div class="hlsg-visual">
      <div class="hlsg-card" id="offer-form" style="scroll-margin-top:80px">
        <div class="hlsg-ribbon">NEU</div>
        <div class="hlsg-offer-big" style="font-size:clamp(1.4rem,2.6vw,1.85rem)">Deine erste Behandlung ist <span class="hlsg-free">gratis</span></div>
        <p class="hlsg-offer-note" style="margin-bottom:14px">60 Minuten, kostenlos, für Neupatient:innen in St. Gallen.</p>
        <div class="hlsg-trust" style="flex-direction:column;gap:9px;margin:0 0 14px">
          <div><span class="hlsg-check">✓</span> Ausführliches Erstgespräch, wir hören zuerst zu</div>
          <div><span class="hlsg-check">✓</span> TCM-Diagnostik durch anerkannte Therapeut:innen</div>
          <div><span class="hlsg-check">✓</span> Erste Behandlung noch in derselben Sitzung</div>
          <div><span class="hlsg-check">✓</span> Eine ehrliche Einschätzung, ob TCM bei dir sinnvoll ist. Wenn nicht, sagen wir es dir.</div>
        </div>
        <p class="hlsg-offer-note" style="margin:0 0 4px">Kein Abo, keine Verpflichtung, kein Verkaufsgespräch.</p>
        <p class="hlsg-offer-note" style="margin:0 0 10px"><strong>Termine diese Woche verfügbar.</strong></p>
        <p class="hlsg-offer-note" style="margin:0">Noch <strong class="hlsg-scarcity" data-sg-free>14</strong> von 20 Gratis-Erstgesprächen frei.</p>
        <p class="hlsg-proof"><span class="hlsg-stars" aria-hidden="true">★★★★★</span> 4.9 bei Google, von Patient:innen weiterempfohlen.</p>
        <div class="hlsg-divider"></div>
        <form class="hlsg-form" data-sg-hero-form novalidate>
          <input type="hidden" name="quelle" value="launch-hero-sg">
          <input type="hidden" name="standort" value="St. Gallen">
          <input type="text" name="name" placeholder="Name" aria-label="Name" autocomplete="name">
          <input type="tel" name="telefon" placeholder="Handynummer" aria-label="Handynummer" autocomplete="tel">
          <input type="text" name="wunschzeit" placeholder="Wunschzeit (z. B. Do Nachmittag)" aria-label="Wunschzeit">
          <div class="cf-turnstile hlsg-ts" data-sitekey={sitekey} data-appearance="interaction-only"></div>
          <button type="submit">Gratis Erstgespräch anfragen</button>
          <p class="hlsg-form-rule">Unverbindlich. Bestätigung per WhatsApp oder Telefon.</p>
          <p class="hlsg-form-err" role="alert" hidden></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .hlsg { padding-top: 68px; background: var(--surface); font-family: var(--font-sans); color: var(--charcoal); }

  .hlsg-inner {
    max-width: var(--max); margin: 0 auto;
    padding: clamp(32px, 6vw, 64px) var(--pad-x) clamp(40px, 7vw, 72px);
    display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(28px, 5vw, 56px); align-items: center;
  }
  @media (max-width: 900px) { .hlsg-inner { grid-template-columns: 1fr; gap: 32px; } }

  .hlsg-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue-light); color: var(--blue-dark); border: 1px solid rgba(45, 155, 111, .18);
    padding: 6px 13px; border-radius: var(--r-pill);
    font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  }
  .hlsg-h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.4rem); line-height: 1.06; letter-spacing: -.03em; font-weight: 800;
    margin: 18px 0 14px; color: var(--charcoal);
  }
  .hlsg-accent { color: var(--blue); }
  .hlsg-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--mid); max-width: 40ch; line-height: 1.55; }

  .hlsg-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .hlsg-btn-primary {
    background: var(--blue); color: #fff; border: none; text-decoration: none;
    padding: 15px 24px; border-radius: var(--r-btn); font-size: 16px; font-weight: 700;
    box-shadow: var(--sh-btn); transition: background var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .hlsg-btn-primary:hover { background: var(--blue-dark); transform: translateY(-2px); }
  .hlsg-btn-ghost {
    background: transparent; color: var(--charcoal); border: 1px solid var(--border); text-decoration: none;
    padding: 15px 22px; border-radius: var(--r-btn); font-size: 16px; font-weight: 600;
  }
  .hlsg-btn-ghost:hover { border-color: var(--blue); color: var(--blue-dark); }

  .hlsg-trust { display: flex; gap: 22px; margin-top: 28px; flex-wrap: wrap; font-size: 14px; color: var(--mid); }
  .hlsg-trust div { display: flex; align-items: center; gap: 7px; }
  .hlsg-check { color: var(--blue); font-weight: 800; }

  .hlsg-card {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, #ffffff, #f2f5f0);
    border: 1px solid rgba(18, 33, 28, .08); border-radius: var(--r-hero);
    padding: 32px; box-shadow: 0 24px 60px -20px rgba(0, 0, 0, .18);
  }
  .hlsg-ribbon {
    position: absolute; top: 16px; right: -42px;
    background: #FFC107; color: #2a2109; font-weight: 800; font-size: 11.5px; letter-spacing: .08em;
    padding: 6px 48px; transform: rotate(45deg); box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .3);
  }
  .hlsg-offer-tag {
    display: inline-block; background: var(--charcoal); color: #fff;
    font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    padding: 6px 11px; border-radius: 6px;
  }
  .hlsg-offer-big { font-size: clamp(1.6rem, 3vw, 2.05rem); font-weight: 800; letter-spacing: -.02em; margin: 14px 0 5px; line-height: 1.1; }
  .hlsg-free { color: var(--blue); }
  .hlsg-offer-note { color: var(--mid); font-size: 14.5px; }
  .hlsg-scarcity { color: var(--blue-dark); font-weight: 800; }
  .hlsg-proof { margin-top: 8px; font-size: 13px; color: var(--mid); }
  .hlsg-stars { color: #FFC107; letter-spacing: 1px; margin-right: 4px; }
  .hlsg-divider { height: 1px; background: var(--border); margin: 22px 0; }

  .hlsg-form { display: flex; flex-direction: column; gap: 10px; }
  .hlsg-form input {
    border: 1px solid var(--border); border-radius: 10px; padding: 13px 14px; font-size: 15px;
    background: #fff; font-family: inherit; color: var(--charcoal);
  }
  .hlsg-form input:focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: transparent; }
  .hlsg-form button {
    background: var(--blue); color: #fff; border: none; border-radius: 10px;
    padding: 14px; font-size: 15.5px; font-weight: 700; cursor: pointer;
    transition: background var(--t-fast) var(--ease-out);
  }
  .hlsg-form button:hover { background: var(--blue-dark); }
  .hlsg-form-rule { font-size: 12px; color: var(--mid); text-align: center; }
  .hlsg-ts { min-height: 0; }
  .hlsg-form-err { font-size: 13px; color: #c0392b; line-height: 1.5; margin-top: 2px; }
  .hlsg-success { text-align: center; padding: 14px 4px; }
  .hlsg-success-check {
    width: 44px; height: 44px; margin: 0 auto 12px; border-radius: 50%;
    background: var(--blue-light); color: var(--blue-dark);
    display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 800;
  }
  .hlsg-success h3 { font-size: 19px; font-weight: 800; color: var(--charcoal); margin: 0 0 8px; letter-spacing: -.01em; }
  .hlsg-success p { font-size: 14.5px; color: var(--mid); line-height: 1.55; }

  @media (max-width: 767px) {
    .hlsg { padding-top: 60px; }
    .hlsg-inner { padding-left: 16px; padding-right: 16px; }
    .hlsg-card { padding: 18px; }
    .hlsg-card, .hlsg-card * { max-width: 100%; }
    .hlsg-ts { max-width: 100%; overflow-x: auto; }
    .hlsg-form input, .hlsg-form button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .hlsg-btn-primary:hover { transform: none; } }
</style>

<script is:inline>
  (function () {
    var f = document.querySelector('[data-sg-hero-form]');
    if (!f) return;
    var btn = f.querySelector('button[type="submit"]');
    var errEl = f.querySelector('.hlsg-form-err');
    var val = function (n) { var el = f.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ''; };
    var showErr = function (m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } };
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      if (errEl) errEl.hidden = true;
      var name = val('name'), telefon = val('telefon');
      if (!name || !telefon) { showErr('Bitte Name und Handynummer angeben.'); return; }
      // Turnstile token (managed/interaction-only widget; same reader as the site forms).
      var ts = window.tcmTsToken ? window.tcmTsToken(f)
        : { el: f.querySelector('.cf-turnstile'), token: (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '' };
      if (ts.el && !ts.token) { showErr('Kurz bestätigen, dass du kein Roboter bist, dann nochmal senden.'); return; }
      var data = {
        name: name, telefon: telefon, behandlung: val('wunschzeit'),
        standort: 'St. Gallen', quelle: 'launch-hero-sg',
        zeit: new Date().toISOString(), turnstileToken: ts.token,
      };
      if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'Wird gesendet…'; }
      fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) { if (!r.ok) throw new Error('bad_status'); return r.json().catch(function () { return {}; }); })
        .then(function () {
          var ok = document.createElement('div');
          ok.className = 'hlsg-success';
          ok.innerHTML = '<div class="hlsg-success-check" aria-hidden="true">✓</div>' +
            '<h3>Danke, deine Anfrage ist da.</h3>' +
            '<p>Wir melden uns in Kürze per WhatsApp oder Telefon und bestätigen dein Gratis-Erstgespräch in St. Gallen.</p>';
          f.replaceWith(ok); // inline success in the card; no scroll/redirect
        })
        .catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || 'Gratis Erstgespräch anfragen'; }
          if (window.turnstile && ts.el) { try { window.turnstile.reset(ts.el); } catch (_) {} }
          showErr('Senden fehlgeschlagen. Bitte per WhatsApp oder Telefon melden.');
        });
    });
  })();
</script>
