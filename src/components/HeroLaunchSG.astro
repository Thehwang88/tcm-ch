<script is:inline>
  // Läuft nach DOMContentLoaded: unteres Formular, Angebots-Wähler und Sticky-Bar (Footer) stehen im DOM erst nach dem Hero.
  (function () {
  var init = function () {
    var f = document.querySelector('[data-sg-hero-form]');
    if (!f) return;
    var btn = f.querySelector('button[type="submit"]');
    var ctaText = f.querySelector('[data-f30-cta]');
    var errEl = f.querySelector('.f30-form-err');
    var tel = f.querySelector('input[name="telefon"]');
    var offerId = f.getAttribute('data-f30-offer') || 'FIRST30_WINTER_2026_SG';
    var waitlist = offerId.indexOf('WARTELISTE') > 0;
    var val = function (n) { var el = f.querySelector('input[name="' + n + '"]'); return el ? el.value.trim() : ''; };
    var showErr = function (m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } };
    // Telefon: 7–15 Ziffern, optional +, Leerzeichen, Punkte, Bindestriche, Schrägstrich, Klammern (CH und international).
    var validPhone = function (s) { var d = s.replace(/\D/g, ''); return /^\+?[0-9 ()\/.\-]{7,24}$/.test(s) && d.length >= 7 && d.length <= 15; };
    var sending = false;
    var push = function (ev, extra) { window.dataLayer = window.dataLayer || []; var o = { event: ev, campaign: 'FIRST30_WINTER_2026_SG', standort: 'St. Gallen', source_path: location.pathname }; for (var k in extra) o[k] = extra[k]; window.dataLayer.push(o); };
    var lastBottomId = 'ERSTTERMIN_REGULAER_SG';

    // ── Hero: phone-only FIRST 30 request ──
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      if (sending) return;
      if (errEl) errEl.hidden = true;
      var telefon = val('telefon');
      if (!validPhone(telefon)) { if (tel) { tel.setAttribute('aria-invalid', 'true'); tel.focus(); } showErr('Bitte gib eine gültige Telefonnummer an (z. B. 079 123 45 67 oder +41 79 123 45 67).'); return; }
      if (tel) tel.removeAttribute('aria-invalid');
      var ts = window.tcmTsToken ? window.tcmTsToken(f)
        : { el: f.querySelector('.cf-turnstile'), token: (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '' };
      if (ts.el && !ts.token) { showErr('Kurz bestätigen, dass du kein Roboter bist, dann nochmal senden.'); return; }
      var data = {
        telefon: telefon, website: val('website'),
        standort: 'St. Gallen', quelle: 'launch-hero-sg',
        formular: f.getAttribute('name') || '', angebot_id: offerId, angebot: val('Angebot'),
        quelle_detail: val('Quelle'), seite: val('Seite'),
        zeit: new Date().toISOString(), turnstileToken: ts.token,
      };
      sending = true;
      if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.dataset.label = ctaText ? ctaText.textContent : ''; if (ctaText) ctaText.textContent = 'Wird gesendet…'; }
      fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(j.error || 'bad_status'); return j; }); })
        .then(function () {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'formular_senden', form_type: 'allgemein', quelle: 'launch-hero-sg' });
          push('first30_phone_form_submit', { angebot_id: offerId, quelle: 'launch-hero-sg' });
          var ok = document.createElement('div');
          ok.className = 'f30-success';
          ok.innerHTML = '<div class="f30-success-check" aria-hidden="true">✓</div><h3></h3><p></p>';
          ok.querySelector('h3').textContent = waitlist ? 'Vielen Dank! Du stehst auf der FIRST 30 Warteliste.' : 'Vielen Dank! Wir haben deine FIRST 30 Anfrage erhalten.';
          ok.querySelector('p').textContent = waitlist ? 'Unser Praxisteam meldet sich persönlich, falls ein Wintergeschenk frei wird. Ein regulärer Ersttermin ist jederzeit möglich.' : 'Unser Praxisteam meldet sich persönlich, um deinen Termin zu vereinbaren.';
          ok.setAttribute('tabindex', '-1');
          f.replaceWith(ok); try { ok.focus({ preventScroll: true }); } catch (_) {}
        })
        .catch(function (err) {
          sending = false;
          if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); if (ctaText) ctaText.textContent = btn.dataset.label || 'Mein Wintergeschenk anfragen'; }
          if (window.turnstile && ts.el) { try { window.turnstile.reset(ts.el); } catch (_) {} }
          showErr(err && err.message === 'invalid_phone' ? 'Bitte gib eine gültige Telefonnummer an.' : 'Senden fehlgeschlagen. Bitte nochmal versuchen oder per WhatsApp oder Telefon melden.');
        });
    });

    // ── Unteres Formular: Angebots-Wähler (data-f30-bottom) → hidden angebot_id, CTA, Reassurance ──
    var bottomSel = document.querySelector('[data-f30-bottom]');
    var bottomForm = document.querySelector('#kontakt form[data-contact-form]');
    var bottomRender = function () {
      if (!bottomSel || !bottomForm) return;
      var r = bottomSel.querySelector('input[name="f30b_wahl"]:checked');
      var id = r ? r.value : 'ERSTTERMIN_REGULAER_SG', isGift = id.indexOf('FIRST30') === 0, isWait = id.indexOf('WARTELISTE') > 0;
      var hid = bottomForm.querySelector('input[name="angebot_id"]'), lab = bottomForm.querySelector('input[name="Angebot"]');
      if (hid) hid.value = id;
      lastBottomId = id;
      if (lab && r) lab.value = r.getAttribute('data-f30-label') || '';
      var sb = bottomForm.querySelector('.form-submit');
      if (sb && !sb.disabled) sb.innerHTML = isGift ? (isWait ? '<span class="f30b-cta-ic" aria-hidden="true">' + bottomSel.querySelector('.f30b-opt--gift svg').outerHTML + '</span> Auf die FIRST 30 Warteliste' : '<span class="f30b-cta-ic" aria-hidden="true">' + bottomSel.querySelector('.f30b-opt--gift svg').outerHTML + '</span> Mein Geschenk anfragen') : 'Ersttermin anfragen';
      if (sb) sb.classList.toggle('f30b-cta', isGift);
      var under = bottomForm.querySelector('.termin-under-btn');
      if (under) under.textContent = isGift ? (isWait ? 'Warteliste · CHF 0.– · Keine Verpflichtung · Wir melden uns, falls ein Platz frei wird' : 'CHF 0.– · Persönliche Terminbestätigung · Keine Folgeterminpflicht') : 'Reguläre Ersttermin-Anfrage. Kosten und Ablauf werden vor dem Termin geklärt.';
      var sum = bottomSel.querySelector('[data-f30b-summary]');
      if (sum) sum.hidden = !isGift;
      bottomSel.setAttribute('data-f30b-selected', isGift ? 'gift' : 'regular');
    };
    if (bottomSel && bottomForm) {
      var rs = bottomSel.querySelectorAll('input[name="f30b_wahl"]');
      for (var i = 0; i < rs.length; i++) rs[i].addEventListener('change', function () { bottomRender(); push('first30_bottom_select', { angebot_id: lastBottomId }); });
      bottomRender();
      // Vorauswahl über URL (?first30=1 oder #first30-kontakt), ohne automatisches Absenden.
      var q = /[?&]first30=1\b/.test(location.search) || location.hash === '#first30-kontakt';
      if (q) { var g = bottomSel.querySelector('input[name="f30b_wahl"][value^="FIRST30"]'); if (g) { g.checked = true; bottomRender(); } }
    }
    var pickBottom = function (want) {
      if (!bottomSel) return;
      var r = want === 'regular' ? bottomSel.querySelector('input[name="f30b_wahl"][value="ERSTTERMIN_REGULAER_SG"]') : bottomSel.querySelector('input[name="f30b_wahl"][value^="FIRST30"]');
      if (r) { r.checked = true; bottomRender(); }
    };

    // ── Jeder CTA mit data-offer: #kontakt → unteres Formular mit Vorauswahl, sonst → Hero-Telefonfeld ──
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('[data-offer]') : null;
      if (!a) return;
      var want = a.getAttribute('data-offer'), href = a.getAttribute('href') || '';
      if (want !== 'regular') push('first30_cta_click', { cta_position: a.getAttribute('data-cta-position') || (href === '#kontakt' ? 'page_cta_bottom_form' : 'page_cta_hero_form'), target: href });
      if (href === '#kontakt') {
        var k = document.getElementById('kontakt'); if (!k) return;
        e.preventDefault();
        pickBottom(want);
        (bottomSel || k).scrollIntoView({ behavior: 'smooth', block: 'start' });
        var nm = bottomForm && bottomForm.querySelector('input[name="name"]');
        if (nm) { try { nm.focus({ preventScroll: true }); } catch (_) { nm.focus(); } }
        try { history.replaceState(null, '', want === 'regular' ? '#kontakt' : '#first30-kontakt'); } catch (_) {}
        return;
      }
      if (href === '#offer-form' && want !== 'regular') {
        var card = document.getElementById('offer-form'); if (!card || !card.contains(f)) return;
        e.preventDefault();
        var w2 = document.querySelector('[data-f30-formwrap]'); if (w2) w2.classList.add('is-open');
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (tel) { try { tel.focus({ preventScroll: true }); } catch (_) { tel.focus(); } }
        try { history.replaceState(null, '', '#offer-form'); } catch (_) {}
      }
    });

    // ── Verfügbarkeits-Indikator: einmalige Einblend-Animation (Balken 0 → echter Anteil, Zahl 0 → echte Zahl),
    //    nur beim ersten Sichtbarwerden; der angezeigte Endwert kommt aus dem HTML (first30.ts) und wird nie erhöht. ──
    var avail = document.querySelector('[data-f30-avail]');
    if (avail) {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var num = avail.querySelector('[data-f30-count]'), finalN = num ? parseInt(num.getAttribute('data-f30-count'), 10) || 0 : 0;
      var startAvail = function () {
        if (avail.classList.contains('is-in')) return;
        if (reduce || !num) { avail.classList.add('is-in'); return; }
        num.textContent = '0';
        avail.classList.add('is-in');
        var t0 = null, dur = 1000;
        var step = function (ts) { if (t0 === null) t0 = ts; var k = Math.min(1, (ts - t0) / dur); var e = 1 - Math.pow(1 - k, 3); num.textContent = String(Math.round(finalN * e)); if (k < 1) requestAnimationFrame(step); else num.textContent = String(finalN); };
        requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) { var io = new IntersectionObserver(function (es) { if (es.some(function (x) { return x.isIntersecting; })) { startAvail(); io.disconnect(); } }, { threshold: 0.4 }); io.observe(avail); }
      else startAvail();
    }

    // ── Countdown im WhatsApp-Button (nur gerendert, wenn der tägliche Bearbeitungs-Cutoff bestätigt ist):
    //    Restzeit bis zum Cutoff in Europe/Zurich (Wanduhrzeit über Intl, DST-sicher), HH:MM ohne Layout-Shift.
    //    Nach dem Cutoff / an Nicht-Cutoff-Tagen: Hinweis auf Bearbeitung am nächsten Arbeitstag, CTA bleibt. ──
    var timer = document.querySelector('[data-f30-timer]');
    if (timer) {
      var live = timer.querySelector('[data-f30-timer-live]'), closed = timer.querySelector('[data-f30-timer-closed]');
      var hh = timer.querySelector('[data-f30-h]'), mm = timer.querySelector('[data-f30-m]'), sr = timer.querySelector('[data-f30-sr]');
      var cut = (timer.getAttribute('data-cutoff') || '17:00').split(':'), cutSec = (+cut[0]) * 3600 + (+cut[1]) * 60;
      var days = timer.getAttribute('data-days') || '123456';
      var fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Zurich', hour12: false, weekday: 'short', hour: '2-digit', minute: '2-digit', second: '2-digit' });
      var DOW = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var lastMin = -1;
      var tick = function () {
        var parts = {}; fmt.formatToParts(new Date()).forEach(function (pp) { parts[pp.type] = pp.value; });
        var now = (+parts.hour % 24) * 3600 + (+parts.minute) * 60 + (+parts.second);
        var rem = cutSec - now;
        var open = days.indexOf(String(DOW[parts.weekday] || 0)) >= 0 && rem > 0;
        if (!open) { live.hidden = true; closed.hidden = false; timer.setAttribute('data-f30-state', 'closed'); return; }
        live.hidden = false; closed.hidden = true; timer.setAttribute('data-f30-state', 'open');
        var h = Math.floor(rem / 3600), m = Math.ceil((rem % 3600) / 60); if (m === 60) { h += 1; m = 0; }
        if (hh.textContent !== pad(h)) hh.textContent = pad(h);
        if (mm.textContent !== pad(m)) mm.textContent = pad(m);
        if (m !== lastMin) { lastMin = m; sr.textContent = 'Heutige Anfragefrist endet in ' + h + ' Stunden und ' + m + ' Minuten, um ' + cut.join(':') + ' Uhr.'; }
      };
      tick(); setInterval(tick, 1000);
    }

    // ── Schwebender Geschenk-CTA (Kampagne): ersetzt die reguläre Sticky-Bar auf dieser Seite; sichtbar erst,
    //    wenn die Geschenkkarte aus dem Bild ist; aus, solange Karte/unteres Formular sichtbar oder ein Feld fokussiert ist;
    //    Dismiss gilt für die Browser-Sitzung (sessionStorage). ──
    var floats = document.querySelectorAll('[data-f30-float]'), bar = document.querySelector('.scb-bar'), cardEl = document.getElementById('offer-form'), kEl = document.getElementById('kontakt');
    var dismissed = false; try { dismissed = sessionStorage.getItem('f30-float-dismissed') === '1'; } catch (_) {}
    if (floats.length && cardEl && 'IntersectionObserver' in window) {
      if (bar) bar.classList.add('scb-off');
      var cardIn = true, kIn = false, focused = false;
      var apply = function () {
        var on = !dismissed && !cardIn && !kIn && !focused;
        for (var i = 0; i < floats.length; i++) { floats[i].hidden = false; floats[i].classList.toggle('is-on', on); floats[i].setAttribute('aria-hidden', on ? 'false' : 'true'); }
        document.body.classList.toggle('f30-float-on', on);
      };
      new IntersectionObserver(function (es) { es.forEach(function (x) { cardIn = x.isIntersecting; }); apply(); }, { threshold: 0.05 }).observe(cardEl);
      if (kEl) new IntersectionObserver(function (es) { es.forEach(function (x) { kIn = x.isIntersecting; }); apply(); }, { threshold: 0.05 }).observe(kEl);
      document.addEventListener('focusin', function (ev) { focused = !!(ev.target && ev.target.closest && ev.target.closest('form')); apply(); });
      document.addEventListener('focusout', function () { setTimeout(function () { focused = !!(document.activeElement && document.activeElement.closest && document.activeElement.closest('form')); apply(); }, 50); });
      var xs = document.querySelectorAll('[data-f30-dismiss]');
      for (var j = 0; j < xs.length; j++) xs[j].addEventListener('click', function () { dismissed = true; try { sessionStorage.setItem('f30-float-dismissed', '1'); } catch (_) {} apply(); push('first30_cta_dismiss', { cta_position: window.innerWidth > 768 ? 'floating_desktop' : 'floating_mobile' }); });
      apply();
    }
    // Hero-Fallback-Link: Telefonformular einblenden (mobil) und fokussieren.
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('[data-f30-showform]') : null;
      if (!a) return;
      e.preventDefault();
      var w = document.querySelector('[data-f30-formwrap]'); if (w) w.classList.add('is-open');
      push('first30_cta_click', { cta_position: a.getAttribute('data-cta-position') || 'hero_form_fallback' });
      if (tel) { try { tel.focus({ preventScroll: false }); } catch (_) { tel.focus(); } tel.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    });
    // WhatsApp-Geschenk-CTAs: Outbound-Intent-Event (kein Nachweis einer gesendeten Nachricht oder Buchung).
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('[data-f30-wa]') : null;
      if (!a) return;
      push('first30_whatsapp_click', { cta_position: a.getAttribute('data-cta-position') || 'hero' });
    });
    // Erfolg des unteren Formulars (home.js ersetzt die Karte durch den Erfolgstext): einmaliges FIRST-30-Event,
    // zusätzlich zum bestehenden formular_senden von home.js (nicht verändert).
    var bCard = document.querySelector('#kontakt .inline-form-card');
    if (bCard && bottomForm && 'MutationObserver' in window) {
      var bDone = false;
      new MutationObserver(function () {
        if (bDone || bCard.querySelector('form[data-contact-form]')) return;
        bDone = true;
        var id = (bottomForm.querySelector('input[name="angebot_id"]') || {}).value || lastBottomId;
        if (id && id.indexOf('FIRST30') === 0) push('first30_bottom_form_submit', { angebot_id: id });
      }).observe(bCard, { childList: true, subtree: true });
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
