---
// Hero for the St. Gallen standort page only — TCM.ch FIRST 30 · Pre-Christmas Edition 2026 (WhatsApp-first, phone-only fallback).
// Mobile first (390px): Ribbon → Headline → Scarcity → EIN Feld (Telefon) → Geschenk-CTA → Microcopy/Consent.
// Desktop 50/50: links Angebot + Leistungen, rechts die Geschenkkarte mit dem Ein-Feld-Formular.
// Tracking-tragende Identifier sind UNVERÄNDERT: form name/data-name "Hero-Gratis-30min-StGallen",
// hidden quelle=launch-hero-sg, Quelle/Seite, dataLayer-Push formular_senden {form_type:'allgemein',
// quelle:'launch-hero-sg'} genau einmal nach HTTP ok. Payload: angebot_id + angebot (Server-Whitelist,
// functions/api/anfrage.js; phone-only nur für launch-hero-sg + FIRST-30-ID). Kein Countdown, keine
// erfundene Verfügbarkeit: Kapazitätstexte ausschliesslich aus src/data/first30.ts.
// Zusätzlich steuert der Script unten den Angebots-Wähler des unteren Formulars (data-f30-bottom) und die
// FIRST-30-CTAs der Seite (data-offer): #offer-form → Hero-Telefonfeld, #kontakt → unteres Formular mit Vorauswahl.
import { FIRST30, first30State, GIFT_SVG } from '../data/first30';
import { campaignCtaFor } from '../data/campaign-cta';
const { sitekey } = Astro.props;
const st = first30State();
const ind = st.indicator;
const ctaLabel = st.soldOut ? 'Auf die FIRST 30 Warteliste' : 'Mein Wintergeschenk anfragen';
const cta = campaignCtaFor('st-gallen');
const WA_SVG = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>';
const waMain = st.soldOut ? 'Auf die FIRST 30 Warteliste' : 'Ja, ich will mein Geschenk!';
const CLOCK_SVG = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
---
<section class="f30-hero" id="first30" data-first30={st.soldOut ? 'soldout' : st.reserved == null ? 'max-only' : 'verified'} data-first30-preview={st.preview ? '1' : undefined}>
  <div class="f30-inner">
    <div class="f30-left">
      <p class="f30-ribbonpill"><span class="f30-pill"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19"/></svg> FIRST 30 · Pre-Christmas Edition 2026</span><span class="f30-eyebrow2">{FIRST30.identity}</span></p>
      <h1 class="f30-h1">Weihnachten kommt dieses Jahr früher.</h1>
      <p class="f30-h2"><em>30 Minuten TCM geschenkt.</em></p>
      <p class="f30-sub">Dein persönliches Vorweihnachtsgeschenk bei TCM.ch St. Gallen. Schon jetzt. Ganz ohne Verpflichtung.</p>
      <p class="f30-value"><span class="f30-value-big">30 Min. · CHF 0.–</span><span class="f30-value-s">{st.scarcityText}</span></p>

      <div class="f30-desk">
        <div class="f30-pricebar" aria-label="Preis und Umfang">
          <span class="f30-pricebar-price">CHF 0.–</span>
          <span class="f30-pricebar-meta"><b>Du zahlst CHF 0.–</b> für 30 Minuten persönliche TCM-Erfahrung<br>Für Menschen, die schon länger etwas für sich tun möchten</span>
        </div>
        <ol class="f30-stack" aria-label="Die fünf Leistungen des Willkommenspakets">
          <li><span>1</span>Persönliches Gespräch über deine Beschwerden</li>
          <li><span>2</span>Individuelle TCM-Kurzeinschätzung</li>
          <li><span>3</span>Erste kurze Anwendung, wenn fachlich und zeitlich möglich</li>
          <li><span>4</span>Drei persönliche Empfehlungen für deinen Alltag</li>
          <li><span>5</span>Unterstützung beim Zusatzversicherungs-Check</li>
        </ol>
        <ul class="f30-trust">
          <li>Nur für neue Patient:innen · einmal pro Person</li>
          <li>Keine Verpflichtung zur Weiterbehandlung</li>
          <li>EMR-/ASCA-anerkannte Therapeut:innen</li>
          <li>Oberer Graben 22 · Mo–Sa 07:30–19:30 · So 08:00–17:00</li>
        </ul>
        <p class="f30-tert"><a href="#online-buchen" class="f30-link">Lieber regulär buchen? Online-Termin wählen</a> · <a href="#kontakt" data-offer="regular" class="f30-link">Regulärer Ersttermin anfragen</a></p>
        <p class="f30-tert"><a href="tel:+41775236122">Anrufen</a> · <a href="https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen." target="_blank" rel="noopener">WhatsApp</a></p>
        <p class="f30-note">Ein Vorweihnachtsgeschenk, das du sofort anfragen kannst: Termine sind ab jetzt möglich, nicht erst an Weihnachten. Einmal pro Person, nur für neue Patient:innen.</p>
      </div>
    </div>

    <div class="f30-cardwrap">
      <div class="f30-card" id="offer-form" style="scroll-margin-top:84px">
        <div class="f30-ribbon" aria-hidden="true"><span>{st.ribbon}</span></div>
        <p class="f30-card-eyebrow">FIRST 30 · Pre-Christmas Edition 2026</p>
        <div class="f30-price"><span class="f30-price-big">30 Min. · CHF 0.–</span><span class="f30-price-meta">Du zahlst CHF 0.–<br>Persönlich &amp; unverbindlich</span></div>
        <div class="f30-body">
        <div class={`f30-avail f30-avail--${ind.mode}`} data-f30-avail data-mode={ind.mode} data-pct={ind.pct} data-confirmed={st.reserved ?? ''} data-total={st.max} role="group" aria-label="Verfügbarkeit der Geschenke">
          <p class="f30-avail-h">{ind.mode === 'unverified' ? ind.head : <Fragment><b class="f30-avail-n" data-f30-count={st.reserved ?? 0}>{st.reserved ?? 0}</b> / {st.max} Geschenke vergeben</Fragment>}</p>
          {ind.mode !== 'unverified' && <div class="f30-avail-bar" aria-hidden="true"><span class="f30-avail-fill" style={`--f30-pct:${ind.pct}%`}></span></div>}
          <p class="f30-avail-s">{ind.sub}</p>
        </div>
        {cta && (
          <div class="f30-wa">
            <a href={cta.whatsappHref} class="f30-cta f30-cta--wa" target="_blank" rel="noopener" data-f30-wa data-cta-position="hero" aria-label={`${waMain} WhatsApp öffnet sich mit einer vorbereiteten Nachricht, die du selbst sendest. ${st.cutoffApproved ? 'Heutige Anfragefrist siehe Countdown.' : st.scarcityText + '.'}`}>
              <span class="f30-wa-top">
                <span class="f30-cta-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span>
                <span class="f30-wa-txt"><span class="f30-wa-main">{waMain}</span><span class="f30-wa-sup"><Fragment set:html={WA_SVG} /> WhatsApp öffnen · Nachricht vorbereitet</span></span>
                <span class="f30-cta-arrow" aria-hidden="true">→</span>
              </span>
              {st.cutoffApproved ? (
                <span class="f30-wa-strip" data-f30-timer data-cutoff={st.cutoffTime} data-days={st.cutoffDays}>
                  <span class="f30-wa-strip-live" data-f30-timer-live>
                    <span class="f30-wa-strip-l"><Fragment set:html={CLOCK_SVG} /> Heutige Anfragefrist</span>
                    <span class="f30-wa-count" aria-hidden="true"><b data-f30-h>--</b>:<b data-f30-m>--</b></span>
                    <span class="f30-sr" aria-live="polite" data-f30-sr></span>
                  </span>
                  <span class="f30-wa-strip-closed" data-f30-timer-closed hidden>Anfragen weiterhin möglich · Bearbeitung am nächsten Arbeitstag</span>
                </span>
              ) : (
                <span class="f30-wa-strip"><span class="f30-wa-strip-l"><Fragment set:html={GIFT_SVG} /> {st.scarcityText}</span></span>
              )}
            </a>
            <p class="f30-cta-sub">Kein Formular. Keine Verpflichtung.</p>
            <p class="f30-cta-sub2">Termin nach persönlicher Bestätigung. Du sendest die Nachricht selbst in WhatsApp.</p>
            <p class="f30-alt f30-alt--form"><a href="#f30-tel" data-f30-showform data-cta-position="hero_form_fallback">Lieber ohne WhatsApp? Kurzes Kontaktformular nutzen</a></p>
          </div>
        )}
        <div class="f30-formwrap" data-f30-formwrap>
        <form class="f30-form" name="Hero-Gratis-30min-StGallen" data-name="Hero-Gratis-30min-StGallen" data-sg-hero-form data-f30-offer={st.gift.id} novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="f30-hp">
          <input type="hidden" name="quelle" value="launch-hero-sg">
          <input type="hidden" name="standort" value="St. Gallen">
          <input type="hidden" name="angebot_id" value={st.gift.id}>
          <input type="hidden" name="Angebot" value={st.gift.label}>
          <input type="hidden" name="Quelle" value="Hero St. Gallen Neueroeffnung">
          <input type="hidden" name="Seite" value="/standort/st-gallen">
          <label class="f30-label" for="f30-tel">Deine Telefonnummer</label>
          <input id="f30-tel" type="tel" name="telefon" placeholder="z. B. 079 123 45 67" autocomplete="tel" inputmode="tel" required aria-describedby="f30-consent">
          <div class="cf-turnstile f30-ts" data-sitekey={sitekey} data-appearance="interaction-only"></div>
          <button type="submit" class="f30-cta"><span class="f30-cta-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span><span data-f30-cta>{ctaLabel}</span><span class="f30-cta-arrow" aria-hidden="true">→</span></button>
          <p class="f30-cta-sub">Nur deine Nummer. Wir erledigen den Rest.</p>
          <p class="f30-cta-sub2">Wir kontaktieren dich zur Terminvereinbarung. Keine Verpflichtung.</p>
          <p class="f30-consent" id="f30-consent">Mit dem Absenden stimmst du zu, dass das Praxisteam von TCM.ch St. Gallen dich unter dieser Nummer telefonisch oder per WhatsApp zur Terminvereinbarung kontaktiert. <a href="/datenschutz/">Datenschutz</a></p>
          <p class="f30-form-err" role="alert" hidden></p>
        </form>
        </div>
        </div>
        <p class="f30-alt"><a href="#online-buchen">Lieber regulär buchen? Online-Termin wählen</a></p>
        <p class="f30-disclaimer">Der 30-Minuten-Termin ist ein Termin für neue Patient:innen (einmal pro Person) und garantiert keine vollständige Erstbehandlung und kein bestimmtes medizinisches Ergebnis; eine Anwendung hängt von der fachlichen Eignung und der verfügbaren Zeit ab. Ein Termin ist erst nach Bestätigung durch die Praxis vereinbart.</p>
      </div>
    </div>
  </div>
</section>

{cta && (
  <Fragment>
    {/* Schwebender Geschenk-CTA (Kampagnen-Config src/data/campaign-cta.ts): mobile = WhatsApp-Karte, Desktop = Pill → Formular.
        Ersetzt auf dieser Seite die reguläre Sticky-Bar (scb-off), erscheint erst, wenn die Geschenkkarte aus dem Bild ist. */}
    <div class="f30-float f30-float--m" data-f30-float="mobile" data-campaign={cta.campaignId} hidden>
      <a href={cta.whatsappHref} target="_blank" rel="noopener" class="f30-float-card" data-f30-wa data-cta-position="floating_mobile" aria-label={`${cta.eyebrow}: ${cta.main}, ${cta.secondary}. Öffnet WhatsApp mit vorbereiteter Nachricht`}>
        <span class="f30-float-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span>
        <span class="f30-float-txt"><span class="f30-float-main">{cta.main}</span><span class="f30-float-sec">{cta.secondary}</span></span>
        <span class="f30-float-arrow" aria-hidden="true"><Fragment set:html={WA_SVG} /></span>
      </a>
      <button type="button" class="f30-float-x" data-f30-dismiss aria-label="Geschenk-Hinweis für diese Sitzung schliessen">×</button>
    </div>
    <div class="f30-float f30-float--d" data-f30-float="desktop" data-campaign={cta.campaignId} hidden>
      <a href={cta.targetForm} class="f30-float-pill" data-offer="first30" data-cta-position="floating_desktop" aria-label={`${cta.desktopMain}, ${cta.desktopSub}: zum Anfrageformular`}>
        <span class="f30-float-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span>
        <span class="f30-float-txt"><span class="f30-float-main">{cta.desktopMain}</span><span class="f30-float-sec">{cta.desktopSub}</span></span>
      </a>
      <button type="button" class="f30-float-x" data-f30-dismiss aria-label="Geschenk-Hinweis für diese Sitzung schliessen">×</button>
    </div>
  </Fragment>
)}

<style>
  .f30-hero {
    --f30-ox: #541D2B; --f30-bg: #813548; --f30-gold: #F0CB91; --f30-ivory: #FFF9F3;
    --f30-gold-deep: #C9A268; --f30-ink: #2a0f16;
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--f30-ivory); color: var(--f30-ink); font-family: var(--font-sans);
    padding: calc(var(--header-h, 76px) + clamp(24px, 4vw, 56px)) 0 clamp(32px, 5vw, 64px);
    border-bottom: 1px solid rgba(84, 29, 43, .12);
  }
  .f30-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(900px 520px at 78% 42%, rgba(129, 53, 72, .16), transparent 70%), radial-gradient(520px 320px at 10% 100%, rgba(240, 203, 145, .28), transparent 70%); }
  .f30-inner { max-width: var(--max, 1280px); margin: 0 auto; padding: 0 var(--pad-x, 40px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .f30-left { max-width: 600px; }
  .f30-ribbonpill { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 0 0 14px; }
  .f30-pill { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--f30-ox);
    background: linear-gradient(180deg, #F7DDB0, var(--f30-gold)); border: 1px solid var(--f30-gold-deep); box-shadow: 0 6px 14px -8px rgba(84, 29, 43, .5); }
  .f30-pill svg { color: var(--f30-bg); }
  .f30-eyebrow2 { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(84, 29, 43, .66); }
  .f30-h1 { font-size: clamp(36px, 4.8vw, 62px); font-weight: 800; letter-spacing: -.025em; line-height: 1.02; color: var(--f30-ox); margin: 0 0 12px; }
  .f30-h1 em { font-style: italic; font-family: 'Nunito', var(--font-sans); font-weight: 700; color: var(--f30-bg); }
  .f30-h2 { font-size: clamp(20px, 2.2vw, 28px); font-weight: 700; margin: 0 0 10px; color: var(--f30-bg); font-family: 'Nunito', var(--font-sans); font-style: italic; line-height: 1.2; }
  .f30-sub { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.5; font-weight: 600; color: rgba(42, 15, 22, .86); margin: 0 0 12px; max-width: 46ch; }
  .f30-value { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin: 0 0 16px; }
  .f30-value-big { font-size: clamp(22px, 2.4vw, 28px); font-weight: 800; letter-spacing: -.02em; color: var(--f30-ox); font-variant-numeric: tabular-nums; }
  .f30-value-s { font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--f30-bg); }
  .f30-pricebar { display: flex; align-items: center; gap: 14px; margin: 0 0 16px; padding: 10px 14px; border-radius: 14px; border: 1px solid rgba(201, 162, 104, .6); background: rgba(255, 255, 255, .6); }
  .f30-pricebar-price { font-size: 30px; font-weight: 800; letter-spacing: -.03em; color: var(--f30-bg); line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .f30-pricebar-meta { font-size: 13.5px; line-height: 1.35; color: rgba(42, 15, 22, .82); border-left: 1px solid rgba(201, 162, 104, .7); padding-left: 12px; }
  .f30-pricebar-meta b { color: var(--f30-ox); }
  .f30-stack { list-style: none; margin: 0 0 14px; padding: 14px 16px; display: grid; gap: 7px; border: 1px solid rgba(201, 162, 104, .55); border-radius: 14px; background: rgba(255, 255, 255, .55); }
  .f30-stack li { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 600; color: var(--f30-ox); line-height: 1.35; }
  .f30-stack li span { flex: 0 0 22px; width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font-size: 11.5px; font-weight: 800; color: var(--f30-ox); background: linear-gradient(145deg, #F7DDB0, var(--f30-gold)); border: 1px solid var(--f30-gold-deep); }
  .f30-trust { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: rgba(42, 15, 22, .78); }
  .f30-trust li::before { content: '✓'; color: var(--f30-bg); font-weight: 800; margin-right: 5px; }
  .f30-tert { font-size: 14px; margin: 0 0 10px; color: rgba(42, 15, 22, .8); }
  .f30-tert a, .f30-alt a { color: var(--f30-ox); font-weight: 700; text-decoration: underline; text-decoration-color: var(--f30-gold-deep); text-underline-offset: 3px; }
  .f30-note { font-size: 12.5px; line-height: 1.5; color: rgba(42, 15, 22, .66); margin: 0 0 6px; max-width: 60ch; }

  /* ── Geschenkkarte ── */
  .f30-cardwrap { position: relative; }
  .f30-cardwrap::before { content: ''; position: absolute; inset: 8% 4% -4%; z-index: -1; border-radius: 32px; filter: blur(36px); background: rgba(129, 53, 72, .4); }
  .f30-card { position: relative; overflow: hidden; border-radius: 22px; padding: clamp(22px, 2.6vw, 34px);
    background: linear-gradient(160deg, #6A2638 0%, var(--f30-ox) 55%, #3E1420 100%); color: var(--f30-ivory);
    border: 1px solid rgba(240, 203, 145, .55); box-shadow: 0 30px 70px -24px rgba(84, 29, 43, .7), inset 0 1px 0 rgba(255, 249, 243, .18); }
  .f30-card::before { content: ''; position: absolute; inset: 7px; border-radius: 16px; border: 1px solid rgba(240, 203, 145, .28); pointer-events: none; }
  .f30-card::after { content: ''; position: absolute; left: -30%; top: -60%; width: 70%; height: 220%; transform: rotate(18deg); pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255, 249, 243, .07), transparent); }
  .f30-ribbon { position: absolute; top: 24px; right: -54px; width: 220px; transform: rotate(45deg); z-index: 2; text-align: center;
    background: linear-gradient(180deg, #F7DDB0, var(--f30-gold) 55%, var(--f30-gold-deep)); color: var(--f30-ox);
    font-size: 10.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; padding: 7px 0; box-shadow: 0 6px 16px -6px rgba(0, 0, 0, .45); }
  .f30-ribbon::before, .f30-ribbon::after { content: ''; position: absolute; top: 0; bottom: 0; width: 1px; background: rgba(84, 29, 43, .35); }
  .f30-ribbon::before { left: 24px; } .f30-ribbon::after { right: 24px; }
  .f30-card-eyebrow { position: relative; font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--f30-gold); margin: 0 0 10px; padding-right: 70px; }
  .f30-price { position: relative; display: flex; align-items: center; gap: 14px; margin: 0 0 12px; }
  .f30-price-big { font-size: clamp(26px, 2.4vw, 34px); font-weight: 800; letter-spacing: -.03em; color: var(--f30-gold); line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .f30-price-meta { font-size: 13px; line-height: 1.35; color: rgba(255, 249, 243, .85); border-left: 1px solid rgba(240, 203, 145, .4); padding-left: 12px; }
  /* ── Verfügbarkeits-Indikator (über dem Geschenk-CTA; Werte ausschliesslich aus first30.ts) ── */
  .f30-avail { order: 0; position: relative; padding: 10px 12px; border: 1px solid rgba(240, 203, 145, .45); border-radius: 12px; background: rgba(0, 0, 0, .14); box-shadow: inset 0 1px 0 rgba(255, 249, 243, .08); }
  .f30-avail-h { font-size: 13.5px; font-weight: 800; color: var(--f30-ivory); margin: 0 0 7px; letter-spacing: .01em; font-variant-numeric: tabular-nums; }
  .f30-avail-n { display: inline-block; min-width: 2ch; text-align: right; color: var(--f30-gold); font-size: 16px; }
  .f30-avail-bar { height: 7px; border-radius: 4px; background: rgba(255, 249, 243, .14); border: 1px solid rgba(240, 203, 145, .4); overflow: hidden; margin: 0 0 7px; }
