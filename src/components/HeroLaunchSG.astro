      apply();
    }
    // Hero-Fallback-Link: Telefonformular einblenden (mobil) und fokussieren.
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('[data-f30-showform]') : null;
      if (!a) return;
      e.preventDefault();
      var w = document.querySelector('[data-f30-formwrap]'); if (w) w.classList.add('is-open');
      push('first30_cta_click', { cta_position: a.getAttribute('data-cta-position') || 'hero_form_fallback' });
      if (tel) { try { tel.focus({ preventScroll: false }); } catch (_) { tel.focus(); } tel.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    });
    // WhatsApp-Geschenk-CTAs: Outbound-Intent-Event (kein Nachweis einer gesendeten Nachricht oder Buchung).
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('[data-f30-wa]') : null;
      if (!a) return;
      push('first30_whatsapp_click', { cta_position: a.getAttribute('data-cta-position') || 'hero' });
    });
    // Erfolg des unteren Formulars (home.js ersetzt die Karte durch den Erfolgstext): einmaliges FIRST-30-Event,
    // zusätzlich zum bestehenden formular_senden von home.js (nicht verändert).
    var bCard = document.querySelector('#kontakt .inline-form-card');
    if (bCard && bottomForm && 'MutationObserver' in window) {
      var bDone = false;
