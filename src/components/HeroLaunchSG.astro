---
// Hero for the St. Gallen standort page only — TCM.ch FIRST 30 · Pre-Christmas Edition 2026 (brand-aligned V2).
// Architektur = regulärer St.-Gallen-Hero (.lsr-hero/.lsr-inner/.lsr-left aus home.css, Mint-Fläche, Figtree 800,
// Nunito-Akzent): links die kurze Einführung + drei Leistungen, rechts statt Foto die kompakte Geschenkkarte (Pine).
// Mobile first (390px): Eyebrow → H1 → Lead → Karte (Wert → Verfügbarkeit → WhatsApp-CTA) → Leistungen. Desktop: Telefonfeld
// primär, WhatsApp sekundär. Saisonale Akzente (Gold/Burgund) nur in der kleinen Schleife.
// Tracking-tragende Identifier sind UNVERÄNDERT: form name/data-name "Hero-Gratis-30min-StGallen",
// hidden quelle=launch-hero-sg, Quelle/Seite, dataLayer-Push formular_senden {form_type:'allgemein',
// quelle:'launch-hero-sg'} genau einmal nach HTTP ok. Payload: angebot_id + angebot (Server-Whitelist,
// functions/api/anfrage.js; phone-only nur für launch-hero-sg + FIRST-30-ID). Kein Countdown ohne bestätigten Cutoff,
// keine erfundene Verfügbarkeit: Kapazitätstexte ausschliesslich aus src/data/first30.ts.
// Zusätzlich steuert der Script unten den Angebots-Wähler des unteren Formulars (data-f30-bottom) und die
// FIRST-30-CTAs der Seite (data-offer): #offer-form → Hero-Telefonfeld, #kontakt → unteres Formular mit Vorauswahl.
import { first30State, GIFT_SVG } from '../data/first30';
import { campaignCtaFor } from '../data/campaign-cta';
const { sitekey } = Astro.props;
const st = first30State();
const ind = st.indicator;
const ctaLabel = st.soldOut ? 'Auf die FIRST 30 Warteliste' : 'Ja, ich möchte mein Geschenk!';
const cta = campaignCtaFor('st-gallen');
const WA_SVG = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>';
const waMain = st.soldOut ? 'Auf die FIRST 30 Warteliste' : 'Ja, ich will mein Geschenk!';
const waDesk = st.soldOut ? 'Warteliste per WhatsApp' : 'Geschenk per WhatsApp anfragen';
const CLOCK_SVG = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
---
<section class="lsr-hero f30-hero" id="first30" data-first30={st.soldOut ? 'soldout' : st.reserved == null ? 'max-only' : 'verified'} data-first30-preview={st.preview ? '1' : undefined}>
  <div class="lsr-inner f30-inner">
    <div class="lsr-left f30-intro">
      <span class="lsr-eyebrow f30-pill">FIRST 30 · Vorweihnachts-Edition</span>
      <h1 class="lsr-h1 f30-h1">Weihnachten kommt dieses Jahr früher. <span class="f30-h2"><em class="lsr-accent">30 Minuten TCM in St. Gallen geschenkt.</em></span></h1>
      <p class="lsr-lead f30-lead">Entdecke TCM ganz persönlich – 30 Minuten für dich, kostenlos und unverbindlich.</p>
    </div>

    <div class="f30-right">
      <div class="f30-card" id="offer-form" style="scroll-margin-top:84px">
        <div class="f30-ribbon" aria-hidden="true"><span>{st.ribbon}</span></div>
        <p class="f30-card-eyebrow"><span aria-hidden="true">🎁</span> Dein Vorweihnachtsgeschenk</p>
        <p class="f30-value"><span class="f30-value-big">30 Minuten · CHF 0.–</span><span class="f30-value-s">Persönliche TCM-Einführung in St. Gallen</span></p>
        <div class={`f30-avail f30-avail--${ind.mode}`} data-f30-avail data-mode={ind.mode} data-pct={ind.pct} data-confirmed={st.reserved ?? ''} data-total={st.max} role="group" aria-label="Verfügbarkeit der Geschenke">
          <p class="f30-avail-h">{ind.mode === 'unverified' ? <Fragment><span class="f30-avail-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span>{ind.head}</Fragment> : <Fragment><b class="f30-avail-n" data-f30-count={st.reserved ?? 0}>{st.reserved ?? 0}</b> / {st.max} Geschenke vergeben</Fragment>}</p>
          {ind.mode !== 'unverified' && <div class="f30-avail-bar" aria-hidden="true"><span class="f30-avail-fill" style={`--f30-pct:${ind.pct}%`}></span></div>}
          {ind.sub && <p class="f30-avail-s">{ind.sub}</p>}
        </div>
        <div class="f30-body">
          {cta && (
            <div class="f30-wa">
              <p class="f30-or f30-d" aria-hidden="true"><span>Oder direkt via WhatsApp</span></p>
              <a href={cta.whatsappHref} class="f30-cta f30-cta--wa" target="_blank" rel="noopener" data-f30-wa data-cta-position="hero" aria-label={`${waMain} – WhatsApp öffnet sich mit einer vorbereiteten Nachricht, die du selbst sendest.`}>
                <span class="f30-wa-top">
                  <span class="f30-wa-m"><span aria-hidden="true">🎁</span> {waMain}</span>
                  <span class="f30-wa-d"><span class="f30-wa-dic" aria-hidden="true"><Fragment set:html={WA_SVG} /></span>{waDesk} <span aria-hidden="true">→</span></span>
                </span>
                {st.cutoffApproved && (
                  <span class="f30-wa-strip" data-f30-timer data-cutoff={st.cutoffTime} data-days={st.cutoffDays}>
                    <span class="f30-wa-strip-live" data-f30-timer-live>
                      <span class="f30-wa-strip-l"><Fragment set:html={CLOCK_SVG} /> Heutige Anfragefrist</span>
                      <span class="f30-wa-count" aria-hidden="true"><b data-f30-h>--</b>:<b data-f30-m>--</b></span>
                      <span class="f30-sr" aria-live="polite" data-f30-sr></span>
                    </span>
                    <span class="f30-wa-strip-closed" data-f30-timer-closed hidden>Anfragen weiterhin möglich · Bearbeitung am nächsten Arbeitstag</span>
                  </span>
                )}
              </a>
              <p class="f30-cta-sub f30-m">Via WhatsApp anfragen · Nachricht vorbereitet</p>
              <p class="f30-cta-sub2 f30-m">Nur ein Klick zu WhatsApp. Keine Verpflichtung.</p>
              <p class="f30-alt f30-alt--form f30-m"><a href="#f30-tel" data-f30-showform data-cta-position="hero_form_fallback">Lieber ohne WhatsApp? Telefonnummer hinterlassen</a></p>
            </div>
          )}
          <div class="f30-formwrap" data-f30-formwrap>
            <form class="f30-form" name="Hero-Gratis-30min-StGallen" data-name="Hero-Gratis-30min-StGallen" data-sg-hero-form data-f30-offer={st.gift.id} novalidate>
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="f30-hp">
              <input type="hidden" name="quelle" value="launch-hero-sg">
              <input type="hidden" name="standort" value="St. Gallen">
              <input type="hidden" name="angebot_id" value={st.gift.id}>
              <input type="hidden" name="Angebot" value={st.gift.label}>
              <input type="hidden" name="Quelle" value="Hero St. Gallen Neueroeffnung">
              <input type="hidden" name="Seite" value="/standort/st-gallen">
              <label class="f30-label" for="f30-tel">Deine Telefonnummer</label>
              <input id="f30-tel" type="tel" name="telefon" placeholder="z. B. 079 123 45 67" autocomplete="tel" inputmode="tel" required aria-describedby="f30-consent">
              <div class="cf-turnstile f30-ts" data-sitekey={sitekey} data-appearance="interaction-only"></div>
              <button type="submit" class="f30-cta"><span aria-hidden="true">🎁</span> <span data-f30-cta>{ctaLabel}</span></button>
              <p class="f30-cta-sub2">Wir melden uns persönlich zur Terminvereinbarung.</p>
              <p class="f30-consent" id="f30-consent">Mit dem Absenden stimmst du zu, dass das Praxisteam von TCM.ch St. Gallen dich unter dieser Nummer telefonisch oder per WhatsApp zur Terminvereinbarung kontaktiert. <a href="/datenschutz/">Datenschutz</a></p>
              <p class="f30-form-err" role="alert" hidden></p>
            </form>
          </div>
        </div>
        <p class="f30-alt"><a href="#online-buchen">Lieber regulär buchen? Online-Termin wählen</a></p>
        <p class="f30-disclaimer">Für neue Patient:innen, einmal pro Person. Keine Verpflichtung. Termin nach persönlicher Bestätigung.</p>
        <details class="f30-terms">
          <summary>Alle Konditionen</summary>
          <p>Der 30-Minuten-Termin ist ein Termin für neue Patient:innen (einmal pro Person) und garantiert keine vollständige Erstbehandlung und kein bestimmtes medizinisches Ergebnis; eine Anwendung hängt von der fachlichen Eignung und der verfügbaren Zeit ab. Ein Termin ist erst nach Bestätigung durch die Praxis vereinbart. Eine WhatsApp-Nachricht oder Anfrage ist keine Reservierung; die Anzahl verfügbarer Geschenke wird von der Praxis manuell nach bestätigten Terminen aktualisiert. Keine Verpflichtung zur Weiterbehandlung. EMR-/ASCA-anerkannte Therapeut:innen · Oberer Graben 22, St. Gallen · Mo–Sa 07:30–19:30, So 08:00–17:00.</p>
        </details>
      </div>
    </div>

    <div class="lsr-left f30-more">
      <ul class="f30-benefits" aria-label="Das Geschenk umfasst">
        <li><span class="lsr-check" aria-hidden="true">✓</span> Persönliches Gespräch &amp; TCM-Kurzeinschätzung</li>
        <li><span class="lsr-check" aria-hidden="true">✓</span> Individuelle Tipps für deinen Alltag</li>
        <li><span class="lsr-check" aria-hidden="true">✓</span> Erste Anwendung, wenn fachlich sinnvoll und zeitlich möglich</li>
      </ul>
      <p class="f30-trustline">Für neue Patient:innen · Einmal pro Person · Anerkannte Therapeut:innen</p>
    </div>
  </div>
</section>

{cta && (
  <Fragment>
    {/* Mobiler FIRST-30-Hinweis wird per JS ALS ZUSATZ in die reguläre .scb-bar verschoben.
        Der normale Termin-/WhatsApp-/Anrufen-Sticky bleibt aktiv. Desktop: separater kompakter Pill-CTA. */}
    <div class="f30-float f30-float--m" data-f30-float="mobile" data-campaign={cta.campaignId} hidden>
      <a href={cta.whatsappHref} target="_blank" rel="noopener" class="f30-float-card" data-f30-wa data-cta-position="floating_mobile" aria-label={`${cta.eyebrow}: ${cta.main}, ${cta.secondary}. Öffnet WhatsApp mit vorbereiteter Nachricht`}>
        <span class="f30-float-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span>
        <span class="f30-float-txt"><span class="f30-float-main">{st.soldOut ? 'FIRST 30 · Warteliste' : 'FIRST 30 · 30 Min. geschenkt'}</span></span>
        <span class="f30-float-arrow" aria-hidden="true"><Fragment set:html={WA_SVG} /></span>
      </a>
      <button type="button" class="f30-float-x" data-f30-dismiss aria-label="Geschenk-Hinweis für diese Sitzung schliessen">×</button>
    </div>
    <div class="f30-float f30-float--d" data-f30-float="desktop" data-campaign={cta.campaignId} hidden>
      <a href={cta.targetForm} class="f30-float-pill" data-offer="first30" data-cta-position="floating_desktop" aria-label={`${cta.desktopMain}, ${cta.desktopSub}: zum Anfrageformular`}>
        <span class="f30-float-ic" aria-hidden="true"><Fragment set:html={GIFT_SVG} /></span>
        <span class="f30-float-txt"><span class="f30-float-main">{cta.desktopMain}</span><span class="f30-float-sec">{cta.desktopSub}</span></span>
      </a>
      <button type="button" class="f30-float-x" data-f30-dismiss aria-label="Geschenk-Hinweis für diese Sitzung schliessen">×</button>
    </div>
  </Fragment>
)}

<style>
  /* Tokens: Mint-Fläche + Brand-Black wie der reguläre Hero (public/styles/tokens.css); Karte in Pine/Ivory,
     Akzentgrün für Balken/Checks, Gold/Burgund nur in der kleinen Schleife. */
  .f30-hero {
    --f30-pine: #14532D; --f30-pine-deep: #0E3D21; --f30-accent: #2E9E6B; --f30-ivory: #FFF9F3;
    --f30-gold: #F0CB91; --f30-ox: #541D2B; --f30-mint: var(--brand, #1AE288); --f30-black: var(--brand-black, #020B10);
    --f30-ivory-72: rgba(255, 249, 243, .84); --f30-ivory-18: rgba(255, 249, 243, .18);
    font-family: var(--font-sans);
  }
  .f30-hero .f30-inner { grid-template-areas: 'intro card' 'more card'; grid-template-rows: auto auto; align-content: center; }
  .f30-intro { grid-area: intro; justify-content: flex-end; padding-bottom: 0; }
  .f30-more { grid-area: more; justify-content: flex-start; padding-top: 18px; }
  /* Desktop: left message sits 40px higher against the gift card. Mobile layout is unchanged. */
  @media (min-width: 1024px) { .f30-intro, .f30-more { position: relative; top: -40px; } }
  .f30-right { grid-area: card; align-self: center; padding: clamp(32px, 4vw, 56px) clamp(24px, 4.5vw, 72px) clamp(32px, 4vw, 56px) 0; }
  .f30-hero .lsr-eyebrow { margin-bottom: 12px; }
  .f30-h1 { margin-bottom: 14px; }
  .f30-h2 { display: block; font-size: clamp(20px, 2vw, 28px); font-weight: 700; letter-spacing: -.005em; line-height: 1.2; margin-top: 8px; }
  .f30-h2 em { font-weight: 700; }
  .f30-lead { margin-bottom: 0; }
  .f30-benefits { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 8px; max-width: 54ch; }
  .f30-benefits li { display: flex; align-items: flex-start; gap: 9px; font-size: 15px; font-weight: 600; line-height: 1.4; color: rgba(2, 11, 16, .82); }
  .f30-benefits .lsr-check { flex-shrink: 0; line-height: 1.4; }
  .f30-trustline { font-size: 13px; font-weight: 600; color: rgba(2, 11, 16, .66); margin: 0; }

  /* ── Geschenkkarte ── */
  .f30-card { position: relative; overflow: hidden; max-width: 520px; margin: 0 auto; border-radius: 22px; padding: clamp(20px, 2.1vw, 26px);
    background: var(--f30-pine); color: var(--f30-ivory); border: 1px solid rgba(2, 11, 16, .18);
    box-shadow: 0 24px 60px -24px rgba(2, 11, 16, .45), inset 0 1px 0 rgba(255, 249, 243, .12); }
  .f30-ribbon { position: absolute; top: 18px; right: 18px; z-index: 2; background: var(--f30-gold); color: var(--f30-ox); font-size: 9.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; }
  .f30-card-eyebrow { font-size: 11.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--f30-mint); margin: 0 0 10px; padding-right: 60px; }
  .f30-value { display: flex; flex-direction: column; gap: 4px; margin: 0 0 14px; }
  .f30-value-big { font-size: clamp(26px, 2.3vw, 32px); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; color: var(--f30-ivory); font-variant-numeric: tabular-nums; }
  .f30-value-s { font-size: 14px; font-weight: 600; color: var(--f30-ivory-72); }
  /* Verfügbarkeit: Werte ausschliesslich aus first30.ts; ohne verifizierte Zahl nur das Maximum, kein Balken. */
  .f30-avail { padding: 10px 0; border-top: 1px solid var(--f30-ivory-18); border-bottom: 1px solid var(--f30-ivory-18); margin: 0 0 14px; }
  .f30-avail-h { font-size: 13.5px; font-weight: 700; color: var(--f30-ivory); margin: 0; font-variant-numeric: tabular-nums; line-height: 22px; }
  .f30-avail-ic { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--f30-mint); color: var(--f30-black); vertical-align: top; margin-right: 8px; }
  .f30-avail-ic svg { width: 13px; height: 13px; }
  .f30-avail-n { display: inline-block; min-width: 2ch; text-align: right; color: var(--f30-mint); font-size: 16px; margin-right: 2px; }
  .f30-avail-bar { height: 6px; border-radius: 3px; background: rgba(255, 249, 243, .14); overflow: hidden; margin: 8px 0 6px; }
  .f30-avail-fill { display: block; height: 100%; width: 0; border-radius: 3px; background: linear-gradient(90deg, var(--f30-accent), var(--f30-mint)); transition: width 1.1s cubic-bezier(.2, .8, .2, 1); }
  .f30-avail.is-in .f30-avail-fill { width: var(--f30-pct, 0%); }
  .f30-avail-s { font-size: 12.5px; font-weight: 600; color: var(--f30-ivory-72); margin: 0; }
  @media (prefers-reduced-motion: reduce) { .f30-avail-fill { transition: none; } }

  .f30-body { display: flex; flex-direction: column; gap: 10px; }
  .f30-formwrap { order: 1; }
  .f30-wa { order: 2; display: flex; flex-direction: column; gap: 6px; }
  .f30-form { position: relative; display: flex; flex-direction: column; gap: 10px; }
  .f30-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .f30-label { font-size: 13px; font-weight: 700; color: var(--f30-ivory); margin: 0 0 -4px; }
  .f30-form input[type="tel"] { width: 100%; border: 1px solid rgba(2, 11, 16, .2); border-radius: 12px; padding: 14px 16px; font-size: 18px; line-height: 1.2; min-height: 54px;
    background: var(--f30-ivory); color: var(--f30-black); font-family: inherit; letter-spacing: .02em; }
  .f30-form input::placeholder { color: rgba(2, 11, 16, .45); }
  .f30-form input:focus-visible { outline: 3px solid var(--f30-mint); outline-offset: 2px; }
  .f30-form input[aria-invalid="true"] { outline: 3px solid #FFB3B3; outline-offset: 2px; }
  .f30-ts { min-height: 0; }

  .f30-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 54px; padding: 12px 22px; border: none; border-radius: 100px; cursor: pointer;
    background: var(--f30-mint); color: var(--f30-black); font-family: inherit; font-size: 16.5px; font-weight: 700; letter-spacing: -.005em; line-height: 1.2; text-align: center; text-decoration: none;
    box-shadow: 0 10px 24px -12px rgba(2, 11, 16, .55); transition: background .15s ease, transform .15s ease; }
  .f30-cta:hover { background: var(--brand-hover, #14C97A); transform: translateY(-1px); }
  .f30-cta:active { transform: translateY(0); }
  .f30-cta:focus-visible { outline: 3px solid var(--f30-ivory); outline-offset: 3px; }
  .f30-cta:disabled { cursor: progress; opacity: .85; transform: none; }
  .f30-cta-sub { font-size: 13px; font-weight: 700; text-align: center; color: var(--f30-ivory); margin: 2px 0 0; }
  .f30-cta-sub2 { font-size: 13px; line-height: 1.5; text-align: center; color: var(--f30-ivory-72); margin: 0; }
  .f30-consent { font-size: 12.5px; line-height: 1.55; color: var(--f30-ivory-72); text-align: center; margin: 2px 0 0; }
  .f30-consent a, .f30-alt a, .f30-terms summary { color: var(--f30-ivory); font-weight: 700; text-decoration: underline; text-decoration-color: var(--f30-mint); text-underline-offset: 3px; }
  .f30-consent a:focus-visible, .f30-alt a:focus-visible, .f30-terms summary:focus-visible { outline: 3px solid var(--f30-mint); outline-offset: 2px; border-radius: 4px; }
  .f30-form-err { font-size: 13px; color: #FFD9D9; background: rgba(0, 0, 0, .22); border: 1px solid rgba(255, 217, 217, .4); border-radius: 10px; padding: 8px 10px; line-height: 1.45; margin: 0; }

  /* WhatsApp: mobil primär (Mint), Desktop sekundär (Outline) unter dem Telefonfeld. */
  .f30-cta--wa { flex-direction: column; align-items: stretch; gap: 0; padding: 0; background: transparent; color: var(--f30-ivory); border: 1.5px solid rgba(255, 249, 243, .45); box-shadow: none; font-size: 15px; font-weight: 600; min-height: 48px; }
  .f30-cta--wa:hover { background: rgba(255, 249, 243, .08); border-color: var(--f30-ivory); transform: none; }
  .f30-cta--wa:focus-visible { outline: 3px solid var(--f30-mint); }
  .f30-wa-top { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 10px 18px; }
  .f30-wa-m { display: none; }
  .f30-wa-d { display: inline-flex; align-items: center; gap: 8px; }
  .f30-wa-dic { display: grid; place-items: center; color: #25D366; }
  .f30-wa-dic svg { width: 17px; height: 17px; }
  .f30-or { display: flex; align-items: center; gap: 12px; margin: 6px 0 0; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 249, 243, .55); }
  .f30-or::before, .f30-or::after { content: ''; flex: 1; height: 1px; background: var(--f30-ivory-18); }
  .f30-m { display: none; }
