---
/**
 * CRO location-context layer for generic Therapie/Beschwerde leaves.
 * Location-aware CRO layer for generic Therapie/Beschwerde leaves.
 * St. Gallen is the master behavior; Zürich Bahnhofstrasse/Oerlikon/Höngg use the same flow.
 * Does not change canonical/meta URLs. Keeps existing forms/tracking and only localizes visible UX.
 */
---
<div class="lc-context" data-lc-context hidden>
  <div class="lc-context-inner">
    <div>
      <strong data-lc-title>Behandlung vor Ort</strong>
      <span data-lc-address></span>
    </div>
    <button type="button" data-lc-change>Standort ändern</button>
  </div>
</div>

<style>
  .lc-context{background:#eefbf5;border-bottom:1px solid rgba(2,11,16,.08);font-family:var(--font-sans)}
  .lc-context[hidden]{display:none!important}
  .lc-context-inner{max-width:1180px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .lc-context-inner>div{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
  .lc-context strong{font-size:14px;color:var(--black,#020B10)}
  .lc-context span{font-size:13px;color:var(--muted,#667085)}
  .lc-context button{border:0;background:transparent;color:var(--black,#020B10);font:700 12.5px/1 var(--font-sans);text-decoration:underline;text-underline-offset:3px;cursor:pointer;padding:6px 0}
  @media(max-width:600px){
    .lc-context-inner{padding:9px 16px}
    .lc-context-inner>div{gap:3px}
    .lc-context strong,.lc-context span{width:100%}
  }
</style>

<script is:inline>
(() => {
  const init = () => {
  const VALID = {
    'st-gallen': {
      name: 'St. Gallen',
      formValue: 'St. Gallen',
      address: 'Oberer Graben 22',
      trustName: 'TCM.ch St. Gallen',
      locationHref: '/standorte/st-gallen/'
    },
    'zuerich-bahnhofstrasse': {
      name: 'Zürich Bahnhofstrasse',
      formValue: 'Zürich Bahnhofstrasse',
      address: 'Bahnhofstrasse 37 · 8001 Zürich',
      trustName: 'TCM.ch Zürich Bahnhofstrasse',
      locationHref: '/standorte/zuerich-bahnhofstrasse/'
    },
    'zuerich-oerlikon': {
      name: 'Zürich Oerlikon',
      formValue: 'Zürich Oerlikon',
      address: 'Ohmstrasse 14 · 8050 Zürich',
      trustName: 'TCM.ch Zürich Oerlikon',
      locationHref: '/standorte/zuerich-oerlikon/'
    },
    'zuerich-hoengg': {
      name: 'Zürich Höngg',
      formValue: 'Zürich Höngg',
      address: 'Limmattalstrasse 340 · 8049 Zürich',
      trustName: 'Praxis Hwang Zürich Höngg',
      locationHref: '/standorte/zuerich-hoengg/'
    }
  };
  const qs = new URLSearchParams(location.search);
  const explicit = qs.get('standort');
  let id = explicit && VALID[explicit] ? explicit : null;

  if (id) {
    try { sessionStorage.setItem('tcm_location_context', id); } catch (_) {}
  } else {
    try {
      const saved = sessionStorage.getItem('tcm_location_context');
      if (saved && VALID[saved]) id = saved;
    } catch (_) {}
  }
  if (!id) return;

  const ctx = VALID[id];
  document.documentElement.dataset.locationContext = id;

  const apply = () => {
  const bar = document.querySelector('[data-lc-context]');
  if (bar) {
    bar.hidden = false;
    const title = bar.querySelector('[data-lc-title]');
    if (title) title.textContent = 'Behandlung in ' + ctx.name;
    const address = bar.querySelector('[data-lc-address]');
    if (address) address.textContent = ctx.address + ' · ' + ctx.trustName;
    if (!bar.dataset.lcBound) {
      bar.dataset.lcBound = '1';
      bar.querySelector('[data-lc-change]')?.addEventListener('click', () => {
      try { sessionStorage.removeItem('tcm_location_context'); } catch (_) {}
        location.href = '/standorte/';
      });
    }
  }

  const push = (event, extra={}) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event, standort: id, source_path: location.pathname, ...extra });
  };
  if (!document.documentElement.dataset.lcViewPushed) {
    document.documentElement.dataset.lcViewPushed = '1';
    push('location_context_view');
  }

  // Localize the visible page context without touching canonical/meta/schema.
  const therapyPage = document.getElementById('page-therapie');
  const symptomPage = document.getElementById('page-symptom');
  const h1 =
    document.querySelector('#therapie-premium-hero h1, #symptom-premium-hero h1, .tsr-h1, .sx-h1') ||
    (therapyPage || symptomPage)?.querySelector('h1');
  if (h1 && !h1.dataset.lcDone) {
    h1.dataset.lcDone = '1';
    const raw = h1.textContent?.replace(/\s+/g,' ').trim() || '';
    const base = raw
      .replace(/\s*TCM\.ch Schweiz\s*$/i,'')
      .replace(/\s*in (?:St\. Gallen|Zürich Bahnhofstrasse|Zürich Oerlikon|Zürich Höngg)\s*$/i,'')
      .trim();
    if (base) {
      h1.textContent = base + ' in ' + ctx.name;
      const eyebrow = (therapyPage || symptomPage)?.querySelector('.tsr-eyebrow,.sx-eyebrow');
      if (eyebrow) eyebrow.textContent = base + ' · TCM.ch ' + ctx.name;
      const lead = (therapyPage || symptomPage)?.querySelector('.tsr-lead,.sx-lead');
      if (lead) {
        lead.textContent = (lead.textContent || '')
          .replace(/EMR-\/ASCA-registrierte Therapeut:innen in Zürich, Winterthur, St\. Gallen, Frauenfeld und Basel\.?/i,
            'EMR-/ASCA-registrierte Therapeut:innen vor Ort: ' + ctx.address + '.');
      }
    }
    h1.dataset.lcDone = '1';
  }

  const primaryHero =
    document.querySelector('#therapie-premium-hero .btn-primary, #symptom-premium-hero .btn-primary, .tsr-btn-primary, .sx-btn-primary') ||
    therapyPage?.querySelector('.tsr-btn-primary') ||
    symptomPage?.querySelector('.btn-primary, .sx-btn-primary, button[onclick*="Contact"], button[onclick*="contact"]');
  if (primaryHero) {
    const t = primaryHero.textContent?.trim() || '';
    if (/anfragen|behandlung|termin/i.test(t)) primaryHero.textContent = 'Termin in ' + ctx.name + ' anfragen';
  }

  // Keep the exact originating clinic through all therapy/complaint navigation.
  const contextualizeHref = (a) => {
    try {
      const u = new URL(a.href, location.origin);
      if (u.origin !== location.origin) return;
      if (!/^\/(therapien|beschwerden)\//.test(u.pathname)) return;
      u.searchParams.set('standort', id);
      a.href = u.pathname + u.search + u.hash;
    } catch (_) {}
  };
  document.querySelectorAll('a[href]').forEach(contextualizeHref);

  // Legacy captured leaves contain onclick="nav('therapie'|'symptom', slug)".
  document.addEventListener('click', (e) => {
    const el = e.target?.closest?.('[onclick*="nav(\'therapie\'"],[onclick*="nav(\'symptom\'"]');
    if (!el) return;
    const oc = el.getAttribute('onclick') || '';
    const m = oc.match(/nav\(['"](therapie|symptom)['"]\s*,\s*['"]([^'"]+)['"]\)/);
    if (!m) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    const root = m[1] === 'therapie' ? 'therapien' : 'beschwerden';
    location.href = '/' + root + '/' + m[2] + '/?standort=' + encodeURIComponent(id);
  }, true);

  // Match the location-page offer flow: Gratis Check-in first and preselected.
  document.querySelectorAll('[data-kf]').forEach((card) => {
    const opts = card.querySelector('.kf-opts');
    const checkin = opts?.querySelector('.kf-opt--checkin');
    const behandlung = opts?.querySelector('.kf-opt--behandlung');
    if (opts && checkin && behandlung && opts.firstElementChild !== checkin) {
      opts.insertBefore(checkin, behandlung);
    }
    const checkinRadio = card.querySelector('input[name="terminart"][value="checkin"]');
    if (checkinRadio && !checkinRadio.disabled && !checkinRadio.checked) {
      checkinRadio.checked = true;
      checkinRadio.dispatchEvent(new Event('change', { bubbles: true }));
    }
    card.setAttribute('data-kf-default', 'checkin');
  });

  // Lock every generic inline contact form on the leaf to the originating clinic.
  document.querySelectorAll('.inline-form, form').forEach((form) => {
    const sel = form.querySelector('select[name="standort"]');
    if (!sel || sel.dataset.lcLocked) return;
    const options = Array.from(sel.options);
    const opt = options.find(o => o.getAttribute('data-id') === id) || options.find(o => (o.value || o.textContent || '').trim() === ctx.formValue);
    if (!opt) return;
    sel.value = opt.value;
    sel.dataset.lcLocked = '1';
    sel.dispatchEvent(new Event('change', { bubbles: true }));
    sel.disabled = true;

    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'standort';
    hidden.value = opt.value;
    hidden.dataset.lcHidden = '1';
    form.appendChild(hidden);

    const group = sel.closest('.form-group,.kf-field');
    if (group) group.hidden = true;

    const card = form.closest('.inline-form-card,[data-kf]');
    const title = card?.querySelector('.inline-form-title,[data-kf] h2,[data-kf] h3');
    if (title && /Behandlung|Hilfe|Termin|Anfrage/i.test(title.textContent || '')) {
      title.textContent = 'Termin in ' + ctx.name + ' anfragen';
    }

    push('location_context_form_prefill', { form_type: form.className || 'form' });
  });

  // Localize the contact section around the generic form.
  document.querySelectorAll('.contact-section-inline,[data-kf]').forEach((section) => {
    const heading = section.querySelector('.section-title');
    const sub = section.querySelector('.section-sub');
    if (heading) heading.innerHTML = 'Termin in <em>' + ctx.name + '</em> anfragen.';
    if (sub) sub.textContent = 'Deine Anfrage geht direkt an den Standort ' + ctx.name + '.';
  });


  document.querySelectorAll('.intake-trust-item').forEach((el) => {
    const t = (el.textContent || '').trim();
    if (/Passende Praxis statt langem Suchen/i.test(t)) el.innerHTML = '<span class="intake-trust-dot"></span>Direkt an ' + ctx.trustName;
    if (/Standorte in der Deutschschweiz/i.test(t)) el.innerHTML = '<span class="intake-trust-dot"></span>' + ctx.address;
  });

  document.querySelectorAll('.subpage-sidebar').forEach((sidebar) => {
    const head = sidebar.querySelector('div[style*="text-transform:uppercase"]');
    if (head && /Termin anfragen/i.test(head.textContent || '')) head.textContent = 'Termin in ' + ctx.name;
  });

  // Location is already known: remove the generic all-locations section entirely.
  document.querySelectorAll('#therapie-cities-section, #symptom-cities-section').forEach((section) => {
    section.hidden = true;
    section.setAttribute('aria-hidden', 'true');
  });

  document.querySelectorAll('.cta-band h2, #symptom-cta-title').forEach((el) => {
    const txt = el.textContent || '';
    if (/Termin|Praxis|behandeln|anfragen/i.test(txt)) el.textContent = 'Termin in ' + ctx.name + ' anfragen';
  });

  // Make generic location-finder buttons preserve the chosen location instead of reopening routing.
  document.querySelectorAll('button[onclick*="nav(\'standorte\')"],a[href="/standorte/"]').forEach((el) => {
    if (el.tagName === 'A') el.setAttribute('href', ctx.locationHref);
    else {
      el.removeAttribute('onclick');
      const isLocationLabel = /Standort finden|Standort wählen|Praxis .* ansehen|Termin in .* anfragen/i.test(el.textContent || '');
      if (isLocationLabel) {
        const inHero = !!el.closest('#therapie-premium-hero,#symptom-premium-hero,.tsr-hero,.sx-hero');
        el.textContent = inHero ? 'Praxis ' + ctx.name + ' ansehen' : 'Praxis ' + ctx.name;
        if (!el.dataset.lcBound) {
          el.dataset.lcBound = '1';
          el.addEventListener('click', (ev) => {
            ev.preventDefault();
            location.href = ctx.locationHref;
          });
        }
      }
    }
  });
  };

  apply();
  requestAnimationFrame(() => apply());
  setTimeout(apply, 150);
  window.addEventListener('load', apply, { once: true });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
})();
</script>
