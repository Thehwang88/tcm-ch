---
import { NETWORK, type PartnerMarket } from '../../data/partner-markets';
interface Props { market: PartnerMarket }
const { market } = Astro.props;

// Orbit geometry (SVG units). Ellipses use the width better than circles.
const W = 820, H = 620, CX = W / 2, CY = H / 2;
const RING = { A: { rx: 238, ry: 188 }, B: { rx: 350, ry: 270 } };
const nodes = NETWORK.map((n, idx) => {
  const r = RING[n.tier];
  const a = (n.angle * Math.PI) / 180;
  const x = CX + r.rx * Math.cos(a);
  const y = CY + r.ry * Math.sin(a);
  const focus = n.id === market.nodeId;
  const anchor = focus ? 'middle' : Math.cos(a) > 0.3 ? 'start' : Math.cos(a) < -0.3 ? 'end' : 'middle';
  const dx = anchor === 'start' ? 14 : anchor === 'end' ? -14 : 0;
  const dy = focus ? -24 : anchor === 'middle' ? (Math.sin(a) < 0 ? -16 : 24) : 5;
  return { ...n, x, y, anchor, dx, dy, focus, idx };
});
const focus = nodes.find((n) => n.focus)!;
const statusText = { active: 'aktiv', planned: 'geplant', available: 'offen' } as const;
const primary = nodes.filter((n) => n.tier === 'A');
---
<section class="pp-ch pp-net" id="kapitel-3" data-chapter>
  <div class="pp-wrap">
    <p class="pp-label">{market.city}</p>
    <h2 class="pp-h2 pp-reveal">Ein Netzwerk.<br />Ein Platz in {market.city}.</h2>

    <div class="pn" data-inview>
      <svg class="pn__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <ellipse class="pn__orbit" cx={CX} cy={CY} rx={RING.A.rx} ry={RING.A.ry} />
        {primary.filter((n) => !n.focus).map((n) => (
          <line class="pn__spoke" x1={CX} y1={CY} x2={n.x} y2={n.y} />
        ))}
        <line class="pn__spoke pn__spoke--focus" x1={CX} y1={CY} x2={focus.x} y2={focus.y} pathLength="1" />
        <circle class="pn__core" cx={CX} cy={CY} r="34" />
        <text class="pn__core-t" x={CX} y={CY + 5} text-anchor="middle">TCM.ch</text>
        {nodes.map((n) => (
          <g class={`pn__node pn__node--${n.tier} is-${n.status}${n.focus ? ' is-focus' : ''}`} style={`--d:${n.idx}`}>
            {n.focus && <circle class="pn__pulse" cx={n.x} cy={n.y} r="12" />}
            <circle class="pn__dot" cx={n.x} cy={n.y} r={n.focus ? 10 : n.tier === 'A' ? 6 : 3.5} />
            <text x={n.x + n.dx} y={n.y + n.dy} text-anchor={n.anchor}>{n.focus ? n.name.toUpperCase() : n.name}</text>
          </g>
        ))}
      </svg>

      <!-- Mobile: lesbare Liste statt Orbit -->
      <ul class="pn__list">
        {[...primary].sort((a, b) => Number(b.focus) - Number(a.focus)).map((n) => (
          <li class={n.focus ? 'is-focus' : `is-${n.status}`}><span class="pn__d"></span>{n.name}<em>{n.focus ? market.statusLabel : statusText[n.status]}</em></li>
        ))}
      </ul>
    </div>

    <div class="bn">
      <p class="bn__city pp-reveal">{market.city}</p>
      <p class="bn__status pp-reveal">{market.statusLabel}</p>
      <p class="bn__note pp-reveal">
        {market.leadPartnerNote}
        <button type="button" class="pp-info" aria-expanded="false" aria-controls="bn-info" data-info><span aria-hidden="true">i</span><span class="pp-sr">Hinweis zum Partnergebiet</span></button>
      </p>
      <p class="pp-fine" id="bn-info" hidden>
        Vorgesehen heisst: Wir entwickeln {market.city} mit einem lokalen Hauptpartner. Eine dauerhafte oder
        unbedingte Gebietsexklusivität ist damit nicht zugesagt; Details regelt die Partnervereinbarung.
        Die Karte ist eine interne strategische Übersicht, keine externe Rangliste.
      </p>
      <p class="pp-lead pp-reveal">Wir suchen nicht möglichst viele Partner in {market.city}. Wir suchen den richtigen lokalen Unternehmer, mit dem wir den Standort entwickeln.</p>
      <div class="pp-actions pp-reveal"><a class="pp-link" href="#kapitel-4">TCM.ch {market.city} ansehen <span aria-hidden="true">↓</span></a></div>
      <p class="pn__legend x-only"><span class="lg lg--active">aktiv</span><span class="lg lg--planned">geplant</span><span class="lg lg--available">offen</span></p>
    </div>
  </div>
</section>
