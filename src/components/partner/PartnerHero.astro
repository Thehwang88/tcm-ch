---
import type { PartnerMarket } from '../../data/partner-markets';
interface Props { market: PartnerMarket }
const { market } = Astro.props;
---
<section class="pp-ch pp-hero" id="kapitel-1" data-chapter>
  <div class="pp-wrap">
    <p class="pp-label"><span class="nc">TCM.ch</span> Partner · {market.city}</p>
    <h1 class="pp-display pp-reveal">
      Deine Praxis.<br />
      Unsere Plattform.<br />
      <span class="pp-accent">Gemeinsam wachsen.</span>
    </h1>
    <p class="pp-lead pp-reveal">
      Baue TCM.ch {market.city} als lokaler Partner auf – mit der Freiheit einer eigenen Praxis
      und dem System einer starken Plattform im Hintergrund.
    </p>
    <div class="pp-actions pp-reveal">
      <a class="pp-btn" href="#kapitel-2">{market.city} entdecken <span aria-hidden="true">↓</span></a>
    </div>

    <!-- TCM.ch → Bern: eine einzige Verbindung -->
    <svg class="hv" viewBox="0 0 360 64" data-inview role="img" aria-label={`TCM.ch verbunden mit ${market.city}`}>
      <circle class="hv__core" cx="12" cy="24" r="7" />
      <line class="hv__line" x1="26" y1="24" x2="326" y2="24" pathLength="1" />
      <circle class="hv__city" cx="340" cy="24" r="9" />
      <text x="5" y="58">TCM.ch</text>
      <text class="hv__city-t" x="349" y="58" text-anchor="end">{market.city}</text>
    </svg>
  </div>
</section>
