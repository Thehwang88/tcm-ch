---
import type { PartnerMarket } from '../../data/partner-markets';
import { formatCHF } from '../../lib/partner-economics';
interface Props { market: PartnerMarket }
const { market } = Astro.props;
const m = market.model;
const months = Array.from({ length: m.launchMonths }, (_, i) => i + 1);
const total = m.launchMonthlyAdBudget * m.launchMonths;
const pct = Math.round(m.marketingShare * 100);
---
<!-- Teil von Kapitel 04 (Start klein), daher kein eigenes data-chapter -->
<section class="pp-ch pp-launch" id="launch">
  <div class="pp-wrap">
    <p class="pp-label">{m.launchMonths * 30}-Tage-Launch</p>
    <p class="ln__big pp-reveal">{formatCHF(total)}</p>
    <p class="ln__sub pp-reveal">{formatCHF(m.launchMonthlyAdBudget)} × {m.launchMonths} Monate</p>

    <ol class="ln__tl" data-inview>
      {months.map((n) => (
        <li style={`--i:${n - 1}`}><span>Monat {n}</span><b>{formatCHF(m.launchMonthlyAdBudget)}</b></li>
      ))}
    </ol>

    <p class="pp-h3 pp-reveal">100 % Launch-Marketing für TCM.ch {market.city}.</p>
    <p class="pp-fine">Keine Eintritts- oder Franchisegebühr.</p>

    <div class="ln__after pp-reveal">
      <p class="pp-label">Danach</p>
      <p class="ln__rule"><span class="pp-accent">{pct} %</span> des Standortumsatzes<br />finanziert Marketing & Wachstum.</p>
    </div>

    <details class="pp-more" data-explore-open>
      <summary>Wie funktioniert das? <span aria-hidden="true">→</span></summary>
      <div class="pp-more__body">
        <p class="pp-p">Die {formatCHF(total)} sind standortbezogenes Werbebudget für die Nachfrage in {market.city}, kein Preis für den Zugang zu TCM.ch.</p>
        <p class="pp-p">TCM.ch bringt das System ein: Setup, Kampagnen, Standortseite, Tracking, Lead Management, Terminadministration, Marke und Technologie.</p>
        <p class="pp-p">Ab Monat {m.launchMonths + 1} wird das Wachstumsbudget zentral nach Partnermodell gesteuert und je nach Bedarf eingesetzt oder reserviert. Bei entsprechender Nachfrage kann sich das laufende Marketing zunehmend aus dem Standortgeschäft tragen.</p>
      </div>
    </details>
  </div>
</section>
