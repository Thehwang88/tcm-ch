---
import type { PartnerMarket } from '../../data/partner-markets';
import PartnerNextSteps from './PartnerNextSteps.astro';
interface Props { market: PartnerMarket }
const { market } = Astro.props;
const wa = `https://wa.me/${market.contact.whatsapp}?text=${encodeURIComponent(market.contact.message)}`;
---
<section class="pp-ch pp-end" id="kapitel-9" data-chapter>
  <div class="pp-wrap">
    <!-- Sitzungs-Zusammenfassung aus den aktuellen Simulatorwerten (nichts wird gespeichert) -->
    <div class="sum pp-reveal">
      <p class="pp-label">Dein Modell</p>
      <p class="sum__city" data-who>{market.city}</p>
      <p class="sum__vals"><span data-v="days"></span> / Woche · <span data-v="patients"></span> Patienten / Tag · <span data-v="util"></span> Auslastung</p>
      <p class="sum__v" data-out="revenue"></p>
      <p class="sum__l">simulierter Standortumsatz / Monat</p>
      <p class="pp-p sum__note">Das ist kein Versprechen. Es ist der Ausgangspunkt für unser gemeinsames Gespräch.</p>
    </div>

    <PartnerNextSteps />

    <div class="fin">
      <p class="pp-label"><span class="nc">TCM.ch</span> · {market.city}</p>
      <h2 class="pp-display pp-reveal">Lass uns herausfinden,<br />ob wir das <span class="pp-accent">gemeinsam</span> bauen.</h2>
      <p class="pp-lead pp-reveal">Eine starke lokale Praxis. Unterstützt durch eine nationale Plattform.</p>
      <div class="pp-actions pp-reveal">
        <a class="pp-btn" href={wa} target="_blank" rel="noopener">{market.city} gemeinsam prüfen <span aria-hidden="true">→</span></a>
        <a class="pp-link" href="#kapitel-5">Simulation nochmals öffnen</a>
      </div>
      <img class="fin__mark" src="/images/logo/tcm-kliniken-logo-wordmark.svg" alt="TCM.ch" width="82" height="40" loading="lazy" />
    </div>
  </div>
</section>
