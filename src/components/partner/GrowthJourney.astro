---
import type { PartnerMarket } from '../../data/partner-markets';
import RoomTile from './RoomTile.astro';
interface Props { market: PartnerMarket }
const { market } = Astro.props;
const stages = [
  { t: 'Micro', l: '1 Raum · Inhaber:in', s: 'indikativ ~CHF 15–25k+ / Monat' },
  { t: 'Partnerklinik', l: '2–3 Räume · Inhaber:in + lokales Team', s: 'indikativ ~CHF 30–75k+ / Monat' },
  { t: 'Lokales Flagship', l: 'Nur wenn die Nachfrage es trägt', s: '' },
];
---
<section class="pp-ch pp-growth" id="kapitel-8" data-chapter>
  <div class="pp-wrap">
    <p class="pp-label">Wachstum</p>
    <h2 class="pp-h2 pp-reveal">Was passiert, wenn {market.city} funktioniert?</h2>

    <div class="gr" data-grow>
      <div class="gr__rooms">
        <RoomTile label="Heute" sub="1 Raum · du" />
        <RoomTile label="Raum 2" sub="angestellte Therapeut:in" variant="team" attrs={{ 'data-room2-tile': '', hidden: '' }} />
      </div>
      <div class="gr__side">
        <p class="gr__v"><span data-out="revenue"></span></p>
        <p class="gr__l">möglicher Standortumsatz / Monat · Modellrechnung</p>
        <button type="button" class="pp-btn pp-btn--ghost" data-add-therapist aria-pressed="false">+ Therapeut:in hinzufügen</button>
      </div>
    </div>

    <div class="org" data-struct hidden>
      <ol class="org__chain">
        <li><span class="nc">TCM.ch</span></li>
        <li class="is-green">Partnerfirma {market.city}</li>
        <li>Du <span class="pp-muted">+</span> angestellte Therapeut:in</li>
      </ol>
      <p class="pp-p">Neue Therapeut:innen werden von der lokalen Partnerfirma beschäftigt – nicht von TCM.ch.<br />TCM.ch unterstützt Recruiting, Nachfrage, Systeme und Wachstum.</p>
    </div>

    <p class="pp-statement gr__claim pp-reveal">Du skalierst nicht deine Arbeitszeit.<br /><span class="pp-accent">Du skalierst deine Praxis.</span></p>

    <ol class="gj" data-inview>
      {stages.map((s, i) => (
        <li style={`--i:${i}`}>
          <span class="gj__n">{String(i + 1).padStart(2, '0')}</span>
          <b>{s.t}</b>
          <small>{s.l}</small>
          {s.s && <small class="gj__s x-only">{s.s}</small>}
        </li>
      ))}
    </ol>
    <p class="pp-fine x-only">Mögliche Entwicklung, kein Automatismus.</p>
  </div>
</section>
