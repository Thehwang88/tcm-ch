---
import { SCENARIOS, BASE_ASSUMPTIONS, type PartnerMarket } from '../../data/partner-markets';
import { formatCHF } from '../../lib/partner-economics';
interface Props { market: PartnerMarket }
const { market } = Astro.props;
const days = ['Mo', 'Di', 'Mi', 'Do', 'Fr'];
const MAX_SLOTS = 15;
const config = { model: market.model, assumptions: BASE_ASSUMPTIONS, scenarios: SCENARIOS, defaultScenario: market.defaultScenario };

const advanced = [
  { key: 'rentPerRoom', label: 'Raummiete pro Raum / Monat' },
  { key: 'materialCosts', label: 'Material / Monat' },
  { key: 'otherOperatingCosts', label: 'Weitere lokale Kosten / Monat' },
  { key: 'ownSocialCosts', label: 'Eigene Sozialabgaben & Vorsorge' },
  { key: 'employeeFullCostFullTime', label: 'Vollkosten Anstellung bei 100 %' },
  { key: 'centralOpsCost', label: 'Zentrale TCM.ch Betriebskosten (Beispiel)' },
  { key: 'targetPartnerResult', label: 'Wunsch-Ergebnis Partnerfirma' },
];
---
<section class="pp-ch pp-sim" id="kapitel-5" data-chapter>
  <div class="pp-wrap" id="sim" data-sim={JSON.stringify(config)}>
    <p class="pp-label pp-label--green" data-who>{market.city}</p>
    <h2 class="pp-h2 pp-reveal">Wie möchtest du arbeiten?</h2>

    <div class="ps-scen" role="radiogroup" aria-label="Szenario">
      {SCENARIOS.map((s) => (
        <button type="button" role="radio" data-scenario={s.key} aria-checked={s.key === market.defaultScenario ? 'true' : 'false'}>{s.label}</button>
      ))}
      <button type="button" role="radio" data-scenario="eigene" aria-checked="false">Eigene Werte</button>
    </div>

    <div class="ps">
      <div class="ps__controls">
        <!-- Hero-Control -->
        <div class="hc">
          <label for="in-pat">Patienten / Tag</label>
          <div class="hc__row">
            <button type="button" class="hc__step" data-step="-1" aria-label="Ein:e Patient:in weniger">−</button>
            <output data-v="patients" for="in-pat"></output>
            <button type="button" class="hc__step" data-step="1" aria-label="Ein:e Patient:in mehr">+</button>
          </div>
          <p class="hc__word" data-v="rhythm"></p>
          <input id="in-pat" type="range" min="4" max="15" step="1" data-in="patientsPerDay" />
        </div>

        <p class="ps-assume">
          <span data-v="days"></span> · <span data-v="util"></span> Auslastung · <span data-v="rev"></span> / Behandlung
          <button type="button" class="pp-link pp-link--sm" data-more-toggle aria-expanded="false" aria-controls="ps-more">Anpassen</button>
        </p>

        <div class="ps-more" id="ps-more">
          <div class="ctl">
            <label for="in-days">Arbeitstage / Woche</label>
            <output data-v="days" for="in-days"></output>
            <input id="in-days" type="range" min="3" max="5" step="1" data-in="workdaysPerWeek" />
          </div>
          <div class="ctl">
            <label for="in-util">Auslastung</label>
            <output data-v="util" for="in-util"></output>
            <input id="in-util" type="range" min="50" max="100" step="5" data-in="utilization" data-scale="100" />
          </div>
          <div class="ctl">
            <label for="in-rev">Ø Umsatz / Behandlung</label>
            <span class="ctl__num">CHF <input id="in-rev-n" type="number" min="60" max="300" step="1" inputmode="numeric" data-in="avgRevenuePerTreatment" aria-label="Ø Umsatz pro Behandlung in CHF" /></span>
            <input id="in-rev" type="range" min="100" max="220" step="1" data-in="avgRevenuePerTreatment" />
          </div>
        </div>

        <details class="ps-adv x-only" data-adv>
          <summary>Weitere Annahmen</summary>
          <p class="pp-fine">Leer = noch nicht definiert. Wir rechnen keine Kosten, die du nicht siehst.</p>
          <div class="ps-adv__grid">
            <div class="ctl ctl--sm">
              <label for="in-d2">Pensum Therapeut:in 2</label>
              <output data-v="days2" for="in-d2"></output>
              <input id="in-d2" type="range" min="1" max="5" step="1" data-in="secondTherapistDays" />
            </div>
            {advanced.map((a) => (
              <label class="fld">
                <span>{a.label}</span>
                <span class="fld__in">CHF <input type="number" min="0" step="50" inputmode="numeric" placeholder="–" data-in={a.key} /></span>
              </label>
            ))}
          </div>
          <p class="pp-fine">Zentrale Kosten: Beispielannahme {formatCHF(BASE_ASSUMPTIONS.centralOpsCost)}, noch nicht validiert.</p>
        </details>
      </div>

      <div class="ps__visual" aria-hidden="true">
        <p class="pp-label">Deine verfügbare Kapazität</p>
        <div class="clinic" data-clinic>
          <div class="cal" data-cal="1">
            {days.map((d, di) => (
              <div class="cal__col" data-col={di}>
                <span class="cal__d">{d}</span>
                <div class="cal__slots">{Array.from({ length: MAX_SLOTS }, (_, si) => <i data-slot={si}></i>)}</div>
              </div>
            ))}
          </div>
          <div class="cal-2" data-room2 hidden>
            <p class="cal-2__t">Raum 2 · Therapeut:in</p>
            <div class="cal" data-cal="2">
              {days.map((d, di) => (
                <div class="cal__col" data-col={di}>
                  <div class="cal__slots">{Array.from({ length: MAX_SLOTS }, (_, si) => <i data-slot={si}></i>)}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <p class="clinic__sum"><b data-out="treatments"></b> Behandlungen / Monat</p>
      </div>
    </div>
    <p class="ps-claim pp-reveal">Du stellst Kapazität bereit.<br /><span class="pp-muted">Gemeinsam arbeiten wir daran, sie zu füllen.</span></p>

    <div class="res">
      <span class="res__v" data-out="revenue"></span>
      <span class="res__l">möglicher Standortumsatz / Monat</span>
      <details class="res__note">
        <summary>Modellrechnung <span class="pp-info" aria-hidden="true">i</span></summary>
        <p class="pp-fine">Modellrechnung zur Veranschaulichung, kein Versprechen. Tatsächliche Umsätze, Kosten und Ergebnisse hängen unter anderem von Nachfrage, Auslastung, Standort, Kostenstruktur und individueller Tätigkeit ab. Berechnung: Arbeitstage × Patienten/Tag × 4 Wochen × Auslastung × Ø Umsatz.</p>
      </details>
      <p class="res__split x-only">Partnerfirma <b data-out="partner"></b><span>·</span>TCM.ch Systemanteil <b data-out="platform"></b></p>
      <ul class="ms x-only" data-milestones aria-label="Meilensteine"></ul>
      <p><a class="pp-link" href="#kapitel-6">Wie wird das verteilt? <span aria-hidden="true">↓</span></a></p>
    </div>
  </div>
</section>
