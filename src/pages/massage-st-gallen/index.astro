---
// /massage-st-gallen — City-Landingpage für "massage st gallen". Reuses SpaPage,
// InsuranceBanner und die geteilten .msg-* Styles. Lokale Entität mit NAP-Schema.
import SpaPage from '../../layouts/SpaPage.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../components/MassageAnfrageForm.astro';
import bodyRaw from '../../data/massage-st-gallen-body.html?raw';
import css from '../../data/massage-city.css?raw';

const [heroPart, restPart] = bodyRaw.split('<!--BANNER-->');

const url = 'https://tcm.ch/massage-st-gallen/';
const title = 'Massage St. Gallen | Medizinische Massage – TCM.ch';
const description = 'Massage in St. Gallen, medizinisch oder zur Entspannung. EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar. Zentral am Oberen Graben.';

const faqs = [
  { q: 'Wo in St. Gallen findet die Massage statt?', a: 'In unserer Praxis am Oberen Graben 22, mitten im Zentrum von St. Gallen. Sie ist zu Fuss aus der Altstadt und mit Bus und Bahn bequem erreichbar.' },
  { q: 'Übernimmt die Krankenkasse die Massage?', a: 'Medizinische Massagen bei unseren EMR- und ASCA-anerkannten Therapeut:innen trägt die Zusatzversicherung in der Regel mit, meist zu 50 bis 90 Prozent. Die Grundversicherung übernimmt keine Massagen, Wellness-Massagen sind Selbstzahlerleistungen.' },
  { q: 'Brauche ich eine ärztliche Verordnung?', a: 'Nein. Für die Abrechnung über die Zusatzversicherung reicht, dass die Behandlung bei einer anerkannten Fachperson stattfindet. Eine Verordnung vom Arzt brauchst du nicht.' },
  { q: 'Behandelt ihr auch Menschen aus der Region?', a: 'Ja, gerne. Zu uns kommen Patient:innen aus ganz St. Gallen und der Ostschweiz, etwa aus Gossau, Wittenbach, Herisau und dem Appenzellerland. Die zentrale Lage macht uns aus der ganzen Region gut erreichbar.' },
  { q: 'Wie schnell bekomme ich einen Termin?', a: 'Meist innert 24 bis 48 Stunden. Am schnellsten geht die Anfrage per WhatsApp oder Telefon, dann melden wir uns mit einem passenden Vorschlag zurück.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'MedicalBusiness', name: 'TCM.ch Massage St. Gallen', url,
    address: { '@type': 'PostalAddress', streetAddress: 'Oberer Graben 22', postalCode: '9000', addressLocality: 'St. Gallen', addressCountry: 'CH' },
    telephone: '+41775236122', openingHours: ['Mo-Fr 07:30-19:30', 'Sa 07:30-16:30'],
    areaServed: { '@type': 'City', name: 'St. Gallen' }, medicalSpecialty: 'PhysicalTherapy' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 3, name: 'Massage St. Gallen', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/massage-st-gallen" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="St. Gallen" />
  <Fragment set:html={restPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="massage-st-gallen" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
