---
// Private partner presentation, e.g. /partner/bern/. noindex, nofollow; not linked
// from public nav; excluded from sitemap.xml (gen-sitemap skips noindex pages).
// New market = new entry in src/data/partner-markets.ts.
// Modes: ?modus=praesentation (story, minimal UI) · default Entdecken (full simulator).
import PartnerLayout from '../../layouts/PartnerLayout.astro';
import PartnerHero from '../../components/partner/PartnerHero.astro';
import PartnerWhy from '../../components/partner/PartnerWhy.astro';
import PartnerNetwork from '../../components/partner/PartnerNetwork.astro';
import PartnerStart from '../../components/partner/PartnerStart.astro';
import PartnerLaunch from '../../components/partner/PartnerLaunch.astro';
import ClinicSimulator from '../../components/partner/ClinicSimulator.astro';
import MoneyFlow from '../../components/partner/MoneyFlow.astro';
import PartnerSystem from '../../components/partner/PartnerSystem.astro';
import GrowthJourney from '../../components/partner/GrowthJourney.astro';
import PartnerCTA from '../../components/partner/PartnerCTA.astro';
import { PARTNER_MARKETS, type PartnerMarket } from '../../data/partner-markets';

export function getStaticPaths() {
  return Object.values(PARTNER_MARKETS).map((market) => ({ params: { city: market.slug }, props: { market } }));
}
const { market } = Astro.props as { market: PartnerMarket };

const chapters = [
  { id: 'kapitel-1', label: 'Die Chance' },
  { id: 'kapitel-2', label: 'Warum TCM.ch' },
  { id: 'kapitel-3', label: market.city },
  { id: 'kapitel-4', label: 'Klein starten' },
  { id: 'kapitel-5', label: 'Deine Praxis' },
  { id: 'kapitel-6', label: 'Die Zahlen' },
  { id: 'kapitel-7', label: 'Das System' },
  { id: 'kapitel-8', label: 'Wachstum' },
  { id: 'kapitel-9', label: `${market.city} bauen` },
];
---
<PartnerLayout
  title={`TCM.ch ${market.city} · Partner`}
  description={`Private Partner-Präsentation: TCM.ch ${market.city} als lokaler Partner aufbauen.`}
  chapters={chapters}
>
  <PartnerHero market={market} />
  <PartnerWhy />
  <PartnerNetwork market={market} />
  <PartnerStart market={market} />
  <PartnerLaunch market={market} />
  <ClinicSimulator market={market} />
  <MoneyFlow market={market} />
  <PartnerSystem market={market} />
  <GrowthJourney market={market} />
  <PartnerCTA market={market} />
</PartnerLayout>

<script>
  import '../../scripts/partner-page';
</script>
