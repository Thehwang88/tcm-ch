---
// /partner/ — Partnerschaft für bestehende Praxen & lokale Unternehmer:innen (B2B).
// Bis 09/2026 war hier die Karriere-/Bewerbungsseite; diese lebt jetzt unter /karriere/.
// Private Stadt-Präsentationen (/partner/[city]/) bleiben noindex und werden hier NICHT verlinkt.
import LayoutDe from '../../layouts/LayoutDe.astro';
import B2bPrinciples from '../../components/b2b/B2bPrinciples.astro';
import B2bOperatingSystem from '../../components/b2b/B2bOperatingSystem.astro';
import B2bJourney from '../../components/b2b/B2bJourney.astro';
import B2bGrowth from '../../components/b2b/B2bGrowth.astro';
import PartnerLeadForm from '../../components/b2b/PartnerLeadForm.astro';
import { site } from '../../data/site';
import { B2B_LINKS } from '../../data/b2b';
import '../../styles/b2b.css';

const path = '/partner';
const url = new URL(path + '/', site.url).href;
const title = 'TCM Partner werden: Deine Praxis mit TCM.ch aufbauen';
const description =
  'Für TCM-Therapeut:innen und bestehende Praxen: lokale Praxis führen, während TCM.ch Marketing, Nachfrage, Technologie und zentrale Systeme aufbaut.';

const bestehend = ['nationale Marke', 'SEO', 'Google Ads', 'Lead Handling', 'Telefon', 'Terminprozesse', 'Technologie', 'Reporting', 'Recruiting', 'Wachstumssupport'];
const neu = ['1 Raum', '1 Therapeut:in', 'kontrollierte Fixkosten', 'erst Nachfrage', 'dann Ausbau'];
const fuer = [
  'Du führst bereits eine TCM-Praxis und willst wachsen.',
  'Du bist erfahrene:r Therapeut:in und willst Unternehmer:in werden.',
  'Du hast ein lokales Netzwerk und klinische Substanz.',
  'Du willst nicht jede Business-Infrastruktur allein bauen.',
  'Du willst wachsen, aber kein klassisches Franchise.',
];
const nicht = [
  'Passive Investor:innen ohne eigene Tätigkeit vor Ort.',
  'Menschen, die eine normale Anstellung suchen.',
  'Erwartungen an garantierten Umsatz.',
  'Wer den lokalen Betrieb nicht professionell führen will.',
];
const faqs = [
  { q: 'Ist das ein Franchise?', a: 'Nicht im klassischen Sinn: Es gibt keine Eintritts- oder Franchisegebühr. Das Launch-Budget ist standortbezogene Werbung, danach fliesst ein Anteil des Umsatzes in Marketing und Wachstum. Details regelt die individuelle Partnervereinbarung.' },
  { q: 'Bleibe ich selbstständig?', a: 'Ja. Die lokale Partnerfirma führt die Praxis, trägt die klinische Verantwortung und die lokalen Kosten. TCM.ch ist Plattform-, Nachfrage- und Systempartner, nicht dein Arbeitgeber.' },
  { q: 'Wird jede Praxis aufgenommen?', a: 'Nein. Wir prüfen Qualifikation, Anerkennung, Standort und Fit. Nicht jede Praxis und nicht jeder Standort passt in das Modell.' },
  { q: 'Gibt es Umsatz- oder Patientengarantien?', a: 'Nein. Das Modell soll Nachfrage aufbauen und messbar machen. Garantieren lässt sich weder Patientenzahl noch Umsatz.' },
  { q: 'Ich suche eigentlich eine Stelle.', a: 'Dann bist du unter tcm.ch/karriere/ richtig: Anstellung als Therapeut:in, Senior oder Standortleitung.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url, inLanguage: 'de-CH',
    audience: { '@type': 'Audience', audienceType: 'TCM practice owners and therapists' },
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Partner', item: url } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema} turnstile={true}>
  <div class="b2">
    <section class="b2-hero">
      <div class="b2-wrap">
        <p class="b2-label">TCM.ch Partner</p>
        <h1 class="b2-h1">Deine Praxis. Unsere Plattform. <span class="b2-accent">Gemeinsam wachsen.</span></h1>
        <p class="b2-lead">Baue deine lokale TCM-Praxis als TCM.ch Partner auf – mit der Freiheit einer eigenen Praxis und dem System einer starken Plattform im Hintergrund.</p>
        <div class="b2-actions">
          <a class="btn btn--primary" href="#partnerschaft">Partnerschaft prüfen</a>
          <a class="b2-link" href={B2B_LINKS.modell}>So funktioniert das Modell</a>
        </div>
        <p class="b2-route">Du suchst eine Anstellung statt Unternehmertum? <a href={B2B_LINKS.karriere}>Karriere bei TCM.ch&nbsp;→</a></p>
      </div>
    </section>

    <B2bPrinciples />

    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap">
        <p class="b2-label">Zwei Ausgangspunkte</p>
        <h2 class="b2-h2">Woher du kommst, entscheidet, wo wir anfangen.</h2>
        <div class="b2-split">
          <div>
            <h3 class="b2-h3">Du hast bereits eine Praxis.</h3>
            <p class="b2-p">TCM.ch kann dort ergänzen, wo Einzelpraxen an Grenzen stossen:</p>
            <ul>{bestehend.map((b) => <li>{b}</li>)}</ul>
            <p class="b2-p">Klinische Verantwortung und lokaler Betrieb bleiben bei dir, gemäss vertraglicher Struktur. Ob und wie deine Praxis passt, prüfen wir gemeinsam.</p>
          </div>
          <div>
            <h3 class="b2-h3">Du bist therapeutisch stark, willst aber nicht jedes System selbst bauen.</h3>
            <p class="b2-p">Dann startest du klein und wächst mit der Nachfrage:</p>
            <ul>{neu.map((b) => <li>{b}</li>)}</ul>
            <p class="b2-p">Nicht fünf Räume, nur weil sie verfügbar sind.</p>
            <div class="b2-actions" style="margin-top:20px"><a class="b2-link b2-link--green" href={B2B_LINKS.modell}>Modell ansehen&nbsp;→</a></div>
          </div>
        </div>
      </div>
    </section>

    <B2bOperatingSystem soft={false} />
    <B2bJourney />
    <B2bGrowth />

    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap">
        <p class="b2-label">Für wen</p>
        <h2 class="b2-h2">Für Unternehmer:innen mit therapeutischer Substanz.</h2>
        <div class="b2-who">
          <div><h3 class="b2-h3">Passt, wenn …</h3><ul>{fuer.map((w) => <li>{w}</li>)}</ul></div>
          <div class="is-not"><h3 class="b2-h3">Passt nicht für …</h3><ul>{nicht.map((w) => <li>{w}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <section class="b2-sec" id="partnerschaft">
      <div class="b2-wrap">
        <p class="b2-label b2-label--green">Partnerschaft prüfen</p>
        <h2 class="b2-h2">Passt das Modell zu deiner Praxis?</h2>
        <p class="b2-p">Ein paar Angaben genügen für ein erstes Gespräch. Keine Umsatzangaben nötig.</p>
        <PartnerLeadForm />
      </div>
    </section>

    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap b2-narrow">
        <p class="b2-label">FAQ</p>
        <h2 class="b2-h2">Häufige Fragen</h2>
        <div class="b2-faq" style="margin-top:28px">
          {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
        <div class="b2-cards" style="margin-top:48px">
          <a class="b2-card" href={B2B_LINKS.modell}><small>Modell</small><b>So funktioniert das Partnermodell</b><p>Launch, Geldfluss, Simulator.</p><span class="b2-go">Ansehen →</span></a>
          <a class="b2-card" href={B2B_LINKS.praxiswissen}><small>Praxiswissen</small><b>Praxis-Zahlen verstehen</b><p>Kosten, Auslastung, Kennzahlen, Rechner.</p><span class="b2-go">Lesen →</span></a>
          <a class="b2-card" href={B2B_LINKS.karriere}><small>Karriere</small><b>Lieber angestellt?</b><p>Therapeut:in, Senior, Standortleitung.</p><span class="b2-go">Zur Karriere →</span></a>
        </div>
      </div>
    </section>
  </div>
</LayoutDe>
