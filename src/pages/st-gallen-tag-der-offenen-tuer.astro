---
// Ads-only event landing page (noindex). Reuses the existing design system via SpaPage
// (home.css + home.js + DeHeader + Footer/StickyCtaBar + Turnstile). One goal: Slot-Anmeldung.
// noindex => SpaPage emits robots noindex AND gen-sitemap.mjs skips it automatically.
// Mobile-first + festive yellow "event" layer added on top of the existing tokens.
import SpaPage from '../layouts/SpaPage.astro';

const PREFILL = 'Anmeldung Tag der offenen Tür – St. Gallen (08.08.26). Ich hätte gern einen 30-Min-Slot (Anamnese & Diagnose).';
const waHref = 'https://wa.me/41775236122?text=' + encodeURIComponent(PREFILL);
// Reuse the Standort map embed pattern (keyless Google Maps output=embed), lazy-loaded.
const MAP = '<iframe src="https://www.google.com/maps?q=Oberer%20Graben%2022%2C%209000%20St.%20Gallen&output=embed" width="100%" height="300" style="border:0;display:block" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Karte: TCM.ch Kliniken St. Gallen, Oberer Graben 22"></iframe>';
const check = '<div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>';

const body = `
<div class="evt-page" style="padding-top:60px;padding-bottom:40px">

<!-- 1) HERO -->
<section class="section evt-reveal" style="text-align:center;padding:24px 16px 18px"><div class="wrap" style="max-width:780px">
  <span class="evt-badge">08. August 2026 · St. Gallen</span>
  <h1 class="section-title" style="margin:16px 0 12px">Tag der offenen Tür – St. Gallen</h1>
  <p class="section-sub evt-lead" style="margin:0 auto;max-width:600px">Ein Tag. Begrenzte Plätze. Gratis, was sonst [CHF 150] kostet.</p>
  <div class="evt-cta-row">
    <a href="#anmeldung" class="evt-cta">Slot sichern – solange verfügbar →</a>
    <a href="${waHref}" class="btn-secondary" target="_blank" rel="noopener" style="min-height:52px">Per WhatsApp fragen</a>
  </div>
  <p style="margin-top:14px;color:var(--muted);font-size:14px">📍 Oberer Graben 22, 9000 St. Gallen · 9:30–15:00 Uhr</p>
</div></section>

<!-- 2) ANGEBOT -->
<section class="section evt-reveal" style="padding-top:4px"><div class="wrap" style="max-width:780px">
  <div class="evt-offer" style="padding:26px 22px">
    <span class="evt-spark" aria-hidden="true">✨</span>
    <div class="section-label">Dein kostenloser TCM-Kennenlern-Termin</div>
    <h2 class="section-title" style="font-size:clamp(22px,6vw,30px);margin:6px 0 8px">Das bekommst du am 8.8. – geschenkt</h2>
    <div class="evt-stack">
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">30-Min-Konsultation mit unserem TCM-Team</span><span class="evt-rval">Wert [CHF 60]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">TCM-Diagnose (Puls &amp; Zunge), die deine Ursache zeigt</span><span class="evt-rval">Wert [CHF 50]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">EINE Behandlung deiner Wahl: Akupunktur, Schröpfen, Tuina oder Ohrakupunktur</span><span class="evt-rval">Wert [CHF 80]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">Persönlicher Mini-Plan für die nächsten Schritte</span><span class="evt-rval">Wert [CHF 30]</span></div>
    </div>
    <div class="evt-total"><span class="evt-total-top">Gesamtwert <s>[CHF 220]</s> → am 8.8.</span><span class="evt-zero">CHF 0</span></div>
    <p class="evt-risk">Kein Haken. Keine Verpflichtung. Du gehst mit einer echten Behandlung und einem klaren Plan nach Hause – nicht nur mit einem Flyer.</p>
    <div class="evt-flags">
      <div class="evt-flag">🔥 <strong>Nur [12] Slots.</strong> Wenn sie weg sind, sind sie weg.</div>
      <div class="evt-flag">⏳ <strong>Nur am 8. August.</strong> Danach gilt der reguläre Preis.</div>
    </div>
    <a href="#anmeldung" class="evt-cta" style="width:100%;margin-top:18px">Slot sichern – solange verfügbar →</a>
  </div>
</div></section>

<!-- 3) WAS DICH ERWARTET -->
<section class="section evt-reveal"><div class="wrap">
  <div class="section-label" style="text-align:center">Was dich erwartet</div>
  <h2 class="section-title" style="text-align:center;margin-bottom:24px">Dein Besuch in Kürze</h2>
  <div class="evt-grid">
    <div class="usp-card">${check}<div class="usp-title">Kennenlernen</div><div class="usp-sub">Team &amp; Praxis unverbindlich kennenlernen.</div></div>
    <div class="usp-card">${check}<div class="usp-title">Anamnese &amp; Diagnose</div><div class="usp-sub">Kurze TCM-Diagnose deiner Beschwerden.</div></div>
    <div class="usp-card">${check}<div class="usp-title">Deine Fragen</div><div class="usp-sub">Akupunktur, Kräutertherapie, Krankenkasse geklärt.</div></div>
  </div>
</div></section>

<!-- 4) STANDORT -->
<section class="section evt-reveal" style="background:var(--surface)"><div class="wrap" style="max-width:780px">
  <div class="section-label">Standort</div>
  <h2 class="section-title" style="margin-bottom:16px">Oberer Graben 22, 9000 St. Gallen</h2>
  <p class="evt-lead" style="color:var(--mid);margin:0 0 6px"><strong>Datum:</strong> 08. August 2026</p>
  <p class="evt-lead" style="color:var(--mid);margin:0 0 8px"><strong>Uhrzeit:</strong> 9:30–15:00 Uhr</p>
  <div class="up-map">${MAP}</div>
</div></section>

<!-- 5) ANMELDUNG -->
<section id="anmeldung" class="section contact-section-inline evt-reveal" style="background:var(--surface)"> <div class="wrap"> <div class="contact-inline-grid"> <div> <div class="section-label">Anmeldung</div> <h2 class="section-title">30-Min-Slot in <em>St. Gallen</em> reservieren.</h2> <p class="section-sub" style="margin-bottom:0">Sag uns kurz Wunschtage und Tageszeit – wir bestätigen deinen Slot.</p> <div class="intake-trust-row"> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Kostenlos &amp; unverbindlich</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Anamnese &amp; erste TCM-Diagnose</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Plätze limitiert (first come, first served)</div> </div> </div> <div> <div class="inline-form-card"><div class="inline-form-header"><div class="inline-form-title">30-Min-Slot reservieren</div><div class="inline-form-sub">Wir bestätigen deinen Slot für den 08.08.</div></div><form class="inline-form" onsubmit="submitTerminForm(event, this)" novalidate=""><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"><div class="form-group"><label class="form-label">Name *</label><input class="form-input" name="name" type="text" autocomplete="name" required=""></div><div class="form-row-2"><div class="form-group"><label class="form-label">Telefon *</label><input class="form-input" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required=""></div><div class="form-group"><label class="form-label">E-Mail *</label><input class="form-input" name="email" type="email" inputmode="email" autocomplete="email" required=""></div></div><div class="form-group"><label class="form-label">Standort</label><select class="form-select" name="standort"><option value="">Standort auswählen</option><option>Zürich City</option><option>Zürich Oerlikon</option><option>Zürich Höngg</option><option>Winterthur</option><option>Volketswil</option><option>Frauenfeld</option><option>Kreuzlingen</option><option selected>St. Gallen</option><option>Wil</option><option>Rorschach</option><option>Basel</option><option>Andere / in meiner Nähe</option></select></div><div class="form-group"><label class="form-label">Behandlung / Anliegen <span class="termin-opt">(optional)</span></label><textarea class="form-textarea" name="behandlung" rows="3" placeholder="z. B. Akupunktur bei Rückenschmerzen">Anmeldung Tag der offenen Tür – St. Gallen (08.08.26). Ich hätte gern einen 30-Min-Slot (Anamnese &amp; Diagnose).</textarea></div><div class="form-group"><label class="form-label">Wunsch-Wochentage</label><div class="termin-chips"><label class="termin-chip"><input type="checkbox" name="wochentag" value="Mo"><span>Mo</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Di"><span>Di</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Mi"><span>Mi</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Do"><span>Do</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Fr"><span>Fr</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Sa"><span>Sa</span></label></div></div><div class="form-group"><label class="form-label">Wunsch-Tageszeit</label><div class="termin-chips"><label class="termin-chip"><input type="checkbox" name="tageszeit" value="Vormittags"><span>Vormittags</span></label><label class="termin-chip"><input type="checkbox" name="tageszeit" value="Nachmittags"><span>Nachmittags</span></label><label class="termin-chip"><input type="checkbox" name="tageszeit" value="Abends"><span>Abends</span></label></div></div><div class="form-group cf-turnstile-wrap"><div class="cf-turnstile" data-sitekey="__TURNSTILE_SITEKEY__" data-ts-mounted="1"></div></div><button type="submit" class="btn-primary form-submit" style="width:100%;justify-content:center">Slot sichern – solange verfügbar →</button><p class="termin-under-btn">Wir melden uns innerhalb von 1 Stunde mit einer Bestätigung.</p><div class="form-divider-quiet">Lieber direkt per WhatsApp?</div><a href="${waHref}" class="form-wa-alt-new" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366" style="display:inline-block;vertical-align:middle;margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"></path></svg>Per WhatsApp anfragen</a></form></div> </div> </div> </div> </section>

<!-- 6) MINI-TRUST -->
<section class="section evt-reveal"><div class="wrap" style="max-width:780px;text-align:center">
  <div class="section-label" style="text-align:center">Unser Team &amp; Krankenkasse</div>
  <p style="font-size:16px;color:var(--black);font-weight:600;margin:8px 0 4px">Corinna Reinhart</p>
  <p style="color:var(--muted);font-size:14px;margin:0">Von der Zusatzversicherung anerkannt · EMR/ASCA-registriert</p>
</div></section>

</div>

<style>
/* ── event yellow token layered on top of existing navy/blue/green ── */
.evt-page{--ey:#FFC107;--ey-deep:#FFB300;--ey-ink:#3E2723;--ey-soft:#FFF8E1;--ey-bd:#FFD54F}
.evt-page h1.section-title{font-size:clamp(28px,8vw,40px);line-height:1.15}
.evt-page .evt-lead{font-size:16px;line-height:1.6}
/* yellow primary event CTA (hero + form submit + sticky primary) — green secondary stays */
.evt-cta{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 26px;border-radius:14px;font-family:var(--font-sans);font-weight:800;font-size:16px;text-decoration:none;border:none;cursor:pointer}
.evt-cta,.evt-page .form-submit{background:linear-gradient(90deg,var(--ey),var(--ey-deep))!important;color:var(--ey-ink)!important;box-shadow:0 8px 22px rgba(255,179,0,.32)!important;border:none!important;animation:evtCtaPulse 2.6s ease-in-out infinite}
/* sticky bar is outside .evt-page so use literal yellow (no var scope) */
.sticky-cta-bar .scb-primary{background:linear-gradient(90deg,#FFC107,#FFB300)!important;color:#3E2723!important;box-shadow:0 8px 22px rgba(255,179,0,.32)!important;border:none!important;animation:evtCtaPulse 2.6s ease-in-out infinite}
@keyframes evtCtaPulse{0%,100%{box-shadow:0 8px 22px rgba(255,179,0,.32)}50%{box-shadow:0 10px 30px rgba(255,179,0,.58)}}
.evt-cta-row{display:flex;flex-direction:column;gap:12px;align-items:stretch;margin-top:22px}
.evt-cta-row>a{width:100%}
@media(min-width:560px){.evt-cta-row{flex-direction:row;justify-content:center}.evt-cta-row>a{width:auto}}
/* responsive 3-up grid (no <360px overflow) */
.evt-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;max-width:980px;margin:0 auto}
/* event badge: entrance pop + soft pulse + shimmer sweep */
.evt-badge{position:relative;overflow:hidden;display:inline-block;background:linear-gradient(90deg,var(--ey),var(--ey-deep));color:var(--ey-ink);font-weight:800;font-size:12px;letter-spacing:.07em;text-transform:uppercase;padding:7px 16px;border-radius:100px;animation:evtPop .6s cubic-bezier(.22,1,.36,1) both,evtBadgePulse 2.8s ease-in-out 1s infinite}
.evt-badge::after{content:"";position:absolute;top:0;left:-70%;width:55%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.6),transparent);transform:skewX(-18deg);animation:evtShim 3.4s ease-in-out 1.2s infinite}
@keyframes evtPop{0%{transform:scale(.85);opacity:0}60%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}
@keyframes evtBadgePulse{0%,100%{box-shadow:0 0 0 0 rgba(255,193,7,.5)}50%{box-shadow:0 0 0 7px rgba(255,193,7,0)}}
@keyframes evtShim{0%{left:-70%}55%,100%{left:130%}}
/* offer highlight box: yellow glow + sparkle */
.evt-offer{position:relative;background:var(--ey-soft);border:1px solid var(--ey-bd);border-radius:18px;animation:evtGlow 3s ease-in-out infinite}
@keyframes evtGlow{0%,100%{box-shadow:0 0 16px rgba(255,193,7,.22)}50%{box-shadow:0 0 30px rgba(255,193,7,.5)}}
.evt-spark{position:absolute;top:-10px;right:16px;font-size:20px;animation:evtTwinkle 1.9s ease-in-out infinite}
@keyframes evtTwinkle{0%,100%{opacity:.5;transform:scale(.9) rotate(0)}50%{opacity:1;transform:scale(1.15) rotate(12deg)}}
/* grand-slam value stack (offer centerpiece) */
.evt-stack{display:flex;flex-direction:column;gap:12px;margin-top:6px}
.evt-row{display:flex;align-items:flex-start;gap:10px;font-size:15.5px;line-height:1.45}
.evt-ck{color:#2D9B6F;font-weight:800;flex-shrink:0;font-size:16px}
.evt-rtxt{flex:1;min-width:0;color:var(--black)}
.evt-rval{flex-shrink:0;color:var(--muted);font-weight:700;white-space:nowrap;font-size:13px}
.evt-total{margin-top:18px;border-radius:14px;background:#fff;border:1px solid var(--ey-bd);box-shadow:0 0 18px rgba(255,193,7,.25);padding:14px;text-align:center}
.evt-total-top{display:block;font-size:15px;color:var(--mid);font-weight:600;margin-bottom:2px}
.evt-total-top s{color:var(--muted)}
.evt-zero{display:inline-block;font-family:var(--font-sans);font-size:clamp(28px,9vw,40px);font-weight:800;color:#1F7A54;letter-spacing:-.02em;line-height:1.1}
.evt-risk{font-size:14.5px;color:var(--mid);line-height:1.55;margin:14px 0 0}
.evt-flags{margin-top:12px;display:flex;flex-direction:column;gap:6px}
.evt-flag{font-size:14px;color:var(--mid);line-height:1.45}
.evt-flag strong{color:var(--black)}
/* yellow section accent line under eyebrows */
.evt-page .section-label{position:relative;padding-bottom:7px}
.evt-page .section-label::after{content:"";position:absolute;left:0;bottom:0;width:28px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--ey),var(--ey-deep))}
.evt-page .section-label[style*="center"]::after{left:50%;transform:translateX(-50%)}
.evt-offer .section-label::after{background:var(--ey-deep)}
/* scroll reveal (fade-up) */
.evt-reveal{opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease}
.evt-reveal.in{opacity:1;transform:none}
/* HARD CONSTRAINT: reduced motion -> everything static */
@media(prefers-reduced-motion:reduce){
  .evt-badge,.evt-badge::after,.evt-offer,.evt-spark,.evt-cta,.evt-page .form-submit,.sticky-cta-bar .scb-primary{animation:none!important}
  .evt-reveal{opacity:1!important;transform:none!important;transition:none!important}
}
</style>

<script is:inline>(function(){
var RM=matchMedia('(prefers-reduced-motion:reduce)').matches;
function burst(x,y,n){if(RM)return;n=n||90;var c=document.createElement('canvas'),W=innerWidth,H=innerHeight;c.width=W;c.height=H;c.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:9999';document.body.appendChild(c);var g=c.getContext('2d'),CO=['#FFC107','#FFB300','#2D9B6F','#1F7A54','#FFD54F','#fff'],P=[],i;for(i=0;i<n;i++)P.push({x:x==null?Math.random()*W:x,y:y==null?H*0.16:y,vx:(Math.random()-.5)*7,vy:Math.random()*-8-3,gg:.22+Math.random()*.12,s:5+Math.random()*6,r:Math.random()*6.3,vr:(Math.random()-.5)*.35,co:CO[i%CO.length]});var t0;function f(t){t0=t0||t;var e=t-t0,a=Math.max(0,1-e/1500),k;g.clearRect(0,0,W,H);for(k=0;k<P.length;k++){var p=P[k];p.vy+=p.gg;p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;g.save();g.globalAlpha=a;g.translate(p.x,p.y);g.rotate(p.r);g.fillStyle=p.co;g.fillRect(-p.s/2,-p.s/2,p.s,p.s*.6);g.restore();}if(e<1500){requestAnimationFrame(f);}else{c.remove();}}requestAnimationFrame(f);}
function reveal(){var els=[].slice.call(document.querySelectorAll('.evt-reveal'));if(RM||!('IntersectionObserver' in window)){els.forEach(function(x){x.classList.add('in');});return;}var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}});},{threshold:.08,rootMargin:'0px 0px -40px 0px'});els.forEach(function(x){io.observe(x);});setTimeout(function(){els.forEach(function(x){x.classList.add('in');});},1600);}
function sticky(){var p=document.querySelector('.sticky-cta-bar .scb-primary');if(p)p.textContent='Slot sichern →';var w=document.querySelector('.sticky-cta-bar .scb-wa');if(w)w.setAttribute('href','${waHref}');}
addEventListener('click',function(e){var t=e.target.closest('.evt-cta,.form-submit,.scb-primary');if(t){var r=t.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2,46);}},true);
function init(){reveal();sticky();burst(null,null,110);}
if(document.readyState!=='loading'){init();}else{addEventListener('DOMContentLoaded',init);}
})();</script>
`;
