---
import LayoutDe from '../../layouts/LayoutDe.astro';
import { site } from '../../data/site';
import { reports, reportBySlug, STAND_DATE } from '../../data/ergebnisse';

export function getStaticPaths() {
  return reports.map((r) => ({ params: { slug: r.slug }, props: { report: r } }));
}

const { report } = Astro.props;
const r = report ?? reportBySlug(Astro.params.slug as string)!;

const path = `/ergebnisse/${r.slug}`;
const url = new URL(path, site.url).href;
const isDraft = r.status === 'draft';

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// ── JSON-LD: MedicalWebPage + FAQPage + BreadcrumbList ──
const medicalLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: r.title,
  description: r.description,
  url,
  inLanguage: 'de-CH',
  ...(r.publishedDate ? { datePublished: r.publishedDate } : {}),
  lastReviewed: r.publishedDate ?? STAND_DATE,
  about: { '@type': 'MedicalCondition', name: r.condition },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  publisher: {
    '@type': 'MedicalOrganization',
    name: 'TCM.ch',
    url: 'https://tcm.ch/',
    logo: { '@type': 'ImageObject', url: 'https://tcm.ch/icon-512.png' },
  },
};

const faqLd = r.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'de-CH',
  mainEntity: r.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Ergebnisse & Transparenz', item: 'https://tcm.ch/ergebnisse/' },
    { '@type': 'ListItem', position: 3, name: r.condition, item: url },
  ],
};

const schema = [medicalLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
---
<LayoutDe title={`${r.title} | TCM.ch`} description={r.description} path={path} schema={schema} noindex={isDraft}>
  {r.sampleNotice && (
    <div class="muster-bar" role="note">
      <strong>{r.sampleNotice}</strong>
    </div>
  )}

  <section class="hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/ergebnisse/">Ergebnisse &amp; Transparenz</a> <span>/</span> <span>{r.condition}</span>
      </nav>
      <div class="eyebrow">TCM.ch · Ergebnisbericht</div>
      <h1>{r.title}</h1>
      {isDraft && !r.sampleNotice && (
        <p class="draft-badge">In Vorbereitung, noch keine Zahlen</p>
      )}
      <p class="lead">{r.lead}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <article class="prose">
        {!r.sampleNotice && <div class="note">{r.dataNote}</div>}

        {(r.keyFindingsIntro || (r.keyFindings && r.keyFindings.length > 0)) && (
          <>
            <h2>Das Wichtigste in Kürze</h2>
            {r.keyFindingsIntro && <p>{r.keyFindingsIntro}</p>}
            {r.keyFindings && r.keyFindings.length > 0 && (
              <ul>{r.keyFindings.map((p) => <li>{p}</li>)}</ul>
            )}
          </>
        )}

        {r.whyTransparent && (
          <>
            <h2>Warum wir das zeigen</h2>
            <p>{r.whyTransparent}</p>
          </>
        )}

        <h2>Methodik</h2>
        {r.methodik.map((p) => <p>{p}</p>)}
        <div class="table-wrap">
          <table class="instruments">
            <thead>
              <tr><th>Instrument</th><th>Skala</th><th>Was es misst</th></tr>
            </thead>
            <tbody>
              {r.instruments.map((i) => (
                <tr>
                  <td><strong>{i.name}</strong>{i.abbr && <span class="abbr"> ({i.abbr})</span>}</td>
                  <td>{i.scale}</td>
                  <td>{i.measures}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>Ergebnisse</h2>
        {r.resultsTable && r.resultsTable.length > 0 ? (
          <>
            {r.resultsIntro && <p>{r.resultsIntro}</p>}
            <div class="table-wrap">
              <table class="results">
                <thead>
                  <tr><th>Kennzahl</th><th>Vor der Behandlung</th><th>Nach der Behandlungsserie</th></tr>
                </thead>
                <tbody>
                  {r.resultsTable.map((row) => (
                    <tr>
                      <td><strong>{row.label}</strong></td>
                      <td>{row.before}</td>
                      <td>{row.after}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {r.resultsHighlights && r.resultsHighlights.length > 0 && (
              <ul>{r.resultsHighlights.map((p) => <li>{p}</li>)}</ul>
            )}
          </>
        ) : (
          <>
            <p>
              Die folgenden Kennzahlen werden befüllt, sobald genügend anonymisierte Verläufe vorliegen.
              Bis dahin bleiben sie bewusst leer. Wir tragen hier keine erfundenen Werte ein.
            </p>
            <div class="placeholders">
              {r.instruments.map((i) => (
                <div class="ph-card">
                  <div class="ph-label">Mittlere Veränderung {i.name}{i.abbr && ` (${i.abbr})`}</div>
                  <div class="ph-value" aria-label="Noch keine Daten">noch keine Daten</div>
                </div>
              ))}
              <div class="ph-card">
                <div class="ph-label">Ausgewertete Behandlungsverläufe</div>
                <div class="ph-value" aria-label="Noch keine Daten">noch keine Daten</div>
              </div>
              <div class="ph-card">
                <div class="ph-label">Erhebungszeitraum</div>
                <div class="ph-value" aria-label="Noch keine Daten">noch keine Daten</div>
              </div>
            </div>
          </>
        )}

        <h2>Was nicht funktioniert hat</h2>
        <ul>
          {r.notWorking.map((p) => <li>{p}</li>)}
        </ul>

        <h2>Ablauf</h2>
        <ol class="ablauf">
          {r.ablauf.map((a) => (
            <li><strong>{a.step}.</strong> {a.text}</li>
          ))}
        </ol>

        <h2>Red Flags: wann du zuerst zur Ärztin oder zum Arzt solltest</h2>
        <ul>
          {r.redFlags.map((p) => <li>{p}</li>)}
        </ul>

        <h2>Datenschutz</h2>
        <ul>
          {r.datenschutz.map((p) => <li>{p}</li>)}
        </ul>

        {r.faqs.length > 0 && (
          <>
            <h2>Häufige Fragen</h2>
            <div class="faq">
              {r.faqs.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </>
        )}

        <div class="cta-row">
          <a class="btn btn--primary" href="/kontakt/">Termin buchen</a>
          <a class="btn btn--ghost" href="/ergebnisse/">← Alle Berichte</a>
        </div>
        {r.therapist && <p class="byline">Behandelnde:r Therapeut:in: {r.therapist}</p>}
        <p class="disclaimer">
          Dieser Bericht ist allgemeine Information, keine medizinische Beratung, und verspricht keine Heilung
          oder ein bestimmtes Ergebnis. Bei starken, plötzlichen oder zunehmenden Beschwerden suche eine Ärztin
          oder einen Arzt auf.
          {!isDraft && r.publishedDate && <> Stand: {fmt(r.publishedDate)}.</>}
        </p>
      </article>
    </div>
  </section>
</LayoutDe>

<style>
  /* MUSTER preview banner — amber notice bar, full width at the very top. */
  .muster-bar { background: #FEF3C7; border-bottom: 1px solid #FDE68A; color: #92400E; text-align: center; padding: 11px 20px; font-size: 14px; letter-spacing: .01em; }
  .muster-bar strong { font-weight: 800; }

  .crumbs { font-size: 13.5px; color: var(--muted); margin: 0 0 14px; }
  .crumbs a { color: var(--blue); text-decoration: none; font-weight: 600; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span { margin: 0 2px; }
  .draft-badge { display: inline-block; background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; border-radius: var(--r-pill); padding: 5px 14px; font-size: 13px; font-weight: 700; margin: 0 0 16px; }
  .prose { max-width: 760px; }
  .prose h2 { font-size: 26px; font-weight: 800; color: var(--ink); margin: 40px 0 14px; letter-spacing: var(--tracking-heading); }
  .prose p { font-size: 17px; color: var(--mid); margin: 0 0 16px; }
  .prose ul, .prose ol { font-size: 17px; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .prose li { margin: 0 0 10px; }
  .prose strong { color: var(--ink); }
  .note { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 18px 22px; margin: 0 0 8px; color: var(--mid); font-size: 16px; }

  .table-wrap { overflow-x: auto; margin: 8px 0 4px; position: relative; }
  /* Mobile audit B2: horizontal-scroll hint (header.js toggles .is-scrollx) */
  .table-wrap.is-scrollx::after {
    content: ""; position: absolute; top: 0; right: 0; bottom: 0; width: 40px;
    background: linear-gradient(to right, rgba(255,255,255,0), #fff 80%);
    pointer-events: none; z-index: 1;
  }
  .table-wrap.is-scrollx::before {
    content: "\203A"; position: absolute; top: 6px; right: 7px; z-index: 2;
    width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
    font: 700 18px/1 var(--font-sans); color: #fff; background: var(--blue);
    border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,.18); pointer-events: none;
  }
  .instruments, .results { width: 100%; border-collapse: collapse; font-size: 15px; }
  .instruments th, .instruments td, .results th, .results td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .instruments th, .results th { color: var(--ink); font-weight: 700; background: var(--surface); }
  .instruments td, .results td { color: var(--mid); }
  .abbr { color: var(--muted); font-weight: 400; }
  .byline { font-size: 14px; color: var(--muted); margin: 8px 0 18px; }

  .placeholders { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin: 6px 0 4px; }
  .ph-card { border: 1px dashed var(--border); border-radius: var(--r-card); padding: 18px 20px; background: var(--surface); }
  .ph-label { font-size: 13px; font-weight: 700; color: var(--mid); margin-bottom: 8px; }
  .ph-value { font-size: 15px; font-weight: 700; color: var(--muted); letter-spacing: .01em; }

  .ablauf li { margin: 0 0 12px; }
  .faq details { border: 1px solid var(--border); border-radius: var(--r-btn); padding: 4px 18px; margin: 0 0 12px; }
  .faq summary { font-weight: 700; color: var(--ink); cursor: pointer; padding: 14px 0; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; float: right; color: var(--blue); font-weight: 800; }
  .faq details[open] summary::after { content: '–'; }
  .faq p { margin: 0 0 16px; }

  .cta-row { margin: 36px 0 24px; display: flex; flex-wrap: wrap; gap: 12px; }
  .disclaimer { font-size: 14px; color: var(--mid); border-top: 1px solid var(--border); padding-top: 18px; }

  @media (max-width: 560px) { .placeholders { grid-template-columns: 1fr; } }
</style>
