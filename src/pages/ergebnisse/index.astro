---
import LayoutDe from '../../layouts/LayoutDe.astro';
import { site } from '../../data/site';
import { publishedReports } from '../../data/ergebnisse';

const path = '/ergebnisse/';
const url = new URL(path, site.url).href;

// Nur veröffentlichte Berichte listen. Drafts (NOINDEX) erscheinen hier nicht.
const published = publishedReports();

const title = 'Ergebnisse & Transparenz';
const description =
  'Wie wir Behandlungsergebnisse mit validierten Instrumenten messen: anonymisiert, aggregiert, nDSG-konform. Die ersten Berichte folgen, sobald genügend Daten erhoben sind.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Ergebnisse & Transparenz', item: url },
  ],
};
---
<LayoutDe title={`${title} | TCM.ch`} description={description} path={path} schema={breadcrumbLd}>
  <section class="hero hero--media">
    <img
      class="hero-bg"
      src="/images/ergebnisse-hero.png"
      alt="Helle, ruhige Schweizer TCM-Praxis mit Behandlungsliege und Eukalyptus – Behandlungsergebnisse und Transparenz bei TCM.ch"
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
    />
    <div class="wrap">
      <div class="hero-copy">
        <div class="eyebrow">TCM.ch — Transparenz</div>
        <h1>Ergebnisse &amp; Transparenz</h1>
        <p class="lead">
          Die meisten Praxen reden über Erfolge, ohne sie zu belegen. Wir gehen den umgekehrten Weg:
          Wir messen, was unsere Behandlungen tatsächlich bringen, und legen die Methodik offen.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="prose">
        <h2>Wie wir messen</h2>
        <p>
          Wir erfassen Behandlungsergebnisse mit <strong>validierten Instrumenten</strong>, nicht mit Bauchgefühl.
          Bei Schmerz arbeiten wir mit der NRS (Numerische Rating-Skala von 0 bis 10), bei der Alltagsfunktion
          mit etablierten Fragebögen wie dem Oswestry Disability Index. Wir erheben die Werte vor Behandlungsbeginn
          und im Verlauf, damit Veränderungen über die Zeit vergleichbar bleiben.
        </p>
        <p>
          Alle Daten werden <strong>anonymisiert und nur aggregiert</strong> ausgewertet, sodass keine Rückschlüsse
          auf einzelne Personen möglich sind. Die Verarbeitung erfolgt nach dem Schweizer Datenschutzgesetz (nDSG).
          Wir berichten auch dann, wenn die Daten keinen klaren Nutzen zeigen.
        </p>

        <div class="note">
          <strong>Status:</strong> Die ersten Berichte folgen, sobald genügend Daten erhoben sind.
          Wir veröffentlichen keine Zahlen, bevor die Datenbasis ausreicht, um eine ehrliche Aussage zu treffen.
        </div>

        {published.length > 0 ? (
          <>
            <h2 style="margin-top:40px">Veröffentlichte Berichte</h2>
            <div class="cards" style="margin-top:8px">
              {published.map((r) => (
                <a class="card" href={`/ergebnisse/${r.slug}`}>
                  <h3>{r.condition}</h3>
                  <p>{r.description}</p>
                </a>
              ))}
            </div>
          </>
        ) : (
          <div class="empty">
            <h2>Noch keine veröffentlichten Berichte</h2>
            <p>
              Wir erheben aktuell Daten. Sobald ein Bericht auf einer belastbaren Datenbasis steht,
              erscheint er an dieser Stelle, mit echten Zahlen und offener Methodik.
            </p>
          </div>
        )}

        <div class="cta-row">
          <a class="btn btn--primary" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich suche eine TCM-Praxis.')}`} target="_blank" rel="noopener">Termin anfragen</a>
          <a class="btn btn--ghost" href="/">← Zur Startseite</a>
        </div>
      </div>
    </div>
  </section>
</LayoutDe>

<style>
  /* Overlay hero: image fills the section, copy sits in the left clear area.
     Reuses the global .hero padding; styles here are component-scoped. */
  .hero--media { position: relative; overflow: hidden; }
  .hero--media .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; z-index: 0; }
  .hero--media .wrap { position: relative; z-index: 1; }
  .hero-copy { max-width: 460px; }
  @media (max-width: 820px) {
    .hero--media .hero-bg { object-position: 72% center; }
    .hero-copy { max-width: 100%; }
  }

  .prose { max-width: 760px; }
  .prose h2 { font-size: var(--fs-h2); font-weight: 800; line-height: var(--lh-heading); letter-spacing: var(--tracking-heading); margin: 0 0 14px; }
  .prose p { font-size: 17px; color: var(--mid); margin: 0 0 16px; }
  .prose strong { color: var(--ink); }
  .note { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 18px 22px; margin: 28px 0 0; color: var(--mid); font-size: 16px; }
  .note strong { color: var(--blue-dark); }
  .empty { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 28px; margin: 40px 0 0; }
  .empty h2 { font-size: 22px; margin: 0 0 8px; }
  .empty p { margin: 0; }
  .cta-row { margin: 36px 0 0; display: flex; flex-wrap: wrap; gap: 12px; }
</style>
