---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
import {
  clinics, commonConditions, deStandortPath, enLocationPath, formatHours, locationImages, type Clinic,
} from '../../../data/locations';

export function getStaticPaths() {
  return clinics.map((c) => ({ params: { slug: c.id }, props: { clinic: c } }));
}

interface Props { clinic: Clinic }
const { clinic } = Astro.props;
const { id, name, city, region, street, postalCode, phone, openingHours, geo, openingSoon } = clinic;

const path = enLocationPath(id);
const url = new URL(path, site.url).href;
const telHref = 'tel:' + phone.replace(/\s+/g, '');
const contactHref = `/en/contact/?standort=${encodeURIComponent(name)}`;
const mapsHref = street
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${street}, ${postalCode} ${city}`)}`
  : null;

const title = `Acupuncture & TCM in ${name} | EMR-recognised | TCM.ch`;
const description = openingSoon
  ? `Acupuncture & Traditional Chinese Medicine in ${city} (opening 2028). English-speaking, EMR-/ASCA-recognised practitioners across TCM.ch — covered by supplementary insurance.`
  : `English-speaking acupuncture in ${city} at TCM.ch. EMR-/ASCA-recognised practitioners for back pain, migraine, sleep & more — Traditional Chinese Medicine ${city}, covered by supplementary insurance. Reply usually within ~1h.`;

const conditionWords = 'back pain, neck pain, migraine, sleep problems, stress and digestive issues';

// Hero image — DE heroBg where the Standort page has one, else a relevant existing asset.
const image = locationImages[id];

// ── JSON-LD: MedicalClinic + BreadcrumbList ──
const clinicLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: `TCM.ch — Acupuncture & TCM ${name}`,
  url,
  telephone: phone,
  medicalSpecialty: 'TraditionalChineseMedicine',
  availableLanguage: ['en', 'de-CH'],
  geo: { '@type': 'GeoCoordinates', latitude: geo.lat, longitude: geo.lng },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CH',
    addressLocality: city,
    ...(street ? { streetAddress: street } : {}),
    ...(postalCode ? { postalCode } : {}),
  },
};
if (openingHours.length) clinicLd.openingHours = openingHours;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://tcm.ch/en/locations/' },
    { '@type': 'ListItem', position: 3, name: `Acupuncture & TCM in ${name}`, item: url },
  ],
};
---
<Layout title={title} description={description} path={path} schema={[clinicLd, breadcrumbLd]}>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch — {region}</div>
      <h1>Acupuncture & TCM in {name}</h1>
      {openingSoon ? (
        <p class="lead">
          Our {name} clinic is <strong>opening in 2028</strong>. Across TCM.ch you'll already find
          English-speaking, EMR-/ASCA-recognised practitioners offering acupuncture and Traditional
          Chinese Medicine — get in touch and we'll point you to your nearest open clinic.
        </p>
      ) : (
        <p class="lead">
          Looking for acupuncture in {city}? At our {name} clinic you'll find <strong>English-speaking</strong>,
          EMR-/ASCA-recognised practitioners offering acupuncture, Tuina, cupping and Chinese herbal medicine.
          People come to us with {conditionWords} and more.
        </p>
      )}
      <div class="hero__cta">
        <a class="btn btn--primary" href={contactHref}>Request an appointment</a>
        <a class="btn btn--ghost" href={telHref}>Call {phone}</a>
      </div>
      {image && (
        <figure class="hero-figure">
          <img src={image.src} alt={image.alt} width="1120" height="746" loading="eager" decoding="async" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cards">
        <div class="card">
          <h3>Where to find us</h3>
          {openingSoon ? (
            <p><strong>Opening 2028</strong><br />{city}, Switzerland</p>
          ) : (
            <p>
              {street}<br />{postalCode} {city}<br />Switzerland
              {mapsHref && (<><br /><a href={mapsHref} target="_blank" rel="noopener" style="color:var(--blue);font-weight:600">Directions on Google Maps →</a></>)}
            </p>
          )}
        </div>

        <div class="card">
          <h3>Opening hours</h3>
          {openingHours.length ? (
            <p>{openingHours.map((h) => (<>{formatHours(h)}<br /></>))}</p>
          ) : (
            <p>To be announced ahead of opening. We usually reply to requests within ~1h.</p>
          )}
        </div>

        <div class="card">
          <h3>Insurance & costs</h3>
          <p>
            Our practitioners are EMR-/ASCA-recognised, so treatment is typically reimbursed through
            supplementary insurance. <a href="/en/health-insurance-acupuncture/" style="color:var(--blue);font-weight:600">Is acupuncture covered by insurance? →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What we treat in {city}</h2>
      <p style="color:var(--mid);max-width:640px;margin:0 0 18px">
        Some of the most common reasons patients come to us. These guides are currently in German.
      </p>
      <div class="cards">
        {commonConditions.map((c) => (
          <a class="card" href={`/beschwerden/${c.id}/`}>
            <h3>{c.label}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="hero__cta">
        <a class="btn btn--primary" href={contactHref}>Request an appointment in {name}</a>
        <a class="btn btn--ghost" href="/en/locations/">← All TCM.ch clinics</a>
      </div>
    </div>
  </section>
</Layout>
