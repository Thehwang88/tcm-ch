---
import Layout from '../../../layouts/Layout.astro';
import { getStandort } from '../../../data/standorte';
import { site } from '../../../data/site';
import {
  clinics, enLocationPath, formatHours, locationImages, type Clinic,
} from '../../../data/locations';

export function getStaticPaths() {
  return clinics.map((c) => ({ params: { slug: c.id }, props: { clinic: c } }));
}

interface Props { clinic: Clinic }
const { clinic } = Astro.props;
const { id, name, city, region, street, postalCode, phone, openingHours, geo } = clinic;
const openingSoon = clinic.status !== 'operational';

const path = enLocationPath(id);
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;
const telHref = 'tel:' + phone.replace(/\s+/g, '');
const preselection = clinic.status === 'operational' ? name : (clinic.vorab?.at(-1)?.value ?? name);
const contactHref = `/en/contact/?standort=${encodeURIComponent(preselection)}`;
const mapsHref = street
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${street}, ${postalCode} ${city}`)}`
  : null;

const title = `Acupuncture & TCM in ${name} | TCM.ch`;
// Pre-opening ohne bestätigtes Datum (openingNote 'In preparation', z. B. Bern):
// neutrale Formulierung, KEIN Eröffnungsjahr erfinden. Datum-Claims bleiben auf
// Standorte mit kommuniziertem Jahr beschränkt.
const inPreparation = openingSoon && clinic.openingNote === 'In preparation';
// Datum/Jahr ausschliesslich aus clinic.openingNote (locations.ts), nie hartcodiert.
const openingLabel = clinic.openingNote ?? 'In preparation';
const underReview = clinic.status === 'review';
const description = openingSoon
  ? underReview
    ? `Acupuncture & TCM in ${name}: status under review, not confirmed as an operating clinic. Send your request and we suggest an available practice nearby.`
    : inPreparation
    ? `Acupuncture & TCM in ${name}: location in preparation, not open yet. Register your interest now; we contact you once appointments are possible.`
    : `Acupuncture & TCM in ${name}: ${openingLabel}, not open yet. Register your interest now; we contact you once appointments are possible.`
  : `Acupuncture & TCM in ${name}: request your appointment in English. Billing via supplementary insurance, depending on your policy.`;

// Reuse the current German location hero, including the dedicated St. Gallen page.
const deStandort = getStandort(id);
const imageSrc = id === 'st-gallen' ? '/images/standort-stgallen.jpg' : deStandort?.hero.image ?? locationImages[id]?.src;
const image = imageSrc ? { src: imageSrc } : undefined;
// Generic/planned imagery must never imply a verified photograph of this clinic.
const illustrativeImage = openingSoon || !deStandort || /\/(hero-main\.webp|basel-reception\.webp)$/.test(imageSrc ?? '');

// ── JSON-LD: MedicalClinic + BreadcrumbList ──
const clinicLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: `TCM.ch - Acupuncture & TCM ${name}`,
  url,
  telephone: phone,
  medicalSpecialty: 'TraditionalChineseMedicine',
  geo: { '@type': 'GeoCoordinates', latitude: geo.lat, longitude: geo.lng },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CH',
    addressLocality: city,
    ...(street ? { streetAddress: street } : {}),
    ...(postalCode ? { postalCode } : {}),
  },
};
if (openingHours.length) clinicLd.openingHours = openingHours;
// TCM.ch-operated location: same entity as the DE page (@id + name), so DE/EN describe one clinic.
const deName = clinic.schemaName ?? deStandort?.seo?.schemaName ?? (deStandort ? `TCM.ch ${deStandort.stadt}` : undefined);
if (!clinic.betreiber && deName) {
  clinicLd['@id'] = `https://tcm.ch/standorte/${id}/`;
  clinicLd.name = deName;
}
// Partner practice: describe the real operator entity (same @id as the DE page), TCM.ch as network only.
if (clinic.betreiber) {
  Object.assign(clinicLd, {
    '@id': `${clinic.betreiber.url}#praxis`, name: clinic.betreiber.name, url: clinic.betreiber.url,
    telephone: clinic.betreiber.telefon, sameAs: [clinic.betreiber.url],
    memberOf: { '@id': 'https://tcm.ch/#org' }, brand: { '@type': 'Brand', name: clinic.betreiber.marke },
  });
}
// Geplante Standorte: Status explizit im Schema, nie Öffnungszeiten (locations.ts status).
if (openingSoon && !underReview) clinicLd.description = `${name}: ${openingLabel}. Not operating yet; no appointments at this address before the opening is confirmed.`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://tcm.ch/en/locations/' },
    { '@type': 'ListItem', position: 3, name: `Acupuncture & TCM in ${name}`, item: url },
  ],
};

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import ClinicCard from '../../../components/en/ClinicCard.astro';
import Journey from '../../../components/en/Journey.astro';
import Insurance from '../../../components/en/Insurance.astro';
import { conditions, enConditionPath } from '../../../data/conditions';
import { therapies, enTherapyPath } from '../../../data/therapies';
import { therapeuten, getPublicTherapistProfile, getTherapeut } from '../../../data/therapeuten';
const profiles = therapeuten.map(getPublicTherapistProfile).filter(t=>t.standorte?.includes(id));
// SG still has a legacy DE page. Resolve only methods from its published lead profile,
// not future staff or a network-wide default treatment list.
const methodNames:Record<string,string> = {akupunktur:'Akupunktur',tuina:'Tuina',schroepfen:'Schröpfen',akupressur:'Akupressur',elektroakupunktur:'Elektroakupunktur'};
const sgMethods = getPublicTherapistProfile(getTherapeut('corinna-reinhart')!).methoden ?? [];
const localMethods = deStandort?.therapien ?? (id==='st-gallen' ? Object.keys(methodNames).filter(key=>sgMethods.includes(methodNames[key])) : []);
const localTherapies = therapies.filter(t=>localMethods.includes(t.deSlug));
const localConditions = deStandort?.beschwerden?.length ? conditions.filter(c=>deStandort.beschwerden.includes(c.deSlug)) : conditions;
const curatedNear = (deStandort?.nearby ?? []).map(n=>clinics.find(c=>c.id===n.slug)).filter((c):c is Clinic=>!!c && c.status==='operational' && c.id!==id);
// Legacy clinics have no Standort.nearby list. Rank central coordinates only;
// do not turn straight-line proximity into a travel-time claim.
const proximity = (c:Clinic) => Math.pow(c.geo.lat-geo.lat,2) + Math.pow((c.geo.lng-geo.lng)*Math.cos(geo.lat*Math.PI/180),2);
const near = curatedNear.length ? curatedNear : clinics.filter(c=>c.status==='operational' && c.id!==id).sort((a,b)=>proximity(a)-proximity(b)).slice(0,3);
const heroLead = openingSoon
  ? underReview ? `The status of this location is under review. It is not confirmed as an operating clinic. Ask us about an available practice nearby.`
    : `This location is not open yet. ${openingLabel}. Register your interest; we confirm when appointments become available.`
  : `${clinic.betreiber ? clinic.betreiber.name + ' is a partner practice in the TCM.ch network.' : 'Explore your local acupuncture and TCM options.'} Request an appointment in English. We confirm the practitioner, treatment and consultation language with you.`;
const faqs = [
 {q:`Where is the ${name} location?`,a:street ? `${street}, ${postalCode} ${city}. ${openingSoon ? 'The location is not currently confirmed for appointments.' : 'Use the map link below for directions to this address.'}` : 'A practice address has not yet been announced.'},
 {q:'Can I have my consultation in English?',a:'Please include English as your preferred consultation language in the request. The coordination team checks this with the practitioner before confirming your appointment.'},
 {q:'Which appointment times are available?',a:openingSoon ? 'Appointments at this location are not confirmed. You can register interest or ask about an operating practice.' : 'Contact us with suitable days and times. Published opening hours do not show appointment availability; the team confirms your appointment separately.'},
 {q:'What should I check before booking?',a:'Ask for the practitioner’s name, treatment fee, likely duration and cancellation conditions. If claiming insurance, confirm coverage for that practitioner and treatment with your insurer.'},
];
---

<Layout title={title} description={description} path={path} schema={underReview || !street ? [breadcrumbLd] : [clinicLd, breadcrumbLd]}>
<Premium>
  <Hero eyebrow={`${region} · ${openingSoon ? 'Location update' : 'Your local practice'}`} title={`Acupuncture & TCM in ${name}`} lead={heroLead} image={image?.src} imageWidth={id === 'st-gallen' ? 1447 : undefined} imageHeight={id === 'st-gallen' ? 1087 : undefined} imageAlt={image ? (illustrativeImage ? 'TCM.ch brand illustration; not a verified photograph of this location' : `TCM.ch ${name}: practice interior`) : undefined} caption={image && illustrativeImage ? 'Illustrative brand image' : undefined} primaryHref={contactHref} primaryLabel={openingSoon ? 'Register your interest' : 'Request an appointment'} secondaryHref="#practical" secondaryLabel="Practical information" />
  <section class="en-section" id="practical"><div class="wrap"><div class="en-grid">
    <div class="en-card"><span class="en-label">Practice</span><h2>{clinic.betreiber?.name ?? clinic.schemaName ?? name}</h2>
      {clinic.betreiber && <p>Partner practice in the TCM.ch network. <a href={clinic.betreiber.url}>Visit the practice website →</a></p>}
      {street ? <p>{street}<br />{postalCode} {city}</p> : <p>Address to be announced.</p>}
      {mapsHref && !openingSoon && <a class="en-link" href={mapsHref} target="_blank" rel="noopener">Directions on Google Maps →</a>}
    </div>
    <div class="en-card"><span class="en-label">Contact</span><h3>Arrange your visit</h3><p>TCM.ch coordinates your inquiry in English. Ask us to confirm treatment language, fees and access needs.</p>
      <p><a class="en-link" href={`tel:+${site.whatsapp}`}>Call TCM.ch coordination</a></p>
      {clinic.betreiber && <p>Practice direct: <a href={`tel:${clinic.betreiber.telefon.replace(/\s/g,'')}`}>{clinic.betreiber.telefon}</a></p>}
      {!clinic.betreiber && phone.replace(/\D/g,'')!==site.whatsapp && <p>Practice direct: <a href={telHref}>{phone}</a></p>}
    </div>
    <div class="en-card"><span class="en-label">Visit planning</span><h3>{openingSoon ? 'Location status' : 'Published opening hours'}</h3>
      {openingSoon ? <p>{heroLead}</p> : openingHours.length ? <p>{openingHours.map(h=><>{formatHours(h)}<br /></>)}</p> : <p>Hours have not been published. Please contact us to agree a time.</p>}
      {!openingSoon && <p class="en-note">Hours are not a live appointment calendar. Ask about step-free access or parking before travelling.</p>}
    </div>
  </div>
  {openingSoon && clinic.vorab && <div class="en-actions">{clinic.vorab.slice(0,-1).map(o=><a class="tcm-btn tcm-btn--mint" href={`/en/contact/?standort=${encodeURIComponent(o.value)}`}>{o.labelEn ?? o.label} →</a>)}</div>}
  </div></section>
  {profiles.length>0 && <section class="en-section en-concrete"><div class="wrap"><span class="en-label">People & qualifications</span><h2>{id==='basel' ? 'Designated clinic leadership' : 'Published practitioner profiles'}</h2><p class="en-intro">Learn about professional backgrounds. A published profile does not confirm a practitioner’s current availability.</p><div class="en-grid">{profiles.map(t=><article class="en-card">{t.bild && <img src={t.bild} alt={t.name} width="160" height="160" loading="lazy" style="width:160px;height:160px;object-fit:cover;border-radius:var(--r-card);margin-bottom:20px" />}<h3>{t.name}</h3>{id==='basel' && t.slug==='janine-schmieder' && <p>Designated clinic manager. Treatment availability is not confirmed by this role.</p>}<a class="en-link" href={`/team/${t.slug}/`} hreflang="de-CH">Qualifications & profile (German) →</a></article>)}</div></div></section>}
  {!openingSoon && localTherapies.length>0 && <section class="en-section"><div class="wrap"><span class="en-label">Treatment options</span><h2>Treatments listed for {name}.</h2><p class="en-intro">The methods below come from the published location or practitioner information. Confirm your chosen method and practitioner when booking.</p><div class="en-grid">{localTherapies.map(t=><a class="en-card" href={enTherapyPath(t.slug)}><h3>{t.name}</h3><span class="en-card-link">What the treatment involves ↗</span></a>)}</div></div></section>}
  {!openingSoon && <section class="en-section en-tint"><div class="wrap"><span class="en-label">Explore in English</span><h2>Start with your concern.</h2><p class="en-intro">These guides explain treatment options and limitations. Discuss suitability with your practitioner.</p><div class="en-grid">{localConditions.map(c=><a class="en-card" href={enConditionPath(c.slug)}><h3>{c.condition}</h3><span class="en-card-link">Read the guide ↗</span></a>)}</div></div></section>}
  {!openingSoon && <Journey />}<Insurance />
  <section class="en-section"><div class="wrap en-split"><div><span class="en-label">Plan your visit</span><h2>Questions about {name}.</h2></div><div class="en-faq">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
  {near.length>0 && <section class="en-section en-concrete"><div class="wrap"><span class="en-label">More local options</span><h2>Other operating practices.</h2><div class="en-grid">{near.map(c=><ClinicCard clinic={c} />)}</div></div></section>}
  <section class="en-section en-dark"><div class="wrap"><h2>{openingSoon ? 'Keep in touch about this location.' : `Your next step in ${name}.`}</h2><p>{openingSoon ? 'Register your interest or ask us about a currently operating practice.' : 'Send your preferred times and language. We’ll contact you to arrange the details.'}</p><div class="en-actions"><a class="tcm-btn tcm-btn--mint" href={contactHref}>{openingSoon ? 'Register your interest' : 'Request an appointment'} ↗</a><a href="/en/locations/" class="en-link">All locations →</a></div></div></section>
</Premium>
</Layout>
