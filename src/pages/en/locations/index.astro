---
// /en/locations/ — EN V2 location directory (mirrors DE /standorte/ hub: Mint hero + photo, status-aware cards).
import Layout from '../../../layouts/Layout.astro';
import HeroSplit from '../../../components/en/HeroSplit.astro';
import CtaBand from '../../../components/en/CtaBand.astro';
import { publicClinics as clinics, enLocationPath, locationImages } from '../../../data/locations';
import { getStandort } from '../../../data/standorte';
import { locationContent } from '../../../data/en/locations-content';
import { standortCardHtml, standortGridHtml } from '../../../lib/standort-card';

const path = '/en/locations/';
const open = clinics.filter((c) => c.status === 'operational');
const upcoming = clinics.filter((c) => c.status !== 'operational');
const thumb = (id: string) => locationContent[id]?.hero ?? (getStandort(id) ? { src: getStandort(id)!.hero.image, alt: `TCM.ch clinic ${id}` } : locationImages[id]);

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://tcm.ch/en/locations/' },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'TCM.ch clinics in Switzerland',
  itemListElement: clinics.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `Acupuncture & TCM in ${c.name}`, url: `https://tcm.ch${enLocationPath(c.id)}` })),
};
---
<Layout
  title="Acupuncture & TCM Clinics in Switzerland | Locations | TCM.ch"
  description="All TCM.ch locations in German-speaking Switzerland: Zürich, Winterthur, St. Gallen, Basel, Thurgau and Lake Constance. English-speaking requests; reimbursement may be available via supplementary insurance, depending on your policy."
  path={path}
  schema={[breadcrumbLd, itemListLd]}
>
  <HeroSplit
    eyebrow="TCM.ch · Swiss clinic network"
    h1="Acupuncture & TCM clinics across <em>Switzerland</em>"
    lead="Clinics and partner practices in German-speaking Switzerland. Pick the location closest to you; requests are welcome in English or German."
    ctas={[{ href: '/en/contact/', label: 'Request an appointment' }, { href: '#open', label: 'See all locations', kind: 'outline' }]}
    trust={['Request by WhatsApp or phone', 'Supplementary insurance: depends on your policy', 'Personal reply in English']}
    image={{ src: '/images/standorte-hero.webp', alt: 'Reception area of a TCM.ch clinic', caption: 'TCM.ch clinic' }}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { label: 'Locations' }]}
  />

  {/* Tiers like DE /standorte/ (05.11.2026): central location card (src/lib/standort-card.ts), hero without photo, compact for tier 3. */}
  <section class="ev-section" id="open">
    <div class="wrap">
      <p class="ev-label">Our clinics</p>
      <h2 class="ev-h2">Zürich and St. Gallen</h2>
      <div class="std-jump"><a href="#open">Zürich</a><a href="#st-gallen">St. Gallen</a><a href="#thurgau">Thurgau</a><a href="#more">More</a></div>
      <div class="std-stufe1">
        <div class="std-zh"><div class="std-zh-box"><div class="std-label">Zürich</div><h3 class="std-zh-h">Acupuncture &amp; TCM across Zürich</h3><p class="std-zh-p">TCM.ch clinics and partner practices in <a href="/en/acupuncture-zurich/">Zürich</a>. Tell us where you are looking for an appointment; we suggest the practice or the next free slot.</p><div class="std-zh-btns"><a class="ev-btn ev-btn--solid" href="/en/acupuncture-zurich/">Find an appointment in Zürich</a></div></div><Fragment set:html={standortGridHtml(['zuerich-bahnhofstrasse', 'zuerich-oerlikon', 'zuerich-hoengg'], { variant: 'hero', cols: 3, lang: 'en' })} /></div>
        <div class="std-sg" id="st-gallen"><Fragment set:html={standortCardHtml('st-gallen', { variant: 'hero', lang: 'en' })} /></div>
      </div>
      <h3 class="std-h3" id="thurgau">Thurgau &amp; Winterthur</h3><p class="std-sub">Partner practices Hwang; appointments directly via hwang.ch.</p>
      <Fragment set:html={standortGridHtml(['frauenfeld', 'kreuzlingen', 'winterthur-muenzgasse'], { variant: 'hero', cols: 3, lang: 'en' })} />
      <h3 class="std-h3" id="more">More locations and openings</h3>
      <Fragment set:html={standortGridHtml(['bottighofen', 'rorschach', 'wil', 'volketswil', 'basel', 'luzern', 'bern', 'winterthur-marktgasse'], { variant: 'kompakt', cols: 4, lang: 'en' })} />
    </div>
  </section>


  <section class="ev-section">
    <div class="wrap">
      <div class="ev-grid">
        <a class="ev-card" href="/en/acupuncture-zurich/"><h3>Acupuncture in Zürich</h3><p>All Zürich practices on one page: tell us your district and we suggest the practice or the next available appointment.</p></a>
        <a class="ev-card" href="/en/acupuncture-near-me/"><h3>Acupuncture near me</h3><p>All addresses on one page, for choosing the clinic that is easiest to reach.</p></a>
        <a class="ev-card" href="/en/health-insurance-acupuncture/"><h3>Insurance &amp; costs</h3><p>Basic versus supplementary insurance, what practitioner recognition (EMR/ASCA) means and how reimbursement works.</p></a>
        <a class="ev-card" href="/en/conditions/"><h3>Conditions</h3><p>Back pain, migraine, sleep, fertility and more: what TCM can realistically help with.</p></a>
      </div>
    </div>
  </section>

  <CtaBand text="Not sure which location fits? Tell us where you live and what is going on; we suggest the nearest clinic and reply personally in English or German." />
</Layout>
<style is:global>
  .std-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 20px; }
  .std-jump a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1.5px solid rgba(2,11,16,.14); border-radius: 999px; font-size: 14.5px; font-weight: 700; color: #020B10; text-decoration: none; background: #fff; }
  .std-stufe1 { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .std-zh { display: flex; flex-direction: column; gap: 14px; }
  .std-zh-box { background: #F4FAF8; border: 1px solid rgba(45,155,111,.14); border-radius: 18px; padding: 22px 20px; }
  .std-label { font-size: 11.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #2D9B6F; }
  .std-zh-h { font-size: 22px; font-weight: 800; letter-spacing: -.02em; margin: 6px 0; }
  .std-zh-p { font-size: 15px; color: rgba(2,11,16,.7); line-height: 1.55; margin: 0 0 14px; }
  .std-sg .sc { height: 100%; }
  .std-h3 { font-size: 20px; font-weight: 800; letter-spacing: -.02em; margin: 36px 0 6px; scroll-margin-top: 90px; }
  .std-sub { font-size: 14.5px; color: rgba(2,11,16,.7); margin: 0 0 14px; }
  #st-gallen, #thurgau, #more { scroll-margin-top: 90px; }
  @media (max-width: 900px) { .std-stufe1 { grid-template-columns: minmax(0, 1fr); } }
</style>
