---
import Layout from '../../../layouts/Layout.astro';
import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import ClinicCard from '../../../components/en/ClinicCard.astro';
import { clinics } from '../../../data/locations';
const path='/en/locations/';
const schema={'@context':'https://schema.org','@type':'CollectionPage',url:'https://tcm.ch/en/locations/',name:'Acupuncture and TCM clinics in Switzerland',inLanguage:'en'};
---
<Layout title="Acupuncture & TCM Clinics in Switzerland | TCM.ch" description="Find an operating acupuncture or TCM practice in Switzerland. View addresses, partner practices and separate updates for planned locations." path={path} schema={schema}>
<Premium>
<Hero eyebrow="TCM.ch network" title="Find your local practice." lead="Choose a clinic, explore its published information and tell us what you need. We coordinate appointment requests in English." primaryHref="#open" primaryLabel="Explore open clinics" secondaryHref="/en/contact/" secondaryLabel="Help me choose" />
<section class="en-section" id="open"><div class="wrap"><span class="en-label">Operating locations</span><h2>Explore our clinics and partner practices.</h2><div class="en-grid">{clinics.filter(c=>c.status==='operational').map(clinic=><ClinicCard clinic={clinic} />)}</div></div></section>
<section class="en-section en-concrete" id="future"><div class="wrap"><span class="en-label">Location updates</span><h2>Planned locations & status checks.</h2><p class="en-intro">These locations are not confirmed as operating clinics. View the local page to register interest or find an alternative practice.</p><div class="en-grid">{clinics.filter(c=>c.status!=='operational').map(clinic=><ClinicCard clinic={clinic} />)}</div></div></section>
</Premium>
</Layout>
