---
// /en/acupuncture-near-me/ - EN twin of /akupunktur-in-der-naehe/.
// Same data source (clinics), same structure mirrored. hreflang pair via PAIR_MAP in site.ts.
import Layout from '../../layouts/Layout.astro';
import HeroSplit from '../../components/en/HeroSplit.astro';
import CtaBand from '../../components/en/CtaBand.astro';
import ClinicFinder from '../../components/en/ClinicFinder.astro';
import AppointmentForm from '../../components/en/AppointmentForm.astro';
import { clinics, enLocationPath } from '../../data/locations';

const path = '/en/acupuncture-near-me';
const url = `https://tcm.ch${path}/`;
const title = 'Acupuncture Near Me: TCM.ch Locations in Switzerland | TCM.ch';
const description =
  'Find acupuncture near you in Switzerland: TCM.ch clinics and partner practices in Zürich, Winterthur, St. Gallen, Basel and beyond, with requests in English.';

const groups = [
  { label: 'Zurich & Winterthur', ids: ['zuerich-hoengg', 'zuerich-oerlikon', 'winterthur-marktgasse', 'winterthur-muenzgasse', 'volketswil'] },
  { label: 'Eastern Switzerland & Lake Constance', ids: ['st-gallen', 'frauenfeld', 'kreuzlingen', 'wil', 'rorschach', 'bottighofen'] },
  { label: 'Basel & Northwest', ids: ['basel'] },
  { label: 'Central Switzerland', ids: ['luzern'] },
  { label: 'Bern & Mittelland', ids: ['bern'] },
];
const byId = (id: string) => clinics.find((c) => c.id === id);
const allIds = groups.flatMap((g) => g.ids);

const faqs = [
  { q: 'Where can I find acupuncture near me in Switzerland?', a: 'TCM.ch runs clinics across German-speaking Switzerland, including Zurich, Winterthur, St. Gallen, Frauenfeld and Kreuzlingen. This page lists every location with its address, so you can contact the clinic closest to you directly.' },
  { q: 'Do the practitioners speak English?', a: 'Requests, replies and appointment coordination are in English or German. Tell us that you would like to be treated in English and we take it into account when suggesting a practice.' },
  { q: 'Does Swiss health insurance cover acupuncture?', a: 'Not through basic insurance, unless a doctor with the relevant training performs it. Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner\'s recognition. We tell you the treating practitioner\'s recognition (EMR/ASCA) and check your cover with you before the first appointment.' },
  { q: 'How quickly can I get an appointment?', a: 'That depends on the location and current capacity. Send your request through the location page, the form or WhatsApp with your preferred days and times; we reply personally with a proposal, and the appointment is fixed once you confirm.' },
  { q: 'What does a session cost?', a: 'You get the exact rate before your first treatment. What you pay yourself depends on your supplementary insurance policy and the practitioner\'s recognition; we check this with you beforehand. Our cost article explains typical session prices in Switzerland.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url, inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalOrganization', name: 'TCM.ch', areaServed: { '@type': 'Country', name: 'Switzerland' } } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'TCM.ch clinics in Switzerland',
    itemListElement: allIds.map((id, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://tcm.ch/en/locations/${id}/` })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Acupuncture near me', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout title={title} description={description} path={path} schema={schema}>
  <HeroSplit
    eyebrow="TCM.ch · Swiss clinic network"
    h1="Acupuncture near you in <em>Switzerland</em>"
    lead="Looking for acupuncture or TCM near you? We are a network of clinics and partner practices across German-speaking Switzerland, with requests and appointment coordination in English. Choose the location that is easiest for you to reach."
    ctas={[{ href: '#finder', label: 'Find the right clinic' }, { href: '#appointment', label: 'Request an appointment', kind: 'outline' }]}
    trust={['Personal reply in English', 'Supplementary insurance: depends on your policy', 'No referral needed']}
    image={{ src: '/images/standorte-hero.webp', alt: 'Reception area of a TCM.ch clinic', caption: 'TCM.ch clinic' }}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { label: 'Acupuncture near me' }]}
  />

  <section class="ev-section" id="clinics">
    <div class="wrap">
      <p class="ev-label">Locations</p>
      <h2 class="ev-h2">Our clinics and partner practices across Switzerland</h2>
      <p class="ev-sub">Pick the location closest to you. Partner practices are independent practices in the TCM.ch network; TCM.ch coordinates your request. Planned locations are marked and cannot be booked yet.</p>
      {groups.map((g) => (
        <div style="margin-bottom:28px">
          <h3 style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(2,11,16,.6);margin:0 0 12px">{g.label}</h3>
          <div class="ev-grid">
            {g.ids.map((id) => byId(id)).filter(Boolean).map((c) => (
              <a class="ev-card" href={enLocationPath(c!.id)}>
                <span class="ev-card__meta">{c!.postalCode ? `${c!.postalCode} ${c!.city}` : c!.city}</span>
                <h3>{c!.name}{c!.betreiber && <span class="ev-badge ev-badge--neutral">Partner</span>}{c!.status !== 'operational' && <span class="ev-badge">{c!.status === 'review' ? 'Under review' : 'Planned'}</span>}</h3>
                <p>{c!.status !== 'operational' ? (c!.status === 'review' ? 'Status under review; not confirmed as an operating clinic.' : (c!.openingNote ?? 'In preparation')) : c!.betreiber ? `${c!.betreiber.name} · ${c!.street}` : `${c!.street}`}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="ev-sub" style="margin:8px 0 0">Not sure which location fits? Tell us where you live and we suggest the nearest clinic. In Zürich, use the <a href="/en/acupuncture-zurich/">Zürich page</a>; you can also browse <a href="/en/locations/">all locations</a> in detail.</p>
    </div>
  </section>

  <section class="ev-section ev-section--tint" id="finder">
    <div class="wrap">
      <div class="ev-center">
        <p class="ev-label">Find the right clinic</p>
        <h2 class="ev-h2">Three quick choices, then your request.</h2>
        <p class="ev-sub">City, treatment interest, clinic. Open locations and verified partner practices take requests; planned locations only register interest. Nothing is booked automatically.</p>
      </div>
      <ClinicFinder formAnchor="#appointment" />
    </div>
  </section>

  <section class="ev-section">
    <div class="wrap">
      <div class="ev-article">
        <h2 style="margin-top:0">Finding acupuncture near you as a newcomer</h2>
        <p>When you search for acupuncture near you, you want two things: a short trip and a practice you can trust. TCM.ch is not a single studio but a network of clinics and partner practices across German-speaking Switzerland: Zürich, Winterthur, Volketswil, Frauenfeld, Kreuzlingen, Bottighofen, St. Gallen, Wil, Rorschach and Basel. Chances are one of them is only a few minutes away.</p>
        <p>If you have recently moved to Switzerland, the insurance side is usually the part that feels unfamiliar, and it matters most. Swiss cover has two layers. Basic insurance is mandatory, but it only pays for acupuncture when a physician with the relevant training performs it. For therapist-led TCM, reimbursement may be available through supplementary insurance for complementary medicine, depending on your policy, the treatment and the individual practitioner's recognition. We tell you where you stand before the first appointment; our <a href="/en/health-insurance-acupuncture/">insurance guide</a> explains the split in plain English.</p>
        <p>The most common reason people come to us is classic <a href="/en/therapies/acupuncture/">acupuncture</a>, for example for back and neck pain, headaches, sleep problems or stress-related complaints. Many locations also offer <a href="/en/therapies/tuina-massage/">Tuina massage</a>, <a href="/en/therapies/cupping/">cupping</a> and <a href="/en/therapies/chinese-herbal-medicine/">Chinese herbal medicine</a>.</p>
        <p>You do not need to know in advance which treatment is right. Tell us briefly what is going on and where you live. We suggest the location near you that fits and, if you like, a first appointment. We reply personally; the appointment is fixed once you confirm.</p>
      </div>
    </div>
  </section>

  <section class="ev-section">
    <div class="wrap">
      <div class="ev-center">
        <p class="ev-label">Start without risk</p>
        <h2 class="ev-h2">Start without risk. <em>We take care of the rest.</em></h2>
        <p class="ev-sub">You tell us what is going on. We organise the next step before you commit to anything.</p>
      </div>
      <div class="ev-kk">
        <div class="ev-kk__item"><h3>Insurance check first</h3><p>We tell you which recognition the treating practitioner holds and what your supplementary policy may reimburse, before any costs arise.</p></div>
        <div class="ev-kk__item"><h3>An honest assessment</h3><p>If TCM is not the right path for your situation, we say so at the first conversation and point you to a better option.</p></div>
        <div class="ev-kk__item"><h3>A team from two worlds</h3><p>Practitioners trained in Switzerland and South Korea, with requests and coordination in English.</p></div>
      </div>
      <p class="ev-sub" style="margin:22px auto 0;text-align:center">No subscription, no obligation. You decide after the first conversation.</p>
    </div>
  </section>

  <section class="ev-section ev-section--tint" id="faq">
    <div class="wrap">
      <p class="ev-label">FAQ</p>
      <h2 class="ev-h2">Questions before your first appointment.</h2>
      <div class="ev-faq" style="max-width:820px">
        {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="ev-section ev-final" id="appointment">
    <div class="wrap">
      <div class="ev-center">
        <p class="ev-label">Appointment</p>
        <h2 class="ev-h2">Request an appointment <em>near you.</em></h2>
        <p class="ev-sub">Pick a location or leave it to us. We reply personally in English or German; the appointment is fixed once you confirm.</p>
      </div>
      <div class="ev-split">
        <AppointmentForm id="en-nearme-form" source={path + '/'} heading="" intro="" />
        <aside class="ev-panel" aria-label="Direct contact">
          <h3>Prefer to talk?</h3>
          <p><a href="tel:+41775236122">+41 77 523 61 22</a><br /><a href="mailto:termine@tcm.ch">termine@tcm.ch</a></p>
          <a class="ev-btn ev-btn--wa" href="https://wa.me/41775236122?text=Hello%2C%20I%20am%20looking%20for%20a%20TCM%20clinic%20near%20me." target="_blank" rel="noopener">WhatsApp</a>
          <hr />
          <h3>Insurance</h3>
          <p style="font-size:14px;color:rgba(2,11,16,.68)">Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition. <a href="/en/health-insurance-acupuncture/">How it works</a></p>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand title="In Zürich?" text="All Zürich practices on one page: tell us your district or ask for the next available appointment." primary={{ href: '/en/acupuncture-zurich/', label: 'Acupuncture in Zürich' }} secondary={{ href: '/en/health-insurance-acupuncture/', label: 'Insurance & costs' }} />
</Layout>

