---
// /en/acupuncture-near-me/ — EN twin of /akupunktur-in-der-naehe/.
// Same data source (clinics), same structure mirrored. hreflang pair via PAIR_MAP in site.ts.
import Layout from '../../layouts/Layout.astro';
import { clinics, enLocationPath } from '../../data/locations';

const path = '/en/acupuncture-near-me';
const url = `https://tcm.ch${path}/`;
const title = 'Acupuncture Near Me: 13 TCM Clinics in Switzerland | TCM.ch';
const description =
  'Find acupuncture near you in Switzerland: 14 TCM.ch clinics with English-speaking, EMR-/ASCA-recognised practitioners in Zurich, Winterthur, St. Gallen and beyond.';

const groups = [
  { label: 'Zurich & Winterthur', ids: ['zuerich-city', 'zuerich-hoengg', 'zuerich-oerlikon', 'winterthur-marktgasse', 'winterthur-muenzgasse', 'volketswil'] },
  { label: 'Eastern Switzerland & Lake Constance', ids: ['st-gallen', 'frauenfeld', 'kreuzlingen', 'wil', 'rorschach', 'bottighofen'] },
  { label: 'Basel & Northwest', ids: ['basel'] },
  { label: 'Central Switzerland', ids: ['luzern'] },
];
const byId = (id: string) => clinics.find((c) => c.id === id);
const allIds = groups.flatMap((g) => g.ids);

const faqs = [
  { q: 'Where can I find acupuncture near me in Switzerland?', a: 'TCM.ch runs 14 clinics across German-speaking Switzerland, including Zurich, Winterthur, St. Gallen, Frauenfeld and Kreuzlingen. This page lists every location with its address, so you can contact the clinic closest to you directly.' },
  { q: 'Do the practitioners speak English?', a: 'Yes. English-speaking practitioners are available at our locations, and appointments, intake and treatment can be done in English. Mention your language preference when booking and we will match you with the right therapist.' },
  { q: 'Does Swiss health insurance cover acupuncture?', a: 'Basic insurance only covers acupuncture performed by licensed physicians. Most supplementary plans for complementary medicine cover a large share, typically 80 to 100 percent, of treatments by EMR- or ASCA-registered therapists. All our practitioners are registered, and we check your coverage for free.' },
  { q: 'How quickly can I get an appointment?', a: 'Usually within a few days, sometimes sooner depending on the location. Contact the clinic directly through its page or by phone, and we typically reply the same working day.' },
  { q: 'What does a session cost?', a: 'You will get the exact rate before your first treatment, with no hidden costs. With supplementary insurance most patients pay only a small share themselves. Checking whether your insurance covers the treatment is free, before any costs arise.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url, inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalOrganization', name: 'TCM.ch', areaServed: { '@type': 'Country', name: 'Switzerland' } } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'TCM.ch clinics in Switzerland',
    itemListElement: allIds.map((id, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://tcm.ch/en/locations/${id}/` })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Acupuncture near me', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout title={title} description={description} path={path} schema={schema}>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch — Swiss TCM network</div>
      <h1>Acupuncture Near You in Switzerland</h1>
      <p class="lead">Looking for acupuncture or TCM near you? We are a network of 14 clinics across German-speaking Switzerland, with English-speaking, EMR-/ASCA-recognised practitioners. One of them is likely a short trip away, and a first appointment is often possible within 24 hours.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/en/contact/">Request an appointment</a>
        <a class="btn btn--ghost" href="#clinics">Find a clinic near you →</a>
      </div>
    </div>
  </section>

  <section class="section" id="clinics">
    <div class="wrap">
      <div class="prose" style="margin-bottom:28px">
        <h2>Our 14 clinics across Switzerland</h2>
        <p>Pick the clinic closest to you. Every location is EMR-/ASCA-recognised and billable through supplementary insurance.</p>
      </div>
      {groups.map((g) => (
        <div style="margin-bottom:28px">
          <h3 style="font-size:18px;font-weight:800;color:var(--ink);margin:0 0 14px">{g.label}</h3>
          <div class="cards">
            {g.ids.map((id) => byId(id)).filter(Boolean).map((c) => (
              <a class="card" href={enLocationPath(c!.id)}>
                <div class="card-body">
                  <h3>{c!.name}</h3>
                  <p>{c!.openingSoon ? `${c!.city} (opening soon)` : `${c!.street}, ${c!.postalCode} ${c!.city}`}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p style="color:var(--mid);font-size:14px;margin-top:6px">Not sure which location fits? We will book you into the nearest clinic. You can also browse <a href="/en/locations/" style="color:var(--blue);font-weight:600">all clinics</a> in detail.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Finding acupuncture near you as a newcomer</h2>
      <p>When you search for acupuncture near you, you want two things: a short trip and a practice you can trust. At TCM.ch you get both. We are not a single studio but a network of 14 clinics across German-speaking Switzerland. In practice that means acupuncture near you in Zurich, Winterthur, Volketswil, Frauenfeld, Kreuzlingen, St. Gallen, Wil, Rorschach and Basel. Chances are one of them is only a few minutes away.</p>
      <p>If you have recently moved to Switzerland, the insurance side is usually the part that feels unfamiliar, and it matters most. Swiss cover has two layers. Basic insurance is mandatory, but it only pays for acupuncture when a physician performs it. Therapist-led TCM, like ours, is reimbursed through optional supplementary insurance for complementary medicine. Most of these supplementary plans cover a large share of each session, typically 80 to 100 percent, as long as the practitioner is EMR- or ASCA-registered. All of ours are. We check your coverage for free before any costs arise, so there are no surprises. For many internationals that clarity is not a given elsewhere, and it is a good reason to sort out the paperwork before your first visit.</p>
      <p>The most common reason people come to us is classic <a href="/en/therapies/acupuncture/">acupuncture</a>, for example for back and neck pain, headaches, sleep problems or stress-related complaints. Many locations also offer Tuina massage, cupping and Chinese herbal medicine. Which methods your nearest team provides is listed on each location page.</p>
      <p>You do not need to know in advance which treatment is right. Tell us briefly what is going on and where you live. We suggest the location near you that fits, and, if you like, a first appointment. We usually reply within the same working day, and a first session is often possible within 24 to 48 hours.</p>
    </div>
  </section>

  <section class="section" style="background:var(--blue-light)">
    <div class="wrap prose">
      <div class="eyebrow">Start without risk</div>
      <h2>Start without risk. We take care of the rest.</h2>
      <p>You tell us what is going on. We organise the next step before you commit to anything.</p>
      <ul>
        <li><strong>Free insurance check.</strong> We confirm what your supplementary policy covers before any costs arise.</li>
        <li><strong>An honest assessment.</strong> If TCM is not the right path for your situation, we say so at the first conversation and point you to a better option.</li>
        <li><strong>A team from two worlds.</strong> Practitioners from Switzerland and South Korea, EMR-/ASCA-registered, working in English.</li>
      </ul>
      <p style="font-size:14px;color:var(--mid)">No subscription, no obligation. You decide after the first conversation.</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/en/contact/">Request an appointment</a>
        <a class="btn btn--ghost" href="/en/health-insurance-acupuncture/">Is acupuncture covered by insurance? →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>FAQ</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .prose { max-width: 760px; }
  .prose h2 { font-size: 26px; font-weight: 800; margin: 0 0 14px; }
  .prose p { font-size: 17px; color: var(--mid); margin: 0 0 16px; }
  .prose ul { font-size: 17px; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .prose li { margin: 0 0 10px; }
  .prose strong { color: var(--ink); }
  .faq details { border: 1px solid var(--border); border-radius: var(--r-btn); padding: 4px 18px; margin: 0 0 12px; }
  .faq summary { font-weight: 700; color: var(--ink); cursor: pointer; padding: 14px 0; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; float: right; color: var(--blue); font-weight: 800; }
  .faq details[open] summary::after { content: '\2013'; }
  .faq p { margin: 0 0 16px; }
  .cta-row { margin: 24px 0 0; display: flex; gap: 12px; flex-wrap: wrap; }
</style>
