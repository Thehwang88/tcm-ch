---
// /en/acupuncture-near-me/ - EN twin of /akupunktur-in-der-naehe/.
// Same data source (clinics), same structure mirrored. hreflang pair via PAIR_MAP in site.ts.
import Layout from '../../layouts/Layout.astro';
import { clinics, enLocationPath } from '../../data/locations';

const path = '/en/acupuncture-near-me';
const url = `https://tcm.ch${path}/`;
const title = 'Acupuncture Near Me in Switzerland | TCM.ch';
const description = 'Find acupuncture by region in Switzerland. Compare operating practices, check location status and request an appointment in English.';

const groups = [
  { label: 'Zurich & Winterthur', ids: ['zuerich-hoengg', 'zuerich-oerlikon', 'winterthur-marktgasse', 'winterthur-muenzgasse', 'volketswil'] },
  { label: 'Eastern Switzerland & Lake Constance', ids: ['st-gallen', 'frauenfeld', 'kreuzlingen', 'wil', 'rorschach', 'bottighofen'] },
  { label: 'Basel & Northwest', ids: ['basel'] },
  { label: 'Central Switzerland', ids: ['luzern'] },
  { label: 'Bern & Mittelland', ids: ['bern'] },
];
const byId = (id: string) => clinics.find((c) => c.id === id);
const allIds = groups.flatMap((g) => g.ids);

const faqs = [
  {
    "q": "How do I choose a nearby practice?",
    "a": "Compare the address, travel options and available treatments on the location page. Tell the team where you live or work and which times suit you."
  },
  {
    "q": "Can I request a consultation in English?",
    "a": "Yes. Include English as your preferred consultation language in your request. The team will confirm language availability with the proposed practitioner."
  },
  {
    "q": "Are all listed locations open?",
    "a": "No. Operating practices and locations in preparation or under review are labelled separately. An interest request for a planned location is not a confirmed appointment."
  },
  {
    "q": "Is treatment covered by insurance?",
    "a": "Check the named practitioner, proposed method and policy conditions with your insurer before booking. Registration alone does not guarantee payment."
  },
  {
    "q": "How soon can I have an appointment?",
    "a": "Availability depends on the practice and practitioner. The team will confirm a suitable time after receiving your request; this page does not show live appointment slots."
  }
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url, inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalOrganization', name: 'TCM.ch', areaServed: { '@type': 'Country', name: 'Switzerland' } } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'TCM.ch clinics in Switzerland',
    itemListElement: allIds.map((id, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://tcm.ch/en/locations/${id}/` })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Acupuncture near me', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];

import Premium from '../../components/en/Premium.astro';
import Hero from '../../components/en/Hero.astro';
import ClinicCard from '../../components/en/ClinicCard.astro';
import NextSteps from '../../components/en/NextSteps.astro';
---
<Layout title={title} description={description} path={path} schema={schema}><Premium>
<Hero eyebrow="Find your practice · Switzerland" title="Care closer to your everyday life." lead="Explore practices by region, check their current status and tell us where you would like an appointment. TCM.ch coordinates inquiries across its own and partner locations." primaryHref="#clinics" primaryLabel="Browse by region" secondaryHref="/en/contact/" secondaryLabel="Help me choose"/>
<section class="en-section" id="clinics"><div class="wrap"><span class="en-label">Choose your region</span><h2>Operating practices</h2><p class="en-intro">Check each page for the actual operator, treatment options and practical information.</p>
{groups.map(g=>{const current=g.ids.map(byId).filter(c=>c?.status==='operational');return current.length>0 && <div class="en-region"><h3>{g.label}</h3><div class="en-grid">{current.map(c=><ClinicCard clinic={c!}/>)}</div></div>;})}
</div></section>
<section class="en-section en-concrete"><div class="wrap"><h2>Planned locations &amp; status updates</h2><p>An interest request is not an appointment at an operating practice. Where a separate partner option exists, the location page explains the distinction.</p><div class="en-grid">{clinics.filter(c=>c.status!=='operational').map(c=><ClinicCard clinic={c}/>)}</div></div></section>
<section class="en-section"><div class="wrap en-split"><div><h2>Choose for more than distance.</h2><p>Ask about your preferred language, treatment method, accessibility needs and appointment times. Confirm the proposed practitioner and fee before arranging travel.</p><a class="en-link" href="/en/health-insurance-acupuncture/">Understand Swiss insurance →</a></div><div><h2>Practical questions</h2><div class="en-faq">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></div></section><NextSteps/></Premium></Layout>
<style>.en-region{margin-top:36px}.en-region h3{margin-bottom:20px}</style>
