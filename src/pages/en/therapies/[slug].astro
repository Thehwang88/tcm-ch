---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
import {
  therapies, INSURANCE_FAQ, REVIEWED_DATE, enTherapyPath, therapyBySlug, therapyImages, type Therapy,
} from '../../../data/therapies';
import { conditions, enConditionPath } from '../../../data/conditions';

export function getStaticPaths() {
  return therapies.map((t) => ({ params: { slug: t.slug }, props: { therapy: t } }));
}

interface Props { therapy: Therapy }
const { therapy } = Astro.props;
const {
  slug, name, titleTerm, keyword, lead, whatItIs, whatToExpect, usedFor, evidence, related,
} = therapy;

const path = enTherapyPath(slug);
const url = new URL(path, site.url).href;
const contactHref = `/en/contact/?therapie=${encodeURIComponent(name)}`;

const title = `${titleTerm} | TCM.ch`;
const h1 = name;
const description = `${titleTerm} in Switzerland: honest, evidence-aware information from English-speaking, EMR-/ASCA-recognised TCM practitioners at TCM.ch. What ${keyword} is, what to expect in a session, and what it is typically used for.`;

// Therapy-specific FAQs + the shared insurance FAQ (display + schema stay in sync).
const faqs = [...therapy.faqs, INSURANCE_FAQ];

// Conditions this therapy commonly supports (cross-link EN -> EN).
const supportedConditions = therapy.conditions
  .map((cs) => conditions.find((c) => c.slug === cs))
  .filter(Boolean);

// Related therapies for cross-linking (EN -> EN).
const relatedTherapies = related.map(therapyBySlug).filter(Boolean) as Therapy[];

// Hero image — same asset the DE therapy showcase uses.
const image = therapyImages[slug];

// ── JSON-LD: MedicalProcedure + MedicalWebPage + FAQPage + BreadcrumbList ──
const procedureLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: titleTerm,
  url,
  inLanguage: 'en',
  description: lead,
  howPerformed: whatToExpect.join(' '),
  procedureType: { '@type': 'MedicalProcedureType', name: 'Complementary or alternative medicine' },
};

const medicalLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: h1,
  url,
  inLanguage: 'en',
  description,
  lastReviewed: REVIEWED_DATE,
  about: { '@type': 'MedicalProcedure', name: titleTerm },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  author: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/en/' },
  reviewedBy: {
    '@type': 'Organization',
    name: 'TCM.ch',
    url: 'https://tcm.ch/en/',
    description: 'EMR-/ASCA-recognised practitioners of Traditional Chinese Medicine in Switzerland.',
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Therapies', item: 'https://tcm.ch/en/therapies/' },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};
---
<Layout title={title} description={description} path={path} schema={[procedureLd, medicalLd, faqLd, breadcrumbLd]}>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch — Therapies</div>
      <h1>{h1}</h1>
      <p class="lead">{lead}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={contactHref}>Request an appointment</a>
        <a class="btn btn--ghost" href={`tel:+${site.whatsapp}`}>Call us</a>
      </div>
      {image && (
        <figure class="hero-figure">
          <img src={image.src} alt={image.alt} width="1120" height="746" loading="eager" decoding="async" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>What it is</h2>
      {whatItIs.map((p) => <p>{p}</p>)}

      <h2>What to expect in a session</h2>
      {whatToExpect.map((p) => <p>{p}</p>)}

      <h2>What it is typically used for</h2>
      <p>{usedFor}</p>

      <h2>What the evidence says</h2>
      <p>{evidence}</p>
      <p class="evidence-note">
        We base this on general clinical guidelines and systematic reviews (e.g. Cochrane, PubMed-indexed
        research). The honest summary: studies vary in quality and findings, and individual results differ.
        We use {name} as a complement, not a substitute for medical assessment.
      </p>

      {supportedConditions.length > 0 && (
        <>
          <h2>Conditions it commonly supports</h2>
          <p>People often try {name} as part of a wider approach for:</p>
          <ul class="cond-links">
            {supportedConditions.map((c) => (
              <li><a class="inline-link" href={enConditionPath(c.slug)}>{c.condition} →</a></li>
            ))}
          </ul>
        </>
      )}

      <h2>FAQ</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="xlinks">
        <strong>Next steps:</strong>
        <a class="inline-link" href="/en/locations/">Find a clinic near you →</a>
        <a class="inline-link" href="/en/health-insurance-acupuncture/">Is this covered by insurance? →</a>
      </div>

      <div class="cta-row">
        <a class="btn btn--primary" href={contactHref}>Request an appointment</a>
        <a class="btn btn--ghost" href="/en/therapies/">← All therapies</a>
      </div>

      <p class="disclaimer">
        This page is general information, not medical advice, and does not promise any cure or specific
        outcome. If symptoms are severe, sudden or worsening, see a doctor.
      </p>
    </div>
  </section>

  {relatedTherapies.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Related therapies</h2>
        <div class="cards">
          {relatedTherapies.map((t) => (
            <a class="card" href={enTherapyPath(t.slug)}>
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .prose { max-width: 760px; }
  .prose h2 { font-size: 26px; font-weight: 800; margin: 38px 0 14px; }
  .prose p { font-size: 17px; color: var(--mid); margin: 0 0 16px; }
  .prose ul { font-size: 17px; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .prose li { margin: 0 0 10px; }
  .prose strong { color: var(--ink); }
  .evidence-note { font-size: 15px; color: var(--text-soft); border-left: 3px solid var(--blue); padding-left: 14px; }
  .cond-links { list-style: none; padding-left: 0; }
  .cond-links li { margin: 0 0 8px; }
  .inline-link { color: var(--blue); font-weight: 700; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }
  .xlinks { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; background: var(--blue-light); border: 1px solid rgba(45, 155, 111, .25); border-radius: var(--r-card); padding: 18px 22px; margin: 28px 0 0; }
  .xlinks strong { color: var(--blue-dark); }
  .faq details { border: 1px solid var(--border); border-radius: var(--r-btn); padding: 4px 18px; margin: 0 0 12px; }
  .faq summary { font-weight: 700; color: var(--ink); cursor: pointer; padding: 14px 0; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; float: right; color: var(--blue); font-weight: 800; }
  .faq details[open] summary::after { content: '–'; }
  .faq p { margin: 0 0 16px; }
  .cta-row { margin: 32px 0 24px; display: flex; flex-wrap: wrap; gap: 12px; }
  .disclaimer { font-size: 14px; color: var(--mid); border-top: 1px solid var(--border); padding-top: 18px; }
</style>
