---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
import {
  therapies, INSURANCE_FAQ, enTherapyPath, therapyBySlug, therapyImages, type Therapy,
} from '../../../data/therapies';
import { conditions, enConditionPath } from '../../../data/conditions';

export function getStaticPaths() {
  return therapies.map((t) => ({ params: { slug: t.slug }, props: { therapy: t } }));
}

interface Props { therapy: Therapy }
const { therapy } = Astro.props;
const {
  slug, name, titleTerm, keyword, lead, whatItIs, whatToExpect, usedFor, evidence, related,
} = therapy;

const path = enTherapyPath(slug);
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;
const contactHref = `/en/contact/?therapie=${encodeURIComponent(name)}`;

const title = `${titleTerm} in Switzerland | TCM.ch`;
const h1 = name;
const description = `${titleTerm} in Switzerland: what a session involves, evidence, practical questions and how to request an appointment.`;

// Therapy-specific FAQs + the shared insurance FAQ (display + schema stay in sync).
const faqs = [...therapy.faqs, ...(slug === 'physiotherapy' ? [] : [INSURANCE_FAQ])];

// Conditions this therapy commonly supports (cross-link EN -> EN).
const supportedConditions = therapy.conditions
  .map((cs) => conditions.find((c) => c.slug === cs))
  .filter(Boolean);

// Related therapies for cross-linking (EN -> EN).
const relatedTherapies = related.map(therapyBySlug).filter(Boolean) as Therapy[];

// Hero image - same asset the DE therapy showcase uses.
const image = therapyImages[slug];

// ── JSON-LD: MedicalProcedure + MedicalWebPage + FAQPage + BreadcrumbList ──
const procedureLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: titleTerm,
  url,
  inLanguage: 'en',
  description: lead,
  howPerformed: whatToExpect.join(' '),
  procedureType: 'https://schema.org/TherapeuticProcedure',
};

const medicalLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: h1,
  url,
  inLanguage: 'en',
  description,
  about: { '@type': 'MedicalProcedure', name: titleTerm },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  author: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/en/' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Therapies', item: 'https://tcm.ch/en/therapies/' },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import ArticleNav from '../../../components/en/ArticleNav.astro';
import NextSteps from '../../../components/en/NextSteps.astro';
import Sources from '../../../components/en/Sources.astro';
import { editorialSources } from '../../../data/en-editorial';
---
<Layout title={title} description={description} path={path} schema={[procedureLd, medicalLd, faqLd, breadcrumbLd]}>
<Premium><div class="wrap en-breadcrumb"><a href="/en/">Home</a> / <a href="/en/therapies/">Therapies</a></div>
<Hero eyebrow="Therapies · Patient guide" title={h1} lead={lead} image={image?.src} imageAlt={image?.alt} caption={image ? 'Illustrative treatment image' : undefined} primaryHref={contactHref} primaryLabel="Ask about treatment" secondaryHref="#evidence" secondaryLabel="Read the evidence" />
<section class="en-section"><div class="wrap en-article-layout"><ArticleNav items={[{id:'overview',label:'Overview'},{id:'session',label:'The session'},{id:'uses',label:'Uses'},{id:'evidence',label:'Evidence'},{id:'practical',label:'Before booking'},{id:'faq',label:'Questions'}]}/><article class="en-reading"><h2 id="overview">What is {name.toLowerCase()}?</h2>{whatItIs.map(p=><p>{p}</p>)}
<h2 id="session">What happens in a session?</h2>{whatToExpect.map(p=><p>{p}</p>)}
<div class="en-checklist"><h3>Questions worth asking</h3><ul><li>What are we trying to improve, and how will we measure it?</li><li>What alternatives are available, including not having this treatment?</li><li>What are the risks for my medical history and medication?</li><li>What is the full fee, and when will we review the plan?</li></ul></div>
<h2 id="uses">Why people consider it</h2><p>{usedFor}</p>
{supportedConditions.length > 0 && <><p>Explore the condition-specific context before choosing a method:</p><ul>{supportedConditions.map(c=><li><a href={enConditionPath(c!.slug)}>{c!.condition}</a></li>)}</ul></>}
<h2 id="evidence">Evidence and limitations</h2><p>{evidence}</p><Sources sources={editorialSources[slug] ?? []}/>
<h2 id="practical">Before booking</h2><p>Availability differs by practice. Tell us which method you are interested in; we will confirm whether your chosen location offers it. Bring your medication list and relevant medical reports, and tell the practitioner about pregnancy, recent procedures and any ongoing treatment.</p><p>Ask for the first-visit fee, follow-up fee and any additional product costs. <a href="/en/knowledge/how-much-does-acupuncture-cost-in-switzerland/">Our cost guide</a> explains what to ask. {slug !== 'physiotherapy' && <a href="/en/health-insurance-acupuncture/">Check supplementary cover before committing.</a>}</p>
<h2 id="faq">Your questions</h2><div class="en-faq">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div><p class="en-note">General information, not a diagnosis or an individual treatment recommendation. No particular outcome is guaranteed.</p></article></div></section>
{relatedTherapies.length > 0 && <section class="en-section en-concrete"><div class="wrap"><span class="en-label">Compare your options</span><h2>Related therapies</h2><div class="en-grid">{relatedTherapies.map(t=><a class="en-card" href={enTherapyPath(t.slug)}><h3>{t.name}</h3><p>{t.summary}</p><span class="en-card-link">Explore treatment →</span></a>)}</div></div></section>}<NextSteps href={contactHref}/></Premium></Layout>
