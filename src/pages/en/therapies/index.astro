---
import Layout from '../../../layouts/Layout.astro';
import { therapies, enTherapyPath, therapyImages } from '../../../data/therapies';

const path = '/en/therapies/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Therapies', item: 'https://tcm.ch/en/therapies/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: therapies.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.titleTerm,
    url: new URL(enTherapyPath(t.slug), 'https://tcm.ch').href,
  })),
};

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import NextSteps from '../../../components/en/NextSteps.astro';
---
<Layout title="Therapies: Acupuncture & TCM in Switzerland | TCM.ch" description="Understand what each treatment involves, what the evidence can tell you and which questions to ask. Availability and practitioner qualifications are confirmed for your chosen clinic." path={path} schema={[breadcrumbLd,itemListLd]} >
<Premium><Hero eyebrow="TCM.ch · Therapies" title="Explore acupuncture & TCM treatments" lead="Understand what each treatment involves, what the evidence can tell you and which questions to ask. Availability and practitioner qualifications are confirmed for your chosen clinic." primaryHref="#explore" primaryLabel="Explore the guides" secondaryHref="/en/contact/" secondaryLabel="Ask a question"/>
<section class="en-section"><div class="wrap en-split"><div><span class="en-label">Start with the right question</span><h2>You do not need to choose a method first.</h2><p>Start with what you want help with. A consultation can clarify whether a treatment is suitable and whether medical assessment should come first.</p><a class="en-link" href="/en/conditions/">Browse conditions →</a></div><div><h3>Compare the practical details</h3><ul class="en-list"><li>What happens during treatment?</li><li>What evidence applies to your particular concern?</li><li>What are the risks, alternatives and total costs?</li><li>Is the method offered at your preferred practice?</li></ul></div></div></section>
<section class="en-section en-concrete" id="explore"><div class="wrap"><span class="en-label">Explore therapies</span><h2>Find your starting point</h2><div class="en-grid">{therapies.map(t=><a class="en-card en-card--image" href={enTherapyPath(t.slug)}>{therapyImages[t.slug] && <img src={therapyImages[t.slug].src} alt={therapyImages[t.slug].alt} width="1120" height="746" loading="lazy" decoding="async"/>}<div class="en-card-body"><h3>{t.name}</h3><p>{t.summary}</p><span class="en-card-link">Session, evidence & questions →</span></div></a>)}</div></div></section><NextSteps/></Premium></Layout>
