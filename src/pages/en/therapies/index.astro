---
// /en/therapies/ — EN V2 therapy hub (mirrors DE /therapien/ hub: Mint hero + photo, media cards).
import Layout from '../../../layouts/Layout.astro';
import { therapies, enTherapyPath, therapyImages } from '../../../data/therapies';

const path = '/en/therapies/';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Therapies', item: 'https://tcm.ch/en/therapies/' },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: therapies.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.titleTerm, url: new URL(enTherapyPath(t.slug), 'https://tcm.ch').href })),
};
const body = "<div class=\"en-therapy-overview\" id=\"page-therapien\" style=\"display:block\">\n  <section class=\"section svc-section therapy-overview\" id=\"s-behandlungen\" aria-labelledby=\"therapy-hub-heading\">\n    <div class=\"wrap\">\n      <div class=\"svc-header reveal visible\"><h1 class=\"section-title\" id=\"therapy-hub-heading\">Our therapies.</h1></div>\n      <div class=\"svc-grid\"><a class=\"svc-card reveal visible\" href=\"/en/therapies/acupuncture/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-akupunktur\" src=\"/images/img-c69a8f9ce7f8.webp\" alt=\"Acupuncture\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 30%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Acupuncture</h3> <p class=\"svc-tagline\">Fine needles at specific points, for example for pain and stress.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/facial-acupuncture/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"630\" height=\"840\" id=\"svc-img-gesichtsakupunktur\" src=\"/images/img-f7c771cf39ed.webp\" alt=\"Facial acupuncture\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 82%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Facial acupuncture</h3> <p class=\"svc-tagline\">For facial tension, wellbeing and skin concerns.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/cupping/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-schroepfen\" src=\"/images/img-a288825ba14a.webp\" alt=\"Cupping\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Cupping</h3> <p class=\"svc-tagline\">Cupping as a complementary method for muscle tension.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/tuina-massage/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-tuina\" src=\"/images/img-2a8cecc37898.webp\" alt=\"Tuina massage\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 30%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Tuina massage</h3> <p class=\"svc-tagline\">Manual massage for muscle discomfort and tension.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/acupressure/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-akupressur\" src=\"/images/img-5bf9460e0ca5.webp\" alt=\"Acupressure\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 40%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Acupressure</h3> <p class=\"svc-tagline\">Targeted pressure without needles.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/shiatsu/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-shiatsu\" src=\"/images/img-7149f50cc917.webp\" alt=\"Shiatsu\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 20%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Shiatsu</h3> <p class=\"svc-tagline\">Japanese pressure and stretching techniques for relaxation.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/gua-sha/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-gua-sha\" src=\"/images/img-0e38a23a362e.webp\" alt=\"Gua Sha\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 20%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Gua Sha</h3> <p class=\"svc-tagline\">Traditional tissue treatment, for example for tension.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card reveal visible\" href=\"/en/therapies/physiotherapy/\" style=\"text-decoration:none;color:inherit\"> <div class=\"svc-photo-wrap\"> <img width=\"1120\" height=\"746\" id=\"svc-img-physiotherapie\" src=\"/images/img-6a11d6de445a.webp\" alt=\"Physiotherapy\" class=\"svc-photo\" loading=\"lazy\" style=\"object-position:center 25%\">  </div> <div class=\"svc-body\"> <h3 class=\"svc-name\">Physiotherapy</h3> <p class=\"svc-tagline\">For pain, restricted movement and rehabilitation after injury.</p> <div class=\"svc-cta\"><span>Learn more</span> <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div> </div> </a>\n<a class=\"svc-card svc-card--contain-image reveal visible\" href=\"/en/therapies/chinese-herbal-medicine/\"><div class=\"svc-photo-wrap\"><img class=\"svc-photo\" src=\"/images/img-14a8b7c52ade.webp\" width=\"630\" height=\"840\" alt=\"Chinese herbal medicine\" loading=\"lazy\" decoding=\"async\" style=\"object-position:center\"></div><div class=\"svc-body\"><h3 class=\"svc-name\">Chinese herbal medicine</h3><p class=\"svc-tagline\">Individually prepared Chinese herbal formulas.</p><div class=\"svc-cta\"><span>Learn more</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div></div></a>\n<a class=\"svc-card svc-card--contain-image reveal visible\" href=\"/therapien/massage/\" hreflang=\"de\"><div class=\"svc-photo-wrap\"><img class=\"svc-photo\" src=\"/images/massage-card-home.webp\" width=\"600\" height=\"800\" alt=\"Massage\" loading=\"lazy\" decoding=\"async\" style=\"object-position:center top\"></div><div class=\"svc-body\"><h3 class=\"svc-name\">Massage</h3><p class=\"svc-tagline\">Manual treatment for relaxation and muscle tension.</p><div class=\"svc-cta\"><span>Learn more (German)</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div></div></a>\n<a class=\"svc-card svc-card--contain-image reveal visible\" href=\"/en/therapies/moxibustion/\"><div class=\"svc-photo-wrap\"><img class=\"svc-photo\" src=\"/images/moxibustion-hero.webp\" width=\"1200\" height=\"800\" alt=\"Moxibustion\" loading=\"lazy\" decoding=\"async\" style=\"object-position:center\"></div><div class=\"svc-body\"><h3 class=\"svc-name\">Moxibustion</h3><p class=\"svc-tagline\">Traditional heat treatment using dried mugwort.</p><div class=\"svc-cta\"><span>Learn more</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div></div></a>\n<a class=\"svc-card reveal visible\" href=\"/therapien/schroepfen/hijama/\" hreflang=\"de\"><div class=\"svc-photo-wrap\"><img class=\"svc-photo\" src=\"/images/hijama-schroepfen.webp\" width=\"1120\" height=\"746\" alt=\"Hijama\" loading=\"lazy\" decoding=\"async\" style=\"object-position:center\"></div><div class=\"svc-body\"><h3 class=\"svc-name\">Hijama</h3><p class=\"svc-tagline\">Traditional wet cupping technique involving small skin incisions.</p><div class=\"svc-cta\"><span>Learn more (German)</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></div></div></a></div>\n      <nav class=\"therapy-specialists\" aria-label=\"Other specialised therapies\">\n        <span class=\"therapy-specialists-label\">Other methods</span>\n        <div class=\"therapy-specialists-links\"><a href=\"/therapien/ohrakupunktur/\" hreflang=\"de\">Ear acupuncture (DE)</a><a href=\"/en/therapies/electroacupuncture/\">Electroacupuncture</a><a href=\"/therapien/dauernadeln/\" hreflang=\"de\">Semi-permanent needles (DE)</a><a href=\"/therapien/ear-seeds/\" hreflang=\"de\">Ear Seeds (DE)</a><a href=\"/therapien/gua-sha/gesichts-gua-sha/\" hreflang=\"de\">Facial Gua Sha (DE)</a></div>\n      </nav>\n    </div>\n  </section>\n  <section class=\"therapy-help\" aria-labelledby=\"therapy-help-heading\">\n    <div class=\"wrap therapy-help-inner\">\n      <div><h2 id=\"therapy-help-heading\">Which therapy is right for you?</h2><p>We help you find the right next step.</p></div>\n      <a class=\"therapy-help-button\" href=\"/en/contact/\">Request an appointment →</a>\n    </div>\n  </section>\n</div>\n";
---
<Layout title="TCM & Acupuncture Therapies in Switzerland | TCM.ch" description="TCM therapies in Switzerland, requests in English: acupuncture, cupping, Tuina, herbal medicine, moxibustion and more." path={path} schema={[breadcrumbLd,itemListLd]} zurichMirror>
<link rel="stylesheet" href="/en-therapies-overview.css" />
<Fragment set:html={body}/>
</Layout>
