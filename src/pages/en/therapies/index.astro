---
// /en/therapies/ — EN V2 therapy hub (mirrors DE /therapien/ hub: Mint hero + photo, media cards).
import Layout from '../../../layouts/Layout.astro';
import HeroSplit from '../../../components/en/HeroSplit.astro';
import CtaBand from '../../../components/en/CtaBand.astro';
import { therapies, enTherapyPath, therapyImages } from '../../../data/therapies';

const path = '/en/therapies/';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Therapies', item: 'https://tcm.ch/en/therapies/' },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: therapies.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.titleTerm, url: new URL(enTherapyPath(t.slug), 'https://tcm.ch').href })),
};
---
<Layout
  title="TCM & Acupuncture Therapies in Switzerland | TCM.ch"
  description="TCM therapies in Switzerland, requests in English: acupuncture, cupping, Tuina, herbal medicine, moxibustion and more."
  path={path}
  schema={[breadcrumbLd, itemListLd]}
>
  <HeroSplit
    eyebrow="TCM.ch · Therapies"
    h1="Our TCM &amp; acupuncture <em>therapies</em>"
    lead="Which method fits which complaint, what a session is like and what the evidence says. Honest, without cure promises."
    ctas={[{ href: '/en/contact/', label: 'Request an appointment' }, { href: '#all', label: 'Browse therapies', kind: 'outline' }]}
    trust={['Supplementary insurance: depends on your policy', 'Recognition checked per practitioner', 'English-speaking requests']}
    image={{ src: '/images/therapien-hero.webp', alt: 'Acupuncture treatment at a TCM.ch clinic', caption: 'TCM.ch clinic' }}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { label: 'Therapies' }]}
  />

  <section class="ev-section" id="all">
    <div class="wrap">
      <p class="ev-label">All methods</p>
      <h2 class="ev-h2">{therapies.length} therapies, one standard.</h2>
      <p class="ev-sub">Every page covers what the method is, what to expect, typical uses and an honest evidence summary. Availability per location is shown on the <a href="/en/locations/">location pages</a>.</p>
      <div class="ev-grid ev-grid--4">
        {therapies.map((t) => (
          <a class="ev-card ev-card--media" href={enTherapyPath(t.slug)}>
            {therapyImages[t.slug] && <img src={therapyImages[t.slug].src} alt={therapyImages[t.slug].alt} width="1120" height="746" loading="lazy" decoding="async" />}
            <div class="ev-card__body"><h3>{t.name}</h3><p>{t.summary}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ev-section ev-section--tint">
    <div class="wrap">
      <div class="ev-grid">
        <a class="ev-card" href="/en/conditions/"><h3>Conditions we treat</h3><p>Back pain, migraine, sleep, fertility and more: which methods we typically combine, and the limits.</p></a>
        <a class="ev-card" href="/en/locations/"><h3>Find a clinic</h3><p>Clinics and partner practices across German-speaking Switzerland, with the treatments offered at each.</p></a>
        <a class="ev-card" href="/en/health-insurance-acupuncture/"><h3>Is this covered by insurance?</h3><p>Basic versus supplementary cover, practitioner recognition (EMR/ASCA) and how reimbursement works.</p></a>
      </div>
    </div>
  </section>

  <CtaBand text="Not sure which method fits? Tell us what is going on; the practitioner decides with you at the first appointment. We reply personally in English or German." />
</Layout>
