---
import Layout from '../../../layouts/Layout.astro';
import { therapies, enTherapyPath, therapyImages } from '../../../data/therapies';

const path = '/en/therapies/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Therapies', item: 'https://tcm.ch/en/therapies/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: therapies.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.titleTerm,
    url: new URL(enTherapyPath(t.slug), 'https://tcm.ch').href,
  })),
};
---
<Layout
  title="TCM & Acupuncture Therapies in Switzerland | TCM.ch"
  description="The Traditional Chinese Medicine therapies we offer in Switzerland — acupuncture, cupping, Tuina massage, Chinese herbal medicine, moxibustion, electroacupuncture, facial acupuncture, acupressure, Shiatsu, gua sha and physiotherapy. English-speaking, EMR-/ASCA-recognised practitioners. Honest and evidence-aware."
  path={path}
  schema={[breadcrumbLd, itemListLd]}
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch — Therapies</div>
      <h1>Our TCM & acupuncture therapies</h1>
      <p class="lead">
        The treatments we offer across Switzerland. We are honest and evidence-aware: most are used as a
        complementary approach, results vary, and we say plainly what each is — and is not — likely to do.
        English-speaking, EMR-/ASCA-recognised practitioners.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/en/contact/">Request an appointment</a>
        <a class="btn btn--ghost" href="/en/conditions/">What we treat →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cards">
        {therapies.map((t) => (
          <a class="card card--media" href={enTherapyPath(t.slug)}>
            {therapyImages[t.slug] && (
              <img class="card-thumb" src={therapyImages[t.slug].src} alt={therapyImages[t.slug].alt} width="1120" height="746" loading="lazy" decoding="async" />
            )}
            <div class="card-body">
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="index-xlinks">
        <a class="inline-link" href="/en/conditions/">Conditions we treat →</a>
        <a class="inline-link" href="/en/locations/">Find a clinic near you →</a>
        <a class="inline-link" href="/en/health-insurance-acupuncture/">Is this covered by insurance? →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .index-xlinks { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 22px; }
  .inline-link { color: var(--blue); font-weight: 600; text-decoration: none; font-size: 15px; }
  .inline-link:hover { text-decoration: underline; }
</style>
