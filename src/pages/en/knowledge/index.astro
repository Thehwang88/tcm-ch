---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const path = '/en/knowledge/';

// Newest first by publish date (static ISO strings — no Date.now()).
const articles = (await getCollection('knowledge'))
  .sort((a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Knowledge', item: 'https://tcm.ch/en/knowledge/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/en/knowledge/${a.data.slug}`, 'https://tcm.ch').href,
  })),
};
---
<Layout
  title="Knowledge: Acupuncture & TCM in Switzerland | TCM.ch"
  description="Honest, evidence-aware guides to acupuncture and Traditional Chinese Medicine in Switzerland — costs, insurance, what to expect, and treatment for specific conditions. Written for English-speaking patients by EMR-/ASCA-recognised practitioners."
  path={path}
  schema={[breadcrumbLd, itemListLd]}
  enOnly={true}
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch — Knowledge</div>
      <h1>Knowledge</h1>
      <p class="lead">
        Honest, evidence-aware guides to acupuncture and Traditional Chinese Medicine in Switzerland —
        written in plain English for people new to the system. No cure claims, no mysticism: what helps,
        what it costs, and when to see a doctor first.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/en/contact">Request an appointment</a>
        <a class="btn btn--ghost" href="/en/conditions/">What we treat →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cards">
        {articles.map((a) => (
          <a class="card card--media" href={`/en/knowledge/${a.data.slug}`}>
            {a.data.heroImage && (
              <img class="card-thumb" src={a.data.heroImage} alt={a.data.heroImageAlt ?? a.data.title} width="1120" height="746" loading="lazy" decoding="async" />
            )}
            <div class="card-body">
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="index-xlinks">
        <a class="inline-link" href="/en/conditions/">Conditions we treat →</a>
        <a class="inline-link" href="/en/therapies/">Our therapies →</a>
        <a class="inline-link" href="/en/health-insurance-acupuncture">Insurance & costs →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .index-xlinks { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 22px; }
  .inline-link { color: var(--blue); font-weight: 600; text-decoration: none; font-size: 15px; }
  .inline-link:hover { text-decoration: underline; }
</style>
