---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const path = '/en/knowledge/';

// Newest first by publish date (static ISO strings - no Date.now()).
const articles = (await getCollection('knowledge'))
  .sort((a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Knowledge', item: 'https://tcm.ch/en/knowledge/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/en/knowledge/${a.data.slug}/`, 'https://tcm.ch').href,
  })),
};

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import NextSteps from '../../../components/en/NextSteps.astro';
---
<Layout title="Knowledge: Acupuncture & TCM in Switzerland | TCM.ch" description="Practical guides for English-speaking patients in Switzerland: understand fees, check insurance, prepare for treatment and weigh the evidence." path={path} schema={[breadcrumbLd,itemListLd]} enOnly={true}>
<Premium><Hero eyebrow="TCM.ch · Knowledge" title="Clear answers before your first visit." lead="Practical guides for English-speaking patients in Switzerland: understand fees, check insurance, prepare for treatment and weigh the evidence." primaryHref="#explore" primaryLabel="Explore the guides" secondaryHref="/en/contact/" secondaryLabel="Ask a question"/>
<section class="en-section"><div class="wrap en-split"><div><span class="en-label">New to Swiss healthcare?</span><h2>Start with the practical essentials.</h2><p>Understand the costs and coverage before committing to a course of treatment. Then explore what the consultation involves.</p></div><div class="en-topic-links"><a href="/en/knowledge/how-much-does-acupuncture-cost-in-switzerland/">Fees & budgeting</a><a href="/en/knowledge/how-to-claim-acupuncture-on-swiss-insurance/">Making a claim</a><a href="/en/knowledge/what-to-expect-first-acupuncture-session/">Your first visit</a><a href="/en/knowledge/is-acupuncture-safe-side-effects-explained/">Safety & side effects</a></div></div></section>
<section class="en-section en-concrete" id="explore"><div class="wrap"><span class="en-label">Explore knowledge</span><h2>All patient guides</h2><div class="en-grid">{articles.map(a=><a class="en-card en-card--image" href={`/en/knowledge/${a.data.slug}/`}>{a.data.heroImage && <img src={a.data.heroImage} alt={a.data.heroImageAlt ?? a.data.title} width="1120" height="746" loading="lazy" decoding="async"/>}<div class="en-card-body"><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="en-card-link">Read the guide →</span></div></a>)}</div></div></section><NextSteps/></Premium></Layout>
