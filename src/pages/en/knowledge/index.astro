---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeroSplit from '../../../components/en/HeroSplit.astro';
import CtaBand from '../../../components/en/CtaBand.astro';

const path = '/en/knowledge/';

// Newest first by publish date (static ISO strings - no Date.now()).
const articles = (await getCollection('knowledge'))
  .sort((a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Knowledge', item: 'https://tcm.ch/en/knowledge/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/en/knowledge/${a.data.slug}/`, 'https://tcm.ch').href,
  })),
};
---
<Layout
  title="Knowledge: Acupuncture & TCM in Switzerland | TCM.ch"
  description="Evidence-aware guides to acupuncture & TCM in Switzerland: costs, insurance, what to expect and treatment. For English-speaking patients."
  path={path}
  schema={[breadcrumbLd, itemListLd]}
  enOnly={true}
>
  <HeroSplit
    eyebrow="TCM.ch · Knowledge"
    h1="Knowledge: acupuncture &amp; TCM in <em>Switzerland</em>"
    lead="Honest, evidence-aware guides written in plain English for people new to the Swiss system. No cure claims: what helps, what it costs, and when to see a doctor first."
    ctas={[{ href: '/en/contact/', label: 'Request an appointment' }, { href: '/en/conditions/', label: 'What we treat', kind: 'outline' }]}
    image={{ src: '/images/img-73bf15a4e741.webp', alt: 'A TCM.ch therapist in conversation with a patient', caption: 'TCM.ch clinic' }}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { label: 'Knowledge' }]}
  />

  <section class="ev-section" id="articles">
    <div class="wrap">
      <p class="ev-label">All articles</p>
      <h2 class="ev-h2">Treatment decisions, costs and what to expect.</h2>
      <p class="ev-sub">Treatment-decision articles ("acupuncture for X") live here; the condition itself is explained in the <a href="/en/conditions/">condition guides</a>.</p>
      <div class="ev-grid">
        {articles.map((a) => (
          <a class="ev-card ev-card--media" href={`/en/knowledge/${a.data.slug}/`}>
            {a.data.heroImage && <img src={a.data.heroImage} alt={a.data.heroImageAlt ?? a.data.title} width="1120" height="746" loading="lazy" decoding="async" />}
            <div class="ev-card__body"><h3>{a.data.title}</h3><p>{a.data.description}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ev-section ev-section--tint">
    <div class="wrap">
      <div class="ev-grid">
        <a class="ev-card" href="/en/conditions/"><h3>Conditions we treat</h3><p>Back pain, neck pain, migraine, sleep, stress, digestion and fertility: honest guides with red flags.</p></a>
        <a class="ev-card" href="/en/therapies/"><h3>Our therapies</h3><p>Acupuncture, cupping, Tuina, Chinese herbal medicine and more: what each method is and when it fits.</p></a>
        <a class="ev-card" href="/en/health-insurance-acupuncture/"><h3>Insurance &amp; costs</h3><p>Basic versus supplementary cover, practitioner recognition (EMR/ASCA) and how reimbursement works.</p></a>
      </div>
    </div>
  </section>

  <CtaBand text="Questions the articles do not answer? Tell us briefly what is going on; we reply personally in English or German." secondary={{ href: '/en/acupuncture-zurich/', label: 'Acupuncture in Zürich' }} />
</Layout>

