---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
import { conditionBySlug, enConditionPath } from '../../../data/conditions';
import { therapyBySlug, enTherapyPath } from '../../../data/therapies';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const path = `/en/knowledge/${d.slug}`;
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;

// Resolve related EN slugs -> live pages for cross-linking.
const relatedConditions = d.relatedConditions.map(conditionBySlug).filter(Boolean);
const relatedTherapies = d.relatedTherapies.map(therapyBySlug).filter(Boolean);

// Pretty date for display (datePublished/dateModified are static ISO strings).
const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// ── JSON-LD: MedicalArticle + FAQPage + BreadcrumbList ──
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalArticle',
  headline: d.title,
  description: d.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'en',
  datePublished: d.datePublished,
  dateModified: d.dateModified,
  author: { '@type': 'Organization', name: d.author, url: 'https://tcm.ch/en/' },
  publisher: {
    '@type': 'Organization',
    name: 'TCM.ch',
    url: 'https://tcm.ch/en/',
    logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
  },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
};

const faqLd = d.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Knowledge', item: 'https://tcm.ch/en/knowledge/' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};

const schema = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import ArticleNav from '../../../components/en/ArticleNav.astro';
import NextSteps from '../../../components/en/NextSteps.astro';
---
<Layout title={`${d.title} | TCM.ch`} description={d.description} path={path} schema={schema} enOnly={!d.deWissenUrl} deHref={d.deWissenUrl}>
<Premium><div class="wrap en-breadcrumb"><a href="/en/">Home</a> / <a href="/en/knowledge/">Knowledge</a></div>
<Hero eyebrow="Knowledge · Patient guide" title={d.title} lead={d.description} image={d.heroImage} imageAlt={d.heroImageAlt ?? d.title} caption={d.heroImage ? 'Illustrative brand image' : undefined} primaryHref="#article" primaryLabel="Read the guide" secondaryHref="/en/contact/" secondaryLabel="Ask a question"/>
<section class="en-section" id="article"><div class="wrap en-article-layout"><ArticleNav items={headings.filter(h=>h.depth===2).map(h=>({id:h.slug,label:h.text}))}/>
<div class="en-reading"><p class="en-note">By {d.author} · Published {fmt(d.datePublished)}{d.dateModified !== d.datePublished && <> · Updated {fmt(d.dateModified)}</>}</p><article><Content/></article>
{d.faq.length>0 && <><h2>Frequently asked questions</h2><div class="en-faq">{d.faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></>}
<h2>Explore your options</h2><div class="en-topic-links">{relatedConditions.map(c=><a href={enConditionPath(c!.slug)}>{c!.condition}</a>)}{relatedTherapies.map(t=><a href={enTherapyPath(t!.slug)}>{t!.name}</a>)}<a href="/en/health-insurance-acupuncture/">Insurance guide</a><a href="/en/locations/">Find a clinic</a></div>
<p class="en-note">General information, not individual medical advice or a promise of treatment results.</p></div></div></section><NextSteps/></Premium></Layout>
