---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeroSplit from '../../../components/en/HeroSplit.astro';
import CtaBand from '../../../components/en/CtaBand.astro';
import { site } from '../../../data/site';
import { conditionBySlug, enConditionPath } from '../../../data/conditions';
import { therapyBySlug, enTherapyPath } from '../../../data/therapies';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const path = `/en/knowledge/${d.slug}`;
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;

// Resolve related EN slugs -> live pages for cross-linking.
const relatedConditions = d.relatedConditions.map(conditionBySlug).filter(Boolean);
const relatedTherapies = d.relatedTherapies.map(therapyBySlug).filter(Boolean);

// Pretty date for display (datePublished/dateModified are static ISO strings).
const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// ── JSON-LD: MedicalArticle + FAQPage + BreadcrumbList ──
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalArticle',
  headline: d.title,
  description: d.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'en',
  datePublished: d.datePublished,
  dateModified: d.dateModified,
  author: { '@type': 'Organization', name: d.author, url: 'https://tcm.ch/en/' },
  reviewedBy: {
    '@type': 'Organization',
    name: d.reviewer,
    url: 'https://tcm.ch/en/',
    description: 'Practitioners of Traditional Chinese Medicine in Switzerland; recognition (EMR/ASCA) is practitioner-specific.',
  },
  publisher: {
    '@type': 'Organization',
    name: 'TCM.ch',
    url: 'https://tcm.ch/en/',
    logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
  },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
};

const faqLd = d.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Knowledge', item: 'https://tcm.ch/en/knowledge/' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};

const schema = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
---
<Layout
  title={`${d.title} | TCM.ch`}
  description={d.description}
  path={path}
  schema={schema}
  enOnly={!d.deWissenUrl}
  deHref={d.deWissenUrl}
>
  <HeroSplit
    eyebrow="TCM.ch · Knowledge"
    h1={d.title}
    lead={d.description}
    sub={`By ${d.author} · Medically reviewed by ${d.reviewer} · Published ${fmt(d.datePublished)}${d.dateModified !== d.datePublished ? ` · Updated ${fmt(d.dateModified)}` : ''}`}
    ctas={[{ href: '/en/contact/', label: 'Request an appointment' }, { href: '/en/locations/', label: 'Find a clinic', kind: 'outline' }]}
    image={d.heroImage ? { src: d.heroImage, alt: d.heroImageAlt ?? d.title, caption: 'TCM.ch clinic' } : undefined}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { href: '/en/knowledge/', label: 'Knowledge' }, { label: d.title }]}
  />

  <section class="ev-section">
    <div class="wrap">
      <div class="ev-split">
        <div>
          <article class="ev-article kb-body">
            <Content />
          </article>

          {d.faq.length > 0 && (
            <div class="ev-article" style="margin-top:8px">
              <h2>Frequently asked questions</h2>
              <div class="ev-faq">
                {d.faq.map((f) => (
                  <details>
                    <summary>{f.q}</summary>
                    <p>{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )}

          <div class="ev-article">
            <div class="ev-note-box">
              <strong>Read next:</strong>
              {relatedConditions.map((c) => (
                <a href={enConditionPath(c.slug)}>{c.condition}</a>
              ))}
              {relatedTherapies.map((t) => (
                <a href={enTherapyPath(t.slug)}>{t.name}</a>
              ))}
              <a href="/en/health-insurance-acupuncture/">Insurance &amp; costs</a>
              <a href="/en/locations/">Find a clinic</a>
            </div>
            <p class="ev-disclaimer">
              This article is general information, not medical advice, and does not promise any cure or specific
              outcome. If symptoms are severe, sudden or worsening, see a doctor.
            </p>
          </div>
        </div>

        <aside class="ev-panel" aria-label="Appointments">
          <h3>Request an appointment</h3>
          <p>Tell us briefly what is going on and where you live. We suggest a clinic and a time, and reply personally in English or German.</p>
          <a class="ev-btn ev-btn--solid" href="/en/contact/">Request an appointment</a>
          <a class="ev-btn ev-btn--wa" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hello, I have a question about acupuncture and TCM.')}`} target="_blank" rel="noopener" style="margin-top:10px;width:100%">WhatsApp</a>
          <hr />
          <h3>Where</h3>
          <p style="font-size:14px"><a href="/en/acupuncture-zurich/">Acupuncture in Zürich</a> · <a href="/en/locations/">All locations</a></p>
          <hr />
          <h3>Insurance</h3>
          <p style="font-size:14px;color:rgba(2,11,16,.68)">Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition. <a href="/en/health-insurance-acupuncture/">How it works</a></p>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand text="Questions after reading? Tell us briefly what is going on; we reply personally in English or German and suggest the nearest clinic." secondary={{ href: '/en/knowledge/', label: 'All articles' }} />
</Layout>

