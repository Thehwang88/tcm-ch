---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Page not found"
  description="This English page does not exist."
  path="/en/404"
  noindex={true}
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">404</div>
      <h1>This page doesn't exist</h1>
      <p class="lead">The English page you're looking for isn't here. Try the English home page or send us a request.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/en/">English home</a>
        <a class="btn btn--ghost" href="/en/contact/">Request an appointment</a>
      </div>
      <p style="color:var(--mid);font-size:14px;margin-top:18px">Looking for the German site? <a href="/" hreflang="de-CH" style="color:var(--blue);font-weight:600">Zur deutschen Startseite →</a></p>
    </div>
  </section>
</Layout>
