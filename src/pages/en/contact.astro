---
// /en/contact/ — EN V2 shared appointment experience: Mint hero, status-aware form (same endpoint as DE),
// direct channels (WhatsApp, phone, email) and location picker. DE twin: /kontakt/ (PAIR_MAP).
import Layout from '../../layouts/Layout.astro';
import HeroSplit from '../../components/en/HeroSplit.astro';
import AppointmentForm from '../../components/en/AppointmentForm.astro';
import { site } from '../../data/site';
import { clinics, enLocationPath } from '../../data/locations';
import { waHref } from '../../data/standorte';

const path = '/en/contact';
const open = clinics.filter((c) => c.status === 'operational');
const upcoming = clinics.filter((c) => c.status !== 'operational');
const phone = '+41 77 523 61 22';
const wa = waHref(phone, 'Hello, I would like to request an appointment.');

const schema = [
  { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Request an appointment - TCM.ch', url: 'https://tcm.ch/en/contact/', inLanguage: 'en',
    about: { '@id': 'https://tcm.ch/#org' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Request an appointment', item: 'https://tcm.ch/en/contact/' },
  ] },
];
---
<Layout
  stickyCta={false}
  title="Request an Appointment · Acupuncture & TCM | TCM.ch"
  description="Request a TCM appointment at one of our Swiss clinics in English: tell us briefly what is going on and your preferred location. Personal reply, no referral needed."
  path={path}
  schema={schema}
>
  <HeroSplit
    variant="hub"
    eyebrow="TCM.ch · Appointments"
    h1="Request an <em>appointment</em>"
    lead="Tell us briefly what is going on and your preferred location. We reply personally in English or German, usually with a concrete suggestion for a clinic and a time."
    ctas={[{ href: '#appointment', label: 'Go to the form' }, { href: wa, label: 'WhatsApp', kind: 'wa', external: true }]}
    trust={['No referral needed', 'Insurance cover checked with you', 'Personal reply, not a bot']}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { label: 'Request an appointment' }]}
  />

  <section class="ev-section" id="appointment">
    <div class="wrap">
      <div class="ev-split">
        <AppointmentForm id="en-contact-form" source="/en/contact" heading="Your request" intro="Required fields are marked. Pick a location if you already know where you would like to be seen; otherwise we suggest the nearest clinic." />
        <aside class="ev-panel" aria-label="Direct contact">
          <h3>Prefer to talk?</h3>
          <p><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <a class="ev-btn ev-btn--wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
          <hr />
          <h3>What happens next</h3>
          <p>We read every request personally and reply with a suggested clinic and time. For planned locations we register your interest and suggest an open clinic nearby if you prefer.</p>
          <hr />
          <h3>Costs &amp; insurance</h3>
          <p style="font-size:14px;color:rgba(2,11,16,.68)">Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition. <a href="/en/health-insurance-acupuncture/">How it works</a></p>
        </aside>
      </div>
    </div>
  </section>

  <section class="ev-section ev-section--tint" id="locations">
    <div class="wrap">
      <p class="ev-label">Where</p>
      <h2 class="ev-h2">Choose a location</h2>
      <p class="ev-sub">Each location page has its own form with the clinic preselected, plus address, opening hours and the treatments offered there.</p>
      <div class="ev-grid ev-grid--4">
        {open.map((c) => (
          <a class="ev-card" href={enLocationPath(c.id)}>
            <span class="ev-card__meta">{c.postalCode} {c.city}</span>
            <h3>{c.name}{c.betreiber && <span class="ev-badge ev-badge--neutral">Partner</span>}</h3>
            <p>{c.street}</p>
          </a>
        ))}
        {upcoming.map((c) => (
          <a class="ev-card" href={enLocationPath(c.id)}>
            <span class="ev-card__meta">{c.city}</span>
            <h3>{c.name}<span class="ev-badge">{c.status === 'review' ? 'Under review' : 'Planned'}</span></h3>
            <p>{c.status === 'review' ? 'Status under review' : (c.openingNote ?? 'In preparation')}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
