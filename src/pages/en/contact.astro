---
import Layout from '../../layouts/Layout.astro';
import { site, standorte } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Request an appointment — TCM.ch',
  url: 'https://tcm.ch/en/contact',
  inLanguage: 'en',
};
---
<Layout
  title="Request an appointment"
  description="Request a TCM appointment at one of our 12 Swiss clinics. Tell us briefly what's going on and your preferred location — we usually reply within ~1h."
  path="/en/contact"
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch</div>
      <h1>Request an appointment</h1>
      <p class="lead">Tell us briefly what's going on and your preferred location — we'll get back to you, usually within ~1h.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <form class="form-card" id="en-contact-form">
        <!-- Honeypot (leave empty) -->
        <div class="hp" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="form-row">
          <div class="field"><label for="c-name">Name <span class="req">*</span></label>
            <input id="c-name" type="text" name="name" required autocomplete="name" placeholder="Anna Müller" /></div>
          <div class="field"><label for="c-email">Email <span class="req">*</span></label>
            <input id="c-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder="anna@example.ch" /></div>
        </div>

        <div class="form-row">
          <div class="field"><label for="c-phone">Phone <span class="req">*</span></label>
            <input id="c-phone" type="tel" name="telefon" required autocomplete="tel" inputmode="tel" placeholder="+41 79 000 00 00" /></div>
          <div class="field"><label for="c-loc">Location</label>
            <select id="c-loc" name="standort">
              <option value="">No preference</option>
              {standorte.map((s) => <option value={s.label}>{s.label}</option>)}
            </select></div>
        </div>

        <div class="field"><label for="c-msg">Message <span class="req">*</span></label>
          <textarea id="c-msg" name="anliegen" required placeholder="e.g. recurring neck pain, preferred times, any questions"></textarea></div>

        <div class="cf-turnstile" data-sitekey={site.turnstileSitekey} style="margin-bottom:14px"></div>

        <button class="btn btn--primary" type="submit"><span class="btn-label">Send request</span></button>
        <div class="form-status" role="status" aria-live="polite" hidden></div>
        <p style="font-size:13px;color:var(--mid);margin-top:14px">Your data is treated confidentially and not shared. See our <a href="/datenschutz" style="color:var(--blue)">privacy policy</a>.</p>
      </form>
    </div>
  </section>

  <script is:inline>
    // Prefill the location dropdown from ?standort= (links from location pages).
    (function () {
      var pre = new URLSearchParams(location.search).get('standort');
      if (!pre) return;
      var sel = document.getElementById('c-loc');
      if (!sel) return;
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === pre) { sel.selectedIndex = i; break; }
      }
    })();
    document.getElementById('en-contact-form')?.addEventListener('submit', async function (e) {
      e.preventDefault();
      var form = e.target;
      var status = form.querySelector('.form-status');
      var label = form.querySelector('.btn-label');
      function show(state, msg) { status.hidden = false; status.setAttribute('data-state', state); status.textContent = msg; }
      if (form.querySelector('[name="website"]').value.trim() !== '') return; // honeypot
      var tokenEl = form.querySelector('[name="cf-turnstile-response"]');
      var token = tokenEl && tokenEl.value ? tokenEl.value : '';
      if (!token) { show('error', 'Please confirm you are human and try again.'); return; }
      var payload = {
        typ: 'termin',
        name: form.name.value.trim(),
        email: form.email.value.trim(),
        telefon: form.telefon.value.trim(),
        standort: form.standort.value,
        anliegen: form.anliegen.value.trim(),
        quelle: '/en/contact',
        turnstileToken: token,
      };
      form.classList.add('is-sending');
      if (label) { label.dataset.orig = label.textContent; label.textContent = 'Sending…'; }
      try {
        var res = await fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var data = null; try { data = await res.json(); } catch (_) {}
        if (res.ok && data && data.ok) {
          form.reset();
          show('success', 'Thank you! Your request has been received — we will get back to you personally, usually within ~1h.');
        } else {
          show('error', (data && data.error) || 'Could not send your request. Please try again or call us.');
        }
      } catch (err) {
        show('error', 'Connection error. Please try again.');
      } finally {
        form.classList.remove('is-sending');
        if (label && label.dataset.orig) label.textContent = label.dataset.orig;
        if (window.turnstile) { try { window.turnstile.reset(); } catch (_) {} }
      }
    });
  </script>
</Layout>
