---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: 'TCM.ch',
  url: 'https://tcm.ch/en/',
  logo: 'https://tcm.ch/icon-512.png',
  medicalSpecialty: 'TraditionalChineseMedicine',
  areaServed: { '@type': 'Country', name: 'Switzerland' },
  availableLanguage: ['de-CH', 'en'],
};

const pillars = [
  { h: 'Conditions', p: 'Back pain, migraine, sleep, fertility and more — what TCM can realistically help with.', href: '/en/conditions/' },
  { h: 'Therapies', p: 'Acupuncture, Tuina, cupping, Chinese herbal medicine — methods and when they fit.', href: '/en/therapies/' },
  { h: 'Locations', p: '12 clinics across Zürich, Winterthur, St. Gallen, Basel and the wider region.', href: '/en/locations/' },
  { h: 'Knowledge', p: 'Evidence-based articles from the practitioners who do these treatments daily.', href: '/en/knowledge/' },
];
---
<Layout
  title="Acupuncture & Traditional Chinese Medicine in Switzerland | TCM.ch"
  description="English-speaking acupuncture & Traditional Chinese Medicine across Switzerland — 12 TCM.ch clinics, vetted EMR-/ASCA-recognised practitioners, covered by supplementary insurance. Request an appointment, usually answered within ~1h."
  path="/en/"
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">TCM.ch — Swiss TCM network</div>
      <h1>Acupuncture & Traditional Chinese Medicine in Switzerland</h1>
      <p class="lead">English-speaking acupuncture and Traditional Chinese Medicine across Switzerland — 12 clinics with vetted, EMR-/ASCA-recognised practitioners, covered by supplementary insurance.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/en/contact">Request an appointment</a>
        <a class="btn btn--ghost" href="/en/locations/">Find a clinic</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Explore TCM.ch</h2>
      <div class="cards">
        {pillars.map((c) => (
          <a class="card" href={c.href}>
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </a>
        ))}
      </div>
      <p style="color:var(--mid);font-size:14px;margin-top:18px">
        These sections are currently in German. An English contact form is available — <a href="/en/contact" style="color:var(--blue);font-weight:600">request an appointment in English</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Why TCM.ch</div>
      <div class="cards">
        <div class="card"><h3>EMR / ASCA recognised</h3><p>Our practitioners are vetted and recognised — the prerequisite for reimbursement through supplementary insurance.</p></div>
        <a class="card" href="/en/health-insurance-acupuncture"><h3>Does insurance cover acupuncture? →</h3><p>How Swiss basic vs. supplementary insurance covers acupuncture and TCM — a plain-English guide for expats.</p></a>
        <div class="card"><h3>Appointments within ~1h reply</h3><p>Tell us briefly what's going on — we usually get back to you within about an hour.</p></div>
      </div>
    </div>
  </section>
</Layout>
