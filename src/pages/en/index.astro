---
// English home visual mirror of DE; retain English schema, navigation and enquiry handling.
import Layout from '../../layouts/Layout.astro';
import { enLocationPath, mapsDirectionsUrl } from '../../data/locations';
import { clinicById } from '../../lib/standort-card';
import { licensedArchitecturePhotos as architecture } from '../../data/heritage-architecture-rights';
import { enHome } from '../../data/en-home-mirror';
import AppointmentForm from '../../components/en/AppointmentForm.astro';
import ClinicConcierge from '../../components/ClinicConcierge.astro';
import WinterSnow from '../../components/WinterSnow.astro';

const INSURANCE = "Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition.";
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalOrganization', '@id': 'https://tcm.ch/#org',
    name: 'TCM.ch', url: 'https://tcm.ch/en/', logo: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png',
    medicalSpecialty: 'TraditionalChineseMedicine', areaServed: { '@type': 'Country', name: 'Switzerland' }, availableLanguage: ['de-CH', 'en'],
  },
];
const faqs = [
  { q: 'What happens after I send an enquiry?', a: 'A member of our team reads your request and replies personally, usually with a suggested clinic and appointment time. Nothing is booked until you agree to the proposal.' },
  { q: 'Can I request a practitioner who speaks English?', a: 'You can send your enquiry and coordinate appointments in English or German. Tell us if you prefer an English-speaking practitioner; we take that into account when suggesting a clinic.' },
  { q: 'How do I find the right clinic?', a: 'Tell us which town or district suits you and what matters most, such as a nearby clinic or a convenient time. We help you choose from our clinics and partner practices. You can also use the clinic finder.' },
  { q: 'What happens at the first visit?', a: 'We begin with a conversation about your symptoms and history, followed by a TCM assessment and a discussion of reasonable treatment options. We explain the likely costs and whether another medical assessment may be more suitable.' },
  { q: 'How can I check insurance coverage and costs?', a: 'For non-physician TCM care, reimbursement usually comes from supplementary rather than basic health insurance. ' + INSURANCE + ' We can tell you the practitioner’s EMR/ASCA recognition and help you check your policy before you book.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const cityIds = ['zuerich-hub','st-gallen','winterthur-marktgasse','basel','bern','luzern'];
const meta: Record<string,{name:string,image?:string,illustration?:boolean}> = {
  'zuerich-hub':{name:'Zürich'}, 'st-gallen':{name:'St. Gallen'}, 'winterthur-marktgasse':{name:'Winterthur',illustration:true}, basel:{name:'Basel',image:'/images/basel-empfang-800.webp'}, bern:{name:'Bern',image:'/images/bern-marktgasse-logo-wall.avif',illustration:true}, luzern:{name:'Luzern',illustration:true}
};
const esc = (s:string) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const icons:Record<string,string> = {
phone:'<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6.5-6.5 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 3.6 1.6h3a2 2 0 0 1 2 1.7l.7 2.8a2 2 0 0 1-.5 2.1L7.9 9a16 16 0 0 0 6 6l.9-.9a2 2 0 0 1 2.1-.5l2.8.7A2 2 0 0 1 22 16.9Z"/>',
whatsapp:'<path d="M21 11.5a8.8 8.8 0 0 1-13 7.7L3 20l1.2-5A8.8 8.8 0 1 1 21 11.5Z"/><path d="M8.5 8.3c.6 3.6 3.1 6.2 6.6 6.8l1.3-1.2"/>',
calendar:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/>',
map:'<path d="M20 10c0 5.5-8 12-8 12S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.6"/>',
info:'<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>'
};
const cityCards = cityIds.map(id => {
 const m=meta[id],hub=id==='zuerich-hub',c=clinicById(hub?'zuerich-oerlikon':id),planned=c.status!=='operational';
 const href=hub?'/en/acupuncture-zurich/':enLocationPath(c.id);
 const img=m.image??c.bild?.src;
 const address=hub?'Three Zürich clinics to choose from':c.street&&c.postalCode?c.street+', '+c.postalCode+' '+c.city:'Central Switzerland · Opening 2027';
 const hours=planned?'Opening 2027 · Waitlist':c.openingHours.length?c.openingHours.map(x=>esc(x.replace(/Mo/g,'Mon').replace(/Fr/g,'Fri').replace(/Sa/g,'Sat').replace(/-/g,'–'))).join('<br>'):'Hours on request';
 const visual=img?'<img class="home-loc-img" src="'+esc(img)+'" alt="'+esc(m.illustration?'Illustration of TCM.ch '+m.name:'TCM.ch '+m.name)+'" width="1200" height="675" loading="lazy" decoding="async">':'<span class="home-loc-upcoming-visual" aria-hidden="true"><span>TCM.CH</span><strong>'+esc(m.name)+'</strong></span>';
 const badge=m.illustration?'<span class="home-loc-visual-note">Illustration</span>':'';
 const action=(kind:string,url:string,label:string,extra='')=>'<a class="home-loc-action home-loc-action--'+kind+'" href="'+esc(url)+'" aria-label="'+esc(label)+'" title="'+esc(label)+'"'+extra+'><svg viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+icons[kind]+'</svg><small>'+({phone:'Call',whatsapp:'WhatsApp',calendar:planned?'Waitlist':'Book',map:hub?'Clinics':'Directions',info:'Info'}[kind]||'Info')+'</small></a>';
 const book=hub?href+'#zh-funnel':planned?href:'#home-contact-form';
 const route=hub?href+'#standorte':planned?href:mapsDirectionsUrl(c);
 const wa='https://wa.me/'+c.phone.replace(/\D/g,'')+'?text='+encodeURIComponent('Hello, I would like to '+(planned?'join the waitlist':'request an appointment')+' in '+m.name+'.');
 return '<article class="home-loc-card home-loc-card--image home-loc-card--hwang'+(planned?' home-loc-card--planned':'')+' reveal" aria-label="TCM.ch '+esc(m.name)+'"><a class="home-loc-visual" href="'+esc(href)+'">'+visual+badge+'</a><div class="home-loc-main"><h3 class="home-loc-name"><a class="home-loc-more" href="'+esc(href)+'">'+esc(m.name)+'</a></h3>'+(planned?'<span class="home-loc-status">Opening 2027</span>':'')+'<p class="home-loc-address">'+esc(address)+'</p><div class="home-loc-actions" role="group" aria-label="Actions for '+esc(m.name)+'">'+action('phone','tel:'+c.phone.replace(/[^+\d]/g,''),'Call '+m.name)+action('whatsapp',wa,'WhatsApp '+m.name,' target="_blank" rel="noopener noreferrer"')+action('calendar',book,planned?'Join waitlist':'Request an appointment',!planned&&!hub?' data-pick="'+esc(c.name)+'"':'')+action(planned?'info':'map',route,hub?'Zürich clinics':planned?'Location information':'Directions',!planned&&!hub?' target="_blank" rel="noopener noreferrer"':'')+'</div><div class="home-loc-hours"><span class="home-loc-hours-label">'+(planned?'Status':'Opening hours')+'</span><span>'+hours+'</span></div></div></article>';
}).join('');
const photos = [
 {src:architecture.hanokAndModern.originalReferenceUrl,alt:'Traditional Korean hanok and contemporary glass architecture at Wonnam Temple in Seoul',label:'Our roots · Korea & Won Buddhism',cls:'heritage-tile--licensed heritage-tile--first',w:1000,h:750},
 {src:'/images/img-9ddc7d8df590.webp',alt:'TCM.ch team at a photo shoot',label:'The fourth generation · TCM.ch',cls:'heritage-tile--people',w:720,h:520},
 {src:'https://cdn.prod.website-files.com/67b0345c66f48f117fbcc562/685ba70fc3905327089d7168_tinywow_579A1800_81910170.webp',alt:'Praxis Hwang reception in Kreuzlingen',label:'Praxis Hwang · since 2012',cls:'heritage-tile--hwang',w:1200,h:800},
 {src:architecture.timberCorridor.originalReferenceUrl,alt:'Light-filled timber corridor at Wonnam Temple in Seoul',label:'Won Buddhist roots · Seoul',cls:'heritage-tile--corridor',w:667,h:1000}
];
---

<Layout title="Acupuncture & TCM in Switzerland · English-speaking appointments | TCM.ch"
 description="Acupuncture & Traditional Chinese Medicine across German-speaking Switzerland, with requests and appointments in English. Clinics in Zürich, Winterthur, St. Gallen, Basel and Bern." path="/en/" schema={[...schema,faqLd]} homeMirror>
 <Fragment set:html={enHome.hero}/>
 <WinterSnow target="#heroPatient"/>
 <Fragment set:html={enHome.trust}/>
 <section class="heritage-story heritage-story--home" id="unsere-geschichte" aria-labelledby="heritage-home-title">
  <div class="wrap heritage-story-inner"><div class="heritage-story-copy">
   <p class="heritage-kicker">OUR STORY <span>·</span> IN SWITZERLAND SINCE 2012</p>
   <h2 id="heritage-home-title">Four generations.<br/><em>A new era of TCM.</em></h2>
   <p>Our family history stretches back four generations in Korea and is closely linked to Won Buddhism. The cleric Hwang Jikpyeong helped shape this tradition. In 2012 we founded Praxis Hwang in Kreuzlingen. Today TCM.ch carries this heritage forward with qualified practitioners, personal care and modern processes.</p>
   <a class="heritage-story-link" href="/ueber-uns/" hreflang="de">Discover our story (German) <span aria-hidden="true">→</span></a>
  </div><div class="heritage-gallery heritage-gallery--home" aria-label="Photos of Korea, Praxis Hwang and TCM.ch">{photos.map(p=><figure class={'heritage-tile '+p.cls}><img src={p.src} alt={p.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" width={p.w} height={p.h}/><figcaption>{p.label}</figcaption></figure>)}</div></div>
 </section>
 <Fragment set:html={enHome.therapies}/>
 <Fragment set:html={enHome.conditions}/>
 <Fragment set:html={enHome.ins}/>
 <Fragment set:html={enHome.quote}/>
 <Fragment set:html={enHome.cities.replace('<!--en-city-cards-->',cityCards)}/>
 <Fragment set:html={enHome.feedback}/>
 <Fragment set:html={enHome.intro}/>
 <section id="home-contact-form" class="section contact-section-inline home-kontakt-section" aria-labelledby="home-kontakt-heading">
  <div class="wrap home-kontakt-shell"><div class="home-kontakt-layout"><Fragment set:html={enHome.contact}/>
  <div class="home-kontakt-form-panel" aria-label="Appointment enquiry"><div class="inline-form-card kf kf--ruhig kf-huelle"><div class="kf-kopf"><h3 class="kf-h inline-form-title">Send us a message.</h3><p class="kf-kopf-sub">Free and without obligation. We will reply personally.</p></div>
  <AppointmentForm id="en-home-form" source="/en/" heading="" intro="" /></div></div></div></div>
 </section>
 <section class="section hf-section" id="haeufige-fragen" style="background:var(--bg)"><div class="wrap"><div class="hf-head reveal"><span class="glb-label">Your first appointment</span><h2 class="glb-title">Well prepared. Easy to get started.</h2><p class="glb-sub">Everything you need to plan your next step.</p></div><div class="hf-grid reveal">{faqs.map(f=><details class="hf-item"><summary><span class="hf-q">{f.q}</span><span class="hf-icon" aria-hidden="true">+</span></summary><div class="hf-a">{f.a}</div></details>)}</div><div class="hf-actions reveal"><a class="hf-appointment-cta" href="#home-contact-form">Request an appointment</a><a class="hf-questions-link" href="/en/knowledge/">More patient information →</a></div></div></section>
 <ClinicConcierge lang="en"/>
 <Fragment set:html={enHome.marquee}/>
</Layout>
<script is:inline>
(function(){
 var d=new Date(),mmdd=(d.getMonth()+1)*100+d.getDate();
 if(mmdd>=1112&&mmdd<=1226)document.documentElement.classList.add('tcm-santa-season');
 document.addEventListener('click',function(e){
  var a=e.target.closest&&e.target.closest('a[data-free-intro]');
  if(!a)return;
  var input=document.querySelector('#en-home-form [name="anliegen"]');
  if(input&&!input.value)input.value='I would like to request a free 30-minute introductory appointment, if available at my preferred location. ';
 });
})();
</script>
<style is:global>
body.en-home-mirror .hf-head{max-width:680px;margin-bottom:24px}
body.en-home-mirror .hf-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px;margin-bottom:25px;align-items:start}
body.en-home-mirror .hf-item{display:block;background:#fff;border:1px solid var(--border);border-radius:16px;padding:0 20px}
body.en-home-mirror .hf-item summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px;padding:16px 0;list-style:none;cursor:pointer}
body.en-home-mirror .hf-item summary::-webkit-details-marker{display:none}
body.en-home-mirror .hf-item[open] .hf-icon{transform:rotate(45deg)}
body.en-home-mirror .hf-a{padding:0 0 19px;font-size:14px;line-height:1.6;color:var(--muted)}
@media(max-width:800px){body.en-home-mirror .hf-grid{grid-template-columns:1fr}}
</style>
