---
import Layout from '../../layouts/Layout.astro';
import Premium from '../../components/en/Premium.astro';
import Hero from '../../components/en/Hero.astro';
import ClinicCard from '../../components/en/ClinicCard.astro';
import Journey from '../../components/en/Journey.astro';
import Insurance from '../../components/en/Insurance.astro';
import BrandSignature from '../../components/BrandSignature.astro';
import { clinics } from '../../data/locations';
import { conditions, enConditionPath } from '../../data/conditions';
import { therapies, enTherapyPath } from '../../data/therapies';
import { getTherapeut, getPublicTherapistProfile } from '../../data/therapeuten';
const featured = ['zuerich-hoengg','basel','st-gallen','winterthur-marktgasse','frauenfeld','kreuzlingen'].map(id=>clinics.find(c=>c.id===id)!).filter(c=>c.status==='operational');
const therapist = getPublicTherapistProfile(getTherapeut('corinna-reinhart')!);
const treatmentLabels:Record<string,string> = { acupuncture:'Fine-needle treatment', 'tuina-massage':'Chinese manual therapy', cupping:'Suction-cup treatment', 'chinese-herbal-medicine':'Individual herbal prescriptions', moxibustion:'A traditional heat-based method', electroacupuncture:'Acupuncture with electrical stimulation' };
const faqs = [
 {q:'Can I request an appointment in English?',a:'Yes. Send your inquiry in English and tell us whether you also need your consultation in English. We check the practitioner and language requirements before confirming an appointment.'},
 {q:'How much will my appointment cost?',a:'Fees depend on the practice, practitioner, treatment and duration. Ask for the initial consultation fee and expected follow-up costs when arranging your appointment.'},
 {q:'Does every clinic offer every treatment?',a:'No. Treatments and practitioner qualifications vary by location. The local page is your starting point; the coordination team can confirm the service you need.'},
 {q:'Is sending a request the same as booking?',a:'No. The team contacts you to agree a suitable appointment. An inquiry does not reserve a time slot.'},
];
const schema = {'@context':'https://schema.org','@type':'WebPage','@id':'https://tcm.ch/en/#webpage',url:'https://tcm.ch/en/',name:'Acupuncture & Traditional Chinese Medicine in Switzerland',inLanguage:'en',about:{'@id':'https://tcm.ch/#org'}};
---
<Layout title="Acupuncture & Traditional Chinese Medicine in Switzerland | TCM.ch" description="Explore acupuncture and TCM in Switzerland. Find a clinic, understand treatment options and insurance, and request your appointment in English." path="/en/" schema={schema}>
<Premium>
  <Hero eyebrow="Modern TCM · Switzerland" title="Acupuncture & TCM. Care that starts with you." lead="Explore Traditional Chinese Medicine across our Swiss network. Find your clinic, understand your options and request an appointment in English." image="/images/img-67b9921801f9.webp" imageAlt="Two people in conversation in TCM.ch clothing" caption="TCM.ch brand imagery" primaryHref="#clinics" primaryLabel="Find your clinic" secondaryHref="/en/contact/" secondaryLabel="Request an appointment" />
  <section class="en-section" id="clinics"><div class="wrap">
    <div class="en-heading"><div><span class="en-label">Find your clinic</span><h2>Closer to your everyday life.</h2><p class="en-intro">Choose an operating practice. TCM.ch coordinates inquiries across its clinics and partner practices.</p></div><a class="en-link" href="/en/locations/">All locations →</a></div>
    <div class="en-grid">{featured.map(clinic=><ClinicCard clinic={clinic} />)}</div>
    <p class="en-note" style="margin-top:24px">Looking for another location? <a href="/en/locations/#future">See planned locations and status updates</a>.</p>
  </div></section>
  <section class="en-section en-concrete"><div class="wrap">
    <span class="en-label">Start with your concern</span><h2>What would you like help with?</h2><p class="en-intro">Explore the options, limitations and questions to discuss with a practitioner.</p>
    <div class="en-grid en-grid--four">{conditions.map(c=><a class="en-card" href={enConditionPath(c.slug)}><h3>{c.condition}</h3><span class="en-card-link">Read the guide ↗</span></a>)}</div>
  </div></section>
  <section class="en-section"><div class="wrap">
    <div class="en-heading"><div><span class="en-label">Our treatments</span><h2>Understand your options.</h2><p class="en-intro">Learn what each method involves. Availability depends on the clinic and practitioner.</p></div><a class="en-link" href="/en/therapies/">All treatments →</a></div>
    <div class="en-grid">{therapies.filter(t=>treatmentLabels[t.slug]).map(t=><a class="en-card" href={enTherapyPath(t.slug)}><span class="en-status">{treatmentLabels[t.slug]}</span><h3>{t.name}</h3><span class="en-card-link">Explore treatment ↗</span></a>)}</div>
  </div></section>
  <Journey /><Insurance />
  <section class="en-section"><div class="wrap en-split"><div><span class="en-label">The people behind your care</span><h2>Get to know your practitioner.</h2><p class="en-intro">Training and experience belong to individual people. Read their published background and ask who will be looking after you.</p></div>
    <article class="en-card en-person">{therapist.bild && <img src={therapist.bild} alt={therapist.name} width="120" height="120" loading="lazy" />}<div><span class="en-label">{therapist.ortLabel}</span><h3>{therapist.name}</h3><p>TCM practitioner with an OdA AM certificate in acupuncture / Tuina and a background in nursing.</p><a class="en-link" href={`/team/${therapist.slug}/`} hreflang="de-CH">Qualifications & profile (German) →</a></div></article>
  </div></section>
  <BrandSignature eyebrow="THIS IS TCM.CH" heading="One network. Your next step." description="Find the practice that fits your location and needs." ctaHref="/en/locations/" ctaLabel="Explore our clinics" />
  <section class="en-section"><div class="wrap en-split"><div><span class="en-label">Before you book</span><h2>Your questions, answered.</h2><a class="en-link" href="/en/knowledge/">Explore our English guides →</a></div><div class="en-faq">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
  <section class="en-section en-dark"><div class="wrap"><span class="en-label">Let’s find your next step</span><h2>Tell us what you need.</h2><p>Share your preferred location, times and consultation language. We’ll help coordinate your request.</p><a class="tcm-btn tcm-btn--mint" href="/en/contact/">Request an appointment ↗</a></div></section>
</Premium>
</Layout>
