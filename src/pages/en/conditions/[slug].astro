---
import Layout from '../../../layouts/Layout.astro';
import HeroSplit from '../../../components/en/HeroSplit.astro';
import CtaBand from '../../../components/en/CtaBand.astro';
import { site } from '../../../data/site';
import {
  conditions, INSURANCE_FAQ, REVIEWED_DATE, enConditionPath, conditionBySlug, conditionImages, type Condition,
} from '../../../data/conditions';
import { therapiesForCondition, enTherapyPath } from '../../../data/therapies';

export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { condition: c } }));
}

interface Props { condition: Condition }
const { condition } = Astro.props;
const { slug, condition: name, keyword, lead, intro, howWeTreat, evidence, redFlags, related } = condition;

const path = enConditionPath(slug);
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;
const contactHref = `/en/contact/?beschwerde=${encodeURIComponent(name)}`;

const title = `Acupuncture for ${name} | TCM.ch`;
const h1 = `Acupuncture & TCM for ${name}`;
const description = `Acupuncture for ${keyword} in Switzerland, in English: how we treat it, what the evidence says and when to see a doctor first. Reimbursement may be available via supplementary insurance.`;

// Condition-specific FAQs + the shared insurance FAQ (display + schema stay in sync).
const faqs = [...condition.faqs, INSURANCE_FAQ];

// Related conditions for cross-linking (EN -> EN).
const relatedConditions = related.map(conditionBySlug).filter(Boolean) as Condition[];

// Therapies commonly used for this condition (cross-link back to therapy pages).
const relevantTherapies = therapiesForCondition(slug);

// Hero image - same asset the DE Beschwerde page uses.
const image = conditionImages[slug];

// ── JSON-LD: MedicalWebPage + FAQPage + BreadcrumbList ──
const medicalLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: h1,
  url,
  inLanguage: 'en',
  description,
  lastReviewed: REVIEWED_DATE,
  about: { '@type': 'MedicalCondition', name },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  author: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/en/' },
  reviewedBy: {
    '@type': 'Organization',
    name: 'TCM.ch',
    url: 'https://tcm.ch/en/',
    description: 'Practitioners of Traditional Chinese Medicine in Switzerland; recognition (EMR/ASCA) is practitioner-specific.',
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Conditions', item: 'https://tcm.ch/en/conditions/' },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};
---
<Layout title={title} description={description} path={path} schema={[medicalLd, faqLd, breadcrumbLd]}>
  <HeroSplit
    eyebrow="TCM.ch · Conditions"
    h1={h1}
    lead={lead}
    ctas={[{ href: contactHref, label: 'Request an appointment' }, { href: '/en/locations/', label: 'Find a clinic', kind: 'outline' }]}
    trust={['Honest, evidence-aware guidance', 'Supplementary insurance: depends on your policy', 'English-speaking requests']}
    image={image ? { src: image.src, alt: image.alt, caption: 'TCM.ch clinic' } : undefined}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { href: '/en/conditions/', label: 'Conditions' }, { label: name }]}
  />

  <section class="ev-section">
    <div class="wrap">
      <div class="ev-split">
        <article class="ev-article">
          {intro.map((p) => <p>{p}</p>)}

          <h2>How we treat {name} at TCM.ch</h2>
          {howWeTreat.map((p) => <p>{p}</p>)}

          <h2>What the evidence says</h2>
          <p>{evidence}</p>
          <p class="evidence-note">
            We base this on general clinical guidelines and systematic reviews (e.g. Cochrane, PubMed-indexed
            research). The honest summary: studies vary in quality and findings, and individual results differ.
          </p>

          <h2>When to see a doctor first</h2>
          <p>Acupuncture is a complement, not a substitute for medical assessment. See a doctor first if you have:</p>
          <ul class="redflags">
            {redFlags.map((r) => <li>{r}</li>)}
          </ul>

          <h2>FAQ</h2>
          <div class="ev-faq">
            {faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>

          {relevantTherapies.length > 0 && (
            <>
              <h2>Therapies we might use</h2>
              <p>Depending on what we find, treatment for {name.toLowerCase()} may draw on:</p>
              <ul>
                {relevantTherapies.map((t) => (
                  <li><a href={enTherapyPath(t.slug)}>{t.name}</a></li>
                ))}
              </ul>
              <p><a href="/en/therapies/">See all therapies</a></p>
            </>
          )}

          <div class="ev-note-box">
            <strong>Next steps:</strong>
            <a href="/en/locations/">Find a clinic near you</a>
            <a href="/en/acupuncture-zurich/">Acupuncture in Zürich</a>
            <a href="/en/health-insurance-acupuncture/">Is this covered by insurance?</a>
          </div>

          <p class="ev-disclaimer">
            This page is general information, not medical advice, and does not promise any cure or specific
            outcome. If symptoms are severe, sudden or worsening, see a doctor.
          </p>
        </article>

        <aside class="ev-panel" aria-label="Appointments">
          <h3>Request an appointment</h3>
          <p>Tell us briefly what is going on and where you live. We suggest a clinic and a time, and reply personally in English or German.</p>
          <a class="ev-btn ev-btn--solid" href={contactHref}>Request an appointment</a>
          <a class="ev-btn ev-btn--wa" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hello, I would like to ask about acupuncture for ${name.toLowerCase()}.`)}`} target="_blank" rel="noopener" style="margin-top:10px;width:100%">WhatsApp</a>
          <hr />
          <h3>Insurance</h3>
          <p style="font-size:14px;color:rgba(2,11,16,.68)">Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition. <a href="/en/health-insurance-acupuncture/">How it works</a></p>
        </aside>
      </div>
    </div>
  </section>

  {relatedConditions.length > 0 && (
    <section class="ev-section ev-section--tint">
      <div class="wrap">
        <p class="ev-label">Related</p>
        <h2 class="ev-h2">Related conditions</h2>
        <div class="ev-grid">
          {relatedConditions.map((c) => (
            <a class="ev-card ev-card--media" href={enConditionPath(c.slug)}>
              {conditionImages[c.slug] && <img src={conditionImages[c.slug].src} alt={conditionImages[c.slug].alt} width="1120" height="746" loading="lazy" decoding="async" />}
              <div class="ev-card__body"><h3>{c.condition}</h3><p>{c.summary}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title={`Acupuncture for ${name.toLowerCase()}?`} text="Tell us briefly what is going on and where you would like to be seen. We say honestly whether TCM makes sense in your case." primary={{ href: contactHref, label: 'Request an appointment' }} secondary={{ href: '/en/conditions/', label: 'All conditions' }} />
</Layout>

