---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
import {
  conditions, INSURANCE_FAQ, enConditionPath, conditionBySlug, conditionImages, type Condition,
} from '../../../data/conditions';
import { therapiesForCondition, enTherapyPath } from '../../../data/therapies';

export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { condition: c } }));
}

interface Props { condition: Condition }
const { condition } = Astro.props;
const { slug, condition: name, keyword, lead, intro, howWeTreat, evidence, redFlags, related } = condition;

const path = enConditionPath(slug);
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;
const contactHref = `/en/contact/?beschwerde=${encodeURIComponent(name)}`;

const title = `Acupuncture for ${name} | TCM.ch`;
const h1 = `Acupuncture & TCM for ${name}`;
const description = `Acupuncture and TCM for ${keyword}: treatment options, evidence, warning signs and practical questions for patients in Switzerland.`;

// Condition-specific FAQs + the shared insurance FAQ (display + schema stay in sync).
const faqs = [...condition.faqs, INSURANCE_FAQ];

// Related conditions for cross-linking (EN -> EN).
const relatedConditions = related.map(conditionBySlug).filter(Boolean) as Condition[];

// Therapies commonly used for this condition (cross-link back to therapy pages).
const relevantTherapies = therapiesForCondition(slug);

// Hero image - same asset the DE Beschwerde page uses.
const image = conditionImages[slug];

// ── JSON-LD: MedicalWebPage + FAQPage + BreadcrumbList ──
const medicalLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: h1,
  url,
  inLanguage: 'en',
  description,
  about: { '@type': 'MedicalCondition', name },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  author: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/en/' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Conditions', item: 'https://tcm.ch/en/conditions/' },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import ArticleNav from '../../../components/en/ArticleNav.astro';
import NextSteps from '../../../components/en/NextSteps.astro';
import Sources from '../../../components/en/Sources.astro';
import { editorialSources } from '../../../data/en-editorial';
---
<Layout title={title} description={description} path={path} schema={[medicalLd, faqLd, breadcrumbLd]}>
<Premium><div class="wrap en-breadcrumb"><a href="/en/">Home</a> / <a href="/en/conditions/">Conditions</a></div>
<Hero eyebrow="Conditions · Patient guide" title={h1} lead={lead} image={image?.src} imageAlt={image?.alt} caption={image ? 'Illustrative treatment image' : undefined} primaryHref={contactHref} primaryLabel="Ask about treatment" secondaryHref="#evidence" secondaryLabel="Read the evidence" />
<section class="en-section"><div class="wrap en-article-layout"><ArticleNav items={[{id:'overview',label:'Overview'},{id:'medical-care',label:'Medical assessment'},{id:'approach',label:'Your consultation'},{id:'evidence',label:'Evidence'},{id:'faq',label:'Questions'}]}/><article class="en-reading"><h2 id="overview">Understanding {name.toLowerCase()}</h2>{intro.map(p=><p>{p}</p>)}
<h2 id="medical-care">When medical assessment comes first</h2><p>Acupuncture should not delay diagnosis. Seek medical assessment for the following warning signs; use emergency care for sudden or severe symptoms:</p><ul>{redFlags.map(r=><li>{r}</li>)}</ul>
<h2 id="approach">Discussing a treatment plan</h2>{howWeTreat.map(p=><p>{p}</p>)}
<div class="en-checklist"><h3>Make the first conversation useful</h3><p>Note when symptoms began, what makes them better or worse, treatments already tried and the change that would matter most to your daily life. Bring relevant reports and a medication list.</p><p>Agree a review point. If symptoms do not improve, or change in character, the plan needs reassessment.</p></div>
<h2 id="evidence">Evidence and limitations</h2><p>{evidence}</p><Sources sources={editorialSources[slug] ?? []}/>
{relevantTherapies.length > 0 && <><h2 id="options">Treatment options to discuss</h2><p>These methods may be discussed after assessment. The list does not mean each is effective for every cause of {name.toLowerCase()} or available at every clinic.</p><ul>{relevantTherapies.map(t=><li><a href={enTherapyPath(t.slug)}>{t.name}</a></li>)}</ul></>}
<h2 id="faq">Your questions</h2><div class="en-faq">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div><p class="en-note">General information, not a diagnosis or an individual treatment recommendation. No particular outcome is guaranteed.</p></article></div></section>
{relatedConditions.length > 0 && <section class="en-section en-concrete"><div class="wrap"><span class="en-label">Keep exploring</span><h2>Related conditions</h2><div class="en-grid">{relatedConditions.map(c=><a class="en-card" href={enConditionPath(c.slug)}><h3>{c.condition}</h3><p>{c.summary}</p><span class="en-card-link">Read the guide →</span></a>)}</div></div></section>}<NextSteps href={contactHref}/></Premium></Layout>
