---
import Layout from '../../../layouts/Layout.astro';
import HeroSplit from '../../../components/en/HeroSplit.astro';
import CtaBand from '../../../components/en/CtaBand.astro';
import { conditions, enConditionPath, conditionImages } from '../../../data/conditions';

const path = '/en/conditions/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Conditions', item: 'https://tcm.ch/en/conditions/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: conditions.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.condition,
    url: new URL(enConditionPath(c.slug), 'https://tcm.ch').href,
  })),
};
---
<Layout
  title="Conditions We Treat with Acupuncture & TCM | TCM.ch"
  description="What we treat with acupuncture & TCM in Switzerland: back pain, neck pain, migraine, sleep, stress, digestion and fertility. Honest guides in English, with when to see a doctor first."
  path={path}
  schema={[breadcrumbLd, itemListLd]}
>
  <HeroSplit
    eyebrow="TCM.ch · Conditions"
    h1="Conditions we treat with acupuncture &amp; <em>TCM</em>"
    lead="The conditions people most often come to us for. We are honest and evidence-aware: acupuncture and Traditional Chinese Medicine are a complementary approach, results vary, and we flag when to see a doctor first."
    ctas={[{ href: '/en/contact/', label: 'Request an appointment' }, { href: '/en/locations/', label: 'Find a clinic', kind: 'outline' }]}
    trust={['Honest, evidence-aware guidance', 'Supplementary insurance: depends on your policy', 'English-speaking requests']}
    image={{ src: '/images/img-4357832d6bef.webp', alt: 'Acupuncture treatment at a TCM.ch clinic', caption: 'TCM.ch clinic' }}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { label: 'Conditions' }]}
  />

  <section class="ev-section" id="all">
    <div class="wrap">
      <p class="ev-label">All guides</p>
      <h2 class="ev-h2">{conditions.length} conditions, one standard.</h2>
      <p class="ev-sub">Each guide covers how we treat the condition, what the evidence says, red flags and the therapies we might use. Condition guides own the problem; treatment-decision articles ("acupuncture for X") live in <a href="/en/knowledge/">Knowledge</a>.</p>
      <div class="ev-grid ev-grid--4">
        {conditions.map((c) => (
          <a class="ev-card ev-card--media" href={enConditionPath(c.slug)}>
            {conditionImages[c.slug] && <img src={conditionImages[c.slug].src} alt={conditionImages[c.slug].alt} width="1120" height="746" loading="lazy" decoding="async" />}
            <div class="ev-card__body"><h3>{c.condition}</h3><p>{c.summary}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ev-section ev-section--tint">
    <div class="wrap">
      <div class="ev-grid">
        <a class="ev-card" href="/en/therapies/"><h3>Our therapies</h3><p>Acupuncture, cupping, Tuina, Chinese herbal medicine and more: what each method is and when it fits.</p></a>
        <a class="ev-card" href="/en/acupuncture-zurich/"><h3>Acupuncture in Zürich</h3><p>All Zürich practices on one page: tell us your district and we suggest the practice or the next available appointment.</p></a>
        <a class="ev-card" href="/en/health-insurance-acupuncture/"><h3>Insurance &amp; costs</h3><p>Basic versus supplementary cover, practitioner recognition (EMR/ASCA) and how reimbursement works.</p></a>
      </div>
    </div>
  </section>

  <CtaBand text="Not sure whether TCM makes sense for your complaint? Tell us briefly what is going on; we say so honestly and suggest the nearest clinic." />
</Layout>
