---
import Layout from '../../../layouts/Layout.astro';
import { conditions, enConditionPath, conditionImages } from '../../../data/conditions';

const path = '/en/conditions/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Conditions', item: 'https://tcm.ch/en/conditions/' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: conditions.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.condition,
    url: new URL(enConditionPath(c.slug), 'https://tcm.ch').href,
  })),
};

import Premium from '../../../components/en/Premium.astro';
import Hero from '../../../components/en/Hero.astro';
import NextSteps from '../../../components/en/NextSteps.astro';
---
<Layout title="Conditions: Acupuncture & TCM in Switzerland | TCM.ch" description="Explore common reasons people consider acupuncture and TCM. Each guide explains treatment options, the limits of the evidence and when to see a doctor first." path={path} schema={[breadcrumbLd,itemListLd]} >
<Premium><Hero eyebrow="TCM.ch · Conditions" title="Start with what is troubling you." lead="Explore common reasons people consider acupuncture and TCM. Each guide explains treatment options, the limits of the evidence and when to see a doctor first." primaryHref="#explore" primaryLabel="Explore the guides" secondaryHref="/en/contact/" secondaryLabel="Ask a question"/>
<section class="en-section"><div class="wrap en-split"><div><span class="en-label">Care starts with understanding</span><h2>A symptom is a starting point, not a diagnosis.</h2><p>Similar symptoms can have different causes. Use these guides to prepare your questions, then discuss the right next step with a qualified professional.</p></div><div><h3>Prepare for your consultation</h3><p>Bring a short symptom timeline, any diagnosis or reports, your medication list and details of what you have tried. Tell us what improvement would matter most to you.</p><a class="en-link" href="/en/knowledge/what-to-expect-first-acupuncture-session/">Your first appointment →</a></div></div></section>
<section class="en-section en-concrete" id="explore"><div class="wrap"><span class="en-label">Explore conditions</span><h2>Find your starting point</h2><div class="en-grid">{conditions.map(c=><a class="en-card en-card--image" href={enConditionPath(c.slug)}>{conditionImages[c.slug] && <img src={conditionImages[c.slug].src} alt={conditionImages[c.slug].alt} width="1120" height="746" loading="lazy" decoding="async"/>}<div class="en-card-body"><h3>{c.condition}</h3><p>{c.summary}</p><span class="en-card-link">Options, evidence & next steps →</span></div></a>)}</div></div></section><NextSteps/></Premium></Layout>
