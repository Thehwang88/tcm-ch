---
// /en/acupuncture-zurich/ — Zürich flagship funnel (Wave 2). Structure mirrors the DE homepage section
// rhythm (split hero → trust strip → location discovery → therapies → conditions → steps → insurance →
// local context → FAQ → final inline form + CTA). Counterpart of DE /akupunktur-tcm-zuerich/ (PAIR_MAP).
// NO clinic entity, no address, no hours here: practice entities live on the location pages.
// Facts only from locations.ts / zuerich-termin.ts. Live since 02.11.2026: TCM.ch Bahnhofstrasse (zuerich-city) and TCM.ch Oerlikon.
import Layout from '../../layouts/Layout.astro';
import HeroSplit from '../../components/en/HeroSplit.astro';
import UspStrip from '../../components/en/UspStrip.astro';
import AppointmentForm from '../../components/en/AppointmentForm.astro';
import CtaBand from '../../components/en/CtaBand.astro';
import { site } from '../../data/site';
import { enLocationPath, formatHours, type Clinic } from '../../data/locations';
import { zuerichStandorte, ZH_FLEXIBEL } from '../../data/zuerich-termin';
import { waHref } from '../../data/standorte';
import { therapies, enTherapyPath, therapyImages } from '../../data/therapies';
import { conditions, enConditionPath } from '../../data/conditions';

const path = '/en/acupuncture-zurich/';
const url = site.url + path;
const zh: Clinic[] = zuerichStandorte();
const hoengg = zh.find((c) => c.id === 'zuerich-hoengg')!;
const oerlikon = zh.find((c) => c.id === 'zuerich-oerlikon')!;
const city = zh.find((c) => c.id === 'zuerich-city')!;
const phone = '+41 77 523 61 22';
const telHref = 'tel:' + phone.replace(/\s/g, '');
const wa = waHref(phone, 'Hello, I am looking for a TCM practice in Zürich.');
const INSURANCE = "Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition.";

// Form options: operational Zürich practices → name; planned → vorab options (EN label, DE routing value);
// plus the flexible option (same value as the DE funnel so routing stays identical).
const options = [
  ...zh.flatMap((c) => c.status === 'operational'
    ? [{ value: c.name, label: c.name }]
    : (c.vorab ?? []).map((o) => ({ value: o.value, label: o.labelEn ?? o.label }))),
  { value: ZH_FLEXIBEL.value, label: 'Next available appointment in Zürich' },
];
const districts = ['City / Centre', 'Stadelhofen', 'Seefeld', 'Hottingen', 'Enge', 'Wiedikon', 'Altstetten', 'Zürich West', 'Wollishofen', 'Oerlikon', 'Höngg', 'Unterstrass', 'Oberstrass', 'Schwamendingen', 'Affoltern', 'Albisrieden', 'Zürichberg'];
const featured = ['acupuncture', 'chinese-herbal-medicine', 'tuina-massage', 'cupping'].map((s) => therapies.find((t) => t.slug === s)!);
const topConditions = ['back-pain', 'neck-pain', 'migraine-headaches', 'stress-burnout', 'sleep-problems', 'fertility-support'].map((s) => conditions.find((c) => c.slug === s)!);
const faqs = [
  { q: 'Which Zürich practice should I choose?', a: 'You do not have to decide. Tell us your district and what matters to you, the nearest practice or the earliest slot, and we suggest the practice that fits: TCM.ch Bahnhofstrasse in the city centre, TCM.ch Oerlikon, or the partner practice in Höngg.' },
  { q: 'Can I request the earliest available appointment?', a: 'Yes. Choose "Next available appointment in Zürich" in the form. We look for the earliest free slot at our Zürich practices and get back to you personally with a proposal.' },
  { q: 'Can I communicate in English?', a: 'Yes. Requests, replies and appointment coordination are in English or German, as you prefer. Tell us if you would like to be treated in English and we take that into account when suggesting a practice.' },
  { q: 'Does supplementary insurance reimburse acupuncture?', a: 'Not through basic insurance. ' + INSURANCE + ' We tell you which recognition (EMR/ASCA) the treating practitioner holds and check your cover with you before the first appointment.' },
  { q: 'Where is the city-centre clinic?', a: `TCM.ch Bahnhofstrasse is at ${city.street}, ${city.postalCode} Zürich, on the first floor. TCM.ch is not yet listed on the directory at the ground-floor entrance: please look for "Medthera", a shared practice. On the first floor, TCM.ch is on the practice door.` },
  { q: 'What happens after I submit the form?', a: 'We read your request personally and reply, usually with a concrete suggestion for a practice and a time. Nothing is booked automatically: your appointment is confirmed by the team once you agree to the proposal. You can also reach us on WhatsApp or by phone.' },
];
const hoenggHours = hoengg.openingHours.map(formatHours);

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${url}#webpage`,
    name: 'Acupuncture & TCM in Zürich', url, inLanguage: 'en',
    about: { '@id': 'https://tcm.ch/#org' }, publisher: { '@id': 'https://tcm.ch/#org' },
    spatialCoverage: { '@type': 'City', name: 'Zürich' },
    mainEntity: { '@type': 'ItemList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: `TCM.ch Bahnhofstrasse – ${city.street}, ${city.postalCode} Zürich`, url: `https://tcm.ch${enLocationPath(city.id)}` },
      { '@type': 'ListItem', position: 2, name: `TCM.ch Oerlikon – ${oerlikon.street}, ${oerlikon.postalCode} Zürich`, url: `https://tcm.ch${enLocationPath(oerlikon.id)}` },
      { '@type': 'ListItem', position: 3, name: `Zürich Höngg – ${hoengg.betreiber?.name}, partner practice in the TCM.ch network`, url: `https://tcm.ch${enLocationPath(hoengg.id)}` },
    ] },
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://tcm.ch/en/locations/' },
    { '@type': 'ListItem', position: 3, name: 'Zürich', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const check = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
---
<Layout
  title="Acupuncture & TCM in Zürich · English-speaking appointments | TCM.ch"
  description="Acupuncture & TCM in Zürich in English: TCM.ch clinics on Bahnhofstrasse and in Oerlikon, plus a partner practice in Höngg. Tell us your district or ask for the next available appointment."
  path={path}
  schema={schema}
>
  <!-- 1 · Split hero (DE homepage .sr-hero concept: Mint left, team photo right) -->
  <HeroSplit
    eyebrow="TCM.ch · Zürich"
    h1="Acupuncture &amp; TCM<br>in <em>Zürich.</em>"
    lead="Medical acupuncture and Traditional Chinese Medicine for people living in Zürich. Tell us what is going on and where you are; we find the practice and the appointment that fit, in English."
    ctas={[{ href: '#zh-funnel', label: 'Find an appointment' }, { href: wa, label: 'WhatsApp', kind: 'wa', external: true }]}
    trust={['Personal reply in English', 'City centre, Oerlikon and Höngg', 'No referral needed']}
    note={`Prefer to talk? Call <b>${phone}</b>.`}
    image={{ src: '/images/team-zuerich.webp', alt: 'The TCM.ch team: EMR/ASCA-registered practitioners', width: 1536, height: 1024 }}
  />

  <!-- 2 · Trust / USP strip -->
  <UspStrip items={[
    { icon: 'chat', title: 'Personal appointment coordination', sub: 'A person reads your request and replies with a concrete proposal. Nothing is booked automatically.' },
    { icon: 'users', title: 'Qualified practitioners', sub: 'Trained in TCM, experienced in Switzerland. Recognition (EMR/ASCA) is practitioner-specific; we tell you before you book.' },
    { icon: 'pin', title: 'Zürich locations', sub: 'Bahnhofstrasse (district 1), Oerlikon (district 11) and Höngg (district 10).' },
    { icon: 'shield', title: 'Supplementary insurance guidance', sub: 'Reimbursement may be available depending on your policy. We check your cover with you first.' },
  ]} />

  <!-- 3 · Find your Zürich practice (DE home location discovery, Zürich-specific) -->
  <section class="ev-section" id="practices">
    <div class="wrap">
      <p class="ev-label">Find your Zürich practice</p>
      <h2 class="ev-h2">Three practices <em>across Zürich.</em></h2>
      <p class="ev-sub">Choose a practice, or let us pick the earliest slot for you. Partner practices are independent practices in the TCM.ch network; TCM.ch coordinates your request.</p>
      <div class="ev-grid">
        <div class="ev-pick">
          <span class="ev-card__meta">{city.postalCode} Zürich · District 1</span>
          <h3>Zürich Bahnhofstrasse <span class="ev-badge ev-badge--neutral">TCM.ch clinic</span></h3>
          <p class="ev-pick__addr">TCM.ch Bahnhofstrasse, {city.street}, 1st floor</p>
          <p>In the city centre. At the entrance, look for "Medthera" on the directory; TCM.ch is on the practice door on the first floor. Appointments on request.</p>
          <div class="ev-pick__actions">
            <a class="ev-btn ev-btn--solid" href="#zh-funnel" data-pick={city.name}>Request here</a>
            <a class="ev-pick__link" href={enLocationPath(city.id)}>Practice details</a>
          </div>
        </div>
        <div class="ev-pick">
          <span class="ev-card__meta">{hoengg.postalCode} Zürich · District 10</span>
          <h3>Zürich Höngg <span class="ev-badge ev-badge--neutral">Partner practice</span></h3>
          <p class="ev-pick__addr">{hoengg.betreiber?.name}, {hoengg.street}</p>
          <p>Open now. Published hours: {hoenggHours.join(', ')}. Acupuncture, cupping, Tuina and Chinese herbal medicine.</p>
          <div class="ev-pick__actions">
            <a class="ev-btn ev-btn--solid" href="#zh-funnel" data-pick={hoengg.name}>Request here</a>
            <a class="ev-pick__link" href={enLocationPath(hoengg.id)}>Practice details</a>
          </div>
        </div>
        <div class="ev-pick">
          <span class="ev-card__meta">{oerlikon.postalCode} Zürich · District 11</span>
          <h3>Zürich Oerlikon <span class="ev-badge ev-badge--neutral">TCM.ch clinic</span></h3>
          <p class="ev-pick__addr">TCM.ch Oerlikon, {oerlikon.street}</p>
          <p>Near Oerlikon station, for Zürich North and the Glattal. Appointments on request; opening hours are published once confirmed.</p>
          <div class="ev-pick__actions">
            <a class="ev-btn ev-btn--solid" href="#zh-funnel" data-pick={oerlikon.name}>Request here</a>
            <a class="ev-pick__link" href={enLocationPath(oerlikon.id)}>Practice details</a>
          </div>
        </div>
      </div>
      <p class="ev-sub" style="margin:22px 0 0">Not sure? Ask for the <a href="#zh-funnel" data-pick={ZH_FLEXIBEL.value}>next available appointment in Zürich</a> and we choose for you. Other regions: <a href="/en/locations/">all TCM.ch locations</a>.</p>
    </div>
  </section>

  <!-- 4 · Treatments (DE home svc-cards) -->
  <section class="ev-section ev-section--tint" id="treatments">
    <div class="wrap">
      <p class="ev-label">Our therapies</p>
      <h2 class="ev-h2">How we treat.</h2>
      <p class="ev-sub">Methods of Traditional Chinese Medicine offered at our Zürich practices. Each page explains the method, what a session is like and what the evidence says, without cure promises.</p>
      <div class="ev-grid ev-grid--4">
        {featured.map((t) => (
          <a class="ev-card ev-card--media" href={enTherapyPath(t.slug)}>
            <div class="ev-card__photo"><img src={therapyImages[t.slug].src} alt={therapyImages[t.slug].alt} width="1120" height="746" loading="lazy" decoding="async" /></div>
            <div class="ev-card__body"><h3>{t.name}</h3><p>{t.summary}</p><ul class="ev-badges"><li>Supplementary insurance</li><li>Zürich</li></ul><span class="ev-card__arrow">Learn more →</span></div>
          </a>
        ))}
      </div>
      <p class="ev-sub" style="margin:22px 0 0"><a href="/en/therapies/">All therapies</a></p>
    </div>
  </section>

  <!-- 5 · Conditions (DE home condition discovery) -->
  <section class="ev-section" id="conditions">
    <div class="wrap">
      <p class="ev-label">What we can help with</p>
      <h2 class="ev-h2">Many come to us when conventional care <em>reaches its limits.</em></h2>
      <p class="ev-sub">We tell you honestly whether TCM makes sense in your case. Each guide explains how we work, how many sessions are realistic and when to see a doctor first.</p>
      <div class="ev-grid">
        {topConditions.map((c) => <a class="ev-card" href={enConditionPath(c.slug)}><h3>{c.condition}</h3><p>{c.summary}</p><span class="ev-card__arrow">Read the guide →</span></a>)}
      </div>
      <p class="ev-sub" style="margin:22px 0 0"><a href="/en/conditions/">All conditions</a></p>
    </div>
  </section>

  <!-- 6 · How appointments work (DE home pj-funnel) -->
  <section class="ev-section ev-section--tint" id="how-it-works">
    <div class="wrap">
      <div class="ev-center">
        <p class="ev-label">How it works</p>
        <h2 class="ev-h2">From your request to a confirmed appointment.</h2>
        <p class="ev-sub">Three steps, one personal contact. No automatic booking.</p>
      </div>
      <ol class="ev-steps ev-steps--3">
        <li><h3>Tell us what you need</h3><p>Form, WhatsApp or phone, in English or German. Your complaint in a sentence, your district and preferred times are enough.</p></li>
        <li><h3>We identify the suitable Zürich practice</h3><p>We check our Zürich practices for the fit and the earliest slot, and clarify insurance questions beforehand.</p></li>
        <li><h3>Confirm your appointment with the team</h3><p>You receive a concrete proposal and confirm it with us. Only then is your appointment fixed.</p></li>
      </ol>
    </div>
  </section>

  <!-- 7 · Insurance and costs (DE home kkc grid) -->
  <section class="ev-section" id="insurance">
    <div class="wrap">
      <div class="ev-center">
        <p class="ev-label">Insurance &amp; costs</p>
        <h2 class="ev-h2">Does my insurance reimburse <em>the treatment?</em></h2>
      </div>
      <div class="ev-kk">
        <div class="ev-kk__item"><h3>Supplementary insurance</h3><p>{INSURANCE} Check with your insurer, or let us help.</p></div>
        <div class="ev-kk__item"><h3>Practitioner recognition</h3><p>EMR and ASCA are the registers most Swiss supplementary insurers reference. Recognition is practitioner-specific, so we tell you which recognition the practitioner treating you holds before your first appointment.</p></div>
        <div class="ev-kk__item"><h3>Basic insurance</h3><p>Mandatory basic insurance covers acupuncture only when a doctor with the relevant training performs it. Therapist-led TCM, as at our practices, is not reimbursed through basic insurance.</p></div>
      </div>
      <p class="ev-sub" style="margin:22px auto 0;text-align:center"><a href="/en/health-insurance-acupuncture/">The full insurance guide in plain English</a> · <a href="/en/knowledge/how-much-does-acupuncture-cost-in-switzerland/">What acupuncture costs in Switzerland</a></p>
    </div>
  </section>

  <!-- 8 · Zürich local context (DE Zürich page: districts, practices, crew photo) -->
  <section class="ev-section ev-offer" id="zurich">
    <div class="wrap">
      <img class="ev-offer__img" src="/images/tcm-ch-crew-zuerich-west-1254.webp" srcset="/images/tcm-ch-crew-zuerich-west-640.webp 640w, /images/tcm-ch-crew-zuerich-west-960.webp 960w, /images/tcm-ch-crew-zuerich-west-1254.webp 1254w" sizes="(max-width: 1280px) 100vw, 1200px" alt="The TCM.ch team in Zürich West" width="1254" height="627" loading="lazy" decoding="async" />
      <div class="ev-split">
        <div class="ev-prose">
          <p class="ev-label">Across the whole of Zürich</p>
          <h2 class="ev-h2">For residents and international patients in Zürich.</h2>
          <p>Whichever district you live or work in, we check which practice fits you best and how quickly you can be seen. Our three practices are spread across the city.</p>
          <ul class="ev-chips">{districts.map((d) => <li>{d}</li>)}</ul>
          <p style="margin-top:14px">Your district is not listed? You can still request an appointment from anywhere in Zürich and the surrounding Glattal and Limmattal.</p>
          <h3>TCM.ch clinics and partner practices, explained</h3>
          <p>A <strong>TCM.ch clinic</strong> (Bahnhofstrasse, Oerlikon) is run by TCM.ch. A <strong>partner practice</strong> (Höngg) is an independent practice in the TCM.ch network: you are treated by its practitioners, and TCM.ch coordinates your request and answers questions about costs and insurance.</p>
        </div>
        <aside class="ev-panel" aria-label="Zürich practices">
          <h3>Höngg · District 10</h3>
          <p><strong>{hoengg.betreiber?.name}</strong><br />{hoengg.street}, {hoengg.postalCode} Zürich<br />{hoenggHours.join(' · ')}</p>
          <p><a href={enLocationPath(hoengg.id)}>Practice details</a></p>
          <hr />
          <h3>Oerlikon · District 11</h3>
          <p><strong>TCM.ch Oerlikon</strong><br />{oerlikon.street}, {oerlikon.postalCode} Zürich, near Oerlikon station</p>
          <p><a href={enLocationPath(oerlikon.id)}>Practice details</a></p>
          <hr />
          <h3>Bahnhofstrasse · District 1</h3>
          <p><strong>TCM.ch Bahnhofstrasse</strong><br />{city.street}, 1st floor, {city.postalCode} Zürich</p>
          <p><a href={enLocationPath(city.id)}>Practice details</a></p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 9 · FAQ -->
  <section class="ev-section" id="faq">
    <div class="wrap">
      <p class="ev-label">FAQ</p>
      <h2 class="ev-h2">Questions before your first appointment.</h2>
      <div class="ev-faq" style="max-width:820px">
        {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <!-- 10 · Final conversion (DE home inline form section): ONE form on the page -->
  <section class="ev-section ev-final" id="zh-funnel">
    <div class="wrap">
      <div class="ev-center">
        <p class="ev-label">Find an appointment</p>
        <h2 class="ev-h2">Request your appointment in <em>Zürich.</em></h2>
        <p class="ev-sub">Choose a practice or the next available appointment. We reply personally in English or German; nothing is booked until you confirm.</p>
      </div>
      <div class="ev-split">
        <AppointmentForm id="en-zurich-form" source={path} options={options} anyLabel="No preference, please recommend" heading="" intro="" />
        <aside class="ev-panel" aria-label="Direct contact">
          <h3>Prefer to talk?</h3>
          <p><a href={telHref}>{phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <a class="ev-btn ev-btn--wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
          <hr />
          <h3>What you can expect</h3>
          <ul style="list-style:none;padding:0;margin:0">
            <li style="display:flex;gap:8px;border:0;padding:4px 0"><Fragment set:html={check} /><span>A personal reply, not an automated booking</span></li>
            <li style="display:flex;gap:8px;border:0;padding:4px 0"><Fragment set:html={check} /><span>A concrete practice and time proposal</span></li>
            <li style="display:flex;gap:8px;border:0;padding:4px 0"><Fragment set:html={check} /><span>Insurance questions clarified beforehand</span></li>
          </ul>
          <hr />
          <p style="font-size:13px;color:rgba(2,11,16,.62)">Your data is used only to handle your request and is not shared. Protected by Cloudflare Turnstile. See our <a href="/datenschutz/" hreflang="de">privacy policy (German)</a>.</p>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand title="Rather ask first?" text="Yuna from the TCM.ch concierge answers questions about treatment, appointments and insurance on WhatsApp, free and without obligation." primary={{ href: wa, label: 'Ask on WhatsApp', external: true }} secondary={{ href: telHref, label: `Call ${phone}` }} />

</Layout>

<style is:global>
  /* Hero right: Zürich team photo (team-zuerich.webp, 10 people) as cover, same crop table as the DE funnel
     /akupunktur-tcm-zuerich/: object-position by container aspect ratio, no face halved at an edge. HeroSplit unchanged. */
  html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-fit: cover; object-position: 58% 10%; }
  @container (aspect-ratio < 1.175) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 86.5% 10%; } }
  @container (aspect-ratio < 1.075) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 73% 10%; } }
  @container (aspect-ratio < 0.995) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 26% 10%; } }
  @container (aspect-ratio < 0.945) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 55.5% 10%; } }
  @container (aspect-ratio < 0.84) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 43.5% 10%; } }
  @container (aspect-ratio < 0.765) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 12.5% 10%; } }
  @container (aspect-ratio < 0.715) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 18% 10%; } }
  @container (aspect-ratio < 0.66) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 36% 10%; } }
  @media (max-width: 900px) { html[lang="en"] [data-hero] .ev-hero__media img[src^="/images/team-zuerich.webp"] { object-position: 58% 10%; } }
</style>
