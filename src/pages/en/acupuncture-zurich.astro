---
// /en/acupuncture-zurich/ — citywide Zürich acquisition funnel (hub & spoke → the Zürich practices).
// Counterpart of DE /akupunktur-tcm-zuerich/ (PAIR_MAP). NO clinic entity, no address, no hours here:
// the practice entities live on the location pages. Zürich City is "in preparation" (DE page only,
// no address) and is never offered as an appointment option. Form options come from zuerich-termin.ts.
import Layout from '../../layouts/Layout.astro';
import HeroSplit from '../../components/en/HeroSplit.astro';
import UspStrip from '../../components/en/UspStrip.astro';
import AppointmentForm from '../../components/en/AppointmentForm.astro';
import CtaBand from '../../components/en/CtaBand.astro';
import { site } from '../../data/site';
import { enLocationPath, type Clinic } from '../../data/locations';
import { zuerichStandorte, ZH_FLEXIBEL } from '../../data/zuerich-termin';
import { waHref } from '../../data/standorte';
import { therapies, enTherapyPath, therapyImages } from '../../data/therapies';
import { conditions, enConditionPath } from '../../data/conditions';

const path = '/en/acupuncture-zurich/';
const url = site.url + path;
const zh: Clinic[] = zuerichStandorte();
const phone = '+41 77 523 61 22';
const wa = waHref(phone, 'Hello, I am looking for a TCM practice in Zürich.');

// Form options: operational Zürich practices → name; planned → vorab options (EN label, DE value);
// plus the flexible option (same value as the DE funnel so routing stays identical).
const options = [
  ...zh.flatMap((c) => c.status === 'operational'
    ? [{ value: c.name, label: c.name }]
    : (c.vorab ?? []).map((o) => ({ value: o.value, label: o.labelEn ?? o.label }))),
  { value: ZH_FLEXIBEL.value, label: 'Next available appointment in Zürich' },
];
const districts = ['City / Centre', 'Stadelhofen', 'Seefeld', 'Hottingen', 'Enge', 'Wiedikon', 'Altstetten', 'Zürich West', 'Wollishofen', 'Oerlikon', 'Höngg', 'Unterstrass', 'Oberstrass', 'Schwamendingen', 'Affoltern', 'Albisrieden', 'Zürichberg'];
const featured = ['acupuncture', 'cupping', 'tuina-massage', 'chinese-herbal-medicine'].map((s) => therapies.find((t) => t.slug === s)!);
const topConditions = ['back-pain', 'neck-pain', 'migraine-headaches', 'sleep-problems', 'stress-burnout', 'fertility-support'].map((s) => conditions.find((c) => c.slug === s)!);
const faqs = [
  { q: 'Do I need to know which practice is the right one?', a: 'No. Tell us where in Zürich you are looking for an appointment and what matters to you, the nearest practice or the earliest slot. We suggest the practice that fits.' },
  { q: 'Can I simply ask for the next available appointment?', a: 'Yes. Choose "Next available appointment in Zürich" in the form; we look for the earliest free slot at our Zürich practices and get back to you personally.' },
  { q: 'Can I ask from any Zürich district?', a: 'Yes. The network practices in Höngg and Oerlikon are reachable by public transport from the whole city. Tell us your district and we suggest the practice that fits.' },
  { q: 'Are the costs covered by supplementary insurance?', a: 'Not through basic insurance. Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner\'s recognition. We check the treating practitioner\'s recognition and your cover with you before the first appointment.' },
  { q: 'What if nothing is free at the nearest practice?', a: 'Then we offer you the next available appointment at another Zürich practice. You decide whether to wait or switch.' },
  { q: 'Is there a TCM.ch practice in the city centre?', a: 'A city-centre location is in preparation; there is no confirmed address or date yet, so it cannot be booked. Until then we treat you in Höngg and Oerlikon.' },
];
const practiceDesc = (c: Clinic) => c.status === 'operational'
  ? (c.betreiber ? `${c.betreiber.name}, ${c.street}. Partner practice; TCM.ch coordinates your request.` : `${c.street}, ${c.postalCode} ${c.city}.`)
  : `Partner practice Praxis Hwang, Schulstrasse 3 today; new TCM.ch clinic at ${c.street} planned (${c.openingNote ?? 'in preparation'}).`;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${url}#webpage`,
    name: 'Acupuncture & TCM in Zürich', url, inLanguage: 'en',
    about: { '@id': 'https://tcm.ch/#org' }, publisher: { '@id': 'https://tcm.ch/#org' },
    spatialCoverage: { '@type': 'City', name: 'Zürich' },
    mainEntity: { '@type': 'ItemList', itemListElement: [
      ...zh.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.betreiber ? `${c.name} – ${c.betreiber.name}, partner practice in the TCM.ch network` : `${c.name} – Praxis Hwang (Schulstrasse 3) and planned TCM.ch clinic (${c.street})`, url: `https://tcm.ch${enLocationPath(c.id)}` })),
      { '@type': 'ListItem', position: zh.length + 1, name: 'Zürich City – location in preparation (German page)', url: 'https://tcm.ch/standorte/zuerich-city/' },
    ] },
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://tcm.ch/en/locations/' },
    { '@type': 'ListItem', position: 3, name: 'Zürich', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout
  title="Acupuncture & TCM in Zürich · Höngg & Oerlikon practices | TCM.ch"
  description="Acupuncture & TCM in Zürich in English: Praxis Hwang partner practices in Höngg and Oerlikon, new TCM.ch clinic at Ohmstrasse 14 planned. Tell us your district; we find the appointment."
  path={path}
  schema={schema}
>
  <HeroSplit
    eyebrow="TCM.ch · Zürich"
    h1="Acupuncture &amp; TCM in <em>Zürich</em>"
    lead="You do not need to know which of our practices is the right one. Tell us where in Zürich you are looking for an appointment; we check our practices and find the option that fits."
    sub="Today in Höngg and Oerlikon (Praxis Hwang partner practices); a new TCM.ch clinic in Oerlikon and a city-centre location are in preparation."
    ctas={[{ href: '#zh-funnel', label: 'Find an appointment' }, { href: wa, label: 'WhatsApp', kind: 'wa', external: true }]}
    trust={['Request by WhatsApp or phone', 'Supplementary insurance: depends on your policy', 'Personal reply in English']}
    note="Prefer to talk? Call <b>+41 77 523 61 22</b>."
    image={{ src: '/images/tcm-ch-crew-zuerich-west-1254.webp', alt: 'The TCM.ch team in Zürich West', caption: 'TCM.ch team, Zürich' }}
    crumbs={[{ href: '/en/', label: 'TCM.ch' }, { href: '/en/locations/', label: 'Locations' }, { label: 'Zürich' }]}
  />
  <UspStrip />

  <section class="ev-section" id="practices">
    <div class="wrap">
      <p class="ev-label">Our practices in Zürich</p>
      <h2 class="ev-h2">Two practices today, more in preparation.</h2>
      <div class="ev-grid">
        {zh.map((c) => (
          <a class="ev-card" href={enLocationPath(c.id)}>
            <span class="ev-card__meta">{c.postalCode} {c.city}</span>
            <h3>{c.name}{c.betreiber && <span class="ev-badge ev-badge--neutral">Partner</span>}{c.status !== 'operational' && <span class="ev-badge">Planned</span>}</h3>
            <p>{practiceDesc(c)}</p>
            <span class="ev-card__arrow">Details &amp; appointment →</span>
          </a>
        ))}
        <a class="ev-card" href="/standorte/zuerich-city/" hreflang="de">
          <span class="ev-card__meta">Zürich</span>
          <h3>Zürich City<span class="ev-badge">In preparation</span><span class="ev-badge ev-badge--neutral">DE</span></h3>
          <p>A city-centre location is in preparation: no confirmed address or date yet, not bookable. Details on the German page.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="ev-section ev-section--tint" id="zh-funnel">
    <div class="wrap">
      <div class="ev-split">
        <AppointmentForm id="en-zurich-form" source={path} options={options} anyLabel="No preference, please recommend" heading="Find an appointment in Zürich" intro="Choose a practice or the next available appointment. Tell us your district and what matters to you; we reply personally in English or German." />
        <aside class="ev-panel" aria-label="Zürich districts">
          <h3>Across the whole of Zürich</h3>
          <p style="font-size:14.5px">Whichever district you are in, we check which practice fits you best.</p>
          <ul class="ev-chips" style="margin-bottom:16px">{districts.map((d) => <li>{d}</li>)}</ul>
          <p style="font-size:14px;color:rgba(2,11,16,.68)">Your district is not listed? You can still request an appointment from anywhere in Zürich.</p>
          <hr />
          <h3>Prefer to talk?</h3>
          <p><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <a class="ev-btn ev-btn--wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="ev-section" id="conditions">
    <div class="wrap">
      <p class="ev-label">What we can help with</p>
      <h2 class="ev-h2">Many come to us when conventional care reaches its limits.</h2>
      <p class="ev-sub">We tell you honestly whether TCM makes sense in your case. Each guide explains how we work and where the limits lie.</p>
      <div class="ev-grid">
        {topConditions.map((c) => <a class="ev-card" href={enConditionPath(c.slug)}><h3>{c.condition}</h3><p>{c.summary}</p></a>)}
      </div>
    </div>
  </section>

  <section class="ev-section ev-section--tint" id="treatments">
    <div class="wrap">
      <p class="ev-label">Treatments in Zürich</p>
      <h2 class="ev-h2">Acupuncture, and more than needles.</h2>
      <div class="ev-grid ev-grid--4">
        {featured.map((t) => (
          <a class="ev-card ev-card--media" href={enTherapyPath(t.slug)}>
            <img src={therapyImages[t.slug].src} alt={therapyImages[t.slug].alt} width="1120" height="746" loading="lazy" decoding="async" />
            <div class="ev-card__body"><h3>{t.name}</h3><p>{t.summary}</p></div>
          </a>
        ))}
      </div>
      <p class="ev-sub" style="margin:22px 0 0"><a href="/en/therapies/">All therapies</a> · <a href="/en/health-insurance-acupuncture/">Supplementary insurance? We check your cover with you.</a></p>
    </div>
  </section>

  <section class="ev-section" id="faq">
    <div class="wrap">
      <p class="ev-label">FAQ</p>
      <h2 class="ev-h2">The essentials in brief.</h2>
      <div class="ev-faq" style="max-width:820px">
        {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <CtaBand title="Find the right appointment in Zürich" text="Tell us your district or ask for the next available slot. We reply personally in English or German." primary={{ href: '#zh-funnel', label: 'Find an appointment' }} secondary={{ href: wa, label: 'WhatsApp', external: true }} />
</Layout>
