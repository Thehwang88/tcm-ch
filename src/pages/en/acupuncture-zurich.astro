---
// /en/acupuncture-zurich/ — Zürich flagship funnel (Wave 2). Structure mirrors the DE homepage section
// rhythm (split hero → trust strip → location discovery → therapies → conditions → steps → insurance →
// local context → FAQ → final inline form + CTA). Counterpart of DE /akupunktur-tcm-zuerich/ (PAIR_MAP).
// NO clinic entity, no address, no hours here: practice entities live on the location pages.
// Facts only from locations.ts / zuerich-termin.ts. Live since 02.11.2026: TCM.ch Bahnhofstrasse (zuerich-bahnhofstrasse) and TCM.ch Oerlikon.
import Layout from '../../layouts/Layout.astro';
import rawDe from '../../data/akupunktur-tcm-zuerich-body.html?raw';
import BrandSignature from '../../components/BrandSignature.astro';
import { therapyCards } from '../../data/therapy-cards';
import { NETZ_THERAPIEN } from '../../data/standorte';
import AppointmentForm from '../../components/en/AppointmentForm.astro';
import ClinicConcierge from '../../components/ClinicConcierge.astro';
import { site } from '../../data/site';
import { enLocationPath, formatHours, type Clinic } from '../../data/locations';
import { zuerichStandorte, ZH_FLEXIBEL } from '../../data/zuerich-termin';
import { waHref } from '../../data/standorte';
import { therapies, enTherapyPath, therapyImages } from '../../data/therapies';
import { conditions, enConditionPath } from '../../data/conditions';

const path = '/en/acupuncture-zurich/';
const url = site.url + path;
const zh: Clinic[] = zuerichStandorte();
const hoengg = zh.find((c) => c.id === 'zuerich-hoengg')!;
const oerlikon = zh.find((c) => c.id === 'zuerich-oerlikon')!;
const city = zh.find((c) => c.id === 'zuerich-bahnhofstrasse')!;
const phone = '+41 77 523 61 22';
const telHref = 'tel:' + phone.replace(/\s/g, '');
const wa = waHref(phone, 'Hello, I am looking for a TCM practice in Zürich.');
const INSURANCE = "Reimbursement may be available through Swiss supplementary insurance, depending on your policy, treatment and the individual practitioner's recognition.";

// Form options: operational Zürich practices → name; planned → vorab options (EN label, DE routing value);
// plus the flexible option (same value as the DE funnel so routing stays identical).
const options = [
  ...zh.flatMap((c) => c.status === 'operational'
    ? [{ value: c.name, label: c.name }]
    : (c.vorab ?? []).map((o) => ({ value: o.value, label: o.labelEn ?? o.label }))),
  { value: ZH_FLEXIBEL.value, label: 'Next available appointment in Zürich' },
];
const districts = ['City / Centre', 'Stadelhofen', 'Seefeld', 'Hottingen', 'Enge', 'Wiedikon', 'Altstetten', 'Zürich West', 'Wollishofen', 'Oerlikon', 'Höngg', 'Unterstrass', 'Oberstrass', 'Schwamendingen', 'Affoltern', 'Albisrieden', 'Zürichberg'];
const featured = ['acupuncture', 'chinese-herbal-medicine', 'tuina-massage', 'cupping'].map((s) => therapies.find((t) => t.slug === s)!);
const topConditions = ['back-pain', 'neck-pain', 'migraine-headaches', 'stress-burnout', 'sleep-problems', 'fertility-support'].map((s) => conditions.find((c) => c.slug === s)!);
const faqs = [
  { q: 'How do I find the right Zürich practice?', a: 'You do not have to decide. Tell us your district and what matters to you, the nearest practice or the earliest slot, and we suggest the practice that fits: TCM.ch Bahnhofstrasse in the city centre, TCM.ch Oerlikon, or the partner practice in Höngg.' },
  { q: 'Can I request the earliest available appointment?', a: 'Yes. Choose "Next available appointment in Zürich" in the form. We look for the earliest free slot at our Zürich practices and get back to you personally with a proposal.' },
  { q: 'Can I communicate in English?', a: 'Yes. Requests, replies and appointment coordination are in English or German, as you prefer. Tell us if you would like to be treated in English and we take that into account when suggesting a practice.' },
  { q: 'How can I check supplementary insurance reimbursement?', a: 'Not through basic insurance. ' + INSURANCE + ' We tell you which recognition (EMR/ASCA) the treating practitioner holds and check your cover with you before the first appointment.' },
  { q: 'Where is the city-centre clinic?', a: `TCM.ch Bahnhofstrasse is at ${city.street}, ${city.postalCode} Zürich, on the first floor. TCM.ch is not yet listed on the directory at the ground-floor entrance: please look for "Medthera", a shared practice. On the first floor, TCM.ch is on the practice door.` },
  { q: 'What happens after I submit the form?', a: 'We read your request personally and reply, usually with a concrete suggestion for a practice and a time. Nothing is booked automatically: your appointment is confirmed by the team once you agree to the proposal. You can also reach us on WhatsApp or by phone.' },
];
const hoenggHours = hoengg.openingHours.map(formatHours);

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${url}#webpage`,
    name: 'Acupuncture & TCM in Zürich', url, inLanguage: 'en',
    about: { '@id': 'https://tcm.ch/#org' }, publisher: { '@id': 'https://tcm.ch/#org' },
    spatialCoverage: { '@type': 'City', name: 'Zürich' },
    mainEntity: { '@type': 'ItemList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: `TCM.ch Bahnhofstrasse – ${city.street}, ${city.postalCode} Zürich`, url: `https://tcm.ch${enLocationPath(city.id)}` },
      { '@type': 'ListItem', position: 2, name: `TCM.ch Oerlikon – ${oerlikon.street}, ${oerlikon.postalCode} Zürich`, url: `https://tcm.ch${enLocationPath(oerlikon.id)}` },
      { '@type': 'ListItem', position: 3, name: `Zürich Höngg – ${hoengg.betreiber?.name}, partner practice in the TCM.ch network`, url: `https://tcm.ch${enLocationPath(hoengg.id)}` },
    ] },
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/en/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://tcm.ch/en/locations/' },
    { '@type': 'ListItem', position: 3, name: 'Zürich', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const check = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
const styleEnd = rawDe.indexOf('<div class="akz">');
if (styleEnd < 0) throw new Error('Zürich style boundary missing');
const sharedStyles = rawDe.slice(0, styleEnd);
if (/<script\b/i.test(sharedStyles)) throw new Error('Unexpected script in German style prefix');
const cards = [city,oerlikon,hoengg];
const names: Record<string,[string,string]> = {
akupunktur:['Acupuncture','Fine needles at specific points'], gesichtsakupunktur:['Facial acupuncture','Gentle needling for facial tension'], schroepfen:['Cupping','A traditional technique for muscular tension'], tuina:['Tuina massage','Manual treatment from Chinese medicine'], akupressur:['Acupressure','Targeted pressure without needles'], shiatsu:['Shiatsu','Japanese pressure massage'], 'gua-sha':['Gua Sha','Traditional scraping technique'], physiotherapie:['Physiotherapy','Movement and manual therapy on prescription'], kraeutertherapie:['Chinese herbal medicine','Individual herbal formulas'], moxibustion:['Moxibustion','Controlled warmth at specific points'], elektroakupunktur:['Electroacupuncture','Gentle electrical stimulation'], massage:['Medical massage','Manual treatment for muscular tension']
};
const mirrorCards = NETZ_THERAPIEN.slice(0,8).map(slug=>{
  const c=therapyCards[slug], n=names[slug], t=therapies.find(x=>x.deSlug===slug);
  if(!c||!n)throw new Error('Missing therapy card '+slug);
  return {...c,name:n[0],tagline:n[1],href:t?enTherapyPath(t.slug):'/therapien/'+slug+'/',time:c.time.replace('Min','min'),ins:slug==='physiotherapie'?'Basic insurance':'Supplementary insurance'};
});
const mirrorConditions = [['back-pain','Back pain','Acute or persistent pain.'],['neck-pain','Neck pain & tension','Including tension headaches.'],['migraine-headaches','Migraine & headaches','Explore treatment options.'],['sleep-problems','Sleep problems','Difficulty falling or staying asleep.'],['stress-burnout','Stress & burnout','Support for relaxation.'],['digestive-issues','Digestion','IBS, bloating and digestive complaints.']];
---

<Layout title="Acupuncture & TCM in Zürich · English-speaking appointments | TCM.ch" description="Acupuncture & TCM in Zürich in English: TCM.ch clinics on Bahnhofstrasse and in Oerlikon, plus a partner practice in Höngg. Tell us your district or ask for the next available appointment." path={path} schema={schema} zurichMirror>
<Fragment set:html={sharedStyles}/>
<section class="lsr-hero akzh"><div class="lsr-inner"><div class="lsr-left">
<div class="tsr-crumb" style="color:rgba(2,11,16,.72)"><a href="/en/" style="color:inherit">TCM.ch</a><span class="tsr-sep">›</span><a href="/en/locations/" style="color:inherit">Locations</a><span class="tsr-sep">›</span><span>Zürich</span></div>
<span class="lsr-eyebrow">TCM.ch network · Zürich</span><h1 class="lsr-h1">Acupuncture &amp; TCM in <em class="lsr-accent">Zürich</em></h1>
<p class="lsr-lead">Three locations in Zürich: Bahnhofstrasse, Oerlikon and Höngg. We help you find the right clinic and appointment, in English.</p><p class="lsr-lead zh-hero-mobile-summary">We find the right clinic and appointment for you.</p>
<div class="lsr-ctas"><a class="lsr-btn-primary" href="#zh-funnel">Request an appointment</a><a class="lsr-btn-ghost" href="/en/contact/">Discuss your concerns for free</a></div>
<div class="zh-hero-proof"><span><span class="lsr-check" aria-hidden="true">✓</span> EMR/ASCA-registered practitioners</span><span><span class="lsr-check" aria-hidden="true">✓</span> Supplementary insurance, subject to policy</span></div>
<p class="zh-hero-meta"><span>Bahnhofstrasse · Oerlikon · Höngg</span><a href={telHref}>{phone}</a></p></div>
<figure class="lsr-right lsr-right--foto lsr-right--team"><video class="zh-hero-video" autoplay muted loop playsinline preload="auto" poster="/images/team-zuerich.webp" aria-label="A look inside the TCM.ch clinics"><source src="https://s3.amazonaws.com/webflow-prod-assets/67a5beedc0990dd5d83dd737/6978a0d73021bbb5e606bac1_praxis_long_website%20copy%20(1).mp4" type="video/mp4"/></video></figure></div></section>
<section class="section" id="standorte"><div class="wrap"><div class="reveal" style="max-width:62ch;margin-bottom:36px"><div class="section-label">Locations in Zürich</div><h2 class="section-title">Our clinics <em>in Zürich</em></h2><p class="section-sub">Choose Bahnhofstrasse, Oerlikon or our partner clinic in Höngg – or let us recommend the right location.</p></div>
<div class="sc-grid sc-grid--3 zh-home-loc-grid">{cards.map(c=><article class="home-loc-card home-loc-card--image zh-home-loc-card" aria-label={'TCM.ch '+c.name}><a class="home-loc-visual" href={enLocationPath(c.id)} aria-label={'More information about '+c.name}>{c.bild&&<img class="home-loc-img" src={c.bild.src} alt={'TCM clinic in '+c.name} width="1200" height="675" loading="lazy" decoding="async"/>}</a><div class="home-loc-main"><h3 class="home-loc-name"><svg class="home-loc-pin" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 10c0 5.5-8 12-8 12S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.6"/></svg><span>{c.name}</span></h3></div><div class="home-loc-actions"><a class="home-loc-cta home-loc-cta--primary" href="#zh-funnel" data-pick={c.name}>Request an appointment</a><a class="home-loc-more" href={enLocationPath(c.id)}>More information →</a></div></article>)}</div>
<div class="zhx-routing zhx-routing--merged" style="margin-top:34px"><h3 class="section-title" style="font-size:clamp(23px,2.5vw,32px);margin-bottom:10px">Not sure <em>which clinic suits you?</em></h3><p class="section-sub" style="margin:0 auto 20px;max-width:58ch">Tell us where you are looking. We find the right clinic or the earliest available appointment.</p><div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap"><a class="btn-primary zhx-match-booking-cta" href="#zh-funnel">Find an appointment</a><a class="btn-secondary" href="#zh-funnel" data-pick={ZH_FLEXIBEL.value}>Next available appointment</a></div></div><p class="section-sub" style="margin-top:24px">Outside Zürich? See <a class="body-link" href="/en/locations/">all locations</a> or find <a class="body-link" href="/en/acupuncture-near-me/">acupuncture near you</a>.</p></div></section>
<section class="section contact-section-inline akz-funnel-section" id="zh-funnel" style="background:var(--surface);scroll-margin-top:68px"><div class="wrap"><div class="contact-inline-grid"><div class="reveal"><div class="section-label">Find the right care</div><h2 class="section-title">Find an appointment at TCM.ch in <em>Zürich.</em></h2><p class="section-sub" style="margin-bottom:0">Choose your location and leave your contact details. We will get back to you personally.</p><div class="intake-trust-row">{['TCM.ch network clinics in Zürich','Bahnhofstrasse, Oerlikon and Höngg','We coordinate the right clinic for you','Supplementary insurance, depending on policy'].map(t=><div class="intake-trust-item"><span class="intake-trust-dot"></span>{t}</div>)}</div><div class="contact-methods-mini"><a href={wa} class="contact-method-mini" target="_blank" rel="noopener"><div class="cm-icon-mini cm-wa">↗</div><div><strong>Start on WhatsApp</strong><span>Personal reply from the team</span></div></a><a href={telHref} class="contact-method-mini phone-quiet"><div class="cm-icon-mini cm-phone">☎</div><div><strong>Appointment coordination (Mon–Fri)</strong><span>{phone}</span></div></a><a href={'mailto:'+site.email} class="contact-method-mini"><div class="cm-icon-mini cm-mail">✉</div><div><strong>Email</strong><span>{site.email}</span></div></a></div></div><div class="reveal"><div class="inline-form-card kf kf--ruhig kf-huelle"><div class="kf-kopf"><h3 class="kf-h inline-form-title">Find an appointment at TCM.ch</h3><p class="kf-kopf-sub">We will suggest an appointment at one of our Zürich clinics.</p></div><AppointmentForm id="en-zurich-form" source={path} options={options} anyLabel="No preference, please recommend" heading="" intro=""/></div></div></div></div></section>
<section class="section zh-proof-section" style="background:#fff;padding:46px 0"><div class="wrap"><div class="section-label">Zürich at a glance</div><div class="zh-proof-grid" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px">{[['3 Zürich clinics','Bahnhofstrasse, Oerlikon and Höngg – one request is enough.'],['EMR / ASCA','Registered practitioners, depending on person and method.'],['Insurance check','We help you check your supplementary insurance before your visit.'],['Personal coordination','We suggest the right clinic or the earliest available appointment.']].map(([t,d])=><div class="city-card location-card"><div class="location-city">{t}</div><div class="location-desc">{d}</div></div>)}</div><div class="zh-proof-mobile"><span>✓ 3 Zürich locations</span><span>✓ Acupuncture &amp; TCM</span><span>✓ Personal appointment coordination</span></div></div></section>
<section class="section akz-beschwerden-section" style="background:#fff"><div class="wrap"><div class="reveal" style="max-width:60ch;margin-bottom:36px"><div class="section-label">What we help with</div><h2 class="section-title">How can we <em>help?</em></h2><p class="section-sub">Many come to us when conventional care reaches its limits. We tell you honestly whether TCM may be suitable for you.</p></div><div class="city-grid">{mirrorConditions.map(([slug,t,d])=><a class="city-card location-card" href={enConditionPath(slug)}><div class="location-city">{t}</div><div class="location-desc">{d}</div><span class="location-link">Learn more →</span></a>)}</div><p class="section-sub" style="margin-top:22px"><a class="body-link" href="/en/conditions/">View more conditions →</a></p></div></section>
<section class="section akz-kasse-section" style="background:#fff"><div class="wrap akz-mobile-disclosure"><div class="section-label">Insurance &amp; costs</div><p><strong>Supplementary insurance:</strong> Reimbursement depends on your policy and practitioner. We help you check.</p><details><summary>Insurance &amp; costs in detail <span aria-hidden="true">+</span></summary><p>{INSURANCE} Basic insurance generally does not cover therapist-led TCM.</p><p><a href="/en/health-insurance-acupuncture/">Insurance details</a> · <a href="/en/knowledge/how-much-does-acupuncture-cost-in-switzerland/">Treatment costs</a></p></details></div><div class="wrap akz-split"><div><div class="section-label">Insurance &amp; costs</div><h2 class="section-title">Supplementary insurance? <em>We help you check.</em></h2><p class="section-sub">{INSURANCE} See our <a class="body-link" href="/en/health-insurance-acupuncture/">acupuncture and insurance guide</a>.</p><div class="akz-chips">{['Helsana','CSS','Swica','Sanitas','Concordia'].map(x=><span class="akz-chip">{x}</span>)}</div><p class="section-sub" style="margin-top:16px">Not sure what your insurer covers? We can help clarify before your appointment. See <a class="body-link" href="/en/knowledge/how-much-does-acupuncture-cost-in-switzerland/">acupuncture costs in Switzerland</a>.</p></div><div><a class="city-card location-card" href="/en/health-insurance-acupuncture/"><div class="location-city">Free insurance check</div><div class="location-desc">Tell us your insurer and we can help clarify potential reimbursement. No obligation.</div><span class="location-link">Check coverage →</span></a></div></div></section>
<section class="section svc-section akz-therapien-section" id="zh-therapien"><div class="wrap"><div class="svc-header reveal"><div><div class="section-label">Our therapies</div><h2 class="section-title">Chinese medicine in Zürich: <em>our therapies</em></h2></div><p class="svc-sub">TCM methods at our Zürich clinics. We decide which approach is appropriate after your first consultation.</p></div><div class="svc-grid">{mirrorCards.map(c=><a class="svc-card reveal" href={c.href} style="text-decoration:none;color:inherit"><div class="svc-photo-wrap"><img width={c.w} height={c.h} src={c.img} alt={c.name} class="svc-photo" loading="lazy" decoding="async" style={'object-position:'+c.objectPos}/><div class="svc-photo-top-bar"></div></div><div class="svc-body"><div class="svc-name">{c.name}</div><div class="svc-tagline">{c.tagline}</div><div class="svc-meta"><span class="svc-badge svc-badge--time">{c.time}</span><span class="svc-badge svc-badge--ins">{c.ins}</span></div><div class="svc-cta">Learn more →</div></div></a>)}</div><p class="section-sub" style="margin-top:22px;max-width:72ch">Read about <a class="body-link" href="/en/therapies/acupuncture/">acupuncture</a> for <a class="body-link" href="/en/conditions/back-pain/">back pain</a>, <a class="body-link" href="/en/conditions/sleep-problems/">sleep problems</a> and <a class="body-link" href="/en/conditions/migraine-headaches/">migraine</a>.</p><p class="akz-txtlinks">More therapies: <a href="/en/therapies/chinese-herbal-medicine/">Chinese herbal medicine</a> <a href="/therapien/massage/" hreflang="de">Medical massage</a> <a href="/en/therapies/moxibustion/">Moxibustion</a> <a href="/en/therapies/electroacupuncture/">Electroacupuncture</a> <a href="/en/therapies/">All treatments →</a></p></div></section>
<section class="section zh-why-section" style="background:var(--surface)"><div class="wrap"><div class="zh-why-mobile"><div class="section-label">Why TCM.ch Zürich</div><h2>You don't need to know where to start.</h2><p>We help you find the right clinic and treatment.</p><div class="zh-why-mobile-points"><span>✓ One request for three clinics</span><span>✓ Find the right treatment</span><span>✓ Personal support</span></div></div><div class="zh-why-desktop"><div class="reveal" style="max-width:68ch;margin-bottom:32px"><div class="section-label">Why TCM.ch Zürich</div><h2 class="section-title">You don't need to know <em>where or how to start.</em></h2><p class="section-sub">Tell us what you need. We coordinate the clinic, appointment and next steps, and tell you if TCM is not the right first option.</p></div><div class="city-grid">{[['One request, three clinics','We check Bahnhofstrasse, Oerlikon and Höngg for you.'],['Find the right therapy','The appropriate method is considered after assessment.'],['Clarity about costs','We clarify insurance and potential charges before your first visit.']].map(([t,d])=><div class="city-card location-card"><div class="location-city">{t}</div><div class="location-desc">{d}</div></div>)}</div></div></div></section>
<section class="kk-section"><div class="wrap"><div class="kk-inner"><div class="kk-header" style="text-align:center"><div class="section-label">Frequently asked questions</div><h2 class="section-title" style="margin:0 auto 14px">What matters <em>most.</em></h2></div><div class="kk-faq">{faqs.map(f=><details class="kk-item"><summary class="kk-q">{f.q}<span class="kk-ico" aria-hidden="true">+</span></summary><div class="kk-a"><p>{f.a}</p></div></details>)}</div></div></div></section>
<section class="section akz-wissen-section" id="zh-wissen" style="background:var(--surface)"><div class="wrap akz-mobile-disclosure"><details><summary>Learn more about acupuncture &amp; TCM <span aria-hidden="true">+</span></summary><p>The right treatment depends on your concerns and first consultation. Seek medical attention for emergencies or new neurological symptoms.</p><p><a href="/en/therapies/acupuncture/">Acupuncture</a> · <a href="/en/therapies/tuina-massage/">Tuina</a> · <a href="/en/therapies/chinese-herbal-medicine/">Herbal medicine</a></p></details></div><div class="wrap akz-split"><div><div class="section-label">Acupuncture &amp; TCM in Zürich</div><h2 class="section-title">What to know <em>before treatment.</em></h2><p class="section-sub">Traditional Chinese Medicine includes acupuncture, Tuina, cupping, moxibustion and Chinese herbal medicine. The appropriate method depends on your history and assessment.</p><p class="section-sub" style="margin-top:14px">Acupuncture is the most widely studied TCM method and may be useful alongside medical care for persistent complaints. Emergencies, suspected fractures or new neurological symptoms need medical assessment first.</p><p class="section-sub" style="margin-top:14px">At your first appointment we explain what is realistic and whether we can help.</p></div><div><img class="akz-img" src="/images/img-c69a8f9ce7f8.webp" alt="Acupuncture treatment at TCM.ch in Zürich" loading="lazy" width="640" height="480"/></div></div></section>
<section class="section akz-quartiere-section" id="zh-quartiere"><div class="wrap" style="max-width:860px"><div class="section-label">Where are you looking?</div><h2 class="section-title">Here for you <em>across Zürich</em></h2><p class="section-sub">Whichever district you are in, we check which clinic is the best fit.</p><div class="zhx-chips" role="list">{districts.map(d=><a class:list={['zhx-chip',{'zhx-chip-x':['Hottingen','Unterstrass','Oberstrass','Affoltern','Albisrieden','Zürichberg'].includes(d)}]} hidden={['Hottingen','Unterstrass','Oberstrass','Affoltern','Albisrieden','Zürichberg'].includes(d)} role="listitem" href="#zh-funnel" data-district={d}>{d}</a>)}<button class="zhx-chip" id="en-zh-more" type="button" aria-expanded="false">+ more districts</button><a class="zhx-chip zhx-chip--other zhx-chip-x" hidden href="#zh-funnel" role="listitem">My district is not listed</a></div><p style="margin-top:18px;font-size:14px;color:var(--mid)">You can request an appointment from any other Zürich district as well.</p></div></section>
<BrandSignature warm imageSrc="/images/team-zuerich.webp" imageWidth={1536} imageHeight={1024} imagePosition="center center" imagePositionMobile="center 30%" imageAlt="TCM.ch team Zürich" eyebrow="THIS IS TCM.CH" heading="More than a clinic." description="People shaping modern TCM together." ctaHref="/en/locations/" ctaLabel="Get to know TCM.ch"/>
<section class="cta-band" style="background:#F2F4F2;padding:48px 0"><div class="wrap" style="text-align:center"><h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#020B10;letter-spacing:-.03em;margin:0 0 8px">Find your appointment in Zürich</h2><p style="font-size:15px;color:rgba(2,11,16,.7);margin:0 auto 28px;max-width:52ch">Tell us where you are looking. We find the right clinic or the next available appointment.</p><div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap"><a class="btn-primary" href="#zh-funnel" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Find an appointment</a><a href={telHref} style="display:inline-flex;align-items:center;font-weight:700;font-size:15px;color:#020B10;text-decoration:none;padding:14px 18px">Call directly</a><a href={wa} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;font-weight:700;font-size:15px;color:#020B10;text-decoration:none;padding:14px 18px">WhatsApp</a></div></div></section>
<ClinicConcierge lang="en" isZurichHub/>
</Layout>
<script is:inline>
(function(){var more=document.getElementById('en-zh-more');if(more)more.addEventListener('click',function(){document.querySelectorAll('#zh-quartiere .zhx-chip-x').forEach(function(c){c.hidden=false;c.classList.remove('zhx-chip-x')});more.hidden=true;more.setAttribute('aria-expanded','true')});document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('[data-district]');if(!a)return;var input=document.querySelector('#en-zurich-form [name="anliegen"]');if(input&&!input.value)input.value='Preferred district: '+a.getAttribute('data-district')+'\n';});})();
</script>
<style is:global>
html:has(main.akz #en-zurich-form){scroll-behavior:auto}
main.akz #en-zurich-form .ev-form__row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
main.akz #en-zurich-form .ev-field{display:flex;flex-direction:column;min-width:0;position:relative}
main.akz #en-zurich-form .ev-hp{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}
main.akz #en-zurich-form .ev-field textarea{min-height:100px!important}
main.akz #en-zurich-form .ev-field :is(input,select,textarea){pointer-events:auto;visibility:visible}

main.akz .reveal {opacity:1!important;transform:none!important}
main.akz .zh-hero-video {opacity:1!important}
main.akz .kk-q {cursor:pointer;list-style:none;width:100%;text-align:left}
main.akz .kk-q::-webkit-details-marker {display:none}
main.akz .kk-item:not([open]) .kk-a {display:none}
main.akz .kk-item[open] .kk-a {display:block;max-height:none!important;opacity:1!important;padding:0 0 18px}
main.akz .kk-item[open] .kk-ico {transform:rotate(45deg)}
main.akz .zhx-chip {text-decoration:none}
main.akz .zhx-chip[hidden] {display:none!important}
main.akz #en-zurich-form {box-shadow:none;border:0;border-radius:0;background:transparent;padding:0;margin:0}
main.akz #en-zurich-form .ev-field input, main.akz #en-zurich-form .ev-field select, main.akz #en-zurich-form .ev-field textarea {background:#f7f7f7;border:1px solid #dedede;border-radius:9px;color:#171b1a}
main.akz #en-zurich-form .ev-btn--solid {background:#1769B1;color:#fff;width:100%;border-color:#1769B1}
@media(max-width:767px){main.akz #en-zurich-form .ev-form__row{grid-template-columns:1fr}}
</style>
