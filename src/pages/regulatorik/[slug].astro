---
// Regulatorik-Leaf. Inhalte: src/data/regulatorik/pages.ts, Fakten/Quellen: sources.ts (Single Source).
// Indexierung hängt am Gate REGULATORIK_VERIFIED.
import LayoutDe from '../../layouts/LayoutDe.astro';
import RegulatoryMap from '../../components/reg/RegulatoryMap.astro';
import RegSources from '../../components/reg/RegSources.astro';
import RegSubnav from '../../components/reg/RegSubnav.astro';
import RegReview from '../../components/reg/RegReview.astro';
import { site } from '../../data/site';
import { REG_PAGES, type RegPage } from '../../data/regulatorik/pages';
import { REGULATORIK_VERIFIED } from '../../data/regulatorik/sources';
import '../../styles/b2b.css';

export function getStaticPaths() {
  return REG_PAGES.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: RegPage };
const path = `/regulatorik/${p.slug}`;
const url = new URL(path + '/', site.url).href;
const mapKey = ({ berufsausuebungsbewilligung: 'kanton', 'gln-zsr-nareg': 'gln', 'chinesische-arzneimittel-abgabe': 'arzneimittel' } as Record<string, string>)[p.slug] ?? p.slug;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: p.title, description: p.metaDesc, url, inLanguage: 'de-CH',
    ...(REGULATORIK_VERIFIED ? { lastReviewed: p.lastReviewed } : {}),
    publisher: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    audience: { '@type': 'Audience', audienceType: 'TCM therapists and practice owners' },
    isPartOf: { '@type': 'CollectionPage', name: 'TCM Regulatorik Schweiz', url: 'https://tcm.ch/regulatorik/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Regulatorik', item: 'https://tcm.ch/regulatorik/' },
    { '@type': 'ListItem', position: 3, name: p.h1, item: url } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<LayoutDe title={p.title} description={p.metaDesc} path={path} schema={schema} noindex={!REGULATORIK_VERIFIED} robots="noindex, follow">
  <div class="b2">
    <article class="b2-hero b2-hero--sm" style="padding-bottom:40px">
      <div class="b2-wrap">
        <RegSubnav current={path + '/'} />
        <div class="b2-art">
          <div class="b2-crumbs" role="navigation" aria-label="Breadcrumb"><a href="/">TCM.ch</a><span aria-hidden="true">/</span><a href="/fachpersonen/">Für Fachpersonen</a><span aria-hidden="true">/</span><a href="/regulatorik/">Regulatorik</a></div>
          <h1 class="b2-h1">{p.h1}</h1>
          <p class="b2-lead">{p.lead}</p>
          <RegReview ids={p.sources} lastReviewed={p.lastReviewed} />
          <div class="pro-short"><p class="b2-label" style="margin:0">Kurzantwort</p><p>{p.short}</p></div>
          <div class="b2-body" set:html={p.bodyHtml} />
          <RegulatoryMap here={mapKey} insurers={p.slug === 'krankenkassen-anerkennung'} />
          <div class="b2-cta">
            <p class="b2-label" style="margin:0 0 8px">{p.cta.commercial ? 'Angebot von TCM.ch' : 'Nächster Schritt'}</p>
            <p class="b2-h3">{p.cta.title}</p>
            {p.cta.text && <p>{p.cta.text}</p>}
            <a class="btn btn--primary" href={p.cta.href}>{p.cta.label}</a>
          </div>
          <div class="b2-faq" style="margin-top:48px">{p.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
          {p.ouch && <p class="pro-ouch"><small>Kommentar & Analyse im OUCH.-Magazin</small><a href={p.ouch.url} rel="noopener">{p.ouch.label}</a> – redaktionelle Perspektive, keine offizielle Quelle.</p>}
          <RegSources ids={p.sources} />
          <p class="b2-route" style="margin-top:32px"><a href="/regulatorik/">Alle Regulatorik-Themen</a> · <a href="/regulatorik/kantone/">Kanton-Navigator</a> · <a href="/praxiswissen/tcm-praxis-eroeffnen/">Praxis eröffnen</a> · <a href="/akademie/">Akademie</a></p>
        </div>
      </div>
    </article>
  </div>
</LayoutDe>
