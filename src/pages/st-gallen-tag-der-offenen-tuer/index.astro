---
// Ads-only event SALES page (noindex). Reuses real Standort sections by extracting their
// baked HTML fragments from st-gallen.html (SOURCE FILE UNTOUCHED) and re-skinning them on
// THIS page only. SpaPage gives home.css/home.js (so reused onclick handlers, reveal,
// reviews toggle, Turnstile all work). noindex => robots noindex + sitemap auto-excluded.
import SpaPage from '../../layouts/SpaPage.astro';
import sgRaw from '../../data/standort-leaves/st-gallen.html?raw';

const PREFILL = 'Anmeldung Tag der offenen Tür – St. Gallen (15.08.26). Ich hätte gern einen 30-Min-Slot (Anamnese & Diagnose).';
const waHref = 'https://wa.me/41775236122?text=' + encodeURIComponent(PREFILL);
const waSpontan = 'https://wa.me/41775236122?text=' + encodeURIComponent('Ich komme heute spontan zum Tag der offenen Tür in St. Gallen vorbei.');
const waFlyer = 'https://wa.me/41775236122?text=' + encodeURIComponent('Ich habe den Flyer mit Gutschein und möchte mein kostenloses Erstgespräch inkl. TCM-Kurzdiagnose in St. Gallen vereinbaren.');
const waLater = 'https://wa.me/41775236122?text=' + encodeURIComponent('Ich schaffe es heute nicht zum Tag der offenen Tür und möchte mein kostenloses Erstgespräch inkl. TCM-Kurzdiagnose in St. Gallen vereinbaren (bis 30.9.).');
const mapsHref = 'https://maps.google.com/?q=' + encodeURIComponent('TCM.ch St. Gallen, Oberer Graben 22, 9000 St. Gallen');

// ── reuse: stack-based section extraction from the Standort leaf ──
function secFromIdx(i) {
  const rx = /<section\b|<\/section>/g; rx.lastIndex = i; let d = 0, m;
  while ((m = rx.exec(sgRaw))) { if (m[0] === '</section>') { d--; if (d === 0) return sgRaw.slice(i, m.index + m[0].length); } else d++; }
  return '';
}
const secFrom = (a) => secFromIdx(sgRaw.indexOf(a));
const secAround = (a) => { const k = sgRaw.indexOf(a); return k < 0 ? '' : secFromIdx(sgRaw.lastIndexOf('<section', k)); };
// every section funnels to the single CTA: kill away-navigation in reused grids
const funnel = (h) => h.replace(/onclick="nav\([^)]*\)"/g, 'onclick="evtToForm()"');

let behandlungen = funnel(secFrom('<section class="section svc-section"'));
behandlungen = behandlungen.split('<div class="svc-photo-wrap">').join('<span class="evt-pill">15.8. gratis</span><div class="svc-photo-wrap">');
const team = secAround('<h2>Dein TCM Team in St. Gallen');
const standort = secFrom('<section class="up-sec">');
let reviews = secAround('class="section-label">Erfahrungen');
// mobile-first: keep only the first 4 review cards (lighter + shorter); source untouched
function endOfDiv(html, startIdx) { const rx = /<div\b|<\/div>/g; rx.lastIndex = startIdx; let d = 0, m; while ((m = rx.exec(html))) { if (m[0] === '</div>') { d--; if (d === 0) return m.index + 6; } else d++; } return html.length; }
{ const starts = []; let i = reviews.indexOf('<div class="review-card'); while (i >= 0) { starts.push(i); i = reviews.indexOf('<div class="review-card', i + 1); } if (starts.length > 4) { reviews = reviews.slice(0, endOfDiv(reviews, starts[3])) + reviews.slice(endOfDiv(reviews, starts[starts.length - 1])); } }
let krankenkassen = secAround('Krankenkassen anerkannt</h2>');
// remove the standort contact CTA card ("Termin in St. Gallen anfragen") — LP funnels to #anmeldung
{ const ci = krankenkassen.indexOf('<div class="cp-cta-card"'); if (ci >= 0) krankenkassen = krankenkassen.slice(0, ci) + krankenkassen.slice(endOfDiv(krankenkassen, ci)); }

// Tier-2 skin device: one consistent yellow divider + eyebrow above a section
const sep = (eyebrow) => `<div class="evt-sep"><span class="evt-eyebrow">${eyebrow}</span></div>`;

const body = `
<div class="evt-page" style="padding-top:60px;padding-bottom:40px">

<!-- 1) HERO + COUNTDOWN -->
<section class="section evt-reveal evt-hero" style="text-align:center;padding:24px 16px 16px"><div class="wrap" style="max-width:780px">
  <span class="evt-badge" id="evtBadge">HEUTE · 15. August · 10–16 Uhr</span>
  <h1 class="section-title" style="margin:16px 0 12px">Tag der offenen Tür – St. Gallen</h1>
  <p class="section-sub evt-lead" id="evtLead" style="margin:0 auto;max-width:600px">Komm einfach vorbei – ohne Termin, ohne Anmeldung. Gratis, was sonst [CHF 150] kostet.</p>
  <div class="evt-countdown" id="evt-cd" aria-live="polite" aria-label="Countdown: so lange ist heute noch geöffnet">
    <div class="evt-cd-box" data-cd-box="d"><span data-cd="d">–</span><label>Tage</label></div>
    <div class="evt-cd-box"><span data-cd="h">–</span><label>Std</label></div>
    <div class="evt-cd-box"><span data-cd="m">–</span><label>Min</label></div>
    <div class="evt-cd-box"><span data-cd="s">–</span><label>Sek</label></div>
  </div>
  <p id="evtCdNote" style="margin:6px 0 0;color:var(--muted);font-size:13px">So lange ist heute noch offen – bis 16:00 Uhr</p>
  <div class="evt-cta-row">
    <a href="${mapsHref}" class="evt-cta" id="evtHeroCta" target="_blank" rel="noopener">Route öffnen – komm spontan vorbei →</a>
    <a href="${waSpontan}" class="btn-secondary" target="_blank" rel="noopener" style="min-height:52px">Kurz Bescheid sagen (WhatsApp)</a>
  </div>
  <p style="margin-top:14px;color:var(--muted);font-size:14px">📍 Oberer Graben 22, 9000 St. Gallen · heute 10–16 Uhr</p>
</div></section>

<!-- 1b) BARRIER REMOVAL -->
<section class="section evt-reveal" style="padding:14px 16px 4px"><div class="wrap" style="max-width:780px">
  <div class="evt-barrier">
    <h2 class="section-title" style="font-size:clamp(22px,6vw,30px);margin:0 0 14px">Erkennst du dich wieder?</h2>
    <ul class="evt-blist">
      <li>Schon vieles probiert, aber nichts hat wirklich geholfen?</li>
      <li>Du suchst eine natürliche Alternative zur Schulmedizin?</li>
      <li>Neugierig auf TCM, aber nie den ersten Schritt gewagt?</li>
      <li>Unsicher, wie Akupunktur funktioniert oder ob sie zu dir passt?</li>
      <li>Skeptisch und willst dir lieber selbst ein Bild machen?</li>
    </ul>
    <div class="evt-chips"><span class="evt-chips-lbl">Wir helfen u.a. bei:</span><span class="evt-chip">Rückenschmerzen</span><span class="evt-chip">Migräne</span><span class="evt-chip">Schlafstörungen</span><span class="evt-chip">Stress &amp; Burnout</span><span class="evt-chip">Nackenschmerzen</span><span class="evt-chip">Kinderwunsch</span><span class="evt-chip">Verdauung</span><span class="evt-chip">Wechseljahre</span></div>
    <p class="evt-barrier-emph">Dann ist heute genau dein Tag.</p>
    <p class="evt-barrier-p">Komm vorbei, lern uns kennen und probier TCM selbst aus. Kostenlos, unverbindlich, ohne Druck, ohne Termin. Du gehst mit einer echten Behandlung und einem klaren Plan nach Hause und entscheidest danach in aller Ruhe, ob du weitermachst. Mehr riskierst du nicht als ein paar entspannte Minuten bei einem Apéro.</p>
    <a href="${mapsHref}" class="evt-cta" target="_blank" rel="noopener" style="display:inline-flex;min-height:48px">Komm heute vorbei →</a>
  </div>
</div></section>

<!-- section break: page-standard sep divider + breathing room between the barrier CTA block and the offer -->
${sep('Dein Geschenk')}
<!-- 2) OFFER / value stack (centerpiece) -->
<section class="section evt-reveal" style="padding-top:28px"><div class="wrap" style="max-width:780px">
  <div class="evt-offer" style="padding:26px 22px">
    <span class="evt-spark" aria-hidden="true">✨</span>
    <div class="section-label">Dein kostenloser TCM-Kennenlern-Termin</div>
    <h2 class="section-title" style="font-size:clamp(22px,6vw,30px);margin:6px 0 8px">Das bekommst du heute – geschenkt</h2>
    <div class="evt-stack">
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">30-Min-Konsultation mit unserem TCM-Team</span><span class="evt-rval">Wert [CHF 60]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">TCM-Diagnose (Puls &amp; Zunge), die deine Ursache zeigt</span><span class="evt-rval">Wert [CHF 50]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">EINE Behandlung deiner Wahl: Akupunktur, Schröpfen, Tuina oder Ohrakupunktur</span><span class="evt-rval">Wert [CHF 40]</span></div>
    </div>
    <div class="evt-total"><span class="evt-total-top">Gesamtwert <s>[CHF 150]</s> → heute</span><span class="evt-zero">CHF 0</span></div>
    <div class="evt-bonus"><span class="evt-ck">✓</span><span><strong>Plus obendrauf:</strong> Schweizer Welcome-Apéro – TCM-Tee, Matcha &amp; Apéro-Häppchen, inklusive</span></div>
    <p class="evt-risk">Kein Haken. Keine Verpflichtung. Du gehst mit einer echten Behandlung und einem klaren Plan nach Hause – nicht nur mit einem Flyer.</p>
    <div class="evt-flags">
      <div class="evt-flag">🚶 <strong>Ohne Termin, ohne Anmeldung.</strong> Kurz-Konsultationen laufen heute durchgehend, einfach reinschauen.</div>
      <div class="evt-flag">⏳ <strong>Nur heute bis 16 Uhr.</strong> Danach gilt der reguläre Preis.</div>
    </div>
    <a href="${mapsHref}" class="evt-cta" target="_blank" rel="noopener" style="width:100%;margin-top:18px">Komm heute vorbei – 10–16 Uhr →</a>
  </div>
</div></section>

<!-- 2a) FLYER-GUTSCHEIN -->
<section class="section evt-reveal" style="padding:0 16px 8px"><div class="wrap" style="max-width:780px">
  <div class="evt-offer" style="padding:20px 22px">
    <h2 class="section-title" style="font-size:clamp(20px,5vw,26px);margin:0 0 8px">Flyer mit Gutschein erhalten?</h2>
    <p class="section-sub" style="margin:0 0 14px">Dein kostenloses Erstgespräch inkl. TCM-Kurzdiagnose (Wert CHF 150) kannst du bis 30.9.2026 einlösen – auch ohne Besuch am 15. August. Vereinbare einfach einen Termin.</p>
    <a href="${waFlyer}" class="evt-cta" target="_blank" rel="noopener" style="width:100%">Termin vereinbaren →</a>
  </div>
</div></section>

<!-- 2b) ZWEI WEGE, dabei zu sein -->
<section class="section evt-reveal" style="padding:18px 16px"><div class="wrap" style="max-width:820px">
  <h2 class="section-title" style="text-align:center;font-size:clamp(22px,6vw,30px);margin:0 0 4px">Zwei Wege, dabei zu sein</h2>
  <div class="evt-ways">
    <div class="evt-way evt-way-1">
      <div class="evt-way-ico">🚶</div>
      <h3 class="evt-way-h">Einfach spontan vorbeikommen</h3>
      <p class="evt-way-t">Ohne Termin, ohne Anmeldung: Komm zwischen 10 und 16 Uhr vorbei, geniess den Apéro und sichere dir deine Gratis-Kurzkonsultation mit TCM-Diagnose und einer Behandlung deiner Wahl. Solange es freie Plätze hat, wer da ist, kommt dran.</p>
      <a href="${mapsHref}" class="evt-cta" target="_blank" rel="noopener" style="width:100%">Route öffnen →</a>
    </div>
    <div class="evt-way evt-way-2">
      <div class="evt-way-ico">🎟️</div>
      <h3 class="evt-way-h">Bereits angemeldet? Dein Slot gilt.</h3>
      <p class="evt-way-t">Du hast dir vorab einen 30-Min-Slot reserviert? Perfekt, komm einfach zur vereinbarten Zeit, dein Platz ist bereit. Fragen dazu beantworten wir dir sofort per WhatsApp.</p>
      <a href="${waHref}" class="btn-secondary" target="_blank" rel="noopener" style="width:100%;justify-content:center;min-height:50px">Frage zum Slot? WhatsApp →</a>
    </div>
  </div>
</div></section>

<!-- 5) BEHANDLUNGEN — reuse treatments (Tier 1: corner ribbon + per-card pills) -->
${sep('Behandlungen')}
<div class="evt-sec evt-tier1"><div class="evt-corner" aria-hidden="true">Am 15.8. gratis</div>${behandlungen}</div>

<!-- 6) TEAM — reuse team section with real photo (Tier 2) -->
${sep('Dein Team vor Ort')}
<div class="evt-sec">${team}</div>

<!-- 7) STANDORT — reuse "Über die Praxis" (address + practice photo + lazy map) (Tier 2) -->
${sep('Standort')}
<div class="evt-sec">${standort}</div>

<!-- 8) PROOF — reuse reviews + Krankenkassen (Tier 2) -->
${sep('Das sagen Patient:innen')}
<div class="evt-sec">${reviews}${krankenkassen}</div>

<!-- 9) SO LÄUFT DER TAG AB — new (Tier 2) -->
${sep('So läuft der Tag ab')}
<div class="evt-sec"><section class="section"><div class="wrap">
  <p class="evt-apero-intro">Komm vorbei, lern unser Team bei einem entspannten Apéro kennen – Tee, Matcha und kleine Häppchen inklusive. Kein Stress, kein Termindruck.</p>
  <div class="evt-grid">
    <div class="usp-card"><div class="usp-icon evt-step">1</div><div class="usp-title">Vorbeikommen</div><div class="usp-sub">Oberer Graben 22, St. Gallen, heute zwischen 10 und 16 Uhr. Ohne Termin.</div></div>
    <div class="usp-card"><div class="usp-icon evt-step">2</div><div class="usp-title">Ankommen &amp; Apéro</div><div class="usp-sub">Tee, Matcha und Häppchen, lern das Team in Ruhe kennen.</div></div>
    <div class="usp-card"><div class="usp-icon evt-step">3</div><div class="usp-title">Deine Gratis-Kurzkonsultation</div><div class="usp-sub">Konsultation, TCM-Diagnose, Behandlung deiner Wahl und Mini-Plan.</div></div>
  </div>
  <div style="text-align:center;margin-top:26px"><a href="${mapsHref}" class="evt-cta" target="_blank" rel="noopener" style="display:inline-flex">Komm heute vorbei – Route öffnen →</a></div>
</div></section></div>

<!-- 10) FAQ — new, objection handling (Tier 2) -->
${sep('Häufige Fragen')}
<div class="evt-sec"><section class="section"><div class="wrap" style="max-width:760px">
  <details class="evt-faq"><summary>Ist es wirklich gratis?</summary><p>Ja. Am Tag der offenen Tür ist deine Kurzkonsultation inkl. TCM-Diagnose, einer Behandlung deiner Wahl und Mini-Plan kostenlos. Kein Haken, keine versteckten Kosten.</p></details>
  <details class="evt-faq"><summary>Muss ich vorher buchen?</summary><p>Nein. Heute ist offene Tür im Wortsinn: Komm einfach zwischen 10 und 16 Uhr vorbei, ohne Termin und ohne Anmeldung. Wer da ist, kommt dran.</p></details>
  <details class="evt-faq"><summary>Was, wenn gerade viel los ist?</summary><p>Dann geniesst du zuerst den Apéro, meist geht es schnell. Und falls es dir zu lange dauert: Wir tragen dich für dein kostenloses Erstgespräch an einem anderen Tag ein, einlösbar bis 30.9.2026.</p></details>
  <details class="evt-faq"><summary>Wird das von der Krankenkasse übernommen?</summary><p>Heute ist die Kennenlern-Konsultation gratis – du brauchst dafür keine Kasse. Reguläre TCM-Behandlungen danach sind bei den meisten Zusatzversicherungen anerkannt (EMR/ASCA).</p></details>
</div></section></div>

<!-- 11) FINAL CTA + ANMELDUNG form (the single CTA) -->
<section id="anmeldung" class="section contact-section-inline evt-reveal" style="background:var(--surface)"> <div class="wrap"> <div class="contact-inline-grid"> <div> <div class="section-label">Heute keine Zeit?</div> <h2 class="section-title">Schaffst du es heute nicht? <s style="color:var(--muted);font-weight:600">[CHF 150]</s> Wert – trotzdem <em>CHF 0</em>.</h2> <p class="section-sub" style="margin-bottom:0">Sichere dir dein kostenloses Erstgespräch inkl. TCM-Kurzdiagnose an einem anderen Tag, einlösbar bis 30.9.2026. Sag uns kurz Wunschtage und Tageszeit – wir melden uns mit Terminvorschlägen.</p> <div class="intake-trust-row"> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Kostenlos &amp; unverbindlich</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Anamnese &amp; erste TCM-Diagnose</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Einlösbar bis 30.9.2026</div> </div> </div> <div> <div class="inline-form-card"><div class="inline-form-header"><div class="inline-form-title">Kostenloses Erstgespräch sichern</div><div class="inline-form-sub">Einlösbar bis 30.9.2026 – wir melden uns mit Terminvorschlägen.</div></div><form class="inline-form" data-contact-form novalidate=""><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"><div class="form-group"><label class="form-label">Name *</label><input class="form-input" name="name" type="text" autocomplete="name" required=""></div><div class="form-row-2"><div class="form-group"><label class="form-label">Telefon *</label><input class="form-input" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required=""></div><div class="form-group"><label class="form-label">E-Mail *</label><input class="form-input" name="email" type="email" inputmode="email" autocomplete="email" required=""></div></div><div class="form-group"><label class="form-label">Standort</label><select class="form-select" name="standort"><option value="">Standort auswählen</option><option>Zürich City</option><option>Zürich Oerlikon</option><option>Zürich Höngg</option><option>Winterthur</option><option>Volketswil</option><option>Frauenfeld</option><option>Kreuzlingen</option><option selected>St. Gallen</option><option>Wil</option><option>Rorschach</option><option>Basel</option><option>Andere / in meiner Nähe</option></select></div><div class="form-group"><label class="form-label">Behandlung / Anliegen <span class="termin-opt">(optional)</span></label><textarea class="form-textarea" name="behandlung" rows="3" placeholder="z. B. Akupunktur bei Rückenschmerzen">Ich schaffe es heute nicht zum Tag der offenen Tür und möchte mein kostenloses Erstgespräch inkl. TCM-Kurzdiagnose in St. Gallen vereinbaren (bis 30.9.).</textarea></div><div class="form-group cf-turnstile-wrap"><div class="cf-turnstile" data-sitekey="__TURNSTILE_SITEKEY__" data-ts-mounted="1"></div></div><button type="submit" class="btn-primary form-submit" style="width:100%;justify-content:center">Kostenloses Erstgespräch sichern →</button><p class="termin-under-btn">Wir melden uns innerhalb von 1 Stunde mit Terminvorschlägen.</p><div class="form-divider-quiet">Lieber direkt per WhatsApp?</div><a href="${waLater}" class="form-wa-alt-new" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366" style="display:inline-block;vertical-align:middle;margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.07