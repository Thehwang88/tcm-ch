.evt-relevance{text-align:center;color:var(--mid);font-size:15px;font-style:italic;margin:6px 16px -6px}
.evt-step{background:rgba(255,193,7,.16)!important;color:#B7791F!important;font-family:var(--font-sans);font-weight:800;font-size:18px}
/* ── EVENT SKIN: Tier 1 — corner ribbon + per-card pill (Behandlungen only) ── */
.evt-tier1{position:relative;overflow:hidden}
.evt-corner{position:absolute;top:22px;right:-56px;transform:rotate(45deg);background:linear-gradient(90deg,var(--ey),var(--ey-deep));color:var(--ey-ink);font-family:var(--font-sans);font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:6px 60px;box-shadow:0 2px 8px rgba(0,0,0,.18);z-index:4}
.evt-tier1 .svc-card{position:relative}
.evt-pill{position:absolute;top:8px;left:8px;z-index:3;background:linear-gradient(90deg,var(--ey),var(--ey-deep));color:var(--ey-ink);font-family:var(--font-sans);font-size:10.5px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;padding:3px 9px;border-radius:100px;box-shadow:0 1px 4px rgba(0,0,0,.14)}
/* FAQ (native disclosure, no JS) */
.evt-faq{border:1px solid var(--border);border-radius:12px;margin-bottom:10px;background:#fff;overflow:hidden}
.evt-faq summary{cursor:pointer;list-style:none;padding:15px 44px 15px 18px;font-family:var(--font-sans);font-weight:700;font-size:15.5px;color:var(--black);position:relative}
.evt-faq summary::-webkit-details-marker{display:none}
.evt-faq summary::after{content:"+";position:absolute;right:18px;top:50%;transform:translateY(-50%);color:var(--ey-deep);font-size:22px;font-weight:700}
.evt-faq[open] summary::after{content:"–"}
.evt-faq p{margin:0;padding:0 18px 16px;color:var(--mid);font-size:14.5px;line-height:1.6}
/* ── mobile-first optimization (page-scoped; reused source untouched) ── */
.evt-page{overflow-x:clip}
/* reused reviews trimmed to 4 cards in HTML; hide any Standort "show more" control */
.evt-page .reviews-expand-btn,.evt-page #reviewsExpanded{display:none!important}
/* tap targets: contact email/phone links >=44px */
.evt-page a.up-val{display:inline-flex;align-items:center;min-height:44px}
/* HARD CONSTRAINT: reduced motion -> static (countdown stays functional) */
@media(prefers-reduced-motion:reduce){
  .evt-badge,.evt-badge::after,.evt-offer,.evt-spark,.evt-cta,.evt-page .form-submit,.sticky-cta-bar .scb-primary{animation:none!important}
  .evt-reveal{opacity:1!important;transform:none!important;transition:none!important}
}
</style>

