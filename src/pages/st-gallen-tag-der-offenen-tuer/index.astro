<style>
.evt-page{--ey:#FFC107;--ey-deep:#FFB300;--ey-ink:#3E2723;--ey-soft:#FFF8E1;--ey-bd:#FFD54F}
.evt-page h1.section-title{font-size:clamp(28px,8vw,40px);line-height:1.15}
.evt-page .evt-lead{font-size:16px;line-height:1.6}
/* hero background (designed banner) + light scrim for legibility; no layout shift */
.evt-hero{background-image:linear-gradient(180deg,rgba(255,255,255,.74),rgba(255,255,255,.66)),url('/images/tag-hero.webp');background-size:cover;background-position:72% center;background-repeat:no-repeat}
/* barrier-removal block */
.evt-barrier{background:#fff;border:1px solid var(--ey-bd);border-left:4px solid var(--ey-deep);border-radius:16px;padding:24px 22px;box-shadow:0 0 18px rgba(255,193,7,.14)}
.evt-blist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.evt-blist li{position:relative;padding-left:20px;font-size:15.5px;line-height:1.5;color:var(--black)}
.evt-blist li::before{content:"·";position:absolute;left:3px;top:-3px;color:var(--ey-deep);font-weight:800;font-size:24px}
.evt-chips{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0 2px}
.evt-chips-lbl{font-size:13.5px;font-weight:700;color:var(--mid)}
.evt-chip{display:inline-block;background:var(--ey-soft);border:1px solid var(--ey-bd);color:var(--ey-ink);font-size:13px;font-weight:600;padding:5px 11px;border-radius:100px;line-height:1.2}
.evt-barrier-emph{font-family:var(--font-sans);font-weight:800;font-size:18px;color:#1F7A54;margin:16px 0 8px}
.evt-barrier-p{font-size:15px;line-height:1.6;color:var(--mid);margin:0 0 18px}
/* "Zwei Wege" two-tier cards */
.evt-ways{display:flex;flex-direction:column;gap:14px;margin-top:16px}
.evt-way{border-radius:16px;padding:22px 20px}
.evt-way-ico{font-size:30px;line-height:1;margin-bottom:8px}
.evt-way-h{font-family:var(--font-sans);font-weight:800;color:#0d0d0d;margin:0 0 8px;line-height:1.25}
.evt-way-t{font-size:15px;line-height:1.55;color:var(--mid);margin:0 0 16px}
.evt-way-1{background:var(--ey-soft);border:1px solid var(--ey-bd);border-top:4px solid var(--ey-deep);box-shadow:0 0 20px rgba(255,193,7,.2)}
.evt-way-1 .evt-way-h{font-size:19px}
.evt-way-2{background:#fff;border:1px solid var(--border)}
.evt-way-2 .evt-way-ico{font-size:26px}
.evt-way-2 .evt-way-h{font-size:16.5px}
.evt-way-2 .evt-way-t{font-size:14px}
@media(min-width:640px){.evt-ways{flex-direction:row;align-items:stretch}.evt-way{display:flex;flex-direction:column}.evt-way-1{flex:1.25}.evt-way-2{flex:.85}.evt-way .evt-cta,.evt-way .btn-secondary{margin-top:auto}}
.evt-cta{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 26px;border-radius:14px;font-family:var(--font-sans);font-weight:800;font-size:16px;text-decoration:none;border:none;cursor:pointer}
.evt-cta,.evt-page .form-submit{background:linear-gradient(90deg,var(--ey),var(--ey-deep))!important;color:var(--ey-ink)!important;box-shadow:0 8px 22px rgba(255,179,0,.32)!important;border:none!important;animation:evtCtaPulse 2.6s ease-in-out infinite}
.sticky-cta-bar .scb-primary{background:linear-gradient(90deg,#FFC107,#FFB300)!important;color:#3E2723!important;box-shadow:0 8px 22px rgba(255,179,0,.32)!important;border:none!important;animation:evtCtaPulse 2.6s ease-in-out infinite}
@keyframes evtCtaPulse{0%,100%{box-shadow:0 8px 22px rgba(255,179,0,.32)}50%{box-shadow:0 10px 30px rgba(255,179,0,.58)}}
