.evt-page .section-label[style*="center"]::after{left:50%;transform:translateX(-50%)}
.evt-reveal{opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease}
.evt-reveal.in{opacity:1;transform:none}
/* ── EVENT SKIN: Tier 2 — one divider + eyebrow device ── */
.evt-sep{display:flex;align-items:center;gap:14px;max-width:1000px;margin:14px auto 2px;padding:0 24px}
.evt-sep::before,.evt-sep::after{content:"";flex:1;height:2px;background:linear-gradient(90deg,transparent,var(--ey-bd),transparent)}
