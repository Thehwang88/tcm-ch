---
// Ads-only event SALES page (noindex). Reuses real Standort sections by extracting their
// baked HTML fragments from st-gallen.html (SOURCE FILE UNTOUCHED) and re-skinning them on
// THIS page only. SpaPage gives home.css/home.js (so reused onclick handlers, reveal,
// reviews toggle, Turnstile all work). noindex => robots noindex + sitemap auto-excluded.
import SpaPage from '../../layouts/SpaPage.astro';
import sgRaw from '../../data/standort-leaves/st-gallen.html?raw';

const PREFILL = 'Anmeldung Tag der offenen Tür – St. Gallen (08.08.26). Ich hätte gern einen 30-Min-Slot (Anamnese & Diagnose).';
const waHref = 'https://wa.me/41775236122?text=' + encodeURIComponent(PREFILL);
const waSpontan = 'https://wa.me/41775236122?text=' + encodeURIComponent('Ich komme am 8.8. spontan zum Tag der offenen Tür in St. Gallen vorbei.');

// ── reuse: stack-based section extraction from the Standort leaf ──
function secFromIdx(i) {
  const rx = /<section\b|<\/section>/g; rx.lastIndex = i; let d = 0, m;
  while ((m = rx.exec(sgRaw))) { if (m[0] === '</section>') { d--; if (d === 0) return sgRaw.slice(i, m.index + m[0].length); } else d++; }
  return '';
}
const secFrom = (a) => secFromIdx(sgRaw.indexOf(a));
const secAround = (a) => { const k = sgRaw.indexOf(a); return k < 0 ? '' : secFromIdx(sgRaw.lastIndexOf('<section', k)); };
// every section funnels to the single CTA: kill away-navigation in reused grids
const funnel = (h) => h.replace(/onclick="nav\([^)]*\)"/g, 'onclick="evtToForm()"');

let behandlungen = funnel(secFrom('<section class="section svc-section"'));
behandlungen = behandlungen.split('<div class="svc-photo-wrap">').join('<span class="evt-pill">8.8. gratis</span><div class="svc-photo-wrap">');
const team = secAround('<h2>Dein TCM Team in St. Gallen');
const standort = secFrom('<section class="up-sec">');
let reviews = secAround('class="section-label">Erfahrungen');
// mobile-first: keep only the first 4 review cards (lighter + shorter); source untouched
function endOfDiv(html, startIdx) { const rx = /<div\b|<\/div>/g; rx.lastIndex = startIdx; let d = 0, m; while ((m = rx.exec(html))) { if (m[0] === '</div>') { d--; if (d === 0) return m.index + 6; } else d++; } return html.length; }
{ const starts = []; let i = reviews.indexOf('<div class="review-card'); while (i >= 0) { starts.push(i); i = reviews.indexOf('<div class="review-card', i + 1); } if (starts.length > 4) { reviews = reviews.slice(0, endOfDiv(reviews, starts[3])) + reviews.slice(endOfDiv(reviews, starts[starts.length - 1])); } }
let krankenkassen = secAround('Krankenkassen anerkannt</h2>');
// remove the standort contact CTA card ("Termin in St. Gallen anfragen") — LP funnels to #anmeldung
{ const ci = krankenkassen.indexOf('<div class="cp-cta-card"'); if (ci >= 0) krankenkassen = krankenkassen.slice(0, ci) + krankenkassen.slice(endOfDiv(krankenkassen, ci)); }

// Tier-2 skin device: one consistent yellow divider + eyebrow above a section
const sep = (eyebrow) => `<div class="evt-sep"><span class="evt-eyebrow">${eyebrow}</span></div>`;

const body = `
<div class="evt-page" style="padding-top:60px;padding-bottom:40px">

<!-- 1) HERO + COUNTDOWN -->
<section class="section evt-reveal evt-hero" style="text-align:center;padding:24px 16px 16px"><div class="wrap" style="max-width:780px">
  <span class="evt-badge">8. August 2026 · St. Gallen</span>
  <h1 class="section-title" style="margin:16px 0 12px">Tag der offenen Tür – St. Gallen</h1>
  <p class="section-sub evt-lead" style="margin:0 auto;max-width:600px">Ein Tag. Begrenzte Plätze. Gratis, was sonst [CHF 220] kostet.</p>
  <div class="evt-countdown" id="evt-cd" aria-live="polite" aria-label="Countdown bis zum Event">
    <div class="evt-cd-box"><span data-cd="d">–</span><label>Tage</label></div>
    <div class="evt-cd-box"><span data-cd="h">–</span><label>Std</label></div>
    <div class="evt-cd-box"><span data-cd="m">–</span><label>Min</label></div>
    <div class="evt-cd-box"><span data-cd="s">–</span><label>Sek</label></div>
  </div>
  <div class="evt-cta-row">
    <a href="#anmeldung" class="evt-cta">Slot sichern – solange verfügbar →</a>
    <a href="${waHref}" class="btn-secondary" target="_blank" rel="noopener" style="min-height:52px">Per WhatsApp fragen</a>
  </div>
  <p style="margin-top:14px;color:var(--muted);font-size:14px">📍 Oberer Graben 22, 9000 St. Gallen · 9:30–15:00 Uhr</p>
</div></section>

<!-- 1b) BARRIER REMOVAL -->
<section class="section evt-reveal" style="padding:14px 16px 4px"><div class="wrap" style="max-width:780px">
  <div class="evt-barrier">
    <h2 class="section-title" style="font-size:clamp(22px,6vw,30px);margin:0 0 14px">Erkennst du dich wieder?</h2>
    <ul class="evt-blist">
      <li>Schon vieles probiert, aber nichts hat wirklich geholfen?</li>
      <li>Du suchst eine natürliche Alternative zur Schulmedizin?</li>
      <li>Neugierig auf TCM, aber nie den ersten Schritt gewagt?</li>
      <li>Unsicher, wie Akupunktur funktioniert oder ob sie zu dir passt?</li>
      <li>Skeptisch und willst dir lieber selbst ein Bild machen?</li>
    </ul>
    <div class="evt-chips"><span class="evt-chips-lbl">Wir helfen u.a. bei:</span><span class="evt-chip">Rückenschmerzen</span><span class="evt-chip">Migräne</span><span class="evt-chip">Schlafstörungen</span><span class="evt-chip">Stress &amp; Burnout</span><span class="evt-chip">Nackenschmerzen</span><span class="evt-chip">Kinderwunsch</span><span class="evt-chip">Verdauung</span><span class="evt-chip">Wechseljahre</span></div>
    <p class="evt-barrier-emph">Dann ist der 8.8. genau dein Tag.</p>
    <p class="evt-barrier-p">Komm vorbei, lern uns kennen und probier TCM selbst aus. Kostenlos, unverbindlich, ohne Druck. Du gehst mit einer echten Behandlung und einem klaren Plan nach Hause und entscheidest danach in aller Ruhe, ob du weitermachst. Mehr riskierst du nicht als ein paar entspannte Minuten bei einem Apéro.</p>
    <a href="#anmeldung" class="evt-cta" style="display:inline-flex;min-height:48px">Slot sichern →</a>
  </div>
</div></section>

<!-- 2) OFFER / value stack (centerpiece) -->
<section class="section evt-reveal" style="padding-top:4px"><div class="wrap" style="max-width:780px">
  <div class="evt-offer" style="padding:26px 22px">
    <span class="evt-spark" aria-hidden="true">✨</span>
    <div class="section-label">Dein kostenloser TCM-Kennenlern-Termin</div>
    <h2 class="section-title" style="font-size:clamp(22px,6vw,30px);margin:6px 0 8px">Das bekommst du am 8.8. – geschenkt</h2>
    <div class="evt-stack">
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">30-Min-Konsultation mit unserem TCM-Team</span><span class="evt-rval">Wert [CHF 60]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">TCM-Diagnose (Puls &amp; Zunge), die deine Ursache zeigt</span><span class="evt-rval">Wert [CHF 50]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">EINE Behandlung deiner Wahl: Akupunktur, Schröpfen, Tuina oder Ohrakupunktur</span><span class="evt-rval">Wert [CHF 80]</span></div>
      <div class="evt-row"><span class="evt-ck">✓</span><span class="evt-rtxt">Persönlicher Mini-Plan für die nächsten Schritte</span><span class="evt-rval">Wert [CHF 30]</span></div>
    </div>
    <div class="evt-total"><span class="evt-total-top">Gesamtwert <s>[CHF 220]</s> → am 8.8.</span><span class="evt-zero">CHF 0</span></div>
    <div class="evt-bonus"><span class="evt-ck">✓</span><span><strong>Plus obendrauf:</strong> Schweizer Welcome-Apéro – TCM-Tee, Matcha &amp; Apéro-Häppchen, inklusive</span></div>
    <p class="evt-risk">Kein Haken. Keine Verpflichtung. Du gehst mit einer echten Behandlung und einem klaren Plan nach Hause – nicht nur mit einem Flyer.</p>
    <div class="evt-flags">
      <div class="evt-flag">🔥 <strong>Nur [12] Slots.</strong> Wenn sie weg sind, sind sie weg.</div>
      <div class="evt-flag">⏳ <strong>Nur am 8. August.</strong> Danach gilt der reguläre Preis.</div>
    </div>
    <a href="#anmeldung" class="evt-cta" style="width:100%;margin-top:18px">Slot sichern – solange verfügbar →</a>
  </div>
</div></section>

<!-- 2b) ZWEI WEGE, dabei zu sein -->
<section class="section evt-reveal" style="padding:18px 16px"><div class="wrap" style="max-width:820px">
  <h2 class="section-title" style="text-align:center;font-size:clamp(22px,6vw,30px);margin:0 0 4px">Zwei Wege, dabei zu sein</h2>
  <div class="evt-ways">
    <div class="evt-way evt-way-1">
      <div class="evt-way-ico">🎟️</div>
      <h3 class="evt-way-h">Die ersten 12: Gratis-Behandlungspaket</h3>
      <p class="evt-way-t">30-Min-Slot mit Konsultation, TCM-Diagnose und einer Behandlung deiner Wahl. Limitiert, first come, first served. Wenn die [12] weg sind, sind sie weg.</p>
      <a href="#anmeldung" class="evt-cta" style="width:100%">Slot sichern →</a>
    </div>
    <div class="evt-way evt-way-2">
      <div class="evt-way-ico">☕</div>
      <h3 class="evt-way-h">Alle anderen: Apéro &amp; offene Fragerunde</h3>
      <p class="evt-way-t">Kein Slot mehr? Kein Problem. Komm einfach spontan vorbei, geniess den Apéro, lern unser Team kennen und stell deine Fragen direkt einem Therapeuten. Kein Termin, keine Anmeldung nötig.</p>
      <a href="${waSpontan}" class="btn-secondary" target="_blank" rel="noopener" style="width:100%;justify-content:center;min-height:50px">Sag uns kurz Bescheid →</a>
    </div>
  </div>
</div></section>

<!-- 5) BEHANDLUNGEN — reuse treatments (Tier 1: corner ribbon + per-card pills) -->
${sep('Behandlungen')}
<div class="evt-sec evt-tier1"><div class="evt-corner" aria-hidden="true">Am 8.8. gratis</div>${behandlungen}</div>

<!-- 6) TEAM — reuse team section with real photo (Tier 2) -->
${sep('Dein Team vor Ort')}
<div class="evt-sec">${team}</div>

<!-- 7) STANDORT — reuse "Über die Praxis" (address + practice photo + lazy map) (Tier 2) -->
${sep('Standort')}
<div class="evt-sec">${standort}</div>

<!-- 8) PROOF — reuse reviews + Krankenkassen (Tier 2) -->
${sep('Das sagen Patient:innen')}
<div class="evt-sec">${reviews}${krankenkassen}</div>

<!-- 9) SO LÄUFT DER TAG AB — new (Tier 2) -->
${sep('So läuft der Tag ab')}
<div class="evt-sec"><section class="section"><div class="wrap">
  <p class="evt-apero-intro">Komm vorbei, lern unser Team bei einem entspannten Apéro kennen – Tee, Matcha und kleine Häppchen inklusive. Kein Stress, kein Termindruck.</p>
  <div class="evt-grid">
    <div class="usp-card"><div class="usp-icon evt-step">1</div><div class="usp-title">Anmelden</div><div class="usp-sub">Slot über das Formular sichern – dauert keine Minute.</div></div>
    <div class="usp-card"><div class="usp-icon evt-step">2</div><div class="usp-title">Vorbeikommen am 8.8.</div><div class="usp-sub">Oberer Graben 22, St. Gallen, zwischen 9:30 und 15:00 Uhr.</div></div>
    <div class="usp-card"><div class="usp-icon evt-step">3</div><div class="usp-title">Dein 30-Min-Slot</div><div class="usp-sub">Konsultation, Behandlung deiner Wahl und persönlicher Mini-Plan.</div></div>
  </div>
  <div style="text-align:center;margin-top:26px"><a href="#anmeldung" class="evt-cta" style="display:inline-flex">Slot sichern – solange verfügbar →</a></div>
</div></section></div>

<!-- 10) FAQ — new, objection handling (Tier 2) -->
${sep('Häufige Fragen')}
<div class="evt-sec"><section class="section"><div class="wrap" style="max-width:760px">
  <details class="evt-faq"><summary>Ist es wirklich gratis?</summary><p>Ja. Am Tag der offenen Tür ist dein 30-Minuten-Slot inkl. Konsultation, TCM-Diagnose, einer Behandlung deiner Wahl und Mini-Plan kostenlos. Kein Haken, keine versteckten Kosten.</p></details>
  <details class="evt-faq"><summary>Muss ich vorher buchen?</summary><p>Empfohlen, ja. Die Plätze sind auf [12] Slots begrenzt und gehen zuerst an Anmeldungen. Spontan vorbeikommen klappt nur, solange noch Slots frei sind.</p></details>
  <details class="evt-faq"><summary>Was, wenn alle Slots weg sind?</summary><p>Dann tragen wir dich für einen regulären Ersttermin ein – oder du kommst auf die Warteliste für kurzfristig frei werdende Slots am 8.8.</p></details>
  <details class="evt-faq"><summary>Wird das von der Krankenkasse übernommen?</summary><p>Am 8.8. ist der Kennenlern-Slot gratis – du brauchst dafür keine Kasse. Reguläre TCM-Behandlungen danach sind bei den meisten Zusatzversicherungen anerkannt (EMR/ASCA).</p></details>
</div></section></div>

<!-- 11) FINAL CTA + ANMELDUNG form (the single CTA) -->
<section id="anmeldung" class="section contact-section-inline evt-reveal" style="background:var(--surface)"> <div class="wrap"> <div class="contact-inline-grid"> <div> <div class="section-label">Jetzt Slot sichern</div> <h2 class="section-title"><s style="color:var(--muted);font-weight:600">[CHF 220]</s> Wert – am 8.8. <em>CHF 0</em>.</h2> <p class="section-sub" style="margin-bottom:0">Nur [12] Slots. Wenn sie weg sind, sind sie weg. Sag uns kurz Wunschtage und Tageszeit – wir bestätigen deinen Slot.</p> <div class="intake-trust-row"> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Kostenlos &amp; unverbindlich</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Anamnese &amp; erste TCM-Diagnose</div> <div class="intake-trust-item"><span class="intake-trust-dot"></span>Plätze limitiert (first come, first served)</div> </div> </div> <div> <div class="inline-form-card"><div class="inline-form-header"><div class="inline-form-title">30-Min-Slot reservieren</div><div class="inline-form-sub">Wir bestätigen deinen Slot für den 08.08.</div></div><form class="inline-form" onsubmit="submitTerminForm(event, this)" novalidate=""><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"><div class="form-group"><label class="form-label">Name *</label><input class="form-input" name="name" type="text" autocomplete="name" required=""></div><div class="form-row-2"><div class="form-group"><label class="form-label">Telefon *</label><input class="form-input" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required=""></div><div class="form-group"><label class="form-label">E-Mail *</label><input class="form-input" name="email" type="email" inputmode="email" autocomplete="email" required=""></div></div><div class="form-group"><label class="form-label">Standort</label><select class="form-select" name="standort"><option value="">Standort auswählen</option><option>Zürich City</option><option>Zürich Oerlikon</option><option>Zürich Höngg</option><option>Winterthur</option><option>Volketswil</option><option>Frauenfeld</option><option>Kreuzlingen</option><option selected>St. Gallen</option><option>Wil</option><option>Rorschach</option><option>Basel</option><option>Andere / in meiner Nähe</option></select></div><div class="form-group"><label class="form-label">Behandlung / Anliegen <span class="termin-opt">(optional)</span></label><textarea class="form-textarea" name="behandlung" rows="3" placeholder="z. B. Akupunktur bei Rückenschmerzen">Anmeldung Tag der offenen Tür – St. Gallen (08.08.26). Ich hätte gern einen 30-Min-Slot (Anamnese &amp; Diagnose).</textarea></div><div class="form-group"><label class="form-label">Wunsch-Wochentage</label><div class="termin-chips"><label class="termin-chip"><input type="checkbox" name="wochentag" value="Mo"><span>Mo</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Di"><span>Di</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Mi"><span>Mi</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Do"><span>Do</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Fr"><span>Fr</span></label><label class="termin-chip"><input type="checkbox" name="wochentag" value="Sa"><span>Sa</span></label></div></div><div class="form-group"><label class="form-label">Wunsch-Tageszeit</label><div class="termin-chips"><label class="termin-chip"><input type="checkbox" name="tageszeit" value="Vormittags"><span>Vormittags</span></label><label class="termin-chip"><input type="checkbox" name="tageszeit" value="Nachmittags"><span>Nachmittags</span></label><label class="termin-chip"><input type="checkbox" name="tageszeit" value="Abends"><span>Abends</span></label></div></div><div class="form-group cf-turnstile-wrap"><div class="cf-turnstile" data-sitekey="__TURNSTILE_SITEKEY__" data-ts-mounted="1"></div></div><button type="submit" class="btn-primary form-submit" style="width:100%;justify-content:center">Slot sichern – solange verfügbar →</button><p class="termin-under-btn">Wir melden uns innerhalb von 1 Stunde mit einer Bestätigung.</p><div class="form-divider-quiet">Lieber direkt per WhatsApp?</div><a href="${waHref}" class="form-wa-alt-new" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366" style="display:inline-block;vertical-align:middle;margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"></path></svg>Per WhatsApp anfragen</a></form></div> </div> </div> </div> </section>

