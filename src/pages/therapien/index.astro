---
import SpaPage from '../../layouts/SpaPage.astro';
import body from '../../data/therapien-body.html?raw';

const title = 'TCM-Methoden – Behandlungen bei TCM.ch';
const description =
  'Die TCM-Behandlungsmethoden bei TCM.ch: von Akupunktur über Tuina bis Physiotherapie. Evidenzbasiert, EMR-/ASCA-anerkannt, in der ganzen Deutschschweiz.';

const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/therapien/', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/therapien" body={body} schema={schema} />

<style is:global>
  /* Therapy overview mirrors the homepage cards while keeping its own compact
     H1, specialty links and a single booking entry. No legacy hero or badge rows. */
  #page-therapien .therapy-overview{
    padding:clamp(24px,3vw,42px) 0 clamp(28px,4.2vw,60px)!important;
    background:#fff;
  }
  #page-therapien .therapy-overview .svc-header{
    display:block;margin-bottom:23px!important;
  }
  #page-therapien .therapy-overview .section-title{
    margin:0;font-size:clamp(34px,3.7vw,54px)!important;
    line-height:1.12;letter-spacing:-.04em;color:#111A1C;
  }
  #page-therapien .svc-grid{
    display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;
    gap:14px!important;margin:0!important;align-items:stretch;
  }
  #page-therapien a.svc-card{
    display:flex;flex-direction:column;min-width:0;overflow:hidden;
    border:1px solid #E1E7EC!important;border-radius:18px!important;
    background:#fff!important;color:inherit!important;text-decoration:none!important;
    box-shadow:none!important;
    transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease;
  }
  #page-therapien a.svc-card:hover{
    border-color:#B7CADB!important;box-shadow:0 9px 26px rgba(14,36,52,.08)!important;
    transform:translateY(-2px)!important;
  }
  #page-therapien a.svc-card:focus-visible,
  #page-therapien .therapy-specialists a:focus-visible,
  #page-therapien .therapy-help-button:focus-visible{
    outline:3px solid #1769B1;outline-offset:3px;
  }
  #page-therapien .svc-photo-wrap{
    display:block;position:relative;aspect-ratio:8/5!important;height:auto!important;
    flex-shrink:0;overflow:hidden;
  }
  #page-therapien .svc-photo{
    display:block;width:100%!important;height:100%!important;
    aspect-ratio:auto!important;object-fit:cover!important;filter:none!important;
  }
  /* Portrait and focal-object photography must remain fully visible, instead
     of being aggressively cropped by the default 8:5 cover treatment. */
  #page-therapien .svc-card--contain-image .svc-photo-wrap{
    box-sizing:border-box!important;
    padding:12px!important;
    background:#F3F5F7!important;
  }
  #page-therapien .svc-card--contain-image .svc-photo{
    object-fit:contain!important;
    object-position:center!important;
  }
  #page-therapien .svc-body{
    display:flex;flex:1;flex-direction:column;align-items:stretch;
    min-width:0;gap:7px!important;padding:16px 17px 17px!important;
  }
  #page-therapien .svc-name{
    margin:0!important;font-size:clamp(19px,1.55vw,23px)!important;
    font-weight:800!important;letter-spacing:-.03em;line-height:1.2;
    color:#111A1C!important;
  }
  #page-therapien .svc-tagline{
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;
    overflow:hidden;min-height:2.9em;margin:0!important;
    font-size:14px!important;font-weight:400!important;line-height:1.45;
    color:#586876!important;
  }
  #page-therapien .svc-cta{
    display:inline-flex;justify-content:flex-start;align-items:center;gap:6px;
    align-self:flex-start;margin-top:auto;padding:10px 0 0!important;
    border:0!important;color:#1769B1!important;
    font-size:14px!important;font-weight:600!important;line-height:1.3;
  }
  #page-therapien .svc-cta svg{
    flex:0 0 14px;width:14px;height:14px;
    color:#1769B1;transition:transform .18s ease;
  }
  #page-therapien .svc-card:hover .svc-cta svg{transform:translateX(2px)}
  #page-therapien .therapy-specialists{
    display:flex;align-items:baseline;flex-wrap:wrap;gap:10px 20px;
    margin-top:26px;padding-top:22px;border-top:1px solid #E7EBEF;
  }
  #page-therapien .therapy-specialists-label{
    font-size:13px;font-weight:700;color:#435362;
  }
  #page-therapien .therapy-specialists-links{
    display:flex;gap:9px 18px;flex-wrap:wrap;
  }
  #page-therapien .therapy-specialists a{
    color:#1769B1;text-decoration:underline;text-underline-offset:3px;
    text-decoration-color:rgba(23,105,177,.32);font-size:13px;
  }
  #page-therapien .therapy-help{
    padding:28px 0 35px;background:#F5F8FA;
  }
  #page-therapien .therapy-help-inner{
    display:flex;align-items:center;justify-content:space-between;gap:24px;
  }
  #page-therapien .therapy-help h2{
    margin:0 0 5px;font-size:clamp(21px,2vw,28px);
    font-weight:800;line-height:1.2;color:#111A1C;
  }
  #page-therapien .therapy-help p{
    margin:0;font-size:15px;line-height:1.5;color:#586876;
  }
  #page-therapien .therapy-help-button{
    display:inline-flex;justify-content:center;align-items:center;
    flex-shrink:0;min-height:48px;padding:12px 23px;border:0;
    border-radius:999px;background:#1769B1;color:#fff;
    font-size:15px;font-weight:700;cursor:pointer;
  }
  #page-therapien .therapy-help-button:hover{background:#145A9B}
  @media(max-width:1050px){
    #page-therapien .svc-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  }
  @media(max-width:560px){
    #page-therapien .therapy-overview{padding:21px 0 30px!important}
    #page-therapien .therapy-overview .svc-header{margin-bottom:17px!important}
    #page-therapien .svc-grid{grid-template-columns:minmax(0,1fr)!important;gap:10px!important}
    #page-therapien a.svc-card{
      display:grid;grid-template-columns:minmax(0,36%) minmax(0,1fr);
      min-height:144px;border-radius:15px!important;
    }
    #page-therapien .svc-photo-wrap{height:100%!important;min-height:144px;aspect-ratio:auto!important}
    #page-therapien .svc-photo{height:100%!important;aspect-ratio:auto!important}
    #page-therapien .svc-body{padding:13px 14px!important;gap:5px!important}
    #page-therapien .svc-name{font-size:clamp(17px,4.5vw,20px)!important;line-height:1.22}
    #page-therapien .svc-tagline{min-height:0;font-size:13px!important;line-height:1.4}
    #page-therapien .svc-cta{padding:7px 0 0!important;font-size:13px!important}
    #page-therapien .therapy-specialists{margin-top:20px;padding-top:18px}
    #page-therapien .therapy-specialists-links{gap:9px 15px}
    #page-therapien .therapy-help-inner{flex-direction:column;align-items:stretch;gap:18px}
    #page-therapien .therapy-help-button{width:100%}
  }
  @media(prefers-reduced-motion:reduce){
    #page-therapien a.svc-card,#page-therapien .svc-cta svg{transition:none!important}
    #page-therapien a.svc-card:hover{transform:none!important}
  }
</style>
