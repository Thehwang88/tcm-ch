---
// /therapien — faithful 1:1 reproduction of the live SPA #page-therapien (rich design:
// hero, "Wie wir behandeln" image cards with badges, Kräutertherapie feature, reviews,
// CTA band). Captured from the SPA render.
import SpaPage from '../../layouts/SpaPage.astro';
import body from '../../data/therapien-body.html?raw';

const title = 'TCM-Methoden – Behandlungen bei TCM.ch';
const description =
  'Die TCM-Behandlungsmethoden bei TCM.ch: von Akupunktur über Tuina bis Physiotherapie. Evidenzbasiert, EMR-/ASCA-anerkannt, an 14 Standorten.';

// Spezialisierte Unterseiten, die der gecapturte Hub nicht verlinkt (Ohrakupunktur,
// Dauernadeln, Ear Seeds, Moxibustion, Kräutertherapie, Elektroakupunktur). Ohne diesen
// Block hängen sie nur an der Navigation und werden entsprechend selten gecrawlt.
const SPEZIAL = [
  { href: '/therapien/ohrakupunktur/', label: 'Ohrakupunktur' },
  { href: '/therapien/dauernadeln/', label: 'Dauernadeln' },
  { href: '/therapien/ear-seeds/', label: 'Ear Seeds' },
  { href: '/therapien/moxibustion/', label: 'Moxibustion' },
  { href: '/therapien/kraeutertherapie/', label: 'Kräutertherapie' },
  { href: '/therapien/elektroakupunktur/', label: 'Elektroakupunktur' },
  { href: '/therapien/gesichtsakupunktur/', label: 'Gesichtsakupunktur' },
  { href: '/therapien/schroepfen/hijama/', label: 'Hijama' },
  { href: '/therapien/gua-sha/gesichts-gua-sha/', label: 'Gesichts-Gua-Sha' },
];
const spezialBlock =
  '<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal">' +
  '<div class="section-label">Spezialisierte Behandlungen</div>' +
  '<h2 class="section-title">Feiner sortiert</h2>' +
  '<p class="section-sub">Einzelne Methoden im Detail, jeweils mit Ablauf, Grenzen und Kassendeckung.</p>' +
  '<div class="cl-links">' + SPEZIAL.map((s) => `<a href="${s.href}" class="cl-chip">${s.label}</a>`).join('') + '</div>' +
  '</div></section>';

const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/therapien', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/therapien" body={body + spezialBlock} schema={schema} />
