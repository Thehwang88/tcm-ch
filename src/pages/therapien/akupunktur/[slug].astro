---
// Akupunkturverfahren-Leaf: /therapien/akupunktur/<slug>/ für eigene neue
// Methodenseiten (publishedVerfahrenPages: published + ohne canonicalUrl).
// Bestehende Methoden behalten ihre kanonischen Seiten; planned-Einträge
// (Bienengift, Pharmakopunktur) erzeugen hier bewusst KEINE Route, auch nicht
// im Dev-Server. Neue Slugs müssen zusätzlich in functions/therapien/[[path]].js
// allowlisted werden (2-Segment-Pfade sind sonst 410).
import LayoutDe from '../../../layouts/LayoutDe.astro';
import { publishedVerfahrenPages } from '../../../data/akupunkturverfahren';
import type { AkupunkturVerfahren } from '../../../data/akupunkturverfahren';

export function getStaticPaths() {
  return publishedVerfahrenPages.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

interface Props { v: AkupunkturVerfahren }
const { v } = Astro.props;
const path = `/therapien/akupunktur/${v.slug}`;
const url = `https://tcm.ch${path}/`;
const title = v.title ?? v.label;
const metaDesc = v.deck;

const schema: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Therapien', item: 'https://tcm.ch/therapien/' },
      { '@type': 'ListItem', position: 3, name: 'Akupunktur', item: 'https://tcm.ch/therapien/akupunktur/' },
      { '@type': 'ListItem', position: 4, name: v.label, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Article',
    '@id': `${url}#article`, headline: title, description: metaDesc, url, inLanguage: 'de-CH',
    ...(v.publishedAt ? { datePublished: v.publishedAt } : {}),
    ...(v.updatedAt ? { dateModified: v.updatedAt } : {}),
    publisher: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/', logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' } },
  },
];
---
<LayoutDe title={title} description={metaDesc} path={path} schema={schema} noindex={!v.indexable} robots={v.indexable ? undefined : 'noindex, follow'}>
  <article>
    <section class="hero">
      <div class="wrap narrow">
        <div class="crumbs" role="navigation" aria-label="Breadcrumb">
          <a href="/therapien/">Therapien</a>
          <span aria-hidden="true">›</span>
          <a href="/therapien/akupunktur/">Akupunktur</a>
          <span aria-hidden="true">›</span>
          <a href="/therapien/akupunktur/verfahren/">Verfahren</a>
        </div>
        <div class="cat">Akupunkturverfahren</div>
        <h1>{v.h1 ?? v.label}</h1>
        <p class="deck">{v.deck}</p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap narrow">
        <div class="read">

          {v.shortAnswerHtml && (
            <aside class="short">
              <div class="box-label">Kurz gesagt</div>
              <div class="kb-body" set:html={v.shortAnswerHtml} />
            </aside>
          )}

          {v.bodyHtml && <div class="kb-body" set:html={v.bodyHtml} />}

          {v.evidenceHtml && (
            <aside class="box">
              <div class="box-label">Evidenz &amp; Einordnung</div>
              <div class="kb-body" set:html={v.evidenceHtml} />
            </aside>
          )}

          {v.safetyHtml && (
            <aside class="box box--warn">
              <div class="box-label">Sicherheit</div>
              <div class="kb-body" set:html={v.safetyHtml} />
            </aside>
          )}

          {v.offeringNote && (
            <aside class="box box--offer">
              <div class="box-label">Verfügbarkeit bei TCM.ch</div>
              <div class="kb-body"><p>{v.offeringNote} <a href="/kontakt/">Zur Zuweisung</a></p></div>
            </aside>
          )}
        </div>

        {v.related && v.related.length > 0 && (
          <div class="related">
            <div class="rel-label">Zum Weiterlesen</div>
            <div class="rel-grid">
              {v.related.map((r) => (
                <a class="rel-card" href={r.href}>
                  <div class="rel-cat">{r.cat}</div>
                  <div class="rel-title">{r.label}</div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </article>
</LayoutDe>

<style>
  .wrap.narrow { max-width: 960px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13.5px; margin-bottom: 18px; }
  .crumbs a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span[aria-hidden] { color: var(--muted); }
  .cat { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); margin-bottom: 12px; }
  h1 { font-size: clamp(30px, 4.6vw, 46px); line-height: 1.1; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 16px; max-width: 820px; }
  .deck { font-size: 20px; line-height: 1.5; color: var(--mid); max-width: 720px; margin: 0; }

  .read { max-width: 720px; }
  .kb-body :global(h2) { font-size: 25px; font-weight: 800; color: var(--ink); margin: 40px 0 14px; letter-spacing: var(--tracking-heading); }
  .kb-body :global(p) { font-size: 17.5px; line-height: 1.7; color: var(--mid); margin: 0 0 18px; }
  .kb-body :global(a) { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kb-body :global(a:hover) { text-decoration: underline; }
  .kb-body :global(strong) { color: var(--ink); }

  .short { background: var(--blue-light); border-left: 3px solid var(--blue); border-radius: 0 var(--r-card) var(--r-card) 0; padding: 20px 22px; margin: 0 0 30px; }
  .box { border: 1px solid var(--border); border-radius: var(--r-card); padding: 20px 22px; margin: 30px 0; }
  .box--warn { border-left: 3px solid #c8842a; border-radius: 0 var(--r-card) var(--r-card) 0; }
  .box--offer { background: var(--surface); }
  .box-label, .short .box-label { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 8px; }
  .box--warn .box-label { color: #92400E; }
  .short :global(p), .box :global(p) { margin: 0 0 10px; font-size: 16px; }
  .short :global(p:last-child), .box :global(p:last-child) { margin-bottom: 0; }

  .related { border-top: 1px solid var(--border); margin-top: 48px; padding-top: 24px; }
  .rel-label { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .rel-card { border: 1px solid var(--border); border-radius: var(--r-card); padding: 16px; text-decoration: none; transition: border-color var(--t-fast) ease; }
  .rel-card:hover { border-color: var(--blue); }
  .rel-cat { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--blue); margin-bottom: 6px; }
  .rel-title { font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.3; }

  @media (max-width: 860px) { .rel-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .rel-grid { grid-template-columns: 1fr; } }
</style>
