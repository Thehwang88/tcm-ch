---
// /therapien/massage — Pillar-Superpage. Reuses SpaPage (Header/Footer/tokens/home.css)
// like the other Therapien-Seiten; content lives in massage-body.html, the InsuranceBanner
// component is injected at the <!--BANNER--> marker (inline) und als sticky Mobile-Bar.
import SpaPage from '../../../layouts/SpaPage.astro';
import InsuranceBanner from '../../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../../components/MassageAnfrageForm.astro';
import WhatsAppContact from '../../../components/WhatsAppContact.astro';
import bodyRaw from '../../../data/massage-body.html?raw';

const [heroPart, afterBanner] = bodyRaw.split('<!--BANNER-->');
const [beforeFaq, faqPart] = afterBanner.split('<!--WHATSAPP-->');

const url = 'https://tcm.ch/therapien/massage/';
const title = 'Massage Winterthur & St. Gallen | Medizinische Massage – TCM.ch';
const description = 'Medizinische Massage in Winterthur & St. Gallen, EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar. Termine oft innert 24 bis 48 Stunden.';

const faqs = [
  { q: 'Übernimmt die Krankenkasse eine Massage?', a: 'Medizinische Massagen bei EMR- oder ASCA-anerkannten Therapeut:innen werden in der Regel über die Zusatzversicherung mitgetragen, meist zu 50 bis 90 Prozent. Die Grundversicherung zahlt keine Massagen. Wellness-Massagen sind reine Selbstzahlerleistungen.' },
  { q: 'Brauche ich eine ärztliche Verordnung?', a: 'Nein. Für die Abrechnung über die Zusatzversicherung genügt, dass die Behandlung bei einer anerkannten Fachperson stattfindet. Du kannst also direkt einen Termin anfragen, ohne vorher zum Arzt zu gehen.' },
  { q: 'Was ist der Unterschied zwischen medizinischer und klassischer Massage?', a: 'Die klassische Massage ist eine Grundtechnik zur allgemeinen Lockerung. Die medizinische Massage setzt gezielt bei einer konkreten Beschwerde an, nach einem kurzen Befund und mit dem Ziel, Schmerzen zu lindern oder die Beweglichkeit zu verbessern.' },
  { q: 'Ist eine Massage schmerzhaft?', a: 'Sie soll es nicht sein. Bei tieferer Arbeit an Verspannungen kann der Druck kurz intensiv sein, bleibt aber im angenehmen Bereich. Sag deiner Therapeutin jederzeit Bescheid, wir passen die Intensität an.' },
  { q: 'Ist Massage in der Schwangerschaft möglich?', a: 'Ja, mit angepasster Technik und Lagerung. Die Schwangerschaftsmassage ist schonend und wird auf das jeweilige Trimester abgestimmt. Sprich uns bei der Anfrage kurz darauf an.' },
  { q: 'Wie lange dauert eine Sitzung und was kostet sie?', a: 'Üblich sind 30, 45 oder 60 Minuten, je nach Anliegen. Der Preis richtet sich nach Dauer und Aufwand. Über die Zusatzversicherung bekommst du bei medizinischen Massagen je nach Police einen grossen Teil zurück.' },
  { q: 'Welcher Standort passt für mich?', a: 'In Winterthur hast du die Wahl zwischen Münzgasse 2 und Marktgasse 78, beide in der Altstadt. In St. Gallen findest du uns am Oberen Graben 22. Nimm einfach den Standort, der für dich am bequemsten liegt.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'MedicalTherapy',
    name: 'Medizinische Massage',
    description: 'Medizinische Massage bei EMR- und ASCA-anerkannten Therapeut:innen in Winterthur und St. Gallen, über die Zusatzversicherung abrechenbar.',
    url,
    medicineSystem: 'https://schema.org/TraditionalChinese',
    relevantSpecialty: 'PhysicalTherapy',
    areaServed: [
      { '@type': 'City', name: 'Winterthur' },
      { '@type': 'City', name: 'St. Gallen' },
    ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Therapien', item: 'https://tcm.ch/therapien/' },
    { '@type': 'ListItem', position: 3, name: 'Massage', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/therapien/massage" body="" schema={schema}>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Winterthur & St. Gallen" />
  <Fragment set:html={beforeFaq} />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Massage-Team TCM.ch" />
  <Fragment set:html={faqPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="massage" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
