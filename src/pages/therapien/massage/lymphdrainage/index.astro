---
import SpaPage from '../../../../layouts/SpaPage.astro';
import InsuranceBanner from '../../../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../../../components/MassageAnfrageForm.astro';
import WhatsAppContact from '../../../../components/WhatsAppContact.astro';
import bodyRaw from '../../../../data/massage-lymphdrainage-body.html?raw';
import css from '../../../../data/massage-city.css?raw';

const url = 'https://tcm.ch/therapien/massage/lymphdrainage/';
const title = 'Lymphdrainage Winterthur & St. Gallen | Manuelle Lymphdrainage – TCM.ch';
const description = 'Manuelle Lymphdrainage in Winterthur & St. Gallen: sanfte Technik bei Schwellungen und Wassereinlagerungen. EMR-/ASCA-anerkannt, über die Zusatzversicherung abrechenbar.';

// Eine Quelle fuer sichtbare FAQ und FAQPage-Schema: faqs[] wird unten in den
// <!--FAQ-->-Platzhalter im Body gerendert. Vorher lagen beide Kopien getrennt vor
// und konnten auseinanderlaufen (Schema ohne passendes sichtbares FAQ = Snippet-Risiko).
const faqs = [
  { q: 'Was bringt manuelle Lymphdrainage?', a: 'Sie regt den Abfluss gestauter Gewebsflüssigkeit an: Schwellungen gehen zurück, Spannung und Schweregefühl lassen nach, nach Operationen kann die Erholung schneller laufen. Beim chronischen Lymphödem ist sie Teil der etablierten Standardbehandlung, immer zusammen mit Kompression.' },
  { q: 'Wie oft braucht man Lymphdrainage?', a: 'Nach Operationen oft nur wenige Sitzungen, beim chronischen Lymphödem ein- bis zweimal wöchentlich in Serien als Langzeitbegleitung. Den Rahmen gibt die ärztliche Verordnung.' },
  { q: 'Übernimmt die Krankenkasse die Lymphdrainage?', a: 'Als Massageleistung beteiligt sich die Zusatzversicherung, meist mit 50 bis 90 Prozent, ganz ohne Verordnung. Mit ärztlicher Verordnung als physiotherapeutische Leistung übernimmt die Grundversicherung nach Franchise und Selbstbehalt. Beim Lymphödem sind wiederholte Serien üblich.' },
  { q: 'Ist Lymphdrainage wie eine Massage?', a: 'Nein, sie ist viel sanfter: rhythmische, kreisende Griffe an der Hautoberfläche statt Druck in die Muskulatur. Wer eine kräftige Massage erwartet, wundert sich, und schläft dann oft trotzdem ein.' },
  { q: 'Hilft Lymphdrainage beim Lipödem?', a: 'Sie lindert Spannungsgefühl, Druckschmerz und Begleitschwellung, die Fettverteilungsstörung selbst behandelt sie nicht, das sagen wir ehrlich. Am wirksamsten ist sie im Paket mit Kompression und Bewegung.' },
  { q: 'Kann ich mit einer Thrombose zur Lymphdrainage?', a: 'Nein, bei akuter unbehandelter Thrombose wird nicht drainiert. Eine plötzliche einseitige, schmerzhafte Beinschwellung gehört sofort ärztlich abgeklärt, vor jeder Behandlung.' },
];
const faqHtml = '<div class="msg-faq" style="margin-top:10px">' + faqs
  .map((f, n) => `<details${n === 0 ? ' open' : ''}><summary>${f.q}</summary><p class="msg-faq-a">${f.a}</p></details>`)
  .join('') + '</div>';
const [heroPart, restPart] = bodyRaw.replace('<!--FAQ-->', faqHtml).split('<!--BANNER-->');

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'MedicalTherapy', name: 'Manuelle Lymphdrainage',
    description: 'Sanfte manuelle Lymphdrainage bei EMR- und ASCA-anerkannten Therapeut:innen in Winterthur und St. Gallen, über die Zusatzversicherung abrechenbar.',
    url, relevantSpecialty: 'PhysicalTherapy',
    areaServed: [{ '@type': 'City', name: 'Winterthur' }, { '@type': 'City', name: 'St. Gallen' }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Therapien', item: 'https://tcm.ch/therapien/' },
    { '@type': 'ListItem', position: 3, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 4, name: 'Lymphdrainage', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/therapien/massage/lymphdrainage" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Winterthur & St. Gallen" />
  <Fragment set:html={restPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="lymphdrainage" />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Massage-Team TCM.ch" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
