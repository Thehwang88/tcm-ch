---
import SpaPage from '../../../../layouts/SpaPage.astro';
import InsuranceBanner from '../../../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../../../components/MassageAnfrageForm.astro';
import bodyRaw from '../../../../data/massage-triggerpunkt-body.html?raw';
import css from '../../../../data/massage-city.css?raw';

const [heroPart, restPart] = bodyRaw.split('<!--BANNER-->');
const url = 'https://tcm.ch/therapien/massage/triggerpunktmassage/';
const title = 'Triggerpunktmassage Winterthur & St. Gallen | TCM.ch';
const description = 'Triggerpunktmassage in Winterthur & St. Gallen: gezielter Druck auf verhärtete Punkte mit ausstrahlendem Schmerz. EMR-/ASCA-anerkannt, über die Zusatzversicherung abrechenbar.';

const faqs = [
  { q: 'Was ist ein Triggerpunkt?', a: 'Eine kleine, verhärtete Stelle im Muskel, die auf Druck schmerzt und den Schmerz oft in eine andere Region ausstrahlt. Ein verspannter Nackenmuskel etwa kann Kopfschmerzen auslösen, obwohl der Kopf selbst gesund ist.' },
  { q: 'Ist es normal, dass der Schmerz ausstrahlt?', a: 'Ja, das ist typisch und sogar hilfreich. Wenn der bekannte ausstrahlende Schmerz beim Druck auftritt, bestätigt das, dass wir den richtigen Punkt getroffen haben. Nach kurzer Zeit lässt die Spannung meist nach.' },
  { q: 'Wie viele Sitzungen brauche ich?', a: 'Bei einem frischen Triggerpunkt reicht manchmal eine Sitzung, bei länger bestehenden oder wiederkehrenden Beschwerden sind mehrere über einige Wochen sinnvoll. Wichtig ist, auch die Ursache anzugehen, etwa die Haltung am Arbeitsplatz. Wir schätzen das gemeinsam mit dir ein.' },
  { q: 'Was ist der Unterschied zur Akupressur?', a: 'Beide arbeiten mit gezieltem Fingerdruck. Die Akupressur nutzt festgelegte Punkte aus der chinesischen Medizin, die Triggerpunktmassage richtet sich nach dem tastbaren verhärteten Punkt im Muskel und seinem Ausstrahlungsmuster.' },
  { q: 'Übernimmt die Krankenkasse die Triggerpunktmassage?', a: 'Als medizinische Massage bei anerkannten Therapeut:innen beteiligt sich in der Regel die Zusatzversicherung, meist zu 50 bis 90 Prozent. Die Grundversicherung zahlt keine Massagen. Wie viel bei dir zurückkommt, hängt von deiner Police ab.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'MedicalTherapy', name: 'Triggerpunktmassage',
    description: 'Triggerpunktmassage bei EMR- und ASCA-anerkannten Therapeut:innen in Winterthur und St. Gallen gegen verhärtete Punkte mit ausstrahlendem Schmerz, über die Zusatzversicherung abrechenbar.',
    url, relevantSpecialty: 'PhysicalTherapy',
    areaServed: [{ '@type': 'City', name: 'Winterthur' }, { '@type': 'City', name: 'St. Gallen' }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Therapien', item: 'https://tcm.ch/therapien/' },
    { '@type': 'ListItem', position: 3, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 4, name: 'Triggerpunktmassage', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/therapien/massage/triggerpunktmassage" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Winterthur & St. Gallen" />
  <Fragment set:html={restPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="triggerpunktmassage" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
