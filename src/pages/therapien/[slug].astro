---
// /therapien/[slug] — faithful 1:1 reproduction of each live SPA therapie leaf.
// Each leaf was captured from the SPA render (#page-therapie) into
// src/data/therapie-leaves/<slug>.html — full rich page: hero+image, trust cards,
// sticky sidebar (Termin widget + "Hilft bei"), standort cards, reviews, symptom pills,
// "Ähnliche Therapien", FAQ, the full contact form, dark CTA band. Per-slug content is
// baked into each captured file (sidebar list, related therapies, FAQ are slug-specific).
import SpaPage from '../../layouts/SpaPage.astro';
import homeBody from '../../data/home-body.html?raw';
import { prefillForm } from '../../data/form-prefill';
import { inlineBodyImage } from '../../data/inline-body-image';
import { appendSidebarAllLink } from '../../data/cap-sidebar';
import { parseLeafFaqs, faqPageSchema } from '../../data/leaf-faq';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/therapie-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.keys(leaves).map((p) => {
    const slug = p.split('/').pop()!.replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] as string } };
  });
}

const { slug } = Astro.params;
const body = Astro.props.body as string;
const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
const name = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/\s*TCM\.ch.*$/i, '').replace(/\s+/g, ' ').trim() : slug;
const url = `https://tcm.ch/therapien/${slug}/`;
// Per-slug overrides (default templates otherwise).
const TITLE_OVERRIDE: Record<string, string> = {
  elektroakupunktur: 'Elektroakupunktur in der Schweiz | TCM.ch',
  shiatsu: 'Shiatsu – Behandlung & Wirkung | TCM.ch',
  physiotherapie: 'Physiotherapie – Kliniken & Termine | TCM.ch',
};
const title = TITLE_OVERRIDE[slug] ?? `${name} – TCM-Behandlung | TCM.ch`;
const DESC_OVERRIDE: Record<string, string> = {
  schroepfen: 'Schröpfen und blutiges Schröpfen (Hijama) bei TCM.ch: EMR-/ASCA-anerkannt, Zusatzversicherung 80–100 %. Geprüfte Therapeuten an 14 Standorten.',
  elektroakupunktur: 'Elektroakupunktur kombiniert Akupunktur mit sanften elektrischen Impulsen für eine gleichmässige Reizung. EMR-/ASCA-anerkannt, an 14 Standorten.',
  shiatsu: 'Shiatsu bei TCM.ch: japanische Drucktherapie bei Verspannungen, Stress und Schlafproblemen. Anerkannt von Zusatzversicherungen. Termin in 24–48h.',
  physiotherapie: 'Physiotherapie bei TCM.ch: manuelle Therapie, Triggerpunkt-Behandlung, Reha. Mit ärztlicher Verordnung über die Grundversicherung. Termin in 24 bis 48 h.',
};
const description = DESC_OVERRIDE[slug] ?? `${name} bei TCM.ch: medizinische TCM, EMR-/ASCA-anerkannt, Krankenkasse 80–100 % über die Zusatzversicherung. Termin oft in 24 Stunden.`;
// Per-Slug OG-Bild, wo das Standard-Motiv nicht passt (Default: site.ogImage).
const OG_OVERRIDE: Record<string, string> = {
  shiatsu: 'https://tcm.ch/images/img-7149f50cc917.webp',
};
const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Therapien', item: 'https://tcm.ch/therapien/' },
    { '@type': 'ListItem', position: 3, name, item: url },
  ] },
];
// Per-slug FAQ -> FAQPage schema (only where the leaf carries a matching FAQ accordion).
const FAQ_OVERRIDE: Record<string, { q: string; a: string }[]> = {
  elektroakupunktur: [
    { q: 'Was ist Elektroakupunktur?', a: 'Akupunktur, bei der die Nadeln mit einem Gerät verbunden werden, das schwache elektrische Impulse abgibt und den Punkt gleichmässig stimuliert.' },
    { q: 'Tut Elektroakupunktur weh?', a: 'Nein. Du spürst ein leichtes Kribbeln oder Pochen, das angenehm eingestellt wird.' },
    { q: 'Was ist der Unterschied zur normalen Akupunktur?', a: 'Statt von Hand übernimmt ein Gerät die gleichmässige Stimulation über die ganze Sitzung, der Reiz ist stärker und konstanter.' },
    { q: 'Ist Elektroakupunktur für jeden geeignet?', a: 'Nicht bei Herzschrittmacher, elektronischen Implantaten, in der Schwangerschaft oder bei bestimmten Herzerkrankungen. Vorab mit dem Therapeuten klären.' },
    { q: 'Übernimmt die Krankenkasse Elektroakupunktur?', a: 'Bei EMR-/ASCA-Therapeuten beteiligen sich viele Zusatzversicherungen, die Grundversicherung nicht.' },
  ],
};
if (FAQ_OVERRIDE[slug]) {
  schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: FAQ_OVERRIDE[slug].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
} else {
  // No override -> source FAQPage from the leaf's own visible FAQ accordion.
  const leafFaqs = parseLeafFaqs(body);
  if (leafFaqs.length) schema.push(faqPageSchema(leafFaqs));
}
// Prefill the contact form with this therapy as the topic (editable; source in hidden quelle).
// + move the orphaned sticky body image into the text flow (after the intro paragraph).
let prefilledBody = appendSidebarAllLink(
  inlineBodyImage(prefillForm(body, `Ich interessiere mich für ${name}.`, `Therapie: ${name}`)),
  'therapie-symptoms-sidebar', '/beschwerden/', 'Alle Beschwerden ansehen');
// Shiatsu: Standard-Offer-Block ("Starte ohne Risiko") 1:1 von Home wiederverwenden.
if (slug === 'shiatsu') {
  const os = homeBody.indexOf('<section id="s-offer"');
  const offer = os >= 0 ? homeBody.slice(os, homeBody.indexOf('</section>', os) + '</section>'.length) : '';
  prefilledBody = prefilledBody.replace('<div id="therapie-cities-section">', offer + '<div id="therapie-cities-section">');
}
---
<SpaPage title={title} description={description} path={`/therapien/${slug}`} body={prefilledBody} schema={schema} ogImage={OG_OVERRIDE[slug]} />
