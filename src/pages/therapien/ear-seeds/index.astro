---
// /therapien/ear-seeds — therapy page (Ear Seeds / Ohrsamen, nadelfreie Ohrakupressur).
// Same layout/tokens/components as the other therapy pages.
import SpaPage from '../../../layouts/SpaPage.astro';
import bodyRaw from '../../../data/ear-seeds-body.html?raw';
import { prefillForm } from '../../../data/form-prefill';
import { inlineBodyImage } from '../../../data/inline-body-image';
import { appendSidebarAllLink } from '../../../data/cap-sidebar';
const body = appendSidebarAllLink(
  inlineBodyImage(prefillForm(bodyRaw, 'Ich interessiere mich für Ear Seeds (Ohrsamen).', 'Therapie: Ear Seeds')),
  'therapie-symptoms-sidebar', '/beschwerden/', 'Alle Beschwerden ansehen');

const url = 'https://tcm.ch/therapien/ear-seeds/';
const title = 'Ear Seeds (Ohrsamen) in der Schweiz | TCM.ch';
const description = 'Ear Seeds, die nadelfreie Ohrakupressur mit kleinen Samen. Gesetzt von geprüften TCM-Therapeuten. Sanfte Alternative zu Akupunktur und Dauernadeln. EMR-/ASCA.';

const faqs = [
  { q: 'Was sind Ear Seeds?', a: 'Kleine Samen oder Kügelchen, die mit einem Pflaster auf Ohrpunkte geklebt werden und sanften Druck ausüben. Nadelfrei.' },
  { q: 'Sind Ear Seeds dasselbe wie Akupunktur?', a: 'Nein. Akupunktur und Dauernadeln stechen in die Haut, Ear Seeds wirken nur über Druck von aussen.' },
  { q: 'Wie lange bleiben Ear Seeds im Ohr?', a: 'Meist drei bis fünf Tage.' },
  { q: 'Tun Ear Seeds weh?', a: 'Nein, sie sind nadelfrei. Beim Draufdrücken spürst du nur einen leichten Druck.' },
  { q: 'Kann ich mit Ear Seeds duschen und schlafen?', a: 'Ja, beides ist möglich. Das Ohr sauber und trocken halten.' },
  { q: 'Helfen Ear Seeds beim Abnehmen?', a: 'Sie werden unterstützend bei Heisshunger eingesetzt, ersetzen aber keine Ernährungsumstellung. Ein Versprechen zum Gewichtsverlust gibt es nicht.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Therapien', item: 'https://tcm.ch/therapien/' },
    { '@type': 'ListItem', position: 3, name: 'Ear Seeds', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/therapien/ear-seeds" body={body} schema={schema} />
