---
// /akupunktur-tcm-zuerich/ - kommerzielle Zürich-Hub-Landingpage (Hub & Spoke → die 3 Zürcher Standorte).
export const prerender = true;
import SpaPage from '../layouts/SpaPage.astro';
import rawBody from '../data/akupunktur-tcm-zuerich-body.html?raw';
import { zhStandortOptionsHtml, zhTerminData, zhTerminScript } from '../data/zuerich-termin';
import StickyCta from '../components/StickyCta.astro';

// Zürcher Standort-Optionen im Termin-Formular aus der zentralen Quelle (src/data/zuerich-termin.ts)
// statt hartcodiert - noch nicht anfragbare Standorte (terminAb) erscheinen erst ab Stichtag.
const ZH_ALT = '<select class="form-select" name="standort"><option value="">Standort auswählen</option><option>Zürich Oerlikon</option><option>Zürich Höngg</option><option>Andere / in meiner Nähe</option></select>';
if (!rawBody.includes(ZH_ALT)) throw new Error('akupunktur-tcm-zuerich: Standort-Select nicht gefunden');
const body = rawBody.replace(
  ZH_ALT,
  `<select class="form-select" name="standort" data-zh-termin="${zhTerminData({ html: true })}"><option value="">Egal - bitte empfehlen</option>${zhStandortOptionsHtml()}<option data-zh-last>Anderer Standort / in meiner Nähe</option></select>`,
) + zhTerminScript;

const title = 'TCM Zürich & Akupunktur Zürich | TCM.ch';
const description =
  'Akupunktur & TCM in Zürich: mehrere Standorte, ein Netzwerk. Sag uns, wo du bist - wir finden die passende Praxis oder den nächsten freien Termin. EMR-/ASCA-anerkannt.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: 'TCM.ch – Akupunktur & TCM Zürich',
    url: 'https://tcm.ch/akupunktur-tcm-zuerich/',
    image: 'https://tcm.ch/og-image.jpg',
    medicalSpecialty: ['TraditionalChineseMedicine', 'Acupuncture'],
    telephone: '+41775236122',
    email: 'termine@tcm.ch',
    priceRange: '$$',
    areaServed: [
      { '@type': 'City', name: 'Zürich' },
      { '@type': 'AdministrativeArea', name: 'Kanton Zürich' },
    ],
    department: [
      { '@type': 'MedicalClinic', name: 'TCM.ch Zürich Oerlikon', url: 'https://tcm.ch/standorte/zuerich-oerlikon/', address: { '@type': 'PostalAddress', addressLocality: 'Zürich Oerlikon', postalCode: '8050', addressRegion: 'ZH', addressCountry: 'CH' } },
      { '@type': 'MedicalClinic', name: 'TCM.ch Zürich Höngg', url: 'https://tcm.ch/standorte/zuerich-hoengg/', address: { '@type': 'PostalAddress', addressLocality: 'Zürich Höngg', postalCode: '8049', addressRegion: 'ZH', addressCountry: 'CH' } },
    ],
    availableService: [
      { '@type': 'MedicalProcedure', name: 'Akupunktur' },
      { '@type': 'MedicalProcedure', name: 'Traditionelle Chinesische Medizin' },
      { '@type': 'MedicalProcedure', name: 'Tuina-Massage' },
      { '@type': 'MedicalProcedure', name: 'Schröpfen' },
      { '@type': 'MedicalProcedure', name: 'Moxibustion' },
      { '@type': 'MedicalProcedure', name: 'Chinesische Kräutertherapie' },
    ],
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '500' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'TCM & Akupunktur Zürich', item: 'https://tcm.ch/akupunktur-tcm-zuerich/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Wo finde ich Akupunktur in Zürich in meiner Nähe?', acceptedAnswer: { '@type': 'Answer', text: 'TCM.ch hat im Raum Zürich Standorte in Oerlikon und in Höngg; ein neuer Standort im Zentrum ist in Vorbereitung. So findest du eine Praxis in deiner Nähe, ohne lange Anfahrt. Schildere kurz dein Anliegen, wir buchen dich in der nächsten passenden Klinik ein.' } },
      { '@type': 'Question', name: 'Muss ich schon wissen, welchen Standort ich wählen möchte?', acceptedAnswer: { '@type': 'Answer', text: 'Nein. Sag uns einfach, wo du in Zürich wohnst oder arbeitest und was dir wichtig ist - nächster Standort oder schnellster Termin. Wir schlagen dir den passenden Standort vor.' } },
      { '@type': 'Question', name: 'Kann ich auch aus Altstetten, Seefeld, Wiedikon oder einem anderen Quartier kommen?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Unsere Zürcher Standorte sind mit dem ÖV aus der ganzen Stadt gut erreichbar. Patient:innen kommen aus allen Zürcher Quartieren zu uns - wir finden den Standort mit dem kürzesten Weg oder dem schnellsten freien Termin.' } },
      { '@type': 'Question', name: 'Was, wenn mein Wunschstandort keinen freien Termin hat?', acceptedAnswer: { '@type': 'Answer', text: 'Dann bieten wir dir den nächsten freien Termin an einem anderen Zürcher Standort an. Du entscheidest, ob du lieber wartest oder ausweichst.' } },
      { '@type': 'Question', name: 'Übernimmt die Krankenkasse die Akupunktur?', acceptedAnswer: { '@type': 'Answer', text: 'Akupunktur und TCM laufen über die Zusatzversicherung, nicht über die Grundversicherung. Unsere Therapeut:innen sind EMR- und ASCA-anerkannt. Bei den meisten Kassen werden 80 bis 100 Prozent übernommen. Wir prüfen das kostenlos vor deinem ersten Termin.' } },
      { '@type': 'Question', name: 'Wie schnell bekomme ich einen Termin in Zürich?', acceptedAnswer: { '@type': 'Answer', text: 'Wir antworten auf deine Anfrage meist innerhalb einer Stunde. Ein Ersttermin ist je nach Standort und Verfügbarkeit oft schon innert 24 bis 48 Stunden möglich, an den Zürcher Standorten Oerlikon und Höngg.' } },
      { '@type': 'Question', name: 'Tut Akupunktur weh?', acceptedAnswer: { '@type': 'Answer', text: 'Die Nadeln sind dünner als ein Haar. Die meisten spüren beim Setzen nur ein kurzes Ziehen oder Kribbeln, danach oft eine angenehme Schwere. Wenn etwas unangenehm ist, sag Bescheid, dann passen wir an.' } },
      { '@type': 'Question', name: 'Bei welchen Beschwerden hilft TCM?', acceptedAnswer: { '@type': 'Answer', text: 'Häufige Gründe sind Rücken- und Nackenschmerzen, Migräne, Schlafprobleme, Stress und Erschöpfung, Zyklusbeschwerden sowie Kinderwunsch. Beim ersten Gespräch klären wir ehrlich, ob TCM in deinem Fall sinnvoll ist.' } },
    ],
  },
];
---
<SpaPage title={title} description={description} path="/akupunktur-tcm-zuerich" body={body} schema={schema}>
  <!-- Mobile Sticky-CTA (bestehende Komponente; erscheint erst nach dem Hero) -->
  <StickyCta prefill="Hallo, ich suche eine TCM-Praxis in Zürich." formTarget="#zh-funnel" heroSelector=".akz-hero" />
</SpaPage>
