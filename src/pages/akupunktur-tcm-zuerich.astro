---
// /akupunktur-tcm-zuerich/ - kommerzielle Zürich-Hub-Landingpage (Hub & Spoke → die 3 Zürcher Standorte).
export const prerender = true;
import SpaPage from '../layouts/SpaPage.astro';
import rawBody from '../data/akupunktur-tcm-zuerich-body.html?raw';
import { zhStandortOptionsHtml } from '../data/zuerich-termin';
import StickyCta from '../components/StickyCta.astro';
import BrandSignature from '../components/BrandSignature.astro';
import { therapyCardsGridHtml } from '../data/therapy-cards';
import { standortCardHtml } from '../lib/standort-card';
import { NETZ_THERAPIEN } from '../data/standorte';

// Zürcher Standort-Optionen im Termin-Formular aus der zentralen Quelle (src/data/zuerich-termin.ts)
// statt hartcodiert - geplante Standorte (clinic.status) nur mit Vormerk-/Partner-Optionen.
const ZH_ALT = '<select class="form-select" name="standort"><option value="">Standort auswählen</option><option>Zürich Oerlikon</option><option>Zürich Höngg</option><option>Andere / in meiner Nähe</option></select>';
if (!rawBody.includes(ZH_ALT)) throw new Error('akupunktur-tcm-zuerich: Standort-Select nicht gefunden');
// Therapien: EIN Kartenraster wie St. Gallen und die Zürcher Standortseiten (gemeinsame Kartendaten therapy-cards.ts).
// Top 8 = die ersten 8 Karten des Netz-Kartensets (NETZ_THERAPIEN), genau die sichtbaren Karten der St.-Galler und Zürcher
// Standortseiten; Kräutertherapie, Massage, Moxibustion und Elektroakupunktur als Textlinks darunter.
const ZH_KARTEN = '<!--zh-therapie-karten-->';
if (!rawBody.includes(ZH_KARTEN)) throw new Error('akupunktur-tcm-zuerich: Therapie-Karten-Marker nicht gefunden');
const ZH_TOP8 = NETZ_THERAPIEN.slice(0, 8); // dieselben 8 sichtbaren Karten wie St. Gallen und die Zürcher Standortseiten
if (ZH_TOP8.length !== 8) throw new Error(`akupunktur-tcm-zuerich: erwartet 8 Therapie-Karten, gefunden ${ZH_TOP8.length}`);
const ZH_STANDORTE = '<!--zh-standort-karten-->';
if (!rawBody.includes(ZH_STANDORTE)) throw new Error('akupunktur-tcm-zuerich: Standort-Karten-Marker nicht gefunden');
const zhCards = '<div class="sc-grid sc-grid--3">' +
  [
    ['zuerich-bahnhofstrasse', 'zuerich-bahnhofstrasse'],
    ['zuerich-oerlikon', 'zuerich-oerlikon'],
    ['zuerich-hoengg', 'zuerich-hoengg'],
  ].map(([id, tracking]) => standortCardHtml(id, {
    variant: 'kompakt',
    attrs: `onclick="window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'zh_standort_card_click',standort:'${tracking}'})"`,
  })).join('') +
  '</div>';

const body = rawBody.replace(
  ZH_ALT,
  `<select class="form-select" name="standort" id="zh-standort"><option value="">Egal - bitte empfehlen</option>${zhStandortOptionsHtml()}</select>`,
).replace(ZH_KARTEN, therapyCardsGridHtml(ZH_TOP8))
  .replace(ZH_STANDORTE, zhCards);

// Brand Signature direkt vor dem End-CTA (nach FAQ): Standortfinder, Quartiere und Funnel bleiben ungestört.
const END_CTA = '<section class="cta-band" style="background:#F2F4F2;padding:48px 0">';
const endCtaAt = body.lastIndexOf(END_CTA);
if (endCtaAt < 0) throw new Error('akupunktur-tcm-zuerich: End-CTA nicht gefunden');

const title = 'TCM & Akupunktur Zürich: Chinesische Medizin | TCM.ch';
const description =
  'TCM & Akupunktur in Zürich: drei Praxen im TCM.ch Netzwerk, in Zürich City, Oerlikon und Höngg. EMR-/ASCA-registriert, Zusatzversicherung, Termin finden.';

const schema = [
  // Hub = Zürcher Netzwerk-Übersicht, KEINE eigene physische Praxis: CollectionPage über die
  // Organisation TCM.ch (@id aus dem Home-Schema) mit Liste der Zürcher Standortseiten. Die
  // Praxis-Entitäten selbst stehen auf den Standortseiten (keine Dubletten, keine Adresse hier).
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://tcm.ch/akupunktur-tcm-zuerich/#webpage',
    name: 'Akupunktur & TCM in Zürich',
    url: 'https://tcm.ch/akupunktur-tcm-zuerich/',
    inLanguage: 'de-CH',
    about: { '@id': 'https://tcm.ch/#org' },
    publisher: { '@id': 'https://tcm.ch/#org' },
    spatialCoverage: { '@type': 'City', name: 'Zürich' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'TCM.ch Bahnhofstrasse – Bahnhofstrasse 37, 8001 Zürich', url: 'https://tcm.ch/standorte/zuerich-bahnhofstrasse/' },
        { '@type': 'ListItem', position: 2, name: 'TCM.ch Oerlikon – Ohmstrasse 14, 8050 Zürich', url: 'https://tcm.ch/standorte/zuerich-oerlikon/' },
        { '@type': 'ListItem', position: 3, name: 'Zürich Höngg – Praxis Hwang, Partnerpraxis im TCM.ch Netzwerk', url: 'https://tcm.ch/standorte/zuerich-hoengg/' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Zürich', item: 'https://tcm.ch/akupunktur-tcm-zuerich/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Muss ich wissen, welcher Standort der richtige ist?', acceptedAnswer: { '@type': 'Answer', text: 'Nein. Sag uns einfach, wo du in Zürich einen Termin suchst und was dir wichtig ist - nächste Praxis oder schnellster Termin. Wir schlagen dir den passenden Standort vor.' } },
      { '@type': 'Question', name: 'Kann ich einfach den nächsten freien Termin anfragen?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Wähle im Formular «Schnellster Termin» oder nutze den Shortcut «Nächsten Termin finden» - wir suchen den frühesten freien Termin an unseren Zürcher Standorten.' } },
      { '@type': 'Question', name: 'Kann ich aus jedem Zürcher Quartier anfragen?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Unsere Praxen an der Bahnhofstrasse, in Oerlikon und in Höngg verteilen sich über die Stadt. Sag uns dein Quartier, wir schlagen dir die passende Praxis vor.' } },
      { '@type': 'Question', name: 'Werden die Kosten von der Zusatzversicherung übernommen?', acceptedAnswer: { '@type': 'Answer', text: 'Akupunktur und TCM laufen über die Zusatzversicherung, nicht über die Grundversicherung. Unsere Therapeut:innen sind EMR- und ASCA-anerkannt; je nach Kasse und Modell werden häufig 80 bis 100 Prozent übernommen. Wir prüfen deine Deckung kostenlos vor dem ersten Termin.' } },
      { '@type': 'Question', name: 'Was passiert, wenn am nächsten Standort nichts frei ist?', acceptedAnswer: { '@type': 'Answer', text: 'Dann bieten wir dir den nächsten freien Termin an einem anderen Zürcher Standort an. Du entscheidest, ob du lieber wartest oder ausweichst.' } },
    ],
  },
];
---
<SpaPage title={title} description={description} path="/akupunktur-tcm-zuerich" body={body.slice(0, endCtaAt)} bodyAfter={body.slice(endCtaAt)} schema={schema}>
  <!-- Mobile Sticky-CTA (bestehende Komponente; erscheint erst nach dem Hero) -->
  <StickyCta prefill="Hallo, ich suche eine TCM-Praxis in Zürich." formTarget="#zh-funnel" heroSelector=".lsr-hero" />
  <BrandSignature
    slot="body-insert"
    imageSrc="/images/tcm-ch-crew-zuerich-west-1254.webp"
    imageSrcset="/images/tcm-ch-crew-zuerich-west-640.webp 640w, /images/tcm-ch-crew-zuerich-west-960.webp 960w, /images/tcm-ch-crew-zuerich-west-1254.webp 1254w"
    imageSizes="(max-width: 760px) 150vw, (max-width: 1043px) 720px, 69vw"
    imageWidth={1536}
    imageHeight={1024}
    imagePosition="35% center"
    imagePositionMobile="44% center"
    imageAlt="Drei Personen in grünen TCM.ch CREW Jacken vor moderner Glas- und Betonarchitektur in Zürich West."
  />
</SpaPage>
