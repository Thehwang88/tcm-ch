---
// /wissen — faithful 1:1 reproduction of the live SPA #page-wissen hub (magazine landing:
// hero, "Worüber wir schreiben" category pillars, "Lesenswertes aus der Praxis" article
// cards with images/categories). Article bodies live on /wissen/[slug] (not embedded here).
import SpaPage from '../../layouts/SpaPage.astro';
import body from '../../data/wissen-body.html?raw';

const title = 'Wissen & Magazin – TCM ehrlich eingeordnet | TCM.ch';
const description =
  'Fundiertes, ehrlich eingeordnetes Wissen zu TCM und Akupunktur – evidenzbasiert, von unseren Therapeut:innen geschrieben und medizinisch geprüft.';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/wissen', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/wissen" body={body} schema={schema} />
