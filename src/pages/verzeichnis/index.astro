---
// /verzeichnis/ — Fachpersonen & Organisationen (Gerüst, noindex). Nur Opt-in, nie gescrapt.
// Profile: noindex by default (taxonomy.profileRobots); Filter-URLs immer noindex,follow.
import LayoutDe from '../../layouts/LayoutDe.astro';
import ProHub from '../../components/pro/ProHub.astro';
import '../../styles/b2b.css';
const cats = [
  { id: 'therapeuten', label: 'Fachpersonen', text: 'TCM-Therapeut:innen und Akupunkteur:innen, die sich selbst eintragen. Angaben der Fachperson; «Profil bestätigt» heisst Identität geprüft, keine klinische Bewertung.', submit: 'profil' },
  { id: 'kliniken', label: 'Kliniken & Praxen', text: 'Praxen, die einstellen, Räume anbieten oder eine Nachfolge suchen – nur mit Einwilligung.', submit: 'profil' },
  { id: 'mentoren', label: 'Mentor:innen', text: 'Neutrales Verzeichnis für M7-, klinisches und Business-Mentoring. M7-Akkreditierung nur mit Nachweis.', submit: 'mentor' },
  { id: 'schulen', label: 'Schulen', text: 'Ausbildungsanbieter mit belegten Anerkennungswegen. Keine Rankings.', submit: 'profil' },
];
---
<LayoutDe title="TCM Fachpersonen & Organisationen Schweiz (im Aufbau) | TCM.ch" description="Professionelles Verzeichnis auf TCM.ch: Fachpersonen, Kliniken, Mentor:innen und Schulen der Schweizer TCM – nur Opt-in, ohne Rankings. Im Aufbau." path="/verzeichnis" noindex={true} robots="noindex, follow">
  <ProHub id="verzeichnis" h1="TCM-Fachpersonen & Organisationen in der Schweiz." lead="Ein professionelles Verzeichnis auf TCM.ch – für Vernetzung, nicht für Rankings. Nur wer sich selbst einträgt und zustimmt, erscheint. Unabhängige Fachpersonen werden klar von TCM.ch-Team und -Partnern unterschieden."
    cats={cats}
    rules={['Opt-in: keine gescrapten oder ungefragten Profile.', 'Keine «beste Therapeut:in»-Listen, keine Bewertungen, Sortierung ohne Qualitätsanspruch.', 'Jedes Profil zeigt «Zuletzt aktualisiert» und woher die Angaben stammen.', 'Kontaktdaten nur mit ausdrücklicher Freigabe öffentlich.', 'Filterkombinationen (Kanton, Sprache, Methode) werden nicht als eigene Seiten indexiert.']}
    routes={[{ label: 'TCM.ch Mentoring', href: '/akademie/', note: 'das eigene Angebot von TCM.ch (kein neutraler Verzeichniseintrag).' }, { label: 'Therapeut:in als Patient:in finden', href: '/standorte/', note: 'Behandlung bei TCM.ch.' }]} />
</LayoutDe>
