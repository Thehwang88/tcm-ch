---
// Körpersignale-Leaf: Symptom-Discovery-Seite vor der Diagnose.
// Rendering bewusst identisch zum Wissen-Artikel-Layout (LayoutDe + kb-body-Stile),
// damit die Rubrik visuell nahtlos zur bestehenden Site gehört.
import LayoutDe from '../../layouts/LayoutDe.astro';
import FaqBlock from '../../components/library/FaqBlock.astro';
import AuthorCard from '../../components/library/AuthorCard.astro';
import TerminForm from '../../components/TerminForm.astro';
import StickyCta from '../../components/StickyCta.astro';
import { site } from '../../data/site';
import { koerpersignale } from '../../data/koerpersignale';
import { regionsForSignal } from '../../data/gesundheitsbibliothek';

export function getStaticPaths() {
  return koerpersignale.map((k) => ({ params: { slug: k.slug }, props: { k } }));
}

const { k: data } = Astro.props;
const path = `/koerpersignale/${data.slug}`;
const url = new URL(path, site.url).href;
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich habe eine Frage zu einem Symptom, das ich bei mir beobachte.')}`;

const MONTHS = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const fmtMonthYear = (iso: string) => { const d = iso.split('-'); return d.length >= 2 ? `${MONTHS[parseInt(d[1], 10) - 1]} ${d[0]}` : iso; };

// JSON-LD nach dem bestehenden Wissen-Muster: MedicalWebPage + BreadcrumbList + FAQPage.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#article`,
  name: data.title,
  headline: data.title,
  description: data.metaDesc,
  url,
  inLanguage: 'de-CH',
  datePublished: data.datePublished,
  dateModified: data.dateModified,
  author: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
  publisher: {
    '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/',
    logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
  },
};
const faqLd = data.faqs.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${url}#faq`,
  mainEntity: data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Körpersignale', item: 'https://tcm.ch/koerpersignale/' },
    { '@type': 'ListItem', position: 3, name: data.h1, item: url },
  ],
};
const schema = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];

const anliegen = `Ich habe folgendes Anliegen: ${data.symptom ?? data.title}. Ich möchte gerne einen Termin anfragen.`;

// Gesundheitsbibliothek: passende Körperregion-Hubs (datengetrieben, kein Hardcoding pro Seite).
const libRegions = regionsForSignal(data.slug);
---
<LayoutDe title={`${data.title} | TCM.ch`} description={data.metaDesc} path={path} schema={schema} turnstile={true}>
  <article>
    <section class="hero">
      <div class="wrap narrow">
        <a class="back" href="/koerpersignale/">← Körpersignale</a>
        <div class="cat">{data.category}</div>
        <h1>{data.h1}</h1>
        <p class="lead">{data.lead}</p>
        <div class="meta-row">
          <span class="m-author">{data.author.name}</span>
          <span class="dot"></span><span>{data.readingTime} Lesezeit</span>
          <span class="dot"></span><span>Aktualisiert {fmtMonthYear(data.dateModified)}</span>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap narrow">
        <div class="kb-body" set:html={data.bodyHtml} />

        <div class="cta-card">
          <div class="cta-card-title">{data.ctaTitle ?? 'Beschwerden einordnen lassen?'}</div>
          <p>{data.ctaText ?? 'Schildere uns kurz, was du beobachtest. Wir sagen dir ehrlich, ob eine TCM-Behandlung bei dir sinnvoll ist oder zuerst eine ärztliche Abklärung gehört.'}</p>
          <div class="cta-row">
            <a class="btn btn--primary" href={data.ctaHref ?? '#formular'}>{data.ctaLabel ?? 'Termin anfragen'}</a>
            <a class="btn btn--ghost" href={waHref} target="_blank" rel="noopener" onclick="window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'whatsapp_click',quelle:'koerpersignal_content_cta'});if(typeof window.gtag==='function'){window.gtag('event','whatsapp_click',{quelle:'koerpersignal_content_cta'})}">Per WhatsApp fragen</a>
          </div>
        </div>

        <AuthorCard
          label="Erstellt von"
          avatar="TCM"
          avatarSm={true}
          author={data.author}
          review={`Allgemeine Einordnung, keine ärztliche Diagnose · zuletzt aktualisiert ${fmtMonthYear(data.dateModified)}`}
        />

        <FaqBlock faqs={data.faqs} />

        {data.sources && data.sources.length > 0 && (
          <div class="ks-sources">
            <div class="ks-sources-label">Quellen</div>
            <ul>
              {data.sources.map((q) => (
                <li>{q.url ? <a href={q.url} target="_blank" rel="noopener">{q.label}</a> : q.label}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="related">
          <div class="rel-label">Weiterlesen</div>
          <div class="rel-grid">
            {data.related.map((r) => (
              <a class="rel-card" href={r.href}>
                <div class="rel-cat">{r.cat}</div>
                <div class="rel-title">{r.label}</div>
              </a>
            ))}
          </div>
        </div>

        {libRegions.length > 0 && (
          <div class="lib-row">
            <span class="lib-row-label">Körperregion:</span>
            {libRegions.map((r) => (
              <a href={`/gesundheitsbibliothek/koerper/${r.slug}/`}>{r.nav}</a>
            ))}
            <span class="lib-row-sep" aria-hidden="true">·</span>
            <a href="/gesundheitsbibliothek/">Zur Gesundheitsbibliothek</a>
          </div>
        )}
      </div>
    </section>

    <TerminForm heading="Abklären lassen?" intro="Beschreib kurz, was du spürst – wir sagen dir ehrlich, ob TCM hier sinnvoll ist." prefill={anliegen} />
    <StickyCta prefill={anliegen} />
  </article>
</LayoutDe>

<style>
  .wrap.narrow { max-width: 760px; }
  .back { display: inline-block; font-size: 13.5px; font-weight: 600; color: var(--blue); text-decoration: none; margin-bottom: 16px; }
  .cat { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); margin-bottom: 10px; }
  h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.12; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 16px; }
  .hero .lead { font-size: 19px; line-height: 1.5; color: var(--mid); }
  .meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 20px; font-size: 13px; color: var(--muted); }
  .m-author { font-weight: 700; color: var(--ink); }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: #c0c5cc; }

  .kb-body :global(h2) { font-size: 25px; font-weight: 800; color: var(--ink); margin: 38px 0 14px; letter-spacing: var(--tracking-heading); }
  .kb-body :global(h3) { font-size: 19px; font-weight: 700; color: var(--ink); margin: 26px 0 10px; }
  .kb-body :global(p) { font-size: 17.5px; line-height: 1.65; color: var(--mid); margin: 0 0 18px; }
  .kb-body :global(ul), .kb-body :global(ol) { font-size: 17.5px; line-height: 1.6; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .kb-body :global(li) { margin: 0 0 10px; }
  .kb-body :global(strong) { color: var(--ink); }
  .kb-body :global(a) { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kb-body :global(a:hover) { text-decoration: underline; }
  .kb-body :global(.wa-callout) { background: var(--blue-light); border-left: 3px solid var(--blue); border-radius: 0 var(--r-btn) var(--r-btn) 0; padding: 18px 20px; margin: 24px 0; }
  .kb-body :global(.wa-callout-label) { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 6px; }
  .kb-body :global(.wa-callout p) { margin: 0; font-size: 16px; }

  .cta-card { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 24px; margin: 40px 0; }
  .cta-card-title { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 6px; }
  .cta-card p { font-size: 15.5px; color: var(--mid); margin: 0 0 16px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }



  .ks-sources { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--border); }
  .ks-sources-label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .ks-sources ul { margin: 0; padding-left: 18px; font-size: 13.5px; line-height: 1.7; color: var(--muted); }
  .ks-sources a { color: var(--muted); text-decoration: underline; }
  .ks-sources a:hover { color: var(--blue); }
  .related { border-top: 1px solid var(--border); margin-top: 44px; padding-top: 24px; }
  .rel-label { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .rel-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .rel-card { border: 1px solid var(--border); border-radius: var(--r-card); padding: 16px; text-decoration: none; transition: border-color var(--t-fast) ease; }
  .rel-card:hover { border-color: var(--blue); }
  .rel-cat { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--blue); margin-bottom: 6px; }
  .rel-title { font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.3; }

  .lib-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin-top: 22px; font-size: 13.5px; }
  .lib-row-label { font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; font-size: 11.5px; }
  .lib-row a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .lib-row a:hover { text-decoration: underline; }
  .lib-row-sep { color: var(--muted); }

  @media (max-width: 640px) {
    .rel-grid { grid-template-columns: 1fr; }
  }
</style>
