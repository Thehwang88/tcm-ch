---
// Visual Library Index — internes Patienten-Kommunikationstool, kein SEO-Silo.
// noindex,follow: öffentlich & teilbar, aber bewusst keine SEO-Landingpage
// (Beschwerden/Behandlungen bleiben die Ranking-Seiten). Nicht in index-queue.md.
import LayoutDe from '../../layouts/LayoutDe.astro';
import VisualCard from '../../components/visuals/VisualCard.astro';
import { visuals, visualCategories } from '../../data/visuals';
---
<LayoutDe
  title="Medizin einfach erklärt | Visual Library"
  description="Einfache medizinische Illustrationen für das Gespräch in der Praxis."
  path="/visuals/"
  noindex={true}
  robots="noindex, follow"
>
  <section class="vl">
    <header class="vl-head">
      <p class="vl-overline">Visual Library</p>
      <h1>Medizin einfach erklärt</h1>
      <div class="vl-search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input
          type="search"
          id="vl-search"
          placeholder="Was möchten Sie zeigen?"
          aria-label="Visuals durchsuchen"
          autocomplete="off"
        />
      </div>
      <div class="vl-cats" role="group" aria-label="Nach Körperregion filtern">
        <button type="button" class="vl-cat" data-cat="" aria-pressed="true">Alle</button>
        {visualCategories.map((c) => (
          <button type="button" class="vl-cat" data-cat={c} aria-pressed="false">{c}</button>
        ))}
      </div>
    </header>

    <div class="vl-grid" id="vl-grid">
      {visuals.map((v) => <VisualCard visual={v} />)}
    </div>
    <div class="vl-empty" id="vl-empty" hidden>
      <p>Keine Treffer. Versuchen Sie z.&nbsp;B. «Knie», «Bandscheibe» oder «Schulter».</p>
      <p class="vl-notfound-q">Nicht gefunden?</p>
      <button type="button" class="vl-request-btn" data-request-open>Visual anfragen</button>
    </div>

    <div class="vl-notfound" id="vl-notfound">
      <span class="vl-notfound-q">Nicht gefunden?</span>
      <button type="button" class="vl-request-btn vl-request-btn--ghost" data-request-open>Visual anfragen</button>
    </div>

    <p class="vl-disclaimer">
      Diese Darstellungen dienen der einfachen Erklärung und ersetzen keine individuelle medizinische Beurteilung.
    </p>

    <dialog class="vl-dialog" id="vl-request-dialog" aria-label="Visual anfragen">
      <button type="button" class="vl-dialog-close" id="vl-request-close" aria-label="Schliessen">&times;</button>
      <h3>Visual anfragen</h3>
      <form id="vl-request-form" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="vl-hp" />
        <label for="vl-req-topic">Visual / Thema</label>
        <input type="text" id="vl-req-topic" name="topic" required maxlength="200" autocomplete="off" />
        <label for="vl-req-note">Was möchtest du dem Patienten erklären? <span>(optional)</span></label>
        <textarea id="vl-req-note" name="note" rows="3" maxlength="1000"></textarea>
        <button type="submit" class="vl-request-submit" id="vl-request-submit">Anfrage senden</button>
        <p class="vl-request-msg" id="vl-request-msg" aria-live="polite"></p>
      </form>
    </dialog>
  </section>

  <script>
    import { track } from '../../scripts/vl-track';

    const input = document.getElementById('vl-search') as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#vl-grid [data-search]'));
    const empty = document.getElementById('vl-empty')!;
    const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.vl-cat'));
    let cat = '';

    const fold = (s: string) =>
      s.toLowerCase().replace(/ä/g, 'a').replace(/ö/g, 'o').replace(/ü/g, 'u').replace(/ß/g, 'ss');

    function filter() {
      const terms = fold(input.value.trim()).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const hay = card.dataset.search || '';
        const okCat = !cat || card.dataset.category === cat;
        const okTerms = terms.every((t) => hay.includes(t));
        const show = okCat && okTerms;
        card.hidden = !show;
        if (show) shown++;
      }
      empty.hidden = shown > 0;
    }

    input.addEventListener('input', filter);
    catBtns.forEach((b) =>
      b.addEventListener('click', () => {
        cat = cat === b.dataset.cat ? '' : b.dataset.cat || '';
        catBtns.forEach((x) => x.setAttribute('aria-pressed', String((x.dataset.cat || '') === cat)));
        filter();
      })
    );

    // ── Visual anfragen ─────────────────────────────────────
    const reqDlg = document.getElementById('vl-request-dialog') as HTMLDialogElement;
    const reqForm = document.getElementById('vl-request-form') as HTMLFormElement;
    const reqTopic = document.getElementById('vl-req-topic') as HTMLInputElement;
    const reqMsg = document.getElementById('vl-request-msg')!;
    const reqSubmit = document.getElementById('vl-request-submit') as HTMLButtonElement;

    document.querySelectorAll('[data-request-open]').forEach((b) =>
      b.addEventListener('click', () => {
        // Suchbegriff vorbefüllen — Ziel-UX: suchen → nicht gefunden → in ~10s angefragt.
        if (!reqTopic.value.trim()) reqTopic.value = input.value.trim();
        reqMsg.textContent = '';
        reqSubmit.disabled = false;
        track('visual_request_open', { category: cat });
        reqDlg.showModal();
        reqTopic.focus();
      })
    );
    document.getElementById('vl-request-close')?.addEventListener('click', () => reqDlg.close());
    reqDlg.addEventListener('click', (e) => { if (e.target === reqDlg) reqDlg.close(); });

    reqForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const topic = reqTopic.value.trim();
      if (topic.length < 2) {
        reqMsg.textContent = 'Bitte ein Thema angeben.';
        reqTopic.focus();
        return;
      }
      reqSubmit.disabled = true;
      reqMsg.textContent = 'Wird gesendet …';
      try {
        const res = await fetch('/api/visual-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            topic,
            note: (reqForm.elements.namedItem('note') as HTMLTextAreaElement).value.trim(),
            query: input.value.trim(),
            category: cat,
            page: location.href,
            website: (reqForm.elements.namedItem('website') as HTMLInputElement).value,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        track('visual_request_submit', { category: cat }); // bewusst OHNE Freitext
        reqMsg.textContent = 'Danke. Die Visual-Anfrage wurde gesendet.';
        reqForm.reset();
        setTimeout(() => reqDlg.close(), 1600);
      } catch {
        reqSubmit.disabled = false;
        reqMsg.textContent = 'Die Anfrage konnte nicht gesendet werden. Bitte erneut versuchen.';
      }
    });
  </script>

  <style>
    .vl {
      max-width: var(--max);
      margin: 0 auto;
      padding: 56px var(--pad-x) 72px;
    }
    .vl-head { max-width: 720px; margin: 0 auto 44px; text-align: center; }
    .vl-overline {
      margin: 0 0 6px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--blue);
    }
    .vl-head h1 {
      margin: 0 0 8px;
      font-size: var(--fs-h1);
      font-weight: 800;
      letter-spacing: var(--tracking-heading);
      line-height: var(--lh-heading);
      color: var(--black);
    }
    .vl-sub {
      margin: 0 0 28px;
      font-size: clamp(17px, 1.8vw, 21px);
      color: var(--text-soft);
    }
    .vl-search {
      position: relative;
      max-width: 520px;
      margin: 0 auto 22px;
      color: var(--muted);
    }
    .vl-search svg {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }
    .vl-search input {
      width: 100%;
      box-sizing: border-box;
      font-family: var(--font-sans);
      font-size: 17px;
      color: var(--text);
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: var(--r-pill);
      padding: 16px 22px 16px 50px;
      box-shadow: var(--sh-sm);
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .vl-search input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(45,155,111,.15);
    }
    .vl-cats { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .vl-cat {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: var(--r-pill);
      padding: 10px 18px;
      font-family: var(--font-sans);
      font-size: 14.5px;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      min-height: 42px;
      transition: border-color .15s ease, background .15s ease, color .15s ease;
    }
    .vl-cat:hover { border-color: var(--blue); color: var(--blue-dark); }
    .vl-cat[aria-pressed="true"] {
      background: var(--blue);
      border-color: var(--blue);
      color: var(--white);
    }
    .vl-cat:focus-visible { outline: 2px solid var(--blue-dark); outline-offset: 2px; }

    .vl-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
    }
    .vl-empty {
      text-align: center;
      color: var(--text-soft);
      font-size: 16px;
      padding: 48px 0 8px;
      margin: 0;
    }
    .vl-empty p { margin: 0 0 8px; }
    .vl-notfound-q {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: var(--tracking-heading);
      color: var(--black);
    }
    .vl-empty .vl-notfound-q { margin: 24px 0 14px; }
    .vl-request-btn {
      background: var(--blue);
      border: 1.5px solid var(--blue);
      color: var(--white);
      border-radius: var(--r-btn);
      padding: 13px 24px;
      font-family: var(--font-sans);
      font-size: 15.5px;
      font-weight: 700;
      cursor: pointer;
      min-height: 48px;
      box-shadow: var(--sh-btn);
      transition: background .15s ease;
    }
    .vl-request-btn:hover { background: var(--blue-dark); }
    .vl-request-btn:focus-visible { outline: 2px solid var(--blue-dark); outline-offset: 2px; }
    .vl-request-btn--ghost {
      background: var(--white);
      color: var(--text);
      border-color: var(--border);
      box-shadow: none;
    }
    .vl-request-btn--ghost:hover { background: var(--white); border-color: var(--blue); color: var(--blue-dark); }
    .vl-notfound {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-top: 40px;
    }

    .vl-dialog {
      border: 0;
      border-radius: var(--r-hero);
      box-shadow: var(--sh-lg);
      padding: 32px 36px 28px;
      width: min(440px, calc(100vw - 40px));
      text-align: left;
    }
    .vl-dialog::backdrop { background: rgba(13,13,13,.45); }
    .vl-dialog h3 {
      margin: 0 0 18px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: var(--tracking-heading);
      color: var(--black);
    }
    .vl-dialog-close {
      position: absolute;
      top: 10px;
      right: 14px;
      border: 0;
      background: transparent;
      font-size: 26px;
      line-height: 1;
      color: var(--muted);
      cursor: pointer;
      padding: 8px;
    }
    .vl-dialog-close:hover { color: var(--black); }
    .vl-dialog label {
      display: block;
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
      margin: 14px 0 6px;
    }
    .vl-dialog label span { font-weight: 500; color: var(--muted); }
    .vl-dialog input[type="text"],
    .vl-dialog textarea {
      width: 100%;
      box-sizing: border-box;
      font-family: var(--font-sans);
      font-size: 15.5px;
      color: var(--text);
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: var(--r-btn);
      padding: 12px 14px;
      resize: vertical;
    }
    .vl-dialog input:focus,
    .vl-dialog textarea:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(45,155,111,.15);
    }
    .vl-hp { position: absolute; left: -9999px; height: 0; opacity: 0; }
    .vl-request-submit {
      margin-top: 18px;
      width: 100%;
      background: var(--blue);
      border: 0;
      color: var(--white);
      border-radius: var(--r-btn);
      padding: 14px;
      font-family: var(--font-sans);
      font-size: 15.5px;
      font-weight: 700;
      cursor: pointer;
      min-height: 48px;
      transition: background .15s ease;
    }
    .vl-request-submit:hover { background: var(--blue-dark); }
    .vl-request-submit:disabled { opacity: .6; cursor: default; }
    .vl-request-msg { margin: 12px 0 0; font-size: 14px; color: var(--text-soft); min-height: 1.2em; }
    .vl-request-msg:empty { display: none; }
    .vl-disclaimer {
      margin: 48px auto 0;
      max-width: 640px;
      text-align: center;
      font-size: 13px;
      color: var(--muted);
    }
    @media (max-width: 640px) {
      .vl { padding: 32px 20px 56px; }
      .vl-head { margin-bottom: 32px; }
      .vl-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
    }
  </style>
</LayoutDe>
