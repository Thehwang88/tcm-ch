---
// /visuals/[slug]/handout/ — druckbare A4-Hochformat-Version jedes Live-Visuals
// ("Als PDF herunterladen" im Viewer). Bewusst OHNE Site-Chrome/Interaktion:
// ein professionelles Patienten-Handout. ?print=1 öffnet direkt den Druckdialog
// (Browser "Als PDF sichern"). noindex,nofollow — reines Werkzeug.
import QRCode from 'qrcode';
import VisualImg from '../../../components/visuals/VisualImg.astro';
import { liveVisuals } from '../../../data/visuals';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return liveVisuals.map((v) => ({ params: { slug: v.slug }, props: { visual: v } }));
}

const { visual: v } = Astro.props;
const url = new URL(`/visuals/${v.slug}/`, site.url).href;
const qrSvg = await QRCode.toString(url, { type: 'svg', margin: 0, color: { dark: '#0d0d0d', light: '#0000' } });
const markers = (v.hotspots ?? []).filter((h) => h.view !== 'pain');
// Sehr hohe Vergleichsbilder (z.B. HWS 604×1283) auf max ~118mm Höhe kappen,
// damit das Handout einseitig bleibt. Breitere Formate (LWS 0.8) bleiben
// unverändert bei voller Spaltenbreite. Wrap wird mitverkleinert, damit die
// %-Hotspots weiter exakt auf dem Bild sitzen.
function capStyle(img: typeof v.imageNormal): string | undefined {
  if (!img || typeof img === 'string') return undefined;
  const mm = Math.min(85, Math.round(118 * (img.width / img.height)));
  return mm < 85 ? `max-width:${mm}mm;margin:0 auto` : undefined;
}
const panels = [
  { key: 'normal', chip: v.labelNormal ?? 'Normal', img: v.imageNormal, alt: `${v.title}: vereinfachte Darstellung, normaler Zustand` },
  { key: 'problem', chip: v.labelProblem ?? v.title, img: v.imageProblem, alt: `${v.title}: vereinfachte Darstellung der Veränderung` },
];
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{v.title} — Patienten-Handout | TCM.ch</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Bildschirm-Werkzeugleiste — erscheint nicht im Druck -->
    <div class="toolbar" data-noprint>
      <a href={`/visuals/${v.slug}/`}>&larr; Zurück zum Visual</a>
      <button type="button" id="print-btn">Drucken / Als PDF sichern</button>
    </div>

    <main class="sheet">
      <header class="ho-head">
        <div class="ho-brand">
          <span class="ho-logo">TCM<span class="ho-logo-dot">.ch</span></span>
          <span class="ho-brand-sub">Medizin einfach erklärt</span>
        </div>
        <div class="ho-titles">
          <h1>{v.title}</h1>
          <p>{v.subtitle}</p>
        </div>
      </header>

      <section class="ho-compare">
        {panels.map((p) => (
          <figure class="ho-panel">
            <figcaption class:list={['ho-chip', { 'ho-chip--problem': p.key === 'problem' }]}>{p.chip}</figcaption>
            <div class="ho-imgwrap" style={capStyle(p.img)}>
              {p.img && <VisualImg image={p.img} alt={p.alt} width={800} height={1000} sizes="90mm" />}
              {markers
                .filter((h) => h.view === 'both' || h.view === p.key)
                .map((h) => (
                  <span
                    class:list={['ho-marker', { 'ho-marker--left': h.labelSide === 'left' }]}
                    style={`left:${h.x}%;top:${h.y}%;`}
                  >
                    <span class="ho-marker-dot"></span>
                    <span class="ho-marker-label">{h.label}</span>
                  </span>
                ))}
            </div>
          </figure>
        ))}
      </section>

      <section class="ho-bottom">
        {v.secondaryImage && (
          <div class="ho-pain">
            <h2>{v.secondaryHeading ?? 'Wo kann man es spüren?'}</h2>
            <div class="ho-pain-row">
              <div class="ho-imgwrap ho-pain-imgwrap">
                <VisualImg image={v.secondaryImage} alt={`${v.title}: vereinfachter Schmerzverlauf`} width={600} height={1000} sizes="45mm" />
                {(v.painPath ?? []).map((s, i) => (
                  <span class="ho-painstep" style={`left:${s.x}%;top:${s.y}%;`}>
                    <span class="ho-painstep-dot">{i + 1}</span>
                  </span>
                ))}
              </div>
              <ol class="ho-pain-list">
                {(v.painPath ?? []).map((s) => <li>{s.label}</li>)}
              </ol>
            </div>
          </div>
        )}
        <aside class="ho-qr">
          <div class="ho-qr-svg" set:html={qrSvg} />
          <p>Interaktive Ansicht<br />auf dem Handy öffnen</p>
        </aside>
      </section>

      <footer class="ho-foot">
        <p>Diese Darstellung dient der einfachen Erklärung und ersetzt keine individuelle medizinische Beurteilung.</p>
        <p class="ho-foot-brand">TCM.ch — {url.replace('https://', '')}</p>
      </footer>
    </main>

    <script>
      document.getElementById('print-btn')?.addEventListener('click', () => window.print());
      if (new URLSearchParams(location.search).get('print') === '1') {
        // Fonts/Bilder erst laden lassen, dann Druckdialog
        window.addEventListener('load', () => setTimeout(() => window.print(), 400));
      }
    </script>

    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--black);
        background: #E9E7E3;
      }

      .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        max-width: 210mm;
        margin: 0 auto;
        padding: 14px 4px;
      }
      .toolbar a {
        font-size: 14px;
        font-weight: 600;
        color: var(--mid);
        text-decoration: none;
      }
      .toolbar a:hover { color: var(--blue-dark); }
      .toolbar button {
        background: var(--blue);
        color: var(--white);
        border: 0;
        border-radius: var(--r-btn);
        padding: 11px 18px;
        font-family: var(--font-sans);
        font-size: 14.5px;
        font-weight: 700;
        cursor: pointer;
      }
      .toolbar button:hover { background: var(--blue-dark); }

      /* A4-Blatt */
      .sheet {
        width: 210mm;
        min-height: 296mm;
        margin: 0 auto 24px;
        background: var(--white);
        padding: 14mm 14mm 10mm;
        box-shadow: 0 8px 40px rgba(0,0,0,.14);
        display: flex;
        flex-direction: column;
      }

      .ho-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10mm;
        border-bottom: 1px solid var(--border);
        padding-bottom: 6mm;
        margin-bottom: 7mm;
      }
      .ho-logo {
        font-family: var(--font-accent);
        font-weight: 900;
        font-style: italic;
        font-size: 22px;
        letter-spacing: -0.02em;
      }
      .ho-logo-dot { color: var(--blue); }
      .ho-brand-sub {
        display: block;
        font-size: 10.5px;
        font-weight: 600;
        color: var(--muted);
        margin-top: 2px;
      }
      .ho-titles { text-align: right; }
      .ho-titles h1 {
        margin: 0 0 4px;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }
      .ho-titles p {
        margin: 0;
        font-size: 14px;
        color: var(--mid);
      }

      .ho-compare {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8mm;
      }
      .ho-panel { margin: 0; }
      .ho-chip {
        display: inline-block;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 3px 12px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--mid);
        margin-bottom: 4mm;
      }
      .ho-chip--problem { color: var(--blue-dark); border-color: var(--green-mid); background: var(--blue-light); }
      .ho-imgwrap { position: relative; }
      .ho-imgwrap :global(img) { display: block; width: 100%; height: auto; }

      .ho-marker {
        position: absolute;
        transform: translate(-13px, -50%);
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 4px;
      }
      .ho-marker--left {
        flex-direction: row-reverse;
        transform: translate(calc(-100% + 13px), -50%);
      }
      .ho-marker-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(45,155,111,.25);
        border: 2px solid var(--blue);
        box-shadow: 0 0 0 2px rgba(255,255,255,.9);
        flex-shrink: 0;
      }
      .ho-marker-label {
        background: rgba(255,255,255,.94);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
      }

      .ho-bottom {
        display: grid;
        grid-template-columns: 1fr 36mm;
        gap: 10mm;
        align-items: end;
        margin-top: 7mm;
      }
      .ho-pain h2 {
        margin: 0 0 4mm;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .ho-pain-row {
        display: grid;
        grid-template-columns: 42mm 1fr;
        gap: 8mm;
        align-items: center;
      }
      .ho-painstep {
        position: absolute;
        transform: translate(-50%, -50%);
      }
      .ho-painstep-dot {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: var(--blue);
        color: var(--white);
        font-size: 9px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 2px rgba(255,255,255,.9);
      }
      .ho-pain-list {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: -0.02em;
        display: flex;
        flex-direction: column;
        gap: 1mm;
      }
      .ho-pain-list li { counter-increment: step; display: flex; align-items: baseline; gap: 6px; }
      .ho-pain-list li::before {
        content: counter(step);
        font-size: 10px;
        font-weight: 800;
        color: var(--white);
        background: var(--blue);
        border-radius: 50%;
        width: 15px;
        height: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transform: translateY(-1px);
      }

      .ho-qr { text-align: center; }
      .ho-qr-svg :global(svg) { width: 26mm; height: 26mm; display: block; margin: 0 auto 3mm; }
      .ho-qr p {
        margin: 0;
        font-size: 9.5px;
        font-weight: 600;
        color: var(--mid);
        line-height: 1.4;
      }

      .ho-foot {
        margin-top: auto;
        padding-top: 5mm;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        gap: 10mm;
      }
      .ho-foot p { margin: 0; font-size: 8.5px; color: var(--muted); }
      .ho-foot-brand { font-weight: 700; white-space: nowrap; }

      @page { size: A4 portrait; margin: 0; }
      @media print {
        body { background: var(--white); }
        [data-noprint] { display: none !important; }
        .sheet {
          width: auto;
          /* Fussnote ans Blattende (297mm − 2×12mm Padding, minus Sicherheitsmarge) */
          min-height: 268mm;
          margin: 0;
          box-shadow: none;
          padding: 12mm 14mm;
        }
        .ho-marker-label { border-color: #ddd; }
      }
      /* Bildschirm klein: Blatt skaliert */
      @media screen and (max-width: 860px) {
        .sheet { width: 100%; min-height: 0; padding: 8mm; }
        .toolbar { padding: 12px 16px; }
      }
    </style>
  </body>
</html>
