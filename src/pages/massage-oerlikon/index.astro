---
// /massage-oerlikon - City-Landingpage für "massage oerlikon", nach dem Muster von
// /massage-winterthur/. Standort Ohmstrasse 14 ist seit 02.11.2026 eröffnet (Inhaberbestätigung); keine Öffnungszeiten
// nennen, solange sie nicht bestätigt sind.
import SpaPage from '../../layouts/SpaPage.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../components/MassageAnfrageForm.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import bodyRaw from '../../data/massage-oerlikon-body.html?raw';
import css from '../../data/massage-city.css?raw';

const [heroPart, restPart] = bodyRaw.split('<!--BANNER-->');

const url = 'https://tcm.ch/massage-oerlikon/';
const title = 'Massage Oerlikon – medizinisch & entspannend | TCM.ch';
const description = 'Massage Oerlikon: medizinisch oder zur Entspannung, wenige Gehminuten vom Bahnhof Oerlikon. EMR-/ASCA-anerkannt, über die Zusatzversicherung abrechenbar.';

const faqs = [
  { q: 'Wie bekomme ich in Oerlikon einen Termin?', a: 'Schick uns deine Anfrage über das Formular oder per WhatsApp. Wir melden uns persönlich mit einem Terminvorschlag an der Ohmstrasse 14; auf Wunsch auch an der Bahnhofstrasse oder in Höngg.' },
  { q: 'Übernimmt die Krankenkasse die Massage in Oerlikon?', a: 'Medizinische Massagen bei unseren EMR- und ASCA-anerkannten Therapeut:innen trägt die Zusatzversicherung in der Regel mit, meist zu 50 bis 90 Prozent. Die Grundversicherung zahlt keine Massagen, Wellness-Massagen sind Selbstzahlerleistungen.' },
  { q: 'Brauche ich eine ärztliche Verordnung?', a: 'Nein. Für die Abrechnung über die Zusatzversicherung genügt die Behandlung bei einer anerkannten Fachperson. Du kannst direkt einen Termin anfragen, ohne vorher zum Arzt zu gehen.' },
  { q: 'Wie erreiche ich die Praxis in Oerlikon?', a: 'Die Ohmstrasse 14 liegt wenige Gehminuten vom Bahnhof Oerlikon, einem der grössten ÖV-Knoten der Schweiz. Ob mit der S-Bahn aus der Stadt, dem Glattal oder von Winterthur: Du bist in wenigen Minuten bei uns, auch aus Neu-Oerlikon und dem Glattpark.' },
  { q: 'Welche Massage passt zu meinem Anliegen?', a: 'Das klären wir vor der ersten Behandlung in einem kurzen Gespräch. Bei konkreten Beschwerden wie Rücken- oder Nackenschmerzen ist die medizinische Massage der übliche Einstieg, für Erholung und Stressabbau eher eine entspannende Technik oder Tuina.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'MedicalBusiness', name: 'TCM Oerlikon – TCM.ch', url: 'https://tcm.ch/standorte/zuerich-oerlikon/',
    address: { '@type': 'PostalAddress', streetAddress: 'Ohmstrasse 14', postalCode: '8050', addressLocality: 'Zürich', addressCountry: 'CH' },
    geo: { '@type': 'GeoCoordinates', latitude: 47.4112, longitude: 8.5459 },
    telephone: '+41775236122', openingHours: ['Mo-Fr 07:30-19:30', 'Sa 07:30-16:30'], areaServed: { '@type': 'City', name: 'Zürich' },
    memberOf: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    medicalSpecialty: 'PhysicalTherapy' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 3, name: 'Massage Oerlikon', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/massage-oerlikon" body="" schema={schema}>
  <div class="city-scope">
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Zürich Oerlikon" />
  <Fragment set:html={restPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="massage-oerlikon" />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Massage-Team TCM.ch" />
  <InsuranceBanner variant="sticky" />
  </div>
</SpaPage>
