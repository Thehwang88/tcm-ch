---
// /team/[slug] - kanonische Therapeut:innen-Profilseiten aus src/data/therapeuten.ts.
// Jede Section rendert NUR, wenn Daten vorhanden sind. `geplant` wird nie gerendert,
// `beantragt` sichtbar als «Antrag läuft». Keine E-Mails, keine internen Hinweise.
import LayoutDe from '../../layouts/LayoutDe.astro';
import { therapeuten, bookingHref, visible, activeRegs, initials, getPublicTherapistProfile, type PublicTherapeut } from '../../data/therapeuten';
import { clinics } from '../../data/locations';
import { site } from '../../data/site';

export function getStaticPaths() {
  return therapeuten.map((t) => ({ params: { slug: t.slug }, props: { t: getPublicTherapistProfile(t) } }));
}

const { t } = Astro.props as { t: PublicTherapeut };
const path = `/team/${t.slug}/`;
const url = site.url + path;
const booking = bookingHref(t);
const vorname = t.vorname ?? t.name.replace(/^Dr\.\s*\w*\.?\s*/i, '').split(' ')[0];

const locs = (t.standorte ?? []).map((id) => clinics.find((c) => c.id === id)).filter((c) => !!c);
const primaryLoc = locs[0];

const ausbildungDone = visible(t.ausbildung).filter((a) => a.status !== 'in_ausbildung');
const ausbildungLaufend = visible(t.ausbildung).filter((a) => a.status === 'in_ausbildung');
const weiterbildungen = visible(t.weiterbildungen);
const WB_VISIBLE = 8;
const regsTcm = (t.registrierungen ?? []).filter((r) => !r.bereich);
const regsOther = (t.registrierungen ?? []).filter((r) => !!r.bereich);
const heroChips = (t.schwerpunkte ?? t.themenGruppen?.map((g) => g.titel) ?? []).slice(0, 3);
const badges = activeRegs(t).slice(0, 4);
const statusLabel = { anerkannt: 'anerkannt', registriert: 'registriert', beantragt: 'Antrag läuft' } as const;
const facts = [
  t.erfahrung && { k: 'Erfahrung', v: t.erfahrung },
  t.sprachen?.length && { k: 'Sprachen', v: t.sprachen.join(', ') },
  t.methoden?.length && { k: 'Methoden', v: t.methoden.slice(0, 4).join(', ') + (t.methoden.length > 4 ? ' …' : '') },
  activeRegs(t).length && { k: 'Anerkennungen', v: activeRegs(t).map((r) => r.organisation).join(', ') },
].filter(Boolean) as { k: string; v: string }[];
const hasRegister = regsTcm.length > 0 || regsOther.length > 0;

const title = t.seo?.title ?? `${t.name} | ${t.titel} bei TCM.ch`;
const description =
  t.seo?.description ??
  (t.kurzbeschreibung ? `${t.kurzbeschreibung} Termin bei TCM.ch${t.ortLabel ? ` in ${t.ortLabel}` : ''} anfragen.` : `${t.name}, ${t.titel}${t.ortLabel ? ` bei TCM.ch in ${t.ortLabel}` : ' bei TCM.ch'}. Ausbildung, Methoden und Termin.`);

// Schema.org: nur sichtbare, gepflegte Angaben. Keine medicalSpecialty, keine Ratings.
const person: Record<string, unknown> = {
  '@type': 'Person',
  name: t.name,
  jobTitle: t.titel,
  url,
  worksFor: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: site.url + '/' },
};
if (t.bild) person.image = site.url + t.bild;
if (t.registerName && t.registerName !== t.name) person.alternateName = t.registerName;
if (t.sprachen?.length) person.knowsLanguage = t.sprachen;
if (locs.length) person.workLocation = locs.map((c) => ({ '@type': 'Place', name: `TCM.ch ${c!.name}`, url: `${site.url}/standorte/${c!.id}/` }));
const creds = [
  ...ausbildungDone.map((a) => ({ '@type': 'EducationalOccupationalCredential', name: a.titel, credentialCategory: 'degree', ...(a.institution ? { recognizedBy: { '@type': 'Organization', name: a.institution } } : {}) })),
  ...activeRegs(t).map((r) => ({ '@type': 'EducationalOccupationalCredential', name: `${r.organisation}-Registrierung`, credentialCategory: 'certification', recognizedBy: { '@type': 'Organization', name: r.organisation } })),
];
if (creds.length) person.hasCredential = creds;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Über uns', item: site.url + '/ueber-uns/' },
      { '@type': 'ListItem', position: 3, name: t.name, item: url } ] },
  ],
};
const WA = '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>';
const edu = (a: { titel: string; institution?: string; jahr?: string; note?: string }) => [a.institution, a.jahr].filter(Boolean).join(' · ');
---
<LayoutDe title={title} description={description} path={path} schema={schema} ogImage={t.bild ? site.url + t.bild : undefined}>
  <article class="tp">
    <div class="tp-wrap">
      <div class="tp-crumb" role="navigation" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/ueber-uns/">Über uns</a><span aria-hidden="true">/</span><span aria-current="page">{t.name}</span>
      </div>

      <header class="tp-hero">
        <div class="tp-portrait">
          {t.bild
            ? <img src={t.bild} alt={`${t.name}, ${t.titel} bei TCM.ch`} width="630" height="840" loading="eager" fetchpriority="high" />
            : <div class="tp-initials" role="img" aria-label={t.name}><span>{initials(t.name)}</span></div>}
        </div>
        <div class="tp-hero-info">
          <p class="tp-eyebrow">{t.titel}</p>
          <h1 class="tp-name">{t.name}</h1>
          {t.untertitel && <p class="tp-sub">{t.untertitel}</p>}
          {t.ortLabel && (
            <p class="tp-ort"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>{t.ortLabel}</p>
          )}
          {t.kurzbeschreibung && <p class="tp-kurz">{t.kurzbeschreibung}</p>}
          {heroChips.length > 0 && <div class="tp-pills">{heroChips.map((s) => <span class="tp-pill">{s}</span>)}</div>}
          {badges.length > 0 && <div class="tp-pills">{badges.map((r) => <span class="tp-pill tp-pill--badge">{r.organisation}</span>)}</div>}
          <div class="tp-cta-row">
            <a class="tp-cta" href={booking} target="_blank" rel="noopener"><Fragment set:html={WA} />Termin anfragen</a>
            {primaryLoc && <a class="tp-cta tp-cta--sec" href={`/standorte/${primaryLoc.id}/`}>Standort ansehen</a>}
          </div>
          <p class="tp-trust">Kostenübernahme abhängig von Methode und Zusatzversicherung. <a href="/krankenkassen/">Wir prüfen deine Deckung gerne vorab.</a></p>
        </div>
      </header>

      {facts.length > 0 && (
        <section class="tp-facts" aria-label="Auf einen Blick">
          <h2 class="tp-visually">Auf einen Blick</h2>
          <dl>{facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}</dl>
        </section>
      )}

      {t.bio?.length ? (
        <section class="tp-section"><h2>Über {vorname}</h2>{t.bio.map((p) => <p>{p}</p>)}</section>
      ) : null}

      {t.themenGruppen?.length ? (
        <section class="tp-section">
          <h2>{t.schwerpunkteAlsInteressen ? 'Behandlungsschwerpunkte & besondere Interessen' : 'Behandlungsschwerpunkte'}</h2>
          {t.schwerpunkteAlsInteressen && <p class="tp-note">Diese Themen sind Schwerpunkte und besondere Interessen in der TCM-Praxis, keine formelle Fachspezialisierung.</p>}
          <div class="tp-groups">
            {t.themenGruppen.map((g) => (
              <div class="tp-group"><h3>{g.titel}</h3><ul class="tp-tags">{g.items.map((i) => <li>{i}</li>)}</ul>{g.note && <p class="tp-note">{g.note}</p>}</div>
            ))}
          </div>
        </section>
      ) : t.schwerpunkte?.length ? (
        <section class="tp-section">
          <h2>{t.schwerpunkteAlsInteressen ? 'Behandlungsschwerpunkte & besondere Interessen' : 'Behandlungsschwerpunkte'}</h2>
          <ul class="tp-tags">{t.schwerpunkte.map((s) => <li>{s}</li>)}</ul>
        </section>
      ) : null}

      {t.methoden?.length ? (
        <section class="tp-section"><h2>Methoden</h2><ul class="tp-tags">{t.methoden.map((m) => <li>{m}</li>)}</ul></section>
      ) : null}

      {(ausbildungDone.length || ausbildungLaufend.length) ? (
        <section class="tp-section">
          <h2>Ausbildung &amp; Abschlüsse</h2>
          <ul class="tp-edu">
            {ausbildungDone.map((a) => <li><strong>{a.titel}</strong>{edu(a) && <span>{edu(a)}</span>}{a.note && <span>{a.note}</span>}<em class="tp-st tp-st--ok">Abgeschlossen</em></li>)}
            {ausbildungLaufend.map((a) => <li><strong>{a.titel}</strong>{edu(a) && <span>{edu(a)}</span>}{a.note && <span>{a.note}</span>}<em class="tp-st">In Ausbildung</em></li>)}
          </ul>
        </section>
      ) : null}

      {(t.klinischerHintergrund || t.berufserfahrung?.length) ? (
        <section class="tp-section">
          <h2>{t.klinischerHintergrund?.titel ?? 'Beruflicher Hintergrund'}</h2>
          {t.klinischerHintergrund && <ul class="tp-list">{t.klinischerHintergrund.items.map((i) => <li>{i}</li>)}</ul>}
          {t.berufserfahrung?.length ? (
            <ul class="tp-edu">
              {t.berufserfahrung.map((e) => (
                <li>
                  <strong>{[e.rolle, e.organisation].filter(Boolean).join(', ')}</strong>
                  {(e.ort || e.zeitraum) && <span>{[e.ort, e.zeitraum].filter(Boolean).join(' · ')}</span>}
                  {e.beschreibung && <span>{e.beschreibung}</span>}
                  {e.aufgaben?.length ? <ul class="tp-list tp-list--sm">{e.aufgaben.map((a) => <li>{a}</li>)}</ul> : null}
                </li>
              ))}
            </ul>
          ) : null}
        </section>
      ) : null}

      {weiterbildungen.length ? (
        <section class="tp-section">
          <h2>Weiterbildungen</h2>
          <ul class="tp-edu">
            {weiterbildungen.slice(0, WB_VISIBLE).map((w) => <li><strong>{w.titel}</strong>{edu(w) && <span>{edu(w)}</span>}{w.status === 'in_ausbildung' && <em class="tp-st">In Ausbildung</em>}</li>)}
          </ul>
          {weiterbildungen.length > WB_VISIBLE && (
            <details class="tp-more">
              <summary>Alle Weiterbildungen anzeigen ({weiterbildungen.length})</summary>
              <ul class="tp-edu">
                {weiterbildungen.slice(WB_VISIBLE).map((w) => <li><strong>{w.titel}</strong>{edu(w) && <span>{edu(w)}</span>}{w.status === 'in_ausbildung' && <em class="tp-st">In Ausbildung</em>}</li>)}
              </ul>
            </details>
          )}
          {t.weitereQualifikationen?.length ? <p class="tp-note">Weitere Qualifikation: {t.weitereQualifikationen.join(' · ')}</p> : null}
        </section>
      ) : null}

      {hasRegister && (
        <section class="tp-section">
          <h2>Anerkennungen &amp; Krankenkasse</h2>
          <div class="tp-reg">
            {regsTcm.map((r) => (
              <div class={`tp-reg-item${r.status === 'beantragt' ? ' is-pending' : ''}`}>
                {r.organisation === 'EMR' && r.status === 'anerkannt' && r.profileUrl ? (
                  <>
                    <b><span aria-hidden="true">✓ </span>EMR-Qualitätslabel bestätigt</b>
                    <a class="tp-reg-link" href={r.profileUrl} target="_blank" rel="noopener noreferrer">Bei EMR prüfen <span aria-hidden="true">→</span><span class="tp-visually"> (öffnet emr.ch in neuem Tab)</span></a>
                  </>
                ) : (
                  <><b>{r.organisation}</b><span class="tp-reg-st">{statusLabel[r.status]}</span></>
                )}
                {r.note && <span>{r.note}</span>}
              </div>
            ))}
          </div>
          {regsOther.length > 0 && (
            <>
              <h3 class="tp-h3">{regsOther[0].bereich} (separat von TCM)</h3>
              <div class="tp-reg">
                {regsOther.map((r) => <div class="tp-reg-item"><b>{r.organisation}</b>{r.note && <span class="tp-reg-st">{r.note}</span>}</div>)}
              </div>
            </>
          )}
          {t.registerName && t.registerName !== t.name && <p class="tp-note">Name bei Versicherern und Registern: {t.registerName}</p>}
          <p class="tp-note">Ob deine Behandlung von der Zusatzversicherung übernommen wird, hängt von Versicherer, Produkt und anerkannter Methode ab. Bitte prüfe deine persönliche Deckung vor der Behandlung. <a href="/krankenkassen/">Krankenkassen &amp; TCM verstehen →</a></p>
        </section>
      )}

      {t.mitgliedschaften?.length ? (
        <section class="tp-section"><h2>Mitgliedschaften</h2><ul class="tp-list">{t.mitgliedschaften.map((m) => <li>{m}</li>)}</ul></section>
      ) : null}

      {(t.sprachen?.length || t.weitereSprachen) ? (
        <section class="tp-section">
          <h2>Sprachen</h2>
          {t.sprachen?.length ? <p><strong>Therapiesprachen:</strong> {t.sprachen.join(' · ')}</p> : null}
          {t.weitereSprachen && <p><strong>{t.weitereSprachen.label}:</strong> {t.weitereSprachen.items.join(' · ')}</p>}
        </section>
      ) : null}

      {locs.length > 0 && (
        <section class="tp-section">
          <h2>{locs.length > 1 ? 'Standorte' : 'Standort'}</h2>
          <div class="tp-locs">
            {locs.map((c) => (
              <div class="tp-loc-card">
                <div class="tp-loc-body">
                  <p class="tp-loc-name">TCM.ch {c!.name}</p>
                  <p class="tp-loc-addr">{[c!.street, [c!.postalCode, c!.city].filter(Boolean).join(' ')].filter(Boolean).join(', ')}</p>
                </div>
                <div class="tp-loc-actions"><a href={`/standorte/${c!.id}/`}>Standort ansehen</a><a class="tp-loc-book" href={booking} target="_blank" rel="noopener">Termin anfragen</a></div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="tp-final">
        <h2>Termin bei {vorname} anfragen</h2>
        <p>Unkompliziert per WhatsApp. Wir melden uns persönlich.</p>
        <a class="tp-cta" href={booking} target="_blank" rel="noopener">Termin anfragen</a>
      </section>

      <p class="tp-back"><a href="/ueber-uns/#ueber-uns-team">← Alle Therapeut:innen ansehen</a></p>
    </div>

    <div class="tp-sticky"><a class="tp-cta" href={booking} target="_blank" rel="noopener">Termin anfragen</a></div>
  </article>
</LayoutDe>

<style>
  /* Wave 4B · Therapeut:innen-Profile im Brand-System (docs/design-system.md §19).
     Nur Praesentation: Klassen, Markup, Daten (therapeuten.ts), bookingHref, Schema unveraendert. */
  .tp { padding: 48px 0 72px; background: var(--white); color: var(--brand-black); }
  .tp-wrap { max-width: 1080px; margin: 0 auto; padding: 0 40px; }
  .tp-crumb { font-size: 13px; color: rgba(2,11,16,.58); display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .tp-crumb a { color: rgba(2,11,16,.7); font-weight: 600; text-decoration: none; transition: color var(--t-base); }
  .tp-crumb a:hover { color: var(--brand-black); text-decoration: underline; text-decoration-color: var(--brand); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .tp-crumb [aria-current] { color: var(--brand-black); font-weight: 600; }
  /* ── Hero: Portrait-Panel auf Concrete ── */
  .tp-hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; background: var(--brand-surface); border-radius: 28px; padding: 44px; }
  .tp-portrait { border-radius: 24px; overflow: hidden; aspect-ratio: 3/4; background: var(--white); box-shadow: 0 24px 60px rgba(2,11,16,.14); }
  .tp-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .tp-status { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; padding: 6px 12px; border-radius: 100px; margin-bottom: 16px; }
  .tp-status.is-on { background: var(--brand-tint); color: var(--brand-black); }
  .tp-status.is-off { background: var(--white); color: rgba(2,11,16,.62); }
  .tp-status-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .tp-eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--brand-ink); margin: 0 0 12px; }
  .tp-eyebrow::before { content: ""; display: inline-block; width: 16px; height: 2px; border-radius: 2px; background: var(--brand); vertical-align: middle; margin: -2px 10px 0 0; }
  .tp-name { font-family: var(--font-sans); font-weight: 800; font-size: clamp(32px, 4.2vw, 50px); letter-spacing: var(--tracking-heading); line-height: 1.04; color: var(--brand-black); margin: 0 0 10px; -webkit-hyphens: auto; hyphens: auto; }
  .tp-sub { font-size: 16px; line-height: 1.5; color: var(--mid); margin: 0 0 12px; }
  .tp-ort { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 600; color: rgba(2,11,16,.7); margin: 0 0 16px; }
  .tp-ort svg { color: var(--brand-black); flex-shrink: 0; }
  .tp-kurz { font-size: 16.5px; line-height: 1.7; color: var(--mid); margin: 0 0 16px; max-width: 560px; }
  .tp-quote { font-family: 'Nunito', sans-serif; font-style: italic; font-weight: 900; font-size: 17px; line-height: 1.55; color: var(--brand-black); margin: 0 0 18px; }
  .tp-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
  .tp-pill { font-size: 12.5px; font-weight: 600; padding: 6px 13px; border-radius: 100px; background: var(--brand-tint); color: var(--brand-black); }
  .tp-pill--soft { background: var(--white); color: var(--brand-black); border: 1px solid rgba(2,11,16,.12); }
  .tp-pill--badge { background: var(--white); color: rgba(2,11,16,.75); border: 1px solid rgba(2,11,16,.12); }
  .tp-meta { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 6px 0 22px; font-size: 14px; }
  .tp-meta dt { color: rgba(2,11,16,.62); font-weight: 600; }
  .tp-meta dd { margin: 0; color: var(--brand-black); }
  .tp-cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .tp-cta { display: inline-flex; align-items: center; justify-content: center; gap: 9px; background: var(--brand-black); color: #fff; padding: 15px 28px; border-radius: 100px; font-family: var(--font-sans); font-size: 15px; font-weight: 700; text-decoration: none; transition: background var(--t-base), transform var(--t-base), box-shadow var(--t-base); }
  .tp-cta:hover { background: #1f2a30; color: #fff; transform: translateY(-1px); box-shadow: 0 10px 24px rgba(2,11,16,.18); }
  .tp-cta--sec { background: var(--white); color: var(--brand-black); border: 1.5px solid rgba(2,11,16,.22); box-shadow: none; }
  .tp-cta--sec:hover { background: var(--white); border-color: var(--brand-black); color: var(--brand-black); box-shadow: none; }
  .tp-trust { font-size: 13px; line-height: 1.55; color: rgba(2,11,16,.62); margin: 14px 0 0; }
  /* ── Sections ── */
  .tp-section { max-width: 760px; margin-top: 56px; padding-top: 40px; border-top: 1px solid rgba(2,11,16,.1); }
  .tp-section h2 { font-family: var(--font-sans); font-weight: 800; font-size: clamp(24px, 2.4vw, 30px); letter-spacing: var(--tracking-heading); line-height: 1.15; color: var(--brand-black); margin: 0 0 16px; }
  .tp-section p { font-size: 16.5px; line-height: 1.7; color: var(--mid); margin: 0 0 14px; max-width: 640px; }
  .tp-section p strong { color: var(--brand-black); }
  .tp-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 9px; padding: 0; margin: 0; }
  .tp-tags li { font-size: 13.5px; font-weight: 600; color: var(--brand-black); background: var(--white); border: 1px solid rgba(2,11,16,.14); border-radius: 100px; padding: 9px 15px; }
  .tp-edu { list-style: none; padding: 0; margin: 0 0 12px; }
  .tp-edu > li { display: flex; flex-direction: column; gap: 3px; padding: 13px 0; border-bottom: 1px solid rgba(2,11,16,.1); font-size: 14.5px; }
