import { PUBLISHED_WELLE_4_2026_10 } from '../../../data/befunde-werte';

const path = '/gesundheitsbibliothek/untersuchungen/eileiterdurchgaengigkeit';
const url = `https://tcm.ch${path}/`;
const title = 'Eileiter prüfen: HSG und HyCoSy im Vergleich';
const description = 'Sind die Eileiter durchgängig? HSG (Röntgen) und HyCoSy (Ultraschall) sind zwei unterschiedliche Verfahren. Ablauf, Vorbereitung, Risiken und Grenzen.';
const published = PUBLISHED_WELLE_4_2026_10;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage',
    '@id': `${url}#article`,
    name: `${title} | TCM.ch`, headline: 'Eileiterdurchgängigkeit prüfen: Wie unterscheiden sich HSG und HyCoSy?', description, url, inLanguage: 'de-CH',
    ...(published ? { datePublished: published, dateModified: published } : {}),
    author: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    publisher: {
      '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/',
      logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Gesundheitsbibliothek', item: 'https://tcm.ch/gesundheitsbibliothek/' },
      { '@type': 'ListItem', position: 3, name: 'Untersuchungen & Diagnostik', item: 'https://tcm.ch/gesundheitsbibliothek/untersuchungen/' },
      { '@type': 'ListItem', position: 4, name: 'Eileiterdurchgängigkeit', item: url },
    ],
  },
];

const rel1Links = [
  { href: '/beschwerden/kinderwunsch/', label: 'Kinderwunsch' },
  { href: '/beschwerden/endometriose/', label: 'Endometriose' },
  { href: '/beschwerden/pcos/', label: 'PCOS' },
];
const rel2Links = [
  { href: '/gesundheitsbibliothek/untersuchungen/laparoskopie/', label: 'Laparoskopie' },
  { href: '/gesundheitsbibliothek/untersuchungen/hysteroskopie/', label: 'Hysteroskopie' },
  { href: '/gesundheitsbibliothek/untersuchungen/spermiogramm/', label: 'Spermiogramm' },
