    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Gesundheitsbibliothek', item: 'https://tcm.ch/gesundheitsbibliothek/' },
      { '@type': 'ListItem', position: 3, name: 'Untersuchungen & Diagnostik', item: 'https://tcm.ch/gesundheitsbibliothek/untersuchungen/' },
      { '@type': 'ListItem', position: 4, name: 'Neurologische Untersuchung', item: url },
    ],
  },
];

const rel1Links = [
  { href: '/koerpersignale/haende-zittern/', label: 'Zitternde Hände' },
  { href: '/koerpersignale/kribbeln-im-koerper/', label: 'Kribbeln im Körper' },
  { href: '/koerpersignale/muskelzucken/', label: 'Muskelzucken am Körper' },
];
const rel2Links = [
  { href: '/gesundheitsbibliothek/untersuchungen/eeg/', label: 'EEG' },
  { href: '/gesundheitsbibliothek/untersuchungen/emg/', label: 'EMG (Elektromyografie)' },
  { href: '/gesundheitsbibliothek/untersuchungen/nervenleitmessung/', label: 'Nervenleitmessung (NLG)' },
