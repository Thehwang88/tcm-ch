import LibraryRelated from '../../../components/LibraryRelated.astro';

const path = '/gesundheitsbibliothek/untersuchungen/neurologische-untersuchung';
const url = `https://tcm.ch${path}/`;
const title = 'Neurologische Untersuchung: Ablauf & Unterschied zu EEG, EMG & NLG';
const description = 'Wie eine neurologische Untersuchung abläuft: Reflexe, Kraft, Gefühl, Koordination. Was sie zeigt, wo ihre Grenzen liegen und wie sie sich von EEG, EMG und Nervenleitmessung unterscheidet.';

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage',
    '@id': `${url}#article`,
    name: `${title} | TCM.ch`, headline: title, description, url, inLanguage: 'de-CH',
    datePublished: '2026-09-30', dateModified: '2026-09-30',
    author: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    publisher: {
