---
// Untersuchungen & Diagnostik Leaf (Kohorte 29.09.2026). Rein edukativ:
// schulmedizinische Diagnostik, TCM.ch fuehrt diese Untersuchung NICHT durch.
import LayoutDe from '../../../layouts/LayoutDe.astro';
import LibraryRelated from '../../../components/LibraryRelated.astro';

const path = '/gesundheitsbibliothek/untersuchungen/hormontest';
const url = `https://tcm.ch${path}/`;
const title = 'Hormontest: Welche Hormone kann man testen und wann sinnvoll?';
const description = 'Müdigkeit, Zyklus, Wechseljahre, Schilddrüse oder Stress: Es gibt nicht den einen Hormontest. Welche Bluttests sinnvoll sein können und warum Symptome die Auswahl bestimmen.';

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage',
    '@id': `${url}#article`,
    name: `${title} | TCM.ch`, headline: title, description, url, inLanguage: 'de-CH',
    datePublished: '2026-09-29', dateModified: '2026-09-29',
    author: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    publisher: {
      '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/',
      logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Gesundheitsbibliothek', item: 'https://tcm.ch/gesundheitsbibliothek/' },
      { '@type': 'ListItem', position: 3, name: 'Untersuchungen & Diagnostik', item: 'https://tcm.ch/gesundheitsbibliothek/untersuchungen/' },
      { '@type': 'ListItem', position: 4, name: 'Hormontest', item: url },
    ],
  },
];

const rel1Links = [
  { href: '/gesundheitsbibliothek/befunde-werte/tsh-erhoeht/', label: 'TSH erhöht' },
  { href: '/gesundheitsbibliothek/befunde-werte/tsh-niedrig/', label: 'TSH niedrig' },
];
const rel2Links = [
  { href: '/beschwerden/hashimoto/', label: 'Hashimoto' },
  { href: '/beschwerden/wechseljahre/', label: 'Wechseljahre' },
  { href: '/beschwerden/schilddruesenunterfunktion/', label: 'Schilddrüsenunterfunktion' },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <article>
    <section class="hero">
      <div class="wrap narrow">
        <div class="crumbs" role="navigation" aria-label="Breadcrumb">
          <a href="/gesundheitsbibliothek/">Gesundheitsbibliothek</a>
          <span aria-hidden="true">›</span>
          <a href="/gesundheitsbibliothek/untersuchungen/">Untersuchungen & Diagnostik</a>
          <span aria-hidden="true">›</span>
          <span class="crumb-here">Hormontest</span>
        </div>
        <div class="cat">Untersuchungen & Diagnostik</div>
        <h1>Hormontest: Welche Hormone sollte man überhaupt untersuchen?</h1>
        <p class="lead">«Ich möchte meine Hormone testen lassen» klingt zunächst eindeutig. Medizinisch ist es das nicht. Es gibt nicht den einen Hormontest. Welche Werte sinnvoll sind, hängt davon ab, welche Beschwerden bestehen und welche konkrete Frage beantwortet werden soll.</p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap narrow">
        <div class="kb-body">
          <div class="info-note"><strong>TCM.ch führt keine Laboranalysen selbst durch.</strong> Diese Seite dient der Orientierung. Welche Laborwerte medizinisch sinnvoll sind, wird anhand der individuellen Fragestellung ärztlich entschieden.</div>

<h2>Es gibt nicht den einen Hormontest</h2>
          <p>Hormone übernehmen im Körper sehr unterschiedliche Aufgaben. Deshalb gibt es kein Laborpaket, das pauschal alle hormonellen Ursachen von Müdigkeit, Gewichtszunahme, Zyklusveränderungen oder Stress erklären kann.</p>
          <p>Am Anfang steht deshalb nicht die Frage «Welche Hormone kann ich testen?», sondern: <strong>Welche medizinische Fragestellung besteht?</strong></p>

          <h2>Schilddrüsenwerte</h2>
          <p>Bei Müdigkeit, Frieren oder anderen passenden Beschwerden können Schilddrüsenwerte eine Rolle spielen. Auch hier ist nicht nur ein einzelner Laborwert entscheidend.</p>
          <p>Ein Ergebnis wie <a href="/gesundheitsbibliothek/befunde-werte/tsh-erhoeht/">TSH erhöht</a> muss im Zusammenhang mit weiteren Werten, Symptomen und der medizinischen Situation beurteilt werden.</p>

          <h2>Zyklus und Sexualhormone</h2>
          <p>Bei Zyklusstörungen, Kinderwunsch oder bestimmten Beschwerden rund um die Wechseljahre können Hormontests sinnvoll sein. Welche Werte benötigt werden und wann sie gemessen werden, hängt von der jeweiligen Fragestellung ab.</p>
          <p>Ein umfangreiches Hormonpanel ohne konkrete Frage ist nicht automatisch hilfreicher als eine gezielte Untersuchung.</p>

          <h2>Cortisol und «Stresshormone»</h2>
          <p>Im Internet werden häufig umfangreiche «Stresshormon-Checks» angeboten. Cortisol ist medizinisch messbar, die Interpretation hängt jedoch stark von Fragestellung, Tageszeit, Untersuchungsmethode und klinischer Situation ab.</p>
          <p>Ein beliebiger Einzelwert sagt nicht einfach aus, «wie gestresst» ein Mensch ist.</p>

          <h2>Warum mehr Werte nicht automatisch besser sind</h2>
          <p>Je mehr Laborwerte ohne klare Fragestellung bestimmt werden, desto wahrscheinlicher findet sich zufällig ein Wert ausserhalb des Referenzbereichs.</p>
          <p>Das bedeutet nicht automatisch Krankheit. Ein gezielter Test mit einer klaren medizinischen Frage ist deshalb häufig hilfreicher als ein sehr breites Panel ohne Kontext.</p>

          <h2>Was sollte ich zu einer Abklärung mitbringen?</h2>
          <ul>
            <li>konkrete Beschwerden</li>
            <li>seit wann sie bestehen</li>
            <li>Medikamente und Nahrungsergänzungsmittel</li>
            <li>Zyklusinformationen, falls relevant</li>
            <li>frühere Laborwerte</li>
            <li>bekannte Erkrankungen</li>
          </ul>

          <div class="wa-callout">
            <div class="wa-callout-label">Keine Selbstdiagnose aus einzelnen Laborwerten</div>
            <p>Referenzbereiche und einzelne Werte müssen im medizinischen Zusammenhang interpretiert werden. Medikamente oder Hormone sollten nicht aufgrund eines selbst interpretierten Laborbefunds verändert oder abgesetzt werden.</p>
          </div>

          <h2>Und was hat das mit TCM zu tun?</h2>
          <p>Laborwerte beantworten medizinische Fragestellungen. TCM kann sie nicht ersetzen.</p>
          <p>Wenn eine medizinische Abklärung erfolgt ist und funktionelle Begleitbeschwerden bestehen, kann danach geprüft werden, ob eine ergänzende Behandlung sinnvoll ist.</p>
        </div>

        <LibraryRelated
          label="Befunde & Werte"
          title="Laborwerte verstehen"
          links={rel1Links}
          allHref="/gesundheitsbibliothek/befunde-werte/"
          allLabel="Alle Befunde & Werte"
        />
        <LibraryRelated
          label="Beschwerden"
          title="Passende Themen"
          links={rel2Links}
          allHref="/beschwerden/"
          allLabel="Alle Beschwerden"
        />

        <div class="cta-card">
          <div class="cta-card-title">Du vermutest «Hormone», weisst aber nicht, welche Abklärung sinnvoll ist?</div>
          <p>Bring deine Beschwerden und vorhandene Laborwerte in die ärztliche Sprechstunde. Statt wahllos Werte zu testen, lässt sich zuerst klären, welche Fragestellung überhaupt besteht und welche Untersuchung sinnvoll sein kann.</p>
          <div class="cta-row">
            <a class="btn btn--primary" href="/sprechstunde/">Ärztliche Sprechstunde</a>
            <a class="btn btn--ghost" href="/standorte/">Praxis in deiner Nähe finden</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</LayoutDe>

<style>
  .wrap.narrow { max-width: 760px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13.5px; margin-bottom: 18px; }
  .crumbs a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span[aria-hidden] { color: var(--muted); }
  .crumb-here { color: var(--muted); font-weight: 600; }
  .cat { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); margin-bottom: 10px; }
  h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.12; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 16px; }
  .hero .lead { font-size: 19px; line-height: 1.5; color: var(--mid); }
  .info-note { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-btn); padding: 16px 18px; font-size: 15px; line-height: 1.6; color: var(--mid); margin: 0 0 8px; }
  .info-note strong { color: var(--ink); }
  .kb-body h2 { font-size: 25px; font-weight: 800; color: var(--ink); margin: 38px 0 14px; letter-spacing: var(--tracking-heading); }
  .kb-body p { font-size: 17.5px; line-height: 1.65; color: var(--mid); margin: 0 0 18px; }
  .kb-body ul { font-size: 17.5px; line-height: 1.6; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .kb-body li { margin: 0 0 10px; }
  .kb-body strong { color: var(--ink); }
  .kb-body a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kb-body a:hover { text-decoration: underline; }
  .cta-card { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 24px; margin: 40px 0 0; }
  .cta-card-title { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 6px; }
  .cta-card p { font-size: 15.5px; color: var(--mid); margin: 0 0 16px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .kb-body .wa-callout { background: var(--blue-light); border-left: 3px solid var(--blue); border-radius: 0 var(--r-btn) var(--r-btn) 0; padding: 18px 20px; margin: 24px 0; }
  .kb-body .wa-callout-label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 6px; }
  .kb-body .wa-callout p { margin: 0; font-size: 16px; }
</style>
