---
// Untersuchungen & Diagnostik Leaf (Kohorte 05.10.2026). Rein edukativ:
// schulmedizinische Diagnostik, TCM.ch fuehrt diese Untersuchung NICHT durch.
import LayoutDe from '../../../layouts/LayoutDe.astro';
import LibraryRelated from '../../../components/LibraryRelated.astro';

const path = '/gesundheitsbibliothek/untersuchungen/ogtt';
const url = `https://tcm.ch${path}/`;
const title = 'oGTT (Glukosetoleranztest): Ablauf, Vorbereitung & Zweck';
const description = 'Wie läuft der orale Glukosetoleranztest ab? Vorbereitung, Zuckerlösung, Blutentnahmen, Einsatz in der Schwangerschaft und warum die Interpretation ärztlich erfolgt.';

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage',
    '@id': `${url}#article`,
    name: `${title} | TCM.ch`, headline: title, description, url, inLanguage: 'de-CH',
    datePublished: '2026-10-05', dateModified: '2026-10-05',
    author: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    publisher: {
      '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/',
      logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Gesundheitsbibliothek', item: 'https://tcm.ch/gesundheitsbibliothek/' },
      { '@type': 'ListItem', position: 3, name: 'Untersuchungen & Diagnostik', item: 'https://tcm.ch/gesundheitsbibliothek/untersuchungen/' },
      { '@type': 'ListItem', position: 4, name: 'oGTT (Glukosetoleranztest)', item: url },
    ],
  },
];

const rel1Links = [
  { href: '/gesundheitsbibliothek/befunde-werte/blutzucker-erhoeht/', label: 'Blutzucker erhöht' },
  { href: '/gesundheitsbibliothek/befunde-werte/hba1c-erhoeht/', label: 'HbA1c erhöht' },
  { href: '/beschwerden/diabetes-typ-2/', label: 'Diabetes Typ 2' },
];
const rel2Links = [
  { href: '/gesundheitsbibliothek/untersuchungen/grosses-blutbild/', label: 'Grosses Blutbild' },
  { href: '/gesundheitsbibliothek/untersuchungen/h2-atemtest/', label: 'H2-Atemtest' },
  { href: '/gesundheitsbibliothek/untersuchungen/urinuntersuchung/', label: 'Urinuntersuchung' },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <article>
    <section class="hero">
      <div class="wrap narrow">
        <div class="crumbs" role="navigation" aria-label="Breadcrumb">
          <a href="/gesundheitsbibliothek/">Gesundheitsbibliothek</a>
          <span aria-hidden="true">›</span>
          <a href="/gesundheitsbibliothek/untersuchungen/">Untersuchungen & Diagnostik</a>
          <span aria-hidden="true">›</span>
          <span class="crumb-here">oGTT</span>
        </div>
        <div class="cat">Untersuchungen & Diagnostik</div>
        <h1>oGTT: Wie der Glukosetoleranztest abläuft</h1>
        <p class="lead">Der orale Glukosetoleranztest (oGTT) zeigt, wie der Körper mit einer definierten Zuckermenge umgeht. Er wird vor allem eingesetzt, wenn einzelne Blutzuckerwerte keine klare Antwort geben – und standardmässig in der Schwangerschaft.</p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap narrow">
        <div class="kb-body">
          <div class="info-note">Diese Seite dient der Orientierung. Der oGTT ist eine schulmedizinische Untersuchung und wird ärztlich veranlasst und beurteilt. <strong>TCM.ch führt diese Untersuchung nicht selbst durch.</strong> Wir helfen aber dabei, Beschwerden einzuordnen und sagen ehrlich, wann eine medizinische Abklärung vor einer ergänzenden Behandlung sinnvoll ist.</div>

          <h2>Was ist ein oGTT?</h2>
          <p>Beim oralen Glukosetoleranztest trinkst du nach einer ersten Blutentnahme eine standardisierte Zuckerlösung. Danach wird der Blutzucker zu festgelegten Zeitpunkten erneut gemessen – üblicherweise nach ein und zwei Stunden.</p>
          <p>So zeigt der Test nicht nur eine Momentaufnahme, sondern die Reaktion des Stoffwechsels auf eine definierte Zuckerbelastung.</p>

          <h2>Wann wird der Test eingesetzt?</h2>
          <ul>
            <li>wenn Nüchternblutzucker oder <a href="/gesundheitsbibliothek/befunde-werte/hba1c-erhoeht/">HbA1c</a> grenzwertig sind und eine klarere Einordnung gebraucht wird</li>
            <li>zur Abklärung einer gestörten Glukosetoleranz (Vorstufe des <a href="/beschwerden/diabetes-typ-2/">Typ-2-Diabetes</a>)</li>
            <li>standardmässig in der Schwangerschaft zur Erkennung eines Schwangerschaftsdiabetes (Gestationsdiabetes), meist zwischen der 24. und 28. Woche</li>
          </ul>
          <p>Ob und wann der Test sinnvoll ist, entscheidet die behandelnde Ärztin oder der behandelnde Arzt.</p>

          <h2>Wie bereitest du dich vor?</h2>
          <p>Üblich sind: nüchtern erscheinen (in der Regel 8 bis 12 Stunden nichts essen, nur Wasser trinken), in den Tagen davor normal essen und keine ungewohnten Extremdiäten, am Testtag auf Kaffee, Nikotin und körperliche Anstrengung vor und während des Tests verzichten. Die Praxis gibt dir die genauen Anweisungen – sie gehen vor.</p>
          <p>Akute Infekte können das Resultat verfälschen; melde dich in diesem Fall vorher bei der Praxis.</p>

          <h2>Wie läuft der Test ab?</h2>
          <p>Nach der ersten Blutentnahme trinkst du die Zuckerlösung innert weniger Minuten. Danach bleibst du ruhig sitzend in der Praxis, bis die weiteren Blutentnahmen erfolgen. Insgesamt dauert der Test meist zwei bis drei Stunden.</p>
          <p>Manchen Menschen wird von der süssen Lösung etwas flau oder übel – das darf man dem Praxisteam jederzeit sagen.</p>

          <h2>Was bedeutet das Resultat?</h2>
          <p>Die Interpretation gehört in ärztliche Hände: Sie hängt von den Messzeitpunkten, der Fragestellung und der Situation ab – in der Schwangerschaft gelten andere Beurteilungsgrenzen als ausserhalb. Ein auffälliger oGTT wird immer im Zusammenhang mit weiteren Werten und der Gesamtsituation beurteilt.</p>
          <p>Je nach Resultat folgen Beratung zu Ernährung und Bewegung, weitere Kontrollen oder eine Behandlung – beim Schwangerschaftsdiabetes eng begleitet durch Gynäkologie und gegebenenfalls Diabetesberatung.</p>

          <div class="wa-callout">
            <div class="wa-callout-label">Gut zu wissen</div>
            <p>Ein einzelner grenzwertiger Zuckerwert ist noch keine Diagnose – und ein unauffälliger oGTT ist kein Freipass für immer. Bei Risikofaktoren gehören Blutzuckerwerte regelmässig ärztlich kontrolliert.</p>
          </div>

          <h2>Und was hat das mit TCM zu tun?</h2>
          <p>Der oGTT ist medizinische Diagnostik und wird nicht durch TCM ersetzt. Zuckerstoffwechsel-Diagnosen und ihre Behandlung gehören in ärztliche Betreuung; eine komplementäre Begleitung ist höchstens bei Begleitthemen wie Stress oder Schlaf ein Gespräch wert – nach der Abklärung.</p>
        </div>

        <LibraryRelated
          label="Befunde & Werte"
          title="Passende Werte verstehen"
          links={rel1Links}
          allHref="/gesundheitsbibliothek/befunde-werte/"
          allLabel="Alle Befunde & Werte"
        />
        <LibraryRelated
          label="Untersuchungen"
          title="Verwandte Untersuchungen"
          links={rel2Links}
          allHref="/gesundheitsbibliothek/untersuchungen/"
          allLabel="Alle Untersuchungen"
        />

        <div class="cta-card">
          <div class="cta-card-title">Unsicher, was dein Zuckerwert bedeutet?</div>
          <p>In einer ärztlichen Sprechstunde lässt sich klären, ob ein oGTT oder andere Kontrollen zu deiner Situation passen.</p>
          <div class="cta-row">
            <a class="btn btn--primary" href="/sprechstunde/">Ärztliche Sprechstunde</a>
            <a class="btn btn--ghost" href="/standorte/">Praxis in deiner Nähe finden</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</LayoutDe>

<style>
  .wrap.narrow { max-width: 760px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13.5px; margin-bottom: 18px; }
  .crumbs a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span[aria-hidden] { color: var(--muted); }
  .crumb-here { color: var(--muted); font-weight: 600; }
  .cat { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); margin-bottom: 10px; }
  h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.12; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 16px; }
  .hero .lead { font-size: 19px; line-height: 1.5; color: var(--mid); }
  .info-note { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-btn); padding: 16px 18px; font-size: 15px; line-height: 1.6; color: var(--mid); margin: 0 0 8px; }
  .info-note strong { color: var(--ink); }
  .kb-body h2 { font-size: 25px; font-weight: 800; color: var(--ink); margin: 38px 0 14px; letter-spacing: var(--tracking-heading); }
  .kb-body p { font-size: 17.5px; line-height: 1.65; color: var(--mid); margin: 0 0 18px; }
  .kb-body ul { font-size: 17.5px; line-height: 1.6; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .kb-body li { margin: 0 0 10px; }
  .kb-body strong { color: var(--ink); }
  .kb-body a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kb-body a:hover { text-decoration: underline; }
  .cta-card { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 24px; margin: 40px 0 0; }
  .cta-card-title { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 6px; }
  .cta-card p { font-size: 15.5px; color: var(--mid); margin: 0 0 16px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .kb-body .wa-callout { background: var(--blue-light); border-left: 3px solid var(--blue); border-radius: 0 var(--r-btn) var(--r-btn) 0; padding: 18px 20px; margin: 24px 0; }
  .kb-body .wa-callout-label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 6px; }
  .kb-body .wa-callout p { margin: 0; font-size: 16px; }
</style>
