const url = `https://tcm.ch${path}/`;
const title = 'Urodynamik: Ablauf und Befund der Blasendruckmessung';
const description = 'Urodynamik (Blasendruckmessung): wann sie veranlasst wird, wie Uroflowmetrie, Restharn und Zystometrie ablaufen, was die Werte zeigen und welche Risiken bestehen.';
const published = PUBLISHED_BIBLIOTHEK_2026_10_26;

