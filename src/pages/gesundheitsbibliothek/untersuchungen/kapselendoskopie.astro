  .kb-body ul { font-size: 17.5px; line-height: 1.6; color: var(--mid); padding-left: 22px; margin: 0 0 18px; }
  .kb-body li { margin: 0 0 10px; }
  .kb-body strong { color: var(--ink); }
  .kb-body a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kb-body a:hover { text-decoration: underline; }
  .cta-card { background: var(--blue-light); border: 1px solid rgba(45,155,111,.25); border-radius: var(--r-card); padding: 24px; margin: 40px 0 0; }
  .cta-card-title { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 6px; }
  .cta-card p { font-size: 15.5px; color: var(--mid); margin: 0 0 16px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .kb-body .wa-callout { background: var(--blue-light); border-left: 3px solid var(--blue); border-radius: 0 var(--r-btn) var(--r-btn) 0; padding: 18px 20px; margin: 24px 0; }
  .kb-body .wa-callout-label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 6px; }
  .kb-body .wa-callout p { margin: 0; font-size: 16px; }
  .kb-body h3 { font-size: 19px; font-weight: 800; color: var(--ink); margin: 26px 0 10px; letter-spacing: var(--tracking-heading); }
</style>
