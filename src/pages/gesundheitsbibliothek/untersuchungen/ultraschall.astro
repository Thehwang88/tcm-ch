const rel1Links = [
  { href: '/koerpersignale/harter-oberbauch-ohne-schmerzen/', label: 'Harter Oberbauch ohne Schmerzen' },
  { href: '/koerpersignale/druck-im-oberbauch/', label: 'Druck im Oberbauch' },
  { href: '/koerpersignale/schwere-beine-abends/', label: 'Schwere Beine am Abend' },
];
const rel2Links = [
  { href: '/beschwerden/schulterschmerzen/', label: 'Schulterschmerzen' },
  { href: '/beschwerden/kalkschulter/', label: 'Kalkschulter' },
  { href: '/beschwerden/schwere-beine/', label: 'Schwere Beine' },
