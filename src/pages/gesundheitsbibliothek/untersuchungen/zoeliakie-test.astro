// Paket; Publikationsdatum ueber PUBLISHED_LABORWERTE_2026_10_W2 (Schema nur mit gesetztem Datum).
import LayoutDe from '../../../layouts/LayoutDe.astro';
import LibraryRelated from '../../../components/LibraryRelated.astro';
import { PUBLISHED_LABORWERTE_2026_10_W2 } from '../../../data/befunde-werte';

const path = '/gesundheitsbibliothek/untersuchungen/zoeliakie-test';
const url = `https://tcm.ch${path}/`;
const title = 'Zöliakie-Test: Bluttest und Abklärung';
const description = 'Wie Zöliakie mit Antikörpertests und gegebenenfalls Gewebeproben abgeklärt wird. Warum glutenfreie Ernährung vor dem Test das Ergebnis verändern kann.';
const published = PUBLISHED_LABORWERTE_2026_10_W2;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MedicalWebPage',
    '@id': `${url}#article`,
    name: `${title} | TCM.ch`, headline: 'Zöliakie-Test: Was wird untersucht?', description, url, inLanguage: 'de-CH',
    ...(published ? { datePublished: published, dateModified: published } : {}),
    author: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
    publisher: {
      '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/',
      logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Gesundheitsbibliothek', item: 'https://tcm.ch/gesundheitsbibliothek/' },
      { '@type': 'ListItem', position: 3, name: 'Untersuchungen & Diagnostik', item: 'https://tcm.ch/gesundheitsbibliothek/untersuchungen/' },
      { '@type': 'ListItem', position: 4, name: 'Zöliakie-Test', item: url },
    ],
  },
];

const rel1Links = [
  { href: '/beschwerden/eisenmangel/', label: 'Eisenmangel' },
  { href: '/beschwerden/zoeliakie/', label: 'Zöliakie' },
];
const rel2Links = [
  { href: '/gesundheitsbibliothek/untersuchungen/allergietest/', label: 'Allergietest' },
  { href: '/gesundheitsbibliothek/untersuchungen/biopsie/', label: 'Biopsie' },
  { href: '/gesundheitsbibliothek/untersuchungen/gastroskopie/', label: 'Gastroskopie' },
];
const rel3Links = [
  { href: '/gesundheitsbibliothek/befunde-werte/folsaeure-zu-niedrig/', label: 'Folsäure zu niedrig: Was bedeutet ein Folsäuremangel?' },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <article>
    <section class="hero">
      <div class="wrap narrow">
        <div class="crumbs" role="navigation" aria-label="Breadcrumb">
          <a href="/gesundheitsbibliothek/">Gesundheitsbibliothek</a>
          <span aria-hidden="true">›</span>
          <a href="/gesundheitsbibliothek/untersuchungen/">Untersuchungen & Diagnostik</a>
          <span aria-hidden="true">›</span>
          <span class="crumb-here">Zöliakie-Test</span>
        </div>
        <div class="cat">Untersuchungen & Diagnostik</div>
        <h1>Zöliakie-Test: Was wird untersucht?</h1>
        <p class="lead">Bei Verdacht auf Zöliakie kommt es auf den richtigen Untersuchungsweg an. Ein negativer Einzeltest schliesst die Erkrankung nicht unter allen Bedingungen aus.</p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap narrow">
        <div class="kb-body">
          <div class="info-note">Diese Seite dient der Orientierung. Die Zöliakie-Diagnostik wird ärztlich veranlasst und beurteilt. <strong>TCM.ch führt diese Untersuchung nicht selbst durch.</strong> Wir helfen aber dabei, Beschwerden einzuordnen und sagen ehrlich, wann eine Abklärung vor einer ergänzenden Behandlung sinnvoll ist.</div>

          <div class="wa-callout">
            <div class="wa-callout-label">Kurz gesagt</div>
            <p>Zur Abklärung einer Zöliakie werden meist bestimmte Antikörper im Blut untersucht. Je nach Ergebnis und Situation kommen Gewebeproben aus dem Dünndarm hinzu. Wichtig: Wer vor der Untersuchung glutenfrei isst, kann die Testergebnisse verändern. Eine Ernährungsumstellung sollte deshalb mit der untersuchenden Praxis abgestimmt werden.</p>
          </div>

          <h2>Welche Blutwerte werden geprüft?</h2>
          <p>Häufig beginnt die Abklärung mit Antikörpern gegen Gewebstransglutaminase vom Typ IgA, abgekürzt tTG-IgA. Zusätzlich wird meist Gesamt-IgA berücksichtigt. Bei einem IgA-Mangel können sonst falsch unauffällige Ergebnisse entstehen; dann werden geeignete andere Tests ausgewählt.</p>
          <p>Je nach Befund können weitere Antikörperuntersuchungen folgen. Das ist ein gezielter Diagnoseweg, kein beliebiger „Unverträglichkeitstest“.</p>
          <h2>Wann braucht es eine Gewebeprobe?</h2>
          <p>Bei einer <a href="/gesundheitsbibliothek/untersuchungen/gastroskopie/">Gastroskopie</a> können kleine Proben aus dem oberen Dünndarm entnommen werden. Die mikroskopische Untersuchung sucht nach Veränderungen, die zur Zöliakie passen.</p>
          <p>Nicht jede Person durchläuft exakt denselben Weg. Für bestimmte Konstellationen bestehen fachärztliche Diagnosewege ohne Biopsie. Ob diese Kriterien erfüllt sind, entscheidet die spezialisierte Praxis. Eine positive Einzelmessung sollte nicht eigenständig zur abschliessenden Diagnose erklärt werden.</p>

          <h2>Warum Gluten vor dem Test wichtig ist</h2>
          <p>Die Antikörperbildung und Veränderungen im Darm können sich unter glutenfreier Ernährung zurückbilden. Deshalb sollte die Abklärung möglichst vor einer solchen Umstellung erfolgen.</p>
          <p>Wenn du bereits glutenfrei isst, teile das offen mit. Beginne nicht ohne ärztlichen Plan eine „Glutenbelastung“. Menge, Dauer und geeignete Untersuchung hängen von deiner Situation ab.</p>

          <h2>Grenzen</h2>
          <p>Eine Besserung nach Weglassen von Brot beweist keine Zöliakie. Auch andere Bestandteile der Ernährung oder andere Erkrankungen können Beschwerden beeinflussen.</p>
          <p>Ein negativer Antikörpertest ist nicht unter allen Bedingungen gleich aussagekräftig, beispielsweise bei glutenfreier Ernährung oder IgA-Mangel. Genetische Tests können in ausgewählten Situationen helfen; ein passendes genetisches Merkmal allein beweist die Erkrankung jedoch nicht.</p>
          <p>Die Seite <a href="/beschwerden/zoeliakie/">Zöliakie</a> erklärt das Krankheitsbild. Ein <a href="/gesundheitsbibliothek/untersuchungen/allergietest/">Allergietest</a> untersucht eine andere Frage und ersetzt die Zöliakiediagnostik nicht.</p>

          <h2>Wann eine Abklärung wichtig ist</h2>
          <p>Anhaltender Durchfall, unbeabsichtigter Gewichtsverlust oder wiederkehrende Mangelbefunde gehören ärztlich besprochen. Bei starker Austrocknung, Ohnmacht oder schweren akuten Bauchbeschwerden brauchst du rasch medizinische Hilfe.</p>

          <h2>Nächste Schritte</h2>
          <p>Nimm frühere Laborbefunde mit und notiere, wie du dich vor der Blutentnahme ernährt hast. Frage, ob Gesamt-IgA mitgemessen wurde und wie ein auffälliger oder unklarer Befund weiter abgeklärt wird.</p>
          <p>Bei ungeklärtem <a href="/beschwerden/eisenmangel/">Eisenmangel</a> oder <a href="/gesundheitsbibliothek/befunde-werte/folsaeure-zu-niedrig/">Folsäuremangel</a> kann eine Zöliakieabklärung je nach Situation dazugehören. Solche Mängel haben aber auch andere Ursachen. Die allgemeine Seite zur <a href="/gesundheitsbibliothek/untersuchungen/biopsie/">Biopsie</a> erklärt, was mit einer entnommenen Gewebeprobe geschieht.</p>

          <h2>Häufige Fragen</h2>
          <h3>Soll ich vor dem Test glutenfrei essen?</h3>
          <p>Nicht ohne Abstimmung. Glutenfreie Ernährung kann die Ergebnisse verändern und eine spätere Diagnose erschweren.</p>
          <h3>Ist ein Zöliakie-Test ein Allergietest?</h3>
          <p>Nein. Zöliakie und Weizenallergie werden mit unterschiedlichen Verfahren abgeklärt.</p>
          <h3>Braucht jede Person eine Dünndarmbiopsie?</h3>
          <p>Nicht ausnahmslos. Ob ein Diagnoseweg ohne Biopsie infrage kommt, wird anhand fachärztlicher Kriterien entschieden.</p>

          <h2>Quellen</h2>
          <ul style="font-size:14px;color:var(--muted)">
            <li><a href="https://www.niddk.nih.gov/health-information/digestive-diseases/celiac-disease/diagnosis" target="_blank" rel="noopener">NIDDK, Diagnosis of Celiac Disease</a></li>
            <li><a href="https://www.niddk.nih.gov/health-information/professionals/clinical-tools-patient-management/digestive-diseases/celiac-disease-health-care-professionals" target="_blank" rel="noopener">NIDDK, Celiac Disease Tests</a></li>
            <li><a href="https://doi.org/10.1136/gutjnl-2025-337747" target="_blank" rel="noopener">British Society of Gastroenterology, Guideline on adult coeliac disease, 2026</a></li>
          </ul>

        </div>

        <LibraryRelated label="Beschwerden" title="Passende Themen" links={rel1Links} allHref="/beschwerden/" allLabel="Alle Beschwerden" />
        <LibraryRelated label="Untersuchungen" title="Verwandte Untersuchungen" links={rel2Links} allHref="/gesundheitsbibliothek/untersuchungen/" allLabel="Alle Untersuchungen" />
        <LibraryRelated label="Befunde &amp; Werte" title="Verwandte Befunde" links={rel3Links} allHref="/gesundheitsbibliothek/befunde-werte/" allLabel="Alle Befunde" />

        <div class="cta-card">
          <div class="cta-card-title">Unsicher, was der nächste Schritt ist?</div>
          <p>Diese Untersuchung wird ärztlich veranlasst und beurteilt. Wenn du nach der Abklärung wissen möchtest, ob eine ergänzende Behandlung sinnvoll ist, helfen wir bei der Einordnung.</p>
          <div class="cta-row">
            <a class="btn btn--primary" href="/standorte/">Praxis finden</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</LayoutDe>

