];

const rel1Links = [
  { href: '/koerpersignale/herzstolpern-in-ruhe/', label: 'Herzstolpern in Ruhe' },
  { href: '/koerpersignale/herzklopfen-im-liegen/', label: 'Herzklopfen im Liegen' },
  { href: '/koerpersignale/herzklopfen-nach-dem-essen/', label: 'Herzklopfen nach dem Essen' },
