---
// Was-jetzt?-Artikel-Template (Phase 1). Handlungsorientierter Aufbau: Kurzantwort,
// "Was du jetzt tun kannst", "Was du besser vermeiden solltest", optionale
// Selbsthilfe-Module (NUR wo relevant, kein Pflicht-Raster), dann Sicherheit
// (Wann ärztlich abklären, Wenn es nicht besser wird) und erst zum Schluss
// "Wann professionelle Behandlung sinnvoll sein kann" mit zurückhaltendem CTA.
// Kein herbsHtml: Kräutertherapie ist professioneller Behandlungsweg.
// Geplante Beiträge bauen nur im Dev-Server (noindex allein reicht nicht),
// sind immer noindex und landen nie in Sitemap oder Suche.
import LayoutDe from '../../../layouts/LayoutDe.astro';
import { wasJetzt, publishedWasJetzt, TOOL_LABELS } from '../../../data/was-jetzt';
import type { WasJetztEntry, WasJetztLink } from '../../../data/was-jetzt';

export function getStaticPaths() {
  // Produktions-Build erzeugt Routen NUR für publizierte Beiträge.
  const source = import.meta.env.DEV ? wasJetzt : publishedWasJetzt;
  return source.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

interface Props { w: WasJetztEntry }
const { w } = Astro.props;
const path = `/gesundheitsbibliothek/was-jetzt/${w.slug}`;
const url = `https://tcm.ch${path}/`;
const isReal = w.status === 'published';
const indexable = isReal && w.indexable;

// Optionale Selbsthilfe-Module in fester, sinnvoller Reihenfolge; gerendert
// wird nur, was Inhalt hat.
const modules: { label: string; html?: string }[] = [
  { label: TOOL_LABELS.movement, html: w.movementHtml },
  { label: TOOL_LABELS.nutrition, html: w.nutritionHtml },
  { label: TOOL_LABELS.acupressure, html: w.acupressureHtml },
  { label: TOOL_LABELS['heat-cold'], html: w.heatColdHtml },
  { label: TOOL_LABELS.sleep, html: w.sleepHtml },
  { label: TOOL_LABELS.stress, html: w.stressHtml },
  { label: TOOL_LABELS.ergonomics, html: w.ergonomicsHtml },
].filter((m) => m.html);

const relatedGroups: { label: string; items: WasJetztLink[] }[] = [
  { label: 'Körpersignale', items: w.relatedSignals ?? [] },
  { label: 'Beschwerden', items: w.relatedConditions ?? [] },
  { label: 'Befunde & Werte', items: w.relatedFindings ?? [] },
  { label: 'Therapien', items: w.relatedTherapies ?? [] },
  { label: 'Diagnostik', items: w.relatedDiagnostics ?? [] },
  { label: 'Visuals', items: w.relatedVisuals ?? [] },
].filter((g) => g.items.length > 0);

// Schema NUR für publizierte Beiträge mit echten Angaben.
const schema: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Gesundheitsbibliothek', item: 'https://tcm.ch/gesundheitsbibliothek/' },
      { '@type': 'ListItem', position: 3, name: 'Was jetzt?', item: 'https://tcm.ch/gesundheitsbibliothek/was-jetzt/' },
      { '@type': 'ListItem', position: 4, name: w.title, item: url },
    ],
  },
];
if (isReal && w.publishedAt) {
  schema.unshift({
    '@context': 'https://schema.org', '@type': 'Article',
    '@id': `${url}#article`, headline: w.title, description: w.deck, url, inLanguage: 'de-CH',
    datePublished: w.publishedAt, ...(w.updatedAt ? { dateModified: w.updatedAt } : {}),
    publisher: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/', logo: { '@type': 'ImageObject', url: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png' } },
  });
}
---
<LayoutDe title={`${w.title} | TCM.ch`} description={w.deck} path={path} schema={schema} noindex={!indexable} robots={indexable ? undefined : 'noindex, follow'}>
  <article>
    <section class="hero">
      <div class="wrap narrow">
        <div class="crumbs" role="navigation" aria-label="Breadcrumb">
          <a href="/gesundheitsbibliothek/">Gesundheitsbibliothek</a>
          <span aria-hidden="true">›</span>
          <a href="/gesundheitsbibliothek/was-jetzt/">Was jetzt?</a>
        </div>
        {w.status !== 'published' && <div class="mock-badge">Geplanter Beitrag, noch ohne Inhalt (nur Dev)</div>}
        <div class="cat">Was jetzt?</div>
        <h1>{w.title}</h1>
        <p class="deck">{w.deck}</p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap narrow">
        <div class="read">

          {w.shortAnswerHtml && (
            <aside class="short">
              <div class="box-label">Kurz gesagt</div>
              <div class="kb-body" set:html={w.shortAnswerHtml} />
            </aside>
          )}

          {w.doNowHtml
            ? (
              <Fragment>
                <h2 class="sec-title">Was du jetzt tun kannst</h2>
                <div class="kb-body" set:html={w.doNowHtml} />
              </Fragment>
            )
            : <p class="placeholder">Dieser Beitrag ist noch nicht redigiert. (Infrastruktur-Vorschau)</p>}

          {w.avoidHtml && (
            <aside class="box box--avoid">
              <div class="box-label">Was du besser vermeiden solltest</div>
              <div class="kb-body" set:html={w.avoidHtml} />
            </aside>
          )}

          {modules.map((m) => (
            <aside class="box">
              <div class="box-label">{m.label}</div>
              <div class="kb-body" set:html={m.html} />
            </aside>
          ))}

          {w.whenToSeekCareHtml && (
            <aside class="box box--warn">
              <div class="box-label">Wann ärztlich abklären?</div>
              <div class="kb-body" set:html={w.whenToSeekCareHtml} />
            </aside>
          )}

          {w.notBetterHtml && (
            <aside class="box">
              <div class="box-label">Wenn es nicht besser wird</div>
              <div class="kb-body" set:html={w.notBetterHtml} />
            </aside>
          )}

          {w.professionalTreatmentHtml && (
            <aside class="box box--pro">
              <div class="box-label">Wann professionelle Behandlung sinnvoll sein kann</div>
              <div class="kb-body" set:html={w.professionalTreatmentHtml} />
            </aside>
          )}

          <div class="hinweis">Selbsthilfe ist nur dort sinnvoll, wo die Beschwerden dafür geeignet sind. Diese Hinweise ersetzen keine ärztliche Beurteilung.</div>

          {w.sources && w.sources.length > 0 && (
            <div class="sources">
              <h2 class="src-title">Quellen</h2>
              <ol>
                {w.sources.map((s) => (
                  <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.label}</a> : s.label}</li>
                ))}
              </ol>
            </div>
          )}
        </div>

        {relatedGroups.length > 0 && (
          <div class="related">
            <div class="rel-label">Zum Weiterlesen</div>
            <div class="rel-grid">
              {relatedGroups.map((g) => g.items.map((r) => (
                <a class="rel-card" href={r.href}>
                  <div class="rel-cat">{g.label}</div>
                  <div class="rel-title">{r.label}</div>
                </a>
              )))}
            </div>
          </div>
        )}
      </div>
    </section>
  </article>
</LayoutDe>

<style>
  .wrap.narrow { max-width: 960px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13.5px; margin-bottom: 18px; }
  .crumbs a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span[aria-hidden] { color: var(--muted); }
  .mock-badge { display: inline-block; background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 700; margin-bottom: 14px; }
  .cat { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); margin-bottom: 12px; }
  h1 { font-size: clamp(30px, 4.6vw, 46px); line-height: 1.1; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 16px; max-width: 820px; }
  .deck { font-size: 20px; line-height: 1.5; color: var(--mid); max-width: 720px; margin: 0; }

  .read { max-width: 720px; }
  .sec-title { font-size: 25px; font-weight: 800; color: var(--ink); margin: 0 0 14px; letter-spacing: var(--tracking-heading); }
  .kb-body :global(h2) { font-size: 25px; font-weight: 800; color: var(--ink); margin: 40px 0 14px; letter-spacing: var(--tracking-heading); }
  .kb-body :global(p) { font-size: 17.5px; line-height: 1.7; color: var(--mid); margin: 0 0 18px; }
  .kb-body :global(a) { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kb-body :global(a:hover) { text-decoration: underline; }
  .kb-body :global(strong) { color: var(--ink); }
  .kb-body :global(ul) { padding-left: 22px; margin: 0 0 18px; }
  .kb-body :global(li) { font-size: 16.5px; line-height: 1.65; color: var(--mid); margin-bottom: 8px; }
  .placeholder { font-size: 15px; color: var(--muted); border: 1px dashed var(--border); border-radius: var(--r-card); padding: 18px 20px; }

  .short { background: var(--blue-light); border-left: 3px solid var(--blue); border-radius: 0 var(--r-card) var(--r-card) 0; padding: 20px 22px; margin: 0 0 30px; }
  .box { border: 1px solid var(--border); border-radius: var(--r-card); padding: 20px 22px; margin: 30px 0; }
  .box--avoid { border-left: 3px solid var(--blue); border-radius: 0 var(--r-card) var(--r-card) 0; }
  .box--warn { border-left: 3px solid #c8842a; border-radius: 0 var(--r-card) var(--r-card) 0; }
  .box--pro { background: var(--surface); }
  .box-label, .short .box-label { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue-dark); margin-bottom: 8px; }
  .box--warn .box-label { color: #92400E; }
  .short :global(p), .box :global(p) { margin: 0 0 10px; font-size: 16px; }
  .short :global(p:last-child), .box :global(p:last-child) { margin-bottom: 0; }

  .hinweis { font-size: 14px; line-height: 1.6; color: var(--muted); border-top: 1px solid var(--border); margin-top: 36px; padding-top: 16px; }

  .sources { border-top: 1px solid var(--border); margin-top: 24px; padding-top: 22px; }
  .src-title { font-size: 16px; font-weight: 800; color: var(--ink); margin: 0 0 12px; letter-spacing: .02em; }
  .sources ol { padding-left: 20px; margin: 0; }
  .sources li { font-size: 14px; line-height: 1.6; color: var(--mid); margin-bottom: 8px; }
  .sources a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .sources a:hover { text-decoration: underline; }

  .related { border-top: 1px solid var(--border); margin-top: 48px; padding-top: 24px; }
  .rel-label { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .rel-card { border: 1px solid var(--border); border-radius: var(--r-card); padding: 16px; text-decoration: none; transition: border-color var(--t-fast) ease; }
  .rel-card:hover { border-color: var(--blue); }
  .rel-cat { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--blue); margin-bottom: 6px; }
  .rel-title { font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.3; }

  @media (max-width: 860px) { .rel-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .rel-grid { grid-template-columns: 1fr; } }
</style>
