---
// /karriere/ — TCM Jobs Schweiz (Anstellung). Inhalte stammen aus der früheren /partner/-Seite;
// /partner/ ist seit 09/2026 die Seite für lokale Unternehmer:innen (Partnermodell).
import LayoutDe from '../../layouts/LayoutDe.astro';
import { site } from '../../data/site';
import { B2B_LINKS, LEGAL_NOTE } from '../../data/b2b';

const path = '/karriere';
const url = new URL(path + '/', site.url).href;
const title = 'TCM Jobs Schweiz: Karriere als Therapeut:in | TCM.ch';
const description =
  'TCM Jobs in der Schweiz: Stellen für TCM-Therapeut:innen, Akupunkteur:innen, Senior-Therapeut:innen und Standortleitungen im TCM.ch Netzwerk.';

const trust = ['TCM', 'Akupunktur', 'Tuina', 'Kräutermedizin', 'Physiotherapie', 'medizinische Massage', 'Senior', 'Standortleitung'];

const rollen = [
  { t: 'Therapeut:in an einem bestehenden Standort', d: 'Du behandelst in einer eingespielten Praxis. Nachfrage, Termine, Administration und Abrechnung laufen zentral.', href: '#bewerbung', cta: 'Bewerben' },
  { t: 'Senior / klinische Leitung', d: 'Für erfahrene Therapeut:innen, die Fälle besprechen, Kolleg:innen einarbeiten und Qualität mitverantworten wollen.', href: '#bewerbung', cta: 'Bewerben' },
  { t: 'Standortleitung', d: 'Du führst einen TCM.ch Standort: Team, Patientenerlebnis, Qualität und Auslastung. Eine Anstellung, keine Beteiligung.', href: B2B_LINKS.standortleitung, cta: 'Mehr zur Standortleitung' },
];

const ablauf = [
  { t: 'Bewerbung einreichen', d: 'Erfahrung, Ausbildung, Methoden, Sprachen, Standortwunsch, Anerkennungsstatus, Rolleninteresse.' },
  { t: 'Qualifikation & Anerkennung prüfen', d: 'Klinischer Hintergrund, EMR/ASCA/OdA/BAB/ZSR/Bewilligungssituation, fachlicher Fit.' },
  { t: 'Standort- und Rollenfit besprechen', d: 'Therapeut:in, Senior oder Standortleitung: welche Rolle passt, an welchem Standort?' },
  { t: 'Konkrete Perspektive', d: 'Bei Fit sprechen wir über Rolle, Pensum, Standort und Start. Ohne Garantie, aber ehrlich.' },
];

const fuerWen = ['TCM-Therapeut:innen', 'Akupunkteur:innen', 'Ärzt:innen mit TCM-Hintergrund', 'Tuina & medizinische Massage', 'Kräutermedizin', 'Internationale Fachpersonen', 'Physiotherapie & integrative Medizin', 'Klinikerfahrene Führungspersonen'];

const nichtFuerWen = [
  'Nicht für reine Nebenjob-Suchende.',
  'Nicht für Therapeut:innen, denen Patientenerfahrung, Dokumentation oder Qualität gleichgültig sind.',
  'Nicht für Erwartungen an garantiertes Einkommen, Visa oder Anerkennung.',
];

const anerkennungItems = ['EMR', 'ASCA', 'OdA AM', 'kantonale Berufsausübungsbewilligung (BAB)', 'ZSR', 'SRK wo relevant', 'Sprachkenntnisse', 'Aufenthalts- und Arbeitsbewilligung'];

const warum = ['Echter Klinikbetreiber statt Jobbörse', 'Patientennachfrage durch zentrales Marketing', 'Zentrale Website & Google-Sichtbarkeit', 'Strukturiertes Onboarding', 'Moderne Klinikstandards', 'Operative Unterstützung', 'Abrechnungs- und Administrations-Know-how', 'Verständnis für Anerkennung, Versicherung und Schweizer Klinikrealität', 'Weg von der Therapie über die Senior-Rolle bis zur Standortleitung'];

const methodenOpts = ['Akupunktur', 'Tuina', 'Kräuter', 'Schröpfen', 'Moxa', 'Physiotherapie', 'Massage', 'andere'];
const anerkennungOpts = ['EMR', 'ASCA', 'OdA AM', 'BAB', 'ZSR', 'SRK', 'noch keine', 'in Bearbeitung'];
const standortOpts = ['Zürich', 'Winterthur', 'Frauenfeld', 'Kreuzlingen', 'St. Gallen', 'Basel', 'Uster', 'Wil', 'andere'];

const faqs = [
  { q: 'Muss ich bereits EMR-anerkannt sein?', a: 'Nein, wir prüfen jeden Fall individuell, auch Anerkennungen, die noch in Bearbeitung sind.' },
  { q: 'Kann ich mich aus dem Ausland bewerben?', a: 'Ja, mit realistischer gemeinsamer Einschätzung, ohne Garantien.' },
  { q: 'Ist das eine normale Stellenbewerbung?', a: 'Es ist eine Bewerbung für eine Anstellung bei TCM.ch. Wir prüfen jede Einreichung persönlich, auch wenn gerade keine konkrete Stelle ausgeschrieben ist.' },
  { q: 'Ist die Standortleitung eine Beteiligung?', a: 'Nein. Die Standortleitung ist eine Anstellung bei TCM.ch, sofern keine separate individuelle Partnervereinbarung besteht.' },
  { q: 'Ich will eine eigene lokale Firma aufbauen. Bin ich hier richtig?', a: 'Dann passt eher das TCM.ch Partnermodell: eigene lokale Praxis, TCM.ch baut Nachfrage und System darum. Details unter tcm.ch/partner/.' },
  { q: 'Ich habe gerade abgeschlossen. Lohnt sich eine Bewerbung?', a: 'Ja. Für den Einstieg nach der Ausbildung gibt es eine eigene Übersicht unter tcm.ch/karriere/berufseinstieg/, und M7-Mentorat läuft über die Akademie.' },
  { q: 'Unterstützt TCM.ch bei BAB/EMR/ZSR?', a: 'Wir geben Orientierung, keine behördliche oder rechtliche Beratung.' },
  { q: 'Ist mein Profil kostenlos?', a: 'Ja, die Einreichung ist unverbindlich und kostenlos.' },
  { q: 'Gibt es garantierte Stellen?', a: 'Nein, jeder Fall wird individuell geprüft.' },
];

// WebPage + BreadcrumbList + FAQPage. Kein JobPosting: es gibt keine konkrete Einzelstelle
// mit Titel, Ort, Pensum und Publikationsdatum. Nie erfundene Stellenfakten.
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url, inLanguage: 'de-CH',
    audience: { '@type': 'Audience', audienceType: 'TCM therapists and medical professionals' },
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Karriere', item: url } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema} turnstile={true}>
  <!-- 1. HERO -->
  <section class="pt-hero" aria-label="Karriere bei TCM.ch">
    <img class="pt-hero-bg" src="/images/partner-hero.webp" alt="Team der TCM.ch Kliniken im Austausch" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" />
    <div class="pt-hero-overlay" aria-hidden="true"></div>
    <div class="wrap pt-hero-inner">
      <div class="pt-hero-text">
        <div class="eyebrow">TCM.ch · Karriere</div>
        <h1>Arbeiten und wachsen bei TCM.ch.</h1>
        <p class="lead">Für Therapeut:innen, die behandeln wollen – und für Menschen, die Verantwortung übernehmen möchten.</p>
        <div class="pt-cta-row">
          <a class="btn btn--primary" href="#bewerbung">Bewerbung starten</a>
          <a class="btn btn--ghost" href="#rollen">Rollen ansehen</a>
        </div>
        <ul class="pt-trust">{trust.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 2. AUSGANGSLAGE -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">TCM Jobs Schweiz</div>
      <p class="pt-body">Viele gute Therapeut:innen finden in der Schweiz kaum feste Stellen: Die meisten Praxen sind Einzelpraxen, die niemanden anstellen. Bei TCM.ch arbeitest du in einem Netzwerk echter Praxen. Patientengewinnung, Terminvergabe, Administration und Abrechnung laufen zentral, damit du dich auf die Behandlung konzentrieren kannst.</p>
      <div class="pt-solution">
        <strong>Anstellung statt Unternehmertum?</strong> Genau dafür ist diese Seite. Du willst eine eigene lokale Firma aufbauen? <a href={B2B_LINKS.partner}>Partner werden&nbsp;→</a>
      </div>
    </div>
  </section>

  <!-- 3. ROLLEN -->
  <section class="section" id="rollen" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Rollen</div>
      <h2 class="section-title">Drei Rollen bei TCM.ch</h2>
      <div class="pt-cards pt-cards-3">
        {rollen.map((m) => (
          <div class="pt-card">
            <h3>{m.t}</h3>
            <p>{m.d}</p>
            <a class="pt-card-link" href={m.href}>{m.cta}&nbsp;→</a>
          </div>
        ))}
      </div>
      <p class="pt-note">Konkrete Ausgestaltung je nach Qualifikation, Standort und Erfahrung. Du willst eine eigene lokale Firma aufbauen statt angestellt zu sein? <a href={B2B_LINKS.partner}>Partner werden</a>.</p>
    </div>
  </section>

  <!-- 4. ABLAUF -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Ablauf</div>
      <h2 class="section-title">In vier Schritten zum Fit</h2>
      <div class="pt-steps">
        {ablauf.map((s, i) => (
          <div class="pt-step">
            <div class="pt-step-num">{i + 1}</div>
            <div><div class="pt-step-t">{s.t}</div><p>{s.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. FÜR WEN -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Für wen</div>
      <h2 class="section-title">An wen sich das richtet</h2>
      <ul class="pt-pills">{fuerWen.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <!-- 6. NICHT FÜR WEN -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">Qualitätsfilter</div>
      <h2 class="section-title">An wen sich das nicht richtet</h2>
      <ul class="pt-x-list">{nichtFuerWen.map((w) => <li>{w}</li>)}</ul>
      <p class="pt-body">Wir suchen seriöse, verlässliche, klinisch starke Fachpersonen mit langfristiger Ambition.</p>
    </div>
  </section>

  <!-- 7. SCHWEIZER ANERKENNUNG -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap pt-narrow">
      <div class="section-label">Schweizer Anerkennung</div>
      <h2 class="section-title">Überblick (nicht-rechtlich)</h2>
      <ul class="pt-tags">{anerkennungItems.map((a) => <li>{a}</li>)}</ul>
      <p class="pt-hint">Hinweis: {LEGAL_NOTE}</p>
    </div>
  </section>

  <!-- 8. INTERNATIONALE FACHPERSONEN -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">International</div>
      <h2 class="section-title">Für internationale TCM-Fachpersonen mit Schweiz-Ambition</h2>
      <p class="pt-body">Die Schweiz kann attraktiv sein, der Weg ist aber komplex. Wir sind an qualifizierten internationalen Fachpersonen mit starker klinischer Erfahrung und langfristigem Engagement interessiert und prüfen gemeinsam, ob ein realistischer Weg in den Schweizer TCM-Markt besteht. Keine Visa-, Anerkennungs- oder Jobgarantie: Wir bieten Orientierung und eine realistische Einschätzung möglicher nächster Schritte.</p>
    </div>
  </section>

  <!-- 9. WARUM TCM.ch -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Warum TCM.ch</div>
      <h2 class="section-title">Was du bei uns findest</h2>
      <ul class="pt-check-list">{warum.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <!-- 9a. KARRIEREWEGE -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Karrierewege</div>
      <h2 class="section-title">Wo stehst du gerade?</h2>
      <div class="pt-cards pt-cards-4">
        <a class="pt-card pt-card--link" href={B2B_LINKS.berufseinstieg}><h3>Frisch abgeschlossen</h3><p>Vom Abschluss zur ersten Stelle: Mentorat, Anerkennung, erste klinische Verantwortung.</p><span class="pt-card-link">Berufseinstieg&nbsp;→</span></a>
        <a class="pt-card pt-card--link" href={B2B_LINKS.standortleitung}><h3>Führung übernehmen</h3><p>Einen TCM.ch Standort führen: Team, Qualität und Standortentwicklung.</p><span class="pt-card-link">Standortleitung&nbsp;→</span></a>
        <a class="pt-card pt-card--link" href={B2B_LINKS.akademie}><h3>Weiterlernen</h3><p>M7-Mentorat, Praktikum, Hospitation und praxisnahe Weiterbildung.</p><span class="pt-card-link">Akademie&nbsp;→</span></a>
        <a class="pt-card pt-card--link" href={B2B_LINKS.partner}><h3>Eigene Firma aufbauen</h3><p>Eigene lokale Praxis, TCM.ch baut Nachfrage und System darum.</p><span class="pt-card-link">Partner werden&nbsp;→</span></a>
      </div>
    </div>
  </section>

  <!-- BEWERBUNG (von /partner/ übernommen; API /api/partner, quelle=karriere) -->
  <section class="section" id="bewerbung">
    <div class="wrap pt-form-wrap">
      <div class="section-label">Bewerbung</div>
      <h2 class="section-title">Bewerbung unverbindlich starten</h2>
      <p class="pt-body" style="margin-bottom:24px">Kostenlos und unverbindlich. Wir prüfen dein Profil und melden uns mit einer realistischen Einschätzung.</p>

      <form class="form-card pt-form" id="pt-form" novalidate>
        <div class="hp" aria-hidden="true"><label>Dieses Feld leer lassen <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <input type="hidden" name="quelle" value="karriere" />

        <fieldset class="pt-fieldset">
          <legend>Persönlich</legend>
          <div class="form-row">
            <div class="field"><label for="name">Name <span class="req">*</span></label><input id="name" name="name" type="text" required autocomplete="name" /></div>
            <div class="field"><label for="email">E-Mail <span class="req">*</span></label><input id="email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="telefon">Telefon</label><input id="telefon" name="telefon" type="tel" autocomplete="tel" inputmode="tel" /></div>
            <div class="field"><label for="ort">Land / Stadt</label><input id="ort" name="ort" type="text" /></div>
          </div>
          <div class="field"><label for="sprachen">Sprachen</label><input id="sprachen" name="sprachen" type="text" placeholder="z. B. Deutsch, Englisch, Mandarin" /></div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Fachlich</legend>
          <div class="form-row">
            <div class="field"><label for="qualifikation">Hauptqualifikation</label><input id="qualifikation" name="qualifikation" type="text" placeholder="z. B. TCM-Therapeutin, Akupunkteur, Ärztin" /></div>
            <div class="field"><label for="erfahrung">Jahre Erfahrung</label><input id="erfahrung" name="erfahrung" type="text" inputmode="numeric" /></div>
          </div>
          <div class="field"><label>Methoden</label>
            <div class="pt-checks">{methodenOpts.map((m) => <label class="pt-check"><input type="checkbox" name="methoden" value={m} />{m}</label>)}</div></div>
          <div class="field"><label>Anerkennungsstatus</label>
            <div class="pt-checks">{anerkennungOpts.map((a) => <label class="pt-check"><input type="checkbox" name="anerkennung" value={a} />{a}</label>)}</div></div>
          <div class="form-row">
            <div class="field"><label for="bewilligung">Arbeitsbewilligung / Visa-Status</label><input id="bewilligung" name="bewilligung" type="text" /></div>
            <div class="field"><label for="anstellung">Aktuelle Anstellung / selbstständig</label><input id="anstellung" name="anstellung" type="text" /></div>
          </div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Standort & Rolle</legend>
          <div class="field"><label>Wunsch-Standorte</label>
            <div class="pt-checks">{standortOpts.map((s) => <label class="pt-check"><input type="checkbox" name="standorte" value={s} />{s}</label>)}</div></div>
          <div class="form-row">
            <div class="field"><label for="umzug">Umzugsbereitschaft</label><select id="umzug" name="umzug"><option value="">Bitte wählen</option><option>Ja</option><option>Nein</option></select></div>
            <div class="field"><label for="pensum">Wunschpensum %</label><input id="pensum" name="pensum" type="text" inputmode="numeric" placeholder="z. B. 80" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="start">Frühester Start</label><input id="start" name="start" type="text" placeholder="z. B. ab sofort, 01.2027" /></div>
            <div class="field"><label for="interesse">Interesse an</label>
              <select id="interesse" name="interesse">
                <option value="">Bitte wählen</option>
                <option>Anstellung</option><option>Senior</option><option>Standortleitung</option>
                <option>Neuen Standort mitaufbauen</option><option>Noch unsicher</option>
              </select></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="patienten">Bestehende Patienten / lokales Netzwerk</label><select id="patienten" name="patienten"><option value="">Bitte wählen</option><option>Ja</option><option>Nein</option></select></div>
            <div class="field"><label for="fuehrung">Erfahrung Klinik-/Teamführung</label><select id="fuehrung" name="fuehrung"><option value="">Bitte wählen</option><option>Ja</option><option>Nein</option></select></div>
          </div>
          <div class="field"><label for="stadt">Stärkste Stadt + Begründung</label><textarea id="stadt" name="stadt" placeholder="In welcher Stadt bist du am stärksten, und warum?"></textarea></div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Dokumente <span class="opt">(optional)</span></legend>
          <label class="pt-upload" for="files">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span><strong>CV, Diplome, Anerkennungsdokumente hochladen</strong><br />PDF, JPG oder PNG · max. 10 MB gesamt</span>
            <input id="files" name="files" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" multiple />
          </label>
          <ul class="pt-filelist" id="pt-filelist" hidden></ul>
          <div class="pt-fileerr" id="pt-fileerr" role="alert" hidden></div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Motivation</legend>
          <div class="field"><label for="motivation">Warum TCM.ch? Welche Rolle passt zu dir, und warum?</label><textarea id="motivation" name="motivation" rows="4"></textarea></div>
        </fieldset>

        <div class="cf-turnstile" data-sitekey={site.turnstileSitekey} style="margin:4px 0 14px"></div>
        <button class="btn btn--primary" type="submit"><span class="btn-label">Bewerbung unverbindlich starten</span></button>
        <div class="form-status" role="status" aria-live="polite" hidden></div>
        <p class="pt-privacy">Übermittlung verschlüsselt und vertraulich. Deine Angaben werden ausschliesslich zur Prüfung deines Profils verwendet. <a href="/datenschutz/">Datenschutz</a>.</p>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap pt-narrow">
      <div class="section-label">FAQ</div>
      <h2 class="section-title">Häufige Fragen</h2>
      <div class="pt-faq">
        {faqs.map((f) => (
          <details class="pt-faq-item">
            <summary>{f.q}</summary>
            <div class="pt-faq-a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Rücklinks ins OUCH.-Magazin (ouch.tcm.ch) - dezenter Magazin-Block am Seitenende -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:820px">
      <div style="border-top:1px solid var(--border);padding-top:24px">
        <div style="font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#8a919c;margin-bottom:10px">Aus dem Magazin.</div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <a href="https://ouch.tcm.ch/insights/m7-mentorat-tcm/" style="display:inline-flex;align-items:center;gap:7px;font-size:15.5px;font-weight:600;color:var(--blue);text-decoration:none">Was unser Mentorat wirklich beinhaltet: M7, ehrlich erklärt<span aria-hidden="true">→</span></a>
          <a href="https://ouch.tcm.ch/insights/tcm-jobs-schweiz/" style="display:inline-flex;align-items:center;gap:7px;font-size:15.5px;font-weight:600;color:var(--blue);text-decoration:none">Warum es in dieser Branche kaum Stellen gibt. Und bei uns schon.<span aria-hidden="true">→</span></a>
          <a href="https://ouch.tcm.ch/insights/tcm-ausbildung-lohnt-sich/" style="display:inline-flex;align-items:center;gap:7px;font-size:15.5px;font-weight:600;color:var(--blue);text-decoration:none">Die ehrliche Kostenrechnung zur Ausbildung<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var MAX_TOTAL = 10 * 1024 * 1024;
      var OK_EXT = /\.(pdf|jpe?g|png)$/i;
      var form = document.getElementById('pt-form');
      if (!form) return;
      var input = document.getElementById('files');
      var listEl = document.getElementById('pt-filelist');
      var errEl = document.getElementById('pt-fileerr');
      var status = form.querySelector('.form-status');
      var label = form.querySelector('.btn-label');
      function fmt(b) { return b < 1048576 ? Math.round(b / 1024) + ' KB' : (b / 1048576).toFixed(1) + ' MB'; }
      function showErr(msg) { errEl.hidden = !msg; errEl.textContent = msg || ''; }
      function show(state, msg) { status.hidden = false; status.setAttribute('data-state', state); status.textContent = msg; }
      function validateFiles() {
        var files = input.files ? Array.prototype.slice.call(input.files) : [];
        listEl.innerHTML = ''; listEl.hidden = files.length === 0;
        var total = 0, bad = '';
        files.forEach(function (f) {
          total += f.size;
          var typeOk = OK_EXT.test(f.name) || ['application/pdf', 'image/jpeg', 'image/png'].indexOf(f.type) !== -1;
          if (!typeOk) bad = 'Nicht unterstützter Dateityp: ' + f.name + ' (nur PDF, JPG, PNG).';
          var li = document.createElement('li'); li.textContent = f.name + ' · ' + fmt(f.size); listEl.appendChild(li);
        });
        if (bad) { showErr(bad); return false; }
        if (files.length > 8) { showErr('Maximal 8 Dateien.'); return false; }
        if (total > MAX_TOTAL) { showErr('Dateien zusammen zu gross (' + fmt(total) + '). Maximal 10 MB.'); return false; }
        showErr(''); return true;
      }
      input.addEventListener('change', validateFiles);
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (form.querySelector('[name="website"]').value.trim() !== '') return;
        if (!form.checkValidity()) { form.reportValidity(); return; }
        if (!validateFiles()) return;
        var tokenEl = form.querySelector('[name="cf-turnstile-response"]');
        var token = tokenEl && tokenEl.value ? tokenEl.value : '';
        if (!token) { show('error', 'Bitte bestätige kurz, dass du kein Roboter bist, und versuche es erneut.'); return; }
        var fd = new FormData(form); fd.set('turnstileToken', token);
        form.classList.add('is-sending');
        if (label) { label.dataset.orig = label.textContent; label.textContent = 'Wird gesendet…'; }
        try {
          var res = await fetch('/api/partner', { method: 'POST', body: fd });
          var data = null; try { data = await res.json(); } catch (_) {}
          if (res.ok && data && data.ok) {
            form.reset(); listEl.hidden = true; listEl.innerHTML = ''; showErr('');
            show('success', 'Danke. Deine Bewerbung ist eingegangen. Wir melden uns mit einer realistischen Einschätzung möglicher nächster Schritte.');
            form.querySelectorAll('input,select,textarea,button').forEach(function (el) { el.disabled = true; });
          } else {
            var map = { missing_fields: 'Bitte fülle Name und E-Mail aus.', too_large: 'Dateien zusammen zu gross (max. 10 MB).', bad_file_type: 'Nicht unterstützter Dateityp (nur PDF, JPG, PNG).', too_many_files: 'Maximal 8 Dateien.', turnstile_failed: 'Sicherheitsprüfung fehlgeschlagen. Bitte erneut versuchen.' };
            show('error', map[data && data.error] || 'Profil konnte nicht gesendet werden. Bitte erneut versuchen.');
          }
        } catch (err) { show('error', 'Verbindungsfehler. Bitte erneut versuchen.'); }
        finally {
          form.classList.remove('is-sending');
          if (label && label.dataset.orig) label.textContent = label.dataset.orig;
          if (window.turnstile) { try { window.turnstile.reset(); } catch (_) {} }
        }
      });
    })();
  </script>
