---
// /haut — Sektions-Startseite «Haut & Gesicht».
// Zwei Aufgaben: die buchbaren Behandlungen sichtbar machen und den Artikel-Cluster
// bündeln. Artikel kommen aus src/data/haut.ts, neue Einträge erscheinen automatisch.
import LayoutDe from '../../layouts/LayoutDe.astro';
import { haut } from '../../data/haut';

const path = '/haut';
const title = 'Haut & Gesicht – Behandlungen und Wirkstoffe ehrlich erklärt | TCM.ch';
const description = 'Gesichtsbehandlungen, Wirkstoffe und Hautthemen, fachlich eingeordnet von TCM.ch. Ohne Versprechen, die niemand halten kann.';

// Buchbare Behandlungen — die eigentlichen Zielseiten des Clusters.
const WA = 'https://wa.me/41775236122';

const behandlungen = [
  {
    href: '/therapien/gesichtsakupunktur/',
    name: 'Gesichtsakupunktur',
    dauer: '40–50 Min',
    preis: 'CHF 140–180',
    kasse: 'Zusatzversicherung 80–100 % bei medizinischer Indikation',
    text: 'Feine Nadeln an gezielten Punkten im Gesicht und am Körper. Die medizinisch indizierte Behandlung für Hautbild und Spannung.',
    fuer: ['Müdes, unruhiges Hautbild', 'Rötungsneigung', 'Stressbedingte Hautthemen', 'Mimische Dauerspannung'],
    serie: '6–10 Sitzungen empfohlen',
  },
  {
    href: '/therapien/hanbang/',
    name: 'Hanbang',
    dauer: '75 Min',
    preis: 'ab CHF 240',
    kasse: 'Selbstzahler-Leistung, keine Kassenübernahme',
    text: 'Die koreanische Gesichtsbehandlung: Gesichtsakupunktur und Gua-Sha-Massage in einer Sitzung, in dieser Reihenfolge. Zwei Methoden, die aufeinander aufbauen.',
    fuer: ['Wer die Gesichtsakupunktur kennt und mehr möchte', 'Trockene, müde oder unruhige Haut', 'Vor einem Anlass', 'Fester Rhythmus statt Einzeltermin'],
    serie: '6er-Kurs empfohlen',
    neu: true,
  },
  {
    href: '/therapien/gua-sha/gesichts-gua-sha/',
    name: 'Gua Sha fürs Gesicht',
    dauer: '30 Min',
    preis: 'kosmetisch',
    kasse: 'Selbstzahler-Leistung',
    text: 'Ruhige Züge mit dem Stein entlang von Lymphbahnen und Kiefer. Entstauend, entspannend, ohne Nadeln. Danach kannst du es zu Hause selbst.',
    fuer: ['Schwellungsgefühl am Morgen', 'Kieferspannung, Zähneknirschen', 'Augenringe (vaskulär)', 'Einmal richtig zeigen lassen'],
    serie: 'Einzeln oder alle 2–4 Wochen',
  },
];

// Zuordnung Thema -> Behandlung. Auch die Zeilen, wo wir NICHT die Antwort sind.
const zuordnung = [
  { thema: 'Schwellungsgefühl, Kieferspannung', href: '/therapien/gua-sha/gesichts-gua-sha/', ziel: 'Gua Sha fürs Gesicht', bei: true },
  { thema: 'Müdes Hautbild, Rötungsneigung, Stress', href: '/therapien/gesichtsakupunktur/', ziel: 'Gesichtsakupunktur', bei: true },
  { thema: 'Koreanische Kombibehandlung', href: '/therapien/hanbang/', ziel: 'Hanbang, 75 Minuten', bei: true },
  { thema: 'Augenringe, vaskulärer Typ', href: '/haut/augenringe/', ziel: 'Erst Typ bestimmen, dann Gua Sha', bei: true },
  { thema: 'Pigmentflecken, Melasma', href: '/haut/pigmentflecken/', ziel: 'Dermatologisch abklären — wir ordnen ein', bei: false },
  { thema: 'Sichtbare Äderchen (Couperose)', href: '/haut/couperose/', ziel: 'Gefässlaser, nicht bei uns', bei: false },
  { thema: 'Aknenarben, Hautstruktur', href: '/haut/microneedling/', ziel: 'Microneedling, nicht bei uns', bei: false },
  { thema: 'Falten, Volumen, Kontur', href: '/haut/falten-gesicht/', ziel: 'Ärztliche Verfahren, nicht bei uns', bei: false },
];

// Artikel nach Kategorie gruppieren
const REIHENFOLGE = ['Wirkstoffe', 'Methoden', 'Hautthemen', 'K-Beauty'];
const gruppen = REIHENFOLGE
  .map((cat) => ({ cat, items: haut.filter((a) => a.category === cat) }))
  .filter((g) => g.items.length > 0);
const rest = haut.filter((a) => !REIHENFOLGE.includes(a.category));
if (rest.length) gruppen.push({ cat: 'Weitere Themen', items: rest });

// Einleitungstexte pro Gruppe
const INTRO: Record<string, string> = {
  'Wirkstoffe': 'Was tatsächlich in den Produkten steckt, welche Konzentration untersucht ist und womit sich was kombinieren lässt.',
  'Methoden': 'Apparative und injizierbare Verfahren, sachlich erklärt — auch die, die wir selbst nicht anbieten.',
  'Hautthemen': 'Von Pigmentflecken bis Couperose: erst die Form bestimmen, dann behandeln.',
  'K-Beauty': 'Koreanische Hautpflege stammt aus derselben Tradition, mit der wir arbeiten. Was daran Methode ist und was Marketing.',
};

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
    url: 'https://tcm.ch/haut/', inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Haut & Gesicht', item: 'https://tcm.ch/haut/' },
    ],
  },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema} ogImage="https://tcm.ch/images/haut-hero.webp">
  <div class="haut-scope">

    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-text">
            <div class="eyebrow">Haut &amp; Gesicht</div>
            <h1>Was der Haut wirklich hilft, und was nur auf der Verpackung steht.</h1>
            <p class="lead">Wirkstoffe, Methoden und Behandlungen rund ums Gesicht, eingeordnet von TCM.ch. Wir schreiben auch dann ehrlich, wenn die Antwort «bringt wenig» lautet.</p>
            <div class="cta-row">
              <a class="btn btn--primary" href={WA} target="_blank" rel="noopener">Per WhatsApp fragen</a>
              <a class="btn btn--ghost" href="#behandlungen">Behandlungen ansehen</a>
            </div>
            <p class="cta-note">Kostenlos und unverbindlich. Wir sagen dir auch, wenn eine Behandlung bei uns nicht das Richtige ist.</p>
          </div>
          <div class="hero-img">
            <img src="/images/haut-hero.webp" width="1536" height="1024" alt="Frau bei einer Gesichtsbehandlung, ruhig liegend im Tageslicht" loading="eager" fetchpriority="high" decoding="async">
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="behandlungen">
      <div class="wrap">
        <div class="sec-label">Das bieten wir an</div>
        <p class="sec-intro">Zwei Gesichtsbehandlungen, beide an unseren Standorten in der Deutschschweiz. Alles andere auf dieser Seite ist Einordnung, kein Angebot.</p>
        <div class="treat-grid">
          {behandlungen.map((b) => (
            <div class="treat">
              <div class="t-head">
                <div class="t-name">{b.name}{b.neu && <span class="t-badge">Neu</span>}</div>
                <div class="t-meta">{b.dauer} · {b.preis}</div>
              </div>
              <p class="t-text">{b.text}</p>
              <ul class="t-fuer">
                {b.fuer.map((f) => <li>{f}</li>)}
              </ul>
              <div class="t-serie">{b.serie}</div>
              <div class="t-kasse">{b.kasse}</div>
              <div class="t-cta">
                <a class="btn btn--primary" href={b.href}>Details ansehen</a>
                <a class="btn btn--ghost" href={WA} target="_blank" rel="noopener">Termin per WhatsApp</a>
              </div>
            </div>
          ))}
        </div>

        <div class="matcher">
          <div class="m-label">Welche Behandlung passt zu welchem Thema?</div>
          <div class="m-rows">
            {zuordnung.map((z) => (
              <a class={z.bei ? 'm-row is-us' : 'm-row'} href={z.href}>
                <span class="m-thema">{z.thema}</span>
                <span class="m-ziel">{z.ziel}</span>
              </a>
            ))}
          </div>
          <p class="m-note">Bei den grau markierten Themen sind wir nicht die richtige Adresse. Wir sagen dir trotzdem, was wir wissen — die Artikel dahinter ordnen ein, wohin du gehörst.</p>
        </div>
        <figure class="band">
          <img src="/images/haut-raum.webp" width="1536" height="1024" alt="Heller Behandlungsraum mit Liege, Tageslicht und beleuchteter Wandnische" loading="lazy" decoding="async">
          <figcaption>Behandelt wird in ruhigen, hellen Räumen an unseren Standorten in der Deutschschweiz.</figcaption>
        </figure>
      </div>
    </section>

    {gruppen.map((g, i) => (
      <>
        {g.cat === 'K-Beauty' && (
          <section class="section sec-tight">
            <div class="wrap">
              <figure class="band craft">
                <div class="craft-imgs">
                  <img src="/images/haut-najeon.webp" width="1400" height="933" alt="Perlmutt wird von Hand in schwarzen Lack eingelegt, koreanische Najeon-Technik" loading="lazy" decoding="async">
                  <img src="/images/haut-lackdose.webp" width="1400" height="933" alt="Fertige koreanische Lackdose mit Perlmutteinlage" loading="lazy" decoding="async">
                </div>
                <figcaption><strong>Najeon chilgi</strong> — Perlmutt in Lack, Koreas höchste Handwerkskunst. Dreissig Schichten, von Hand poliert, Monate Arbeit für ein Stück. Dieselbe Geduld steckt hinter der koreanischen Hautpflege: nicht die einzelne Anwendung zählt, sondern was sich über Monate aufbaut. Und dieselbe Tradition — Hanbang ist die Schwesterdisziplin der chinesischen Medizin, mit der wir arbeiten.</figcaption>
              </figure>
            </div>
          </section>
        )}
        {g.cat === 'Hautthemen' && (
          <section class="section sec-tight">
            <div class="wrap">
              <figure class="band band-skin">
                <img src="/images/haut-textur.webp" width="1600" height="700" alt="Nahaufnahme der Gesichtshaut an Schläfe und Augenbraue" loading="lazy" decoding="async">
                <figcaption>Hautbild vor Behandlung: Wir schauen zuerst auf Textur, Rötung und Pigment — erst danach entscheidet sich, was überhaupt sinnvoll ist.</figcaption>
              </figure>
            </div>
          </section>
        )}
        <section class="section sec-tight">
          <div class="wrap">
            <div class="sec-label">{g.cat}</div>
            {INTRO[g.cat] && <p class="sec-intro">{INTRO[g.cat]}</p>}
            <div class="art-grid">
              {g.items.map((a) => (
                <a class="art" href={`/haut/${a.slug}/`}>
                  <div class="a-cat">{a.category}</div>
                  <h3 class="a-title">{a.title}</h3>
                  <p class="a-excerpt">{a.excerpt}</p>
                  <div class="a-meta">{a.readingTime} Lesezeit</div>
                </a>
              ))}
            </div>
          </div>
        </section>
      </>
    ))}

    <section class="section">
      <div class="wrap">
        <div class="closing">
          <div class="closing-img">
            <img src="/images/haut-perlmutt.webp" width="1536" height="1024" alt="Perlmutt, das Licht in Schichten zurückwirft" loading="lazy" decoding="async">
          </div>
          <div class="closing-text">
            <h2>Unsicher, was zu deiner Haut passt?</h2>
            <p>Schildere uns kurz, worum es geht. Wir sagen dir ehrlich, ob eine Behandlung sinnvoll ist, und wann du besser dermatologisch abklären lässt.</p>
            <div class="cta-row">
              <a class="btn btn--primary" href={WA} target="_blank" rel="noopener">Per WhatsApp fragen</a>
              <a class="btn btn--ghost" href="/standorte/">Standort finden</a>
            </div>
            <p class="cta-note">Antwort meist in wenigen Minuten. Oder <a href="/kontakt/">per Formular</a>.</p>
          </div>
        </div>
      </div>
    </section>

  </div>
</LayoutDe>

<style>
  .haut-scope {
    --h-bronze: #A8916A;
    --h-bronze-dk: #7A663F;
    --h-porcelain: #F6F2EA;
    --h-line: #E2D9C9;
  }

  /* ---------- Hero ---------- */
  .hero { background: var(--h-porcelain); padding: 56px 0; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .hero-img img { width: 100%; height: auto; display: block; border-radius: var(--r-card); }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--h-bronze-dk); margin-bottom: 14px; }
  h1 { font-size: clamp(29px, 4.2vw, 44px); line-height: 1.1; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 18px; }
  .hero .lead { font-size: 18px; line-height: 1.55; color: var(--mid); margin: 0; }

  /* ---------- Abschnitte ---------- */
  .sec-tight { padding-top: 0; }
  .sec-label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--h-bronze-dk); margin-bottom: 10px; }
  .sec-intro { font-size: 16px; line-height: 1.55; color: var(--mid); max-width: 62ch; margin: 0 0 20px; }

  /* ---------- Bildbänder ---------- */
  .band { margin: 40px 0 0; }
  .band img { width: 100%; height: auto; display: block; border-radius: var(--r-card); aspect-ratio: 16 / 7; object-fit: cover; object-position: center; }
  .band-skin { margin-top: 8px; }
  .band-skin img { aspect-ratio: 21 / 8; object-position: center 45%; }
  .band figcaption { font-size: 14px; color: var(--muted); margin-top: 12px; max-width: 68ch; }
  .band.craft { margin: 0 0 34px; }
  .craft-imgs { display: grid; grid-template-columns: 1.25fr 1fr; gap: 14px; }
  .craft-imgs img { width: 100%; height: 100%; display: block; border-radius: var(--r-card); aspect-ratio: 3 / 2; object-fit: cover; }
  .band.craft figcaption { margin-top: 14px; max-width: 76ch; font-size: 15px; line-height: 1.6; }
  .band.craft figcaption strong { color: var(--h-bronze-dk); }

  /* ---------- CTA ---------- */
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .cta-note { font-size: 13.5px; color: var(--muted); margin: 12px 0 0; max-width: 52ch; }
  .cta-note a { color: var(--h-bronze-dk); }

  /* ---------- Behandlungen ---------- */
  .treat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: stretch; }
  .treat { display: flex; flex-direction: column; border: 1px solid var(--h-line); border-radius: var(--r-card); padding: 26px; background: #fff; transition: border-color var(--t-fast) ease; }
  .treat:hover { border-color: var(--h-bronze); }
  .t-head { margin-bottom: 12px; }
  .t-name { font-size: 20px; font-weight: 800; color: var(--ink); display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .t-badge { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #fff; background: var(--h-bronze-dk); padding: 3px 8px; border-radius: 3px; }
  .t-meta { font-size: 13px; font-weight: 600; color: var(--h-bronze-dk); margin-top: 4px; }
  .t-text { font-size: 15.5px; line-height: 1.55; color: var(--mid); margin: 0 0 14px; }
  .t-fuer { list-style: none; padding: 0; margin: 0 0 14px; }
  .t-fuer li { font-size: 14px; line-height: 1.45; color: var(--mid); padding-left: 18px; position: relative; margin-bottom: 6px; }
  .t-fuer li::before { content: '·'; position: absolute; left: 5px; color: var(--h-bronze); font-weight: 700; }
  .t-serie { font-size: 13px; font-weight: 600; color: var(--h-bronze-dk); margin-bottom: 10px; }
  .t-kasse { font-size: 12.5px; color: var(--muted); border-top: 1px solid var(--h-line); padding-top: 10px; margin-bottom: 16px; }
  .t-cta { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
  .t-cta .btn { width: 100%; justify-content: center; }

  /* ---------- Zuordnung ---------- */
  .matcher { margin-top: 40px; border: 1px solid var(--h-line); border-radius: var(--r-card); padding: clamp(22px, 3vw, 32px); background: var(--h-porcelain); }
  .m-label { font-size: 17px; font-weight: 800; color: var(--ink); margin-bottom: 16px; }
  .m-rows { display: flex; flex-direction: column; border-top: 1px solid var(--h-line); }
  .m-row { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: baseline; padding: 13px 0; border-bottom: 1px solid var(--h-line); text-decoration: none; transition: padding-left var(--t-fast) ease; }
  .m-row:hover { padding-left: 6px; }
  .m-thema { font-size: 15.5px; color: var(--ink); font-weight: 600; }
  .m-ziel { font-size: 14px; color: var(--muted); text-align: right; }
  .m-row.is-us .m-ziel { color: var(--h-bronze-dk); font-weight: 600; }
  .m-note { font-size: 13.5px; line-height: 1.55; color: var(--muted); margin: 16px 0 0; max-width: 74ch; }

  /* ---------- Artikel ---------- */
  .art-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .art { display: block; border: 1px solid var(--h-line); border-radius: var(--r-card); padding: 22px; text-decoration: none; transition: border-color var(--t-fast) ease; }
  .art:hover { border-color: var(--h-bronze); }
  .a-cat { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--h-bronze-dk); margin-bottom: 8px; }
  .a-title { font-size: 17px; font-weight: 800; color: var(--ink); line-height: 1.28; margin: 0 0 8px; }
  .a-excerpt { font-size: 14.5px; line-height: 1.55; color: var(--mid); margin: 0 0 12px; }
  .a-meta { font-size: 12.5px; color: var(--muted); }

  /* ---------- Abschluss ---------- */
  .closing { background: var(--h-porcelain); border: 1px solid var(--h-line); border-radius: var(--r-card); overflow: hidden; display: grid; grid-template-columns: 1fr 1.1fr; align-items: stretch; }
  .closing-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .closing-text { padding: clamp(26px, 4vw, 44px); }
  .closing h2 { font-size: 25px; font-weight: 800; color: var(--ink); margin: 0 0 8px; letter-spacing: var(--tracking-heading); }
  .closing p { font-size: 16px; color: var(--mid); margin: 0 0 18px; max-width: 52ch; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-img { order: -1; }
    .craft-imgs { grid-template-columns: 1fr; }
    .closing { grid-template-columns: 1fr; }
    .closing-img img { aspect-ratio: 16 / 7; height: auto; }
  }
  @media (max-width: 980px) { .treat-grid { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .art-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .m-row { grid-template-columns: 1fr; gap: 3px; } .m-ziel { text-align: left; } }
  @media (max-width: 640px) {
    .art-grid { grid-template-columns: 1fr; }
    .hero { padding: 36px 0; }
  }
</style>
