---
// /haut — Sektions-Startseite «Haut & Gesicht».
// Zwei Aufgaben: die buchbaren Behandlungen sichtbar machen und den Artikel-Cluster
// bündeln. Artikel kommen aus src/data/haut.ts, neue Einträge erscheinen automatisch.
import LayoutDe from '../../layouts/LayoutDe.astro';
import { haut } from '../../data/haut';

const path = '/haut';
const title = 'Haut & Gesicht – Behandlungen und Wirkstoffe ehrlich erklärt | TCM.ch';
const description = 'Gesichtsbehandlungen, Wirkstoffe und Hautthemen, fachlich eingeordnet von unseren TCM-Therapeutinnen. Ohne Versprechen, die niemand halten kann.';

// Buchbare Behandlungen — die eigentlichen Zielseiten des Clusters.
const behandlungen = [
  {
    href: '/therapien/gesichtsakupunktur/',
    name: 'Gesichtsakupunktur',
    meta: '40–50 Min · CHF 140–180',
    kasse: 'Zusatzversicherung 80–100 % bei medizinischer Indikation',
    text: 'Feine Nadeln an gezielten Punkten im Gesicht und am Körper. Die medizinisch indizierte Behandlung für Hautbild und Spannung.',
  },
  {
    href: '/therapien/gua-sha/gesichts-gua-sha/',
    name: 'Gua Sha fürs Gesicht',
    meta: '30 Min · kosmetisch',
    kasse: 'Selbstzahler-Leistung',
    text: 'Ruhige Züge mit dem Stein entlang von Lymphbahnen und Kiefer. Entstauend, entspannend, ohne Nadeln.',
  },
];

// Artikel nach Kategorie gruppieren
const REIHENFOLGE = ['Wirkstoffe', 'Methoden', 'Hautthemen', 'K-Beauty'];
const gruppen = REIHENFOLGE
  .map((cat) => ({ cat, items: haut.filter((a) => a.category === cat) }))
  .filter((g) => g.items.length > 0);
const rest = haut.filter((a) => !REIHENFOLGE.includes(a.category));
if (rest.length) gruppen.push({ cat: 'Weitere Themen', items: rest });

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
    url: 'https://tcm.ch/haut/', inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Haut & Gesicht', item: 'https://tcm.ch/haut/' },
    ],
  },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <div class="haut-scope">

    <section class="hero">
      <div class="wrap">
        <div class="eyebrow">Haut &amp; Gesicht</div>
        <h1>Was der Haut wirklich hilft, und was nur auf der Verpackung steht.</h1>
        <p class="lead">Wirkstoffe, Methoden und Behandlungen rund ums Gesicht, eingeordnet von unseren TCM-Therapeutinnen. Wir schreiben auch dann ehrlich, wenn die Antwort «bringt wenig» lautet.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="sec-label">Behandlungen bei uns</div>
        <div class="treat-grid">
          {behandlungen.map((b) => (
            <a class="treat" href={b.href}>
              <div class="t-name">{b.name}</div>
              <div class="t-meta">{b.meta}</div>
              <p class="t-text">{b.text}</p>
              <div class="t-kasse">{b.kasse}</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {gruppen.map((g) => (
      <section class="section sec-tight">
        <div class="wrap">
          <div class="sec-label">{g.cat}</div>
          <div class="art-grid">
            {g.items.map((a) => (
              <a class="art" href={`/haut/${a.slug}/`}>
                <div class="a-cat">{a.category}</div>
                <h3 class="a-title">{a.title}</h3>
                <p class="a-excerpt">{a.excerpt}</p>
                <div class="a-meta">{a.readingTime} Lesezeit</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="section">
      <div class="wrap">
        <div class="closing">
          <h2>Unsicher, was zu deiner Haut passt?</h2>
          <p>Schildere uns kurz, worum es geht. Wir sagen dir ehrlich, ob eine Behandlung sinnvoll ist, und wann du besser dermatologisch abklären lässt.</p>
          <div class="cta-row">
            <a class="btn btn--primary" href="/kontakt/">Termin anfragen</a>
            <a class="btn btn--ghost" href="/standorte/">Standort finden</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</LayoutDe>

<style>
  .haut-scope {
    --h-bronze: #A8916A;
    --h-bronze-dk: #7A663F;
    --h-porcelain: #F6F2EA;
    --h-line: #E2D9C9;
  }

  .hero { background: var(--h-porcelain); padding: 64px 0 56px; }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--h-bronze-dk); margin-bottom: 14px; }
  h1 { font-size: clamp(30px, 4.6vw, 46px); line-height: 1.1; letter-spacing: var(--tracking-heading); color: var(--ink); margin: 0 0 18px; max-width: 20ch; }
  .hero .lead { font-size: 18.5px; line-height: 1.55; color: var(--mid); max-width: 62ch; margin: 0; }

  .sec-tight { padding-top: 0; }
  .sec-label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--h-bronze-dk); margin-bottom: 18px; }

  .treat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .treat { display: block; border: 1px solid var(--h-line); border-radius: var(--r-card); padding: 26px; text-decoration: none; background: #fff; transition: border-color var(--t-fast) ease; }
  .treat:hover { border-color: var(--h-bronze); }
  .t-name { font-size: 20px; font-weight: 800; color: var(--ink); }
  .t-meta { font-size: 13px; font-weight: 600; color: var(--h-bronze-dk); margin: 4px 0 12px; }
  .t-text { font-size: 15.5px; line-height: 1.55; color: var(--mid); margin: 0 0 14px; }
  .t-kasse { font-size: 12.5px; color: var(--muted); border-top: 1px solid var(--h-line); padding-top: 10px; }

  .art-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .art { display: block; border: 1px solid var(--h-line); border-radius: var(--r-card); padding: 22px; text-decoration: none; transition: border-color var(--t-fast) ease; }
  .art:hover { border-color: var(--h-bronze); }
  .a-cat { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--h-bronze-dk); margin-bottom: 8px; }
  .a-title { font-size: 17px; font-weight: 800; color: var(--ink); line-height: 1.28; margin: 0 0 8px; }
  .a-excerpt { font-size: 14.5px; line-height: 1.55; color: var(--mid); margin: 0 0 12px; }
  .a-meta { font-size: 12.5px; color: var(--muted); }

  .closing { background: var(--h-porcelain); border: 1px solid var(--h-line); border-radius: var(--r-card); padding: 34px; }
  .closing h2 { font-size: 25px; font-weight: 800; color: var(--ink); margin: 0 0 8px; letter-spacing: var(--tracking-heading); }
  .closing p { font-size: 16px; color: var(--mid); margin: 0 0 18px; max-width: 60ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 860px) { .art-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .treat-grid, .art-grid { grid-template-columns: 1fr; }
    .hero { padding: 44px 0 36px; }
  }
</style>
