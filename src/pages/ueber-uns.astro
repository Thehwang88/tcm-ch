---
// /ueber-uns — faithful 1:1 reproduction of the live SPA #page-ueber-uns
// ("Über uns – Unsere Geschichte"). Linked from the burger.
import SpaPage from '../layouts/SpaPage.astro';
import body from '../data/ueber-uns-body.html?raw';
const title = 'Über uns – Unsere Geschichte | TCM.ch';
const description = 'Wer wir sind, woran wir glauben, und warum wir medizinische TCM in der Schweiz neu denken. Die Geschichte hinter dem TCM.ch Netzwerk.';
const schema = { '@context': 'https://schema.org', '@type': 'AboutPage', name: title, url: 'https://tcm.ch/ueber-uns/', inLanguage: 'de-CH', isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } };
---
<SpaPage title={title} description={description} path="/ueber-uns" body={body} schema={schema} />
