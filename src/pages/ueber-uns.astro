---
// /ueber-uns: patient-first CRO layout, preserving existing imagery, therapist
// registry, founder story and optional behind-the-scenes content.
// All appointment requests use existing /kontakt/ and clinic routes.
import SpaPage from '../layouts/SpaPage.astro';
import rawBody from '../data/ueber-uns-body.html?raw';
import homeBody from '../data/home-body.html?raw';
import { teamGridHtml } from '../data/therapeuten';
import { upgradeLegacyForms } from '../lib/kontakt-form';

const between = (start: string, end: string) => {
  const a = rawBody.indexOf(start), b = rawBody.indexOf(end);
  if (a < 0 || b <= a) throw new Error('Über-uns page section missing: ' + start);
  return rawBody.slice(a, b);
};

// Preserve the original video/photo while cutting duplicated copy, navigation
// and corporate essays; keep the patient journey focused on people and contact.
let intro = rawBody.slice(0, rawBody.indexOf('<div class="uu-press">'));
if (!intro.includes('<div style="margin-top:20px;max-width:760px">')) throw new Error('Über-uns intro marker changed');
intro = intro.slice(0, intro.indexOf('<div style="margin-top:20px;max-width:760px">'))
  + '</div></div>';
intro = intro
  .replace('Ein junges Team. Eine klare Mission.<br><em>TCM, wie sie sein sollte.</em>', 'Persönliche TCM.<br><em>Echte Menschen.</em>')
  .replace('<p class="sub-desc">Wer wir sind, woran wir glauben, und warum wir TCM in der Schweiz neu denken.</p>',
    '<p class="sub-desc">Lerne unser Team kennen und finde die passende Praxis.</p>'
    + '<div class="uu-cro-actions"><a class="uu-cro-btn uu-cro-btn--primary" href="/kontakt/?von=/ueber-uns/">Termin anfragen <span aria-hidden="true">→</span></a><a class="uu-cro-btn uu-cro-btn--secondary" href="/standorte/">Standort finden</a></div>')
  .replace('alt="Das TCM.ch Team – EMR/ASCA-registrierte Therapeut:innen"', 'alt="Einblicke in das TCM.ch Team"')
  .replace(/<button class="back-btn"[^>]*>[\s\S]*?<\/button>/, '');

const teamSource = between('<section class="section team-section" id="ueber-uns-team"', '<section class="bts-section"');
// Restore the complete original team grid, open and fully visible (no details).
// Cards still come from the canonical therapist registry.
const team = teamSource
  .replace('Anerkannte Fachpersonen. <em>Echte Menschen.</em>', 'Lerne unser <em>Team kennen.</em>')
  .replace('Unser Team bringt unterschiedliche Ausbildungswege, klinische Erfahrungen und TCM-Schwerpunkte mit. Deshalb zeigen wir bei jeder Person transparent, welche Ausbildung, Methoden und Anerkennungen tatsächlich vorliegen.', 'Menschen, Erfahrungen und Qualifikationen – direkt im Profil.')
  .replace('<!--TEAM-GRID-->', teamGridHtml());

let founder = between('<section class="founder-section" id="ueber-uns-founder"', '<section class="uu-advisor"');
founder = founder
  .replace('Von Simon, Co-Founder &amp; Head of Patient Experience', 'Von Simon Stüve Hwang · Inhaber TCM.ch')
  .replace(/<div class="founder-body">[\s\S]*?<\/div> <div class="founder-sig">/,
    '<div class="founder-body"><p>TCM.ch ist aus der Überzeugung entstanden, dass Traditionelle Chinesische Medizin persönlicher, verständlicher und leichter zugänglich sein sollte.</p><p>Mir ist wichtig, dass du weisst, wer dich behandelt, wie du uns erreichst und welche Schritte als Nächstes folgen.</p></div> <div class="founder-sig">')
  .replace(/<a href="https:\/\/wa\.me\/41775236122" class="founder-cta" target="_blank">[\s\S]*?<\/a>/,
    '<a href="/kontakt/?von=/ueber-uns/" class="founder-cta">Persönlich Kontakt aufnehmen <span aria-hidden="true">→</span></a>');

const bts = between('<section class="bts-section" id="ueber-uns-bts"', '<section class="founder-section"');
// The preserved Behind-the-Scenes section is shown exactly as before,
// including all six video tiles, posters, pillars and its original layout.
const behind = bts;
// Reuse the exact three existing TCM.ch homepage sections in the requested
// order: genuine patient feedback -> free introduction -> contact form.
// Keep one shared renderer/handler for enquiries; do not copy the old legacy form.
const homeBetween = (start: string, end: string) => {
  const a = homeBody.indexOf(start), b = homeBody.indexOf(end, a + start.length);
  if (a < 0 || b <= a) throw new Error('About homepage section missing: ' + start);
  return homeBody.slice(a, b).trim();
};
const proof = homeBetween('<section id="s-offer" class="section proof-section"', '<section class="section home-cities-section"');
const freeIntro = homeBetween('<section id="home-free-intro" class="free-intro-section"', '<section id="home-contact-form"')
  .replace('data-care-cta="home-free-intro"', 'data-care-cta="about-free-intro"');
const homeContactLegacy = homeBetween('<section id="home-contact-form"', '<section class="section hf-section"');
const homeContact = upgradeLegacyForms(homeContactLegacy, {
  path: '/ueber-uns/', instancePrefix: 'home',
  extra: { ruhig: true, zusatzOffen: true, kopfTitel: 'Schreib uns eine Nachricht.', quelle: '/ueber-uns/', quelleDetail: 'Über uns · Kontaktformular' },
});
if ((homeContact.match(/data-kf-instance="home"/g) ?? []).length !== 1)
  throw new Error('About: the shared homepage-style contact form was not rendered exactly once');
const patientSections = '<div id="home-content" class="uu-cro-home-sections">' + proof + freeIntro + homeContact + '</div>';
// Keep a single closing tag for #page-ueber-uns; the old B2B recruiting
// section, media-logo strip, negative comparison and duplicated CEO block
// are intentionally not in the patient journey.
// Short, patient-first About flow: team, genuine video, founder, then proof/offer/form.
const body = [intro, team, behind, founder, patientSections, '</section>'].join('');
const title = 'Über uns – Unser Team & unsere Geschichte | TCM.ch';
const description = 'Lerne die Menschen hinter TCM.ch kennen, entdecke unser Team und finde deine Praxis. Jetzt persönlich einen Termin anfragen.';
const schema = { '@context': 'https://schema.org', '@type': 'AboutPage', name: title, url: 'https://tcm.ch/ueber-uns/', inLanguage: 'de-CH', isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } };
---
<SpaPage title={title} description={description} path="/ueber-uns" body={body} schema={schema}>
  <script slot="pre-footer" src="/home-friendly-form.js" is:inline defer></script>
  <script slot="pre-footer" src="/proof-section.js" is:inline defer></script>
  <script slot="pre-footer" is:inline>
    // Start behind-the-scenes clips only when approaching the viewport.
    // Posters remain visible until playback; scrolling away pauses decoding.
    (function(){
      var clips=document.querySelectorAll('#ueber-uns-bts video');
      if(!clips.length)return;
      var c=navigator.connection;
      if((window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)||(c&&c.saveData))return;
      if(!('IntersectionObserver' in window))return;
      var observer=new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          var v=e.target;
          if(e.isIntersecting){
            v.preload='auto';
            var p=v.play();if(p&&p.catch)p.catch(function(){});
          }else if(!v.paused)v.pause();
        });
      },{rootMargin:'250px 0px',threshold:0.01});
      clips.forEach(function(v){observer.observe(v);});
    })();
  </script>
</SpaPage>


<style is:global>
/* Patient-first CRO layout for About; retain all original team portraits. */
#page-ueber-uns .ueber-intro{padding-bottom:34px!important}
#page-ueber-uns .uu-hero{align-items:center!important}
#page-ueber-uns .sub-title{font-size:clamp(34px,4.4vw,58px)!important;line-height:1.06}
#page-ueber-uns .sub-desc{max-width:35rem!important}
#page-ueber-uns .uu-cro-brief{margin:22px 0 0;max-width:850px}
#page-ueber-uns .uu-cro-brief p{font-size:15.5px;line-height:1.65;color:#62717b;margin:0}
#page-ueber-uns .uu-cro-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:22px}
#page-ueber-uns .uu-cro-btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:12px 22px;border-radius:999px;text-decoration:none!important;font-size:15px;font-weight:750;line-height:1.3;text-align:center;transition:background .15s ease,border-color .15s ease}
#page-ueber-uns .uu-cro-btn--primary{background:#1769B1;color:#fff!important;border:1px solid #1769B1}
#page-ueber-uns .uu-cro-btn--primary:hover{background:#12588d}
#page-ueber-uns .uu-cro-btn--secondary{background:#fff;color:#203342!important;border:1px solid #CFD9E0}
#page-ueber-uns .uu-cro-btn--secondary:hover{background:#F4F7F9;border-color:#9EB3C1}
#page-ueber-uns .uu-cro-btn:focus-visible,#page-ueber-uns .uu-cro-nav a:focus-visible,#page-ueber-uns .uu-cro-more summary:focus-visible{outline:3px solid #1769B1;outline-offset:3px}
#page-ueber-uns .uu-cro-micro{font-size:12.5px;color:#697b86;margin:10px 0 0}
#page-ueber-uns .uu-cro-trust{background:#fff;border-bottom:1px solid #E5EAED}
#page-ueber-uns .uu-cro-trust>.wrap{display:flex;align-items:center;justify-content:center;gap:14px 32px;padding-block:17px;flex-wrap:wrap}
#page-ueber-uns .uu-cro-trust span{font-size:13px;color:#506570;font-weight:650;display:inline-flex;align-items:center;gap:8px}
#page-ueber-uns .uu-cro-trust span::before{content:'✓';display:inline-grid;place-items:center;background:#E8F2FA;color:#1769B1;width:22px;height:22px;border-radius:50%;font-weight:750}
#page-ueber-uns .uu-cro-nav{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px 26px;background:#fff;border-bottom:1px solid #E8EDF0;padding:13px 18px}
#page-ueber-uns .uu-cro-nav a{font-weight:700;font-size:13.5px;color:#425664;text-decoration:none;min-height:38px;display:inline-flex;align-items:center}
#page-ueber-uns .uu-cro-nav a:hover{text-decoration:underline;text-underline-offset:4px}
#page-ueber-uns #ueber-uns-team{padding:clamp(38px,5vw,60px) 0!important}
#page-ueber-uns .uu-cro-team-actions{margin:24px 0 12px}
#page-ueber-uns .uu-cro-team-actions a{font-size:15px;font-weight:750;color:#1769B1}
#page-ueber-uns .uu-cro-more{margin:25px 0 0;border:1px solid #DCE5EB;border-radius:18px;background:#fff;overflow:hidden}
#page-ueber-uns .uu-cro-more summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:15px;min-height:58px;padding:17px 22px;font-size:15px;font-weight:750;color:#233744}
#page-ueber-uns .uu-cro-more summary::-webkit-details-marker{display:none}
#page-ueber-uns .uu-cro-more[open]>summary{border-bottom:1px solid #E5EAED}
#page-ueber-uns .uu-cro-team-more .tmc-grid{padding:22px}
#page-ueber-uns .uu-cro-section,#page-ueber-uns .uu-cro-mission{padding:clamp(46px,6vw,78px) 0;background:#F6F5F2}
#page-ueber-uns .uu-cro-mission{background:#fff;padding:clamp(30px,4vw,55px) 0;border-top:1px solid #E5EAED}
#page-ueber-uns .uu-cro-mission .wrap{max-width:950px}
#page-ueber-uns .uu-cro-eyebrow{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#5E7481;margin-bottom:12px}
#page-ueber-uns :is(.uu-cro-section,.uu-cro-mission,.uu-cro-finish) h2{font-size:clamp(27px,3.2vw,43px);line-height:1.13;letter-spacing:-.04em;font-weight:800;color:#1b272c;max-width:800px;margin:0 0 15px}
#page-ueber-uns .uu-cro-section p,#page-ueber-uns .uu-cro-mission p,#page-ueber-uns .uu-cro-finish p{font-size:15.5px;line-height:1.6;color:#61717a;margin:0;max-width:68ch}
#page-ueber-uns .uu-cro-step-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin:25px 0 0}
#page-ueber-uns .uu-cro-step-grid>div{border:1px solid #E1E7EA;background:#fff;border-radius:18px;padding:22px;min-width:0}
#page-ueber-uns .uu-cro-step-grid span{display:block;font-size:12px;font-weight:800;color:#1769B1;margin-bottom:14px}
#page-ueber-uns .uu-cro-step-grid h3{font-size:18px;line-height:1.3;font-weight:750;color:#233744;margin:0 0 9px}
#page-ueber-uns .uu-cro-step-grid p{font-size:14px;line-height:1.55}
#page-ueber-uns .uu-cro-anchor{display:block;height:0;scroll-margin-top:110px}
#page-ueber-uns :is(#ueber-uns-team,#ueber-uns-care-system,#ueber-uns-vision,#ueber-uns-founder){scroll-margin-top:104px}
#page-ueber-uns .founder-section{padding:clamp(40px,5vw,70px) 0!important}
#page-ueber-uns .founder-body p{font-size:15.5px;line-height:1.65}
#page-ueber-uns .uu-cro-bts-more{margin:0 auto 30px;max-width:1160px;background:#fff}
#page-ueber-uns .uu-cro-bts-more>.bts-section{margin:0;min-height:0;padding:25px 0 45px}
#page-ueber-uns .uu-cro-finish{background:#E8F2FA;padding:clamp(42px,5vw,64px) 0;margin-top:25px}
#page-ueber-uns .uu-cro-finish>.wrap{display:flex;align-items:center;justify-content:space-between;gap:24px}
#page-ueber-uns .uu-cro-finish .uu-cro-actions{margin:0;flex-shrink:0}
@media(max-width:767px){
  #page-ueber-uns .ueber-intro{padding-bottom:22px!important}
  #page-ueber-uns .uu-hero{gap:16px!important}
  #page-ueber-uns .sub-title{font-size:clamp(31px,8vw,43px)!important}
  #page-ueber-uns .uu-cro-actions{gap:9px}
  #page-ueber-uns .uu-cro-actions .uu-cro-btn{flex:1 1 165px}
  #page-ueber-uns .uu-cro-brief{margin-top:14px}
  #page-ueber-uns .uu-cro-trust>.wrap{justify-content:flex-start;gap:10px;padding:15px 20px}
  #page-ueber-uns .uu-cro-trust span{font-size:12px}
  #page-ueber-uns .uu-cro-step-grid{grid-template-columns:1fr}
  #page-ueber-uns .uu-cro-step-grid>div{padding:18px}
  #page-ueber-uns .uu-cro-team-more .tmc-grid{padding:12px}
  #page-ueber-uns .uu-cro-finish>.wrap{display:block}
  #page-ueber-uns .uu-cro-finish .uu-cro-actions{margin-top:20px}
}
@media(prefers-reduced-motion:reduce){#page-ueber-uns .uu-cro-btn{transition:none}}

/* Reused homepage panels inside About: do not inherit the homepage header offset. */
#page-ueber-uns #home-content.uu-cro-home-sections{
  padding-top:0!important;margin-top:0!important;
  width:100%;background:#fff;
}
#page-ueber-uns #home-content.uu-cro-home-sections :is(#s-offer,#home-free-intro,#home-contact-form){scroll-margin-top:90px}
#page-ueber-uns .bts-section{margin:0}
#page-ueber-uns .bts-section .bts-stage{overflow:hidden}


/* Tighter, clearer hero without a second explanatory paragraph. */
#page-ueber-uns #ueber-uns-intro{padding-top:clamp(74px,9vh,100px)!important}
#page-ueber-uns .ueber-intro{padding-bottom:clamp(36px,4vw,58px)!important}
#page-ueber-uns .uu-hero{align-items:center!important}
#page-ueber-uns .sub-title{max-width:650px;line-height:1.07!important;margin-bottom:17px!important}
#page-ueber-uns .sub-title em{font-style:normal!important;font-weight:800!important;color:#1769B1!important}
#page-ueber-uns .sub-desc{font-size:clamp(16px,1.5vw,19px)!important;line-height:1.52!important;max-width:34ch!important;margin-bottom:0!important}
#page-ueber-uns .uu-cro-actions{margin-top:22px}
#page-ueber-uns #ueber-uns-team{padding-top:clamp(38px,4vw,58px)!important}
#page-ueber-uns #ueber-uns-team .team-sub{max-width:380px;line-height:1.55}
@media(max-width:767px){
  #page-ueber-uns #ueber-uns-intro{padding-top:78px!important}
  #page-ueber-uns .ueber-intro{padding-bottom:34px!important}
  #page-ueber-uns .sub-desc{max-width:32ch!important}
}
</style>
