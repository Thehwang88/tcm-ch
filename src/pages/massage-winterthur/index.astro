---
// /massage-winterthur — City-Landingpage für "massage winterthur". Reuses SpaPage,
// InsuranceBanner (abrechenbare Seite) und die geteilten .msg-* Styles. Lokale Entität
// mit NAP-Schema (zwei Standorte) für Local SEO.
import SpaPage from '../../layouts/SpaPage.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../components/MassageAnfrageForm.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import bodyRaw from '../../data/massage-winterthur-body.html?raw';
import css from '../../data/massage-city.css?raw';

const [heroPart, restPart] = bodyRaw.split('<!--BANNER-->');

const url = 'https://tcm.ch/massage-winterthur/';
const title = 'Massage Winterthur | Medizinische Massage – TCM.ch';
const description = 'Massage Winterthur: medizinisch oder zur Entspannung. EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar. Zwei Standorte in der Altstadt.';

const faqs = [
  { q: 'An welchem Standort in Winterthur werde ich behandelt?', a: 'Du hast die Wahl zwischen Münzgasse 2 und Marktgasse 78, beide in der Altstadt und wenige Gehminuten vom Hauptbahnhof. Sag bei der Anfrage einfach, was dir besser passt, das Team ist an beiden Adressen gleich ausgebildet.' },
  { q: 'Übernimmt die Krankenkasse die Massage in Winterthur?', a: 'Medizinische Massagen bei unseren EMR- und ASCA-anerkannten Therapeut:innen trägt die Zusatzversicherung in der Regel mit, meist zu 50 bis 90 Prozent. Die Grundversicherung zahlt keine Massagen, Wellness-Massagen sind Selbstzahlerleistungen.' },
  { q: 'Brauche ich eine ärztliche Verordnung?', a: 'Nein. Für die Abrechnung über die Zusatzversicherung genügt die Behandlung bei einer anerkannten Fachperson. Du kannst direkt einen Termin anfragen, ohne vorher zum Arzt zu gehen.' },
  { q: 'Wie schnell bekomme ich einen Termin?', a: 'Meist innert 24 bis 48 Stunden. Weil wir in Winterthur zwei Standorte haben, finden wir auch kurzfristig oft noch einen passenden Platz. Am schnellsten geht es per WhatsApp oder Telefon.' },
  { q: 'Wie komme ich zu euch?', a: 'Beide Praxen liegen in der Winterthurer Altstadt, vom Hauptbahnhof aus in wenigen Gehminuten zu Fuss erreichbar. Auch aus den umliegenden Gemeinden bist du rasch da.' },
];

const oh = ['Mo-Fr 07:30-19:30', 'Sa 07:30-16:30'];
const business = (name, strasse, lat, lng) => ({
  '@context': 'https://schema.org', '@type': 'MedicalBusiness', name, url,
  address: { '@type': 'PostalAddress', streetAddress: strasse, postalCode: '8400', addressLocality: 'Winterthur', addressCountry: 'CH' },
  geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng },
  telephone: '+41775236122', openingHours: oh, areaServed: { '@type': 'City', name: 'Winterthur' },
  medicalSpecialty: 'PhysicalTherapy',
});

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  business('TCM.ch Massage Winterthur Münzgasse', 'Münzgasse 2', 47.4998, 8.729),
  business('TCM.ch Massage Winterthur Marktgasse', 'Marktgasse 78', 47.4992, 8.7281),
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 3, name: 'Massage Winterthur', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/massage-winterthur" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Winterthur" />
  <Fragment set:html={restPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="massage-winterthur" />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Massage-Team TCM.ch" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
