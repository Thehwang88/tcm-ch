---
// /beschwerden/[slug] — faithful 1:1 reproduction of each live SPA symptom leaf
// (#page-symptom), captured per-slug. Per-slug content (sidebar "hilft bei", related
// therapies, FAQ, "Behandlung in deiner Nähe") is baked into each captured file.
import SpaPage from '../../layouts/SpaPage.astro';
import { beschwerden } from '../../data/beschwerden';
import { prefillForm } from '../../data/form-prefill';
import { appendSidebarAllLink } from '../../data/cap-sidebar';
import { parseLeafFaqs, faqPageSchema } from '../../data/leaf-faq';
import { hautLinksForBeschwerde, hautLinksHtml } from '../../data/haut-links';
import { massageLinksForBeschwerde, massageLinksHtml } from '../../data/massage-links';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/symptom-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  // kinderwunsch has a dedicated page at beschwerden/kinderwunsch/index.astro — exclude it
  // here so it doesn't double-build the same route (leaf file kept for the leafSlugs set below).
  return Object.keys(leaves).filter((p) => !p.endsWith('/kinderwunsch.html')).map((p) => {
    const slug = p.split('/').pop().replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] } };
  });
}

// Duplikat-Auflösung innerhalb von /beschwerden/. Drei Beschwerdebilder existierten
// doppelt bzw. dreifach unter Synonym-Slugs und teilten sich damit die Ranking-Signale
// (GSC Q3 2026: alle Beteiligten auf Position 57 bis 83, zusammen 119 Impressionen,
// 1 Klick). Die schwächere URL bleibt für Nutzer:innen und interne Links bestehen,
// kanonisiert aber auf die stärkere und fällt aus der Sitemap.
//   Schlafstörungen  -> Schlafprobleme      (in der Navigation, 387 statt 76 Impressionen)
//   Burnout          -> Stress & Burnout    (Titel überschnitten sich fast vollständig)
//   Heuschnupfen     -> Allergien & Heusch. (breiter, bessere Position, mehr Impressionen)
// Nicht zusammengelegt: Plantarfasziitis und Fersensporn — die Seiten grenzen sich
// fachlich sauber voneinander ab und verlinken sich gegenseitig.
const MERGED: Record<string, string> = {
  schlafstoerungen: '/beschwerden/schlafprobleme/',
  burnout: '/beschwerden/stress-burnout/',
  heuschnupfen: '/beschwerden/allergien-heuschnupfen/',
};

// Valid leaf slugs (source of truth for real pages) — used to keep cross-links unbroken.
const leafSlugs = new Set(
  Object.keys(import.meta.glob('../../data/symptom-leaves/*.html')).map((p) => p.split('/').pop()!.replace('.html', '')),
);
// Fallback pool of top-demand complaints to pad sparse related[] up to a few links.
// Nur kanonische Slugs — nichts aus MERGED, sonst verlinken wir intern auf Seiten,
// die selbst auf eine andere URL zeigen.
const RELATED_POOL = [
  { slug: 'rueckenschmerzen', label: 'Rückenschmerzen' },
  { slug: 'nackenschmerzen', label: 'Nackenschmerzen' },
  { slug: 'migraene', label: 'Migräne' },
  { slug: 'schlafprobleme', label: 'Schlafprobleme' },
  { slug: 'stress-burnout', label: 'Stress & Burnout' },
  { slug: 'verdauungsprobleme', label: 'Verdauungsprobleme' },
];

const { slug } = Astro.params;
const body = Astro.props.body;
const entry = beschwerden.find((b) => b.slug === slug);
const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
const hName = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/\s*TCM\.ch.*$/i, '').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim() : slug;
const name = entry?.name || hName;
const condName = entry?.conditionName || name;
const url = `https://tcm.ch/beschwerden/${slug}/`;
// Per-slug title overrides from the content briefs; template default otherwise.
const TITLES: Record<string, string> = {
  guertelrose: 'Gürtelrose & Nervenschmerzen – TCM | TCM.ch',
  migraene: 'Akupunktur bei Migräne – TCM-Behandlung | TCM.ch',
  kieferschmerzen: 'Kieferschmerzen & CMD – TCM-Behandlung | TCM.ch',
  'morbus-crohn': 'Morbus Crohn – begleitende TCM | TCM.ch',
  hyperhidrose: 'Starkes Schwitzen (Hyperhidrose) – TCM | TCM.ch',
  spannungskopfschmerzen: 'Spannungskopfschmerzen – TCM | TCM.ch',
  'colitis-ulcerosa': 'Colitis ulcerosa – begleitende TCM | TCM.ch',
  tennisarm: 'Tennisarm & Golferarm – TCM-Behandlung | TCM.ch',
  'cluster-kopfschmerzen': 'Cluster-Kopfschmerzen – begleitende TCM | TCM.ch',
  fettleber: 'Fettleber – TCM-Behandlung | TCM.ch',
  'restless-legs': 'Restless Legs – TCM-Behandlung | TCM.ch',
  gastritis: 'Gastritis – TCM-Behandlung | TCM.ch',
  rosacea: 'Rosacea – TCM-Behandlung | TCM.ch',
  hueftschmerzen: 'Hüftschmerzen – TCM-Behandlung | TCM.ch',
  sehnenscheidenentzuendung: 'Sehnenscheidenentzündung: Behandlung, Dauer & was hilft | TCM.ch',
  nesselsucht: 'Nesselsucht (Urtikaria): Behandlung & was wirklich hilft | TCM.ch',
  aphten: 'Aphten – TCM-Behandlung | TCM.ch',
  'raynaud-syndrom': 'Raynaud-Syndrom – TCM-Behandlung | TCM.ch',
  'long-covid': 'Long Covid – begleitende TCM | TCM.ch',
  bluthochdruck: 'Bluthochdruck – begleitende TCM | TCM.ch',
  durchblutungsstoerungen: 'Durchblutungsstörungen – TCM | TCM.ch',
  depressionen: 'Depressionen – TCM-Begleitung | TCM.ch',
};
// Per-slug dateModified for pages upgraded to article standard.
const MODIFIED: Record<string, string> = {
  sehnenscheidenentzuendung: '2026-08-13',
  nesselsucht: '2026-08-13',
};
const title = TITLES[slug!] ?? `${name} – TCM-Behandlung | TCM.ch`;
// Per-slug meta descriptions from the content briefs; template default otherwise.
const DESCRIPTIONS: Record<string, string> = {
  migraene: 'Akupunktur bei Migräne: Attacken seltener machen, Trigger verstehen, Medikamente ergänzen. TCM-Behandlung an 14 Standorten, EMR/ASCA-anerkannt.',
  lippenherpes: 'Immer wieder Lippenherpes? TCM mit Kräutertherapie und Akupunktur bei häufigen Herpesschüben: Rezidive seltener machen. EMR/ASCA-anerkannt.',
  reizblase: 'Reizblase mit TCM behandeln: Akupunktur bei ständigem Harndrang und überaktiver Blase, ohne Infekt. Diskret und krankenkassenanerkannt, 14 Standorte.',
  spannungskopfschmerzen: 'Spannungskopfschmerzen mit TCM behandeln: Akupunktur bei drückenden Kopfschmerzen und verspanntem Nacken, weniger Schmerztage. EMR/ASCA-anerkannt.',
  prostata: 'Prostatabeschwerden mit TCM behandeln: Akupunktur und Kräuter bei häufigem Harndrang, schwachem Harnstrahl und chronischer Prostatitis. EMR/ASCA-anerkannt.',
  akne: 'Akne mit TCM behandeln: Kräutertherapie und Akupunktur bei unreiner Haut, hormoneller Akne und Erwachsenenakne. Von innen ansetzen statt nur Cremes.',
  schuppenflechte: 'Schuppenflechte (Psoriasis) mit TCM begleiten: Kräutertherapie und Akupunktur bei schuppenden Plaques und Juckreiz. Schübe reduzieren, Haut beruhigen.',
  hoersturz: 'Hörsturz mit TCM begleiten: Akupunktur nach akuter Phase, bei bleibender Hörminderung, Ohrdruck und begleitendem Tinnitus. EMR/ASCA-anerkannt.',
  asthma: 'Asthma mit TCM begleiten: Akupunktur und Kräutertherapie ergänzend zur ärztlichen Therapie, für freieres Atmen und weniger Beschwerden im Alltag.',
  hitzewallungen: 'Hitzewallungen mit TCM behandeln: Akupunktur und Kräutertherapie bei Wallungen und Schweissausbrüchen in den Wechseljahren. EMR/ASCA-anerkannt.',
  schwindel: 'Schwindel mit TCM behandeln: Akupunktur bei Drehschwindel, Schwankschwindel und Benommenheit nach ärztlicher Abklärung. EMR/ASCA-anerkannt, 14 Standorte.',
  immunschwaeche: 'Infektanfälligkeit mit TCM angehen: Akupunktur, Kräuter und Moxibustion bei ständigen Erkältungen und langer Erholung. Vorbeugen statt nur reagieren.',
  verstopfung: 'Verstopfung mit TCM behandeln: Akupunktur und Kräutertherapie bei chronischer Obstipation und träger Verdauung, statt Dauerabführmittel.',
  kieferschmerzen: 'Kieferschmerzen, Zähneknirschen und CMD mit TCM behandeln: Akupunktur löst die verspannte Kiefermuskulatur. EMR/ASCA-anerkannt, 14 Standorte.',
  guertelrose: 'Gürtelrose und Post-Zoster-Neuralgie mit TCM begleiten: Akupunktur bei anhaltenden Nervenschmerzen nach Herpes Zoster. EMR/ASCA-anerkannt, 14 Standorte.',
  bandscheibenvorfall: 'Bandscheibenvorfall konservativ begleiten: Akupunktur, Schröpfen und Tuina bei Rückenschmerzen mit Ausstrahlung. EMR/ASCA-anerkannt, 14 Standorte.',
  pcos: 'PCOS mit TCM begleiten: Akupunktur und Kräutertherapie bei unregelmässigem Zyklus, Kinderwunsch und hormonellen Beschwerden. EMR/ASCA-anerkannt.',
  karpaltunnelsyndrom: 'Karpaltunnelsyndrom mit TCM behandeln: Akupunktur bei eingeschlafenen Händen, Kribbeln und nächtlichen Schmerzen. Konservativ, EMR/ASCA-anerkannt.',
  fersensporn: 'Fersensporn und Plantarfasziitis mit TCM behandeln: Akupunktur bei stechenden Fersenschmerzen und Anlaufschmerz am Morgen. EMR/ASCA-anerkannt.',
  polyneuropathie: 'Polyneuropathie mit TCM begleiten: Akupunktur bei brennenden Füssen, Kribbeln und Taubheitsgefühl. Auch bei diabetischer Neuropathie. EMR/ASCA-anerkannt.',
  hexenschuss: 'Hexenschuss: Akute Rückenschmerzen mit TCM behandeln. Akupunktur und Schröpfen lösen die Blockade, schnell wieder beweglich. EMR/ASCA-anerkannt.',
  nesselsucht: 'Chronische Nesselsucht (Urtikaria) mit TCM behandeln: Kräutertherapie und Akupunktur bei Quaddeln und Juckreiz ohne Auslöser. EMR/ASCA-anerkannt.',
  gicht: 'Gicht mit TCM begleiten: Akupunktur und Ernährung nach TCM bei erhöhter Harnsäure und wiederkehrenden Gichtanfällen. EMR/ASCA-anerkannt, 14 Standorte.',
  'morbus-crohn': 'Morbus Crohn mit TCM begleiten: Akupunktur und Kräutertherapie ergänzend zur Gastroenterologie, für ruhigere Phasen und Lebensqualität. EMR/ASCA-anerkannt.',
  spinalkanalstenose: 'Spinalkanalstenose konservativ begleiten: Akupunktur bei Rückenschmerzen und schweren Beinen beim Gehen. EMR/ASCA-anerkannt, 14 Standorte.',
  trigeminusneuralgie: 'Trigeminusneuralgie mit TCM begleiten: Akupunktur bei blitzartigen Gesichtsschmerzen, ergänzend zur neurologischen Therapie. EMR/ASCA-anerkannt.',
  hyperhidrose: 'Hyperhidrose mit TCM behandeln: Akupunktur und Kräutertherapie bei übermässigem Schwitzen an Händen, Achseln und Füssen. EMR/ASCA-anerkannt.',
  'colitis-ulcerosa': 'Colitis ulcerosa mit TCM begleiten: Akupunktur und Kräutertherapie ergänzend zur Gastroenterologie, für stabilere Ruhephasen. EMR/ASCA-anerkannt.',
  tennisarm: 'Tennisarm und Golferarm mit TCM behandeln: Akupunktur bei Schmerzen am Ellbogen, ohne Spritzen. Auch bei Mausarm. EMR/ASCA-anerkannt, 14 Standorte.',
  'cluster-kopfschmerzen': 'Cluster-Kopfschmerzen mit TCM begleiten: Akupunktur zwischen den Episoden, ergänzend zur neurologischen Therapie. EMR/ASCA-anerkannt, 14 Standorte.',
  fettleber: 'Fettleber mit TCM begleiten: Ernährung nach TCM, Akupunktur und Stoffwechsel-Begleitung. Die Fettleber ist umkehrbar. EMR/ASCA-anerkannt.',
  'restless-legs': 'Restless-Legs-Syndrom mit TCM begleiten: Akupunktur bei unruhigen Beinen und gestörtem Schlaf, ergänzend zur ärztlichen Abklärung. EMR/ASCA-anerkannt.',
  gastritis: 'Gastritis mit TCM behandeln: Akupunktur, Kräuter und Ernährung bei Magenschleimhautentzündung und Reizmagen. EMR/ASCA-anerkannt, 14 Standorte.',
  rosacea: 'Rosacea mit TCM behandeln: Kräutertherapie und Akupunktur bei Gesichtsrötung, Flushs und Papeln. Trigger senken, Haut beruhigen. EMR/ASCA-anerkannt.',
  hueftschmerzen: 'Hüftschmerzen mit TCM behandeln: Akupunktur bei Hüftarthrose, Leistenschmerzen und Schleimbeutelentzündung. Beweglich bleiben. EMR/ASCA-anerkannt.',
  aphten: 'Immer wieder Aphten im Mund? TCM mit Kräutertherapie und Akupunktur bei wiederkehrenden Aphthen: Schübe seltener machen. EMR/ASCA-anerkannt.',
  'raynaud-syndrom': 'Raynaud-Syndrom mit TCM behandeln: Akupunktur und Moxibustion bei weissen, kalten Fingern und Durchblutungsstörungen. EMR/ASCA-anerkannt, 14 Standorte.',
  uebelkeit: 'Übelkeit mit TCM behandeln: Akupunktur und Akupressur am Punkt P6, auch begleitend bei Chemotherapie. EMR/ASCA-anerkannt, 14 Standorte.',
  augenmigraene: 'Augenmigräne mit TCM behandeln: Akupunktur bei Flimmern, Zickzacklinien und Sehstörungen mit oder ohne Kopfschmerz. EMR/ASCA-anerkannt.',
  bluthochdruck: 'Bluthochdruck mit TCM begleiten: Akupunktur, Ernährung und Stressregulation ergänzend zur ärztlichen Therapie. Nie als Ersatz. EMR/ASCA-anerkannt.',
  blaehungen: 'Blähungen und Blähbauch mit TCM behandeln: Akupunktur, Kräuter und Ernährung bei aufgeblähtem Bauch und Völlegefühl. EMR/ASCA-anerkannt.',
  durchblutungsstoerungen: 'Kalte Hände und Füsse, funktionelle Durchblutungsstörungen: TCM mit Moxibustion, Akupunktur und Kräutern. Nach ärztlicher Abklärung. EMR/ASCA.',
  'long-covid': 'Long Covid mit TCM begleiten: Akupunktur und Kräutertherapie bei Fatigue, Brain Fog und Erschöpfung nach Infekt, Pacing-kompatibel. EMR/ASCA-anerkannt.',
  haemorrhoiden: 'Hämorrhoiden mit TCM behandeln: Akupunktur, Kräuter und Ernährung bei Jucken, Brennen und wiederkehrenden Beschwerden. Diskret, EMR/ASCA-anerkannt.',
  osteoporose: 'Osteoporose mit TCM begleiten: Akupunktur bei Rückenschmerzen, sanfte Behandlung für Beweglichkeit und Stabilität. Ergänzend zur ärztlichen Therapie.',
  depressionen: 'Depressionen mit TCM begleiten: Akupunktur für besseren Schlaf, mehr Energie und weniger Anspannung. Ergänzend zu Psychotherapie und ärztlicher Behandlung.',
  hashimoto: 'Hashimoto und Schilddrüsenunterfunktion mit TCM begleiten: mehr Energie, weniger Frieren, stabilere Verdauung. Ergänzend zur ärztlichen Hormontherapie.',
  rheuma: 'Rheuma mit TCM begleiten: Akupunktur bei Gelenkschmerzen, Morgensteifigkeit und rheumatoider Arthritis. Ergänzend zur rheumatologischen Therapie.',
};
const description = DESCRIPTIONS[slug!] ?? `${name} mit TCM behandeln: Ursachen und Behandlung. EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung.`;

// MedicalWebPage about a MedicalCondition + breadcrumb (+ FAQPage where the data has FAQs).
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalCondition', name: condName },
    ...(MODIFIED[slug!] ? { dateModified: MODIFIED[slug!] } : {}) },
  { '@context': 'https://schema.org', '@type': 'MedicalCondition', name: condName, url },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Beschwerden', item: 'https://tcm.ch/beschwerden/' },
    { '@type': 'ListItem', position: 3, name, item: url },
  ] },
];
// Renders a visible FAQ accordion from faqs data (same markup/classes as the leaf FAQs).
// Used when a page has FAQ data but no accordion baked into its leaf (schlafstoerungen).
function renderSymptomFaq(faqs: { q: string; a: string }[], label: string) {
  const items = faqs.map((f) => `<details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0"><summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">${f.q}<span style="font-size:20px;color:var(--blue);transition:transform .2s">+</span></summary><div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">${f.a}</div></details>`).join('');
  return `<div id="symptom-faq-section"><section style="background:#fff;padding:56px 0"><div class="wrap" style="max-width:820px"><div class="section-label">Häufige Fragen</div><h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>${label}</em></h2><div class="faq-list">${items}</div></div></section></div>`;
}
// FAQPage from entry.faqs when present, else from the leaf's own visible accordion.
// schlafstoerungen has entry.faqs but no accordion in the leaf -> render one (faqBlock).
let faqBlock = '';
if (entry?.faqs?.length) {
  schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: entry.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
  if (!parseLeafFaqs(body).length) faqBlock = renderSymptomFaq(entry.faqs, name);
} else {
  const leafFaqs = parseLeafFaqs(body);
  if (leafFaqs.length) schema.push(faqPageSchema(leafFaqs));
}
// "Verwandte Beschwerden" cross-link block — interlinks the /beschwerden/ leaf pages
// (SEO: lift them out of "discovered, not crawled"). Built from the real related[] data,
// padded from RELATED_POOL, filtered to existing leaf slugs (no broken links), excl. self.
const relSeen = new Set([slug]);
const related: { slug: string; label: string }[] = [];
for (const r of [...(entry?.related ?? []), ...RELATED_POOL]) {
  if (related.length >= 4) break;
  if (!relSeen.has(r.slug) && leafSlugs.has(r.slug)) { related.push({ slug: r.slug, label: r.label }); relSeen.add(r.slug); }
}
const relatedBlock = related.length
  ? `<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal"><div class="section-label">Verwandte Beschwerden</div><h2 class="section-title">Das könnte dich auch betreffen</h2><div class="cl-links">${related.map((r) => `<a href="/beschwerden/${r.slug}/" class="cl-chip">${r.label}</a>`).join('')}</div></div></section>`
  : '';
// Links in den /haut/-Cluster — nur auf hautnahen Beschwerden (Akne, Rosacea, Neurodermitis, ...),
// damit die Verlinkung thematisch trägt. Hebt die /haut/-Leaves aus "Gefunden – nicht indexiert".
const hautBlock = hautLinksHtml(
  hautLinksForBeschwerde(slug!, 6),
  'Haut & Gesicht',
  'Passend dazu aus der Rubrik Haut',
  'Wirkstoffe und Behandlungen, ehrlich eingeordnet — ohne Versprechen, die keiner halten kann.',
);
// Links in den Massage-Cluster — nur auf muskuloskelettalen und verwandten Beschwerden.
// Die Unterseiten unter /therapien/massage/ haben Volumen (Lymphdrainage 9.900/Monat CH),
// bekommen aber kaum Impressionen; ein paar davon standen auf "Gefunden – nicht indexiert".
const massageBlock = massageLinksHtml(
  massageLinksForBeschwerde(slug!, 4),
  'Massage, die hier oft dazugehört',
  'Welche Technik im Einzelfall passt, klären wir vor der Behandlung — nicht am Telefon geraten.',
);
// Prefill the contact form with this complaint as the topic (editable; source in hidden quelle).
const prefilledBody = appendSidebarAllLink(
  prefillForm(body, `Ich habe ${name} und suche Unterstützung.`, `Beschwerde: ${name}`),
  'symptom-therapies-sidebar', '/therapien/', 'Alle Therapien ansehen');
// Soft entry into the interactive self-test (links to /selbsttest/ from every complaint page).
const selbsttestBlock = `<section class="section" style="background:#fff;padding:40px 0"><div class="wrap reveal"><a href="/selbsttest/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;background:var(--green-mint);border:1px solid var(--green-mid);border-radius:16px;padding:20px 22px;text-decoration:none;max-width:820px;margin:0 auto"><div><div style="font-family:var(--font-sans);font-weight:800;font-size:19px;color:var(--black);line-height:1.25;margin-bottom:4px">Unsicher, ob die TCM bei dir passt?</div><div style="font-size:14.5px;color:var(--mid);line-height:1.5">Mach den Selbsttest: 5 Fragen in unter 1 Minute, unverbindlich.</div></div><span style="flex-shrink:0;display:inline-flex;align-items:center;gap:6px;background:var(--green);color:#fff;font-family:var(--font-sans);font-weight:700;font-size:14.5px;padding:11px 16px;border-radius:12px">Selbsttest starten<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></a></div></section>`;
---
<SpaPage title={title} description={description} path={`/beschwerden/${slug}`} body={prefilledBody + faqBlock + selbsttestBlock + relatedBlock + hautBlock + massageBlock} schema={schema} canonicalTo={MERGED[slug!]} />
