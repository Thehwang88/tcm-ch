---
// /beschwerden/[slug] — faithful 1:1 reproduction of each live SPA symptom leaf
// (#page-symptom), captured per-slug. Per-slug content (sidebar "hilft bei", related
// therapies, FAQ, "Behandlung in deiner Nähe") is baked into each captured file.
import SpaPage from '../../layouts/SpaPage.astro';
import { beschwerden } from '../../data/beschwerden';
import { prefillForm } from '../../data/form-prefill';
import { appendSidebarAllLink } from '../../data/cap-sidebar';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/symptom-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.keys(leaves).map((p) => {
    const slug = p.split('/').pop().replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] } };
  });
}

// Valid leaf slugs (source of truth for real pages) — used to keep cross-links unbroken.
const leafSlugs = new Set(
  Object.keys(import.meta.glob('../../data/symptom-leaves/*.html')).map((p) => p.split('/').pop()!.replace('.html', '')),
);
// Fallback pool of top-demand complaints to pad sparse related[] up to a few links.
const RELATED_POOL = [
  { slug: 'rueckenschmerzen', label: 'Rückenschmerzen' },
  { slug: 'nackenschmerzen', label: 'Nackenschmerzen' },
  { slug: 'migraene', label: 'Migräne' },
  { slug: 'schlafstoerungen', label: 'Schlafstörungen' },
  { slug: 'stress-burnout', label: 'Stress & Burnout' },
  { slug: 'verdauungsprobleme', label: 'Verdauungsprobleme' },
];

const { slug } = Astro.params;
const body = Astro.props.body;
const entry = beschwerden.find((b) => b.slug === slug);
const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
const hName = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/\s*TCM\.ch.*$/i, '').replace(/\s+/g, ' ').trim() : slug;
const name = entry?.name || hName;
const condName = entry?.conditionName || name;
const url = `https://tcm.ch/beschwerden/${slug}/`;
const title = `${name} – TCM-Behandlung bei TCM.ch`;
const description = `${name} mit TCM behandeln: Ursachen, Symptome und passende Behandlung. EMR-/ASCA-anerkannt, an 12 Standorten. Krankenkasse 80–100 % über die Zusatzversicherung.`;

// MedicalWebPage about a MedicalCondition + breadcrumb (+ FAQPage where the data has FAQs).
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalCondition', name: condName } },
  { '@context': 'https://schema.org', '@type': 'MedicalCondition', name: condName, url },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Beschwerden', item: 'https://tcm.ch/beschwerden/' },
    { '@type': 'ListItem', position: 3, name, item: url },
  ] },
];
if (entry?.faqs?.length) {
  schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: entry.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
// "Verwandte Beschwerden" cross-link block — interlinks the /beschwerden/ leaf pages
// (SEO: lift them out of "discovered, not crawled"). Built from the real related[] data,
// padded from RELATED_POOL, filtered to existing leaf slugs (no broken links), excl. self.
const relSeen = new Set([slug]);
const related: { slug: string; label: string }[] = [];
for (const r of [...(entry?.related ?? []), ...RELATED_POOL]) {
  if (related.length >= 4) break;
  if (!relSeen.has(r.slug) && leafSlugs.has(r.slug)) { related.push({ slug: r.slug, label: r.label }); relSeen.add(r.slug); }
}
const relatedBlock = related.length
  ? `<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal"><div class="section-label">Verwandte Beschwerden</div><h2 class="section-title">Das könnte dich auch betreffen</h2><div class="cl-links">${related.map((r) => `<a href="/beschwerden/${r.slug}/" class="cl-chip">${r.label}</a>`).join('')}</div></div></section>`
  : '';
// Prefill the contact form with this complaint as the topic (editable; source in hidden quelle).
const prefilledBody = appendSidebarAllLink(
  prefillForm(body, `Ich habe ${name} und suche Unterstützung.`, `Beschwerde: ${name}`),
  'symptom-therapies-sidebar', '/therapien/', 'Alle Therapien ansehen');
---
<SpaPage title={title} description={description} path={`/beschwerden/${slug}`} body={prefilledBody + relatedBlock} schema={schema} />
