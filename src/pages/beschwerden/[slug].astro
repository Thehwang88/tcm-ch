---
// /beschwerden/[slug] — faithful 1:1 reproduction of each live SPA symptom leaf
// (#page-symptom), captured per-slug. Per-slug content (sidebar "hilft bei", related
// therapies, FAQ, "Behandlung in deiner Nähe") is baked into each captured file.
import SpaPage from '../../layouts/SpaPage.astro';
import { beschwerden } from '../../data/beschwerden';
import { prefillForm } from '../../data/form-prefill';
import { appendSidebarAllLink } from '../../data/cap-sidebar';
import { parseLeafFaqs, faqPageSchema } from '../../data/leaf-faq';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/symptom-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  // kinderwunsch has a dedicated page at beschwerden/kinderwunsch/index.astro — exclude it
  // here so it doesn't double-build the same route (leaf file kept for the leafSlugs set below).
  return Object.keys(leaves).filter((p) => !p.endsWith('/kinderwunsch.html')).map((p) => {
    const slug = p.split('/').pop().replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] } };
  });
}

// Valid leaf slugs (source of truth for real pages) — used to keep cross-links unbroken.
const leafSlugs = new Set(
  Object.keys(import.meta.glob('../../data/symptom-leaves/*.html')).map((p) => p.split('/').pop()!.replace('.html', '')),
);
// Fallback pool of top-demand complaints to pad sparse related[] up to a few links.
const RELATED_POOL = [
  { slug: 'rueckenschmerzen', label: 'Rückenschmerzen' },
  { slug: 'nackenschmerzen', label: 'Nackenschmerzen' },
  { slug: 'migraene', label: 'Migräne' },
  { slug: 'schlafstoerungen', label: 'Schlafstörungen' },
  { slug: 'stress-burnout', label: 'Stress & Burnout' },
  { slug: 'verdauungsprobleme', label: 'Verdauungsprobleme' },
];

const { slug } = Astro.params;
const body = Astro.props.body;
const entry = beschwerden.find((b) => b.slug === slug);
const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
const hName = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/\s*TCM\.ch.*$/i, '').replace(/\s+/g, ' ').trim() : slug;
const name = entry?.name || hName;
const condName = entry?.conditionName || name;
const url = `https://tcm.ch/beschwerden/${slug}/`;
const title = `${name} – TCM-Behandlung | TCM.ch`;
const description = `${name} mit TCM behandeln: Ursachen und Behandlung. EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung.`;

// MedicalWebPage about a MedicalCondition + breadcrumb (+ FAQPage where the data has FAQs).
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalCondition', name: condName } },
  { '@context': 'https://schema.org', '@type': 'MedicalCondition', name: condName, url },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Beschwerden', item: 'https://tcm.ch/beschwerden/' },
    { '@type': 'ListItem', position: 3, name, item: url },
  ] },
];
// Renders a visible FAQ accordion from faqs data (same markup/classes as the leaf FAQs).
// Used when a page has FAQ data but no accordion baked into its leaf (schlafstoerungen).
function renderSymptomFaq(faqs: { q: string; a: string }[], label: string) {
  const items = faqs.map((f) => `<details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0"><summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">${f.q}<span style="font-size:20px;color:var(--blue);transition:transform .2s">+</span></summary><div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">${f.a}</div></details>`).join('');
  return `<div id="symptom-faq-section"><section style="background:#fff;padding:56px 0"><div class="wrap" style="max-width:820px"><div class="section-label">Häufige Fragen</div><h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>${label}</em></h2><div class="faq-list">${items}</div></div></section></div>`;
}
// FAQPage from entry.faqs when present, else from the leaf's own visible accordion.
// schlafstoerungen has entry.faqs but no accordion in the leaf -> render one (faqBlock).
let faqBlock = '';
if (entry?.faqs?.length) {
  schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: entry.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
  if (!parseLeafFaqs(body).length) faqBlock = renderSymptomFaq(entry.faqs, name);
} else {
  const leafFaqs = parseLeafFaqs(body);
  if (leafFaqs.length) schema.push(faqPageSchema(leafFaqs));
}
// "Verwandte Beschwerden" cross-link block — interlinks the /beschwerden/ leaf pages
// (SEO: lift them out of "discovered, not crawled"). Built from the real related[] data,
// padded from RELATED_POOL, filtered to existing leaf slugs (no broken links), excl. self.
const relSeen = new Set([slug]);
const related: { slug: string; label: string }[] = [];
for (const r of [...(entry?.related ?? []), ...RELATED_POOL]) {
  if (related.length >= 4) break;
  if (!relSeen.has(r.slug) && leafSlugs.has(r.slug)) { related.push({ slug: r.slug, label: r.label }); relSeen.add(r.slug); }
}
const relatedBlock = related.length
  ? `<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal"><div class="section-label">Verwandte Beschwerden</div><h2 class="section-title">Das könnte dich auch betreffen</h2><div class="cl-links">${related.map((r) => `<a href="/beschwerden/${r.slug}/" class="cl-chip">${r.label}</a>`).join('')}</div></div></section>`
  : '';
// Prefill the contact form with this complaint as the topic (editable; source in hidden quelle).
const prefilledBody = appendSidebarAllLink(
  prefillForm(body, `Ich habe ${name} und suche Unterstützung.`, `Beschwerde: ${name}`),
  'symptom-therapies-sidebar', '/therapien/', 'Alle Therapien ansehen');
// Soft entry into the interactive self-test (links to /selbsttest/ from every complaint page).
const selbsttestBlock = `<section class="section" style="background:#fff;padding:40px 0"><div class="wrap reveal"><a href="/selbsttest/" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;background:var(--green-mint);border:1px solid var(--green-mid);border-radius:16px;padding:20px 22px;text-decoration:none;max-width:820px;margin:0 auto"><div><div style="font-family:var(--font-sans);font-weight:800;font-size:19px;color:var(--black);line-height:1.25;margin-bottom:4px">Unsicher, ob die TCM bei dir passt?</div><div style="font-size:14.5px;color:var(--mid);line-height:1.5">Mach den Selbsttest: 5 Fragen in unter 1 Minute, unverbindlich.</div></div><span style="flex-shrink:0;display:inline-flex;align-items:center;gap:6px;background:var(--green);color:#fff;font-family:var(--font-sans);font-weight:700;font-size:14.5px;padding:11px 16px;border-radius:12px">Selbsttest starten<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></a></div></section>`;
---
<SpaPage title={title} description={description} path={`/beschwerden/${slug}`} body={prefilledBody + faqBlock + selbsttestBlock + relatedBlock} schema={schema} />
