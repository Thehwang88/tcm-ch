---
import LayoutDe from '../layouts/LayoutDe.astro';
import { site } from '../data/site';

const path = '/partner';
const url = new URL(path + '/', site.url).href;
const title = 'Partner & Karriere im TCM-Netzwerk Schweiz | TCM.ch';
const description =
  'TCM.ch sucht qualifizierte Therapeutinnen, Akupunkteure und Fachpersonen als Behandler, Senior oder Standortleitung für neue Standorte.';

const trust = ['TCM', 'Akupunktur', 'Tuina', 'Kräutermedizin', 'Physiotherapie', 'medizinische Massage', 'Standortleitung', 'Standortaufbau'];

const modelle = [
  { t: 'Therapeut:in an einem bestehenden Standort', d: 'Für qualifizierte Therapeuten, die ein stabiles, professionelles Klinikumfeld suchen.' },
  { t: 'Senior / Standortleitung', d: 'Für erfahrene Therapeuten mit Wunsch nach Verantwortung, Teamführung und Entwicklung.' },
  { t: 'Standortleitung für einen neuen Standort', d: 'Für herausragende Therapeuten, die einen neuen TCM.ch Standort in ihrer Stadt aufbauen und führen wollen, ohne alles allein von null zu errichten.' },
];

const ablauf = [
  { t: 'Bewerbung einreichen', d: 'Erfahrung, Ausbildung, Methoden, Sprachen, Standortwunsch, Anerkennungsstatus, Rolleninteresse.' },
  { t: 'Qualifikation & Anerkennung prüfen', d: 'Klinischer Hintergrund, EMR/ASCA/OdA/BAB/ZSR/Bewilligungssituation, fachlicher Fit.' },
  { t: 'Standort- und Rollenfit besprechen', d: 'Passend als Therapeutin oder Therapeut, Senior oder als Standortleiterin oder Standortleiter.' },
  { t: 'Gemeinsame Perspektive entwickeln', d: 'Bei starkem Fit konkrete Möglichkeiten: bestehender Standort, neuer Standort, Standortleitung.' },
];

const fuerWen = ['TCM-Therapeut:innen', 'Akupunkteur:innen', 'Ärzt:innen mit TCM-Hintergrund', 'Tuina & medizinische Massage', 'Kräutermedizin', 'Internationale Fachpersonen', 'Physiotherapie & integrative Medizin', 'Standortleiter-Persönlichkeiten', 'Klinikerfahrene Führungspersonen'];

const nichtFuerWen = [
  'Nicht für reine Nebenjob-Suchende.',
  'Nicht für Therapeuten, denen Patientenerfahrung, Dokumentation oder Qualität gleichgültig sind.',
  'Nicht für Menschen, die volle Unabhängigkeit ohne Struktur wollen.',
  'Nicht für Erwartungen an garantiertes Einkommen, Visa, Anerkennung oder sofortigen Klinikbesitz.',
];

const anerkennungItems = ['EMR', 'ASCA', 'OdA AM', 'kantonale Berufsausübungsbewilligung (BAB)', 'ZSR', 'SRK wo relevant', 'Sprachkenntnisse', 'Aufenthalts- und Arbeitsbewilligung'];

const warum = ['Echter Klinikbetreiber statt Jobbörse', 'Wachsendes Schweizer Netzwerk', 'Patientennachfrage durch starkes Marketing', 'Zentrale Website & Google-Sichtbarkeit', 'Strukturiertes Onboarding', 'Moderne Klinikstandards', 'Operative Unterstützung', 'Abrechnungs- und Administrations-Know-how', 'Verständnis für Anerkennung, Versicherung und Schweizer Klinikrealität', 'Langfristige Expansionsstrategie', 'Möglicher Weg von der Therapie über die Senior-Rolle bis zur Standortleitung'];

const methodenOpts = ['Akupunktur', 'Tuina', 'Kräuter', 'Schröpfen', 'Moxa', 'Physiotherapie', 'Massage', 'andere'];
const anerkennungOpts = ['EMR', 'ASCA', 'OdA AM', 'BAB', 'ZSR', 'SRK', 'noch keine', 'in Bearbeitung'];
const standortOpts = ['Zürich', 'Winterthur', 'Frauenfeld', 'Kreuzlingen', 'St. Gallen', 'Basel', 'Uster', 'Wil', 'andere'];

const faqs = [
  { q: 'Muss ich bereits EMR-anerkannt sein?', a: 'Nein, wir prüfen jeden Fall individuell, auch in Bearbeitung befindliche Anerkennungen.' },
  { q: 'Kann ich mich aus dem Ausland bewerben?', a: 'Ja, mit realistischer gemeinsamer Einschätzung, ohne Garantien.' },
  { q: 'Ist das eine normale Stellenbewerbung?', a: 'Nein, es ist eine kuratierte Karriere- und Standortleitungs-Pipeline.' },
  { q: 'Kann ich mit TCM.ch eine neue Klinik eröffnen?', a: 'Bei starkem Fit möglich, je nach Standort und Prüfung.' },
  { q: 'Bedeutet Standortleitung Franchise, Beteiligung oder Selbstständigkeit?', a: 'Nein, die Standortleitung ist eine Anstellung bei TCM.ch.' },
  { q: 'Unterstützt TCM.ch bei BAB/EMR/ZSR?', a: 'Wir geben Orientierung, keine behördliche oder rechtliche Beratung.' },
  { q: 'Welche Standorte sind geplant?', a: 'Bestehende Standorte plus laufende Expansion, abhängig von passenden Profilen.' },
  { q: 'Ist mein Profil kostenlos?', a: 'Ja, die Einreichung ist unverbindlich und kostenlos.' },
  { q: 'Ist eine Beteiligung möglich?', a: 'Der Standard ist eine Anstellung bei TCM.ch – ohne Kapitaleinsatz und ohne unternehmerisches Risiko. In Einzelfällen, bei entsprechender Erfahrung und nachgewiesener Führungsleistung, ist ein Beteiligungsmodell nach Absprache möglich. Das besprechen wir persönlich, nicht im Bewerbungsformular.' },
  { q: 'Gibt es garantierte Jobs oder Standortleitungen?', a: 'Nein, jeder Fall wird individuell geprüft.' },
];

// FAQPage only, no JobPosting (would require invented job/salary/date data).
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url, inLanguage: 'de-CH',
    audience: { '@type': 'Audience', audienceType: 'TCM therapists and medical professionals' },
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema} turnstile={true}>
  <!-- 1. HERO -->
  <section class="pt-hero" aria-label="Partner und Karriere bei TCM.ch">
    <img class="pt-hero-bg" src="/images/partner-hero.webp" alt="Team der TCM.ch Kliniken bei der gemeinsamen Standortplanung" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" />
    <div class="pt-hero-overlay" aria-hidden="true"></div>
    <div class="wrap pt-hero-inner">
      <div class="pt-hero-text">
        <div class="eyebrow">TCM.ch · Partner & Karriere</div>
        <h1>Bauen Sie mit TCM.ch die nächste TCM-Klinik der Schweiz</h1>
        <p class="lead">TCM.ch sucht qualifizierte TCM-Therapeutinnen, Akupunkteure und medizinische Fachpersonen, die als Behandler, Senior oder Standortleitung Teil eines wachsenden Schweizer Kliniknetzwerks werden möchten.</p>
        <div class="pt-cta-row">
          <a class="btn btn--primary" href="#partnerprofil">Bewerbung starten</a>
          <a class="btn btn--ghost" href="#modell">Möglichkeiten prüfen</a>
        </div>
        <ul class="pt-trust">{trust.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM / LÖSUNG -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">Ausgangslage</div>
      <p class="pt-body">Eine eigene TCM-Klinik aufzubauen ist anspruchsvoll. Patientengewinnung, Google-Sichtbarkeit, Website, Administration, Kassenanerkennung, Abrechnung, Standortsuche, Empfang und Schweizer Regulatorik kosten Zeit und binden Energie, die für die Behandlung fehlt. Gleichzeitig braucht die Schweiz mehr seriöse, moderne und qualitätsorientierte TCM-Kliniken.</p>
      <div class="pt-solution">
        <strong>Die Lösung:</strong> TCM.ch verbindet starke Therapeuten mit zentraler Marke, Marketing, Systemen, Infrastruktur und nationaler Expansionsstrategie. Ihr Fokus bleibt die Behandlung, wir bauen die Klinik darum herum.
      </div>
    </div>
  </section>

  <!-- 3. PARTNER-MODELL -->
  <section class="section" id="modell" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Standort-Modelle</div>
      <h2 class="section-title">Drei Wege, mit uns zu wachsen</h2>
      <div class="pt-cards pt-cards-3">
        {modelle.map((m) => (
          <div class="pt-card">
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </div>
        ))}
      </div>
      <p class="pt-note">Konkrete Ausgestaltung je nach Qualifikation, Standort, Erfahrung und gemeinsamer Prüfung.</p>
      <p class="pt-note" style="margin-top:6px">Beteiligungsmodelle sind in Einzelfällen nach persönlicher Absprache möglich.</p>
    </div>
  </section>

  <!-- 4. ABLAUF -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Ablauf</div>
      <h2 class="section-title">In vier Schritten zum Fit</h2>
      <div class="pt-steps">
        {ablauf.map((s, i) => (
          <div class="pt-step">
            <div class="pt-step-num">{i + 1}</div>
            <div><div class="pt-step-t">{s.t}</div><p>{s.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. FÜR WEN -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Für wen</div>
      <h2 class="section-title">An wen sich das richtet</h2>
      <ul class="pt-pills">{fuerWen.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <!-- 6. NICHT FÜR WEN -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">Qualitätsfilter</div>
      <h2 class="section-title">An wen sich das nicht richtet</h2>
      <ul class="pt-x-list">{nichtFuerWen.map((w) => <li>{w}</li>)}</ul>
      <p class="pt-body">Wir suchen seriöse, verlässliche, klinisch starke Fachpersonen mit langfristiger Ambition.</p>
    </div>
  </section>

  <!-- 7. SCHWEIZER ANERKENNUNG -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap pt-narrow">
      <div class="section-label">Schweizer Anerkennung</div>
      <h2 class="section-title">Überblick (nicht-rechtlich)</h2>
      <ul class="pt-tags">{anerkennungItems.map((a) => <li>{a}</li>)}</ul>
      <p class="pt-hint">Hinweis: Wir geben Orientierung, ersetzen aber keine behördliche oder rechtliche Beratung.</p>
    </div>
  </section>

  <!-- 8. INTERNATIONALE FACHPERSONEN -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">International</div>
      <h2 class="section-title">Für internationale TCM-Fachpersonen mit Schweiz-Ambition</h2>
      <p class="pt-body">Die Schweiz kann attraktiv sein, der Weg ist aber komplex. Wir sind an qualifizierten internationalen Fachpersonen mit starker klinischer Erfahrung und langfristigem Engagement interessiert und prüfen gemeinsam, ob ein realistischer Weg in den Schweizer TCM-Markt besteht. Keine Visa-, Anerkennungs- oder Jobgarantie, wir bieten Orientierung und eine realistische Einschätzung möglicher nächster Schritte.</p>
    </div>
  </section>

  <!-- 9. WARUM TCM.ch -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Warum TCM.ch</div>
      <h2 class="section-title">Was Sie bei uns finden</h2>
      <ul class="pt-check-list">{warum.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <!-- 9a. AUFBAUEN -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Standortleitung</div>
      <h2 class="section-title">Für Menschen, die aufbauen wollen</h2>
      <p class="pt-body">Eine eigene Praxis zu eröffnen kostet Kapital, Jahre und Nerven. Die meisten scheitern nicht an der Therapie, sondern an Administration, Marketing und Personal.</p>
      <p class="pt-body" style="margin-bottom:24px">Bei TCM.ch übernehmen Sie einen Standort mit Ihrem Namen, Ihrem Team und Ihrer Handschrift. Aufbau, Verwaltung und Patientengewinnung kommen von uns.</p>

      <div class="pt-cards pt-cards-4">
        <div class="pt-card">
          <h3>Ihr Standort</h3>
          <p>Sie führen ihn unter Ihrem Namen, stellen Ihr Team ein und prägen das Angebot vor Ort.</p>
        </div>
        <div class="pt-card">
          <h3>Ihr Ergebnis zählt</h3>
          <p>Die Entwicklung Ihres Standorts wirkt sich direkt auf Ihre Vergütung aus – zusätzlich zum Fixlohn.</p>
        </div>
        <div class="pt-card">
          <h3>Ohne eigenes Risiko</h3>
          <p>Kein Kapitaleinsatz, keine Kreditaufnahme, keine Bürokratie. Sie bauen auf, ohne alles zu riskieren.</p>
        </div>
        <div class="pt-card">
          <h3>Sichtbarer Weg</h3>
          <p>Standortleitung → mehrere Standorte → Regionalverantwortung. Wer stark führt, wächst mit.</p>
        </div>
      </div>

      <p class="pt-note">Wer über Jahre stark führt, kann im Einzelfall in ein Partnermodell wechseln – nach persönlicher Absprache, nicht über das Bewerbungsformular.</p>
    </div>
  </section>

  <!-- 9b. STANDORT-STATUS -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Standort-Status</div>
      <h2 class="section-title">Wo TCM.ch heute steht</h2>
      <p class="pt-body">Die 8 grössten Städte der Schweiz. Drei Standorte sind aktiv, fünf Positionen sind offen.</p>

      <div class="pt-st-progress">
        <div class="pt-st-bar"><span style="width:25%"></span></div>
        <div class="pt-st-bar-label">2 / 8 Städte live</div>
      </div>

      <div class="pt-st-grid">
        <div class="pt-st-box pt-st--planned" aria-label="Zürich — Standort in Planung">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>In Planung</span>
          <div class="pt-st-city">Zürich</div>
          <div class="pt-st-meta">3 Standorte</div>
        </div>
        <div class="pt-st-box pt-st--live">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Live</span>
          <div class="pt-st-city">Winterthur</div>
          <div class="pt-st-meta">2 Standorte</div>
        </div>
        <div class="pt-st-box pt-st--live">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Live</span>
          <div class="pt-st-city">St. Gallen</div>
          <div class="pt-st-meta">1 Standort</div>
        </div>
        <a class="pt-st-box pt-st--open" href="#partnerprofil" aria-label="Basel — Standortleitung offen, jetzt für die Standortleitung bewerben">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Offen</span>
          <div class="pt-st-city">Basel</div>
          <div class="pt-st-meta">Standortleitung gesucht</div>
          <div class="pt-st-cta">Jetzt für die Standortleitung bewerben&nbsp;→</div>
        </a>
        <a class="pt-st-box pt-st--open" href="#partnerprofil" aria-label="Luzern — Standortleitung offen, jetzt für die Standortleitung bewerben">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Offen</span>
          <div class="pt-st-city">Luzern</div>
          <div class="pt-st-meta">Standortleitung gesucht</div>
          <div class="pt-st-cta">Jetzt für die Standortleitung bewerben&nbsp;→</div>
        </a>
        <a class="pt-st-box pt-st--open" href="#partnerprofil" aria-label="Bern — Standortleitung offen, jetzt für die Standortleitung bewerben">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Offen</span>
          <div class="pt-st-city">Bern</div>
          <div class="pt-st-meta">Standortleitung gesucht</div>
          <div class="pt-st-cta">Jetzt für die Standortleitung bewerben&nbsp;→</div>
        </a>
        <a class="pt-st-box pt-st--open" href="#partnerprofil" aria-label="Lausanne — Standortleitung offen, jetzt für die Standortleitung bewerben">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Offen</span>
          <div class="pt-st-city">Lausanne</div>
          <div class="pt-st-meta">Standortleitung gesucht</div>
          <div class="pt-st-cta">Jetzt für die Standortleitung bewerben&nbsp;→</div>
        </a>
        <a class="pt-st-box pt-st--open" href="#partnerprofil" aria-label="Genf — Standortleitung offen, jetzt für die Standortleitung bewerben">
          <span class="pt-st-tag"><i class="pt-st-dot"></i>Offen</span>
          <div class="pt-st-city">Genf</div>
          <div class="pt-st-meta">Standortleitung gesucht</div>
          <div class="pt-st-cta">Jetzt für die Standortleitung bewerben&nbsp;→</div>
        </a>
      </div>

      <p class="pt-note">Standorte entstehen um starke Menschen herum. Wer eine offene Stadt als Standortleitung übernimmt, baut sie von Anfang an mit.</p>
      <p class="pt-note">Die Standortleitung ist eine Anstellung bei TCM.ch – keine Beteiligung und kein unternehmerisches Risiko. Sie führen den Standort, wir übernehmen Aufbau, Administration und Marketing.</p>
      <a class="btn btn--primary pt-st-btn" href="#partnerprofil">Bewerbung starten</a>
    </div>
  </section>

  <!-- 10. FORMULAR -->
  <section class="section" id="partnerprofil">
    <div class="wrap pt-form-wrap">
      <div class="section-label">Bewerbung</div>
      <h2 class="section-title">Bewerbung unverbindlich starten</h2>
      <p class="pt-body" style="margin-bottom:24px">Kostenlos und unverbindlich. Wir prüfen Ihr Profil und melden uns mit einer realistischen Einschätzung.</p>

      <form class="form-card pt-form" id="pt-form" novalidate>
        <div class="hp" aria-hidden="true"><label>Dieses Feld leer lassen <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <input type="hidden" name="quelle" value="Partner Karriere" />

        <fieldset class="pt-fieldset">
          <legend>Persönlich</legend>
          <div class="form-row">
            <div class="field"><label for="name">Name <span class="req">*</span></label><input id="name" name="name" type="text" required autocomplete="name" /></div>
            <div class="field"><label for="email">E-Mail <span class="req">*</span></label><input id="email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="telefon">Telefon</label><input id="telefon" name="telefon" type="tel" autocomplete="tel" inputmode="tel" /></div>
            <div class="field"><label for="ort">Land / Stadt</label><input id="ort" name="ort" type="text" /></div>
          </div>
          <div class="field"><label for="sprachen">Sprachen</label><input id="sprachen" name="sprachen" type="text" placeholder="z. B. Deutsch, Englisch, Mandarin" /></div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Fachlich</legend>
          <div class="form-row">
            <div class="field"><label for="qualifikation">Hauptqualifikation</label><input id="qualifikation" name="qualifikation" type="text" placeholder="z. B. TCM-Therapeutin, Akupunkteur, Ärztin" /></div>
            <div class="field"><label for="erfahrung">Jahre Erfahrung</label><input id="erfahrung" name="erfahrung" type="text" inputmode="numeric" /></div>
          </div>
          <div class="field"><label>Methoden</label>
            <div class="pt-checks">{methodenOpts.map((m) => <label class="pt-check"><input type="checkbox" name="methoden" value={m} />{m}</label>)}</div></div>
          <div class="field"><label>Anerkennungsstatus</label>
            <div class="pt-checks">{anerkennungOpts.map((a) => <label class="pt-check"><input type="checkbox" name="anerkennung" value={a} />{a}</label>)}</div></div>
          <div class="form-row">
            <div class="field"><label for="bewilligung">Arbeitsbewilligung / Visa-Status</label><input id="bewilligung" name="bewilligung" type="text" /></div>
            <div class="field"><label for="anstellung">Aktuelle Anstellung / selbstständig</label><input id="anstellung" name="anstellung" type="text" /></div>
          </div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Standort & Rolle</legend>
          <div class="field"><label>Wunsch-Standorte</label>
            <div class="pt-checks">{standortOpts.map((s) => <label class="pt-check"><input type="checkbox" name="standorte" value={s} />{s}</label>)}</div></div>
          <div class="form-row">
            <div class="field"><label for="umzug">Umzugsbereitschaft</label><select id="umzug" name="umzug"><option value="">Bitte wählen</option><option>Ja</option><option>Nein</option></select></div>
            <div class="field"><label for="pensum">Wunschpensum %</label><input id="pensum" name="pensum" type="text" inputmode="numeric" placeholder="z. B. 80" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="start">Frühester Start</label><input id="start" name="start" type="text" placeholder="z. B. ab sofort, 01.2027" /></div>
            <div class="field"><label for="interesse">Interesse an</label>
              <select id="interesse" name="interesse">
                <option value="">Bitte wählen</option>
                <option>Anstellung</option><option>Senior</option><option>Standortleitung</option>
                <option>Neuen Standort mitaufbauen</option><option>Standortleitung</option><option>Noch unsicher</option>
              </select></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="patienten">Bestehende Patienten / lokales Netzwerk</label><select id="patienten" name="patienten"><option value="">Bitte wählen</option><option>Ja</option><option>Nein</option></select></div>
            <div class="field"><label for="fuehrung">Erfahrung Klinik-/Teamführung</label><select id="fuehrung" name="fuehrung"><option value="">Bitte wählen</option><option>Ja</option><option>Nein</option></select></div>
          </div>
          <div class="field"><label for="stadt">Stärkste Stadt + Begründung</label><textarea id="stadt" name="stadt" placeholder="In welcher Stadt sind Sie am stärksten, und warum?"></textarea></div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Dokumente <span class="opt">(optional)</span></legend>
          <label class="pt-upload" for="files">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span><strong>CV, Diplome, Anerkennungsdokumente hochladen</strong><br />PDF, JPG oder PNG · max. 10 MB gesamt</span>
            <input id="files" name="files" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" multiple />
          </label>
          <ul class="pt-filelist" id="pt-filelist" hidden></ul>
          <div class="pt-fileerr" id="pt-fileerr" role="alert" hidden></div>
        </fieldset>

        <fieldset class="pt-fieldset">
          <legend>Motivation</legend>
          <div class="field"><label for="motivation">Warum TCM.ch? Was macht Sie zu einer starken Standortleiterin oder einem starken Standortleiter für einen künftigen Standort?</label><textarea id="motivation" name="motivation" rows="4"></textarea></div>
        </fieldset>

        <div class="cf-turnstile" data-sitekey={site.turnstileSitekey} style="margin:4px 0 14px"></div>
        <button class="btn btn--primary" type="submit"><span class="btn-label">Bewerbung unverbindlich starten</span></button>
        <div class="form-status" role="status" aria-live="polite" hidden></div>
        <p class="pt-privacy">Übermittlung verschlüsselt und vertraulich. Ihre Angaben werden ausschliesslich zur Prüfung Ihres Profils verwendet. <a href="/datenschutz/">Datenschutz</a>.</p>
      </form>
    </div>
  </section>

  <!-- 11. STANDORT-TEASER -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap pt-narrow pt-teaser">
      <h2 class="section-title">Neue Standorte entstehen um starke Menschen herum.</h2>
      <p class="pt-body">Wir eröffnen neue TCM.ch Standorte nicht nur nach Karte, sondern nach Qualität. Wenn eine starke Therapeutin oder ein starker Therapeut zu uns passt, kann daraus der nächste Standort entstehen.</p>
      <a class="btn btn--primary" href="#partnerprofil">Bewerbung starten</a>
    </div>
  </section>

  <!-- 12. FAQ -->
  <section class="section">
    <div class="wrap pt-narrow">
      <div class="section-label">FAQ</div>
      <h2 class="section-title">Häufige Fragen</h2>
      <div class="pt-faq">
        {faqs.map((f) => (
          <details class="pt-faq-item">
            <summary>{f.q}</summary>
            <div class="pt-faq-a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var MAX_TOTAL = 10 * 1024 * 1024;
      var OK_EXT = /\.(pdf|jpe?g|png)$/i;
      var form = document.getElementById('pt-form');
      if (!form) return;
      var input = document.getElementById('files');
      var listEl = document.getElementById('pt-filelist');
      var errEl = document.getElementById('pt-fileerr');
      var status = form.querySelector('.form-status');
      var label = form.querySelector('.btn-label');
      function fmt(b) { return b < 1048576 ? Math.round(b / 1024) + ' KB' : (b / 1048576).toFixed(1) + ' MB'; }
      function showErr(msg) { errEl.hidden = !msg; errEl.textContent = msg || ''; }
      function show(state, msg) { status.hidden = false; status.setAttribute('data-state', state); status.textContent = msg; }
      function validateFiles() {
        var files = input.files ? Array.prototype.slice.call(input.files) : [];
        listEl.innerHTML = ''; listEl.hidden = files.length === 0;
        var total = 0, bad = '';
        files.forEach(function (f) {
          total += f.size;
          var typeOk = OK_EXT.test(f.name) || ['application/pdf', 'image/jpeg', 'image/png'].indexOf(f.type) !== -1;
          if (!typeOk) bad = 'Nicht unterstützter Dateityp: ' + f.name + ' (nur PDF, JPG, PNG).';
          var li = document.createElement('li'); li.textContent = f.name + ' · ' + fmt(f.size); listEl.appendChild(li);
        });
        if (bad) { showErr(bad); return false; }
        if (files.length > 8) { showErr('Maximal 8 Dateien.'); return false; }
        if (total > MAX_TOTAL) { showErr('Dateien zusammen zu gross (' + fmt(total) + '). Maximal 10 MB.'); return false; }
        showErr(''); return true;
      }
      input.addEventListener('change', validateFiles);
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (form.querySelector('[name="website"]').value.trim() !== '') return;
        if (!form.checkValidity()) { form.reportValidity(); return; }
        if (!validateFiles()) return;
        var tokenEl = form.querySelector('[name="cf-turnstile-response"]');
        var token = tokenEl && tokenEl.value ? tokenEl.value : '';
        if (!token) { show('error', 'Bitte bestätigen Sie, dass Sie kein Roboter sind, und versuchen Sie es erneut.'); return; }
        var fd = new FormData(form); fd.set('turnstileToken', token);
        form.classList.add('is-sending');
        if (label) { label.dataset.orig = label.textContent; label.textContent = 'Wird gesendet…'; }
        try {
          var res = await fetch('/api/partner', { method: 'POST', body: fd });
          var data = null; try { data = await res.json(); } catch (_) {}
          if (res.ok && data && data.ok) {
            form.reset(); listEl.hidden = true; listEl.innerHTML = ''; showErr('');
            show('success', 'Vielen Dank. Ihre Bewerbung ist eingegangen. Wir melden uns mit einer realistischen Einschätzung möglicher nächster Schritte.');
            form.querySelectorAll('input,select,textarea,button').forEach(function (el) { el.disabled = true; });
          } else {
            var map = { missing_fields: 'Bitte füllen Sie Name und E-Mail aus.', too_large: 'Dateien zusammen zu gross (max. 10 MB).', bad_file_type: 'Nicht unterstützter Dateityp (nur PDF, JPG, PNG).', too_many_files: 'Maximal 8 Dateien.', turnstile_failed: 'Sicherheitsprüfung fehlgeschlagen. Bitte erneut versuchen.' };
            show('error', map[data && data.error] || 'Profil konnte nicht gesendet werden. Bitte erneut versuchen.');
          }
        } catch (err) { show('error', 'Verbindungsfehler. Bitte erneut versuchen.'); }
        finally {
          form.classList.remove('is-sending');
          if (label && label.dataset.orig) label.textContent = label.dataset.orig;
          if (window.turnstile) { try { window.turnstile.reset(); } catch (_) {} }
        }
      });
    })();
  </script>
</LayoutDe>

<style>
