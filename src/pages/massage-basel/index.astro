---
// /massage-basel - City-Landingpage für "massage basel". Template 1:1 von
// /massage-frauenfeld/ und /massage-kreuzlingen/: SpaPage + InsuranceBanner +
// geteilte .msg-* Styles.
// Anti-Kannibalisierung: targetet ausschliesslich "massage basel". Kein
// "tcm basel" / "akupunktur basel" in Title, H1 oder H2s (gehört
// /standorte/...), und "tuina" generisch bleibt bei /therapien/tuina/.
// Aktiver Standort: Steinenvorstadt 73, 4051 Basel. Termin-Anfrage via MassageAnfrageForm.
import SpaPage from '../../layouts/SpaPage.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../components/MassageAnfrageForm.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import bodyRaw from '../../data/massage-basel-body.html?raw';
import css from '../../data/massage-city.css?raw';

const [heroPart, restPart] = bodyRaw.split('<!--BANNER-->');

// Qualifizierter Longtail für Basel. "massage basel" selbst hat 5.400 Suchanfragen bei
// KD 33 - gegen physiozentrum, Origin Massage und Treatwell ist das ein Mehrjahreskampf.
// Diese drei Varianten sind es nicht, und sie treffen genau unsere Positionierung
// (Semrush CH, 09/2026):
//   medizinische massage basel 320 / KD 27 · lymphdrainage basel 260 / KD 10
//   sportmassage basel 90 / KD 12
// Bleibt innerhalb der Anti-Kannibalisierungs-Regel oben: alles Varianten von
// "massage basel", nichts aus dem tcm-/akupunktur-Feld.
const ARROW = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
const longtailBlock = `
<section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="wrap">
    <div class="section-label">Im Detail</div>
    <h2 class="section-title">Drei Behandlungen, nach denen in Basel <em>am häufigsten gesucht wird.</em></h2>
    <p class="section-sub" style="margin-bottom:8px">Was sie unterscheidet und wann welche sinnvoll ist.</p>
    <div class="msg-prose" style="max-width:none">
      <h3 style="font-size:20px;font-weight:800;color:var(--black);margin:26px 0 10px">Medizinische Massage in Basel</h3>
      <p>Der übliche Einstieg bei einem konkreten Befund: verspannte Nacken- und Schultermuskulatur, ein überlasteter unterer Rücken, eine Schulter, die nach dem Sturz nicht mehr richtig mitmacht. Sie wird geplant statt improvisiert und ist über die Zusatzversicherung abrechenbar, ohne ärztliche Verordnung. Wie sie sich von einer Entspannungsmassage unterscheidet, steht auf der Seite zur <a href="/therapien/massage/medizinische-massage/">medizinischen Massage</a>.</p>
      <h3 style="font-size:20px;font-weight:800;color:var(--black);margin:26px 0 10px">Lymphdrainage in Basel</h3>
      <p>Eine sehr sanfte Grifftechnik, die mit einer kräftigen Massage wenig gemein hat. Eingesetzt bei Schwellungen und Wassereinlagerungen, etwa nach Operationen, bei Venenproblemen oder in der Schwangerschaft. Wer eine Lymphdrainage erwartet und eine Sportmassage bekommt, ist bei der falschen Adresse - Details auf der <a href="/therapien/massage/lymphdrainage/">Lymphdrainage-Seite</a>.</p>
      <h3 style="font-size:20px;font-weight:800;color:var(--black);margin:26px 0 10px">Sportmassage in Basel</h3>
      <p>Kräftiger dosiert, vor oder nach der Belastung, mit anderem Ziel als eine Entspannungsmassage. Für alle, die regelmässig trainieren und den Unterschied zwischen Muskelkater und einem Problem kennen wollen. Mehr auf der <a href="/therapien/massage/sportmassage/">Sportmassage-Seite</a>.</p>
      <p style="margin-top:18px">Alle drei rechnest du bei EMR- und ASCA-anerkannten Therapeut:innen über die Zusatzversicherung ab. Was genau übernommen wird, steht unter <a href="/krankenkassen/massage/">Massage und Krankenkasse</a>.</p>
    </div>
    <div class="msg-pills" style="margin-top:22px">
      <a class="msg-pill" href="/therapien/massage/medizinische-massage/">${ARROW}Medizinische Massage</a>
      <a class="msg-pill" href="/therapien/massage/lymphdrainage/">${ARROW}Lymphdrainage</a>
      <a class="msg-pill" href="/therapien/massage/sportmassage/">${ARROW}Sportmassage</a>
      <a class="msg-pill" href="/therapien/massage/triggerpunktmassage/">${ARROW}Triggerpunktmassage</a>
      <a class="msg-pill" href="/therapien/massage/">${ARROW}Alle Massagearten</a>
    </div>
  </div>
</section>`;

const url = 'https://tcm.ch/massage-basel/';
const title = 'Massage Basel – Medizinische Massage & Tuina | TCM.ch';
const description = "Massage Basel, Steinenvorstadt 73: medizinische Massage, Tuina, Schröpfen und Gua Sha. EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar. Jetzt Termin anfragen.";

const faqs = [
  { q: "Wie buche ich in Basel einen Termin?", a: "Frag deinen Termin über das Formular oder direkt an termine@tcm.ch an, mit Behandlung und Wunschzeitraum. Wir melden uns für die Terminvereinbarung. Die Praxis liegt an der Steinenvorstadt 73, 4051 Basel." },
  { q: "Was kostet eine Massage bei euch?", a: "Eine medizinische Massage oder eine Tuina-Behandlung dauert 45 bis 60 Minuten und kostet rund 130 bis 160 Franken. Kürzere Behandlungen wie Schröpfen oder Gua Sha liegen bei 30 bis 40 Minuten und rund 90 bis 120 Franken. Abgerechnet wird nach dem anerkannten Tarif 590 nach tatsächlicher Dauer. Die Tarife sind an allen Standorten gleich, auch in Basel." },
  { q: "Zahlt die Krankenkasse eine Massage?", a: "Bei medizinisch indizierten Behandlungen durch EMR- und ASCA-anerkannte Therapeut:innen beteiligt sich die Zusatzversicherung für Komplementärmedizin, je nach Modell 50 bis 90 Prozent, bei guten Policen mehr. Die Grundversicherung übernimmt keine Massagen, und reine Entspannungsmassagen zahlst du selbst. Eine ärztliche Verordnung ist nicht nötig." },
  { q: "Was zahle ich als Grenzgänger:in?", a: "Entscheidend ist deine Versicherung, nicht dein Wohnort. Wer in der Schweiz grundversichert ist, kann eine Zusatzversicherung für Komplementärmedizin abschliessen und darüber abrechnen, genau wie alle anderen. Bist du in Deutschland oder Frankreich versichert, zahlst du selbst und reichst die Rechnung dort ein. Du bekommst von uns eine detaillierte Rechnung mit ZSR-Nummer, mit der du bei deinem Versicherer einreichen kannst." },
  { q: "Kostet die Termin-Anfrage etwas?", a: "Nein. Es braucht nur eine E-Mail-Adresse, keine Anzahlung und keine Verpflichtung. Wir melden uns nur zur Terminvereinbarung. Keine Werbung, keine Weitergabe an Dritte." },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 3, name: 'Massage Basel', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/massage-basel" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Basel" />
  <Fragment set:html={restPart} />
  <Fragment set:html={longtailBlock} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="massage-basel" />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Massage-Team TCM.ch" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
