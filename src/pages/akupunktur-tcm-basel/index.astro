---
// /akupunktur-tcm-basel — Stadt-Landingpage für Basel, nach dem Muster von
// /akupunktur-tcm-zuerich/ und /akupunktur-tcm-st-gallen/.
//
// Warum jetzt, obwohl die Praxis erst 2028 eröffnet: "akupunktur basel" hat 590
// Suchanfragen/Monat bei KD 8 — der niedrigste Difficulty-Wert, den wir auf dieser Domain
// gemessen haben (Semrush CH, 09/2026). Rankings brauchen 6 bis 18 Monate. Wer zur
// Eröffnung sichtbar sein will, fängt nicht zur Eröffnung an.
//
// Der Local Pack ist bis zur Adresse verschlossen (kein Google-Business-Profil ohne
// Standort). Diese Seite zielt deshalb bewusst auf die organischen Plätze darunter und auf
// den Baselbieter Longtail, wo gar kein Pack ausgespielt wird.
//
// Pre-Opening-Regeln wie auf /standorte/basel/: Warteliste statt Termin-CTA, KEIN
// MedicalClinic-Schema (erst mit Adresse), keine Öffnungszeiten, keine Anfahrt.
export const prerender = true;
import SpaPage from '../../layouts/SpaPage.astro';
import MassageAnfrageForm from '../../components/MassageAnfrageForm.astro';
import css from '../../data/massage-city.css?raw';

const url = 'https://tcm.ch/akupunktur-tcm-basel/';
const title = 'Akupunktur Basel – TCM-Praxis ab 2028 | TCM.ch';
const description = 'Akupunktur und TCM in Basel: TCM.ch eröffnet 2028 zentral in der Stadt, EMR-/ASCA-anerkannt, über die Zusatzversicherung abrechenbar. Jetzt auf die Warteliste.';

const faqs = [
  { q: 'Ab wann gibt es TCM.ch in Basel?', a: 'Die Eröffnung ist für 2028 geplant, die Adresse steht noch nicht fest. Auf der Warteliste bekommst du Bescheid, sobald Termine vergeben werden — und zwar vor allen anderen.' },
  { q: 'Was kann ich bis dahin machen?', a: 'Wenn du nicht warten willst: Unsere nächstgelegene Praxis erreichst du in gut einer Stunde. Für Anliegen, die keine Behandlung vor Ort brauchen, kannst du dich vorab per WhatsApp oder E-Mail bei uns melden, wir sagen dir ehrlich, ob sich der Weg lohnt.' },
  { q: 'Übernimmt die Krankenkasse Akupunktur in Basel?', a: 'Über die Zusatzversicherung für Komplementärmedizin ja, in der Regel mit 70 bis 90 Prozent pro Sitzung. Unsere Therapeut:innen sind EMR- und ASCA-anerkannt und arbeiten unter anerkannter ZSR-Nummer. Die Grundversicherung übernimmt Akupunktur nur bei Ärztinnen und Ärzten mit komplementärmedizinischer Weiterbildung.' },
  { q: 'Was kostet eine Sitzung?', a: 'Abgerechnet wird nach Tarif 590 nach Dauer. Die Tarife sind im ganzen TCM.ch-Netzwerk identisch, unabhängig vom Standort. Die Details stehen auf der Kostenseite.' },
  { q: 'Brauche ich eine Überweisung vom Arzt?', a: 'Nein. Für die Abrechnung über die Zusatzversicherung genügt die Behandlung bei einer anerkannten Fachperson. Wenn wir im Erstgespräch merken, dass dein Anliegen zuerst ärztlich abgeklärt gehört, sagen wir dir das.' },
  { q: 'Behandelt ihr auch Menschen aus dem Baselbiet?', a: 'Ja. Basel-Stadt und Baselland sind mit dem ÖV eng verbunden, aus Liestal, Sissach, Binningen, Münchenstein, Reinach, Allschwil oder Riehen bist du in wenigen Minuten in der Stadt.' },
];

const ARROW = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
const CHECK = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

const REGION = ['Basel-Stadt', 'Riehen', 'Binningen', 'Allschwil', 'Münchenstein', 'Reinach', 'Liestal', 'Sissach', 'Muttenz', 'Pratteln', 'Oberwil', 'Therwil'];

const body = `
<div class="msg-page">

<section class="section msg-hero">
  <div class="wrap">
    <div class="msg-crumb"><a href="/">TCM.ch</a> <span>&rsaquo;</span> <a href="/standorte/">Standorte</a> <span>&rsaquo;</span> <span>Basel</span></div>
    <div class="msg-hero-grid">
      <div>
        <h1 class="msg-h1">Akupunktur und TCM in <em>Basel.</em></h1>
        <p class="msg-lead">Wir eröffnen 2028 eine Praxis in Basel. Bis dahin steht hier, was du wissen solltest: wie wir arbeiten, was eine Behandlung kostet, was die Zusatzversicherung übernimmt und wie du dir einen der ersten Termine sicherst. Ehrlich gesagt: heute buchen kannst du noch nichts.</p>
        <div class="msg-hero-ctas">
          <a href="#anfrage" class="btn-primary">Auf die Warteliste</a>
          <a href="/standorte/basel/" class="btn-secondary">Zum Standort Basel</a>
        </div>
        <div class="msg-hero-trust">
          <span>${CHECK}EMR &amp; ASCA anerkannt</span>
          <span>${CHECK}Eröffnung 2028</span>
          <span>${CHECK}Warteliste offen</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-label">Was entsteht</div>
    <h2 class="section-title">Eine TCM-Klinik, keine <em>Wohlfühlpraxis.</em></h2>
    <div class="msg-prose">
      <p>TCM.ch betreibt Praxen in der Deutschschweiz mit einem klaren Anspruch: chinesische Medizin als Behandlung, nicht als Wellness-Angebot. Das heisst bei uns Anamnese vor der ersten Nadel, ein Behandlungsplan mit einem definierten Zeitpunkt zur Überprüfung, und die Bereitschaft zu sagen, wenn eine Methode bei deinem Anliegen wenig bringt.</p>
      <p>Alle Therapeut:innen sind EMR- und ASCA-anerkannt und arbeiten unter anerkannter ZSR-Nummer. Praktisch heisst das für dich, dass deine Zusatzversicherung sich beteiligt und du keine ärztliche Überweisung brauchst.</p>
      <p>Was wir nicht machen: Heilversprechen, Pakete, die im Voraus zu kaufen sind, und den Rat, ärztliche Therapien abzusetzen. Wenn dir das anderswo begegnet, ist es ein Warnzeichen.</p>
    </div>
  </div>
</section>

<section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="wrap">
    <div class="section-label">Behandlungen</div>
    <h2 class="section-title">Was es in Basel <em>geben wird.</em></h2>
    <p class="section-sub" style="margin-bottom:8px">Dasselbe Spektrum wie an unseren bestehenden Standorten. Jede Seite erklärt Ablauf, Wirkung und Grenzen.</p>
    <div class="msg-group"><div class="msg-arts">
      <a class="msg-art" href="/therapien/akupunktur/"><div class="msg-art-t">Akupunktur${ARROW}</div><div class="msg-art-d">Der Kern der Behandlung. Am häufigsten bei Schmerzen, Schlafproblemen und stressbedingten Beschwerden.</div></a>
      <a class="msg-art" href="/therapien/tuina/"><div class="msg-art-t">Tuina${ARROW}</div><div class="msg-art-d">Die manuelle Therapie der chinesischen Medizin, mit Druck-, Schiebe- und Dehngriffen am bekleideten Körper.</div></a>
      <a class="msg-art" href="/therapien/schroepfen/"><div class="msg-art-t">Schröpfen${ARROW}</div><div class="msg-art-d">Unterdruck statt Druck, spürbar tiefer als eine Massage. Auch als Hijama.</div></a>
      <a class="msg-art" href="/therapien/kraeutertherapie/"><div class="msg-art-t">Kräutertherapie${ARROW}</div><div class="msg-art-d">Individuell zusammengestellte Rezepturen, oft dort sinnvoll, wo Nadeln allein zu kurz greifen.</div></a>
      <a class="msg-art" href="/therapien/ohrakupunktur/"><div class="msg-art-t">Ohrakupunktur${ARROW}</div><div class="msg-art-d">Die Ohrmuschel als eigenes Punktesystem, allein oder ergänzend. Auch als Dauernadeln für zu Hause.</div></a>
      <a class="msg-art" href="/therapien/"><div class="msg-art-t">Alle Therapien${ARROW}</div><div class="msg-art-d">Moxibustion, Akupressur, Shiatsu, Gua Sha, Gesichtsakupunktur und Physiotherapie im Überblick.</div></a>
    </div></div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-label">Für wen</div>
    <h2 class="section-title">Womit Menschen zu uns <em>kommen.</em></h2>
    <p class="section-sub" style="margin-bottom:6px">Die häufigsten Anliegen an unseren bestehenden Standorten. Jede Seite sagt auch, wann TCM nicht das richtige Mittel ist.</p>
    <div class="msg-pills">
      <a class="msg-pill" href="/beschwerden/rueckenschmerzen/">${ARROW}Rückenschmerzen</a>
      <a class="msg-pill" href="/beschwerden/nackenschmerzen/">${ARROW}Nackenschmerzen</a>
      <a class="msg-pill" href="/beschwerden/migraene/">${ARROW}Migräne</a>
      <a class="msg-pill" href="/beschwerden/schlafprobleme/">${ARROW}Schlafprobleme</a>
      <a class="msg-pill" href="/beschwerden/stress-burnout/">${ARROW}Stress und Burnout</a>
      <a class="msg-pill" href="/beschwerden/kinderwunsch/">${ARROW}Kinderwunsch</a>
      <a class="msg-pill" href="/beschwerden/">${ARROW}Alle Beschwerden</a>
    </div>
  </div>
</section>

<section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)" id="kosten">
  <div class="wrap">
    <div class="section-label">Kosten</div>
    <h2 class="section-title">Was eine Behandlung <em>kostet.</em></h2>
    <div class="msg-kk-grid">
      <div class="msg-prose" style="max-width:none">
        <p>Abgerechnet wird nach Tarif 590 nach Dauer. Die Tarife sind im ganzen TCM.ch-Netzwerk identisch — der Standort ändert am Preis nichts. Die Erstkonsultation dauert länger als eine Folgesitzung, weil die Anamnese Zeit braucht, und liegt entsprechend höher.</p>
        <p>Über deine Zusatzversicherung für Komplementärmedizin kommen je nach Police meist 70 bis 90 Prozent zurück, gedeckelt durch ein Jahresmaximum. Eine ärztliche Überweisung brauchst du nicht. Details stehen unter <a href="/standorte/basel/kosten/">Akupunktur Kosten Basel</a> und <a href="/krankenkassen/akupunktur/">Akupunktur und Krankenkasse</a>.</p>
        <p>Ein praktischer Hinweis, wenn du ohnehin über einen Kassenwechsel nachdenkst: Der Unterschied zwischen einer guten und einer schwachen Komplementärmedizin-Deckung ist bei regelmässiger Behandlung schnell vierstellig im Jahr. Bis 2028 hast du Zeit, das zu prüfen.</p>
      </div>
      <aside class="msg-kk-aside">
        <h3>Kurz zusammengefasst</h3>
        <ul>
          <li>Tarif 590, netzweit identisch</li>
          <li>Zusatzversicherung statt Grundversicherung</li>
          <li>Keine Überweisung nötig</li>
          <li>EMR- und ASCA-anerkannt</li>
        </ul>
        <a href="#anfrage" class="btn-primary" style="margin-top:16px;width:100%;justify-content:center">Deckung prüfen lassen</a>
      </aside>
    </div>
  </div>
</section>

<section class="section" id="region">
  <div class="wrap">
    <div class="section-label">Einzugsgebiet</div>
    <h2 class="section-title">Basel-Stadt und <em>Baselland.</em></h2>
    <p class="section-sub" style="margin-bottom:6px">Die Region ist mit dem ÖV eng verbunden. Aus diesen Gemeinden bist du in wenigen Minuten in der Stadt:</p>
    <div class="msg-pills">${REGION.map((o) => `<span class="msg-pill" style="cursor:default">${o}</span>`).join('')}</div>
    <div class="msg-prose" style="margin-top:24px">
      <p>Wir eröffnen bewusst eine Praxis in der Stadt statt mehrerer kleiner in der Agglomeration. Aus Liestal bist du mit der S-Bahn in gut zwanzig Minuten am Bahnhof SBB, aus Sissach in gut dreissig. Das ist für die meisten näher als eine Praxis im eigenen Dorf, die nur zweimal pro Woche geöffnet hat.</p>
    </div>
  </div>
</section>

<section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="wrap">
    <div class="section-label">Häufige Fragen</div>
    <h2 class="section-title">Akupunktur in Basel, gut zu wissen.</h2>
    <div class="msg-faq" style="margin-top:10px">
      ${faqs.map((f, i) => `<details${i === 0 ? ' open' : ''}><summary>${f.q}</summary><p class="msg-faq-a">${f.a}</p></details>`).join('')}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div style="background:var(--green-mint);border:1px solid var(--green-mid);border-radius:var(--r-card,16px);padding:34px 30px;text-align:center;max-width:760px;margin:0 auto">
      <h2 class="section-title" style="margin-bottom:10px">Einer der ersten Termine <em>in Basel?</em></h2>
      <p class="section-sub" style="margin:0 auto 20px">Auf der Warteliste bekommst du Bescheid, sobald wir Termine vergeben. Kein Newsletter, keine Werbung — eine Nachricht, wenn es so weit ist.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="#anfrage" class="btn-primary">Auf die Warteliste</a>
        <a href="/massage-basel/" class="btn-secondary">Massage in Basel</a>
      </div>
      <p style="font-size:13px;color:var(--muted);margin:16px 0 0">Fragen? Schreib an <a href="mailto:termine@tcm.ch" style="color:var(--green-dark)">termine@tcm.ch</a>.</p>
    </div>
  </div>
</section>

</div>`;

// Kein MedicalClinic-Schema: Ohne Adresse und Öffnungszeiten wäre das eine Behauptung
// über einen Betrieb, den es noch nicht gibt. Erst mit der Eröffnung.
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
    { '@type': 'ListItem', position: 3, name: 'Akupunktur Basel', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/akupunktur-tcm-basel" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={body} />
  <MassageAnfrageForm
    anfrageTyp="warteliste"
    quelle="warteliste-basel-akupunktur"
    heading="Auf die <em>Warteliste.</em>"
    sub="Wir melden uns, sobald in Basel Termine vergeben werden. Sonst nichts."
  />
</SpaPage>
