---
// /akupunktur-in-der-naehe/ — kommerzielle "in der Nähe"-Landingpage.
// Targets: "akupunktur in der nähe", "tcm in der nähe", "akupunktur massage in der nähe".
// Standortdaten: einzige Quelle = src/data/locations.ts (clinics). Offer-Block: home-body.html.
export const prerender = true;
import SpaPage from '../layouts/SpaPage.astro';
import { clinics } from '../data/locations';
import homeBody from '../data/home-body.html?raw';

const url = 'https://tcm.ch/akupunktur-in-der-naehe/';
const title = 'Akupunktur in deiner Nähe: 14 Standorte Schweiz | TCM.ch';
const description =
  'Akupunktur, TCM und Tuina-Massage in deiner Nähe: 13 EMR-/ASCA-anerkannte Standorte in der Deutschschweiz, von Zürich bis St. Gallen. Termin oft schon in 24 Stunden.';

// Kurze deutsche Ortsbeschreibung pro Standort.
const desc: Record<string, string> = {
  'zuerich-city': 'Zentral in Zürich', 'zuerich-hoengg': 'Zürich West', 'zuerich-oerlikon': 'Zürich Nord',
  'winterthur-marktgasse': 'Altstadt Winterthur', 'winterthur-muenzgasse': 'Nahe Bahnhof', 'volketswil': 'Zürcher Oberland',
  'frauenfeld': 'Thurgau · auch für Weinfelden', 'kreuzlingen': 'Am Bodensee · auch ab Konstanz', 'bottighofen': 'Am Bodensee',
  'st-gallen': 'Beim Bahnhof', 'rorschach': 'Bodenseeregion', 'wil': 'Fürstenland',
  'basel': 'Eröffnung 2028 · Warteliste offen', 'luzern': 'Eröffnung 2027 · Warteliste offen',
};

// Regionen-Gruppierung (crawlbare Karten, keine div-onclick).
const groups = [
  { label: 'Region Zürich & Winterthur', ids: ['zuerich-city', 'zuerich-hoengg', 'zuerich-oerlikon', 'winterthur-marktgasse', 'winterthur-muenzgasse', 'volketswil'] },
  { label: 'Ostschweiz & Bodensee', ids: ['st-gallen', 'frauenfeld', 'kreuzlingen', 'wil', 'rorschach', 'bottighofen'] },
  { label: 'Basel & Nordwestschweiz', ids: ['basel'] },
  { label: 'Zentralschweiz', ids: ['luzern'] },
];
const allIds = groups.flatMap((g) => g.ids);
const card = (id: string) => {
  const c = clinics.find((x) => x.id === id);
  if (!c) return '';
  const kurz = [c.street, desc[c.id]].filter(Boolean).join(' · ');
  return `<a class="city-card location-card" href="/standorte/${c.id}/">${c.postalCode ? `<span class="location-plz">${c.postalCode}</span>` : ''}<div class="location-city">${c.name}</div><div class="location-desc">${kurz}</div><span class="location-link">Termin prüfen →</span></a>`;
};
// Basel und Luzern sind seit dem 14-Standorte-Update reguläre clinics-Einträge
// (postalCode null, deshalb rendert card() dort kein PLZ-Badge). Die frühere
// Luzern-Sonderkarte entfällt damit, sonst stünde die Stadt doppelt in der Liste.
const finderHtml = groups
  .map((g, i) => `<h3 style="font-family:var(--font-sans);font-size:18px;font-weight:800;color:var(--black);letter-spacing:-.01em;margin:${i === 0 ? '0' : '32px'} 0 14px">${g.label}</h3><div class="city-grid">${g.ids.map(card).join('')}</div>`)
  .join('');

// Home-Offer-Block ("Starte ohne Risiko") 1:1 wiederverwenden.
const os = homeBody.indexOf('<section id="s-offer"');
const offerBlock = os >= 0 ? homeBody.slice(os, homeBody.indexOf('</section>', os) + '</section>'.length) : '';

const faqs = [
  { q: 'Wo finde ich Akupunktur in meiner Nähe?', a: 'TCM.ch betreibt 14 Standorte in der Deutschschweiz, unter anderem in Zürich, Winterthur, St. Gallen, Frauenfeld und Kreuzlingen. Auf dieser Seite findest du alle Praxen mit Adresse und fragst direkt beim nächstgelegenen Standort einen Termin an.' },
  { q: 'Wie schnell bekomme ich einen Termin?', a: 'Auf deine Anfrage antworten wir meist innert einer Stunde. Ein Ersttermin ist je nach Standort oft schon innert 24 bis 48 Stunden möglich. Frag am besten über das Kontaktformular des Standorts an oder ruf uns an.' },
  { q: 'Zahlt die Krankenkasse die Behandlung?', a: 'Über die Zusatzversicherung für Komplementärmedizin beteiligen sich die meisten Kassen mit 80 bis 100 Prozent. Alle unsere Therapeutinnen und Therapeuten sind EMR- oder ASCA-registriert. Deine Deckung prüfen wir auf Wunsch kostenlos, bevor Kosten entstehen.' },
  { q: 'Bieten alle Standorte dieselben Behandlungen an?', a: 'Akupunktur und TCM-Beratung gibt es an jedem Standort. Einzelne Methoden wie Tuina-Massage, Schröpfen oder Kräutertherapie variieren je nach Team vor Ort. Auf der jeweiligen Standortseite siehst du das genaue Angebot.' },
  { q: 'Was kostet eine Akupunktursitzung?', a: 'Den aktuellen Tarif erfährst du vor der ersten Behandlung, transparent und ohne versteckte Kosten. Mit Zusatzversicherung trägst du meist nur einen kleinen Selbstbehalt. Die Abklärung deiner Kassendeckung ist bei uns kostenlos.' },
];
const faqHtml = faqs.map((f) => `<details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0"><summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">${f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary><div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">${f.a}</div></details>`).join('');

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalOrganization', name: 'TCM.ch', areaServed: { '@type': 'Country', name: 'Schweiz' } } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'TCM.ch Standorte in der Schweiz',
    itemListElement: allIds.map((id, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://tcm.ch/standorte/${id}/` })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Akupunktur in deiner Nähe', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];

const waHref = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20suche%20eine%20TCM-Praxis%20in%20meiner%20N%C3%A4he.';

const body = `<div style="padding-top:68px">
  <section class="section" style="background:var(--green-mint);border-bottom:1px solid var(--border)">
    <div class="wrap" style="max-width:760px">
      <div class="section-label">Akupunktur · Medizinische TCM</div>
      <h1 class="section-title" style="margin-bottom:16px">Akupunktur in deiner Nähe</h1>
      <p class="section-sub">Du suchst Akupunktur oder TCM in deiner Nähe? Wir sind ein Netzwerk aus 14 Praxen in der Deutschschweiz, von Zürich über Winterthur bis St. Gallen. Eine davon liegt fast sicher in deiner Nähe, und ein Termin ist oft schon innert 24 Stunden möglich.</p>
      <div class="deh-cta" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
        <a class="btn-primary" href="${waHref}" rel="nofollow">Termin anfragen · Antwort in ~1h</a>
        <a class="btn-secondary" href="#standorte">Standort finden</a>
      </div>
    </div>
  </section>

  <section class="section" id="standorte" style="background:var(--surface)">
    <div class="wrap">
      <div class="reveal" style="max-width:60ch;margin-bottom:36px">
        <div class="section-label">Standort-Finder</div>
        <h2 class="section-title">Unsere 14 Standorte <em>in der Schweiz</em></h2>
        <p class="section-sub">Wähle die Praxis in deiner Nähe. Alle Standorte sind EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar.</p>
      </div>
      ${finderHtml}
      <p class="section-sub" style="margin-top:24px">Nicht sicher, welcher Standort passt? Wir buchen dich in die nächste Klinik in deiner Nähe ein. Sieh dir auch <a href="/standorte/">alle Standorte</a> im Detail an. Im Thurgau ist <a href="/standorte/frauenfeld/">TCM Frauenfeld</a> die zentrale Adresse. Schwanger? Dann findest du auf der Seite zur <a href="/therapien/akupunktur/schwangerschaft/">Akupunktur in der Schwangerschaft</a>, was ab welcher Woche möglich ist.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:760px">
      <div class="section-label">TCM in deiner Nähe</div>
      <h2 class="section-title">Warum "in der Nähe" bei uns <em>mehr ist als ein Standort</em></h2>
      <p class="section-sub">Wenn du nach Akupunktur in deiner Nähe suchst, willst du zwei Dinge: einen kurzen Weg und eine Praxis, der du vertraust. Bei TCM.ch bekommst du beides. Wir sind kein einzelnes Studio, sondern ein Netzwerk aus 14 Praxen in der Deutschschweiz. TCM in deiner Nähe heisst bei uns konkret: in Zürich, Winterthur, Volketswil, Frauenfeld, Kreuzlingen, St. Gallen, Wil, Rorschach und Bottighofen. Die Chance ist gross, dass eine davon nur wenige Minuten von dir entfernt liegt. Dazu kommen zwei Standorte im Aufbau: <a href="/standorte/luzern/">Akupunktur und TCM in Luzern</a> ab 2027 und <a href="/standorte/basel/">Basel</a> ab 2028, für beide ist die Warteliste offen.</p>
      <p class="section-sub" style="margin-top:16px">Was alle Standorte verbindet, ist der gleiche Anspruch. An jeder Praxis behandeln EMR- oder ASCA-registrierte Therapeutinnen und Therapeuten. Diese Register prüfen Ausbildung und Weiterbildung, und sie sind die Voraussetzung dafür, dass sich deine Zusatzversicherung an den Kosten beteiligt. Ob du in der Stadt Zürich oder am Bodensee zu uns kommst: Die Qualitätsstandards sind dieselben, und die Abrechnung über die <a href="/krankenkassen/">Zusatzversicherung</a> läuft überall gleich.</p>
      <p class="section-sub" style="margin-top:16px">Das häufigste Anliegen ist die klassische <a href="/therapien/akupunktur/">Akupunktur</a>, etwa bei Rücken- und Nackenschmerzen, Kopfschmerzen, Schlafproblemen oder stressbedingten Beschwerden. Viele Standorte bieten darüber hinaus <a href="/therapien/tuina/">Tuina-Massage</a>, <a href="/therapien/schroepfen/">Schröpfen</a>, <a href="/therapien/shiatsu/">Shiatsu</a> und chinesische Kräutertherapie an. An ausgewählten Praxen ist auch <a href="/therapien/schroepfen/hijama/">Hijama</a> möglich, das blutige Schröpfen. Welche Methoden dein nächstgelegenes Team anbietet, siehst du auf der jeweiligen Standortseite.</p>
      <p class="section-sub" style="margin-top:16px">Du musst nicht vorher wissen, welche Behandlung die richtige ist. Schildere uns kurz, worum es geht und wo du wohnst. Wir schlagen dir den passenden Standort in deiner Nähe vor und, wenn du möchtest, gleich einen Termin. Meist melden wir uns innert einer Stunde, und oft ist ein Ersttermin schon innert 24 bis 48 Stunden möglich.</p>
    </div>
  </section>

  ${offerBlock}

  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Häufige Fragen</div>
      <h2 class="section-title" style="margin-bottom:20px">Das Wichtigste <em>in Kürze</em></h2>
      <div class="faq-list">${faqHtml}</div>
    </div>
  </section>

  <section class="cta-band" style="background:var(--blue);padding:48px 0">
    <div class="wrap" style="text-align:center">
      <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Akupunktur in deiner Nähe finden?</h2>
      <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Schildere kurz dein Anliegen, wir melden uns mit einem Standort in deiner Nähe. Antwort in rund einer Stunde.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn-white" href="${waHref}" rel="nofollow" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</a>
        <a href="tel:+41775236122" style="display:inline-flex;align-items:center;font-family:var(--font-sans);font-weight:700;font-size:15px;color:#fff;text-decoration:none;padding:14px 24px;border:1.5px solid rgba(255,255,255,.4);border-radius:var(--r-btn)">+41 77 523 61 22</a>
      </div>
    </div>
  </section>
</div>`;
---
<SpaPage title={title} description={description} path="/akupunktur-in-der-naehe" body={body} schema={schema} />
