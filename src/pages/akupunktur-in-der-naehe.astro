---
// /akupunktur-in-der-naehe/ — kommerzielle "in der Nähe"-Landingpage.
// Targets: "akupunktur in meiner nähe", "tcm in der nähe". Listet alle 13 Standorte.
export const prerender = true;
import SpaPage from '../layouts/SpaPage.astro';
import { clinics } from '../data/locations';

const url = 'https://tcm.ch/akupunktur-in-der-naehe/';
const title = 'Akupunktur in deiner Nähe: 13 Standorte Schweiz | TCM.ch';
const description =
  'Akupunktur und TCM in deiner Nähe: 13 EMR-/ASCA-anerkannte Standorte in der Deutschschweiz, von Zürich über Winterthur bis St. Gallen. Termin oft in 24 Stunden.';

// Curated display order (Metros zuerst) + kurze deutsche Ortsbeschreibung.
const order = ['zuerich-city','zuerich-hoengg','zuerich-oerlikon','winterthur-marktgasse','winterthur-muenzgasse','volketswil','frauenfeld','kreuzlingen','bottighofen','st-gallen','rorschach','wil','basel'];
const desc: Record<string, string> = {
  'zuerich-city': 'Zentral in Zürich', 'zuerich-hoengg': 'Zürich West', 'zuerich-oerlikon': 'Zürich Nord',
  'winterthur-marktgasse': 'Altstadt Winterthur', 'winterthur-muenzgasse': 'Nahe Bahnhof', 'volketswil': 'Zürcher Oberland',
  'frauenfeld': 'Kanton Thurgau', 'kreuzlingen': 'Am Bodensee', 'bottighofen': 'Am Bodensee',
  'st-gallen': 'Ostschweiz', 'rorschach': 'Bodenseeregion', 'wil': 'Fürstenland', 'basel': 'Innenstadt',
};
const cards = order
  .map((id) => clinics.find((c) => c.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => `<a class="city-card location-card" href="/standorte/${c.id}/">${c.postalCode ? `<span class="location-plz">${c.postalCode}</span>` : ''}<div class="location-city">${c.name}</div><div class="location-desc">${desc[c.id] ?? c.city}</div><span class="location-link">Termin prüfen →</span></a>`)
  .join('');

const faqs = [
  { q: 'Wie finde ich Akupunktur in meiner Nähe?', a: 'Schildere uns kurz dein Anliegen und deinen Wohnort. Wir buchen dich in die nächste passende TCM.ch-Klinik ein, an einem von 13 Standorten in der Deutschschweiz. So sparst du dir das lange Suchen.' },
  { q: 'Übernimmt die Krankenkasse die Akupunktur?', a: 'Akupunktur und TCM laufen über die Zusatzversicherung, nicht über die Grundversicherung. Unsere Therapeut:innen sind EMR- und ASCA-anerkannt. Bei den meisten Kassen werden 80 bis 100 Prozent übernommen. Wir prüfen das kostenlos vor deinem ersten Termin.' },
  { q: 'Wie schnell bekomme ich einen Termin?', a: 'Auf deine Anfrage antworten wir meist innert einer Stunde. Ein Ersttermin ist je nach Standort oft schon innert 24 bis 48 Stunden möglich.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
    about: { '@type': 'MedicalOrganization', name: 'TCM.ch', areaServed: { '@type': 'Country', name: 'Schweiz' } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Akupunktur in deiner Nähe', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];

const faqHtml = faqs.map((f) => `<details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0"><summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">${f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary><div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">${f.a}</div></details>`).join('');

const waHref = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20suche%20eine%20TCM-Praxis%20in%20meiner%20N%C3%A4he.';

const body = `<div style="padding-top:68px">
  <section class="section" style="background:var(--green-mint);border-bottom:1px solid var(--border)">
    <div class="wrap" style="max-width:760px">
      <div class="section-label">Akupunktur · Medizinische TCM</div>
      <h1 class="section-title" style="margin-bottom:16px">Akupunktur in deiner Nähe – <em>13 Standorte in der Schweiz</em></h1>
      <p class="section-sub">Du suchst Akupunktur oder TCM in deiner Nähe? An 13 Standorten in der Deutschschweiz, von Zürich über Winterthur bis St. Gallen, findest du eine EMR-/ASCA-anerkannte Praxis in erreichbarer Nähe. Termin oft schon innert 24 Stunden.</p>
      <div class="deh-cta" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
        <a class="btn-primary" href="${waHref}" rel="nofollow">Termin anfragen · Antwort in ~1h</a>
        <a class="btn-secondary" href="#standorte">Standort finden</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:760px">
      <div class="section-label">Akupunktur in meiner Nähe</div>
      <h2 class="section-title">Eine TCM-Praxis in der Nähe, <em>ohne langes Suchen</em></h2>
      <p class="section-sub">Wer "Akupunktur in meiner Nähe" sucht, will keinen langen Anfahrtsweg. Als Netzwerk sind wir an 13 Orten für dich da. Schildere kurz dein Anliegen und deinen Wohnort, wir buchen dich in die nächste passende Klinik ein. So findest du TCM in der Nähe, ohne dich durch Listen zu klicken.</p>
    </div>
  </section>

  <section class="section" id="standorte" style="background:var(--surface)">
    <div class="wrap">
      <div class="reveal" style="max-width:60ch;margin-bottom:36px">
        <div class="section-label">Standorte</div>
        <h2 class="section-title">Unsere 13 Standorte <em>in der Schweiz</em></h2>
        <p class="section-sub">Wähle deinen Standort. Alle Praxen sind EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar.</p>
      </div>
      <div class="city-grid">${cards}</div>
      <p class="section-sub" style="margin-top:22px">Nicht sicher, welcher Standort passt? Wir buchen dich in die nächste Klinik in deiner Nähe ein. Sieh dir auch <a href="/standorte/">alle Standorte</a> im Detail an.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:760px">
      <div class="section-label">Krankenkasse &amp; Kosten</div>
      <h2 class="section-title">Meist zahlst du <em>nichts selbst</em></h2>
      <p class="section-sub">Akupunktur und TCM laufen über die Zusatzversicherung, nicht über die Grundversicherung. Unsere Therapeut:innen sind EMR- und ASCA-anerkannt. Bei den meisten Kassen werden 80 bis 100 Prozent übernommen. Mehr dazu auf unserer Seite zur <a href="/krankenkassen/">Krankenkasse</a>.</p>
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Häufige Fragen</div>
      <h2 class="section-title" style="margin-bottom:20px">Das Wichtigste <em>in Kürze</em></h2>
      <div class="faq-list">${faqHtml}</div>
    </div>
  </section>

  <section class="cta-band" style="background:var(--blue);padding:48px 0">
    <div class="wrap" style="text-align:center">
      <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Akupunktur in deiner Nähe finden?</h2>
      <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Schildere kurz dein Anliegen, wir melden uns mit einem Standort in deiner Nähe. Antwort in rund einer Stunde.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn-white" href="${waHref}" rel="nofollow" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</a>
        <a href="tel:+41775236122" style="display:inline-flex;align-items:center;font-family:var(--font-sans);font-weight:700;font-size:15px;color:#fff;text-decoration:none;padding:14px 24px;border:1.5px solid rgba(255,255,255,.4);border-radius:var(--r-btn)">+41 77 523 61 22</a>
      </div>
    </div>
  </section>
</div>`;
---
<SpaPage title={title} description={description} path="/akupunktur-in-der-naehe" body={body} schema={schema} />
