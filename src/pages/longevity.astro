---
// Longevity – faithful static reproduction of the SPA page-longevity, with the live
// header (#mainNav) + footer + burger (#siteDrawer). Same chrome/CSS/JS as the home.
import { site } from '../data/site';
import DeHeader from '../components/DeHeader.astro';
import body from '../data/longevity-body.html?raw';

const title = 'Longevity Schweiz – Medizinische TCM für Vitalität & Prävention';
const description =
  'Länger gut leben: medizinische TCM für Vitalität, Prävention und langfristige Gesundheit. EMR-/ASCA-anerkannt, an den TCM.ch Kliniken in der Deutschschweiz.';
const canonical = 'https://tcm.ch/longevity';

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: canonical, inLanguage: 'de-CH', isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
];

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';
const html = body.replace(/__TURNSTILE_SITEKEY__/g, turnstileSitekey);
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/home.css" />
    <script is:inline>document.documentElement.classList.add('js','ready');</script>
    <style is:inline>html:not(.ready){visibility:visible !important}html:not(.js) .reveal{opacity:1 !important;transform:none !important}</style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <DeHeader />
    <Fragment set:html={html} />
    <script src="/header.js" is:inline defer></script>
    <script src="/home.js" is:inline defer></script>
  </body>
</html>
