---
// Home - faithful 1:1 static reproduction of the LIVE tcm.ch home.
// The body is the SPA home verbatim: its own header (#mainNav) + #home-content +
// <footer> + burger (#siteDrawer). Full SPA CSS bundled (public/home.css, header rules
// KEPT); interactivity in public/home.js (nav() routes the SPA's nav() calls to the DE
// Astro pages). Only functional adaptations: value=slug select, stats baked, Turnstile
// env-gated. NO voice cleanup, NO trimming - wording/layout identical to live.
import { site } from '../data/site';
import DeHeader from '../components/DeHeader.astro';
import ConcernSheet from '../components/ConcernSheet.astro';
import BookingSheet from '../components/BookingSheet.astro';
import Footer from '../components/Footer.astro';
import HeadAnalytics from '../components/HeadAnalytics.astro';
import homeBody from '../data/home-body.html?raw';
import { cardHref, clinicById } from '../lib/standort-card';
import { clinics, mapsDirectionsUrl } from '../data/locations';
import { expandStandort } from '../data/standort-optionen';
import { upgradeLegacyForms } from '../lib/kontakt-form';

const title = 'TCM & Akupunktur Schweiz | Medizinische TCM | TCM.ch';
const description =
  'Das Schweizer Netzwerk für medizinische TCM: Akupunktur, Tuina und mehr – EMR-/ASCA-anerkannt, in der ganzen Deutschschweiz. Kostenbeteiligung über die Zusatzversicherung je nach Police und Therapeut:in.';
const canonical = 'https://tcm.ch/';

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalOrganization', '@id': 'https://tcm.ch/#org', name: 'TCM.ch', url: 'https://tcm.ch/', logo: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png', medicalSpecialty: 'TraditionalChineseMedicine', areaServed: 'CH', availableLanguage: ['de-CH', 'en'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://tcm.ch/#website', name: 'TCM.ch', url: 'https://tcm.ch/', inLanguage: 'de-CH', publisher: { '@id': 'https://tcm.ch/#org' } },
];

// Turnstile sitekey: preview branches use Cloudflare's always-pass TEST key; production
// (main, served on tcm.ch) keeps the real key. Fail-safe to the real key.
const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';
// Standort-Select im Home-Formular status-bewusst aus src/data/locations.ts (clinic.status):
// nicht operative Standorte erscheinen nur mit ihren vorab-Optionen (Partnerpraxis, Vormerkung, in Prüfung).
const HOME_SELECT_RE = /(<select class="form-select" name="standort"><option value="">Standort auswählen<\/option>)([\s\S]*?)(<option value="andere">)/;
if (!HOME_SELECT_RE.test(homeBody)) throw new Error('index.astro: Home-Standort-Select nicht gefunden');
const homeSelect = (inner: string) => [...inner.matchAll(/<option value="([^"]+)">([^<]+)<\/option>/g)]
  .flatMap(([, id, name]) => {
    const c = clinics.find((x) => x.id === id);
    if (!c || c.status === 'operational') return [`<option value="${id}">${name}</option>`];
    // home.js sendet den Options-TEXT; value = id für die Vorauswahl (?standort=<id>) auf der Vormerk-Option (letzte).
    const opts = expandStandort(c.name);
    return opts.map((o, i) => `<option value="${i === opts.length - 1 ? id : `${id}-${i}`}">${o.label}</option>`);
  }).join('');
// Gemeinsames Kontaktformular (15.10.2026) ersetzt die Karte in #home-contact-form (globale Standortauswahl,
// Check-in nur für freigegebene Standorte). Prefill ?standort= / ?anliegen= / ?quelle= (home.js) bleibt erhalten.
const homeUpgraded = upgradeLegacyForms(homeBody.replace(HOME_SELECT_RE, (_m, a, inner, b) => a + homeSelect(inner) + b), { path: '/', instancePrefix: 'home', extra: { ruhig: true, zusatzOffen: true, kopfTitel: 'Schreib uns eine Nachricht.' } });
if ((homeUpgraded.match(/data-kf-instance="home"/g) || []).length !== 1) throw new Error('index.astro: Home-Kontaktkarte nicht eindeutig umgestellt');
const homeHtmlBase = homeUpgraded.replace(/__TURNSTILE_SITEKEY__/g, turnstileSitekey);

// Six equal-size homepage cards: one location name, one direct enquiry action, one information link.
// No address subline or small promo/status badges; planned Luzern keeps a waitlist-only CTA.
const escHome = (s: string) => String(s ?? '')
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;');

const homeCityMeta: Record<string, { name: string; image?: string; alt?: string }> = {
  'zuerich-hub': { name: 'Zürich' },
  'st-gallen': { name: 'St. Gallen' },
  'winterthur-marktgasse': { name: 'Winterthur' },
  'basel': {
    name: 'Basel',
    image: '/images/basel-empfang-800.webp',
    alt: 'Empfangsbereich der TCM.ch Klinik Basel, Steinenvorstadt 73',
  },
  'bern': {
    name: 'Bern',
    image: '/images/bern-marktgasse-logo-wall.avif',
    alt: 'Visualisierung: TCM.ch Original-Logo auf einer Wand, kein echtes Foto der Praxis Bern',
  },
  'luzern': { name: 'Luzern' },
};

// Homepage-only Hwang-style cards; business data is from src/data/locations.ts.
const homeIcons: Record<string,string> = {
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6.5-6.5 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 3.6 1.6h3a2 2 0 0 1 2 1.7l.7 2.8a2 2 0 0 1-.5 2.1L7.9 9a16 16 0 0 0 6 6l.9-.9a2 2 0 0 1 2.1-.5l2.8.7A2 2 0 0 1 22 16.9Z"/>',
  whatsapp: '<path d="M21 11.5a8.8 8.8 0 0 1-13 7.7L3 20l1.2-5A8.8 8.8 0 1 1 21 11.5Z"/><path d="M8.5 8.3c.6 3.6 3.1 6.2 6.6 6.8l1.3-1.2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/>',
  map: '<path d="M20 10c0 5.5-8 12-8 12S4 15.5 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.6"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
};
const homeClinicCardHtml = (id: string) => {
  const meta=homeCityMeta[id]; if(!meta) throw new Error(`unknown featured city ${id}`);
  const hub=id==='zuerich-hub';
  const c=clinicById(hub?'zuerich-oerlikon':id);
  const planned=c.status!=='operational';
  const href=hub?'/akupunktur-tcm-zuerich/':cardHref(c,'de');
  const imageSrc=meta.image??c.bild?.src, imageAlt=meta.alt??c.bild?.alt??meta.name;
  const visual=imageSrc?`<img class="home-loc-img" src="${escHome(imageSrc)}" alt="${escHome(imageAlt)}" width="1200" height="675" loading="lazy" decoding="async">`
    :`<span class="home-loc-upcoming-visual" aria-hidden="true"><span>TCM.CH</span><strong>${escHome(meta.name)}</strong></span>`;
  const badge=/Visualisierung/i.test(imageAlt)?'<span class="home-loc-visual-note">Visualisierung</span>':'';
  const tracking=hub?' onclick="window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:\'homepage_zurich_hub_click\',source_page:\'homepage\',section:\'locations\',destination:\'/akupunktur-tcm-zuerich/\',action_type:\'hub\'})"':'';
  const address=hub?'Drei Praxen in Zürich zur Auswahl':c.street&&c.postalCode?`${c.street}, ${c.postalCode} ${c.city}`:'Zentralschweiz · Eröffnung 2027';
  const hours=planned?'Eröffnung 2027 · Warteliste':c.openingHours.length?c.openingHours.map(x=>escHome(x.replace(/-/g,'–'))).join('<br>'):'Öffnungszeiten auf Anfrage';
  const phone=c.phone.replace(/[^+\d]/g,''),waNumber=c.phone.replace(/\D/g,'');
  const waText=planned?`Hallo TCM.ch, ich interessiere mich für die Warteliste in ${meta.name}.`:`Hallo TCM.ch, ich interessiere mich für einen Termin in ${meta.name}. Könnt ihr mir helfen?`;
  const waHref=`https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`;
  const bookingHref=planned?`${href}#warteliste`:hub?'/akupunktur-tcm-zuerich/#zh-funnel':`/?standort=${encodeURIComponent(id)}`;
  const bookingAttrs=planned?'':hub?tracking:` data-booking-sheet="home" data-booking-location="${escHome(id)}" data-care-cta="home-location-card-${escHome(id)}"`;
  const routeHref=hub?'/akupunktur-tcm-zuerich/#standorte':planned?href:mapsDirectionsUrl(c);
  const action=(kind:'phone'|'whatsapp'|'calendar'|'map'|'info',url:string,label:string,extra='')=>
    `<a class="home-loc-action home-loc-action--${kind}" href="${escHome(url)}" aria-label="${escHome(label)}" title="${escHome(label)}"${extra}><svg viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${homeIcons[kind]}</svg><small>${kind==='phone'?'Anruf':kind==='whatsapp'?'WhatsApp':kind==='calendar'?(planned?'Vormerken':'Termin'):kind==='info'?'Infos':hub?'Praxen':'Route'}</small></a>`;
  return `<article class="home-loc-card home-loc-card--image home-loc-card--hwang${planned?' home-loc-card--planned':''} reveal" aria-label="TCM.ch ${escHome(meta.name)}">
    <a class="home-loc-visual" href="${escHome(href)}" aria-label="Mehr Informationen zu TCM.ch ${escHome(meta.name)}"${tracking}>${visual}${badge}</a>
    <div class="home-loc-main">
      <h3 class="home-loc-name"><a class="home-loc-more" href="${escHome(href)}"${tracking}>${escHome(meta.name)}</a></h3>
      ${planned?'<span class="home-loc-status">Eröffnung 2027</span>':''}
      <p class="home-loc-address">${escHome(address)}</p>
      <div class="home-loc-actions" role="group" aria-label="Aktionen für ${escHome(meta.name)}">
        ${action('phone',`tel:${phone}`,`TCM.ch ${meta.name} anrufen`)}
        ${action('whatsapp',waHref,`TCM.ch ${meta.name} über WhatsApp kontaktieren`,' target="_blank" rel="noopener noreferrer"')}
        ${action('calendar',bookingHref,planned?`${meta.name}: Warteliste`:`Termin in ${meta.name} anfragen`,bookingAttrs)}
        ${routeHref?action(planned?'info':'map',routeHref,planned?`${meta.name}: Standortinformationen`:hub?'Zürcher Praxen und Adressen':`Anfahrt ${meta.name}`,!planned&&!hub?' target="_blank" rel="noopener noreferrer"':hub?tracking:''):''}
      </div>
      <div class="home-loc-hours"><span class="home-loc-hours-label">${planned?'Status':'Öffnungszeiten'}</span><span>${hours}</span></div>
    </div>
  </article>`;
};

const homeHtmlCards = homeHtmlBase
  .replace('<!--sc:home-zuerich-->', homeClinicCardHtml('zuerich-hub'))
  .replace('<!--sc:home-weitere-->',
    ['st-gallen', 'winterthur-marktgasse', 'basel', 'bern', 'luzern']
      .map(homeClinicCardHtml).join(''));

if (/<!--sc:/.test(homeHtmlCards)) throw new Error('index.astro: Standortkarten nicht vollständig gerendert');
const homeHtml = homeHtmlCards;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadAnalytics />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/ui.css" />
    <link rel="stylesheet" href="/home.css" />
    <link rel="stylesheet" href="/nav-rebrand.css" />
    <link rel="stylesheet" href="/footer-rebrand.css" />
    <!-- Central patient success modal (home has its own layout, not SpaPage). -->
    <link rel="stylesheet" href="/patient-success.css" />
    <link rel="stylesheet" href="/standort-card.css" />
    <link rel="stylesheet" href="/warm-clinic.css" />
    <link rel="stylesheet" href="/proof-section.css" />
    <link rel="stylesheet" href="/home-conditions.css" />
    <link rel="stylesheet" href="/free-intro-section.css" />
    <!-- static page: reveal + SPA anti-FOUC are JS-only; never hide content from no-JS/crawlers -->
    <script is:inline>document.documentElement.classList.add('js','ready');</script>
    <style is:inline>html:not(.ready){visibility:visible !important}html:not(.js) .reveal{opacity:1 !important;transform:none !important}
    /* Home has a fixed header. Reserve exactly one header height, not
       the legacy SPA 68px plus the rebrand 80px offset. */
    #home-content{padding-top:var(--header-h,76px)}
    @media(max-width:900px){
      /* The mobile screenshot shows a 20px white strip after the fixed 80px nav.
         Compensate for the additional legacy top spacing without altering the
         shared navigation component or the hero's internal typography. */
      body.tcm-warm > #home-content{padding-top:60px!important;margin-top:0!important}
      body.tcm-warm > #home-content > #heroPatient{margin-top:0!important;padding-top:0!important}
    }
    /* Primary therapy grid: one compact link to the complete therapy overview. */
    #s-behandlungen .svc-all-cta{display:flex;justify-content:center;margin-top:clamp(24px,3vw,36px)}
    #s-behandlungen .svc-all-cta-link{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 24px;border-radius:999px;border:1.5px solid #171B1A;background:#171B1A;color:#fff;font-family:var(--font-sans);font-size:15px;font-weight:700;text-decoration:none;transition:background .16s ease,border-color .16s ease}
    #s-behandlungen .svc-all-cta-link:hover{background:#353A37;border-color:#353A37;color:#fff}
    #s-behandlungen .svc-all-cta-link:focus-visible{outline:3px solid #565B59;outline-offset:3px}
    @media(max-width:600px){#s-behandlungen .svc-all-cta-link{width:100%;max-width:340px}}
    /* Homepage therapy journey: image → clear title → one-line explanation → one
       consistent deep-link. All eight cards retain their original therapy URLs. */
    #home-content #s-behandlungen .svc-header{
      margin-bottom:22px;align-items:flex-start
    }
    #home-content #s-behandlungen .svc-grid{
      gap:14px;margin-top:0!important;align-items:stretch
    }
    #home-content #s-behandlungen a.svc-card{
      display:flex;flex-direction:column;min-width:0;overflow:hidden;
      border:1px solid #E1E7EC!important;border-radius:18px;
      background:#fff;box-shadow:none!important;
      transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease
    }
    #home-content #s-behandlungen a.svc-card:hover{
      border-color:#B7CADB!important;
      box-shadow:0 9px 26px rgba(14,36,52,.08)!important;
      transform:translateY(-2px)!important
    }
    #home-content #s-behandlungen a.svc-card:focus-visible{
      outline:3px solid #1769B1!important;outline-offset:3px
    }
    #home-content #s-behandlungen .svc-photo-wrap{aspect-ratio:8/5;flex-shrink:0}
    #home-content #s-behandlungen .svc-photo{
      display:block;width:100%;height:100%;aspect-ratio:auto;object-fit:cover;
      filter:none
    }
    #home-content #s-behandlungen .svc-body{
      display:flex;flex:1;flex-direction:column;align-items:stretch;gap:7px;
      min-width:0;padding:16px 17px 17px
    }
    #home-content #s-behandlungen .svc-name{
      margin:0;font-size:clamp(19px,1.55vw,23px)!important;
      font-weight:800;letter-spacing:-.03em;line-height:1.2;
      color:#111A1C
    }
    #home-content #s-behandlungen .svc-tagline{
      display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;
      overflow:hidden;min-height:2.9em;margin:0;
      font-size:14px!important;font-weight:400;line-height:1.45;
      color:#586876
    }
    #home-content #s-behandlungen .svc-cta{
      display:inline-flex;justify-content:flex-start;align-items:center;gap:6px;
      align-self:flex-start;margin-top:auto;padding:10px 0 0;border-top:0!important;
      color:#1769B1!important;font-size:14px!important;
      line-height:1.3;font-weight:600!important
    }
    #home-content #s-behandlungen .svc-cta svg{
      flex:0 0 14px;width:14px;height:14px;
      color:#1769B1;transition:transform .18s ease
    }
    #home-content #s-behandlungen .svc-card:hover .svc-cta svg{
      transform:translateX(2px)
    }
    @media(max-width:1050px){
      #home-content #s-behandlungen .svc-grid{
        grid-template-columns:repeat(2,minmax(0,1fr))
      }
    }
    @media(max-width:560px){
      #home-content #s-behandlungen .svc-header{margin-bottom:18px}
      /* Eight compact horizontal cards are shorter and more readable than
         eight full-width tall photos or tiny two-column mobile tiles. */
      #home-content #s-behandlungen .svc-grid{
        grid-template-columns:minmax(0,1fr);gap:10px
      }
      #home-content #s-behandlungen a.svc-card{
        display:grid;grid-template-columns:minmax(0,36%) minmax(0,1fr);
        min-height:144px;border-radius:15px
      }
      #home-content #s-behandlungen .svc-photo-wrap{
        height:100%;min-height:144px;aspect-ratio:auto
      }
      #home-content #s-behandlungen .svc-photo{
        height:100%;aspect-ratio:auto;object-fit:cover
      }
      #home-content #s-behandlungen .svc-body{
        padding:13px 14px;gap:5px
      }
      #home-content #s-behandlungen .svc-name{
        font-size:clamp(17px,4.5vw,20px)!important;line-height:1.22
      }
      #home-content #s-behandlungen .svc-tagline{
        min-height:0;font-size:13px!important;line-height:1.4
      }
      #home-content #s-behandlungen .svc-cta{
        padding:7px 0 0;font-size:13px!important
      }
      #home-content #s-behandlungen .svc-cta svg{
        flex-basis:14px;width:14px;height:14px
      }
    }
    /* Uniform six-card clinic finder: 3x2 desktop, 2 columns tablet, 1 mobile. */
    #home-content #home-zuerich{margin-top:26px;scroll-margin-top:calc(var(--header-h,76px) + 20px)}
    #home-content .home-loc-grid--six-cities{
      display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
      gap:14px;align-items:stretch
    }
    #home-content .home-loc-card--image{
      display:flex;flex-direction:column;align-items:stretch;min-width:0;
      height:100%;box-sizing:border-box;padding:0;overflow:hidden;
      border:1px solid rgba(2,11,16,.11);border-radius:18px;
      background:#fff;color:inherit;text-decoration:none;
      transition:border-color .16s ease,box-shadow .16s ease,transform .16s ease
    }
    #home-content .home-loc-card--image:hover{
      border-color:rgba(2,11,16,.28);
      box-shadow:0 8px 22px rgba(2,11,16,.06);transform:translateY(-1px)
    }
    #home-content .home-loc-visual{
      display:block;width:100%;aspect-ratio:16/9;overflow:hidden;
      background:#EDF2F5;flex-shrink:0
    }
    #home-content .home-loc-img{
      display:block;width:100%;height:100%;object-fit:cover;object-position:center
    }
    #home-content .home-loc-upcoming-visual{
      display:flex;flex-direction:column;align-items:flex-start;
      justify-content:center;gap:9px;width:100%;height:100%;
      box-sizing:border-box;padding:26px;
      background:radial-gradient(ellipse at 83% 12%,#D9E7F0 0%,transparent 49%),
        linear-gradient(135deg,#F0F4F6 0%,#E5ECF2 100%);
      color:#314554;font-family:var(--font-sans)
    }
    #home-content .home-loc-upcoming-visual>span{
      font-size:11px;letter-spacing:.15em;font-weight:800;opacity:.7
    }
    #home-content .home-loc-upcoming-visual>strong{
      font-size:clamp(27px,3vw,40px);line-height:1.1;letter-spacing:-.035em
    }
    #home-content .home-loc-main{
      display:flex;flex-direction:column;align-items:flex-start;justify-content:center;
      gap:4px;min-width:0;flex:1;padding:17px 19px 10px
    }
    #home-content .home-loc-name{
      display:flex;align-items:center;gap:9px;margin:0;
      font-family:var(--font-sans);font-size:clamp(21px,1.6vw,24px);font-weight:800;
      line-height:1.22;letter-spacing:-.025em;color:var(--brand-black,#020B10)
    }
    #home-content .home-loc-pin{
      display:block;flex:none;color:#506579
    }
    #home-content .home-loc-status{
      display:block;margin-left:30px;font-family:var(--font-sans);
      font-size:13.5px;font-weight:600;line-height:1.4;color:#5B6872
    }
    #home-content .home-loc-actions{
      display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.65fr);
      align-items:center;gap:9px;padding:4px 19px 19px
    }
    #home-content .home-loc-cta{
      display:flex;align-items:center;justify-content:center;gap:5px;
      box-sizing:border-box;min-width:0;min-height:48px;padding:10px 12px;
      border:1px solid transparent;border-radius:11px;text-align:center;
      font-family:var(--font-sans);font-size:14px;line-height:1.2;
      font-weight:750;text-decoration:none;white-space:normal;
      transition:background-color .16s ease,border-color .16s ease,box-shadow .16s ease
    }
    #home-content .home-loc-cta--primary{
      color:#fff!important;background:var(--tcm-primary,#1769B1);border-color:var(--tcm-primary,#1769B1)
    }
    #home-content .home-loc-cta--primary:hover{background:#12578f;border-color:#12578f;color:#fff!important}
    #home-content .home-loc-more{
      display:inline-flex;align-items:center;justify-content:center;gap:6px;
      min-height:48px;min-width:0;padding:6px 0;
      color:#344C5F;font-family:var(--font-sans);font-size:14px;
      font-weight:750;text-decoration:none;white-space:nowrap
    }
    #home-content .home-loc-more:hover{text-decoration:underline;text-underline-offset:4px}
    #home-content .home-loc-card :is(.home-loc-cta,.home-loc-more,.home-loc-visual):focus-visible{
      outline:3px solid #547A9A;outline-offset:2px
    }
    #home-content .home-locations-secondary{margin:24px 0 0;text-align:center}
    #home-content .home-locations-secondary a{
      font-family:var(--font-sans);font-size:13.5px;font-weight:700;
      color:#565B59;text-decoration:none
    }
    #home-content .home-locations-secondary a:hover{
      text-decoration:underline;text-underline-offset:3px
    }
    @media(max-width:950px){
      #home-content .home-loc-grid--six-cities{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    @media(max-width:620px){
      #home-content .home-loc-grid--six-cities{grid-template-columns:1fr}
