---
// Home - faithful 1:1 static reproduction of the LIVE tcm.ch home.
// The body is the SPA home verbatim: its own header (#mainNav) + #home-content +
// <footer> + burger (#siteDrawer). Full SPA CSS bundled (public/home.css, header rules
// KEPT); interactivity in public/home.js (nav() routes the SPA's nav() calls to the DE
// Astro pages). Only functional adaptations: value=slug select, stats baked, Turnstile
// env-gated. NO voice cleanup, NO trimming - wording/layout identical to live.
import { site } from '../data/site';
import DeHeader from '../components/DeHeader.astro';
import Footer from '../components/Footer.astro';
import HeadAnalytics from '../components/HeadAnalytics.astro';
import homeBody from '../data/home-body.html?raw';
import { clinics } from '../data/locations';
import { expandStandort } from '../data/standort-optionen';
import { first30State } from '../data/first30';

const title = 'TCM & Akupunktur Schweiz | Medizinische TCM | TCM.ch';
const description =
  'Das Schweizer Netzwerk für medizinische TCM: Akupunktur, Tuina und mehr – EMR-/ASCA-anerkannt, in der ganzen Deutschschweiz. Krankenkasse zahlt 80 bis 100%.';
const canonical = 'https://tcm.ch/';

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalOrganization', '@id': 'https://tcm.ch/#org', name: 'TCM.ch', url: 'https://tcm.ch/', logo: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png', medicalSpecialty: 'TraditionalChineseMedicine', areaServed: 'CH', availableLanguage: ['de-CH', 'en'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://tcm.ch/#website', name: 'TCM.ch', url: 'https://tcm.ch/', inLanguage: 'de-CH', publisher: { '@id': 'https://tcm.ch/#org' } },
];

// Turnstile sitekey: preview branches use Cloudflare's always-pass TEST key; production
// (main, served on tcm.ch) keeps the real key. Fail-safe to the real key.
const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';
// Standort-Select im Home-Formular status-bewusst aus src/data/locations.ts (clinic.status):
// nicht operative Standorte erscheinen nur mit ihren vorab-Optionen (Partnerpraxis, Vormerkung, in Prüfung).
const HOME_SELECT_RE = /(<select class="form-select" name="standort"><option value="">Standort auswählen<\/option>)([\s\S]*?)(<option value="andere">)/;
if (!HOME_SELECT_RE.test(homeBody)) throw new Error('index.astro: Home-Standort-Select nicht gefunden');
const homeSelect = (inner: string) => [...inner.matchAll(/<option value="([^"]+)">([^<]+)<\/option>/g)]
  .flatMap(([, id, name]) => {
    const c = clinics.find((x) => x.id === id);
    if (!c || c.status === 'operational') return [`<option value="${id}">${name}</option>`];
    // home.js sendet den Options-TEXT; value = id für die Vorauswahl (?standort=<id>) auf der Vormerk-Option (letzte).
    const opts = expandStandort(c.name);
    return opts.map((o, i) => `<option value="${i === opts.length - 1 ? id : `${id}-${i}`}">${o.label}</option>`);
  }).join('');
const homeHtmlBase = homeBody
  .replace(HOME_SELECT_RE, (_m, a, inner, b) => a + homeSelect(inner) + b)
  .replace(/__TURNSTILE_SITEKEY__/g, turnstileSitekey);

// Nur während der real geöffneten St.-Gallen-Edition: dezenter Hinweis IN der bestehenden
// Standort-Karte. Kein nationales Hero-Banner, kein zweites Promo-Element und keine
// Werbeaussage für andere Standorte. Wenn geschlossen/ausverkauft ohne Warteliste, unverändert.
const homeFirst30 = first30State();
const SG_HOME_CARD = /<a href="\/standorte\/st-gallen\/" class="city-card location-card" onclick="event\.preventDefault\(\); nav\('standort','st-gallen'\)" style="cursor:pointer"><span class="location-plz">9000<\/span><div class="location-city">St\. Gallen<\/div><div class="location-desc">Ostschweiz<\/div><span class="location-link">Termin prüfen →<\/span><\/a>/g;
if (homeFirst30.showCampaign && [...homeHtmlBase.matchAll(SG_HOME_CARD)].length !== 1) throw new Error('index.astro: St.-Gallen-Standortkarte für FIRST 30 nicht eindeutig');
const homeHtml = homeFirst30.showCampaign
  ? homeHtmlBase.replace(SG_HOME_CARD, (card) => card
    // Direkt zum Kampagnen-Hero statt durch die alte nav()-Weiterleitung ohne Hash.
    .replace('href="/standorte/st-gallen/"', 'href="/standorte/st-gallen/#first30"')
    .replace(' onclick="event.preventDefault(); nav(\'standort\',\'st-gallen\')"', '')
    .replace('<span class="location-link">Termin prüfen →</span>',
      '<span class="home-first30-tag"><span aria-hidden="true">🎁</span> FIRST 30 · 30 Min. geschenkt</span><span class="location-link">Geschenk ansehen →</span>'))
  : homeHtmlBase;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadAnalytics />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/ui.css" />
    <link rel="stylesheet" href="/home.css" />
    <link rel="stylesheet" href="/nav-rebrand.css" />
    <link rel="stylesheet" href="/footer-rebrand.css" />
    <!-- static page: reveal + SPA anti-FOUC are JS-only; never hide content from no-JS/crawlers -->
    <script is:inline>document.documentElement.classList.add('js','ready');</script>
    <style is:inline>html:not(.ready){visibility:visible !important}html:not(.js) .reveal{opacity:1 !important;transform:none !important}
    /* restore the SPA #app{padding-top:68px} offset so the full-bleed hero clears the fixed 68px header */
    #home-content{padding-top:68px}
    /* Das Geschenk erscheint nur auf der SG-Standortkarte, nicht als nationaler Claim. */
    #home-content .home-first30-tag{display:inline-flex;align-items:center;gap:6px;max-width:100%;margin-top:9px;padding:5px 9px;
      background:#F0FBF4;color:#14532D;border:1px solid rgba(20,83,45,.24);border-radius:10px;
      font-family:var(--font-sans);font-size:12px;font-weight:750;line-height:1.35;white-space:normal;text-align:left}
    #home-content .home-first30-tag span[aria-hidden]{flex-shrink:0}
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de-CH" href="https://tcm.ch/" />
    <link rel="alternate" hreflang="en" href="https://tcm.ch/en/" />
    <link rel="alternate" hreflang="x-default" href="https://tcm.ch/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site.ogImage} />
    <meta property="og:image:width" content={site.ogImageWidth} />
    <meta property="og:image:height" content={site.ogImageHeight} />
    <meta property="og:image:type" content={site.ogImageType} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap" rel="stylesheet" />

    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <DeHeader />
    <Fragment set:html={homeHtml} />
    <Footer />
    <script src="/header.js" is:inline defer></script>
    <script src="/home.js" is:inline defer></script>
  </body>
</html>
