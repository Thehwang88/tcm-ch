---
// Home - faithful 1:1 static reproduction of the LIVE tcm.ch home.
// The body is the SPA home verbatim: its own header (#mainNav) + #home-content +
// <footer> + burger (#siteDrawer). Full SPA CSS bundled (public/home.css, header rules
// KEPT); interactivity in public/home.js (nav() routes the SPA's nav() calls to the DE
// Astro pages). Only functional adaptations: value=slug select, stats baked, Turnstile
// env-gated. NO voice cleanup, NO trimming - wording/layout identical to live.
import { site } from '../data/site';
import DeHeader from '../components/DeHeader.astro';
import ConcernSheet from '../components/ConcernSheet.astro';
import BookingSheet from '../components/BookingSheet.astro';
import Footer from '../components/Footer.astro';
import HeadAnalytics from '../components/HeadAnalytics.astro';
import homeBody from '../data/home-body.html?raw';
import { cardHref, cardHinweis, cardName, cardStatus, checkinFrei, clinicById } from '../lib/standort-card';
import { clinics } from '../data/locations';
import { expandStandort } from '../data/standort-optionen';
import { upgradeLegacyForms } from '../lib/kontakt-form';
import { first30State } from '../data/first30';

const title = 'TCM & Akupunktur Schweiz | Medizinische TCM | TCM.ch';
const description =
  'Das Schweizer Netzwerk für medizinische TCM: Akupunktur, Tuina und mehr – EMR-/ASCA-anerkannt, in der ganzen Deutschschweiz. Kostenbeteiligung über die Zusatzversicherung je nach Police und Therapeut:in.';
const canonical = 'https://tcm.ch/';

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalOrganization', '@id': 'https://tcm.ch/#org', name: 'TCM.ch', url: 'https://tcm.ch/', logo: 'https://tcm.ch/images/logo/tcm-kliniken-logo-512.png', medicalSpecialty: 'TraditionalChineseMedicine', areaServed: 'CH', availableLanguage: ['de-CH', 'en'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://tcm.ch/#website', name: 'TCM.ch', url: 'https://tcm.ch/', inLanguage: 'de-CH', publisher: { '@id': 'https://tcm.ch/#org' } },
];

// Turnstile sitekey: preview branches use Cloudflare's always-pass TEST key; production
// (main, served on tcm.ch) keeps the real key. Fail-safe to the real key.
const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';
// Standort-Select im Home-Formular status-bewusst aus src/data/locations.ts (clinic.status):
// nicht operative Standorte erscheinen nur mit ihren vorab-Optionen (Partnerpraxis, Vormerkung, in Prüfung).
const HOME_SELECT_RE = /(<select class="form-select" name="standort"><option value="">Standort auswählen<\/option>)([\s\S]*?)(<option value="andere">)/;
if (!HOME_SELECT_RE.test(homeBody)) throw new Error('index.astro: Home-Standort-Select nicht gefunden');
const homeSelect = (inner: string) => [...inner.matchAll(/<option value="([^"]+)">([^<]+)<\/option>/g)]
  .flatMap(([, id, name]) => {
    const c = clinics.find((x) => x.id === id);
    if (!c || c.status === 'operational') return [`<option value="${id}">${name}</option>`];
    // home.js sendet den Options-TEXT; value = id für die Vorauswahl (?standort=<id>) auf der Vormerk-Option (letzte).
    const opts = expandStandort(c.name);
    return opts.map((o, i) => `<option value="${i === opts.length - 1 ? id : `${id}-${i}`}">${o.label}</option>`);
  }).join('');
// Gemeinsames Kontaktformular (15.10.2026) ersetzt die Karte in #home-contact-form (globale Standortauswahl,
// Check-in nur für freigegebene Standorte). Prefill ?standort= / ?anliegen= / ?quelle= (home.js) bleibt erhalten.
const homeUpgraded = upgradeLegacyForms(homeBody.replace(HOME_SELECT_RE, (_m, a, inner, b) => a + homeSelect(inner) + b), { path: '/', instancePrefix: 'home', extra: { ruhig: true } });
if ((homeUpgraded.match(/data-kf-instance="home"/g) || []).length !== 1) throw new Error('index.astro: Home-Kontaktkarte nicht eindeutig umgestellt');
const homeHtmlBase = homeUpgraded.replace(/__TURNSTILE_SITEKEY__/g, turnstileSitekey);

// Homepage-Standortauswahl: bewusst reduzierter als die Standortseiten selbst.
// Eine Karte = Name + eine klare Orts-/Betreiberzeile + Pfeil. Keine Promo-Chips,
// Fotos oder siebenfach wiederholte Check-in-Buttons; das globale Check-in-Angebot
// bleibt über Banner/Popup sichtbar.
const homeFirst30 = first30State();
const escHome = (s: string) => String(s ?? '')
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;');

const homeClinicCardHtml = (id: string, tracking = '', withImage = false) => {
  const c = clinicById(id);
  const defaultHref = cardHref(c, 'de');
  const href = defaultHref; // Whole location card always opens the hero, including SG during FIRST 30.
  const external = /^https?:\/\//.test(href);
  const status = cardStatus(c);
  const action = status === 'partner' ? 'Zur Praxis' : status === '2027' ? 'Standort ansehen' : 'Termin & Praxis';
  const checkin = checkinFrei(c);
  const image = withImage && c.bild
    ? `<img class="home-loc-img" src="${escHome(c.bild.src)}" alt="${escHome(c.bild.alt)}" width="1200" height="896" loading="lazy" decoding="async">`
    : '';
  const gratis = checkin
    ? '<span class="home-loc-gratis">Gratis Check-in</span>'
    : '';
  const campaign = id === 'st-gallen' && homeFirst30.showCampaign
    ? `<span class="home-loc-note">${homeFirst30.soldOut ? 'FIRST 30 · Warteliste' : 'FIRST 30 · 30 Min. geschenkt'}</span>`
    : '';
  return `<a class="home-loc-card${withImage ? ' home-loc-card--image' : ''} reveal" href="${escHome(href)}"${external ? ' target="_blank" rel="noopener"' : ''}${tracking ? ' ' + tracking : ''}>
    ${image}
    <span class="home-loc-main">
      <span class="home-loc-title-row"><span class="home-loc-name"><svg class="home-loc-pin" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><strong>${escHome(cardName(c))}</strong></span>${gratis}</span>
      <span>${escHome(cardHinweis(c))}</span>
      ${campaign}
    </span>
    <span class="home-loc-action"><span>${action}</span><span aria-hidden="true">→</span></span>
  </a>`;
};

const zhTracking = (slug: string) =>
  `onclick="window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'homepage_zurich_location_click',source_page:'homepage',section:'locations',location_slug:'${slug}'})"`;

const homeHtmlCards = homeHtmlBase
  .replace('<!--sc:home-zuerich-->',
    '<div class="home-loc-grid home-loc-grid--3">' +
      ['zuerich-bahnhofstrasse','zuerich-oerlikon','zuerich-hoengg'].map((id) => homeClinicCardHtml(id, zhTracking(id), true)).join('') +
    '</div>')
  .replace('<!--sc:home-weitere-->',
    '<div class="home-loc-grid home-loc-grid--4">' +
      ['st-gallen','frauenfeld','kreuzlingen','winterthur-muenzgasse'].map((id) => homeClinicCardHtml(id, '', true)).join('') +
    '</div>');

if (/<!--sc:/.test(homeHtmlCards)) throw new Error('index.astro: Standortkarten nicht vollständig gerendert');
const homeHtml = homeHtmlCards;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadAnalytics />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/ui.css" />
    <link rel="stylesheet" href="/home.css" />
    <link rel="stylesheet" href="/nav-rebrand.css" />
    <link rel="stylesheet" href="/footer-rebrand.css" />
    <link rel="stylesheet" href="/standort-card.css" />
    <link rel="stylesheet" href="/warm-clinic.css" />
    <!-- static page: reveal + SPA anti-FOUC are JS-only; never hide content from no-JS/crawlers -->
    <script is:inline>document.documentElement.classList.add('js','ready');</script>
    <style is:inline>html:not(.ready){visibility:visible !important}html:not(.js) .reveal{opacity:1 !important;transform:none !important}
    /* Home has a fixed header. Reserve exactly one header height, not
       the legacy SPA 68px plus the rebrand 80px offset. */
    #home-content{padding-top:var(--header-h,76px)}
    @media(max-width:900px){
      /* The mobile screenshot shows a 20px white strip after the fixed 80px nav.
         Compensate for the additional legacy top spacing without altering the
         shared navigation component or the hero's internal typography. */
      body.tcm-warm > #home-content{padding-top:60px!important;margin-top:0!important}
      body.tcm-warm > #home-content > #heroPatient{margin-top:0!important;padding-top:0!important}
    }
    /* Primary therapy grid: one compact link to the complete therapy overview. */
    #s-behandlungen .svc-all-cta{display:flex;justify-content:center;margin-top:clamp(24px,3vw,36px)}
    #s-behandlungen .svc-all-cta-link{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 24px;border-radius:999px;border:1.5px solid #171B1A;background:#171B1A;color:#fff;font-family:var(--font-sans);font-size:15px;font-weight:700;text-decoration:none;transition:background .16s ease,border-color .16s ease}
    #s-behandlungen .svc-all-cta-link:hover{background:#353A37;border-color:#353A37;color:#fff}
    #s-behandlungen .svc-all-cta-link:focus-visible{outline:3px solid #565B59;outline-offset:3px}
    @media(max-width:600px){#s-behandlungen .svc-all-cta-link{width:100%;max-width:340px}}
    /* Reduzierter Standortfinder auf Home: eine visuelle Sprache, keine Promo-Wiederholungen. */
    #home-content .home-locations-feature{
      margin-top:28px;padding:clamp(22px,3vw,30px);border:1px solid rgba(2,11,16,.12);
      border-radius:18px;background:linear-gradient(135deg,var(--tcm-surface) 0%,var(--tcm-surface-strong) 68%,var(--tcm-offer) 100%);display:flex;align-items:flex-end;
      justify-content:space-between;gap:28px
    }
    #home-content .home-locations-feature__copy{max-width:680px}
    #home-content .home-locations-kicker,
    #home-content .home-locations-divider>span{
      font-family:var(--font-sans);font-size:11px;font-weight:800;letter-spacing:.14em;
      text-transform:uppercase;color:var(--brand-ink,#0B7A4B)
    }
    #home-content .home-locations-feature h3{
      margin:7px 0 7px;font-family:var(--font-sans);font-size:clamp(22px,2.5vw,30px);
      font-weight:800;letter-spacing:-.025em;color:var(--brand-black,#020B10)
    }
    #home-content .home-locations-feature p{margin:0;color:rgba(2,11,16,.68);font-size:15px;line-height:1.55}
    #home-content .home-locations-feature__actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;flex-shrink:0}
    #home-content .home-locations-textlink,
    #home-content .home-locations-divider a{
      color:var(--brand-black,#020B10);font-family:var(--font-sans);font-size:14px;font-weight:750;
      text-decoration:none
    }
    #home-content .home-locations-textlink:hover,
    #home-content .home-locations-divider a:hover{text-decoration:underline;text-underline-offset:3px}
    #home-content .home-loc-grid{display:grid;gap:12px;margin-top:12px}
    #home-content .home-loc-grid--3{grid-template-columns:repeat(3,minmax(0,1fr))}
    #home-content .home-loc-grid--4{grid-template-columns:repeat(4,minmax(0,1fr))}
    #home-content .home-loc-card{
      min-width:0;display:flex;align-items:center;justify-content:space-between;gap:18px;
      padding:18px 20px;background:#fff;border:1px solid rgba(2,11,16,.11);border-radius:16px;
      text-decoration:none;color:inherit;transition:border-color .16s ease,box-shadow .16s ease,transform .16s ease
    }
    #home-content .home-loc-card:hover{border-color:rgba(2,11,16,.28);box-shadow:0 8px 22px rgba(2,11,16,.06);transform:translateY(-1px)}
    #home-content .home-loc-card--image{padding:0;display:grid;grid-template-columns:1fr;gap:0;overflow:hidden;align-items:stretch}
    /* 16:9 statt fester Höhe: mehr Bild sichtbar, gleicher Ausschnitt-Charakter für alle Karten */
    #home-content .home-loc-card--image .home-loc-img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:center}
    #home-content .home-loc-card--image .home-loc-main{padding:17px 18px 8px}
    #home-content .home-loc-card--image .home-loc-action{padding:0 18px 17px;justify-content:space-between;width:100%;box-sizing:border-box}
    #home-content .home-loc-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    #home-content .home-loc-name{display:inline-flex;align-items:baseline;gap:8px;min-width:0}
    #home-content .home-loc-pin{width:18px;height:18px;flex:0 0 18px;align-self:baseline;transform:translateY(2px);color:#565B59}
    #home-content .home-loc-name strong{min-width:0}

    #home-content .home-loc-gratis{
      display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;background:#EEDBD7;
      color:#020B10;font-family:var(--font-sans);font-size:10.5px;font-weight:800;line-height:1.15;
      letter-spacing:.01em;white-space:nowrap
    }
    #home-content .home-loc-main{display:block;min-width:0}
    #home-content .home-loc-main strong{display:block;font-family:var(--font-sans);font-size:17px;line-height:1.2;font-weight:800;color:var(--brand-black,#020B10)}
    #home-content .home-loc-main>span:not(.home-loc-note):not(.home-loc-title-row){display:block;margin-top:4px;font-size:13.5px;line-height:1.4;color:rgba(2,11,16,.6)}
    #home-content .home-loc-action{display:flex;align-items:center;gap:8px;flex-shrink:0;font-family:var(--font-sans);font-size:13px;font-weight:750;color:var(--brand-black,#020B10)}
    #home-content .home-loc-note{display:block;margin-top:7px;font-size:11.5px;font-weight:700;color:var(--brand-ink,#0B7A4B)}
    #home-content .home-locations-divider{
      margin-top:34px;padding-top:22px;border-top:1px solid rgba(2,11,16,.09);
      display:flex;align-items:center;justify-content:space-between;gap:18px
    }
    @media(max-width:960px){
      #home-content .home-locations-feature{align-items:flex-start;flex-direction:column}
      #home-content .home-loc-grid--4{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    @media(max-width:720px){
      #home-content .home-loc-grid--3,#home-content .home-loc-grid--4{grid-template-columns:1fr}
      #home-content .home-loc-card{padding:16px}
      #home-content .home-loc-card--image{padding:0}
      #home-content .home-loc-card--image .home-loc-img{height:auto;aspect-ratio:16/9}
      #home-content .home-loc-action span:first-child{display:none}
      #home-content .home-locations-divider{align-items:flex-start}
    }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de-CH" href="https://tcm.ch/" />
    <link rel="alternate" hreflang="en" href="https://tcm.ch/en/" />
    <link rel="alternate" hreflang="x-default" href="https://tcm.ch/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site.ogImage} />
    <meta property="og:image:width" content={site.ogImageWidth} />
    <meta property="og:image:height" content={site.ogImageHeight} />
    <meta property="og:image:type" content={site.ogImageType} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap" rel="stylesheet" />

    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body class="tcm-warm">
    <DeHeader />
    <Fragment set:html={homeHtml} />
    <Footer />
    <ConcernSheet />
    <BookingSheet />
    <script src="/header.js" is:inline defer></script>
    <script src="/home.js" is:inline defer></script>
    <!-- Homepage-only Christmas snow preview. No library, no interaction layer.
         Deliberately enabled now for visual testing; can be season-gated later. -->
    <style is:global>
      #heroPatient{position:relative;isolation:isolate;overflow:hidden}
      #heroPatient .tcm-snow-layer{position:absolute;inset:0;z-index:2;overflow:hidden;pointer-events:none;contain:paint}
      #heroPatient .tcm-snowflake{position:absolute;top:-18px;left:var(--snow-x);width:var(--snow-size);height:var(--snow-size);border-radius:50%;background:rgba(102,145,172,var(--snow-opacity));box-shadow:0 0 3px rgba(120,166,195,.12);animation:tcm-snow-fall var(--snow-duration) linear infinite;animation-delay:var(--snow-delay);will-change:transform}
      /* Actual six-armed snowflake glyphs, not circular blue particles. */
      #heroPatient .tcm-snowflake{
        width:auto;height:auto;border-radius:0;background:none;box-shadow:none;
        font-family:Arial,'Noto Sans Symbols 2',sans-serif;font-weight:400;
        font-size:calc(var(--snow-size) * 2.5);line-height:1;
        color:rgba(103,144,169,var(--snow-opacity));
        font-variant-emoji:text;
        user-select:none;
      }
      @keyframes tcm-snow-fall{from{transform:translate3d(0,-20px,0)}to{transform:translate3d(var(--snow-drift),calc(100vh + 60px),0)}}
      /* Seasonal hat: white brim rests on the top-left shoulder of the M, like a fitted cap.
         Smaller, lowered and mirrored (pom-pom to the left) to avoid the eyebrow above.
         Desktop only; heading text, booking CTAs and mobile layout are unchanged. */
      #heroPatient .tcm-santa-m{position:relative;display:inline-block}
      #heroPatient .tcm-santa-hat{display:none;position:absolute;left:-.10em;top:-.19em;width:.72em;height:auto;overflow:visible;pointer-events:none;transform:rotate(5deg);transform-origin:65% 90%;filter:drop-shadow(0 1px 1.4px rgba(22,24,25,.14))}
      @media(min-width:1024px){
        html.tcm-santa-season #heroPatient .tcm-santa-hat{display:block}
      }
      /* Desktop-only winter polish: higher contrast across cream copy and grey team photo.
         Keep 13 original flakes and appearance unchanged on mobile. */
      @media(min-width:1024px){
        #heroPatient .tcm-snowflake{
          font-size:calc(var(--snow-size) * 2.8);
          color:rgba(var(--snow-rgb, 103,144,169),var(--snow-opacity-desktop, .48));
          text-shadow:0 1px 2px rgba(27,43,52,.10);
        }
      }
      @media(max-width:1023px){
        #heroPatient .tcm-snowflake:nth-child(n+14){display:none!important}
      }
      @media(prefers-reduced-motion:reduce){#heroPatient .tcm-snow-layer{display:none!important}}
    </style>
    <script is:inline>
      // Homepage only: seasonal decorative Santa hat, 12 November through 26 December.
      (function(){
        var today=new Date();
        var mmdd=(today.getMonth()+1)*100+today.getDate();
        if(mmdd>=1112 && mmdd<=1226)document.documentElement.classList.add('tcm-santa-season');
      })();
    </script>
    <script is:inline>
      (function(){
        if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
        var hero=document.getElementById('heroPatient');
        if(!hero||hero.querySelector('.tcm-snow-layer'))return;
        var layer=document.createElement('div');
        layer.className='tcm-snow-layer';
        layer.setAttribute('aria-hidden','true');
        // Fixed parameters: lightweight, reproducible. Four additional desktop-only flakes.
        for(var i=0;i<17;i++){
          var flake=document.createElement('i');
          flake.className='tcm-snowflake';
          flake.textContent='❄︎';
          var x=((i*73+17)%97+1);
          flake.style.setProperty('--snow-x',x+'%');
          flake.style.setProperty('--snow-size',(4+i%3)+'px');
          flake.style.setProperty('--snow-opacity',(0.22+(i%4)*0.065).toFixed(2));
          // Steel-blue on the light hero copy; soft white over the grey team photograph.
          flake.style.setProperty('--snow-rgb',x<51?'73,109,130':'255,255,255');
          flake.style.setProperty('--snow-opacity-desktop',(x<51?0.37+(i%4)*0.055:0.42+(i%4)*0.055).toFixed(2));
          flake.style.setProperty('--snow-duration',(15+(i*7)%14)+'s');
          flake.style.setProperty('--snow-delay',(-((i*11)%25))+'s');
          flake.style.setProperty('--snow-drift',((i%2?1:-1)*(12+(i*13)%55))+'px');
          layer.appendChild(flake);
        }
        hero.appendChild(layer);
      })();
    </script>
  </body>
</html>
