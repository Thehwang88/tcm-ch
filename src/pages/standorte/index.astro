---
// /standorte - faithful 1:1 reproduction of the live SPA #page-standorte hub.
import SpaPage from '../../layouts/SpaPage.astro';
import bodyRaw from '../../data/standorte-body.html?raw';
import { clinicById, cardStatus, cardHref, cardName, cardHinweis, zeitenChip, checkinFrei } from '../../lib/standort-card';
// Standortliste (06.11.2026, nur diese Seite): EIN Grid (4/3/2/1 Spalten) für alle Standorte, Abschnittstitel (Eyebrow + h2) als
// volle Zeilen darin. Feste Kartenanatomie: Titel max. 2 Zeilen, Adresse 1 Zeile, max. 2 Chips (Zeiten, Krankenkassen),
// CTA unten. CTA-Hierarchie: Check-in (CHECKIN_FREIGABE) gelb gefüllt · offen = Ghost-Button · 2027/Vorbereitung = Textlink,
// Karte gedämpft, nur Status-Chip. Partner-Hinweis als grauer Suffix in der Adresszeile. Daten weiterhin nur aus locations.ts.
const esc = (s: string) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const PIN = '<svg class="stdc-pin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>';
const card = (id: string) => {
  const c = clinicById(id); const st = cardStatus(c); const href = cardHref(c); const ext = /^https?:\/\//.test(href);
  const offen = st === 'live' || st === 'partner'; const ci = checkinFrei(c);
  const chips = offen ? [zeitenChip(c), 'Krankenkassen anerkannt'].filter(Boolean)
    : st === '2027' ? [/2027/.test(c.openingNote ?? '') || c.status === 'operational' ? 'Eröffnung 2027' : 'In Vorbereitung'] : [];
  const suffix = c.karte?.chip ? ` <span class="stdc-suffix">· ${esc(c.karte.chip)}</span>` : '';
  const label = c.karte?.button ?? (st === 'einzugsgebiet' ? `Nächste Praxis: ${cardName(clinicById(c.karte?.naechste ?? ''))}` : st === '2027' ? (c.status === 'operational' ? 'Standort ansehen' : 'Warteliste') : ci ? 'Gratis Check-in buchen' : 'Termin buchen');
  const cardImage = c.bild && (['zuerich-bahnhofstrasse','zuerich-oerlikon','zuerich-hoengg','st-gallen'].includes(id)) ? `<img class="stdc-photo" src="${esc(c.bild.src)}" alt="${esc(c.bild.alt)}" loading="lazy" decoding="async">` : '';
  const cta = `<span class="stdc-cta ${offen ? (ci ? 'stdc-cta--gelb' : 'stdc-cta--ghost') : 'stdc-cta--link'}">${esc(label)} <span aria-hidden="true">→</span></span>`;
  return `<a class="stdc${offen ? '' : ' stdc--muted'}" href="${esc(href)}"${ext ? ' target="_blank" rel="noopener"' : ''}>${cardImage}<h3 class="stdc-h">${PIN}<span>${esc(cardName(c))}</span></h3><p class="stdc-adr"><span>${esc(cardHinweis(c))}</span>${suffix}</p><div class="stdc-chips">${chips.map((t) => `<span class="stdc-chip">${esc(t)}</span>`).join('')}</div>${cta}</a>`;
};
const head = (id: string, eyebrow: string, h: string) => `<div class="std-sec" id="${id}"><span class="std-eyebrow">${esc(eyebrow)}</span><h2 class="std-h2">${h}</h2></div>`;
const liste =
  head('standorte-zuerich', 'TCM.ch Praxen', 'Zürich') + ['zuerich-bahnhofstrasse', 'zuerich-oerlikon', 'zuerich-hoengg'].map(card).join('') +
  '<a class="std-next" href="/akupunktur-tcm-zuerich/#zh-funnel"><span class="std-next-l">Standort egal?</span><span class="std-next-t"><strong>Nächster freier Termin in Zürich</strong><span>Wir prüfen unsere Zürcher Praxen und finden den schnellsten passenden Termin für dich.</span></span><span class="std-next-go">Nächsten Termin finden →</span></a>' +
  head('standorte-st-gallen', 'TCM.ch Praxis', 'St. Gallen') + card('st-gallen') +
  head('standorte-thurgau', 'Partnerpraxen Hwang · Termine über hwang.ch', 'Thurgau &amp; Winterthur') + ['frauenfeld', 'kreuzlingen', 'winterthur-muenzgasse'].map(card).join('') +
  head('standorte-weitere', 'Partner, Eröffnungen 2027 und Warteliste', 'Weitere Standorte') + ['bottighofen', 'rorschach', 'wil', 'volketswil', 'basel', 'luzern', 'bern', 'winterthur-marktgasse'].map(card).join('');
const body = bodyRaw.replace('<!--sc:std-liste-->', liste);
if (/<!--sc:/.test(body) || (body.match(/class="stdc[" ]/g) || []).length !== 15) throw new Error('standorte/index.astro: Standortkarten nicht vollständig gerendert');

const title = 'Standorte – TCM.ch Kliniken in der Deutschschweiz';
const description =
  'Unsere TCM.ch Kliniken – von Zürich über Winterthur und St. Gallen bis Kreuzlingen. EMR-/ASCA-anerkannt, Krankenkasse 80–100 % über die Zusatzversicherung.';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/standorte/', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/standorte" body={body} schema={schema} />

<style is:global>
  /* /standorte only: Grid-Section rueckt an den Hero. Die frueheren
     #standorte-premium-hero-Regeln sind mit dem hh-Hero (home.css) obsolet
     und entfernt — das alte Hero-Markup existiert nicht mehr. */
  @media (max-width: 768px) {
    /* grid section (only the one holding #standorte-page-grid): kill the top-padding seam and
       drop the duplicate eyebrow + subline that restate the hero; keep H2 as minimal label */
    .section:has(#standorte-page-grid) { padding-top: 8px !important; }
    .section:has(#standorte-page-grid) .section-label { display: none !important; }
    .section:has(#standorte-page-grid) .location-intro { display: none !important; }
    .section:has(#standorte-page-grid) .section-title { margin-bottom: 12px !important; }
  }
  @media (min-width: 769px) {
    .section:has(#standorte-page-grid) { padding-top: 56px !important; }
    /* Zürich-Block: Headline sitzt direkt über dem grünen Container, kein doppelter Abstand */
    #standorte-zuerich { margin-top: 36px !important; }
  }
  /* Standortliste 06.11.2026: Sprunglinks, ein Grid (4/3/2/1), Abschnittstitel und Termin-Leiste als volle Zeilen. */
  .std-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 20px; }
  .std-jump a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1.5px solid var(--border); border-radius: 999px; font-family: var(--font-sans); font-size: 14.5px; font-weight: 700; color: var(--black); text-decoration: none; background: #fff; }
  .std-jump a:hover { border-color: var(--blue); }
  #standorte-page-grid.std-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; align-items: stretch; margin-top: 8px; }
  .std-sec, .std-next { grid-column: 1 / -1; }
  .std-sec { display: flex; flex-direction: column; gap: 4px; margin-top: 16px; scroll-margin-top: 90px; }
  .std-sec:first-child { margin-top: 0; }
  .std-eyebrow { font-family: var(--font-sans); font-size: 11.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--blue); }
  .std-h2 { font-family: var(--font-sans); font-size: 24px; font-weight: 800; letter-spacing: -.02em; line-height: 1.15; color: var(--black); margin: 0; }
  /* Karte: feste Anatomie, 1px Rand, kein Schatten, CTA unten */
  .stdc { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 20px 18px 18px; background: #fff; border: 1px solid var(--border); border-radius: var(--r-card, 16px); text-decoration: none; color: inherit; font-family: var(--font-sans); transition: border-color .15s ease; }
  .stdc:hover { border-color: var(--black); }
  .stdc--muted { background: #F6F7F7; }
  .stdc-h { display: flex; align-items: flex-start; gap: 8px; margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -.02em; line-height: 1.2; color: var(--black); min-height: calc(2 * 1.2em); }
  .stdc-h span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-width: 0; }
  .stdc-pin { flex: 0 0 18px; width: 18px; height: 18px; margin-top: .2em; color: var(--blue); }
  .stdc-adr { display: flex; align-items: baseline; gap: 4px; margin: 0; font-size: 14.5px; line-height: 1.4; color: var(--mid); white-space: nowrap; min-width: 0; }
  .stdc-adr > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .stdc-suffix { flex-shrink: 0; color: #8a8a8a; font-size: 13px; }
  .stdc-chips { display: flex; flex-wrap: wrap; gap: 6px; height: 26px; overflow: hidden; }
  .stdc-chip { display: inline-flex; align-items: center; height: 26px; padding: 0 10px; border: 1px solid var(--border); border-radius: 999px; background: #fff; font-size: 12.5px; font-weight: 700; line-height: 1; color: var(--black); white-space: nowrap; }
  .stdc--muted .stdc-chip { background: transparent; }
  .stdc-cta { margin-top: auto; padding-top: 6px; font-size: 15px; font-weight: 800; line-height: 1.2; }
  .stdc-cta--gelb, .stdc-cta--ghost { display: flex; justify-content: center; align-items: center; gap: 6px; border-radius: 999px; padding: 12px 16px; margin-top: auto; }
  .stdc-cta--gelb { background: #FFD84D; color: #111; border: 1px solid #FFD84D; }
  .stdc:hover .stdc-cta--gelb { background: #F5C800; border-color: #F5C800; }
  .stdc-cta--ghost { background: transparent; color: var(--black); border: 1px solid var(--black); }
  .stdc:hover .stdc-cta--ghost { background: var(--black); color: #fff; }
  .stdc-cta--link { display: inline-flex; align-items: center; gap: 6px; color: var(--black); text-decoration: underline; text-underline-offset: 3px; }
  /* Schmale Termin-Leiste unter Zürich (keine Karte) */
  .std-next { display: flex; align-items: center; gap: 16px; border: 1px solid var(--border); border-radius: 999px; padding: 10px 20px; background: #fff; text-decoration: none; color: inherit; margin-top: -8px; }
  .std-next:hover { border-color: var(--black); }
  .std-next-l { font-family: var(--font-sans); font-size: 11.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--black); white-space: nowrap; }
  .std-next-t { flex: 1; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: 13.5px; color: var(--mid); min-width: 0; }
  .std-next-t strong { font-family: var(--font-sans); font-size: 15px; color: var(--black); }
  .std-next-go { font-family: var(--font-sans); font-size: 14px; font-weight: 700; color: var(--black); white-space: nowrap; }
  .std-finder { margin: 24px 0 0; font-size: 15px; }
  .std-finder a { color: var(--blue); font-weight: 700; text-decoration: none; }
  @media (max-width: 1199px) { #standorte-page-grid.std-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 899px) { #standorte-page-grid.std-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } .std-next { border-radius: 20px; flex-wrap: wrap; gap: 8px 16px; } }
  @media (max-width: 599px) { #standorte-page-grid.std-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; } .std-h2 { font-size: 22px; } .std-next { flex-direction: column; align-items: flex-start; gap: 4px; padding: 14px 18px; margin-top: 0; } .std-next-t { flex-direction: column; gap: 2px; } }
</style>

<style is:global>
  .stdc-photo {display:block;width:100%;height:150px;object-fit:cover;border-radius:12px;margin-bottom:5px;}
  @media(max-width:600px){.stdc-photo{height:176px;}}
  .stdc-photo[src$="standort-zuerich-bahnhofstrasse-brand.webp"]{object-position:50% 40%}
</style>
