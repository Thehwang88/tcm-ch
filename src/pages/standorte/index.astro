---
// /standorte - faithful 1:1 reproduction of the live SPA #page-standorte hub.
import SpaPage from '../../layouts/SpaPage.astro';
import bodyRaw from '../../data/standorte-body.html?raw';
import { clinicById, cardHref, cardName } from '../../lib/standort-card';
// /standorte overview: 7 TCM.ch clinic cards in the same visual hierarchy as home;
// partner / additional locations remain crawlable in a collapsed native disclosure.
// All booking / contact form logic and analytics events remain untouched.
const esc = (s: string) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const PIN = '<svg class="stdc-pin" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5.5-8 12-8 12S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.6"/></svg>';
const mainIds = ['zuerich-bahnhofstrasse','zuerich-oerlikon','zuerich-hoengg','st-gallen','winterthur-marktgasse','basel','bern'] as const;
const additionalIds = ['frauenfeld','kreuzlingen','bottighofen','volketswil','wil','rorschach','luzern'] as const;
const displayName: Record<string,string> = { 'winterthur-marktgasse': 'Winterthur' };
const mainCard = (id: typeof mainIds[number]) => {
  const c = clinicById(id);
  if(c.status !== 'operational') throw new Error(`/standorte/: main clinic ${id} must be operational`);
  const label = esc(displayName[id] ?? cardName(c));
  const href = cardHref(c);
  if(/^https?:\/\//.test(href)) throw new Error(`/standorte/: main clinic ${id} unexpectedly routes outside TCM.ch`);
  const img = id === 'basel'
    ? {src:'/images/basel-empfang-800.webp',alt:'Empfangsbereich der TCM.ch Klinik Basel, Steinenvorstadt 73'}
    : c.bild;
  if(!img) throw new Error(`/standorte/: main clinic ${id} missing image`);
  return `<article class="stdc stdc--clinic" aria-label="TCM.ch ${label}">
    <a class="stdc-visual" href="${esc(href)}" aria-label="Mehr Informationen zu TCM.ch ${label}">
      <img class="stdc-photo" src="${esc(img.src)}" alt="${esc(img.alt)}" width="1200" height="675" loading="lazy" decoding="async">
    </a>
    <div class="stdc-main"><h3 class="stdc-h">${PIN}<span>${label}</span></h3></div>
    <div class="stdc-actions">
      <a class="stdc-primary" href="#standorte-anfrage" onclick="openContactForm(null, '${id}')">Termin anfragen</a>
      <a class="stdc-more" href="${esc(href)}">Mehr Infos <span aria-hidden="true">→</span></a>
    </div>
  </article>`;
};
// Do not imply that partner clinics are TCM.ch-owned, or that planned Luzern accepts treatment bookings.
const additionalRow = (id: typeof additionalIds[number]) => {
  const c=clinicById(id);
  const href=cardHref(c), external=/^https?:\/\//.test(href);
  const label=esc(cardName(c));
  const descriptor = id==='luzern' ? 'Eröffnung 2027 · Warteliste'
    : id==='bottighofen' ? 'Partnerklinik TCM Pelican'
    : c.betreiber ? 'Praxis Hwang · Partnerpraxis' : 'Weiterer Behandlungsstandort';
  const action=id==='luzern'?'Vormerken':'Mehr Infos';
  return `<a class="std-partner-row" href="${esc(href)}"${external?' target="_blank" rel="noopener"':''}>
    <span class="std-partner-row-copy"><strong>${label}</strong><span>${esc(descriptor)}</span></span>
    <span class="std-partner-row-action">${action} <span aria-hidden="true">→</span></span>
  </a>`;
};
const liste =
  '<div class="std-primary-group"><h2 class="std-group-heading">Zürich</h2><div class="std-featured-grid">' +
    mainIds.slice(0,3).map(mainCard).join('')+'</div></div>'+
  '<div class="std-primary-group"><h2 class="std-group-heading">Weitere Kliniken</h2><div class="std-featured-grid std-featured-grid--other">' +
    mainIds.slice(3).map(mainCard).join('')+'</div></div>'+
  '<details id="standorte-weitere" class="std-other-locations"><summary><span>Weitere Standorte &amp; Partnerpraxen</span><span class="std-disclosure-meta">7 Standorte anzeigen <span aria-hidden="true">⌄</span></span></summary><div class="std-partner-grid">'+
    additionalIds.map(additionalRow).join('')+'</div></details>';
// Replace ONLY the redundant hero/nav section. Keep the existing embedded contact
// form, submission code, schema, canonical links and analytics untouched.
const introStart=bodyRaw.indexOf('<div class="std-overview-intro">');
const cardsStart=bodyRaw.indexOf('<div id="standorte-page-grid"',introStart);
if(introStart<0 || cardsStart<0) throw new Error('/standorte/: intro/card markers not found');
const hero = `<div class="std-overview-intro">
  <h1 class="std-overview-heading" id="std-overview-heading">Unsere TCM.ch <em>Standorte.</em></h1>
  <p class="std-overview-lead">Wähle eine Praxis oder lass dir den passenden Termin vorschlagen.</p>
  <a class="std-overview-primary" href="#standorte-anfrage" onclick="openContactForm()">Passenden Termin anfragen →</a>
</div>
`;
const body = (bodyRaw.slice(0,introStart) + hero + bodyRaw.slice(cardsStart))
  .replace('<!--sc:std-liste-->',liste)
  .replace('<section class="section contact-section-inline"','<section class="section contact-section-inline" id="standorte-anfrage"')
  .replace(/<p class="std-finder">[\s\S]*?<\/p>/,'');
if(/<!--sc:/.test(body) || (body.match(/class="stdc stdc--clinic"/g)||[]).length!==7 || (body.match(/class="std-partner-row"/g)||[]).length!==7)
  throw new Error('/standorte/: missing or duplicated location cards');

const title = 'Standorte – TCM.ch Kliniken in der Deutschschweiz';
const description =
  'Unsere TCM.ch Standorte in Zürich, Winterthur, St. Gallen, Basel, Bern und der Ostschweiz. Akupunktur und TCM; Zusatzversicherung je nach Police und Anerkennung.';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/standorte/', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/standorte" body={body} schema={schema} />

<style is:global>
/* /standorte only: compact hero, seven owned/operational cards, one subdued
   secondary disclosure. No shared forms, marketing instrumentation or pages affected. */
#page-standorte .std-overview{
  padding:clamp(28px,3.5vw,46px) 0 clamp(40px,4vw,58px)!important;
  background:var(--tcm-surface-strong,#E8E6E3)!important
}
#page-standorte .std-overview>.wrap{max-width:1200px!important}
#page-standorte #standorte-page-grid.std-grid{display:block;margin:0;max-width:none}
#page-standorte .std-overview-intro{max-width:840px;margin:0 0 31px}
#page-standorte .std-overview-heading{
  font-family:var(--font-sans);font-size:clamp(33px,4vw,54px);
  font-weight:850;line-height:1.08;letter-spacing:-.045em;
  color:var(--tcm-ink,#171B1A);margin:0 0 11px;text-wrap:balance
}
#page-standorte .std-overview-heading em{font-style:italic;color:inherit}
#page-standorte .std-overview-lead{
  max-width:58ch;font-size:clamp(15px,1.25vw,18px);
  line-height:1.5;color:var(--tcm-text-soft,#505453);margin:0 0 20px
}
#page-standorte .std-overview-primary{
  display:inline-flex;align-items:center;justify-content:center;
  min-height:48px;box-sizing:border-box;padding:11px 24px;
  font-family:var(--font-sans);font-size:15px;font-weight:750;
  border-radius:999px;background:var(--tcm-primary,#1769B1);
  color:#fff!important;text-decoration:none
}
#page-standorte .std-overview-primary:hover{background:#12578F;color:#fff!important}
#page-standorte .std-primary-group{margin-top:29px}
#page-standorte .std-primary-group:first-child{margin-top:0}
#page-standorte .std-group-heading{
  font-family:var(--font-sans);font-weight:800;letter-spacing:-.025em;
  line-height:1.15;font-size:clamp(24px,2.4vw,30px);
  color:var(--tcm-ink,#171B1A);margin:0 0 16px
}
#page-standorte .std-featured-grid{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16px;align-items:stretch
}
#page-standorte .std-featured-grid--other{
  grid-template-columns:repeat(2,minmax(0,1fr))
}
#page-standorte .stdc--clinic{
  display:flex;flex-direction:column;align-items:stretch;
  height:100%;min-width:0;padding:0;overflow:hidden;
  border:1px solid rgba(2,11,16,.11);border-radius:18px;
  background:#fff;box-shadow:none;transition:border-color .16s ease,box-shadow .16s ease,transform .16s ease
}
#page-standorte .stdc--clinic:hover{
  border-color:rgba(2,11,16,.28);box-shadow:0 8px 22px rgba(2,11,16,.06);transform:translateY(-1px)
}
#page-standorte .stdc-visual{
  display:block;width:100%;aspect-ratio:16/9;overflow:hidden;
  background:#EDF2F5;flex-shrink:0
}
#page-standorte .stdc-photo{
  display:block;width:100%;height:100%;object-fit:cover;object-position:center;
  margin:0;border:0;border-radius:0
}
#page-standorte .stdc-main{
  display:flex;align-items:center;min-width:0;flex:1;
  padding:17px 19px 10px
}
#page-standorte .stdc-h{
  display:flex;align-items:center;gap:9px;min-height:0;
  margin:0;color:var(--brand-black,#020B10);
  font-family:var(--font-sans);font-size:clamp(21px,1.65vw,24px);
  line-height:1.2;letter-spacing:-.025em;font-weight:800
}
#page-standorte .stdc-h span{
  display:block;overflow:visible;white-space:normal;
  -webkit-line-clamp:unset;min-width:0
}
#page-standorte .stdc-pin{
  display:block;flex:0 0 21px;width:21px;height:21px;margin:0;color:#506579
}
#page-standorte .stdc-actions{
  display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.65fr);
  align-items:center;gap:9px;padding:4px 19px 19px
}
#page-standorte .stdc-primary{
  display:flex;align-items:center;justify-content:center;min-width:0;
  box-sizing:border-box;min-height:48px;border:1px solid var(--tcm-primary,#1769B1);
  border-radius:11px;padding:10px 12px;background:var(--tcm-primary,#1769B1);
  color:#fff!important;font-family:var(--font-sans);font-size:14px;line-height:1.2;
  font-weight:750;text-align:center;text-decoration:none
}
#page-standorte .stdc-primary:hover{background:#12578f;border-color:#12578f;color:#fff!important}
#page-standorte .stdc-more{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  min-height:48px;min-width:0;padding:6px 0;color:#344C5F;
  font-family:var(--font-sans);font-size:14px;font-weight:750;
  text-decoration:none;white-space:nowrap
}
#page-standorte .stdc-more:hover{text-decoration:underline;text-underline-offset:4px}
#page-standorte .std-other-locations{
  margin:34px 0 0;border:1px solid var(--tcm-border,#D7D4D0);
  border-radius:16px;background:#fff;overflow:hidden
}
#page-standorte .std-other-locations>summary{
  display:flex;justify-content:space-between;align-items:center;
  gap:12px;min-height:62px;box-sizing:border-box;padding:16px 20px;
  font-family:var(--font-sans);font-size:17px;line-height:1.3;
  font-weight:800;cursor:pointer;list-style:none;color:#171B1A
}
#page-standorte .std-other-locations>summary::-webkit-details-marker{display:none}
#page-standorte .std-disclosure-meta{
  color:#526272;font-family:var(--font-sans);font-size:13px;
  font-weight:650;white-space:nowrap
}
#page-standorte .std-other-locations[open] .std-disclosure-meta span{display:inline-block;transform:rotate(180deg)}
#page-standorte .std-partner-grid{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  padding:4px 20px 20px;gap:10px
}
#page-standorte .std-partner-row{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;min-width:0;padding:12px 14px;
  border:1px solid #E4E8EA;border-radius:11px;
  color:#171B1A;background:#FAFBFB;text-decoration:none
}
#page-standorte .std-partner-row:hover{border-color:#ADBFCB;background:#F1F6F8}
#page-standorte .std-partner-row-copy{display:flex;flex-direction:column;gap:3px;min-width:0}
#page-standorte .std-partner-row-copy strong{font-family:var(--font-sans);font-size:15px;font-weight:750}
#page-standorte .std-partner-row-copy>span{font-family:var(--font-sans);font-size:12.5px;color:#5B6872}
#page-standorte .std-partner-row-action{
  flex-shrink:0;font-family:var(--font-sans);font-size:13px;
  font-weight:750;color:#344C5F;white-space:nowrap
}
#page-standorte .std-overview :is(a,button,summary):focus-visible{
  outline:3px solid var(--tcm-primary,#1769B1);outline-offset:3px
}
#standorte-anfrage{scroll-margin-top:105px}
@media(max-width:900px){
  #page-standorte .std-featured-grid,
  #page-standorte .std-featured-grid--other{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
  #page-standorte .std-overview{padding:29px 0 37px!important}
  /* Prevent long/italic headline fragments being cropped on narrow phones,
     regardless of global SPA heading and wrap defaults. */
  #page-standorte .std-overview>.wrap{
    width:100%!important;max-width:100%!important;min-width:0;
    box-sizing:border-box!important;padding-left:max(18px,env(safe-area-inset-left))!important;
    padding-right:max(18px,env(safe-area-inset-right))!important
  }
  #page-standorte .std-overview-intro{
    display:block!important;width:100%!important;max-width:100%!important;
    min-width:0;margin:0 0 26px;box-sizing:border-box;overflow:visible!important
  }
  #page-standorte .std-overview-heading{
    display:block!important;width:100%;max-width:100%;min-width:0;
    font-size:clamp(30px,7.7vw,39px)!important;line-height:1.14!important;
    letter-spacing:-.035em;white-space:normal!important;text-wrap:wrap!important;
    word-break:normal;overflow-wrap:anywhere;box-sizing:border-box
  }
  #page-standorte .std-overview-heading em{
    display:inline;white-space:normal!important;overflow-wrap:anywhere
  }
  #page-standorte .std-overview-lead{
    max-width:100%;white-space:normal!important;overflow-wrap:break-word
  }
  #page-standorte .std-overview-primary{
    max-width:100%;white-space:normal;text-align:center;box-sizing:border-box
  }
  #page-standorte .std-featured-grid,
  #page-standorte .std-featured-grid--other{grid-template-columns:minmax(0,1fr);gap:14px}
  #page-standorte .stdc-main{padding:16px 17px 10px}
  #page-standorte .stdc-actions{padding:4px 17px 17px}
  #page-standorte .std-other-locations>summary{
    align-items:flex-start;flex-direction:column;gap:6px;padding:15px 17px
  }
  #page-standorte .std-partner-grid{grid-template-columns:1fr;padding:0 15px 16px}
}
</style>
