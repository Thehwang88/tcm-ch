---
// /standorte — faithful 1:1 reproduction of the live SPA #page-standorte hub.
import SpaPage from '../../layouts/SpaPage.astro';
import body from '../../data/standorte-body.html?raw';

const title = 'Standorte – TCM.ch Kliniken in der Deutschschweiz';
const description =
  'Unsere TCM.ch Kliniken – von Zürich über Winterthur und St. Gallen bis Kreuzlingen. EMR-/ASCA-anerkannt, Krankenkasse 80–100 % über die Zusatzversicherung.';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/standorte', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/standorte" body={body} schema={schema} />

<style is:global>
  /* Mobile hero compression — /standorte only. Lifts the location grid toward the
     first scroll. Every selector namespaced under #standorte-premium-hero so nothing
     leaks to other heroes/pages. Desktop (>768px) is untouched. */
  @media (max-width: 768px) {
    /* tighten hero, and kill the bottom half of the hero->section seam */
    #standorte-premium-hero { padding: var(--section-py) 20px 12px !important; }
    /* image only adds scroll height on mobile */
    #standorte-premium-hero .sg-media { display: none !important; }
    /* drop the long sub paragraph + the secondary (WhatsApp) CTA; keep H1, eyebrow, primary CTA */
    #standorte-premium-hero .sg-sub { display: none !important; }
    #standorte-premium-hero .sg-ctas .btn-secondary { display: none !important; }

    /* --- hero alignment + vertical rhythm --- */
    /* 1. one shared left edge: drop the back-button wrapper's extra 20px inset so it
          lines up with breadcrumb/eyebrow/H1/CTA at the hero's 20px container padding */
    #standorte-premium-hero .back-btn-outer { padding-left: 0 !important; padding-right: 0 !important; }
    /* 3. back button + breadcrumb = subordinate nav group: muted + tightly grouped, then a
          clear 16px break to the H1 content block */
    #standorte-premium-hero .back-btn { margin-bottom: 8px !important; opacity: .55 !important; }
    #standorte-premium-hero .sg-crumb { margin-bottom: 16px !important; }
    /* 2. uniform 8/16 rhythm: eyebrow -> H1 -> location tight (8), block breaks at 16 */
    #standorte-premium-hero .sg-eyebrow { margin-bottom: 8px !important; }
    #standorte-premium-hero .sg-title { margin-bottom: 8px !important; }
    #standorte-premium-hero .sg-location { margin-top: 0 !important; margin-bottom: 16px !important; }
    #standorte-premium-hero .sg-ctas { margin-bottom: 16px !important; }

    /* keep the trust strip, but compact (it is hidden by default on mobile in home.css) */
    #standorte-premium-hero .sg-trust {
      display: flex !important;
      margin-top: 0 !important;
      padding-top: 16px !important;
      gap: 8px 14px !important;
    }
    /* grid section (only the one holding #standorte-grid): kill the top-padding seam and
       drop the duplicate eyebrow + subline that restate the hero; keep H2 as minimal label */
    .section:has(#standorte-grid) { padding-top: 8px !important; }
    .section:has(#standorte-grid) .section-label { display: none !important; }
    .section:has(#standorte-grid) .location-intro { display: none !important; }
    .section:has(#standorte-grid) .section-title { margin-bottom: 12px !important; }
  }
</style>
