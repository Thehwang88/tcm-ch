---
import LayoutDe from '../../layouts/LayoutDe.astro';
import { site } from '../../data/site';
import { standorte } from '../../data/standorte';

const path = '/standorte';
const url = new URL(path, site.url).href;
const title = 'Standorte – TCM.ch Kliniken in der Deutschschweiz';
const description =
  'Unsere TCM.ch Kliniken – von Zürich über Winterthur und St. Gallen bis Kreuzlingen. EMR-/ASCA-anerkannt, Krankenkasse 80–100% über die Zusatzversicherung.';

// open locations first (alphabetical), then "in Planung"
const items = [...standorte].sort((a, b) =>
  (a.open === b.open ? a.name.localeCompare(b.name, 'de') : a.open ? -1 : 1)
);

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Standorte',
  description,
  url,
  inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(`/standorte/${s.slug}`, site.url).href,
    })),
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Standorte', item: url },
  ],
};
const schema = [collectionLd, breadcrumbLd];
---
<LayoutDe title={`${title} | TCM.ch`} description={description} path={path} schema={schema}>
  <section class="hero">
    <div class="wrap hub-hero">
      <div class="eyebrow">Standorte · TCM.ch</div>
      <h1>TCM.ch Kliniken in deiner Nähe</h1>
      <p class="lead">{description}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/kontakt">Termin anfragen</a>
        <a class="btn btn--ghost" href="/beschwerden">Beschwerden ansehen</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="hub-grid">
        {items.map((s) => (
          <a class="hub-card" href={`/standorte/${s.slug}`}>
            <span class="hub-name">
              {s.name}
              {!s.open && <span class="badge">In Planung</span>}
            </span>
            <span class="hub-sub">{s.region}</span>
            <span class="hub-go">Mehr erfahren <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>

      <p class="hub-foot">
        Kein Standort in deiner Nähe? <a href="/kontakt">Schreib uns kurz</a> –
        wir buchen dich in die nächstgelegene TCM.ch-Klinik ein.
      </p>
    </div>
  </section>
</LayoutDe>

<style>
  .hub-hero { max-width: 720px; }
  .hero .lead { max-width: 660px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 0; }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    grid-auto-rows: 1fr;
  }
  .hub-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 18px 18px 16px;
    text-decoration: none;
    background: var(--white);
    transition: border-color var(--t-fast) ease, box-shadow var(--t-fast) ease, transform var(--t-fast) ease;
  }
  .hub-card:hover { border-color: var(--blue); box-shadow: var(--sh-card); transform: translateY(-2px); }
  .hub-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .badge { display: inline-block; margin-left: 6px; background: var(--blue-light); color: var(--blue-dark); font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; border-radius: var(--r-pill); vertical-align: middle; }
  .hub-sub { font-size: 13px; color: var(--muted); margin-top: 4px; min-height: 1.3em; }
  .hub-go { margin-top: auto; padding-top: 12px; font-size: 13px; font-weight: 700; color: var(--blue); }

  .hub-foot { margin-top: 32px; font-size: 15px; color: var(--mid); border-top: 1px solid var(--border); padding-top: 20px; }
  .hub-foot a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .hub-foot a:hover { text-decoration: underline; }

  @media (max-width: 980px) { .hub-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .hub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
</style>
