---
// /standorte - faithful 1:1 reproduction of the live SPA #page-standorte hub.
import SpaPage from '../../layouts/SpaPage.astro';
import bodyRaw from '../../data/standorte-body.html?raw';
import { standortCardHtml, standortGridHtml } from '../../lib/standort-card';
// Standortkarten (05.11.2026): zentrale Komponente, Variante hero ohne Foto (Stufe 1+2), kompakt (Stufe 3). Kein stiller Fallback.
const body = bodyRaw
  .replace('<!--sc:std-zuerich-->', standortGridHtml(['zuerich-bahnhofstrasse', 'zuerich-oerlikon', 'zuerich-hoengg'], { variant: 'hero', cols: 3 }))
  .replace('<!--sc:std-stgallen-->', standortCardHtml('st-gallen', { variant: 'hero', extraClass: 'std-sg-card' }))
  .replace('<!--sc:std-stufe2-->', standortGridHtml(['frauenfeld', 'kreuzlingen', 'winterthur-muenzgasse'], { variant: 'hero', cols: 3 }))
  .replace('<!--sc:std-stufe3-->', standortGridHtml(['bottighofen', 'rorschach', 'wil', 'volketswil', 'basel', 'luzern', 'bern', 'winterthur-marktgasse'], { variant: 'kompakt', cols: 4 }));
if (/<!--sc:/.test(body) || (body.match(/class="sc sc--/g) || []).length !== 15) throw new Error('standorte/index.astro: Standortkarten nicht vollständig gerendert');

const title = 'Standorte – TCM.ch Kliniken in der Deutschschweiz';
const description =
  'Unsere TCM.ch Kliniken – von Zürich über Winterthur und St. Gallen bis Kreuzlingen. EMR-/ASCA-anerkannt, Krankenkasse 80–100 % über die Zusatzversicherung.';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
  url: 'https://tcm.ch/standorte/', inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<SpaPage title={title} description={description} path="/standorte" body={body} schema={schema} />

<style is:global>
  /* /standorte only: Grid-Section rueckt an den Hero. Die frueheren
     #standorte-premium-hero-Regeln sind mit dem hh-Hero (home.css) obsolet
     und entfernt — das alte Hero-Markup existiert nicht mehr. */
  @media (max-width: 768px) {
    /* grid section (only the one holding #standorte-grid): kill the top-padding seam and
       drop the duplicate eyebrow + subline that restate the hero; keep H2 as minimal label */
    .section:has(#standorte-grid) { padding-top: 8px !important; }
    .section:has(#standorte-grid) .section-label { display: none !important; }
    .section:has(#standorte-grid) .location-intro { display: none !important; }
    .section:has(#standorte-grid) .section-title { margin-bottom: 12px !important; }
  }
  @media (min-width: 769px) {
    .section:has(#standorte-grid) { padding-top: 56px !important; }
    /* Zürich-Block: Headline sitzt direkt über dem grünen Container, kein doppelter Abstand */
    #standorte-zuerich { margin-top: 36px !important; }
  }
  /* Gliederung 05.11.2026: Sprunglinks, Stufe 1 (Zürich 2/3 + St. Gallen 1/3, gleich hoch), Stufe 2/3 mit Zwischentiteln. */
  .std-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 20px; }
  .std-jump a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1.5px solid var(--border); border-radius: 999px; font-family: var(--font-sans); font-size: 14.5px; font-weight: 700; color: var(--black); text-decoration: none; background: #fff; }
  .std-jump a:hover { border-color: var(--blue); }
  .std-stufe1 { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16px; align-items: stretch; margin-top: 8px; }
  .std-zh { display: flex; flex-direction: column; gap: 14px; }
  .std-zh-box { background: #F4FAF8; border: 1px solid rgba(45,155,111,.14); border-radius: 18px; padding: 22px 20px; }
  .std-label { font-size: 11.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--blue); font-family: var(--font-sans); }
  .std-zh-h { font-family: var(--font-sans); font-size: 22px; font-weight: 800; letter-spacing: -.02em; color: var(--charcoal); margin: 6px 0 6px; }
  .std-zh-p { font-size: 15px; color: var(--mid); line-height: 1.55; margin: 0 0 14px; }
  .std-zh-btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .std-next { display: flex; align-items: center; gap: 16px; border: 1px solid var(--border); border-radius: 16px; padding: 14px 18px; background: #fff; text-decoration: none; color: inherit; }
  .std-next-l { font-family: var(--font-sans); font-size: 11.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--black); white-space: nowrap; }
  .std-next-t { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: var(--mid); }
  .std-next-t strong { font-family: var(--font-sans); font-size: 16px; color: var(--black); }
  .std-next-go { font-family: var(--font-sans); font-size: 14px; font-weight: 700; color: var(--black); white-space: nowrap; }
  .std-sg .sc { height: 100%; }
  .std-h3 { font-family: var(--font-sans); font-size: 20px; font-weight: 800; letter-spacing: -.02em; color: var(--black); margin: 36px 0 6px; scroll-margin-top: 90px; }
  .std-sub { font-size: 14.5px; color: var(--mid); margin: 0 0 14px; }
  .std-finder { margin: 18px 0 0; font-size: 15px; }
  .std-finder a { color: var(--blue); font-weight: 700; text-decoration: none; }
  #standorte-zuerich, #standorte-st-gallen, #standorte-thurgau { scroll-margin-top: 90px; }
  @media (max-width: 900px) { .std-stufe1 { grid-template-columns: minmax(0, 1fr); } .std-next { flex-wrap: wrap; } }
</style>
