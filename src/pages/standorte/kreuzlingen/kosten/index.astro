export const prerender = true;
import SpaPage from '../../../../layouts/SpaPage.astro';
import body from '../../../../data/kreuzlingen-kosten-body.html?raw';

const url = 'https://tcm.ch/standorte/kreuzlingen/kosten/';
const title = 'Akupunktur Kosten Kreuzlingen – Preise & Krankenkasse | TCM.ch';
const description =
  'Was kostet Akupunktur in Kreuzlingen? Rund CHF 130 bis 160 pro Sitzung, Tarif 590. Zusatzversicherung übernimmt meist 80 bis 100%. Deckung kostenlos prüfen.';

const faqs = [
  {
    q: "Übernimmt die Grundversicherung Akupunktur in Kreuzlingen?",
    a: "Nein. Akupunktur bei Therapeut:innen läuft ausschliesslich über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Ohne passende Zusatzversicherung zahlst du selbst. Wir prüfen deine Deckung kostenlos, bevor du das erste Mal kommst, damit du vorher weisst, woran du bist.",
  },
  {
    q: "Wie prüfe ich meine Deckung?",
    a: "Am einfachsten schickst du uns deine Krankenkasse und dein Versicherungsmodell, wir klären für dich, was deine Zusatzversicherung übernimmt. Das ist kostenlos und unverbindlich. Alternativ steht die Beteiligung in deiner Police, oder du fragst direkt bei deiner Kasse nach.",
  },
  {
    q: "Was kostet die Erstbehandlung?",
    a: "Die Erstkonsultation dauert länger, weil die Anamnese Zeit braucht, oft bis zu 90 Minuten. Abgerechnet wird nach Tarif 590 nach Dauer, entsprechend liegt sie über einer Folgesitzung. Den konkreten Betrag nennen wir dir vorab, bevor behandelt wird.",
  },
  {
    q: "Brauche ich eine Überweisung vom Arzt?",
    a: "Nein. Du kannst direkt einen Termin anfragen, eine ärztliche Überweisung ist für die Behandlung nicht nötig. Wenn wir im Erstgespräch merken, dass dein Anliegen zuerst ärztlich abgeklärt gehört, sagen wir dir das ehrlich und verweisen dich weiter.",
  },
  {
    q: "Was zahle ich als Patient:in aus Konstanz?",
    a: "Behandelt wird in der Schweiz, abgerechnet nach Schweizer Tarif. Wer als Grenzgänger:in eine Schweizer Zusatzversicherung hat, reicht die Rechnung ein wie alle anderen. Eine deutsche gesetzliche Kasse erstattet die Behandlung in der Regel nicht, private Tarife teilweise. Ohne Deckung zahlst du selbst, zu denselben Preisen und ohne Aufschlag.",
  },
];

const schema = [
