      { '@type': 'ListItem', position: 3, name: 'Kreuzlingen', item: 'https://tcm.ch/standorte/kreuzlingen/' },
      { '@type': 'ListItem', position: 4, name: 'Kosten & Krankenkasse', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': url + '#faq',
