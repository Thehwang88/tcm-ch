---
// /standorte/luzern/ — Pre-Opening-Standortseite (Eröffnung 2027, noch keine Adresse).
// Targetet "tcm luzern" + "akupunktur luzern" (gehören per Anti-Kannibalisierungs-Regel
// hierher, nicht zu /massage-luzern/). Kein MedicalClinic-Schema, solange es keinen
// NAP-Datensatz gibt; Warteliste statt Buchungs-CTA, analog /massage-luzern/.
// Statische Route gewinnt gegen [slug].astro; bei Eröffnung auf den kanonischen
// data-driven Flow (src/data/standorte.ts) migrieren und diese Datei löschen.
import SpaPage from '../../layouts/SpaPage.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import MassageWartelisteForm from '../../components/MassageWartelisteForm.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import css from '../../data/massage-city.css?raw';

const url = 'https://tcm.ch/standorte/luzern/';
const title = 'TCM & Akupunktur Luzern | TCM.ch';
const description = 'TCM & Akupunktur Luzern: TCM.ch eröffnet 2027 eine Praxis in der Stadt Luzern. Akupunktur, Tuina und chinesische Kräuter, EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100%. Jetzt auf die Warteliste.';

const faqs = [
  { q: 'Wann eröffnet TCM.ch in Luzern?', a: 'Wir eröffnen 2027. Ein genaues Datum steht noch nicht fest, weil die Räume gerade gesucht werden. Trag dich auf die Warteliste ein, dann melden wir uns, sobald Adresse und Terminvergabe feststehen, und du kommst vor der offiziellen Freigabe dran.' },
  { q: 'Was wird die Praxis in Luzern anbieten?', a: 'Geplant ist das volle TCM.ch Spektrum wie an unseren bestehenden Standorten: Akupunktur, Tuina, Schröpfen, Gua Sha, Moxibustion und individuell zusammengestellte Kräuterrezepturen. Das genaue Angebot hängt vom Team vor Ort ab und steht ab Eröffnung auf dieser Seite.' },
  { q: 'Zahlt die Krankenkasse Akupunktur in Luzern?', a: 'Es gilt dasselbe wie an allen TCM.ch Standorten: Behandelt wird durch EMR- und ASCA-anerkannte Therapeut:innen, deshalb beteiligt sich die Zusatzversicherung für Komplementärmedizin je nach Modell mit 80 bis 100 Prozent. Die Grundversicherung übernimmt Akupunktur nicht. Deine Deckung prüfen wir kostenlos.' },
  { q: 'Wo finde ich bis zur Eröffnung eine Behandlung?', a: 'An unseren bestehenden Standorten in der Deutschschweiz, von Zürich über Winterthur bis St. Gallen, bekommst du meist innert 24 bis 48 Stunden einen Termin. Die Übersicht mit allen Adressen findest du unter Standorte oder über die Seite Akupunktur in deiner Nähe.' },
  { q: 'Kostet die Warteliste etwas?', a: 'Nein. Es braucht nur eine E-Mail-Adresse, keine Anzahlung und keine Verpflichtung. Wir schreiben dir einmal, wenn die Termine in Luzern freigegeben sind. Keine Werbung, keine Weitergabe an Dritte.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
    { '@type': 'ListItem', position: 3, name: 'Luzern', item: url },
  ] },
];
const faqHtml = faqs.map((f) => `<details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0"><summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">${f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary><div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">${f.a}</div></details>`).join('');

const hero = `<div class="msg-page">
<section class="section msg-hero">
  <div class="wrap">
    <div class="msg-crumb"><a href="/">TCM.ch</a> <span>&rsaquo;</span> <a href="/standorte/">Standorte</a> <span>&rsaquo;</span> <span>Luzern</span></div>
    <div class="msg-hero-grid">
      <div>
        <div class="msg-crumb" style="margin-bottom:10px"><span style="display:inline-flex;align-items:center;gap:6px;background:var(--green-mint);border:1px solid var(--green-mid);color:var(--green-dark);font-family:var(--font-sans);font-weight:800;font-size:12px;letter-spacing:.04em;padding:5px 12px;border-radius:100px">Eröffnung 2027</span></div><h1 class="msg-h1">TCM &amp; <em>Akupunktur Luzern.</em></h1>
        <p class="msg-lead">TCM.ch eröffnet 2027 eine eigene Praxis in der Stadt Luzern. TCM Luzern heisst dann: Akupunktur, Tuina, Schröpfen und chinesische Kräuterrezepturen bei EMR- und ASCA-anerkannten Therapeut:innen, über die Zusatzversicherung je nach Modell mit 80 bis 100 Prozent abrechenbar. Trag dich auf die Warteliste ein, dann bekommst du einen der ersten Termine.</p>
        <div class="msg-hero-ctas">
          <a href="#warteliste" class="btn-primary">Auf die Warteliste</a><a href="/standorte/" class="btn-secondary">Bestehende Standorte</a>
        </div>
        <div class="msg-hero-trust">
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Eröffnung 2027</span>
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>EMR &amp; ASCA anerkannt</span>
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Warteliste offen</span>
        </div>
      </div>
      <div class="msg-hero-media">
        <img src="/images/hero-main.webp" width="1120" height="747" alt="Akupunktur-Behandlung bei TCM.ch" fetchpriority="high" decoding="async">
      </div>
    </div>
  </div>
</section>`;

const rest = `<section class="section">
  <div class="wrap" style="max-width:760px">
    <div class="section-label">Standort Luzern</div>
    <h2 class="section-title">Was in Luzern <em>geplant ist.</em></h2>
    <div class="msg-prose">
      <p>Die Zentralschweiz ist komplementärmedizinisch dünner besetzt als der Grossraum Zürich, gerade bei Behandlungen, die über die Zusatzversicherung laufen. Deshalb kommt der nächste TCM.ch Standort nach Luzern: eine Praxis für die Stadt und die umliegenden Gemeinden, von Kriens und Emmen über Horw und Ebikon bis in den Raum Zug.</p>
      <p>Geplant ist das volle Behandlungsspektrum, das du von unseren bestehenden Praxen kennst: <a href="/therapien/akupunktur/">Akupunktur</a>, <a href="/therapien/tuina/">Tuina</a>, <a href="/therapien/schroepfen/">Schröpfen</a>, Gua Sha, Moxibustion und individuell zusammengestellte Kräuterrezepturen. Behandelt wird durch EMR- und ASCA-anerkannte Therapeut:innen, damit die <a href="/krankenkassen/">Zusatzversicherung</a> die Kosten je nach Modell zu 80 bis 100 Prozent übernimmt.</p>
      <p>Suchst du gezielt eine Behandlung gegen Verspannungen statt eine ganze TCM-Therapie? Dann findest du Angebot und Warteliste auf der Seite <a href="/massage-luzern/">Massage Luzern</a>.</p>
      <p>Bis zur Eröffnung bekommst du an unseren bestehenden Standorten meist innert 24 bis 48 Stunden einen Termin. Am nächsten liegen die Praxen im Raum Zürich, die vollständige Übersicht steht unter <a href="/akupunktur-in-der-naehe/">Akupunktur in deiner Nähe</a>.</p>
    </div>
  </div>
</section>
<section class="section" style="background:var(--surface)">
  <div class="wrap" style="max-width:820px">
    <div class="section-label">Häufige Fragen</div>
    <h2 class="section-title" style="margin-bottom:20px">FAQ zu <em>TCM Luzern</em></h2>
    <div class="faq-list">${faqHtml}</div>
  </div>
</section>
</div>`;
---
<SpaPage title={title} description={description} path="/standorte/luzern" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={hero} />
  <InsuranceBanner variant="inline" location="Luzern" />
  <Fragment set:html={rest} />
  <MassageWartelisteForm stadt="Luzern" jahr="2027" quelle="warteliste-luzern-standort" />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Team TCM.ch" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
