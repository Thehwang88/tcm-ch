      <div class="cl-links" style="margin-top:18px">
        {['Basel-Stadt','Riehen','Bettingen','Binningen','Allschwil','Münchenstein','Reinach','Muttenz','Pratteln','Oberwil','Therwil','Liestal','Sissach','Birsfelden'].map((o) => (
          <span class="cl-chip" style="cursor:default">{o}</span>
        ))}
      </div>
    </div>
