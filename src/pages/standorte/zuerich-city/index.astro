---
// /standorte/zuerich-city/ — schmale Intent-Seite für "TCM/Akupunktur Zürich City
// & Zentrum". KEIN zweiter Zürich-Hub (das bleibt /akupunktur-tcm-zuerich/) und
// KEIN eigener zukünftiger Klinik-Standort mehr: Die frühere Flagship-/
// Bahnhofstrasse-/2028-Story ist entfernt. Die Seite beantwortet den City-Intent
// und routet zur realen City-Location, dem City Pop-up TCM.ch Zürich Bellevue
// (Rössligasse 8, Kreis 1, Start 19.10.2026).
//
// Bewusst schlank gehalten (kein Hub-Duplikat, keine Standortkarten-Kopie,
// keine Klinik-Schema-Auszeichnung — es gibt hier keine eigene Praxis).
export const prerender = true;
import SpaPage from '../../../layouts/SpaPage.astro';

const url = 'https://tcm.ch/standorte/zuerich-city/';
const title = 'TCM & Akupunktur Zürich City & Zentrum | TCM.ch';
const description =
  'TCM und Akupunktur im Zentrum von Zürich: TCM.ch ist mit dem City Pop-up am Bellevue (Rössligasse 8, Kreis 1) mitten in Zürich City für dich da. Jetzt Termin im Zentrum finden.';

const faqs = [
  {
    q: 'Wo finde ich TCM.ch in Zürich City?',
    a: 'Unser Standort im Zentrum ist TCM.ch Zürich Bellevue an der Rössligasse 8, 8001 Zürich — mitten im Kreis 1, wenige Schritte vom Bellevueplatz und nahe beim Bahnhof Stadelhofen. Der City Pop-up startet am 19. Oktober 2026.',
  },
  {
    q: 'Kann ich im Zentrum von Zürich direkt einen Termin anfragen?',
    a: 'Ja. Du fragst deinen Termin direkt über die Bellevue-Seite an. Wenn dort gerade nichts passt, prüfen wir freie Termine an unseren weiteren Zürcher Standorten in Oerlikon und Höngg.',
  },
  {
    q: 'Zahlt die Krankenkasse die Behandlung?',
    a: 'Akupunktur läuft über die Zusatzversicherung für Komplementärmedizin. Bei den meisten Kassen sind 80 bis 100 Prozent gedeckt; deine Deckung prüfen wir kostenlos, bevor Kosten entstehen.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url,
    inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Zürich City', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<SpaPage title={title} description={description} path="/standorte/zuerich-city" body="" schema={schema}>

  <!-- ── HERO ── -->
  <section class="zc-hero">
    <div class="zc-hero-inner">
      <div class="sg-crumb" style="font-size:12.5px;color:var(--muted);margin-bottom:18px"><a href="/" style="color:inherit">TCM.ch</a> › <a href="/standorte/" style="color:inherit">Standorte</a> › <span>Zürich City</span></div>
      <span class="zc-badge">Zürich City &amp; Zentrum</span>
      <h1 class="zc-h1">TCM &amp; Akupunktur in <span class="zc-accent">Zürich City</span></h1>
      <p class="zc-sub">TCM.ch ist jetzt auch mitten in Zürich City für dich da: Unser Standort im Zentrum ist der City Pop-up <strong>TCM.ch Zürich Bellevue</strong> an der Rössligasse 8 im Kreis 1 — wenige Schritte vom Bellevueplatz, nahe beim Bahnhof Stadelhofen. Start: 19. Oktober 2026.</p>
      <div class="zc-cta-row">
        <a href="/standorte/zuerich-bellevue/#termin" class="zc-btn-primary">Termin in Zürich City finden</a>
        <a href="/akupunktur-tcm-zuerich/" class="zc-btn-ghost">Alle Zürcher Standorte</a>
      </div>
      <div class="zc-trust">
        <div><span class="zc-check">✓</span> EMR- und ASCA-anerkannt</div>
        <div><span class="zc-check">✓</span> Krankenkasse 80 bis 100%</div>
        <div><span class="zc-check">✓</span> Keine Überweisung nötig</div>
      </div>
    </div>
  </section>

  <!-- ── CITY-STANDORT ── -->
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Im Zentrum</div>
      <h2 class="section-title">Dein TCM.ch Standort <em>in der City.</em></h2>
      <p class="section-sub">Mitten im Kreis 1, zwischen Bellevueplatz, See und Altstadt: Am Bellevue behandeln wir mit Akupunktur und weiteren TCM-Methoden — medizinisch geführt, mit viel Zeit pro Termin und über die Zusatzversicherung abrechenbar.</p>
      <div style="margin-top:24px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:22px 24px">
        <div style="font-weight:800;font-family:var(--font-sans);letter-spacing:-.01em;margin-bottom:6px">TCM.ch Zürich Bellevue</div>
        <p style="font-size:15px;line-height:1.7;color:var(--mid);margin:0">bei Élu Cosmetics<br>Rössligasse 8, 8001 Zürich<br>Start: 19. Oktober 2026 · aktuell montags</p>
        <a href="/standorte/zuerich-bellevue/" class="btn-secondary" style="display:inline-flex;margin-top:16px">Zum Standort Bellevue →</a>
      </div>
      <p style="margin-top:20px">Kein passender Termin im Zentrum? Wir prüfen gerne freie Termine an unseren weiteren Zürcher Standorten in <a href="/standorte/zuerich-oerlikon/">Oerlikon</a> und <a href="/standorte/zuerich-hoengg/">Höngg</a>. Den Überblick über Akupunktur und Chinesische Medizin in der ganzen Stadt gibt die Seite <a href="/akupunktur-tcm-zuerich/">TCM Zürich</a>, Preise stehen unter <a href="/standorte/zuerich/kosten/">Akupunktur-Kosten in Zürich</a>.</p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Häufige Fragen</div>
      <h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>TCM in Zürich City</em></h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0">
            <summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">{f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary>
            <div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">{f.a}</div>
          </details>
        ))}
      </div>
      <div class="cl-links" style="margin-top:26px">
        <a href="/standorte/zuerich-bellevue/" class="cl-chip">Zürich Bellevue</a>
        <a href="/akupunktur-tcm-zuerich/" class="cl-chip">TCM Zürich</a>
        <a href="/standorte/zuerich/kosten/" class="cl-chip">Kosten &amp; Krankenkasse Zürich</a>
        <a href="/therapien/akupunktur/" class="cl-chip">Akupunktur</a>
      </div>
    </div>
  </section>

  <!-- ── END-CTA ── -->
  <section class="cta-band" style="background:var(--blue);padding:48px 0">
    <div class="wrap" style="text-align:center">
      <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Dein Termin im Zentrum von Zürich</h2>
      <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Am Bellevue oder an einem unserer weiteren Zürcher Standorte — wir finden den passenden Termin für dich.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn-white" href="/standorte/zuerich-bellevue/#termin" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin in Zürich City finden</a>
      </div>
    </div>
  </section>

<style>
  .zc-hero { padding-top: 68px; background: var(--surface); font-family: var(--font-sans); color: var(--charcoal); }
  .zc-hero-inner { max-width: 860px; margin: 0 auto; padding: clamp(32px, 6vw, 64px) var(--pad-x) clamp(40px, 7vw, 72px); }
  .zc-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue-light); color: var(--blue-dark); border: 1px solid rgba(45, 155, 111, .18);
    padding: 6px 13px; border-radius: var(--r-pill);
    font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  }
  .zc-h1 { font-size: clamp(2.1rem, 5.2vw, 3.2rem); line-height: 1.06; letter-spacing: -.03em; font-weight: 800; margin: 18px 0 14px; }
  .zc-accent { color: var(--blue); }
  .zc-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--mid); max-width: 62ch; line-height: 1.6; }
  .zc-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .zc-btn-primary {
    background: var(--blue); color: #fff; text-decoration: none;
    padding: 15px 24px; border-radius: var(--r-btn); font-size: 16px; font-weight: 700; box-shadow: var(--sh-btn);
  }
  .zc-btn-primary:hover { background: var(--blue-dark); }
  .zc-btn-ghost {
    background: transparent; color: var(--charcoal); border: 1px solid var(--border); text-decoration: none;
    padding: 15px 22px; border-radius: var(--r-btn); font-size: 16px; font-weight: 600;
  }
  .zc-btn-ghost:hover { border-color: var(--blue); color: var(--blue-dark); }
  .zc-trust { display: flex; gap: 22px; margin-top: 28px; flex-wrap: wrap; font-size: 14px; color: var(--mid); }
  .zc-trust div { display: flex; align-items: center; gap: 7px; }
  .zc-check { color: var(--blue); font-weight: 800; }
  @media (max-width: 767px) { .zc-hero { padding-top: 60px; } .zc-hero-inner { padding-left: 16px; padding-right: 16px; } }
</style>
</SpaPage>
