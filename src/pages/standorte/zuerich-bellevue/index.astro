      <div class="section-label">Häufige Fragen</div>
      <h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>TCM &amp; Akupunktur am Bellevue</em></h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0">
            <summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">{f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary>
            <div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">{f.a}</div>
          </details>
        ))}
      </div>
      <div class="cl-links" style="margin-top:26px">
        <a href="/akupunktur-tcm-zuerich/" class="cl-chip">TCM Zürich</a>
        <a href="/standorte/zuerich/kosten/" class="cl-chip">Kosten &amp; Krankenkasse Zürich</a>
        <a href="/therapien/akupunktur/" class="cl-chip">Akupunktur</a>
        <a href="/therapien/akupressur/" class="cl-chip">Akupressur</a>
        <a href="/massage-zuerich/" class="cl-chip">Massage Zürich</a>
      </div>
    </div>
  </section>

  <!-- ── ZÜRICH-ROUTING / PRAXEN IN DER NÄHE (sichtbar, conversion-kritisch) ── -->
  <section class="related-section" style="background:#fff">
    <div class="wrap">
      <div class="section-label">Weitere Standorte</div>
      <h2 class="section-title">TCM.ch in <em>Zürich</em></h2>
      <p class="section-sub"><strong>Kein passender Termin am Bellevue?</strong> Wir finden gerne einen passenden Termin an einem unserer Zürcher Standorte - oder du sicherst dir direkt den <a href="#termin">nächsten freien Termin in Zürich</a>. Den Überblick gibt die Seite <a href="/akupunktur-tcm-zuerich/">Akupunktur &amp; TCM in Zürich</a>.</p>
      <div class="city-grid reveal">
        {nearby.map((n) => (
          <a href={`/standorte/${n.slug}/`} class="city-card location-card"><span class="location-plz">{n.meta}</span><div class="location-city">{n.city}</div><div class="location-desc">{n.desc}</div><span class="location-link">Standort ansehen →</span></a>
        ))}
      </div>
    </div>
