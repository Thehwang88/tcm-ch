  <!-- ── KONTAKT / TERMINANFRAGE (zentrale Komponente wie St. Gallen/Oerlikon) ── -->
  <KontaktForm data={kontaktData} sitekey={turnstileSitekey} />

  <!-- ── END-CTA ── -->
  <section class="cta-band" style="background:var(--blue);padding:48px 0">
    <div class="wrap" style="text-align:center">
      <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Dein Termin in Zürich</h2>
      <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Am Bellevue oder an einem unserer weiteren Zürcher Standorte - sag uns, wann es dir passt, wir finden den passenden Termin.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn-white" href="#termin" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin in Zürich finden</a>
        <a href="https://wa.me/41775236122?text=Hallo%2C%20ich%20m%C3%B6chte%20einen%20Termin%20in%20Z%C3%BCrich%20%28Bellevue%29." target="_blank" rel="noopener" style="display:inline-flex;align-items:center;font-family:var(--font-sans);font-weight:700;font-size:15px;color:#fff;text-decoration:none;padding:14px 24px;border:1.5px solid rgba(255,255,255,.4);border-radius:var(--r-btn)">Per WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Mobile Sticky-CTA (bestehende Komponente; springt zum Hero-Formular) -->
  <StickyCta prefill="Hallo, ich möchte einen Termin in Zürich (Bellevue) anfragen." formTarget="#termin" />

<style>
  .svc-card, .kt-feature, .city-card { text-decoration: none; color: inherit; }

  /* ── Progressive Disclosure (nur mobil): .mob-extra-Elemente sind server-
     gerendert und auf Desktop immer sichtbar; unter 768px blendet .mob-collapsed
     sie aus, bis der zugehörige "Weitere anzeigen"-Button (nur mobil sichtbar)
     die Klasse entfernt. Kein Lazy-Load, keine Layout-Shifts beim Initial-Render. */
  .mob-more-btn { display: none; }
  @media (max-width: 767px) {
    .mob-more-btn {
      display: inline-flex; width: 100%; max-width: 100%; justify-content: center;
      white-space: normal; text-align: center; box-sizing: border-box;
    }
    .mob-collapsed .mob-extra { display: none !important; }
  }

  /* ── Mobiler Seitenrhythmus: engere Section-Abstände + kompakter Ablauf ── */
  @media (max-width: 767px) {
    .section, .related-section { padding: 52px 0; }
    .section-sub { margin-bottom: 0; }
    .ablauf-grid { gap: 10px; }
    .ablauf-grid .usp-card { padding: 14px 16px; display: flex; gap: 12px; align-items: flex-start; }
    .ablauf-grid .usp-icon { flex-shrink: 0; margin-bottom: 0; }
  }

  /* Hero-Styles wie /standorte/basel/ bzw. /standorte/luzern/ (1:1 nach
     HeroLaunchSG.astro), Astro scoped die Regeln auf diese Seite. */
  .lu-hero { padding-top: 68px; background: var(--surface); font-family: var(--font-sans); color: var(--charcoal); }
  .lu-hero-inner {
    max-width: var(--max); margin: 0 auto;
    padding: clamp(32px, 6vw, 64px) var(--pad-x) clamp(40px, 7vw, 72px);
    display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(28px, 5vw, 56px); align-items: center;
  }
  @media (max-width: 900px) { .lu-hero-inner { grid-template-columns: 1fr; gap: 32px; } }

  .lu-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue-light); color: var(--blue-dark); border: 1px solid rgba(45, 155, 111, .18);
    padding: 6px 13px; border-radius: var(--r-pill);
    font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  }
  .lu-h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.4rem); line-height: 1.06; letter-spacing: -.03em; font-weight: 800;
    margin: 18px 0 14px; color: var(--charcoal);
  }
  .lu-accent { color: var(--blue); }
  .lu-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--mid); max-width: 44ch; line-height: 1.55; }

  .lu-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .lu-btn-primary {
    background: var(--blue); color: #fff; border: none; text-decoration: none;
    padding: 15px 24px; border-radius: var(--r-btn); font-size: 16px; font-weight: 700;
    box-shadow: var(--sh-btn); transition: background var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .lu-btn-primary:hover { background: var(--blue-dark); transform: translateY(-2px); }
  .lu-btn-ghost {
    background: transparent; color: var(--charcoal); border: 1px solid var(--border); text-decoration: none;
    padding: 15px 22px; border-radius: var(--r-btn); font-size: 16px; font-weight: 600;
  }
  .lu-btn-ghost:hover { border-color: var(--blue); color: var(--blue-dark); }

  .lu-trust { display: flex; gap: 22px; margin-top: 28px; flex-wrap: wrap; font-size: 14px; color: var(--mid); }
  .lu-trust div { display: flex; align-items: center; gap: 7px; }
  .lu-check { color: var(--blue); font-weight: 800; }

  .lu-card {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, #ffffff, #f2f5f0);
    border: 1px solid rgba(18, 33, 28, .08); border-radius: var(--r-hero);
    padding: 32px; box-shadow: 0 24px 60px -20px rgba(0, 0, 0, .18);
  }
  .lu-ribbon {
    position: absolute; top: 16px; right: -42px;
    background: #FFC107; color: #2a2109; font-weight: 800; font-size: 11.5px; letter-spacing: .08em;
    padding: 6px 48px; transform: rotate(45deg); box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .3);
  }
  .lu-card-h { font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 800; letter-spacing: -.02em; margin: 6px 0 5px; line-height: 1.15; }
  .lu-note { color: var(--mid); font-size: 14.5px; }
  .lu-divider { height: 1px; background: var(--border); margin: 22px 0; }

  .lu-wl-form { display: flex; flex-direction: column; gap: 10px; }
  .lu-wl-form input[type="email"], .lu-wl-form input[type="text"]:not([name="website"]), .lu-wl-form input[type="tel"], .lu-wl-form select {
    border: 1px solid var(--border); border-radius: 10px; padding: 13px 14px; font-size: 15px;
    background: #fff; font-family: inherit; color: var(--charcoal); width: 100%;
  }
  .lu-wl-form input:focus, .lu-wl-form select:focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: transparent; }
  .lu-select-label { font-size: 12.5px; font-weight: 700; color: var(--mid); letter-spacing: .03em; text-transform: uppercase; margin-top: 4px; }
  .lu-wl-form button {
    background: var(--blue); color: #fff; border: none; border-radius: 10px;
    padding: 14px; font-size: 15.5px; font-weight: 700; cursor: pointer;
    transition: background var(--t-fast) var(--ease-out);
  }
  .lu-wl-form button:hover { background: var(--blue-dark); }
  .lu-wl-form button:disabled { opacity: .65; cursor: default; }
  .lu-form-rule { font-size: 12px; color: var(--mid); text-align: center; }
  .lu-ts { min-height: 0; }
  .lu-form-err { font-size: 13px; color: #c0392b; line-height: 1.5; margin-top: 2px; }

  @media (max-width: 767px) {
    .lu-hero { padding-top: 60px; }
    .lu-hero-inner { padding-left: 16px; padding-right: 16px; }
    .lu-card { padding: 18px; }
    .lu-card, .lu-card * { max-width: 100%; }
    .lu-ts { max-width: 100%; overflow-x: auto; }
    .lu-wl-form input, .lu-wl-form select, .lu-wl-form button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .lu-btn-primary:hover { transform: none; } }
</style>

  <script is:inline>
    (function () {
      // "Weitere anzeigen"-Buttons (mobil): klappen server-gerenderte Inhalte auf.
      // Mit data-label-less wird der Button zum Auf-/Zuklapp-Toggle, sonst
      // verschwindet er nach dem ersten Aufklappen (One-Shot).
      document.querySelectorAll('[data-more-target]').forEach(function (b) {
        var less = b.getAttribute('data-label-less');
        var more = b.textContent;
        b.addEventListener('click', function () {
          var t = document.getElementById(b.getAttribute('data-more-target'));
          if (!t) return;
          var open = t.classList.toggle('mob-collapsed') === false;
          b.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (less) { b.textContent = open ? less : more; }
          else if (open) { b.style.display = 'none'; }
        });
      });

      var f = document.querySelector('[data-lu-termin]');
      if (!f) return;
      var btn = f.querySelector('button[type="submit"]');
      var errEl = f.querySelector('.lu-form-err');
      var showErr = function (m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } };
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errEl) errEl.hidden = true;
        var val = function (n) { var el = f.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ''; };
        var name = val('name'), telefon = val('telefon'), email = val('email'), standort = val('standort') || 'Zürich Bellevue';
        if (!name) { showErr('Bitte deinen Namen angeben.'); return; }
        if (!telefon) { showErr('Bitte eine Telefonnummer angeben.'); return; }
        if (!email || email.indexOf('@') < 1) { showErr('Bitte eine gültige E-Mail-Adresse angeben.'); return; }
        var ts = window.tcmTsToken ? window.tcmTsToken(f)
          : { el: f.querySelector('.cf-turnstile'), token: (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '' };
        if (ts.el && !ts.token) { showErr('Kurz bestätigen, dass du kein Roboter bist, dann nochmal senden.'); return; }
        var data = {
          name: name, telefon: telefon, email: email,
          standort: standort, typ: 'termin', quelle: 'termin-zuerich-bellevue',
          website: (f.querySelector('[name="website"]') || {}).value || '',
          zeit: new Date().toISOString(), turnstileToken: ts.token,
        };
        if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'Wird gesendet…'; }
        fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
          .then(function (r) { if (!r.ok) throw new Error('bad_status'); return r.json().catch(function () { return {}; }); })
          .then(function () {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'formular_senden', form_type: 'terminanfrage', quelle: 'termin-zuerich-bellevue', standort: standort });
            var ok = document.createElement('div');
            ok.style.cssText = 'text-align:center;padding:14px 4px';
            ok.innerHTML = '<div aria-hidden="true" style="width:44px;height:44px;margin:0 auto 12px;border-radius:50%;background:var(--blue-light);color:var(--blue-dark);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800">✓</div>' +
              '<h3 style="font-size:19px;font-weight:800;color:var(--charcoal);margin:0 0 8px;letter-spacing:-.01em">Danke, deine Anfrage ist bei uns.</h3>' +
              '<p style="font-size:14.5px;color:var(--mid);line-height:1.55">Wir melden uns mit passenden Terminvorschlägen - am Bellevue oder an einem unserer weiteren Zürcher Standorte.</p>';
            f.replaceWith(ok);
          })
          .catch(function () {
            if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || 'Termin anfragen'; }
            if (window.turnstile && ts.el) { try { window.turnstile.reset(ts.el); } catch (_) {} }
            showErr('Senden fehlgeschlagen. Bitte später nochmal versuchen oder an termine@tcm.ch schreiben.');
          });
      });
    })();
  </script>
</SpaPage>
