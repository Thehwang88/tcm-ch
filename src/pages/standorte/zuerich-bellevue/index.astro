---
// /standorte/zuerich-bellevue/ — vierter Zürcher Spoke, Pre-Opening-Modus auf dem
// Basel-/Luzern-Template (das seinerseits auf St. Gallen basiert).
//
// Verifizierte Daten für diese Seite: Name (TCM.ch Zürich Bellevue) und Adresse
// (Rössligasse 8, 8001 Zürich). KEIN Eröffnungsdatum, KEINE Öffnungszeiten, KEIN
// Team, KEINE Standort-spezifische Therapieliste — deshalb:
//   • Warteliste-Formular statt Buchungs-CTA (quelle=warteliste-zuerich-bellevue)
//   • MedicalClinic-Schema MIT Adresse (anders als Basel, dort fehlt sie), aber
//     ohne Öffnungszeiten und ohne Geo (nicht verifiziert)
//   • keine Team-Sektion, keine Anfahrts-Details, kein Datum, keine Fake-Urgency
//
// Intent-Ownership: NUR Bellevue/Kreis-1-Intents. Breites "TCM/Akupunktur Zürich"
// bleibt bei /akupunktur-tcm-zuerich/ (Hub), "Zürich City"-Intents bei
// /standorte/zuerich-city/ (siehe seo/master-keyword-url-map.csv).
export const prerender = true;
import SpaPage from '../../../layouts/SpaPage.astro';
import { symptomCards } from '../../../data/symptom-cards';
import { therapyCards } from '../../../data/therapy-cards';

const url = 'https://tcm.ch/standorte/zuerich-bellevue/';
const title = 'TCM & Akupunktur Zürich Bellevue | TCM.ch';
const description =
  'TCM und Akupunktur in Zürich Bellevue: TCM.ch entsteht an der Rössligasse 8, 8001 Zürich, mitten im Kreis 1. Jetzt auf die Warteliste für die ersten Termine.';

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

const beschwerdenHref: Record<string, string> = { heuschnupfen: 'allergien-heuschnupfen', schlafstoerungen: 'schlafprobleme' };
const beschwerden = ['rueckenschmerzen', 'nackenschmerzen', 'migraene', 'schlafstoerungen', 'stress-burnout', 'kinderwunsch', 'ischias', 'heuschnupfen']
  .map((slug) => ({ slug, href: beschwerdenHref[slug] ?? slug, c: symptomCards[slug] }))
  .filter((x) => x.c);
const anchor = (i: number, name: string) => `${i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei ${name}`;

const therapien = ['akupunktur', 'gesichtsakupunktur', 'schroepfen', 'tuina', 'akupressur', 'shiatsu', 'gua-sha', 'physiotherapie']
  .map((slug) => ({ slug, c: therapyCards[slug], tagline: therapyCards[slug]?.tagline }))
  .filter((x) => x.c);

// Bis Bellevue öffnet: die bestehenden Zürcher Standorte.
const nearby = [
  { slug: 'zuerich-oerlikon', city: 'Zürich Oerlikon', meta: '8050', desc: 'Ohmstrasse 14, direkt beim Bahnhof Oerlikon.' },
  { slug: 'zuerich-hoengg', city: 'Zürich Höngg', meta: '8049', desc: 'Limmattalstrasse 340, im Westen der Stadt.' },
  { slug: 'zuerich-city', city: 'Zürich City', meta: '8001', desc: 'An der Bahnhofstrasse, ebenfalls im Aufbau.' },
];

const faqs = [
  {
    q: 'Wo genau seid ihr am Bellevue?',
    a: 'An der Rössligasse 8, 8001 Zürich, mitten im Kreis 1 beim Bellevue. Details zu Zugang und Anfahrt veröffentlichen wir hier, sobald die Praxis eröffnet.',
  },
  {
    q: 'Wann eröffnet die Praxis am Bellevue?',
    a: 'Ein Datum können wir noch nicht nennen. Wer auf der Warteliste steht, erfährt den Eröffnungstermin als Erstes und kann sich vor der offiziellen Freigabe einen Platz sichern.',
  },
  {
    q: 'Kann ich schon einen Termin buchen?',
    a: 'Fix buchen kannst du am Bellevue noch nicht, auf die Warteliste eintragen schon. Wenn du früher etwas brauchst, behandeln wir dich gerne an unseren bestehenden Zürcher Standorten in Oerlikon oder Höngg.',
  },
  {
    q: 'Was kostet Akupunktur bei euch?',
    a: 'Eine Sitzung liegt bei rund 130 bis 160 Franken, abgerechnet nach dem anerkannten Tarif 590 nach Behandlungsdauer. Die Erstkonsultation dauert länger und liegt entsprechend höher. Alle Details stehen auf der Seite Akupunktur-Kosten in Zürich.',
  },
  {
    q: 'Zahlt die Krankenkasse die Behandlung?',
    a: 'Akupunktur läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Weil unsere Therapeut:innen EMR- und ASCA-anerkannt sind, beteiligen sich die meisten Zusatzversicherungen mit 80 bis 100 Prozent. Deine Deckung prüfen wir kostenlos, bevor Kosten entstehen.',
  },
  {
    q: 'Was ist der Unterschied zu eurem Standort Zürich City?',
    a: 'Zürich City entsteht an der Bahnhofstrasse, Bellevue an der Rössligasse beim Bellevueplatz. Beide liegen im Kreis 1, decken aber unterschiedliche Ecken der Innenstadt ab: City die Achse Hauptbahnhof/Paradeplatz, Bellevue die Seite Richtung See, Opernhaus und Altstadt.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: 'TCM.ch Zürich Bellevue',
    url,
    image: 'https://tcm.ch/og-image.jpg',
    medicalSpecialty: ['TraditionalChineseMedicine', 'Acupuncture'],
    telephone: '+41775236122',
    email: 'termine@tcm.ch',
    address: { '@type': 'PostalAddress', streetAddress: 'Rössligasse 8', postalCode: '8001', addressLocality: 'Zürich', addressRegion: 'ZH', addressCountry: 'CH' },
    parentOrganization: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Zürich Bellevue', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<SpaPage title={title} description={description} path="/standorte/zuerich-bellevue" body="" schema={schema}>

  <!-- ── HERO ── -->
  <section class="lu-hero">
    <div class="lu-hero-inner">
      <div class="lu-hero-copy">
        <div class="sg-crumb" style="font-size:12.5px;color:var(--muted);margin-bottom:18px"><a href="/" style="color:inherit">TCM.ch</a> › <a href="/standorte/" style="color:inherit">Standorte</a> › <span>Zürich Bellevue</span></div>
        <span class="lu-badge">Standort Zürich Bellevue · In Vorbereitung</span>
        <h1 class="lu-h1">TCM &amp; Akupunktur in <span class="lu-accent">Zürich Bellevue</span></h1>
        <p class="lu-sub">TCM.ch Zürich Bellevue entsteht an der Rössligasse 8, 8001 Zürich, mitten im Kreis 1 beim Bellevue. Weitere Informationen zur Terminverfügbarkeit folgen. Bis dahin behandeln wir dich gerne an unseren bestehenden Zürcher Standorten.</p>
        <div class="lu-cta-row">
          <a href="#warteliste" class="lu-btn-primary">Auf die Warteliste</a>
          <a href="/akupunktur-tcm-zuerich/" class="lu-btn-ghost">TCM in Zürich</a>
        </div>
        <div class="lu-trust">
          <div><span class="lu-check">✓</span> EMR- und ASCA-anerkannt</div>
          <div><span class="lu-check">✓</span> Krankenkasse 80 bis 100%</div>
          <div><span class="lu-check">✓</span> Keine Überweisung nötig</div>
        </div>
      </div>

      <div class="lu-hero-visual">
        <div class="lu-card" id="warteliste" style="scroll-margin-top:88px">
          <div class="lu-ribbon">NEU</div>
          <div class="lu-card-h">Sichere dir einen der <span class="lu-accent">ersten Termine</span></div>
          <p class="lu-note" style="margin-bottom:14px">Eine E-Mail genügt. Wir melden uns, sobald die Terminvergabe am Bellevue startet.</p>
          <div class="lu-trust" style="flex-direction:column;gap:9px;margin:0 0 16px">
            <div><span class="lu-check">✓</span> Du hörst als Erstes vom Eröffnungstermin</div>
            <div><span class="lu-check">✓</span> Terminwahl vor der offiziellen Freigabe</div>
            <div><span class="lu-check">✓</span> Keine Anzahlung, keine Verpflichtung</div>
          </div>
          <div class="lu-divider"></div>
          <form class="lu-wl-form" data-lu-waitlist novalidate>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
            <input type="hidden" name="quelle" value="warteliste-zuerich-bellevue" />
            <input type="hidden" name="standort" value="Zürich Bellevue" />
            <input name="email" type="email" autocomplete="email" required placeholder="deine@email.ch" aria-label="E-Mail-Adresse" />
            <div class="cf-turnstile lu-ts" data-sitekey={turnstileSitekey} data-appearance="interaction-only"></div>
            <button type="submit">Auf die Warteliste</button>
            <p class="lu-form-rule">Keine Werbung, keine Weitergabe. Nur eine Nachricht, wenn Bellevue startet.</p>
            <p class="lu-form-err" role="alert" hidden></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST-BAND ── -->
  <section class="usp-grid-section" style="background:#fff;padding:48px 0;border-bottom:1px solid var(--border)">
    <div class="wrap"><div class="usp-grid">
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 11 11 13 15 9"></polyline></svg></div>
        <div class="usp-title">Krankenkassen-anerkannt</div>
        <div class="usp-sub">EMR und ASCA, Abrechnung über die Zusatzversicherung.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
        <div class="usp-title">Rössligasse 8, 8001 Zürich</div>
        <div class="usp-sub">Mitten im Kreis 1, beim Bellevue.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
        <div class="usp-title">Warteliste offen</div>
        <div class="usp-sub">Wer eingetragen ist, erfährt den Eröffnungstermin zuerst.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div>
        <div class="usp-title">Keine Überweisung nötig</div>
        <div class="usp-sub">Du meldest dich direkt bei uns.</div>
      </div>
    </div></div>
  </section>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Standort</div>
      <h2 class="section-title">Deine <em>TCM-Praxis</em> am Bellevue.</h2>
      <p class="section-sub">TCM.ch Zürich Bellevue entsteht an der Rössligasse 8 im Kreis 1 und wird genauso aufgebaut wie unsere bestehenden Praxen: kleine Teams, viel Zeit pro Termin, klare Diagnostik.</p>
      <p style="margin-top:20px">Das Bellevue ist einer der zentralsten Punkte Zürichs: der Bellevueplatz als Tram-Knoten, der See und die Altstadt in Gehdistanz. Genau hier eröffnen wir den vierten Zürcher Standort unseres Netzwerks für <a href="/akupunktur-tcm-zuerich/">Akupunktur &amp; TCM in Zürich</a>, neben Oerlikon, Höngg und dem entstehenden Standort City an der Bahnhofstrasse.</p>
      <p style="margin-top:16px">Der Ablauf ist überall gleich. Beim ersten Termin nimmt sich deine Therapeutin oder dein Therapeut eine ganze Stunde Zeit, hört zu, schaut Vorbefunde an und macht eine TCM-Diagnostik. Erst danach steht fest, welche Methoden sinnvoll sind und in welcher Reihenfolge. Wir sagen dir auch, wenn wir dir nicht weiterhelfen können, und verweisen dich dann weiter.</p>
      <p style="margin-top:16px">Unsere Therapeut:innen sind EMR- und ASCA-registriert, damit deine Zusatzversicherung mitzahlt. Was eine Sitzung kostet und was am Ende bei dir bleibt, steht auf der Seite <a href="/standorte/zuerich/kosten/">Akupunktur-Kosten in Zürich</a>.</p>
    </div>
  </section>

  <!-- ── LAGE / EINZUGSGEBIET ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Lage</div>
      <h2 class="section-title">Kreis 1, beim <em>Bellevue.</em></h2>
      <p class="section-sub">Die Rössligasse liegt in der Altstadt auf der Seeseite des Kreis 1, wenige Schritte vom Bellevueplatz. Damit ist die Praxis für alle gut erreichbar, die in der Innenstadt arbeiten oder auf der Seite Richtung See, Opernhaus und Niederdorf unterwegs sind.</p>
      <p style="margin-top:16px">Für die Achse Hauptbahnhof, Bahnhofstrasse und Paradeplatz entsteht parallel unser Standort <a href="/standorte/zuerich-city/">Zürich City</a>. Im Norden der Stadt ist <a href="/standorte/zuerich-oerlikon/">Oerlikon</a> bereits für dich da, im Westen <a href="/standorte/zuerich-hoengg/">Höngg</a>. Welcher Standort für dich passt, zeigt die Übersicht <a href="/akupunktur-tcm-zuerich/">TCM Zürich</a>.</p>
    </div>
  </section>

  <!-- ── BESCHWERDEN ── -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <div class="section-label">Beschwerden</div>
        <h2 class="section-title">Beschwerden, die wir am <em>Bellevue</em> behandeln werden</h2>
        <p class="section-sub">Das sind die Anliegen, mit denen Patient:innen an unseren Standorten am häufigsten kommen. Auf den einzelnen Seiten steht, wie wir vorgehen, wie viele Sitzungen realistisch sind und wo die Grenzen der TCM liegen.</p>
      </div>
      <div class="card-grid reveal">
        {beschwerden.map(({ href, c }, i) => (
          <a href={`/beschwerden/${href}/`} class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src={c.img} alt={`${c.name} mit TCM behandeln in Zürich`} style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">{anchor(i, c.name)}</div><div class="svc-tagline">{c.tagline}</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a>
        ))}
      </div>
      <div style="text-align:center;margin-top:24px"><a href="/beschwerden/" class="btn-secondary" style="display:inline-flex">Alle Beschwerden ansehen →</a></div>
    </div>
  </section>

  <!-- ── THERAPIEN ── -->
  <section class="section svc-section" style="background:var(--surface)">
    <div class="wrap">
      <div class="svc-header reveal">
        <div>
          <div class="section-label">Therapien</div>
          <h2 class="section-title">Unsere <em>Methoden</em> im Netzwerk</h2>
        </div>
        <p class="svc-sub">Diese Methoden bietet TCM.ch an seinen Standorten an. Welche davon am Bellevue ab Eröffnung verfügbar sind, kommunizieren wir hier, sobald es fix ist.</p>
      </div>
      <div class="svc-grid">
        {therapien.map(({ slug, c, tagline }) => (
          <a href={`/therapien/${slug}/`} class="svc-card reveal"> <div class="svc-photo-wrap"> <img width={c.w} height={c.h} src={c.img} alt={`${c.name} bei TCM.ch`} class="svc-photo" loading="lazy" style={`object-position:${c.objectPos}`}> <div class="svc-photo-top-bar"></div> </div> <div class="svc-body"> <div class="svc-name">{c.name}</div> <div class="svc-tagline">{tagline}</div> <div class="svc-meta"> <span class="svc-badge svc-badge--time"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15.5 14"></polyline></svg>{c.time}</span> <span class="svc-badge svc-badge--ins">{c.ins}</span> </div> <div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </div> </a>
        ))}
      </div>
      <p style="margin:22px 0 0;font-size:15px;line-height:1.6;color:var(--mid);max-width:72ch">Geht es dir vor allem um Verspannungen und nicht um eine ganze Behandlungsserie? Angebot und Preise stehen auf der Seite <a href="/massage-zuerich/" style="color:var(--blue);font-weight:700">Massage in Zürich</a>.</p>
    </div>
  </section>

  <!-- ── ABLAUF ── -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Ablauf</div>
      <h2 class="section-title">Erstgespräch → Behandlungsplan → Folgetermine</h2>
      <p class="section-sub">So läuft es an allen unseren Standorten ab, und so wird es auch am Bellevue laufen.</p>
      <div class="usp-grid" style="margin-top:28px">
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(45,155,111,.1);color:#2D9B6F;font-family:var(--font-sans);font-weight:800;font-size:18px">1</div>
          <div class="usp-title">Erstgespräch &amp; Anamnese, 60 Minuten</div>
          <div class="usp-sub">Wir hören zu, schauen Vorbefunde an und machen die TCM-Diagnostik. Eine erste Behandlung ist meist schon dabei.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(45,155,111,.1);color:#2D9B6F;font-family:var(--font-sans);font-weight:800;font-size:18px">2</div>
          <div class="usp-title">Behandlungsplan</div>
          <div class="usp-sub">Du bekommst eine konkrete Einschätzung: welche Methoden, wie viele Sitzungen, in welchem Abstand und was das kostet.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(45,155,111,.1);color:#2D9B6F;font-family:var(--font-sans);font-weight:800;font-size:18px">3</div>
          <div class="usp-title">Folgetermine</div>
          <div class="usp-sub">Meist 45 bis 60 Minuten, anfangs wöchentlich. Nach vier bis sechs Sitzungen schauen wir gemeinsam, ob es wirkt.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── KRANKENKASSE ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Krankenkasse</div>
      <h2 class="section-title">Was die <em>Zusatzversicherung</em> übernimmt.</h2>
      <p>Akupunktur bei Therapeut:innen läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Damit deine Kasse mitzahlt, muss die behandelnde Person in den Registern <strong>EMR</strong> und <strong>ASCA</strong> anerkannt sein. Das trifft auf unser gesamtes Team zu, und daran ändert sich am Bellevue nichts.</p>
      <p style="margin-top:16px">Bei den meisten Kassen sind damit <strong>80 bis 100 Prozent</strong> gedeckt, abhängig von Modell und Jahreslimite. Verbindlich ist immer deine Police. Was eine Sitzung in Zürich kostet, steht im Detail auf der Seite <a href="/standorte/zuerich/kosten/">Akupunktur-Kosten in Zürich</a>, mehr zur Abrechnung unter <a href="/krankenkassen/">Krankenkasse</a>.</p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section">
    <div class="wrap reveal" style="max-width:820px">
      <div class="section-label">Häufige Fragen</div>
      <h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>TCM &amp; Akupunktur am Bellevue</em></h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0">
            <summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">{f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary>
            <div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">{f.a}</div>
          </details>
        ))}
      </div>
      <div class="cl-links" style="margin-top:26px">
        <a href="/akupunktur-tcm-zuerich/" class="cl-chip">TCM Zürich</a>
        <a href="/standorte/zuerich/kosten/" class="cl-chip">Kosten &amp; Krankenkasse Zürich</a>
        <a href="/therapien/akupunktur/" class="cl-chip">Akupunktur</a>
        <a href="/massage-zuerich/" class="cl-chip">Massage Zürich</a>
      </div>
    </div>
  </section>

  <!-- ── PRAXEN IN DER NÄHE ── -->
  <section class="related-section" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-label">Weitere Standorte</div>
      <h2 class="section-title">TCM.ch in <em>Zürich</em></h2>
      <p class="section-sub">Bis Bellevue öffnet, sind das unsere Zürcher Standorte. Den Überblick über alle gibt die Seite <a href="/akupunktur-tcm-zuerich/">Akupunktur &amp; TCM in Zürich</a>.</p>
      <div class="city-grid reveal">
        {nearby.map((n) => (
          <a href={`/standorte/${n.slug}/`} class="city-card location-card"><span class="location-plz">{n.meta}</span><div class="location-city">{n.city}</div><div class="location-desc">{n.desc}</div><span class="location-link">Standort ansehen →</span></a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── END-CTA ── -->
  <section class="cta-band" style="background:var(--blue);padding:48px 0">
    <div class="wrap" style="text-align:center">
      <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Einer der ersten Termine am Bellevue?</h2>
      <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Trag dich mit deiner E-Mail ein. Wir melden uns, sobald die Terminvergabe startet, und du kommst vor allen anderen dran.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn-white" href="#warteliste" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Auf die Warteliste</a>
        <a href="/akupunktur-tcm-zuerich/" style="display:inline-flex;align-items:center;font-family:var(--font-sans);font-weight:700;font-size:15px;color:#fff;text-decoration:none;padding:14px 24px;border:1.5px solid rgba(255,255,255,.4);border-radius:var(--r-btn)">TCM in Zürich</a>
      </div>
    </div>
  </section>

<style>
  .svc-card, .kt-feature, .city-card { text-decoration: none; color: inherit; }

  /* Hero-Styles wie /standorte/basel/ bzw. /standorte/luzern/ (1:1 nach
     HeroLaunchSG.astro), Astro scoped die Regeln auf diese Seite. */
  .lu-hero { padding-top: 68px; background: var(--surface); font-family: var(--font-sans); color: var(--charcoal); }
  .lu-hero-inner {
    max-width: var(--max); margin: 0 auto;
    padding: clamp(32px, 6vw, 64px) var(--pad-x) clamp(40px, 7vw, 72px);
    display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(28px, 5vw, 56px); align-items: center;
  }
  @media (max-width: 900px) { .lu-hero-inner { grid-template-columns: 1fr; gap: 32px; } }

  .lu-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue-light); color: var(--blue-dark); border: 1px solid rgba(45, 155, 111, .18);
    padding: 6px 13px; border-radius: var(--r-pill);
    font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  }
  .lu-h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.4rem); line-height: 1.06; letter-spacing: -.03em; font-weight: 800;
    margin: 18px 0 14px; color: var(--charcoal);
  }
  .lu-accent { color: var(--blue); }
  .lu-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--mid); max-width: 44ch; line-height: 1.55; }

  .lu-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .lu-btn-primary {
    background: var(--blue); color: #fff; border: none; text-decoration: none;
    padding: 15px 24px; border-radius: var(--r-btn); font-size: 16px; font-weight: 700;
    box-shadow: var(--sh-btn); transition: background var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .lu-btn-primary:hover { background: var(--blue-dark); transform: translateY(-2px); }
  .lu-btn-ghost {
    background: transparent; color: var(--charcoal); border: 1px solid var(--border); text-decoration: none;
    padding: 15px 22px; border-radius: var(--r-btn); font-size: 16px; font-weight: 600;
  }
  .lu-btn-ghost:hover { border-color: var(--blue); color: var(--blue-dark); }

  .lu-trust { display: flex; gap: 22px; margin-top: 28px; flex-wrap: wrap; font-size: 14px; color: var(--mid); }
  .lu-trust div { display: flex; align-items: center; gap: 7px; }
  .lu-check { color: var(--blue); font-weight: 800; }

  .lu-card {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, #ffffff, #f2f5f0);
    border: 1px solid rgba(18, 33, 28, .08); border-radius: var(--r-hero);
    padding: 32px; box-shadow: 0 24px 60px -20px rgba(0, 0, 0, .18);
  }
  .lu-ribbon {
    position: absolute; top: 16px; right: -42px;
    background: #FFC107; color: #2a2109; font-weight: 800; font-size: 11.5px; letter-spacing: .08em;
    padding: 6px 48px; transform: rotate(45deg); box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .3);
  }
  .lu-card-h { font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 800; letter-spacing: -.02em; margin: 6px 0 5px; line-height: 1.15; }
  .lu-note { color: var(--mid); font-size: 14.5px; }
  .lu-divider { height: 1px; background: var(--border); margin: 22px 0; }

  .lu-wl-form { display: flex; flex-direction: column; gap: 10px; }
  .lu-wl-form input[type="email"] {
    border: 1px solid var(--border); border-radius: 10px; padding: 13px 14px; font-size: 15px;
    background: #fff; font-family: inherit; color: var(--charcoal);
  }
  .lu-wl-form input[type="email"]:focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: transparent; }
  .lu-wl-form button {
    background: var(--blue); color: #fff; border: none; border-radius: 10px;
    padding: 14px; font-size: 15.5px; font-weight: 700; cursor: pointer;
    transition: background var(--t-fast) var(--ease-out);
  }
  .lu-wl-form button:hover { background: var(--blue-dark); }
  .lu-wl-form button:disabled { opacity: .65; cursor: default; }
  .lu-form-rule { font-size: 12px; color: var(--mid); text-align: center; }
  .lu-ts { min-height: 0; }
  .lu-form-err { font-size: 13px; color: #c0392b; line-height: 1.5; margin-top: 2px; }

  @media (max-width: 767px) {
    .lu-hero { padding-top: 60px; }
