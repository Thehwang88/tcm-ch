---
// /standorte/zuerich-bellevue/ - neutrale "Neuer Standort in Vorbereitung"-Seite.
//
// Der frühere Standort-Setup (Raumpartner, Adresse, Eröffnungsdatum, Visuals,
// Team-Zuordnung, Bellevue-Buchung) wurde vollständig entfernt: Es gibt aktuell
// KEINE bestätigte Adresse im Zürcher Zentrum. Die URL bleibt bestehen (SEO),
// die Seite kommuniziert nur: neuer Standort im Zürcher Zentrum in Vorbereitung,
// Termine ab sofort an den bestehenden Zürcher Standorten (Oerlikon, Höngg).
//
// Kein MedicalClinic-/LocalBusiness-Schema (keine physische Adresse publizieren),
// nur WebPage + Breadcrumb. Kein Bellevue-Standort mehr in Formularen/Datenquellen
// (locations.ts, zuerich-termin.ts, KontaktForm, TerminForm).
export const prerender = true;
import SpaPage from '../../../layouts/SpaPage.astro';
import KontaktForm from '../../../components/standort/KontaktForm.astro';
import type { Standort } from '../../../data/standorte';

// KontaktForm ohne Standort-Vorauswahl: stadt 'Zürich' matcht keine Option,
// Leads wählen einen bestehenden Standort oder "Andere / in meiner Nähe".
const kontaktData = { stadt: 'Zürich', nap: { telefon: '+41 77 523 61 22', email: 'termine@tcm.ch' } } as unknown as Standort;

const url = 'https://tcm.ch/standorte/zuerich-bellevue/';
const title = 'TCM Zürich City - Neuer Standort in Vorbereitung | TCM.ch';
const description =
  'TCM.ch bereitet einen neuen Standort im Zürcher Zentrum vor. Bereits jetzt Termine an unseren bestehenden Zürcher Standorten anfragen.';

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

const standorte = [
  { slug: 'zuerich-oerlikon', city: 'Zürich Oerlikon', meta: '8050', desc: 'Ohmstrasse 14, direkt beim Bahnhof Oerlikon.' },
  { slug: 'zuerich-hoengg', city: 'Zürich Höngg', meta: '8049', desc: 'Limmattalstrasse 340, im Westen der Stadt.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url,
    inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Zürich City', item: url },
    ],
  },
];
---
<SpaPage title={title} description={description} path="/standorte/zuerich-bellevue" body="" schema={schema}>

  <!-- ── HERO ── -->
  <section class="zc-hero">
    <div class="zc-hero-inner">
      <div class="sg-crumb" style="font-size:12.5px;color:var(--muted);margin-bottom:18px"><a href="/" style="color:inherit">TCM.ch</a> › <a href="/standorte/" style="color:inherit">Standorte</a> › <span>Zürich City</span></div>
      <span class="zc-badge">Neuer Standort in Vorbereitung</span>
      <h1 class="zc-h1">TCM.ch <span class="zc-accent">Zürich City</span></h1>
      <p class="zc-sub">Wir bereiten aktuell einen neuen TCM.ch Standort im Zürcher Zentrum vor. Weitere Informationen zur Adresse und Eröffnung folgen in Kürze. Bereits jetzt kannst du einen Termin an einem unserer bestehenden Zürcher Standorte anfragen.</p>
      <div class="zc-cta-row">
        <a href="#kontakt" class="zc-btn-primary">Termin in Zürich finden</a>
        <a href="/akupunktur-tcm-zuerich/" class="zc-btn-ghost">Unsere Zürcher Standorte</a>
      </div>
      <div class="zc-trust">
        <div><span class="zc-check">✓</span> EMR- und ASCA-anerkannt</div>
        <div><span class="zc-check">✓</span> Krankenkasse 80 bis 100%</div>
        <div><span class="zc-check">✓</span> Keine Überweisung nötig</div>
      </div>
      <img src="/images/ZHCity.png" alt="TCM.ch Zürich City Klinik" width="1672" height="941" style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--r-card);margin-top:32px" />

    </div>
  </section>

  <!-- ── BESTEHENDE ZÜRCHER STANDORTE ── -->
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Schon heute für dich da</div>
      <h2 class="section-title">Unsere <em>Zürcher Standorte.</em></h2>
      <p class="section-sub">Bis der neue Standort im Zentrum eröffnet, behandeln wir dich an unseren bestehenden Zürcher Praxen - oder wir finden den nächsten freien Termin für dich. Den Überblick gibt die Seite <a href="/akupunktur-tcm-zuerich/">Akupunktur &amp; TCM in Zürich</a>, Preise stehen unter <a href="/standorte/zuerich/kosten/">Akupunktur-Kosten in Zürich</a>.</p>
      <div class="city-grid reveal" style="margin-top:28px;grid-template-columns:repeat(2,1fr)">
        {standorte.map((n) => (
          <a href={`/standorte/${n.slug}/`} class="city-card location-card"><span class="location-plz">{n.meta}</span><div class="location-city">{n.city}</div><div class="location-desc">{n.desc}</div><span class="location-link">Termin prüfen →</span></a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── KONTAKT / TERMINANFRAGE (zentrale Komponente, ohne Standort-Vorauswahl) ── -->
  <KontaktForm data={kontaktData} sitekey={turnstileSitekey} />

<style>
  .city-card { text-decoration: none; color: inherit; }
  .zc-hero { padding-top: 68px; background: var(--surface); font-family: var(--font-sans); color: var(--charcoal); }
  .zc-hero-inner { max-width: 860px; margin: 0 auto; padding: clamp(32px, 6vw, 64px) var(--pad-x) clamp(40px, 7vw, 72px); }
  .zc-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue-light); color: var(--blue-dark); border: 1px solid rgba(45, 155, 111, .18);
    padding: 6px 13px; border-radius: var(--r-pill);
    font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  }
  .zc-h1 { font-size: clamp(2.1rem, 5.2vw, 3.2rem); line-height: 1.06; letter-spacing: -.03em; font-weight: 800; margin: 18px 0 14px; }
  .zc-accent { color: var(--blue); }
  .zc-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--mid); max-width: 62ch; line-height: 1.6; }
  .zc-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .zc-btn-primary {
    background: var(--blue); color: #fff; text-decoration: none;
    padding: 15px 24px; border-radius: var(--r-btn); font-size: 16px; font-weight: 700; box-shadow: var(--sh-btn);
  }
  .zc-btn-primary:hover { background: var(--blue-dark); }
  .zc-btn-ghost {
    background: transparent; color: var(--charcoal); border: 1px solid var(--border); text-decoration: none;
    padding: 15px 22px; border-radius: var(--r-btn); font-size: 16px; font-weight: 600;
  }
  .zc-btn-ghost:hover { border-color: var(--blue); color: var(--blue-dark); }
  .zc-trust { display: flex; gap: 22px; margin-top: 28px; flex-wrap: wrap; font-size: 14px; color: var(--mid); }
  .zc-trust div { display: flex; align-items: center; gap: 7px; }
  .zc-check { color: var(--blue); font-weight: 800; }
  @media (max-width: 767px) {
    .zc-hero { padding-top: 60px; }
    .zc-hero-inner { padding-left: 16px; padding-right: 16px; }
    .section { padding: 52px 0; }
  }
  @media (max-width: 600px) { .city-grid { grid-template-columns: 1fr !important; } }
</style>
</SpaPage>
