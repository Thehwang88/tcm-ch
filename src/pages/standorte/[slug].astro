---
// /standorte/[slug] — hybrid during the leaf → data-driven migration.
//
//   • Slugs present in src/data/standorte.ts render from the canonical component flow
//     (src/components/standort/*). One template, one section order, per-slug data.
//   • All other slugs still render from their captured leaf (src/data/standort-leaves/*.html)
//     via the legacy path below — unchanged — so no standort is dropped mid-migration.
//
// getStaticPaths still globs the leaves so every existing page keeps building. As each
// slug gains a standorte.ts entry it flips to the data-driven branch; when all are migrated
// the leaves + legacy branch can be deleted.
import SpaPage from '../../layouts/SpaPage.astro';
import HeroLaunchSG from '../../components/HeroLaunchSG.astro';
import { clinics } from '../../data/locations';
import { prefillStandort } from '../../data/form-prefill';
import ueberUns from '../../data/ueber-uns-body.html?raw';
import homeBody from '../../data/home-body.html?raw';
import { getStandort, waHref, telHref } from '../../data/standorte';
import { symptomCards } from '../../data/symptom-cards';
import { hautLinksFor, hautLinksHtml } from '../../data/haut-links';
import type { Standort } from '../../data/standorte';
import Hero from '../../components/standort/Hero.astro';
import IntroNap from '../../components/standort/IntroNap.astro';
import Therapien from '../../components/standort/Therapien.astro';
import Kraeuter from '../../components/standort/Kraeuter.astro';
import Beschwerden from '../../components/standort/Beschwerden.astro';
import Ablauf from '../../components/standort/Ablauf.astro';
import KrankenkassenTeam from '../../components/standort/KrankenkassenTeam.astro';
import Reviews from '../../components/standort/Reviews.astro';
import UeberPraxis from '../../components/standort/UeberPraxis.astro';
import WarumTcm from '../../components/standort/WarumTcm.astro';
import WeitereStandorte from '../../components/standort/WeitereStandorte.astro';
import KontaktForm from '../../components/standort/KontaktForm.astro';
import FinalCta from '../../components/standort/FinalCta.astro';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/standort-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.keys(leaves).map((p) => {
    const slug = p.split('/').pop()!.replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] as string } };
  });
}

const { slug } = Astro.params;
const migrated = getStandort(slug!);
const url = `https://tcm.ch/standorte/${slug}/`;

// Interne Links in den /haut/-Cluster. Die Standort-Seiten werden täglich gecrawlt,
// die /haut/-Leaves standen dagegen in GSC auf "Gefunden – zurzeit nicht indexiert".
// Rotation über den Slug, damit nicht alle 14 Standorte dieselben sechs Leaves verlinken.
const hautBlock = hautLinksHtml(
  hautLinksFor(slug!, 6),
  'Haut & Gesicht',
  'Haut, Gesicht und was wirklich hilft',
  'Ehrlich erklärt: Wirkstoffe, Behandlungen und was davon realistisch etwas bringt.',
);

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

let title: string;
let description: string;
let schema: object;
let spaBody = '';

if (migrated) {
  // ── Data-driven branch ──────────────────────────────────────────────
  const data = migrated;
  const stadt = data.stadt;
  const clinic = clinics.find((c) => c.id === slug);
  title = data.seo?.title ?? `TCM & Akupunktur ${data.titelZusatz ?? stadt} | TCM.ch`;
  description = data.seo?.description ?? `TCM & Akupunktur in ${stadt}: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin oft in 24 Stunden.`;
  // MedicalClinic fed from nap/geo; opening hours + areaServed from the clinic NAP record.
  const medClinic: Record<string, unknown> = {
    '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': url,
    name: data.seo?.schemaName ?? `TCM.ch ${stadt}`, url, inLanguage: 'de-CH', medicalSpecialty: 'TraditionalChineseMedicine',
    telephone: data.nap.telefon,
    memberOf: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
  };
  if (data.nap.strasse) medClinic.address = { '@type': 'PostalAddress', streetAddress: data.nap.strasse, postalCode: data.nap.plz, addressLocality: data.nap.ort, addressCountry: 'CH' };
  if (data.nap.geo) medClinic.geo = { '@type': 'GeoCoordinates', latitude: data.nap.geo.lat, longitude: data.nap.geo.lng };
  if (clinic?.openingHours?.length) medClinic.openingHours = clinic.openingHours;
  if (clinic?.areaServed?.length) medClinic.areaServed = clinic.areaServed.map((a) => ({ '@type': 'City', name: a }));
  const breadcrumb = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: stadt, item: url },
    ],
  };
  schema = [medClinic, breadcrumb];
  if (data.faqs?.length) {
    (schema as object[]).push({ '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
  }
} else {
  // ── Legacy leaf branch (verbatim from the pre-refactor template) ─────
  const body = Astro.props.body;
  const clinic = clinics.find((c) => c.id === slug);
  const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
  const hName = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/TCM\.ch CARE.*?Akupunktur\s*/i, '').replace(/\s+/g, ' ').trim().slice(0, 40) : slug!;
  const name = clinic ? clinic.name : hName;
  const isPartner = slug === 'bottighofen';
  title = isPartner
    ? 'TCM Pelican Bottighofen: Akupunktur & TCM am Bodensee | TCM.ch'
    : slug === 'st-gallen'
      ? 'Akupunktur & TCM St. Gallen | TCM.ch'
      : `TCM & Akupunktur ${name} | TCM.ch`;
  description = isPartner
    ? 'TCM Pelican in Bottighofen: Akupunktur, Tuina und TCM, EMR-anerkannt, gut erreichbar bei Kreuzlingen am Bodensee. Geprüfte Partnerklinik im TCM.ch Netzwerk.'
    : slug === 'st-gallen'
      ? 'Akupunktur & TCM in St. Gallen beim Bahnhof: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin oft in 24 Stunden.'
      : `TCM & Akupunktur in ${name}: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin oft in 24 Stunden.`;

  const medClinic: Record<string, unknown> = {
    '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': url,
    name: isPartner ? 'TCM Pelican' : slug === 'st-gallen' ? 'TCM St. Gallen' : `TCM.ch ${name}`, url, inLanguage: 'de-CH', medicalSpecialty: 'TraditionalChineseMedicine',
  };
  if (clinic) {
    medClinic.telephone = clinic.phone;
    if (clinic.street) medClinic.address = { '@type': 'PostalAddress', streetAddress: clinic.street, postalCode: clinic.postalCode, addressLocality: clinic.city, addressCountry: 'CH' };
    if (clinic.geo) medClinic.geo = { '@type': 'GeoCoordinates', latitude: clinic.geo.lat, longitude: clinic.geo.lng };
    if (clinic.openingHours?.length) medClinic.openingHours = clinic.openingHours;
    if (clinic.areaServed?.length) medClinic.areaServed = clinic.areaServed.map((a) => ({ '@type': 'City', name: a }));
  }
  const breadcrumb = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name, item: url },
    ],
  };
  schema = [medClinic, breadcrumb];

  function endOfDiv(html: string, i: number) { const rx = /<div\b|<\/div>/g; rx.lastIndex = i; let d = 0; let m: RegExpExecArray | null; while ((m = rx.exec(html))) { if (m[0] === '</div>') { d--; if (d === 0) return m.index + 6; } else d++; } return html.length; }
  let outBody = body;
  if (slug === 'st-gallen' || slug === 'winterthur-marktgasse') {
    const tg0 = ueberUns.indexOf('<div class="team-grid">');
    const teamGrid = tg0 >= 0 ? ueberUns.slice(tg0, endOfDiv(ueberUns, tg0)) : '';
    const cor0 = outBody.indexOf('<div style="display:grid;grid-template-columns:1fr;gap:16px;margin:20px 0;max-width:300px">');
    if (teamGrid && cor0 >= 0) outBody = outBody.slice(0, cor0) + teamGrid + outBody.slice(endOfDiv(outBody, cor0));
  }
  if (slug === 'bottighofen') {
    const ei = ueberUns.indexOf('Emanuela Pelican');
    const cs = ei >= 0 ? ueberUns.lastIndexOf('<div class="team-card', ei) : -1;
    const card = cs >= 0 ? ueberUns.slice(cs, endOfDiv(ueberUns, cs)) : '';
    const ph = outBody.indexOf('<div style="display:grid;grid-template-columns:1fr;gap:16px;margin:20px 0;max-width:300px">');
    if (card && ph >= 0) outBody = outBody.slice(0, ph) + '<div class="team-grid bf-therapist" style="max-width:360px;margin:20px 0">' + card + '</div>' + outBody.slice(endOfDiv(outBody, ph));
    const hg0 = homeBody.indexOf('<div class="svc-grid">');
    const homeGrid = hg0 >= 0 ? homeBody.slice(hg0, endOfDiv(homeBody, hg0)) : '';
    const lg0 = outBody.indexOf('<div class="svc-grid">');
    if (homeGrid && lg0 >= 0) outBody = outBody.slice(0, lg0) + homeGrid + outBody.slice(endOfDiv(outBody, lg0));
  }

  // "Häufige Beschwerden" für die Legacy-Leaves — gleiches Schema wie Beschwerden.astro
  // (Basis-Set + Rotation, unique Listen, Anker-Mix), bis diese Slugs migriert sind.
  const LEGACY_BESCHWERDEN: Record<string, { stadt: string; intro: string; slugs: string[] }> = {
    'st-gallen': { stadt: 'St. Gallen', intro: 'Von Rücken bis Schlaf: Das sind die häufigsten Anliegen, mit denen Patient:innen in St. Gallen zu uns kommen.', slugs: ['rueckenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'kinderwunsch', 'ischias', 'reizdarm', 'schulterschmerzen'] },
    'zuerich-city': { stadt: 'Zürich', intro: 'Ein Überblick über die Beschwerden, die wir in Zürich am häufigsten behandeln. Details zu Ablauf und Kosten stehen auf den einzelnen Seiten.', slugs: ['rueckenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'kinderwunsch', 'wechseljahre', 'endometriose', 'knieschmerzen'] },
    bottighofen: { stadt: 'Bottighofen', intro: 'Womit kommen die Leute in Bottighofen zu uns? Meistens mit einem dieser Themen. Jede Seite erklärt, was die TCM realistisch leisten kann.', slugs: ['rueckenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'kinderwunsch', 'tinnitus', 'wechseljahre'] },
  };
  const lb = LEGACY_BESCHWERDEN[slug!];
  const beschwerdenLinks = lb
    ? `<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal"><div class="section-label">Beschwerden</div><h2 class="section-title">Häufige Beschwerden in ${lb.stadt}</h2><p class="section-sub">${lb.intro}</p><div class="cl-links">${lb.slugs.map((s, i) => `<a href="/beschwerden/${s}/" class="cl-chip">${i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei ${symptomCards[s]?.name ?? s}</a>`).join('')}</div></div></section>`
    : '';
  const filledBody = prefillStandort(outBody, name)
    .replace(
      /<button type="button" class="btn-primary" onclick="openTerminForm\(\)" style="width:100%;justify-content:center;margin-bottom:10px;display:flex">([\s\S]*?)<\/button>/,
      `<a href="?standort=${encodeURIComponent(name)}" class="btn-primary" style="width:100%;justify-content:center;margin-bottom:10px;display:flex">$1</a>`,
    )
    .replace(
      '<button type="button" class="btn-white" onclick="openTerminForm()" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</button>',
      '<a href="#kontakt" class="btn-white" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</a>',
    )
    .replace(
      '<section class="section contact-section-inline" style="background:var(--surface)">',
      '<section id="kontakt" class="section contact-section-inline" style="scroll-margin-top:68px;background:var(--surface)">',
    );

  const sgOfferBand = `<section class="section" style="scroll-margin-top:68px;background:var(--blue);text-align:center"><div class="wrap"><div style="font-family:var(--font-sans);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#FFC107;margin-bottom:12px">Launch St. Gallen</div><h2 style="font-family:var(--font-sans);font-size:clamp(22px,3vw,34px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 20px">Erstbehandlung gratis, nur zum Launch.</h2><a href="#kontakt" style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--blue-dark);font-family:var(--font-sans);font-size:15px;font-weight:700;padding:14px 30px;border-radius:12px;text-decoration:none">Noch unsicher? Gratis Erstgespräch anfragen</a></div></section>`;
  // OneDoc-Buchungswidget (nur St. Gallen): offizielles JS-Embed (Höhe steuert das Widget
  // per postMessage selbst), GA4 direkt via measurementIds — kein eigenes Blur-Tracking mehr.
  const onedocSection = `<section class="section" id="online-buchen" style="scroll-margin-top:68px;background:var(--surface)"><div class="wrap reveal" style="max-width:820px"><div class="section-label">Online-Buchung</div><h2 class="section-title">Termin online buchen</h2><p class="section-sub">Wähle direkt einen freien Termin bei Corinna Reinhart – Bestätigung sofort per E-Mail.</p><script>var widgetConfigs=widgetConfigs||{};widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"]={},widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"].measurementIds=["G-NHZ8Y6V840"],widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"].hasGoogleTagTracking=!0,widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"].hasFusedeck=!1,window.addEventListener("message",(function(e){var t=e.data["od-widget-id"],i=e.data["od-widget-height"],d=e.data["od-widget-ios"];if(t&&t in widgetConfigs&&"7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"===t){var a=document.getElementById("od-widget-"+t);i&&(a.style.height=i+"px"),!0===d&&(a.style.width="100px",a.style["min-width"]="100%",a.scrolling="no");var g=e.data["od-tracking-configs"];void 0!==g&&(widgetConfigs[t].measurementIds=g);var o=e.data["od-has-google-tag-manager"];void 0!==o&&(widgetConfigs[t].hasGoogleTagTracking=o);var f=e.data["od-has-fusedeck"];void 0!==f&&(widgetConfigs[t].hasFusedeck=f);var n=e.data.GA4;if(widgetConfigs[t].hasGoogleTagTracking&&window.dataLayer&&n){var s=Object.keys(n.properties),r={event:n.name};s.forEach((function(e){r[e]=n.properties[e]})),dataLayer.push(r)}if(widgetConfigs[t].hasFusedeck&&window.fdData&&n){var s=Object.keys(n.properties),r={event:n.name};s.forEach((function(e){r[e]=n.properties[e]})),fdData.push(r)}if(n&&void 0!==window.gtag)for(var w=0;w<widgetConfigs[t].measurementIds.length;w++){var f=widgetConfigs[t].measurementIds[w],c=(s=Object.keys(n.properties),{send_to:f});s.forEach((function(e){c[e]=n.properties[e]})),gtag("event",n.name,c)}}})),window.addEventListener("load",(function(e){for(var t=document.querySelectorAll("iframe.od-widget"),i=0;i<t.length;i++){var d=t[i];d.dataset&&d.dataset.src&&(d.src=d.dataset.src)}}));</script><iframe class="od-widget" id="od-widget-7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794" src="about:blank" data-src="https://www.onedoc.ch/de/widget/7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794" frameborder="0" style="width:100%;max-width:1024px;height:400px"></iframe></div></section>`;
  let sgBody = filledBody;
  if (slug === 'st-gallen') {
    const h0 = sgBody.indexOf('<div id="standort-flagship-hero"');
    const c0 = sgBody.indexOf('<div id="standort-content">');
    if (h0 >= 0 && c0 > h0) sgBody = sgBody.slice(0, h0) + sgBody.slice(c0);
    sgBody = sgBody.replace('<div id="standort-content">', '<div id="standort-content">' + onedocSection);
    // End-CTA vor dem Footer: Online-Buchung als primäre Conversion, Anchor auf die Widget-Sektion (nie extern zu onedoc.ch)
    const sgEndCta = `<section class="section" style="background:var(--surface);text-align:center"><div class="wrap reveal" style="max-width:820px"><h2 class="section-title">Bereit für deinen Ersttermin?</h2><p class="section-sub" style="margin-left:auto;margin-right:auto">Wähle direkt einen freien Termin, Bestätigung sofort per E-Mail.</p><a href="#online-buchen" class="btn-primary" style="display:inline-flex;align-items:center;gap:8px">Termin online buchen <span aria-hidden="true">→</span></a></div></section>`;
    sgBody = sgBody + beschwerdenLinks + sgOfferBand + sgEndCta;
  }
  spaBody = (slug === 'st-gallen') ? sgBody + hautBlock : filledBody + beschwerdenLinks + hautBlock;
}

const data = migrated as Standort;
const waTermin = migrated ? waHref(data.nap.telefon, `Hallo, ich möchte einen Termin in ${data.stadt} anfragen.`) : '';
---
{migrated ? (
  <SpaPage title={title} description={description} path={`/standorte/${slug}`} body="" schema={schema}>
    <div class="page active" id="page-standort" style="display:block">
      <Hero data={data} />
      <section class="section" style="padding:0;background:var(--bg)">
        <div class="wrap" style="padding-top:12px;padding-bottom:4px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;background:var(--green-mint);border:1px solid var(--green-mid);border-radius:16px;padding:20px 22px">
            <div>
              <div style="font-family:var(--font-sans);font-weight:800;font-size:clamp(17px,3.4vw,21px);color:var(--black);line-height:1.25;margin-bottom:4px">Keine Ahnung, wo du anfangen sollst? Dafür sind wir da.</div>
              <div style="font-size:14.5px;color:var(--mid);line-height:1.5;max-width:64ch">Du musst nicht wissen, welche Therapie du brauchst. Komm vorbei, wir finden es gemeinsam heraus und nehmen dir den Rest ab.</div>
            </div>
            <button type="button" onclick="openContactForm()" class="btn-primary" style="flex-shrink:0">Termin anfragen <span aria-hidden="true">→</span></button>
          </div>
        </div>
      </section>
      <div id="standort-content">
        <IntroNap data={data} />
        {data.extraBlock && <Fragment set:html={data.extraBlock} />}
        <Therapien data={data} />
        <Kraeuter />
        <Beschwerden data={data} />
        {data.ablaufBlock && <Ablauf />}
        <WarumTcm data={data} />
        <KrankenkassenTeam data={data} />
        {data.reviews && <Reviews data={data} />}
        {data.faqs?.length && (
          <section class="section" style="background:var(--surface)">
            <div class="wrap reveal" style="max-width:820px">
              <div class="section-label">Häufige Fragen</div>
              <h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>TCM {data.stadt}</em></h2>
              <div class="faq-list">
                {data.faqs.map((f) => (
                  <details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0">
                    <summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">{f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary>
                    <div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">{f.a}</div>
                  </details>
                ))}
              </div>
            </div>
          </section>
        )}
        <UeberPraxis data={data} />
        <WeitereStandorte data={data} />
        <Fragment set:html={hautBlock} />
        <KontaktForm data={data} sitekey={turnstileSitekey} />
        <FinalCta data={data} />
      </div>
      <div class="mobile-cta-bar" id="standort-mobile-cta">
        <a href={waTermin} class="btn-primary" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;flex-shrink:0"><path d="M13 2L4.5 13H11.5L11 22L19.5 11H12.5L13 2z"></path></svg> Per WhatsApp</a> <button class="btn-secondary" onclick="openTerminForm()">Termin anfragen</button> <a href={telHref(data.nap.telefon)} class="btn-call" title="Anrufen"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.97-.97a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17z"></path></svg></a>
      </div>
    </div>
  </SpaPage>
) : (
  <SpaPage title={title} description={description} path={`/standorte/${slug}`} body={spaBody} schema={schema}>
    {slug === 'st-gallen' && <HeroLaunchSG sitekey={turnstileSitekey} />}
  </SpaPage>
)}
