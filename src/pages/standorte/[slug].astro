---
// /standorte/[slug] - hybrid during the leaf → data-driven migration.
//
//   • Slugs present in src/data/standorte.ts render from the canonical component flow
//     (src/components/standort/*). One template, one section order, per-slug data.
//   • All other slugs still render from their captured leaf (src/data/standort-leaves/*.html)
//     via the legacy path below - unchanged - so no standort is dropped mid-migration.
//
// getStaticPaths still globs the leaves so every existing page keeps building. As each
// slug gains a standorte.ts entry it flips to the data-driven branch; when all are migrated
// the leaves + legacy branch can be deleted.
import SpaPage from '../../layouts/SpaPage.astro';
import HeroLaunchSG from '../../components/HeroLaunchSG.astro';
import HeroStandardSG from '../../components/HeroStandardSG.astro';
// Herbst-Kennenlerntage St. Gallen (temporär, src/data/herbst-sg.ts): Banner unter dem Header + Sheet/Sticky, nur bei aktiver Kampagne.
import HerbstBannerSG from '../../components/HerbstBannerSG.astro';
import HerbstSheetSG from '../../components/HerbstSheetSG.astro';
import { herbstState } from '../../data/herbst-sg';
const herbst = herbstState();
import { clinics, isRedirectedClinic } from '../../data/locations';
import { prefillStandort } from '../../data/form-prefill';
import homeBody from '../../data/home-body.html?raw';
import { getTherapeut, therapeuten, teamCardHtml, getPublicTherapistProfile } from '../../data/therapeuten';
import { getStandort, standorte, NETZ_BESCHWERDEN } from '../../data/standorte';
import { symptomCards } from '../../data/symptom-cards';
import { sgTherapienCompactHtml, sgBeschwerdenCompactHtml } from '../../lib/sg-compact-sections';
import { hautLinksFor, hautLinksHtml } from '../../data/haut-links';
import { ksLinksFor, ksLinksHtml } from '../../data/koerpersignale-links';
import type { Standort } from '../../data/standorte';
import Hero from '../../components/standort/Hero.astro';
import UspGrid from '../../components/standort/UspGrid.astro';
import Team from '../../components/standort/Team.astro';
import ClinicalLead from '../../components/standort/ClinicalLead.astro';
import { clinicalLeadHtml, clinicalLeadCardHtml } from '../../data/clinical-lead';
import { first30BottomSelectorHtml, first30State } from '../../data/first30';
import { upgradeLegacyForms, clinicById } from '../../lib/kontakt-form';
import { nearbyClinics, standortGridHtml, buchbareClinics } from '../../lib/standort-card';
const first30 = first30State();
import IntroNap from '../../components/standort/IntroNap.astro';
import Therapien from '../../components/standort/Therapien.astro';
import Beschwerden from '../../components/standort/Beschwerden.astro';
import Ablauf from '../../components/standort/Ablauf.astro';
import KrankenkassenTeam from '../../components/standort/KrankenkassenTeam.astro';
import { transparenzHtml } from '../../data/transparenz';
import UeberPraxis from '../../components/standort/UeberPraxis.astro';
import WeitereStandorte from '../../components/standort/WeitereStandorte.astro';
import KontaktForm from '../../components/standort/KontaktForm.astro';
import ClinicConcierge from '../../components/ClinicConcierge.astro';
import KontaktPraxis from '../../components/standort/KontaktPraxis.astro';
import AnfrageKarte from '../../components/standort/AnfrageKarte.astro';
import TerminSektion from '../../components/standort/TerminSektion.astro';
import ClinicLocationFirst from '../../components/standort/ClinicLocationFirst.astro';
import { locationTeamHtml } from '../../lib/location-team';
import CompactTherapien from '../../components/standort/CompactTherapien.astro';
import CompactBeschwerden from '../../components/standort/CompactBeschwerden.astro';
import Faq from '../../components/standort/Faq.astro';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/standort-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  // Umgeleitete Standorte (Winterthur Münzgasse → hwang.ch, public/_redirects) bekommen keine Seite.
  const paths = Object.keys(leaves).map((p) => {
    const slug = p.split('/').pop()!.replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] as string } };
  }).filter((x) => !isRedirectedClinic(x.params.slug));
  // Voll migrierte Standorte ohne Leaf (z.B. basel): Route kommt allein aus standorte.ts.
  const leafSlugs = new Set(paths.map((x) => x.params.slug));
  for (const s of Object.keys(standorte)) {
    if (!leafSlugs.has(s) && !isRedirectedClinic(s)) paths.push({ params: { slug: s }, props: { body: '' } });
  }
  return paths;
}

const { slug } = Astro.params;
const migrated = getStandort(slug!);
// Bern is an open clinic, never the old waitlist/legacy leaf. Fail the build on any regression.
if (slug === 'bern') {
  const bernClinic = clinics.find((c) => c.id === 'bern');
  if (!migrated || migrated.planned || migrated.review || migrated.partnerUmleitung || bernClinic?.status !== 'operational') {
    throw new Error('Bern must render the data-driven operating-clinic template, never the waitlist landing page');
  }
}
const url = `https://tcm.ch/standorte/${slug}/`;

// Interne Links in den /haut/-Cluster. Die Standort-Seiten werden täglich gecrawlt,
// die /haut/-Leaves standen dagegen in GSC auf "Gefunden – zurzeit nicht indexiert".
// Rotation über den Slug, damit nicht alle 14 Standorte dieselben sechs Leaves verlinken.
const hautBlock = hautLinksHtml(
  hautLinksFor(slug!, 6),
  'Haut & Gesicht',
  'Haut, Gesicht und was wirklich hilft',
  'Ehrlich erklärt: Wirkstoffe, Behandlungen und was davon realistisch etwas bringt.',
);

// Interne Links in den /koerpersignale/-Cluster. Gleiches Problem wie bei /haut/:
// Die Leaves stehen in GSC auf "URL ist Google nicht bekannt", verweisende Seite: keine.
const ksBlock = ksLinksHtml(
  ksLinksFor(slug! + 'ks', 6),
  'Körpersignale',
  'Wenn der Körper etwas meldet, bevor es einen Namen hat',
  'Schwindel beim Umdrehen, Puls im Ohr, taube Finger: medizinisch eingeordnet, ohne Panikmache.',
);

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

let title: string;
let description: string;
let schema: object;
let spaBody = '';
let sgPraxisHtml = '';

if (migrated) {
  // ── Data-driven branch ──────────────────────────────────────────────
  const data = migrated;
  const stadt = data.stadt;
  const clinic = clinics.find((c) => c.id === slug);
  title = data.seo?.title ?? `TCM & Akupunktur ${data.titelZusatz ?? stadt} | TCM.ch`;
  description = data.seo?.description ?? `TCM & Akupunktur in ${stadt}: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin direkt anfragen.`;
  // MedicalClinic fed from nap/geo; opening hours + areaServed from the clinic NAP record.
  const medClinic: Record<string, unknown> = {
    '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': url,
    name: data.seo?.schemaName ?? `TCM.ch ${stadt}`, url, inLanguage: 'de-CH', medicalSpecialty: 'TraditionalChineseMedicine',
    telephone: data.nap.telefon,
    memberOf: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
  };
  if (data.nap.strasse) medClinic.address = { '@type': 'PostalAddress', streetAddress: data.nap.strasse, postalCode: data.nap.plz, addressLocality: data.nap.ort, addressCountry: 'CH' };
  // Geplante Standorte: Status auch in den strukturierten Daten, keine Verfügbarkeits-Claims.
  if (data.planned) medClinic.description = `TCM-Praxis in Vorbereitung an der ${data.nap.strasse}, ${data.nap.ort}. Anfragen für den geplanten Start sind bereits möglich.`;
  if (data.nap.geo) medClinic.geo = { '@type': 'GeoCoordinates', latitude: data.nap.geo.lat, longitude: data.nap.geo.lng };
  if (clinic?.openingHours?.length) medClinic.openingHours = clinic.openingHours;
  if (clinic?.areaServed?.length) medClinic.areaServed = clinic.areaServed.map((a) => ({ '@type': 'City', name: a }));
  // Partnerpraxis: Schema beschreibt die reale Entität der Betreiberin (Name, URL, Praxistelefon) statt
  // einer zweiten «TCM.ch»-Klinik; TCM.ch nur als Netzwerk (memberOf). Gleiche @id auf DE und EN.
  if (data.betreiber) {
    Object.assign(medClinic, {
      '@id': `${data.betreiber.url}#praxis`, name: data.betreiber.name, url: data.betreiber.url,
      telephone: data.betreiber.telefon, sameAs: [data.betreiber.url],
      memberOf: { '@id': 'https://tcm.ch/#org' },
      brand: { '@type': 'Brand', name: data.betreiber.marke },
    });
  }
  const breadcrumb = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      ...(slug!.startsWith('zuerich-') ? [{ '@type': 'ListItem', position: 3, name: 'Zürich', item: 'https://tcm.ch/akupunktur-tcm-zuerich/' }] : []),
      { '@type': 'ListItem', position: slug!.startsWith('zuerich-') ? 4 : 3, name: stadt, item: url },
    ],
  };
  // Betriebsstatus in Prüfung: kein MedicalClinic-Knoten (keine bestätigte Praxis an dieser Adresse).
  schema = data.review ? [breadcrumb] : [medClinic, breadcrumb];
  if (data.faqs?.length) {
    (schema as object[]).push({ '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
  }
} else {
  // ── Legacy leaf branch (verbatim from the pre-refactor template) ─────
  const body = Astro.props.body;
  const clinic = clinics.find((c) => c.id === slug);
  const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
  const hName = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/TCM\.ch CARE.*?Akupunktur\s*/i, '').replace(/\s+/g, ' ').trim().slice(0, 40) : slug!;
  const name = clinic ? clinic.name : hName;
  const isPartner = slug === 'bottighofen';
  title = isPartner
    ? 'TCM Pelican Bottighofen: Akupunktur & TCM am Bodensee | TCM.ch'
    : slug === 'st-gallen'
      ? 'Akupunktur & TCM St. Gallen | TCM.ch'
      : `TCM & Akupunktur ${name} | TCM.ch`;
  description = isPartner
    ? 'TCM Pelican in Bottighofen: Akupunktur, Tuina und TCM, EMR-anerkannt, gut erreichbar bei Kreuzlingen am Bodensee. Partnerklinik im TCM.ch Netzwerk.'
    : slug === 'st-gallen'
      ? 'Akupunktur & TCM in St. Gallen beim Bahnhof: EMR-/ASCA-anerkannt, Zusatzversicherung je nach Police. Termin direkt anfragen.'
      : `TCM & Akupunktur in ${name}: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin direkt anfragen.`;

  const medClinic: Record<string, unknown> = {
    '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': url,
    name: clinic?.schemaName ?? `TCM.ch ${name}`, url, inLanguage: 'de-CH', medicalSpecialty: 'TraditionalChineseMedicine',
  };
  if (clinic) {
    medClinic.telephone = clinic.phone;
    if (clinic.street) medClinic.address = { '@type': 'PostalAddress', streetAddress: clinic.street, postalCode: clinic.postalCode, addressLocality: clinic.city, addressCountry: 'CH' };
    if (clinic.geo) medClinic.geo = { '@type': 'GeoCoordinates', latitude: clinic.geo.lat, longitude: clinic.geo.lng };
    if (clinic.openingHours?.length) medClinic.openingHours = clinic.openingHours;
    if (clinic.areaServed?.length) medClinic.areaServed = clinic.areaServed.map((a) => ({ '@type': 'City', name: a }));
  }
  const breadcrumb = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name, item: url },
    ],
  };
  schema = [medClinic, breadcrumb];

  function endOfDiv(html: string, i: number) { const rx = /<div\b|<\/div>/g; rx.lastIndex = i; let d = 0; let m: RegExpExecArray | null; while ((m = rx.exec(html))) { if (m[0] === '</div>') { d--; if (d === 0) return m.index + 6; } else d++; } return html.length; }
  let outBody = body;
  if (slug === 'st-gallen') {
    // Lokales Team ausschliesslich aus den kanonischen Zuordnungen therapeuten[].standorte[]
    // (gleiche Quelle wie Team.astro und EN Practitioners.astro; Gate check-clinic-status 4i).
    // Keine hartcodierte Slug-Liste, kein stiller Fallback: fehlt der Grid-Marker, bricht der Build ab.
    const tg0 = outBody.indexOf('<div class="team-grid">');
    if (tg0 < 0) throw new Error('st-gallen: team-grid-Marker für die kanonischen Teamkarten nicht gefunden - Leaf geändert?');
    const cards = therapeuten
      .filter((t) => t.standorte?.includes('st-gallen'))
      .map((t) => teamCardHtml(getPublicTherapistProfile(t)))
      .join('')
      // Schmale Mobile-Karten: bedingte Trennstellen nur im sichtbaren Titel-/Namenstext (nicht in alt/aria-label),
      // damit lange Wörter sauber mit Trennstrich statt mitten im Wort umbrechen.
      .replace(/(<div class="tmc-(?:title|name)">)([^<]*)(<\/div>)/g, (_m, a: string, txt: string, b: string) =>
        a + txt.replace(/Naturheilpraktikerin/g, 'Naturheil&shy;praktikerin').replace(/Lenggenhager/g, 'Lenggen&shy;hager') + b);
    if (!cards) throw new Error('st-gallen: keine Therapeut:innen mit standorte[] st-gallen in therapeuten.ts');
    // Ein einheitliches Teamraster: klinische Leitung (netzwerkweit, eigener Marker, keine .tmc-Karte) zuerst,
    // danach die lokalen Karten; die separate Clinical-Lead-Sektion entfällt für St. Gallen.
    const leadCard = clinicalLeadCardHtml('st-gallen');
    if (!leadCard) throw new Error('st-gallen: Clinical-Lead-Karte leer - clinics/therapeuten prüfen');
    outBody = outBody.slice(0, tg0) + '<div class="team-grid sg-team-grid">' + leadCard + cards + '</div>' + outBody.slice(endOfDiv(outBody, tg0));
  }
  if (slug === 'bottighofen') {
    const emanuela = getTherapeut('emanuela-pelican');
    const card = emanuela ? teamCardHtml(getPublicTherapistProfile(emanuela)) : '';
    const ph = outBody.indexOf('<div style="display:grid;grid-template-columns:1fr;gap:16px;margin:20px 0;max-width:300px">');
    if (card && ph >= 0) outBody = outBody.slice(0, ph) + '<div class="team-grid bf-therapist" style="max-width:360px;margin:20px 0">' + card + '</div>' + outBody.slice(endOfDiv(outBody, ph));
    const hg0 = homeBody.indexOf('<div class="svc-grid">');
    const homeGrid = hg0 >= 0 ? homeBody.slice(hg0, endOfDiv(homeBody, hg0)) : '';
    const lg0 = outBody.indexOf('<div class="svc-grid">');
    if (homeGrid && lg0 >= 0) outBody = outBody.slice(0, lg0) + homeGrid + outBody.slice(endOfDiv(outBody, lg0));
  }

  // "Häufige Beschwerden" für die Legacy-Leaves - gleiches Schema wie Beschwerden.astro
  // (Basis-Set + Rotation, unique Listen, Anker-Mix), bis diese Slugs migriert sind.
  const LEGACY_BESCHWERDEN: Record<string, { stadt: string; intro: string; slugs: string[] }> = {
    bottighofen: { stadt: 'Bottighofen', intro: 'Womit kommen die Leute in Bottighofen zu uns? Meistens mit einem dieser Themen. Jede Seite erklärt, was die TCM realistisch leisten kann.', slugs: ['rueckenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'kinderwunsch', 'tinnitus', 'wechseljahre'] },
  };
  const lb = LEGACY_BESCHWERDEN[slug!];
  const beschwerdenLinks = lb
    ? `<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal"><div class="section-label">Beschwerden</div><h2 class="section-title">Häufige Beschwerden in ${lb.stadt}</h2><p class="section-sub">${lb.intro}</p><div class="cl-links">${lb.slugs.map((s, i) => `<a href="/beschwerden/${s}/" class="cl-chip">${i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei ${symptomCards[s]?.name ?? s}</a>`).join('')}</div></div></section>`
    : '';
  const filledBody = prefillStandort(outBody, name)
    .replace('<!--transparenz-->', transparenzHtml(slug!))
    .replace(
      /<button type="button" class="btn-primary" onclick="openTerminForm\(\)" style="width:100%;justify-content:center;margin-bottom:10px;display:flex">([\s\S]*?)<\/button>/,
      `<a href="?standort=${encodeURIComponent(name)}" class="btn-primary" style="width:100%;justify-content:center;margin-bottom:10px;display:flex">$1</a>`,
    )
    .replace(
      '<button type="button" class="btn-white" onclick="openTerminForm()" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</button>',
      '<a href="#kontakt" class="btn-white" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</a>',
    )
    .replace(
      '<section class="section contact-section-inline" style="background:var(--surface)">',
      '<section id="kontakt" class="section contact-section-inline" style="scroll-margin-top:68px;background:var(--surface)">',
    );

  // SG Ads/CRO: four concise groups with all eight original detail links optional.
  const escH = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  // FAQ «Fragen zu deinem ersten Termin» (ersetzt den Ablauf-Block; bestehendes kk-faq-Accordion, kkToggle in home.js;
  // nur belegte SG-Angaben, kein FAQ-Schema). Steht direkt vor dem Kontaktformular.
  const sgFaqHtml = slug === 'st-gallen'
    ? '<section class="kk-section" id="sg-faq" aria-labelledby="sg-faq-h"><div class="wrap"><div class="kk-inner"><div class="kk-header reveal"><div class="section-label">Häufige Fragen</div><h2 class="section-title" id="sg-faq-h">Fragen zu deinem ersten Termin</h2></div><div class="kk-faq"><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q1" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a1">Wie kläre ich meine Zusatzversicherung vor dem Termin?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a1" role="region" aria-labelledby="sg-faq-q1"><p>Unsere Fachpersonen sind EMR-/ASCA-anerkannt. Was deine Zusatzversicherung übernimmt, hängt von deiner Police und der Anerkennung der behandelnden Fachperson ab. Nenn uns bei der Anfrage deine Krankenkasse, dann unterstützen wir dich bei der Abklärung vor dem ersten Termin. Den Überblick findest du unter <a href="/krankenkassen/">Krankenkasse &amp; Kosten</a>.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q3" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a3">Wird beim ersten Termin bereits behandelt?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a3" role="region" aria-labelledby="sg-faq-q3"><p>Meist ja. Zuerst nehmen wir uns Zeit für ein ausführliches Gespräch und die TCM-Diagnostik nach Puls und Zunge. Ist eine Behandlung fachlich sinnvoll, beginnen wir direkt damit. <a href="/gesundheitsbibliothek/fragen/was-passiert-beim-ersten-termin/">Was beim ersten Termin passiert</a></p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q4" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a4">Brauche ich eine ärztliche Überweisung?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a4" role="region" aria-labelledby="sg-faq-q4"><p>Nein. Du kannst direkt einen Termin anfragen, für die TCM-Behandlung brauchst du keine ärztliche Überweisung. Gehört dein Anliegen zuerst ärztlich abgeklärt, sagen wir dir das ehrlich.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q5" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a5">Gibt es Abend- oder Samstagstermine?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a5" role="region" aria-labelledby="sg-faq-q5"><p>Die Praxis ist Montag bis Samstag von 07:30 bis 19:30 Uhr geöffnet, sonntags von 08:00 bis 17:00 Uhr. Ob zu deiner Wunschzeit ein Termin frei ist, klären wir bei der Anfrage. Trag dafür im Formular deine Wunschzeit ein oder schau in der <a href="#online-buchen">Online-Buchung</a> nach.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q6" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a6">Was soll ich zum ersten Termin mitbringen?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a6" role="region" aria-labelledby="sg-faq-q6"><p>Du musst nichts vorbereiten. Bring, falls vorhanden, bisherige Befunde oder eine Liste deiner Medikamente mit. Mehr zum Ablauf unter <a href="/wissen/tcm-st-gallen-erfahrungen-ablauf/">Erfahrungen und Ablauf in St. Gallen</a>.</p></div></div></div></div></div></section>'
    : '';
  const sgBeschwerdenHtml = slug === 'st-gallen' ? sgBeschwerdenCompactHtml() : '';
  const sgWlLinks = ksLinksFor(slug! + 'ks', 6);
  const sgWeiterlesenHtml = slug === 'st-gallen'
    ? '<section class="section sg-weiterlesen" id="sg-weiterlesen"><div class="wrap"><div class="sg-wl" role="navigation" aria-labelledby="sg-wl-h"><h2 class="sg-wl-label" id="sg-wl-h">Weiterlesen</h2>' +
      sgWlLinks.map((l) => `<a href="/koerpersignale/${l.slug}/">${escH(l.label)}</a>`).join('') +
      '<a href="/koerpersignale/" class="sg-wl-all">Alle Körpersignale <span aria-hidden="true">→</span></a></div></div></section>'
    : '';
  // Netzwerkweite klinische Leitung (src/data/clinical-lead.ts): St. Gallen direkt nach dem lokalen
  // Team-Block (fehlender Team-Marker bricht den Build ab), andere Legacy-Leaves siehe unten.
  const leadHtml = clinicalLeadHtml(slug!);
  let sgBody = filledBody;
  if (slug === 'st-gallen') {
    // Presentation-only SG pilot: replace the bulky 10-image therapy catalogue
    // with four core treatments and six expandable text links, then the compact
    // four-group complaints section. The canonical detail pages stay linked.
    // The original leaf's therapy block is validated before replacement.
    const ti = sgBody.indexOf('<section class="section" id="team-st-gallen"');
    if (ti < 0) throw new Error('st-gallen: Team-Marker für die Beschwerden-Karten nicht gefunden - Leaf geändert?');
    const thi = sgBody.indexOf('<section', ti + 1);
    const the = sgBody.indexOf('</section>', thi) + 10;
    let thSec = sgBody.slice(thi, the);
    thSec = thSec
      .replace(/href="\/therapien\/([^"/]+)\/?"/g, 'href="/therapien/$1/?standort=st-gallen"')
      .replace(/onclick="event\.preventDefault\(\);\s*nav\('therapie','([^']+)'\)"/g, '');
    if (!thSec.startsWith('<section class="section svc-section">') || !thSec.includes('Unsere <em>Therapien</em> in St. Gallen') || !thSec.includes('id="sg-more-therapien-btn"'))
      throw new Error('st-gallen: Therapie-Sektion folgt nicht direkt auf das Team - Leaf geändert?');
    sgBody = sgBody.slice(0, ti) + sgTherapienCompactHtml(thSec) + sgBody.slice(ti, thi) + sgBeschwerdenHtml + sgBody.slice(the);
    sgBody = sgBody
      .replace(/href="\/therapien\/([^"/]+)\/?"/g, 'href="/therapien/$1/?standort=st-gallen"')
      .replace(/href="\/beschwerden\/([^"/]+)\/?"/g, 'href="/beschwerden/$1/?standort=st-gallen"');
    // FIRST 30 (nur solange der Kampagnen-Hero gezeigt wird): Angebots-Wähler ÜBER dem unteren Kontaktformular und
    // Leaf-CTAs auf das Geschenk umgestellt. Geschlossene Kampagne = Leaf unverändert (reguläre CTAs → #offer-form).
    if (first30.showCampaign) {
      const bc = '<div class="inline-form-card">';
      const bi = sgBody.indexOf(bc);
      if (bi < 0) throw new Error('st-gallen: inline-form-card-Marker für den FIRST-30-Wähler nicht gefunden - Leaf geändert?');
      sgBody = sgBody.slice(0, bi) + first30BottomSelectorHtml() + sgBody.slice(bi);
      const giftLabel = first30.campaign === 'soldout-waitlist' ? 'FIRST 30 Warteliste' : 'FIRST 30 Geschenk anfragen';
      sgBody = sgBody
        .split('<a href="#offer-form" class="btn-primary">Ersttermin anfragen</a>').join(`<a href="#kontakt" class="btn-primary" data-offer="first30">${giftLabel}</a>`)
        .split('<a href="#offer-form" class="sgcta-free">Ersttermin anfragen</a>').join(`<a href="#kontakt" class="sgcta-free" data-offer="first30">${giftLabel}</a>`);
    }
    // Angebotsspezifische CTAs «Ersttermin anfragen» → explizit Ersttermin mit Behandlung (kontakt-form.js, data-kf-terminart).
    sgBody = sgBody
      .split('<a href="#offer-form" class="btn-primary">Ersttermin anfragen</a>').join('<a href="#termin-formular" class="btn-primary" data-kf-terminart="behandlung">Ersttermin anfragen</a>')
      .split('<a href="#offer-form" class="sgcta-free">Ersttermin anfragen</a>').join('<a href="#termin-formular" class="sgcta-free" data-kf-terminart="behandlung">Ersttermin anfragen</a>');
    // Praxisfoto in «Über die Praxis»: der FIRST-30-Hero hat keine Fotohälfte, der reguläre Hero zeigt seit dem
    // gemeinsamen Hero-Video (HeroMedia) das Foto nur noch als Poster. Markup wie praxisBilder in UeberPraxis.astro.
    const uh = '<h2 class="up-h2">Über die Praxis</h2>';
    const ui = sgBody.indexOf(uh);
    if (ui < 0) throw new Error('st-gallen: Über-die-Praxis-Marker für das Praxisfoto nicht gefunden - Leaf geändert?');
    // The existing real clinic photo follows the factual location details, before the map.
    // The hero video remains in the hero; do not duplicate the clinic photo in a booking sidebar.
    const sgMobilePhoto = '<figure class="sgt-practice-photo"><img src="/images/standort-stgallen.webp" srcset="/images/standort-stgallen-800.webp 800w, /images/standort-stgallen.webp 1400w" sizes="(max-width:1023px) 100vw, 1px" alt="TCM.ch St. Gallen – Empfangsbereich, Oberer Graben 22" width="1400" height="1052" loading="lazy" decoding="async"></figure>';
    const mapMarker = '<div class="up-map">';
    if (sgBody.split(mapMarker).length !== 2) throw new Error('st-gallen: expected one clinic map after the NAP facts');
    sgBody = sgBody.replace(mapMarker, sgMobilePhoto + mapMarker);
    // 05.11.2026: Praxisfoto steht in der linken Spalte der Kontaktsektion (HeroStandardSG), nicht mehr unter «Über die Praxis».
    const h0 = sgBody.indexOf('<div id="standort-flagship-hero"');
    const c0 = sgBody.indexOf('<div id="standort-content">');
    if (h0 >= 0 && c0 > h0) sgBody = sgBody.slice(0, h0) + sgBody.slice(c0);
    // 05.11.2026: Buchung (OneDoc) und Formular stehen in der Kontaktsektion #termin direkt unter dem Hero (HeroStandardSG).
    // Die untere Leaf-Kontaktkarte (#kontakt) und die separate OneDoc-Sektion entfallen; an ihrer Stelle FAQ + Weiterlesen.
    // Kein stiller Fallback: fehlt der Kontakt-Marker, bricht der Build ab (Injektions-Guard).
    const kontaktMarker = '<section id="kontakt" class="section contact-section-inline"';
    const ki = sgBody.indexOf(kontaktMarker);
    const ke = ki >= 0 ? sgBody.indexOf('</section>', ki) : -1;
    if (ke < 0) throw new Error('st-gallen: untere Kontaktsektion nicht gefunden - Leaf geändert?');
    // «Über die Praxis» steht seit 20.11.2026 zwischen FAQ und «Weiterlesen» (Platzhalter, gefüllt weiter unten).
    sgBody = sgBody.slice(0, ki) + sgFaqHtml + '<!--sg-praxis-->' + sgWeiterlesenHtml + sgBody.slice(ke + 10);
    // Keine Preisangaben (05.11.2026): Kostenkarte «CHF 130–160 pro Sitzung» → nur «Krankenkassen anerkannt (EMR/ASCA)» mit Link;
    // Transparenz-Karte («Was du vorab prüfen kannst») ohne Tarifbezug. Guards statt stiller Fallbacks.
    const kk0 = sgBody.indexOf('<div class="sg-kosten-card"');
    const kkEnd = 'Kosten &amp; Krankenkasse ansehen <span aria-hidden="true">→</span></a></div>';
    const kk1 = kk0 >= 0 ? sgBody.indexOf(kkEnd, kk0) : -1;
    if (kk1 < 0) throw new Error('st-gallen: Kostenkarte nicht gefunden - Leaf geändert?');
    sgBody = sgBody.slice(0, kk0) + '<p class="sg-kk-line" style="font-family:var(--font-sans);font-size:16px;font-weight:700;color:var(--black);margin:0"><span class="lsr-check" aria-hidden="true">✓</span> Krankenkassen anerkannt (EMR/ASCA) <span style="color:var(--mid);font-weight:600">·</span> <a href="/krankenkassen/" style="color:var(--blue);text-decoration:none">Krankenkasse &amp; Kosten <span aria-hidden="true">→</span></a></p>' + sgBody.slice(kk1 + kkEnd.length);
    const tr0 = 'Kosten vorab klar', tr1 = 'Abrechnung nach Tarif 590. Was deine';
    if (!sgBody.includes(tr0) || !sgBody.includes(tr1)) throw new Error('st-gallen: Transparenz-Kostenkarte nicht gefunden - transparenz.ts geändert?');
    sgBody = sgBody.replace(tr0, 'Krankenkasse vorab klar').replace(tr1, 'Krankenkassen anerkannt (EMR/ASCA). Was deine');
    // Duplikate zum Vertrauensblock im Termin-Bereich (06.11.2026): Transparenz-Karte «Krankenkasse vorab klar», Sektion
    // «Krankenkassen anerkannt» (inkl. Kassenzeile + CTA) und «Dein TCM Team in St. Gallen» entfallen. Guards statt stiller Fallbacks.
    const cut = (startMarker: string, endMarker: string, name: string, fromIdx = 0) => {
      const a = sgBody.indexOf(startMarker, fromIdx); const b = a >= 0 ? sgBody.indexOf(endMarker, a + startMarker.length) : -1;
      if (a < 0 || b < 0) throw new Error(`st-gallen: ${name} nicht gefunden - Leaf/transparenz.ts geändert?`);
      sgBody = sgBody.slice(0, a) + sgBody.slice(b);
    };
    const trk = sgBody.indexOf('Krankenkasse vorab klar');
    cut('<div class="usp-card">', '<div class="usp-card">', 'Transparenz-Krankenkassenkarte', sgBody.lastIndexOf('<div class="usp-card">', trk));
    const kks = sgBody.indexOf('Krankenkassen <em>anerkannt</em>');
    if (kks < 0) throw new Error('st-gallen: Sektion «Krankenkassen anerkannt» nicht gefunden - Leaf geändert?');
    sgBody = sgBody.slice(0, sgBody.lastIndexOf('<section', kks)) + sgBody.slice(sgBody.indexOf('</section>', kks) + 10);
    { const t0 = sgBody.indexOf('<section class="section" id="team-st-gallen"'); const t1 = t0 >= 0 ? sgBody.indexOf('</section>', t0) + 10 : -1; if (t1 < 10) throw new Error('st-gallen: Team-Sektion nicht gefunden - Leaf geändert?'); sgBody = sgBody.slice(0, t0) + sgBody.slice(t1); }
    // Alle Leaf-CTAs auf die Kontaktsektion: #kontakt (entfernt) und #offer-form (Formularkarte, bleibt als Alias) → #termin.
    sgBody = sgBody.split('href="#kontakt"').join('href="#termin"').split('href="#offer-form"').join('href="#termin"');
    // Regulärer Hero (16.10.2026): USP-Reihe und «Über die Praxis» werden aus dem Leaf VERSCHOBEN (nicht kopiert) und von
    // HeroStandardSG direkt unter dem Hero gerendert: USPs kompakt, Praxisangaben neben der Buchungsbox.
    // Die USP-CTA-Wiederholung (#offer-form / #online-buchen) entfällt, die Box folgt unmittelbar.
    if (!first30.showCampaign) {
      const us0 = sgBody.indexOf('<section class="usp-grid-section"');
      const us1 = us0 >= 0 ? sgBody.indexOf('</section>', us0) + 10 : -1;
      const usSec = us0 >= 0 ? sgBody.slice(us0, us1) : '';
      const ug = usSec.indexOf('<div class="usp-grid">');
      if (ug < 0 || (usSec.match(/class="usp-card"/g) || []).length !== 3 || !usSec.includes('class="sg-cta-repeat"'))
        throw new Error('st-gallen: USP-Sektion (3 Karten + CTA-Wiederholung) nicht gefunden - Leaf geändert?');
      // The three repeated USPs and contact CTAs are removed entirely, not moved.
      sgBody = sgBody.slice(0, us0) + sgBody.slice(us1);
      // No second "Du weisst nicht, welche Behandlung ..." pitch after the location/booking section.
      const notice = '<section class="section" style="padding:20px 0 0 !important">';
      const n0 = sgBody.indexOf(notice), n1 = n0 >= 0 ? sgBody.indexOf('</section>', n0) : -1;
      if (n0 < 0 || n1 < 0 || !sgBody.slice(n0, n1).includes('Du weisst nicht, welche Behandlung du brauchst?'))
        throw new Error('st-gallen: old redundant advice notice not found');
      sgBody = sgBody.slice(0, n0) + sgBody.slice(n1 + 10);
      const up0 = sgBody.indexOf('<section class="up-sec"><div class="up-wrap">');
      const up1 = up0 >= 0 ? sgBody.indexOf('</div></section>', up0) : -1;
      if (up1 < 0 || !sgBody.slice(up0, up1).includes(uh) || /<section/.test(sgBody.slice(up0 + 8, up1)))
        throw new Error('st-gallen: Über-die-Praxis-Sektion nicht eindeutig gefunden - Leaf geändert?');
      sgPraxisHtml = sgBody.slice(up0 + '<section class="up-sec"><div class="up-wrap">'.length, up1);
      sgBody = sgBody.slice(0, up0) + sgBody.slice(up1 + '</div></section>'.length);
      // Praxis-Sektion (NAP, Foto, Karte, Anreise) nach dem FAQ: Infos links, Foto/Karte rechts (Styles .sgt-* aus
      // HeroStandardSG, dort seit 16.10.2026). Guards statt stiller Fallbacks; Markup/Attribute der Links unverändert.
      if (!sgPraxisHtml.includes('Oberer Graben 22, 9000 St. Gallen') || !sgPraxisHtml.includes('class="up-map"') ||
          sgPraxisHtml.split('<figure class="sgt-practice-photo"').length !== 2 || (sgPraxisHtml.match(/class="up-ico"/g) || []).length !== 4)
        throw new Error('st-gallen: Praxisangaben/Foto/Karte/Icons nicht eindeutig gefunden - Leaf geändert?');
      const pra = sgPraxisHtml
        .replaceAll('class="up-ico"', 'class="sgt-fact-icon"')
        .replace('href="tel:+41775236122"', 'href="tel:+41775236122" data-kf-tel data-care-cta="termin-karte-tel"');
      const pf = pra.indexOf('<figure class="sgt-practice-photo"'), pt = pra.indexOf('<details class="up-transit-acc"');
      if (pf < 0 || pt < pf) throw new Error('st-gallen: Reihenfolge Foto → Karte → Anreise nicht gefunden - Leaf geändert?');
      const SG_MAPS = 'https://www.google.com/maps/place/TCM.ch+St+Gallen/@47.423225,9.3740224,17z/data=!4m8!3m7!1s0x479b1fa8422eee23:0x4d9e5b1cb4999c7!8m2!3d47.423225!4d9.3740224!9m1!1b1';
      const SG_WA = 'https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen.';
      const sgPraxisSection = '<section class="sgt sgt--location-first sgt--praxis" aria-label="Über die Praxis St. Gallen"><div class="sgt-wrap sgt-grid sgt-grid--praxis">' +
        '<div class="sgt-practice" id="sg-standort">' + pra.slice(0, pf) + pra.slice(pt) +
        '<div class="sgt-location-actions"><a href="' + SG_MAPS + '" target="_blank" rel="noopener noreferrer" data-care-cta="sg-route"><span aria-hidden="true">↗</span> Route planen</a>' +
        '<a href="' + SG_WA + '" target="_blank" rel="noopener noreferrer" data-care-cta="termin-karte-wa"><span aria-hidden="true">↗</span> WhatsApp</a></div></div>' +
        '<div class="sgt-practice sgt-praxis-media">' + pra.slice(pf, pt) + '</div></div></section>';
      if (sgBody.split('<!--sg-praxis-->').length !== 2) throw new Error('st-gallen: Praxis-Platzhalter nicht gefunden');
      sgBody = sgBody.replace('<!--sg-praxis-->', sgPraxisSection);
    }
  }
  // Andere Legacy-Leaves (Bottighofen): Block vor dem Kontaktformular, sonst vor den Beschwerden-Links.
  const km = filledBody.indexOf('<section id="kontakt" class="section contact-section-inline"');
  const legacyBody0 = km >= 0 ? filledBody.slice(0, km) + leadHtml + filledBody.slice(km) : filledBody + leadHtml;
  // Gemeinsames Kontaktformular auch auf den übrigen Legacy-Leaves (Bottighofen): fester Standort, wenn operativ.
  const legacyClinic = clinicById(slug!);
  const legacyBody = upgradeLegacyForms(legacyBody0, { path: `/standorte/${slug}/`, standortId: legacyClinic?.status === 'operational' ? slug : undefined, instancePrefix: 'standort' });
  // The legacy Corinna / Yuna WhatsApp-only banner is superseded by the
  // shared CARE concierge below all page content. Preserve therapist/team
  // information, FAQs, existing contact forms and the original links.
  const removeOldPromo = (html: string) => {
    const marker = '<section class="sg-merged-cta">';
    const at = html.indexOf(marker);
    if (at < 0) return html;
    const end = html.indexOf('</section>', at);
    if (end < 0 || html.indexOf(marker, end + 10) >= 0)
      throw new Error('standort: legacy promo marker unbalanced or repeated');
    return html.slice(0, at) + html.slice(end + 10);
  };
  spaBody = removeOldPromo((slug === 'st-gallen') ? sgBody : legacyBody + beschwerdenLinks + hautBlock + ksBlock);
  if (slug === 'bottighofen') {
    const heading = spaBody.indexOf('Deine Therapeutin in Bottighofen');
    const start = heading < 0 ? -1 : spaBody.lastIndexOf('<section', heading);
    const end = heading < 0 ? -1 : spaBody.indexOf('</section>', heading);
    if (start < 0 || end < 0) throw new Error('Bottighofen: original therapist section not found');
    spaBody = spaBody.slice(0,start) + locationTeamHtml('bottighofen','Bottighofen') + spaBody.slice(end+10);
  }
  if (slug === 'kreuzlingen') {
    // Kreuzlingen has no legacy team section: insert the shared full roster
    // directly after its genuine practice/arrival block.
    const start=spaBody.indexOf('<section class="up-sec">');
    const end=start<0?-1:spaBody.indexOf('</section>',start);
    if(start<0||end<0)throw new Error('Kreuzlingen: original Über die Praxis section not found');
    spaBody=spaBody.slice(0,end+10)+locationTeamHtml('kreuzlingen','Kreuzlingen')+spaBody.slice(end+10);
  }
  // «Praxen in der Nähe» (05.11.2026): Leaf-Karten durch die zentrale Standortkarte ersetzen (max. 3 buchbare nach Distanz).
  {
    const rs = spaBody.indexOf('<section class="related-section">');
    if (rs < 0) throw new Error(`${slug}: related-section (Praxen in der Nähe) nicht gefunden - Leaf geändert?`);
    const re = spaBody.indexOf('</section>', rs) + 10;
    // SG pilot: this competing-clinic cross-sell is deliberately removed.
    // All other legacy location pages retain their existing nearby-clinic cards.
    const near = slug === 'st-gallen' ? [] : nearbyClinics(slug!, 3);
    spaBody = spaBody.slice(0, rs) + (near.length ? '<section class="related-section"><div class="wrap"><div class="section-label">Weitere Standorte</div><h2 class="section-title">Praxen <em>in der Nähe</em></h2><div class="reveal">' + standortGridHtml(near, { variant: 'kompakt', cols: 3 }) + '</div></div></section>' : '') + spaBody.slice(re);
    // Buchungsanker #termin (Standortkarten «Termin buchen →») auf Legacy-Leaves ohne eigenen Anker: vor der Kontaktsektion.
    if (!/id="termin"/.test(spaBody)) spaBody = spaBody.replace('<section id="kontakt" class="section contact-section-inline"', '<span id="termin" class="kf-compat-anchor" aria-hidden="true" style="display:block;height:0;scroll-margin-top:var(--header-h,76px)"></span><section id="kontakt" class="section contact-section-inline"');
  }
}

const data = migrated as Standort;
const conciergeClinic = clinics.find((c) => c.id === slug);
const conciergeName = conciergeClinic?.name ?? (migrated?.stadt ?? slug!);
const conciergeStatus = conciergeClinic?.status ?? (migrated?.review ? 'review' : migrated?.planned ? 'planned' : 'operational');
// Partner-Umleitung (Marktgasse bis zur Eröffnung 2027 → Praxis Hwang): Umleitungskarte statt Anfragebox/Formular/OneDoc;
// Karte trägt den Sticky-CTA-Hinweis (StickyCtaBar liest data-sticky-cta-href/-label).
const PU = migrated?.partnerUmleitung;
const escU = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const umleitungCard = PU
  ? `<div class="inline-form-card kf kf--ruhig kf-huelle" id="anfrage-box" data-sticky-cta-href="${escU(PU.href)}" data-sticky-cta-label="${escU(PU.cta)}"><link rel="stylesheet" href="/kontakt-form.css"><div class="kf-kopf"><h2 class="kf-h">Termin in Winterthur</h2><p class="kf-kopf-sub">${escU(PU.hinweis)}</p></div><div class="kf-fields" style="padding-top:16px"><a class="kf-btn kf-btn--primary" href="${escU(PU.href)}" target="_blank" rel="noopener" style="display:inline-flex;justify-content:center;width:100%;text-decoration:none">${escU(PU.cta)} <span aria-hidden="true">→</span></a><p class="kf-note" style="margin-top:10px">Du wechselst auf hwang.ch, die Website der Praxis Hwang. Die Praxis an der Marktgasse 78 eröffnet 2027.</p></div></div>`
  : '';
// Kompakte weiterführende Links (SG «Weiterlesen»): dieselben Haut- und Körpersignale-Links wie die bisherigen Blöcke.
const escL = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Wie SG «Weiterlesen» (eine kompakte Linkzeile); zusätzlich die /haut/-Links (Indexierung, haut-links.ts) in derselben Zeile.
const weiterlesenHtml = '<section class="section sg-weiterlesen" id="weiterlesen"><div class="wrap"><div class="sg-wl" role="navigation" aria-labelledby="std-wl-h"><h2 class="sg-wl-label" id="std-wl-h">Weiterlesen</h2>' +
  hautLinksFor(slug!, 6).map((l) => `<a href="/haut/${l.slug}/">${escL(l.label)}</a>`).join('') +
  '<a href="/haut/" class="sg-wl-all">Alle Themen zu Haut &amp; Gesicht <span aria-hidden="true">→</span></a>' +
  ksLinksFor(slug! + 'ks', 6).map((l) => `<a href="/koerpersignale/${l.slug}/">${escL(l.label)}</a>`).join('') +
  '<a href="/koerpersignale/" class="sg-wl-all">Alle Körpersignale <span aria-hidden="true">→</span></a></div></div></section>';
---
{migrated ? (
  <SpaPage title={title} description={description} path={`/standorte/${slug}`} body="" schema={schema} noindex={!!data.noindex} robots="noindex, follow">
    {/* Wie St. Gallen (HeroStandardSG): Hero und Kontakt-/Praxisbereich vor #page-standort, damit dort weder die
        seitenweiten Karten-/Abstandsregeln ([id^="page-"] …) noch die Hero-Geschwisterregel (#sg-premium-hero ~ section) greifen. */}
    <Hero data={data} />
    <div class:list={["std-oben", { "std-zh-cro": ['zuerich-bahnhofstrasse','zuerich-oerlikon','zuerich-hoengg'].includes(data.slug) }]}>
      {data.planned && (
      <section class="section" data-status-banner={data.review ? 'review' : 'planned'} style="padding:0;background:var(--bg)">
        <div class="wrap" style="padding-top:12px">
          <div style="background:var(--green-mint);border:1px solid var(--green-mid);border-radius:14px;padding:16px 20px">
            <div style="font-family:var(--font-sans);font-weight:800;font-size:15.5px;color:var(--black);margin-bottom:3px">{data.plannedTitle ?? 'Standort in Vorbereitung'}</div>
            {data.plannedNote
              ? <div class="content-body" style="font-size:14.5px;color:var(--mid);line-height:1.55" set:html={data.plannedNote} />
              : <div style="font-size:14.5px;color:var(--mid);line-height:1.55">Die Praxis in {data.stadt} ist noch nicht eröffnet. Du kannst dein Anliegen bereits jetzt anfragen – wir melden uns, sobald Termine möglich sind. Bis dahin behandeln wir dich gerne an einem unserer anderen Standorte.</div>}
          </div>
        </div>
      </section>
      )}
      {/* Shared SG-style facts + canonical booking component. */}
      <ClinicLocationFirst data={data} sitekey={turnstileSitekey} umleitungCard={umleitungCard} />
    </div>
    <div class:list={["page active std-ds std-vorlage", { "std-zh-cro": ['zuerich-bahnhofstrasse','zuerich-oerlikon','zuerich-hoengg'].includes(data.slug) }]} id="page-standort" style="display:block">
      <div id="standort-content">
        <Fragment set:html={locationTeamHtml(data.slug, data.stadt)} />
        <CompactTherapien data={data} />
        <CompactBeschwerden data={data} />
        <Faq data={data} />
        <Fragment set:html={weiterlesenHtml} />
      </div>
    </div>
    <style is:global>
      /* Zürich location pages only: compact mobile rhythm, no content or link deletion. */
      @media(max-width:767px){
        .std-zh-cro .sgu{padding:4px 16px}
        .std-zh-cro .sgu .usp-card{padding:7px 0}
        .std-zh-cro .sgu .usp-sub{font-size:12px;line-height:1.4}
        .std-zh-cro .sgk{padding:20px 16px}
        .std-zh-cro .sgk-inner{gap:16px}
        .std-zh-cro .svc-section{padding-top:30px!important;padding-bottom:30px!important;min-height:0!important}
        .std-zh-cro .svc-header{margin-bottom:16px!important}
        .std-zh-cro .svc-sub{font-size:14px!important;line-height:1.45!important}
        .std-zh-cro .svc-card .svc-cta{font-size:12px!important}
        .std-zh-cro .sg-bs-cta{margin-top:18px!important}
        .std-zh-cro .std-hinweis{padding-top:10px!important}
        .std-zh-cro .std-hinweis .wrap>div{padding:14px 16px!important}
      }
    </style>
    <ClinicConcierge slot="pre-footer" locationName={conciergeName} status={conciergeStatus} />
  </SpaPage>
) : (
  <SpaPage title={title} description={description} path={`/standorte/${slug}`} body={spaBody} schema={schema}>
    {slug === 'st-gallen' && <style is:global>{`
      /* St. Gallen primary landing page: compact mobile section rhythm only. */
      @media(max-width:767px){
        #page-standort.sg-ds .svc-section{padding-top:30px!important;padding-bottom:30px!important;min-height:0!important}
        #page-standort.sg-ds .svc-header{margin-bottom:16px!important}
        #page-standort.sg-ds .svc-sub{font-size:14px!important;line-height:1.45!important}
        #page-standort.sg-ds .svc-card .svc-cta{font-size:12px!important}
        #page-standort.sg-ds .sg-merged-cta{padding-top:20px!important;padding-bottom:20px!important}
        #page-standort.sg-ds .related-section{padding-top:30px!important;padding-bottom:30px!important}
      }
    `}</style>}

    {slug === 'st-gallen' && !first30.showCampaign && herbst.show && <HerbstBannerSG />}
    {slug === 'st-gallen' && (first30.showCampaign ? <HeroLaunchSG sitekey={turnstileSitekey} /> : <HeroStandardSG sitekey={turnstileSitekey} />)}
    {slug === 'st-gallen' && !first30.showCampaign && herbst.show && <HerbstSheetSG sitekey={turnstileSitekey} />}
    {/* Seitenende St. Gallen (nach dem Leaf-Body inkl. «Über die Praxis», vor dem Concierge): offenes OneDoc-Widget + zweites Formular. */}
    {slug === 'st-gallen' && !first30.showCampaign && <HeroStandardSG sitekey={turnstileSitekey} teil="ende" slot="body-insert" />}
    <ClinicConcierge slot="pre-footer" locationName={conciergeName} status={conciergeStatus} />
  </SpaPage>
)}
