---
// /standorte/[slug] — faithful 1:1 reproduction of each live SPA standort leaf
// (#page-standort), captured per-slug. Per-slug content (NAP/Anfahrt/ÖV/Parken, map,
// "Unsere Therapien in X", "Beschwerden, die wir in X behandeln", reviews, team) baked in.
import SpaPage from '../../layouts/SpaPage.astro';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/standort-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.keys(leaves).map((p) => {
    const slug = p.split('/').pop().replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] } };
  });
}

const { slug } = Astro.params;
const body = Astro.props.body;
const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
const name = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/TCM\.ch CARE.*?Akupunktur\s*/i, '').replace(/\s+/g, ' ').trim().slice(0, 40) : slug;
const title = `TCM & Akupunktur ${name} – TCM.ch Klinik`;
const description = `TCM & Akupunktur in ${name}: EMR-/ASCA-anerkannt, Krankenkasse 80–100 % über die Zusatzversicherung. Termin oft in 24 Stunden. Anfahrt, Therapien und Team vor Ort.`;
const schema = { '@context': 'https://schema.org', '@type': 'MedicalClinic', name: `TCM.ch ${name}`, url: `https://tcm.ch/standorte/${slug}`, inLanguage: 'de-CH' };
---
<SpaPage title={title} description={description} path={`/standorte/${slug}`} body={body} schema={schema} />
