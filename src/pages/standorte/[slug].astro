---
// /standorte/[slug] - hybrid during the leaf → data-driven migration.
//
//   • Slugs present in src/data/standorte.ts render from the canonical component flow
//     (src/components/standort/*). One template, one section order, per-slug data.
//   • All other slugs still render from their captured leaf (src/data/standort-leaves/*.html)
//     via the legacy path below - unchanged - so no standort is dropped mid-migration.
//
// getStaticPaths still globs the leaves so every existing page keeps building. As each
// slug gains a standorte.ts entry it flips to the data-driven branch; when all are migrated
// the leaves + legacy branch can be deleted.
import SpaPage from '../../layouts/SpaPage.astro';
import HeroLaunchSG from '../../components/HeroLaunchSG.astro';
import HeroStandardSG from '../../components/HeroStandardSG.astro';
import { clinics } from '../../data/locations';
import { prefillStandort } from '../../data/form-prefill';
import homeBody from '../../data/home-body.html?raw';
import { getTherapeut, therapeuten, teamCardHtml, getPublicTherapistProfile } from '../../data/therapeuten';
import { getStandort, standorte } from '../../data/standorte';
import { symptomCards } from '../../data/symptom-cards';
import { hautLinksFor, hautLinksHtml } from '../../data/haut-links';
import { ksLinksFor, ksLinksHtml } from '../../data/koerpersignale-links';
import type { Standort } from '../../data/standorte';
import Hero from '../../components/standort/Hero.astro';
import UspGrid from '../../components/standort/UspGrid.astro';
import Team from '../../components/standort/Team.astro';
import ClinicalLead from '../../components/standort/ClinicalLead.astro';
import { clinicalLeadHtml, clinicalLeadCardHtml } from '../../data/clinical-lead';
import { first30BottomSelectorHtml, first30State } from '../../data/first30';
import { upgradeLegacyForms, clinicById } from '../../lib/kontakt-form';
const first30 = first30State();
import IntroNap from '../../components/standort/IntroNap.astro';
import Therapien from '../../components/standort/Therapien.astro';
import Beschwerden from '../../components/standort/Beschwerden.astro';
import Ablauf from '../../components/standort/Ablauf.astro';
import KrankenkassenTeam from '../../components/standort/KrankenkassenTeam.astro';
import { transparenzHtml } from '../../data/transparenz';
import UeberPraxis from '../../components/standort/UeberPraxis.astro';
import WeitereStandorte from '../../components/standort/WeitereStandorte.astro';
import KontaktForm from '../../components/standort/KontaktForm.astro';
import FinalCta from '../../components/standort/FinalCta.astro';
import KontaktPraxis from '../../components/standort/KontaktPraxis.astro';
import AnfrageKarte from '../../components/standort/AnfrageKarte.astro';
import Faq from '../../components/standort/Faq.astro';

export function getStaticPaths() {
  const leaves = import.meta.glob('../../data/standort-leaves/*.html', { query: '?raw', import: 'default', eager: true });
  const paths = Object.keys(leaves).map((p) => {
    const slug = p.split('/').pop()!.replace('.html', '');
    return { params: { slug }, props: { body: leaves[p] as string } };
  });
  // Voll migrierte Standorte ohne Leaf (z.B. basel): Route kommt allein aus standorte.ts.
  const leafSlugs = new Set(paths.map((x) => x.params.slug));
  for (const s of Object.keys(standorte)) {
    if (!leafSlugs.has(s)) paths.push({ params: { slug: s }, props: { body: '' } });
  }
  return paths;
}

const { slug } = Astro.params;
const migrated = getStandort(slug!);
const url = `https://tcm.ch/standorte/${slug}/`;

// Interne Links in den /haut/-Cluster. Die Standort-Seiten werden täglich gecrawlt,
// die /haut/-Leaves standen dagegen in GSC auf "Gefunden – zurzeit nicht indexiert".
// Rotation über den Slug, damit nicht alle 14 Standorte dieselben sechs Leaves verlinken.
const hautBlock = hautLinksHtml(
  hautLinksFor(slug!, 6),
  'Haut & Gesicht',
  'Haut, Gesicht und was wirklich hilft',
  'Ehrlich erklärt: Wirkstoffe, Behandlungen und was davon realistisch etwas bringt.',
);

// Interne Links in den /koerpersignale/-Cluster. Gleiches Problem wie bei /haut/:
// Die Leaves stehen in GSC auf "URL ist Google nicht bekannt", verweisende Seite: keine.
const ksBlock = ksLinksHtml(
  ksLinksFor(slug! + 'ks', 6),
  'Körpersignale',
  'Wenn der Körper etwas meldet, bevor es einen Namen hat',
  'Schwindel beim Umdrehen, Puls im Ohr, taube Finger: medizinisch eingeordnet, ohne Panikmache.',
);

// Integrierter Physio+TCM-Hinweis nur an Standorten, deren therapien[] Physiotherapie
// führt (Verfügbarkeits-Flag; kein Standort ohne Physio bekommt den Block). Nicht an geplanten / in Prüfung
// stehenden Standorten: «An diesem Standort … verfügbar» wäre dort eine Zusage ohne bestätigten Betrieb.
const physioDachBlock = migrated && !migrated.planned && migrated.therapien?.includes('physiotherapie')
  ? `<section class="section" style="padding:36px 0;background:var(--bg)"><div class="wrap reveal"><div style="background:#fff;border:1px solid var(--border);border-radius:16px;padding:22px 24px;max-width:860px"><div style="font-family:var(--font-sans);font-weight:800;font-size:18px;color:var(--black);margin-bottom:6px">TCM und Physiotherapie unter einem Dach</div><p style="font-size:15px;color:var(--mid);line-height:1.6;margin:0">An diesem Standort sind TCM-Methoden und <a href="/therapien/physiotherapie/" style="color:var(--blue);font-weight:700;text-decoration:none">Physiotherapie</a> verfügbar; je nach Beschwerdebild können sich beide sinnvoll ergänzen, mit einem abgestimmten Plan. Wichtig zur Abrechnung: Physiotherapie läuft mit ärztlicher Verordnung über die Grundversicherung, TCM-Methoden über die Zusatzversicherung. Die Physio-Verfügbarkeit hängt vom Therapieplan der Fachpersonen ab, frag bei der Terminanfrage kurz nach.</p></div></div></section>`
  : '';
const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

let title: string;
let description: string;
let schema: object;
let spaBody = '';
let sgUspHtml = '', sgPraxisHtml = '';

if (migrated) {
  // ── Data-driven branch ──────────────────────────────────────────────
  const data = migrated;
  const stadt = data.stadt;
  const clinic = clinics.find((c) => c.id === slug);
  title = data.seo?.title ?? `TCM & Akupunktur ${data.titelZusatz ?? stadt} | TCM.ch`;
  description = data.seo?.description ?? `TCM & Akupunktur in ${stadt}: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin direkt anfragen.`;
  // MedicalClinic fed from nap/geo; opening hours + areaServed from the clinic NAP record.
  const medClinic: Record<string, unknown> = {
    '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': url,
    name: data.seo?.schemaName ?? `TCM.ch ${stadt}`, url, inLanguage: 'de-CH', medicalSpecialty: 'TraditionalChineseMedicine',
    telephone: data.nap.telefon,
    memberOf: { '@type': 'MedicalOrganization', name: 'TCM.ch', url: 'https://tcm.ch/' },
  };
  if (data.nap.strasse) medClinic.address = { '@type': 'PostalAddress', streetAddress: data.nap.strasse, postalCode: data.nap.plz, addressLocality: data.nap.ort, addressCountry: 'CH' };
  // Geplante Standorte: Status auch in den strukturierten Daten, keine Verfügbarkeits-Claims.
  if (data.planned) medClinic.description = `TCM-Praxis in Vorbereitung an der ${data.nap.strasse}, ${data.nap.ort}. Anfragen für den geplanten Start sind bereits möglich.`;
  if (data.nap.geo) medClinic.geo = { '@type': 'GeoCoordinates', latitude: data.nap.geo.lat, longitude: data.nap.geo.lng };
  if (clinic?.openingHours?.length) medClinic.openingHours = clinic.openingHours;
  if (clinic?.areaServed?.length) medClinic.areaServed = clinic.areaServed.map((a) => ({ '@type': 'City', name: a }));
  // Partnerpraxis: Schema beschreibt die reale Entität der Betreiberin (Name, URL, Praxistelefon) statt
  // einer zweiten «TCM.ch»-Klinik; TCM.ch nur als Netzwerk (memberOf). Gleiche @id auf DE und EN.
  if (data.betreiber) {
    Object.assign(medClinic, {
      '@id': `${data.betreiber.url}#praxis`, name: data.betreiber.name, url: data.betreiber.url,
      telephone: data.betreiber.telefon, sameAs: [data.betreiber.url],
      memberOf: { '@id': 'https://tcm.ch/#org' },
      brand: { '@type': 'Brand', name: data.betreiber.marke },
    });
  }
  const breadcrumb = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      ...(slug!.startsWith('zuerich-') ? [{ '@type': 'ListItem', position: 3, name: 'Zürich', item: 'https://tcm.ch/akupunktur-tcm-zuerich/' }] : []),
      { '@type': 'ListItem', position: slug!.startsWith('zuerich-') ? 4 : 3, name: stadt, item: url },
    ],
  };
  // Betriebsstatus in Prüfung: kein MedicalClinic-Knoten (keine bestätigte Praxis an dieser Adresse).
  schema = data.review ? [breadcrumb] : [medClinic, breadcrumb];
  if (data.faqs?.length) {
    (schema as object[]).push({ '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
  }
} else {
  // ── Legacy leaf branch (verbatim from the pre-refactor template) ─────
  const body = Astro.props.body;
  const clinic = clinics.find((c) => c.id === slug);
  const nm = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>/);
  const hName = nm ? nm[1].replace(/<[^>]+>/g, '').replace(/TCM\.ch CARE.*?Akupunktur\s*/i, '').replace(/\s+/g, ' ').trim().slice(0, 40) : slug!;
  const name = clinic ? clinic.name : hName;
  const isPartner = slug === 'bottighofen';
  title = isPartner
    ? 'TCM Pelican Bottighofen: Akupunktur & TCM am Bodensee | TCM.ch'
    : slug === 'st-gallen'
      ? 'Akupunktur & TCM St. Gallen | TCM.ch'
      : `TCM & Akupunktur ${name} | TCM.ch`;
  description = isPartner
    ? 'TCM Pelican in Bottighofen: Akupunktur, Tuina und TCM, EMR-anerkannt, gut erreichbar bei Kreuzlingen am Bodensee. Partnerklinik im TCM.ch Netzwerk.'
    : slug === 'st-gallen'
      ? 'Akupunktur & TCM in St. Gallen beim Bahnhof: EMR-/ASCA-anerkannt, Zusatzversicherung je nach Police. Termin direkt anfragen.'
      : `TCM & Akupunktur in ${name}: EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Termin direkt anfragen.`;

  const medClinic: Record<string, unknown> = {
    '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': url,
    name: clinic?.schemaName ?? `TCM.ch ${name}`, url, inLanguage: 'de-CH', medicalSpecialty: 'TraditionalChineseMedicine',
  };
  if (clinic) {
    medClinic.telephone = clinic.phone;
    if (clinic.street) medClinic.address = { '@type': 'PostalAddress', streetAddress: clinic.street, postalCode: clinic.postalCode, addressLocality: clinic.city, addressCountry: 'CH' };
    if (clinic.geo) medClinic.geo = { '@type': 'GeoCoordinates', latitude: clinic.geo.lat, longitude: clinic.geo.lng };
    if (clinic.openingHours?.length) medClinic.openingHours = clinic.openingHours;
    if (clinic.areaServed?.length) medClinic.areaServed = clinic.areaServed.map((a) => ({ '@type': 'City', name: a }));
  }
  const breadcrumb = {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name, item: url },
    ],
  };
  schema = [medClinic, breadcrumb];

  function endOfDiv(html: string, i: number) { const rx = /<div\b|<\/div>/g; rx.lastIndex = i; let d = 0; let m: RegExpExecArray | null; while ((m = rx.exec(html))) { if (m[0] === '</div>') { d--; if (d === 0) return m.index + 6; } else d++; } return html.length; }
  let outBody = body;
  if (slug === 'st-gallen') {
    // Lokales Team ausschliesslich aus den kanonischen Zuordnungen therapeuten[].standorte[]
    // (gleiche Quelle wie Team.astro und EN Practitioners.astro; Gate check-clinic-status 4i).
    // Keine hartcodierte Slug-Liste, kein stiller Fallback: fehlt der Grid-Marker, bricht der Build ab.
    const tg0 = outBody.indexOf('<div class="team-grid">');
    if (tg0 < 0) throw new Error('st-gallen: team-grid-Marker für die kanonischen Teamkarten nicht gefunden - Leaf geändert?');
    const cards = therapeuten
      .filter((t) => t.standorte?.includes('st-gallen'))
      .map((t) => teamCardHtml(getPublicTherapistProfile(t)))
      .join('')
      // Schmale Mobile-Karten: bedingte Trennstellen nur im sichtbaren Titel-/Namenstext (nicht in alt/aria-label),
      // damit lange Wörter sauber mit Trennstrich statt mitten im Wort umbrechen.
      .replace(/(<div class="tmc-(?:title|name)">)([^<]*)(<\/div>)/g, (_m, a: string, txt: string, b: string) =>
        a + txt.replace(/Naturheilpraktikerin/g, 'Naturheil&shy;praktikerin').replace(/Lenggenhager/g, 'Lenggen&shy;hager') + b);
    if (!cards) throw new Error('st-gallen: keine Therapeut:innen mit standorte[] st-gallen in therapeuten.ts');
    // Ein einheitliches Teamraster: klinische Leitung (netzwerkweit, eigener Marker, keine .tmc-Karte) zuerst,
    // danach die lokalen Karten; die separate Clinical-Lead-Sektion entfällt für St. Gallen.
    const leadCard = clinicalLeadCardHtml('st-gallen');
    if (!leadCard) throw new Error('st-gallen: Clinical-Lead-Karte leer - clinics/therapeuten prüfen');
    outBody = outBody.slice(0, tg0) + '<div class="team-grid sg-team-grid">' + leadCard + cards + '</div>' + outBody.slice(endOfDiv(outBody, tg0));
  }
  if (slug === 'bottighofen') {
    const emanuela = getTherapeut('emanuela-pelican');
    const card = emanuela ? teamCardHtml(getPublicTherapistProfile(emanuela)) : '';
    const ph = outBody.indexOf('<div style="display:grid;grid-template-columns:1fr;gap:16px;margin:20px 0;max-width:300px">');
    if (card && ph >= 0) outBody = outBody.slice(0, ph) + '<div class="team-grid bf-therapist" style="max-width:360px;margin:20px 0">' + card + '</div>' + outBody.slice(endOfDiv(outBody, ph));
    const hg0 = homeBody.indexOf('<div class="svc-grid">');
    const homeGrid = hg0 >= 0 ? homeBody.slice(hg0, endOfDiv(homeBody, hg0)) : '';
    const lg0 = outBody.indexOf('<div class="svc-grid">');
    if (homeGrid && lg0 >= 0) outBody = outBody.slice(0, lg0) + homeGrid + outBody.slice(endOfDiv(outBody, lg0));
  }

  // "Häufige Beschwerden" für die Legacy-Leaves - gleiches Schema wie Beschwerden.astro
  // (Basis-Set + Rotation, unique Listen, Anker-Mix), bis diese Slugs migriert sind.
  const LEGACY_BESCHWERDEN: Record<string, { stadt: string; intro: string; slugs: string[] }> = {
    'zuerich-city': { stadt: 'Zürich', intro: 'Ein Überblick über die Beschwerden, die wir in Zürich am häufigsten behandeln. Details zu Ablauf und Kosten stehen auf den einzelnen Seiten.', slugs: ['rueckenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'kinderwunsch', 'wechseljahre', 'endometriose', 'knieschmerzen'] },
    bottighofen: { stadt: 'Bottighofen', intro: 'Womit kommen die Leute in Bottighofen zu uns? Meistens mit einem dieser Themen. Jede Seite erklärt, was die TCM realistisch leisten kann.', slugs: ['rueckenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'kinderwunsch', 'tinnitus', 'wechseljahre'] },
  };
  const lb = LEGACY_BESCHWERDEN[slug!];
  const beschwerdenLinks = lb
    ? `<section class="section cl-related" style="background:var(--surface)"><div class="wrap reveal"><div class="section-label">Beschwerden</div><h2 class="section-title">Häufige Beschwerden in ${lb.stadt}</h2><p class="section-sub">${lb.intro}</p><div class="cl-links">${lb.slugs.map((s, i) => `<a href="/beschwerden/${s}/" class="cl-chip">${i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei ${symptomCards[s]?.name ?? s}</a>`).join('')}</div></div></section>`
    : '';
  const filledBody = prefillStandort(outBody, name)
    .replace('<!--transparenz-->', transparenzHtml(slug!))
    .replace(
      /<button type="button" class="btn-primary" onclick="openTerminForm\(\)" style="width:100%;justify-content:center;margin-bottom:10px;display:flex">([\s\S]*?)<\/button>/,
      `<a href="?standort=${encodeURIComponent(name)}" class="btn-primary" style="width:100%;justify-content:center;margin-bottom:10px;display:flex">$1</a>`,
    )
    .replace(
      '<button type="button" class="btn-white" onclick="openTerminForm()" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</button>',
      '<a href="#kontakt" class="btn-white" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termin anfragen</a>',
    )
    .replace(
      '<section class="section contact-section-inline" style="background:var(--surface)">',
      '<section id="kontakt" class="section contact-section-inline" style="scroll-margin-top:68px;background:var(--surface)">',
    );

  // OneDoc-Buchungswidget (nur St. Gallen): offizielles JS-Embed (Höhe steuert das Widget
  // per postMessage selbst), GA4 direkt via measurementIds - kein eigenes Blur-Tracking mehr.
  const onedocSection = `<section class="section" id="online-buchen" style="scroll-margin-top:68px;background:var(--surface)"><div class="wrap reveal" style="max-width:820px"><div class="section-label">Online-Buchung</div><h2 class="section-title">Oder direkt <em>online buchen</em></h2><p class="section-sub">Wähle direkt einen freien Termin bei Corinna Reinhart – Bestätigung sofort per E-Mail. Frage vorher? <a href="https://wa.me/41775236122?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Behandlung%20in%20St.%20Gallen." target="_blank" rel="noopener" style="color:var(--blue);font-weight:700;text-decoration:none">Per WhatsApp</a></p><script>var widgetConfigs=widgetConfigs||{};widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"]={},widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"].measurementIds=["G-NHZ8Y6V840"],widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"].hasGoogleTagTracking=!0,widgetConfigs["7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"].hasFusedeck=!1,window.addEventListener("message",(function(e){var t=e.data["od-widget-id"],i=e.data["od-widget-height"],d=e.data["od-widget-ios"];if(t&&t in widgetConfigs&&"7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794"===t){var a=document.getElementById("od-widget-"+t);i&&(a.style.height=i+"px"),!0===d&&(a.style.width="100px",a.style["min-width"]="100%",a.scrolling="no");var g=e.data["od-tracking-configs"];void 0!==g&&(widgetConfigs[t].measurementIds=g);var o=e.data["od-has-google-tag-manager"];void 0!==o&&(widgetConfigs[t].hasGoogleTagTracking=o);var f=e.data["od-has-fusedeck"];void 0!==f&&(widgetConfigs[t].hasFusedeck=f);var n=e.data.GA4;if(widgetConfigs[t].hasGoogleTagTracking&&window.dataLayer&&n){var s=Object.keys(n.properties),r={event:n.name};s.forEach((function(e){r[e]=n.properties[e]})),dataLayer.push(r)}if(widgetConfigs[t].hasFusedeck&&window.fdData&&n){var s=Object.keys(n.properties),r={event:n.name};s.forEach((function(e){r[e]=n.properties[e]})),fdData.push(r)}if(n&&void 0!==window.gtag)for(var w=0;w<widgetConfigs[t].measurementIds.length;w++){var f=widgetConfigs[t].measurementIds[w],c=(s=Object.keys(n.properties),{send_to:f});s.forEach((function(e){c[e]=n.properties[e]})),gtag("event",n.name,c)}}})),window.addEventListener("load",(function(e){for(var t=document.querySelectorAll("iframe.od-widget"),i=0;i<t.length;i++){var d=t[i];d.dataset&&d.dataset.src&&(d.src=d.dataset.src)}}));</script><iframe class="od-widget" id="od-widget-7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794" src="about:blank" data-src="https://www.onedoc.ch/de/widget/7a0d6d1be45b44d5cbe90243187f9e7c30949c5dd23682bf770e7b5808674794" frameborder="0" style="width:100%;max-width:1024px;height:400px"></iframe></div></section>`;
  // St. Gallen (15.10.2026): Beschwerden als Startseiten-Karten (svc-card/svc-grid) + eine CTA aufs SG-Formular.
  const SG_BESCHWERDEN = ['rueckenschmerzen', 'nackenschmerzen', 'migraene', 'schlafprobleme', 'stress-burnout', 'verdauungsprobleme', 'zyklusbeschwerden', 'kinderwunsch'];
  const escH = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const svcArrow = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
  // FAQ «Fragen zu deinem ersten Termin» (ersetzt den Ablauf-Block; bestehendes kk-faq-Accordion, kkToggle in home.js;
  // nur belegte SG-Angaben, kein FAQ-Schema). Steht direkt vor dem Kontaktformular.
  const sgFaqHtml = slug === 'st-gallen'
    ? '<section class="kk-section" id="sg-faq" aria-labelledby="sg-faq-h"><div class="wrap"><div class="kk-inner"><div class="kk-header reveal"><div class="section-label">Häufige Fragen</div><h2 class="section-title" id="sg-faq-h">Fragen zu deinem ersten Termin</h2></div><div class="kk-faq"><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q1" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a1">Was kostet mein erster Termin?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a1" role="region" aria-labelledby="sg-faq-q1"><p>Abgerechnet wird nach Tarif 590, also nach Dauer. Weil beim ersten Termin die Anamnese Zeit braucht, liegt er über einer Folgesitzung. Den konkreten Betrag nennen wir dir vorab, bevor behandelt wird. Mehr dazu unter <a href="/akupunktur-st-gallen-kosten/">Kosten und Krankenkasse in St. Gallen</a>.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q2" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a2">Übernimmt meine Zusatzversicherung die Behandlung?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a2" role="region" aria-labelledby="sg-faq-q2"><p>Das hängt von deiner Police und der Anerkennung der behandelnden Fachperson ab. Eine Kostenübernahme können wir nicht pauschal zusagen. Nenn uns bei der Anfrage deine Krankenkasse, dann unterstützen wir dich bei der Abklärung vor dem Ersttermin. Den Überblick findest du unter <a href="/krankenkassen/">Krankenkasse und Kosten</a>.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q3" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a3">Wird beim ersten Termin bereits behandelt?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a3" role="region" aria-labelledby="sg-faq-q3"><p>Meist ja. Zuerst nehmen wir uns Zeit für ein ausführliches Gespräch und die TCM-Diagnostik nach Puls und Zunge. Ist eine Behandlung fachlich sinnvoll, beginnen wir direkt damit. <a href="/gesundheitsbibliothek/fragen/was-passiert-beim-ersten-termin/">Was beim ersten Termin passiert</a></p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q4" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a4">Brauche ich eine ärztliche Überweisung?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a4" role="region" aria-labelledby="sg-faq-q4"><p>Nein. Du kannst direkt einen Termin anfragen, für die TCM-Behandlung brauchst du keine ärztliche Überweisung. Gehört dein Anliegen zuerst ärztlich abgeklärt, sagen wir dir das ehrlich.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q5" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a5">Gibt es Abend- oder Samstagstermine?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a5" role="region" aria-labelledby="sg-faq-q5"><p>Die Praxis ist Montag bis Samstag von 07:30 bis 19:30 Uhr geöffnet, sonntags von 08:00 bis 17:00 Uhr. Ob zu deiner Wunschzeit ein Termin frei ist, klären wir bei der Anfrage. Trag dafür im Formular deine Wunschzeit ein oder schau in der <a href="#online-buchen">Online-Buchung</a> nach.</p></div></div><div class="kk-item"><button type="button" class="kk-q" id="sg-faq-q6" onclick="kkToggle(this)" aria-expanded="false" aria-controls="sg-faq-a6">Was soll ich zum ersten Termin mitbringen?<span class="kk-ico" aria-hidden="true">+</span></button><div class="kk-a" id="sg-faq-a6" role="region" aria-labelledby="sg-faq-q6"><p>Du musst nichts vorbereiten. Bring, falls vorhanden, bisherige Befunde oder eine Liste deiner Medikamente mit. Mehr zum Ablauf unter <a href="/wissen/tcm-st-gallen-erfahrungen-ablauf/">Erfahrungen und Ablauf in St. Gallen</a>.</p></div></div></div></div></div></section>'
    : '';
  const sgBeschwerdenHtml = slug === 'st-gallen'
    ? '<section class="section svc-section" id="sg-beschwerden" style="background:var(--surface)"><div class="wrap">' +
      '<div class="svc-header reveal"><div><div class="section-label">Beschwerden</div><h2 class="section-title">Wobei können wir <em>helfen</em>?</h2></div>' +
      '<p class="svc-sub">Häufige Beschwerden, bei denen Akupunktur und TCM eingesetzt werden.</p></div><div class="svc-grid">' +
      SG_BESCHWERDEN.map((s) => {
        const c = symptomCards[s];
        if (!c) throw new Error(`st-gallen: symptomCards.${s} fehlt`);
        return `<a class="svc-card reveal" href="/beschwerden/${s}/" style="text-decoration:none;color:inherit"><div class="svc-photo-wrap"><img width="1120" height="746" src="${c.img}" alt="${escH(c.name)}" class="svc-photo" loading="lazy" decoding="async"><div class="svc-photo-top-bar"></div></div><div class="svc-body"><div class="svc-name">${escH(c.name)}</div><div class="svc-tagline">${escH(c.tagline)}</div><div class="svc-cta">Mehr erfahren ${svcArrow}</div></div></a>`;
      }).join('') +
      '</div><div class="sg-bs-cta reveal"><a href="#kontakt" class="btn-primary tcm-btn tcm-btn--primary tcm-btn--lg">Termin in St. Gallen anfragen <span aria-hidden="true">→</span></a></div></div></section>'
    : '';
  const sgWlLinks = ksLinksFor(slug! + 'ks', 6);
  const sgWeiterlesenHtml = slug === 'st-gallen'
    ? '<section class="section sg-weiterlesen" id="sg-weiterlesen"><div class="wrap"><div class="sg-wl" role="navigation" aria-labelledby="sg-wl-h"><h2 class="sg-wl-label" id="sg-wl-h">Weiterlesen</h2>' +
      sgWlLinks.map((l) => `<a href="/koerpersignale/${l.slug}/">${escH(l.label)}</a>`).join('') +
      '<a href="/koerpersignale/" class="sg-wl-all">Alle Körpersignale <span aria-hidden="true">→</span></a></div></div></section>'
    : '';
  // Netzwerkweite klinische Leitung (src/data/clinical-lead.ts): St. Gallen direkt nach dem lokalen
  // Team-Block (fehlender Team-Marker bricht den Build ab), andere Legacy-Leaves siehe unten.
  const leadHtml = clinicalLeadHtml(slug!);
  let sgBody = filledBody;
  if (slug === 'st-gallen') {
    // Reihenfolge: Therapien -> Team -> Beschwerden-Karten (Startseiten-Komponente svc-card, 8 Kernthemen aus
    // symptom-cards.ts in Startseiten-Reihenfolge, inkl. CTA). Im Leaf folgt die Therapie-Sektion direkt aufs Team.
    const ti = sgBody.indexOf('<section class="section" id="team-st-gallen"');
    if (ti < 0) throw new Error('st-gallen: Team-Marker für die Beschwerden-Karten nicht gefunden - Leaf geändert?');
    const thi = sgBody.indexOf('<section', ti + 1);
    const the = sgBody.indexOf('</section>', thi) + 10;
    const thSec = sgBody.slice(thi, the);
    if (!thSec.startsWith('<section class="section svc-section">') || !thSec.includes('Unsere <em>Therapien</em> in St. Gallen') || !thSec.includes('id="sg-more-therapien-btn"'))
      throw new Error('st-gallen: Therapie-Sektion folgt nicht direkt auf das Team - Leaf geändert?');
    sgBody = sgBody.slice(0, ti) + thSec + sgBody.slice(ti, thi) + sgBeschwerdenHtml + sgBody.slice(the);
    // FIRST 30 (nur solange der Kampagnen-Hero gezeigt wird): Angebots-Wähler ÜBER dem unteren Kontaktformular und
    // Leaf-CTAs auf das Geschenk umgestellt. Geschlossene Kampagne = Leaf unverändert (reguläre CTAs → #offer-form).
    if (first30.showCampaign) {
      const bc = '<div class="inline-form-card">';
      const bi = sgBody.indexOf(bc);
      if (bi < 0) throw new Error('st-gallen: inline-form-card-Marker für den FIRST-30-Wähler nicht gefunden - Leaf geändert?');
      sgBody = sgBody.slice(0, bi) + first30BottomSelectorHtml() + sgBody.slice(bi);
      const giftLabel = first30.campaign === 'soldout-waitlist' ? 'FIRST 30 Warteliste' : 'FIRST 30 Geschenk anfragen';
      sgBody = sgBody
        .split('<a href="#offer-form" class="btn-primary">Ersttermin anfragen</a>').join(`<a href="#kontakt" class="btn-primary" data-offer="first30">${giftLabel}</a>`)
        .split('<a href="#offer-form" class="sgcta-free">Ersttermin anfragen</a>').join(`<a href="#kontakt" class="sgcta-free" data-offer="first30">${giftLabel}</a>`);
    }
    // Gemeinsames Kontaktformular (15.10.2026) ersetzt die untere Leaf-Karte (#kontakt); Hero-Formular: HeroStandardSG.
    // Bestehende Identifier: quelle=sg-kontakt-bottom, Wunschzeit; Anker #kontakt (Sektion) + #first30-kontakt (alte Links).
    sgBody = upgradeLegacyForms(sgBody, { path: '/standorte/st-gallen/', standortId: 'st-gallen', instancePrefix: 'sg-unten',
      extra: { wunschzeit: true, compatAnchors: ['first30-kontakt'], onedocBeideTerminarten: true, ruhig: true, ohneOnedocAlternative: true, zusatzOffen: true } });
    if ((sgBody.match(/data-kf-instance="sg-unten"/g) || []).length !== 1 || /<form class="inline-form"/.test(sgBody))
      throw new Error('st-gallen: untere Kontaktkarte nicht eindeutig auf das gemeinsame Formular umgestellt - Leaf geändert?');
    // Praxisfoto in «Über die Praxis»: der FIRST-30-Hero hat keine Fotohälfte, der reguläre Hero zeigt seit dem
    // gemeinsamen Hero-Video (HeroMedia) das Foto nur noch als Poster. Markup wie praxisBilder in UeberPraxis.astro.
    const uh = '<h2 class="up-h2">Über die Praxis</h2>';
    const ui = sgBody.indexOf(uh);
    if (ui < 0) throw new Error('st-gallen: Über-die-Praxis-Marker für das Praxisfoto nicht gefunden - Leaf geändert?');
    sgBody = sgBody.slice(0, ui + uh.length) + '<figure style="margin:0 0 22px;border-radius:var(--r-card);overflow:hidden;box-shadow:var(--sh-md);position:relative"><img src="/images/standort-stgallen.webp" srcset="/images/standort-stgallen-800.webp 800w, /images/standort-stgallen.webp 1447w" sizes="(max-width:1023px) 100vw, 720px" alt="TCM.ch St. Gallen – Empfangsbereich, Oberer Graben 22" width="1447" height="1087" loading="lazy" decoding="async" style="width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;display:block"><figcaption style="position:absolute;left:10px;bottom:10px;background:rgba(255,255,255,.92);color:var(--charcoal);font-family:var(--font-sans);font-size:12.5px;font-weight:700;padding:5px 11px;border-radius:999px">Oberer Graben 22</figcaption></figure>' + sgBody.slice(ui + uh.length);
    const h0 = sgBody.indexOf('<div id="standort-flagship-hero"');
    const c0 = sgBody.indexOf('<div id="standort-content">');
    if (h0 >= 0 && c0 > h0) sgBody = sgBody.slice(0, h0) + sgBody.slice(c0);
    // OneDoc-Widget als sekundäre Buchungs-Sektion DIREKT NACH dem Kontaktformular (CRO: Formular = Primär,
    // Buchung = Sekundär); Hero/Sticky-Anker #online-buchen zeigen weiterhin hierher.
    const kontaktMarker = '<section id="kontakt" class="section contact-section-inline"';
    const fi = sgBody.indexOf(kontaktMarker);
    if (fi < 0) throw new Error('st-gallen: Kontakt-Marker für die FAQ nicht gefunden - Leaf geändert?');
    sgBody = sgBody.slice(0, fi) + sgFaqHtml + sgBody.slice(fi);
    const ki = sgBody.indexOf(kontaktMarker);
    const ke = ki >= 0 ? sgBody.indexOf('</section>', ki) : -1;
    // Kein stiller Fallback: fehlt der Kontakt-Marker, bricht der Build ab, statt das
    // OneDoc-Widget an einer falschen Position auszuliefern (CRO-L2.1 Injektions-Guard).
    if (ke < 0) throw new Error('st-gallen: Kontakt-Marker für OneDoc-Injektion nicht gefunden - Leaf geändert?');
    // OneDoc direkt nach dem Formular, danach nur noch der kompakte Weiterlesen-Bereich (15.10.2026:
    // Beschwerden-Chips und Haut-Block entfallen, Körpersignale als Textlinks statt Grosssektion).
    sgBody = sgBody.slice(0, ke + 10) + onedocSection + sgWeiterlesenHtml + sgBody.slice(ke + 10);
    // Regulärer Hero (16.10.2026): USP-Reihe und «Über die Praxis» werden aus dem Leaf VERSCHOBEN (nicht kopiert) und von
    // HeroStandardSG direkt unter dem Hero gerendert: USPs kompakt, Praxisangaben neben der Buchungsbox.
    // Die USP-CTA-Wiederholung (#offer-form / #online-buchen) entfällt, die Box folgt unmittelbar.
    if (!first30.showCampaign) {
      const us0 = sgBody.indexOf('<section class="usp-grid-section"');
      const us1 = us0 >= 0 ? sgBody.indexOf('</section>', us0) + 10 : -1;
      const usSec = us0 >= 0 ? sgBody.slice(us0, us1) : '';
      const ug = usSec.indexOf('<div class="usp-grid">');
      if (ug < 0 || (usSec.match(/class="usp-card"/g) || []).length !== 3 || !usSec.includes('class="sg-cta-repeat"'))
        throw new Error('st-gallen: USP-Sektion (3 Karten + CTA-Wiederholung) nicht gefunden - Leaf geändert?');
      sgUspHtml = usSec.slice(ug, endOfDiv(usSec, ug));
      sgBody = sgBody.slice(0, us0) + sgBody.slice(us1);
      const up0 = sgBody.indexOf('<section class="up-sec"><div class="up-wrap">');
      const up1 = up0 >= 0 ? sgBody.indexOf('</div></section>', up0) : -1;
      if (up1 < 0 || !sgBody.slice(up0, up1).includes(uh) || /<section/.test(sgBody.slice(up0 + 8, up1)))
        throw new Error('st-gallen: Über-die-Praxis-Sektion nicht eindeutig gefunden - Leaf geändert?');
      sgPraxisHtml = sgBody.slice(up0 + '<section class="up-sec"><div class="up-wrap">'.length, up1);
      sgBody = sgBody.slice(0, up0) + sgBody.slice(up1 + '</div></section>'.length);
    }
  }
  // Andere Legacy-Leaves (Bottighofen): Block vor dem Kontaktformular, sonst vor den Beschwerden-Links.
  const km = filledBody.indexOf('<section id="kontakt" class="section contact-section-inline"');
  const legacyBody0 = km >= 0 ? filledBody.slice(0, km) + leadHtml + filledBody.slice(km) : filledBody + leadHtml;
  // Gemeinsames Kontaktformular auch auf den übrigen Legacy-Leaves (Bottighofen): fester Standort, wenn operativ.
  const legacyClinic = clinicById(slug!);
  const legacyBody = upgradeLegacyForms(legacyBody0, { path: `/standorte/${slug}/`, standortId: legacyClinic?.status === 'operational' ? slug : undefined, instancePrefix: 'standort' });
  spaBody = (slug === 'st-gallen') ? sgBody : legacyBody + beschwerdenLinks + hautBlock + ksBlock;
}

const data = migrated as Standort;
// Kompakte weiterführende Links (SG «Weiterlesen»): dieselben Haut- und Körpersignale-Links wie die bisherigen Blöcke.
const escL = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const weiterlesenHtml = '<section class="section sg-weiterlesen" id="weiterlesen"><div class="wrap"><div class="sg-wl" role="navigation" aria-labelledby="std-wl-h"><h2 class="sg-wl-label" id="std-wl-h">Weiterlesen</h2>' +
  hautLinksFor(slug!, 6).map((l) => `<a href="/haut/${l.slug}/">${escL(l.label)}</a>`).join('') +
  '<a href="/haut/" class="sg-wl-all">Alle Themen zu Haut &amp; Gesicht <span aria-hidden="true">→</span></a>' +
  ksLinksFor(slug! + 'ks', 6).map((l) => `<a href="/koerpersignale/${l.slug}/">${escL(l.label)}</a>`).join('') +
  '<a href="/koerpersignale/" class="sg-wl-all">Alle Körpersignale <span aria-hidden="true">→</span></a></div></div></section>';
---
{migrated ? (
  <SpaPage title={title} description={description} path={`/standorte/${slug}`} body="" schema={schema}>
    {/* Wie St. Gallen (HeroStandardSG): Hero und Kontakt-/Praxisbereich vor #page-standort, damit dort weder die
        seitenweiten Karten-/Abstandsregeln ([id^="page-"] …) noch die Hero-Geschwisterregel (#sg-premium-hero ~ section) greifen. */}
    <Hero data={data} />
    <div class="std-oben">
      {data.planned && (
      <section class="section" data-status-banner={data.review ? 'review' : 'planned'} style="padding:0;background:var(--bg)">
        <div class="wrap" style="padding-top:12px">
          <div style="background:var(--green-mint);border:1px solid var(--green-mid);border-radius:14px;padding:16px 20px">
            <div style="font-family:var(--font-sans);font-weight:800;font-size:15.5px;color:var(--black);margin-bottom:3px">{data.plannedTitle ?? 'Standort in Vorbereitung'}</div>
            {data.plannedNote
              ? <div class="content-body" style="font-size:14.5px;color:var(--mid);line-height:1.55" set:html={data.plannedNote} />
              : <div style="font-size:14.5px;color:var(--mid);line-height:1.55">Die Praxis in {data.stadt} ist noch nicht eröffnet. Du kannst dein Anliegen bereits jetzt anfragen – wir melden uns, sobald Termine möglich sind. Bis dahin behandeln wir dich gerne an einem unserer anderen Standorte.</div>}
          </div>
        </div>
      </section>
      )}
      {/* SG-Reihenfolge: USP kompakt → Praxisangaben links / Anfragebox rechts (mobil Box zuerst) → Hinweis →
          Therapien → Team → Beschwerden → Transparenz → Krankenkasse → lokale Inhalte → Praxen in der Nähe →
          WhatsApp → FAQ → unteres Formular → Weiterlesen. */}
      <KontaktPraxis id="standort-kontakt-praxis" uspLabel={`Darum TCM.ch ${data.stadt}`}>
        <UspGrid slot="usp" planned={data.planned} review={data.review} />
        <div slot="form" data-std-box-oben><AnfrageKarte data={data} sitekey={turnstileSitekey} oben /></div>
        <UeberPraxis slot="info" data={data} inner />
      </KontaktPraxis>
    </div>
    <div class="page active std-ds std-vorlage" id="page-standort" style="display:block">
      <div id="standort-content">
        <section class="section std-hinweis" style="padding:20px 0 0 !important;background:var(--bg)"><div class="wrap"><div style="background:var(--green-mint);border:1px solid var(--green-mid);border-radius:16px;padding:20px 22px"><div style="font-family:var(--font-sans);font-weight:800;font-size:clamp(17px,3.4vw,21px);color:var(--black);line-height:1.25;margin-bottom:6px">Keine Ahnung, wo du anfangen sollst? Dafür sind wir da.</div><div style="font-size:14.5px;color:var(--mid);line-height:1.55;max-width:70ch">Du musst nicht wissen, welche Therapie du brauchst. {data.planned ? 'Schreib uns' : 'Komm vorbei'}, wir finden es gemeinsam heraus und nehmen dir den Rest ab.</div></div></div></section>
        {data.aufEinenBlick && <Fragment set:html={data.aufEinenBlick} />}
        <Therapien data={data} />
        {physioDachBlock && <Fragment set:html={physioDachBlock} />}
        {!data.planned && !data.review && <Team data={data} />}
        <ClinicalLead slug={data.slug} />
        <Beschwerden data={data} />
        {data.ablaufBlock && <Ablauf />}
        <Fragment set:html={transparenzHtml(data.slug, data.planned, data.review)} />
        <KrankenkassenTeam data={data} />
        <IntroNap data={data} />
        {data.extraBlock && <Fragment set:html={data.extraBlock} />}
        <WeitereStandorte data={data} />
        <FinalCta data={data} />
        <Faq data={data} />
        <KontaktForm data={data} sitekey={turnstileSitekey} />
        <Fragment set:html={weiterlesenHtml} />
      </div>
    </div>
  </SpaPage>
) : (
  <SpaPage title={title} description={description} path={`/standorte/${slug}`} body={spaBody} schema={schema}>
    {slug === 'st-gallen' && (first30.showCampaign ? <HeroLaunchSG sitekey={turnstileSitekey} /> : <HeroStandardSG sitekey={turnstileSitekey} uspHtml={sgUspHtml} praxisHtml={sgPraxisHtml} />)}
  </SpaPage>
)}
