---
// /standorte/bern/ - kommerzieller Bern-Owner auf dem Luzern-Template,
// im Markteintritts-Modus (Standort in Vorbereitung, Adresse noch offen).
//
// Abweichungen zum offenen Standort-Template, bewusst und nur wegen Vorbereitung:
//   • Termininteresse-Formular (quelle=warteliste-bern) statt Termin-Buchung
//   • KEIN MedicalClinic-Schema (erst mit Adresse), nur BreadcrumbList + FAQPage
//   • keine Adress-/Karten-Sektion, keine Öffnungszeiten, keine Team-Karten
//     (Team im Aufbau, kein produktionsreifes öffentliches Profil)
//   • KEIN Eröffnungsdatum, keine Lage-Claims (Bahnhof/Parking) vor Mietvertrag
//   • keine Reviews (es gibt kein Berner Review-Korpus; Netzwerk-Proof nur als
//     Netzwerk-Aussage im Trust-Band)
// Statischer Pfad, deshalb greift standorte/[slug].astro hier nicht (Bern ist nicht in standorte.ts).
export const prerender = true;
import SpaPage from '../../../layouts/SpaPage.astro';
import { symptomCards } from '../../../data/symptom-cards';
import { therapyCards } from '../../../data/therapy-cards';

const url = 'https://tcm.ch/standorte/bern/';
const title = 'Akupunktur & TCM Bern | TCM.ch';
const description =
  'TCM.ch kommt nach Bern: Akupunktur und Traditionelle Chinesische Medizin, EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Jetzt Interesse anmelden.';

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

const beschwerden = ['rueckenschmerzen', 'nackenschmerzen', 'migraene', 'schulterschmerzen', 'stress-burnout', 'schlafstoerungen', 'verdauungsprobleme', 'knieschmerzen']
  .map((slug) => ({ slug, c: symptomCards[slug] }))
  .filter((x) => x.c);
// Anchor-Texte alternieren "Akupunktur bei X" / "TCM bei X", wie in Beschwerden.astro.
const anchor = (i: number, name: string) => `${i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei ${name}`;

// Therapien-Grid: bewusst nur das Kern-Spektrum - der definitive Behandlungsumfang
// für Bern steht erst mit der Eröffnung fest (kein Service-Versprechen erfinden).
const therapien = ['akupunktur', 'schroepfen', 'tuina', 'akupressur']
  .map((slug) => ({ slug, c: therapyCards[slug], tagline: therapyCards[slug]?.tagline }))
  .filter((x) => x.c);

const faqs = [
  {
    q: 'Wann eröffnet TCM.ch in Bern?',
    a: 'Der Standort ist in Vorbereitung, ein Eröffnungsdatum können wir noch nicht nennen. Wer uns sein Anliegen jetzt schildert, erfährt als Erstes, wann es in Bern losgeht.',
  },
  {
    q: 'Wo befindet sich die TCM.ch Praxis in Bern?',
    a: 'Die definitive Adresse steht noch nicht fest. Geplant ist eine zentrale Lage in der Stadt Bern; sobald der Mietvertrag unterschrieben ist, veröffentlichen wir die Adresse hier.',
  },
  {
    q: 'Kann ich mich bereits für einen Termin melden?',
    a: 'Fix buchen kannst du in Bern noch nicht, dein Interesse anmelden schon. Schilder uns kurz dein Anliegen, dann melden wir uns persönlich, sobald die Terminvergabe in Bern startet. Wenn du früher etwas brauchst, behandeln wir dich gerne an einem unserer bestehenden Standorte.',
  },
  {
    q: 'Was kostet Akupunktur in Bern?',
    a: 'Für Bern gilt dasselbe Modell wie an allen TCM.ch-Standorten: Eine Sitzung liegt bei rund 130 bis 160 Franken, abgerechnet nach dem anerkannten Tarif 590 nach Behandlungsdauer. Die Erstkonsultation dauert länger, weil die Anamnese Zeit braucht, und liegt entsprechend höher.',
  },
  {
    q: 'Zahlt die Krankenkasse Akupunktur?',
    a: 'Akupunktur läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Weil unsere Therapeut:innen EMR- und ASCA-anerkannt sind, beteiligen sich viele Zusatzversicherungen, je nach Kasse und Modell häufig mit 80 bis 100 Prozent. Deine Deckung prüfen wir kostenlos, bevor Kosten entstehen.',
  },
  {
    q: 'Brauche ich eine Überweisung?',
    a: 'Nein. Du meldest dich direkt bei uns, eine ärztliche Überweisung ist für TCM-Behandlungen nicht nötig. Wenn eine schulmedizinische Abklärung sinnvoll ist, sagen wir dir das ehrlich und verweisen dich weiter.',
  },
  {
    q: 'Welche Beschwerden behandelt ihr?',
    a: 'Am häufigsten kommen Patient:innen mit Rücken- und Nackenschmerzen, Migräne, Schlafproblemen, Stress und Verdauungsbeschwerden zu uns. Einen vollständigen Überblick mit ehrlicher Einordnung, was TCM leisten kann und was nicht, findest du unter tcm.ch/beschwerden/.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Bern', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<SpaPage title={title} description={description} path="/standorte/bern" body="" schema={schema}>
<div class="standort-scope">

  <!-- ── HERO (lsr Conversion-Variante: Mint-Panel links, Interesse-Karte rechts) ── -->
  <section class="lsr-hero">
    <div class="lsr-cinner">
      <div class="lsr-ccopy">
        <div class="tsr-crumb"><a href="/" style="color:inherit">TCM.ch</a> › <a href="/standorte/" style="color:inherit">Standorte</a> › <span>Bern</span></div>
        <span class="lsr-eyebrow">TCM.ch · Bern · In Vorbereitung</span>
        <h1 class="lsr-h1">Akupunktur &amp; <span class="lsr-accent">TCM in Bern</span></h1>
        <p class="lsr-lead">TCM.ch baut einen neuen Standort in Bern auf: medizinisch orientierte Traditionelle Chinesische Medizin mit Akupunktur und persönlicher Begleitung. Du kannst uns dein Anliegen bereits jetzt schildern – wir informieren dich über den Start und die passende Behandlungsmöglichkeit.</p>
        <div class="lsr-ctas">
          <a href="#interesse" class="lsr-btn-primary">Termininteresse Bern</a>
          <a href="/kontakt/" class="lsr-btn-ghost">Frage an TCM.ch</a>
        </div>
        <div class="lsr-trust">
          <div><span class="lsr-check">✓</span> EMR- und ASCA-anerkannt</div>
          <div><span class="lsr-check">✓</span> Krankenkasse 80 bis 100%</div>
          <div><span class="lsr-check">✓</span> Keine Überweisung nötig</div>
        </div>
      </div>

      <div class="lsr-cform">
        <div class="be-card" id="interesse" style="scroll-margin-top:88px">
          <div class="be-ribbon">NEU</div>
          <div class="be-card-h">TCM.ch kommt <span class="be-accent">nach Bern</span></div>
          <p class="be-note" style="margin-bottom:14px">Schilder uns kurz dein Anliegen. Wir melden uns persönlich, sobald die Terminvergabe in Bern startet.</p>
          <div class="be-trust" style="flex-direction:column;gap:9px;margin:0 0 16px">
            <div><span class="be-check">✓</span> Du erfährst den Start als Erstes</div>
            <div><span class="be-check">✓</span> Ehrliche Einschätzung zu deinem Anliegen</div>
            <div><span class="be-check">✓</span> Keine Anzahlung, keine Verpflichtung</div>
          </div>
          <div class="be-divider"></div>
          <form class="be-wl-form" data-be-interesse novalidate>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
            <input type="hidden" name="quelle" value="warteliste-bern" />
            <input type="hidden" name="standort" value="Bern" />
            <input name="name" type="text" autocomplete="name" placeholder="Dein Name (optional)" aria-label="Name" />
            <input name="email" type="email" autocomplete="email" required placeholder="deine@email.ch" aria-label="E-Mail-Adresse" />
            <textarea name="behandlung" rows="2" placeholder="Dein Anliegen (optional – musst du nicht genau wissen)" aria-label="Anliegen"></textarea>
            <div class="cf-turnstile be-ts" data-sitekey={turnstileSitekey} data-appearance="interaction-only"></div>
            <button type="submit">Termininteresse senden</button>
            <p class="be-form-rule">Keine Werbung, keine Weitergabe. Nur eine Nachricht, wenn Bern startet.</p>
            <p class="be-form-err" role="alert" hidden></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST-BAND (usp-grid wie an den übrigen Standorten) ── -->
  <section class="usp-grid-section" style="background:#fff;padding:48px 0;border-bottom:1px solid var(--border)">
    <div class="wrap"><div class="usp-grid">
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(26,226,136,.14)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 11 11 13 15 9"></polyline></svg></div>
        <div class="usp-title">Krankenkassen-anerkannt</div>
        <div class="usp-sub">EMR und ASCA, Abrechnung über die Zusatzversicherung.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(26,226,136,.14)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
        <div class="usp-title">Standort im Aufbau</div>
        <div class="usp-sub">Wer sein Interesse anmeldet, erfährt den Start in Bern zuerst.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(26,226,136,.14)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div>
        <div class="usp-title">Keine Überweisung nötig</div>
        <div class="usp-sub">Du meldest dich direkt bei uns.</div>
      </div>
    </div></div>
  </section>

  <!-- ── STATUS / INTRO ── -->
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Standort</div>
      <h2 class="section-title">TCM.ch kommt <em>nach Bern.</em></h2>
      <p class="section-sub">Bern ist unser nächster Standort, und wir bauen ihn genau so auf wie die bestehenden: kleine Teams, viel Zeit pro Termin, klare Diagnostik.</p>
      <p style="margin-top:20px">Wer nach Traditioneller Chinesischer Medizin in Bern sucht, findet bisher vor allem Einzelpraxen mit langen Wartezeiten. Wir wollen das ändern: mit einer Praxis nach TCM.ch-Standard, in der dich ein qualifiziertes Team behandelt, das täglich mit denselben Krankheitsbildern arbeitet und schwierige Fälle untereinander bespricht, statt allein zu entscheiden.</p>
      <p style="margin-top:16px">Der Ablauf ist überall gleich. Beim ersten Termin nimmt sich dein Akupunkteur eine ganze Stunde Zeit, hört zu, schaut sich Vorbefunde an und macht eine TCM-Diagnostik. Erst danach steht fest, ob <a href="/therapien/akupunktur/">Akupunktur</a>, Schröpfen oder Tuina sinnvoll ist, und in welcher Reihenfolge. Wir sagen dir auch, wenn wir dir nicht weiterhelfen können, und verweisen dich dann weiter – TCM ersetzt keine ärztliche Abklärung und keine notwendige schulmedizinische Behandlung.</p>
      <p style="margin-top:16px">Unsere Therapeut:innen sind EMR- und ASCA-registriert, damit deine Zusatzversicherung mitzahlen kann. Was übernommen wird, hängt von Kasse und Modell ab; wir rechnen es dir vorher vor, mehr dazu unter <a href="/krankenkassen/">Krankenkasse</a> und <a href="/krankenkassen/akupunktur/">Akupunktur &amp; Krankenkasse</a>.</p>
      <p style="margin-top:16px">Das Team für Bern befindet sich im Aufbau. Sobald es steht, stellen wir es hier vor – mit denselben Anforderungen wie überall bei TCM.ch: geprüfte Ausbildung, EMR-/ASCA-Anerkennung, eigene ZSR-Nummer.</p>
      <p style="margin-top:16px;font-size:14.5px;color:var(--muted)">Zentrale Lage in der Stadt Bern geplant – die definitive Adresse veröffentlichen wir, sobald sie feststeht.</p>
    </div>
  </section>

  <!-- ── EINZUGSGEBIET ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Einzugsgebiet</div>
      <h2 class="section-title">Für Bern <em>und die Region.</em></h2>
      <p class="section-sub">Geplant ist eine Praxis zentral in der Stadt Bern, gut erreichbar mit dem öffentlichen Verkehr – für die Stadt und die Agglomeration.</p>
      <p style="margin-top:16px">Wer in Köniz, Ostermundigen oder Ittigen wohnt, ist ohnehin eng an die Stadt angebunden; dasselbe gilt für Zollikofen, Muri bei Bern und Worb. Statt mehrerer kleiner Praxen in der Agglomeration führen wir eine Praxis in der Stadt, mit vollen Behandlungstagen und einem eingespielten Team.</p>
      <p style="margin-top:16px">Wie gut die Praxis von deinem Wohnort aus erreichbar ist, hängt von der definitiven Adresse ab – sie steht noch nicht fest. Sobald sie klar ist, findest du hier Lage und Anfahrt im Detail.</p>
    </div>
  </section>

  <!-- ── BESCHWERDEN ── -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <div class="section-label">Beschwerden</div>
        <h2 class="section-title">Beschwerden, die wir in <em>Bern</em> behandeln werden</h2>
        <p class="section-sub">Das sind die Anliegen, mit denen Patient:innen an unseren Standorten am häufigsten kommen, und die wir auch in Bern behandeln werden. Auf den einzelnen Seiten steht, wie wir vorgehen, wie viele Sitzungen realistisch sind und wo die Grenzen der TCM liegen. Ehrliche Einordnungen der Studienlage findest du zum Beispiel unter <a href="/wissen/akupunktur-bei-knieschmerzen/">Akupunktur bei Knieschmerzen</a> und <a href="/wissen/akupunktur-bei-schulterschmerzen/">Akupunktur bei Schulterschmerzen</a>.</p>
      </div>
      <div class="card-grid reveal">
        {beschwerden.map(({ slug, c }, i) => (
          <a href={`/beschwerden/${slug}/`} class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src={c.img} alt={`${c.name} mit TCM behandeln`} style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">{anchor(i, c.name)}</div><div class="svc-tagline">{c.tagline}</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a>
        ))}
      </div>
      <div style="text-align:center;margin-top:24px"><a href="/beschwerden/" class="btn-secondary" style="display:inline-flex">Alle Beschwerden ansehen →</a></div>
    </div>
  </section>

  <!-- ── THERAPIEN ── -->
  <section class="section svc-section" style="background:var(--surface)">
    <div class="wrap">
      <div class="svc-header reveal">
        <div>
          <div class="section-label">Unsere Therapien</div>
          <h2 class="section-title">Unsere <em>Therapien</em> für Bern</h2>
        </div>
        <p class="svc-sub">Bern orientiert sich am Behandlungsspektrum unserer übrigen Standorte – im Zentrum stehen Akupunktur und die klassischen TCM-Methoden. Der definitive Umfang für Bern steht mit der Eröffnung fest. Was bei dir sinnvoll ist, entscheiden wir nach dem Erstgespräch, nicht vorher.</p>
      </div>
      <div class="svc-grid">
        {therapien.map(({ slug, c, tagline }) => (
          <a href={`/therapien/${slug}/`} class="svc-card reveal"> <div class="svc-photo-wrap"> <img width={c.w} height={c.h} src={c.img} alt={`${c.name} bei TCM.ch`} class="svc-photo" loading="lazy" style={`object-position:${c.objectPos}`}> <div class="svc-photo-top-bar"></div> </div> <div class="svc-body"> <div class="svc-name">{c.name}</div> <div class="svc-tagline">{tagline}</div> <div class="svc-meta"> <span class="svc-badge svc-badge--time"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15.5 14"></polyline></svg>{c.time}</span> <span class="svc-badge svc-badge--ins">{c.ins}</span> </div> <div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </div> </a>
        ))}
      </div>
      <p style="margin:22px 0 0;font-size:15px;line-height:1.6;color:var(--mid);max-width:72ch">Alle Methoden im Überblick, mit Ablauf, Kosten und ehrlicher Einordnung: <a href="/therapien/" style="color:var(--brand-black);font-weight:700">Unsere Therapien</a>.</p>
    </div>
  </section>

  <!-- ── ABLAUF ── -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Ablauf</div>
      <h2 class="section-title">Erstgespräch → Behandlungsplan → Folgetermine</h2>
      <p class="section-sub">So läuft es an allen unseren Standorten ab, und so wird es auch in Bern laufen.</p>
      <div class="usp-grid" style="margin-top:28px">
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(26,226,136,.14);color:#020B10;font-family:var(--font-sans);font-weight:800;font-size:18px">1</div>
          <div class="usp-title">Erstgespräch &amp; Anamnese, 60 Minuten</div>
          <div class="usp-sub">Wir hören zu, schauen Vorbefunde an und machen die TCM-Diagnostik. Eine erste Behandlung ist meist schon dabei.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(26,226,136,.14);color:#020B10;font-family:var(--font-sans);font-weight:800;font-size:18px">2</div>
          <div class="usp-title">Behandlungsplan</div>
          <div class="usp-sub">Du bekommst eine konkrete Einschätzung: welche Methoden, wie viele Sitzungen, in welchem Abstand und was das kostet.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(26,226,136,.14);color:#020B10;font-family:var(--font-sans);font-weight:800;font-size:18px">3</div>
          <div class="usp-title">Folgetermine</div>
          <div class="usp-sub">Meist 45 bis 60 Minuten, anfangs wöchentlich. Nach vier bis sechs Sitzungen schauen wir gemeinsam, ob es wirkt.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── KRANKENKASSE ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Krankenkasse</div>
      <h2 class="section-title">Was die <em>Zusatzversicherung</em> übernimmt.</h2>
      <p>Akupunktur bei Therapeut:innen läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Damit deine Kasse mitzahlt, muss die behandelnde Person in den Registern <strong>EMR</strong> und <strong>ASCA</strong> anerkannt sein. Das trifft auf unser gesamtes Team zu, und daran ändert sich mit Bern nichts.</p>
      <p style="margin-top:16px">Bei den meisten Kassen sind damit <strong>80 bis 100 Prozent</strong> gedeckt, abhängig von Modell und Jahreslimite. Verbindlich ist immer deine Police. Schick uns Kasse und Modell, wir prüfen das kostenlos und sagen dir vorher, womit du rechnen musst. Mehr dazu unter <a href="/krankenkassen/">Krankenkasse</a> und speziell für Akupunktur unter <a href="/krankenkassen/akupunktur/">Akupunktur &amp; Krankenkasse</a>.</p>
    </div>
  </section>

  <!-- ── WARUM TCM.CH ── -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Warum TCM.ch</div>
      <h2 class="section-title">Was du bei uns anders <em>bekommst.</em></h2>
      <p class="section-sub">Bern wird kein Einzelkämpfer-Standort, sondern Teil eines Netzes, das seit Jahren läuft.</p>
      <div class="usp-grid" style="margin-top:28px">
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(26,226,136,.14)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
          <div class="usp-title">Ein Netzwerk in der ganzen Deutschschweiz</div>
          <div class="usp-sub">Ziehst du um oder brauchst früher einen Termin, behandelt dich das nächste Team mit derselben Akte. <a href="/standorte/">Alle Standorte</a>.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(26,226,136,.14)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"></path><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"></path><circle cx="20" cy="10" r="2"></circle></svg></div>
          <div class="usp-title">Ärztliche Sprechstunde</div>
          <div class="usp-sub">Wenn eine schulmedizinische Abklärung nötig ist, läuft das intern über unsere <a href="/sprechstunde/">ärztliche Sprechstunde</a>, statt dich weiterzuschicken.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(26,226,136,.14)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#020B10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="7" y1="9" x2="17" y2="9"></line><line x1="7" y1="13" x2="13" y2="13"></line></svg></div>
          <div class="usp-title">Abrechnung nach Tarif 590</div>
          <div class="usp-sub">Der anerkannte Tarif für Komplementärmedizin, nach Behandlungsdauer. Keine Pauschalen, keine Überraschungen auf der Rechnung.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap reveal" style="max-width:820px">
      <div class="section-label">Häufige Fragen</div>
      <h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>Akupunktur &amp; TCM in Bern</em></h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0">
            <summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">{f.q}<span style="font-size:20px;color:var(--brand-black)">+</span></summary>
            <div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── END-CTA ── -->
  <section class="cta-band" style="background:var(--brand-black);padding:48px 0">
    <div class="wrap" style="text-align:center">
      <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Interesse an TCM in Bern?</h2>
      <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Schilder uns dein Anliegen. Wir melden uns, sobald es in Bern losgeht – und sagen dir ehrlich, was TCM bei dir leisten kann.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn-white" href="#interesse" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Termininteresse Bern</a>
        <a href="/standorte/" style="display:inline-flex;align-items:center;font-family:var(--font-sans);font-weight:700;font-size:15px;color:#fff;text-decoration:none;padding:14px 24px;border:1.5px solid rgba(255,255,255,.4);border-radius:var(--r-btn)">Bestehende Standorte</a>
      </div>
    </div>
  </section>

<style>
  /* Karten sind <a> (crawlbar) statt div+onclick; Link-Default zurücksetzen. */
  .svc-card { text-decoration: none; color: inherit; }

  /* Hero-Shell kommt aus dem globalen lsr-Conversion-System (public/home.css);
     hier bleiben nur die Karten-/Formular-Styles (be-Prefix, Astro-scoped).
     be-accent/be-trust/be-check werden weiterhin in der Karte genutzt. */
  .be-accent { color: var(--brand-black); }

  .be-trust { display: flex; gap: 22px; margin-top: 28px; flex-wrap: wrap; font-size: 14px; color: var(--mid); }
  .be-trust div { display: flex; align-items: center; gap: 7px; }
  .be-check { color: var(--brand-black); font-weight: 800; }

  .be-card {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, #ffffff, #f2f5f0);
    border: 1px solid rgba(18, 33, 28, .08); border-radius: var(--r-hero);
    padding: 32px; box-shadow: 0 24px 60px -20px rgba(0, 0, 0, .18);
  }
  .be-ribbon {
    position: absolute; top: 16px; right: -42px;
    background: #FFC107; color: #2a2109; font-weight: 800; font-size: 11.5px; letter-spacing: .08em;
    padding: 6px 48px; transform: rotate(45deg); box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .3);
  }
  .be-card-h { font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 800; letter-spacing: -.02em; margin: 6px 0 5px; line-height: 1.15; }
  .be-note { color: var(--mid); font-size: 14.5px; }
  .be-divider { height: 1px; background: var(--border); margin: 22px 0; }

  .be-wl-form { display: flex; flex-direction: column; gap: 10px; }
  .be-wl-form input[type="email"], .be-wl-form input[type="text"]:not([name="website"]), .be-wl-form textarea {
    border: 1px solid var(--border); border-radius: 10px; padding: 13px 14px; font-size: 15px;
    background: #fff; font-family: inherit; color: var(--charcoal); resize: vertical;
  }
  .be-wl-form input:focus, .be-wl-form textarea:focus { outline: 2px solid var(--brand-black); outline-offset: 1px; border-color: transparent; }
  .be-wl-form button {
    background: var(--brand); color: var(--brand-black); border: none; border-radius: 10px;
    padding: 14px; font-size: 15.5px; font-weight: 700; cursor: pointer;
    transition: background var(--t-fast) var(--ease-out);
  }
  .be-wl-form button:hover { background: #14C97A; }
  .be-wl-form button:disabled { opacity: .65; cursor: default; }
  .be-form-rule { font-size: 12px; color: var(--mid); text-align: center; }
  .be-ts { min-height: 0; }
  .be-form-err { font-size: 13px; color: #c0392b; line-height: 1.5; margin-top: 2px; }

  @media (max-width: 767px) {
    .be-card { padding: 18px; }
    /* Ribbon-Ecke freihalten, damit die Karten-Headline nicht darunter laeuft. */
    .be-card-h { padding-right: 52px; }
    .be-card, .be-card * { max-width: 100%; }
    .be-ts { max-width: 100%; overflow-x: auto; }
    .be-wl-form input, .be-wl-form textarea, .be-wl-form button { width: 100%; }
  }
</style>

  <script is:inline>
    (function () {
      var f = document.querySelector('[data-be-interesse]');
      if (!f) return;
      var btn = f.querySelector('button[type="submit"]');
      var errEl = f.querySelector('.be-form-err');
      var showErr = function (m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } };
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errEl) errEl.hidden = true;
        var emailEl = f.querySelector('[name="email"]');
        var email = emailEl ? emailEl.value.trim() : '';
        if (!email || email.indexOf('@') < 1) { showErr('Bitte eine gültige E-Mail-Adresse angeben.'); return; }
        var ts = window.tcmTsToken ? window.tcmTsToken(f)
          : { el: f.querySelector('.cf-turnstile'), token: (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '' };
        if (ts.el && !ts.token) { showErr('Kurz bestätigen, dass du kein Roboter bist, dann nochmal senden.'); return; }
        var data = {
          email: email,
          name: (f.querySelector('[name="name"]') || {}).value || '',
          behandlung: (f.querySelector('[name="behandlung"]') || {}).value || '',
          standort: 'Bern', quelle: 'warteliste-bern',
          website: (f.querySelector('[name="website"]') || {}).value || '',
          zeit: new Date().toISOString(), turnstileToken: ts.token,
        };
        if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'Wird gesendet…'; }
        fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
          .then(function (r) { if (!r.ok) throw new Error('bad_status'); return r.json().catch(function () { return {}; }); })
          .then(function () {
            // Inline-Styles, weil die scoped Styles dieser Seite auf zur Laufzeit
            // erzeugte Elemente nicht greifen (kein data-astro-cid).
            var ok = document.createElement('div');
            ok.style.cssText = 'text-align:center;padding:14px 4px';
            ok.innerHTML = '<div aria-hidden="true" style="width:44px;height:44px;margin:0 auto 12px;border-radius:50%;background:var(--brand-surface);color:var(--brand-black);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800">✓</div>' +
              '<h3 style="font-size:19px;font-weight:800;color:var(--charcoal);margin:0 0 8px;letter-spacing:-.01em">Danke, wir haben dein Anliegen.</h3>' +
              '<p style="font-size:14.5px;color:var(--mid);line-height:1.55">Wir melden uns per E-Mail, sobald es in Bern losgeht.</p>';
            f.replaceWith(ok);
          })
          .catch(function () {
            if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || 'Termininteresse senden'; }
            if (window.turnstile && ts.el) { try { window.turnstile.reset(ts.el); } catch (_) {} }
            showErr('Senden fehlgeschlagen. Bitte später nochmal versuchen oder an termine@tcm.ch schreiben.');
          });
      });
    })();
  </script>
</div>
</SpaPage>
