---
// /standorte/luzern/ — vollwertige Standortseite auf dem St.-Gallen-Template,
// im Pre-Opening-Modus (Eröffnung 2027, Adresse noch offen).
//
// Abweichungen zu St. Gallen, bewusst und nur wegen Pre-Opening:
//   • Warteliste-Formular statt OneDoc-Widget / Buchungs-CTA (quelle=warteliste-luzern)
//   • KEIN MedicalClinic-Schema (erst mit Adresse), nur BreadcrumbList + FAQPage
//   • keine Adress-/Karten-Sektion, keine Öffnungszeiten, keine Team-Sektion
// Statischer Pfad, deshalb greift standorte/[slug].astro hier nicht (Luzern ist nicht in standorte.ts).
export const prerender = true;
import SpaPage from '../../../layouts/SpaPage.astro';
import { symptomCards } from '../../../data/symptom-cards';
import { therapyCards } from '../../../data/therapy-cards';

const url = 'https://tcm.ch/standorte/luzern/';
const title = 'TCM & Akupunktur Luzern | TCM.ch';
const description =
  'Akupunktur und TCM in Luzern: TCM.ch eröffnet 2027 in der Stadt Luzern. EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Jetzt auf die Warteliste.';

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

const beschwerden = ['rueckenschmerzen', 'nackenschmerzen', 'migraene', 'schlafstoerungen', 'stress-burnout', 'kinderwunsch', 'ischias', 'heuschnupfen']
  .map((slug) => ({ slug, c: symptomCards[slug] }))
  .filter((x) => x.c);
// Anchor-Texte alternieren "Akupunktur bei X" / "TCM bei X", wie in Beschwerden.astro.
const anchor = (i: number, name: string) => `${i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei ${name}`;

// Therapien-Grid: dieselben 8 Karten in derselben Reihenfolge wie /standorte/st-gallen/.
// Kräutertherapie steht wie dort NICHT im Grid, sondern in der kt-wrap-Sektion darunter.
const therapien = ['akupunktur', 'gesichtsakupunktur', 'schroepfen', 'tuina', 'akupressur', 'shiatsu', 'gua-sha', 'physiotherapie']
  .map((slug) => ({ slug, c: therapyCards[slug], tagline: therapyCards[slug]?.tagline }))
  .filter((x) => x.c);

const faqs = [
  {
    q: 'Wann eröffnet ihr in Luzern?',
    a: '2027. Ein genaues Datum können wir noch nicht nennen, weil die Räume gerade gesucht werden. Wer auf der Warteliste steht, erfährt den Termin als Erstes und kann sich vor der offiziellen Eröffnung einen Platz sichern.',
  },
  {
    q: 'Was kostet Akupunktur in Luzern?',
    a: 'Eine Sitzung liegt bei rund 130 bis 160 Franken. Abgerechnet wird nach dem anerkannten Tarif 590 nach Behandlungsdauer. Die Erstkonsultation dauert länger, weil die Anamnese Zeit braucht, und liegt entsprechend höher. Alle Zahlen stehen auf unserer Seite zu den Kosten in Luzern.',
  },
  {
    q: 'Zahlt die Krankenkasse die Behandlung?',
    a: 'Akupunktur läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Weil unsere Therapeut:innen EMR- und ASCA-anerkannt sind, beteiligen sich die meisten Zusatzversicherungen mit 80 bis 100 Prozent. Deine Deckung prüfen wir kostenlos, bevor Kosten entstehen.',
  },
  {
    q: 'Wo genau seid ihr in Luzern?',
    a: 'Die Adresse steht noch nicht fest. Klar ist die Lage: zentral in der Stadt Luzern, zu Fuss vom Bahnhof erreichbar und mit dem Bus gut angebunden an Kriens, Emmen und Horw. Sobald der Mietvertrag unterschrieben ist, steht die Adresse hier.',
  },
  {
    q: 'Kann ich schon einen Termin reservieren?',
    a: 'Fix buchen kannst du noch nicht. Auf die Warteliste eintragen schon. Wir melden uns, sobald die Terminvergabe für Luzern startet, und du kommst vor allen anderen dran. Wenn du früher etwas brauchst, behandeln wir dich gerne an einem unserer bestehenden Standorte.',
  },
  {
    q: 'Behandelt ihr auch bei Kinderwunsch?',
    a: 'Ja, das ist einer der häufigeren Gründe, warum Patientinnen zu uns kommen, oft begleitend zu einer Kinderwunschbehandlung in der Klinik. Wir stimmen die Termine auf deinen Zyklus und auf laufende medizinische Behandlungen ab und sprechen offen darüber, was TCM dabei leisten kann und was nicht. In Luzern bieten wir das ab der Eröffnung an, bis dahin an unseren bestehenden Standorten.',
  },
  {
    q: 'Gibt es Termine ausserhalb der Bürozeiten?',
    a: 'Ja. An unseren bestehenden Standorten behandeln wir früh morgens, über Mittag und am Abend, dazu samstags. Für Luzern planen wir dieselben Zeiten, damit du für eine Sitzung keinen halben Arbeitstag brauchst. Die definitiven Öffnungszeiten stehen hier, sobald die Praxis fix ist.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Luzern', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<SpaPage title={title} description={description} path="/standorte/luzern" body="" schema={schema}>

  <!-- ── HERO (Struktur wie HeroLaunchSG: Copy links, Karte rechts) ── -->
  <section class="lu-hero">
    <div class="lu-hero-inner">
      <div class="lu-hero-copy">
        <div class="sg-crumb" style="font-size:12.5px;color:var(--muted);margin-bottom:18px"><a href="/" style="color:inherit">TCM.ch</a> › <a href="/standorte/" style="color:inherit">Standorte</a> › <span>Luzern</span></div>
        <span class="lu-badge">Standort Luzern · Eröffnung 2027</span>
        <h1 class="lu-h1">TCM &amp; <span class="lu-accent">Akupunktur Luzern</span></h1>
        <p class="lu-sub">Wir eröffnen 2027 eine Praxis in der Stadt Luzern, mit demselben Team und denselben Methoden wie an unseren zwölf bestehenden Standorten. Zentrale Lage, Bahnhof in Gehdistanz — die Adresse folgt nach Mietvertrag. Bis dahin behandeln wir dich gerne an einem Standort in deiner Nähe.</p>
        <div class="lu-cta-row">
          <a href="#warteliste" class="lu-btn-primary">Auf die Warteliste</a>
          <a href="/standorte/" class="lu-btn-ghost">Bestehende Standorte</a>
        </div>
        <div class="lu-trust">
          <div><span class="lu-check">✓</span> EMR- und ASCA-anerkannt</div>
          <div><span class="lu-check">✓</span> Krankenkasse 80 bis 100%</div>
          <div><span class="lu-check">✓</span> Keine Überweisung nötig</div>
        </div>
      </div>

      <div class="lu-hero-visual">
        <div class="lu-card" id="warteliste" style="scroll-margin-top:88px">
          <div class="lu-ribbon">2027</div>
          <div class="lu-card-h">Sichere dir einen der <span class="lu-accent">ersten Termine</span></div>
          <p class="lu-note" style="margin-bottom:14px">Eine E-Mail genügt. Wir melden uns, sobald die Terminvergabe in Luzern startet.</p>
          <div class="lu-trust" style="flex-direction:column;gap:9px;margin:0 0 16px">
            <div><span class="lu-check">✓</span> Du hörst als Erstes vom Eröffnungstermin</div>
            <div><span class="lu-check">✓</span> Terminwahl vor der offiziellen Freigabe</div>
            <div><span class="lu-check">✓</span> Keine Anzahlung, keine Verpflichtung</div>
          </div>
          <div class="lu-divider"></div>
          <form class="lu-wl-form" data-lu-waitlist novalidate>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
            <input type="hidden" name="quelle" value="warteliste-luzern" />
            <input type="hidden" name="standort" value="Luzern" />
            <input name="email" type="email" autocomplete="email" required placeholder="deine@email.ch" aria-label="E-Mail-Adresse" />
            <div class="cf-turnstile lu-ts" data-sitekey={turnstileSitekey} data-appearance="interaction-only"></div>
            <button type="submit">Auf die Warteliste</button>
            <p class="lu-form-rule">Keine Werbung, keine Weitergabe. Nur eine Nachricht, wenn Luzern startet.</p>
            <p class="lu-form-err" role="alert" hidden></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST-BAND (usp-grid wie St. Gallen) ── -->
  <section class="usp-grid-section" style="background:#fff;padding:48px 0;border-bottom:1px solid var(--border)">
    <div class="wrap"><div class="usp-grid">
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 11 11 13 15 9"></polyline></svg></div>
        <div class="usp-title">Krankenkassen-anerkannt</div>
        <div class="usp-sub">EMR und ASCA, Abrechnung über die Zusatzversicherung.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></div>
        <div class="usp-title">Über 2000 zufriedene Patienten</div>
        <div class="usp-sub">4,9★ bewertet, an zwölf Standorten.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
        <div class="usp-title">Termine ab Eröffnung 2027</div>
        <div class="usp-sub">Warteliste zuerst, danach die offizielle Freigabe.</div>
      </div>
      <div class="usp-card">
        <div class="usp-icon" style="background:rgba(45,155,111,.1)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D9B6F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div>
        <div class="usp-title">Keine Überweisung nötig</div>
        <div class="usp-sub">Du meldest dich direkt bei uns.</div>
      </div>
    </div></div>
  </section>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Standort</div>
      <h2 class="section-title">Deine <em>TCM-Praxis</em> in Luzern.</h2>
      <p class="section-sub">Luzern ist unser nächster Standort, und wir bauen ihn genau so auf wie die bestehenden: kleine Teams, viel Zeit pro Termin, klare Diagnostik.</p>
      <p style="margin-top:20px">Wenn du nach chinesischer Medizin in Luzern suchst, findest du bisher vor allem Einzelpraxen mit langen Wartezeiten. Wir wollen das ändern. Ab 2027 behandelt dich hier ein Team, das täglich mit denselben Krankheitsbildern arbeitet und sich untereinander abspricht, statt allein zu entscheiden.</p>
      <p style="margin-top:16px">Der Ablauf ist überall gleich. Beim ersten Termin nimmt sich dein Akupunkteur eine ganze Stunde Zeit, hört zu, schaut sich Vorbefunde an und macht eine TCM-Diagnostik. Erst danach steht fest, ob Akupunktur, Schröpfen, Tuina oder eine Kräuterrezeptur sinnvoll ist, und in welcher Reihenfolge. Wir sagen dir auch, wenn wir dir nicht weiterhelfen können, und verweisen dich dann weiter. Wie ein Termin Schritt für Schritt abläuft, was er kostet und was die Studien zu Akupunktur hergeben, steht ausführlich unter <a href="/wissen/tcm-luzern-erfahrungen-ablauf/">Erfahrungen &amp; Ablauf</a>.</p>
      <p style="margin-top:16px">Genauso wichtig ist uns, dass du nicht wochenlang auf einen Termin wartest. An unseren bestehenden Standorten bekommst du in der Regel innerhalb von zwei Tagen einen Platz, und dieselbe Planung übernehmen wir für Luzern. Wer auf der Warteliste steht, kommt vor der offiziellen Terminfreigabe dran.</p>
      <p style="margin-top:16px">Unsere Therapeut:innen sind EMR- und ASCA-registriert, damit deine Zusatzversicherung mitzahlt. Was eine Sitzung kostet und was am Ende bei dir bleibt, rechnen wir dir vorher vor, siehe <a href="/standorte/luzern/kosten/">Kosten &amp; Krankenkasse in Luzern</a>.</p>
      <p style="margin-top:16px;font-size:14.5px;color:var(--muted)">Zentrale Lage, Bahnhof in Gehdistanz — Adresse folgt nach Mietvertrag.</p>
    </div>
  </section>

  <!-- ── EINZUGSGEBIET ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Einzugsgebiet</div>
      <h2 class="section-title">Wo wir in Luzern <em>erreichbar sein werden.</em></h2>
      <p class="section-sub">Die Praxis entsteht zentral in der Stadt, mit kurzen Wegen aus der Altstadt und der Neustadt. Der Bahnhof liegt in Gehdistanz, damit du nach der Arbeit nicht noch quer durch die Stadt musst.</p>
      <p style="margin-top:16px">Von Kriens bist du in wenigen Minuten da. Wer Akupunktur in Kriens sucht, hat mit uns eine anerkannte Praxis vor der Haustür, ohne Umsteigen und ohne Fahrt nach Zürich. Für Horw und Ebikon gilt dasselbe: beide Gemeinden sind direkt ans Zentrum angebunden.</p>
      <p style="margin-top:16px">Aus Emmen und Emmenbrücke fährt die S-Bahn im dichten Takt. TCM in Emmenbrücke heisst für die meisten ohnehin ein kurzer Weg in die Stadt, und genau dort sind wir ab 2027. Auch aus Littau und Meggen sind es keine weiten Strecken. Kurz: Wenn du im Raum Luzern wohnst, bist du in der Regel in einer Viertelstunde bei uns.</p>
    </div>
  </section>

  <!-- ── BESCHWERDEN ── -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <div class="section-label">Beschwerden</div>
        <h2 class="section-title">Beschwerden, die wir in <em>Luzern</em> behandeln</h2>
        <p class="section-sub">Das sind die Anliegen, mit denen Patient:innen an unseren Standorten am häufigsten kommen, und die wir ab 2027 auch in Luzern behandeln. Auf den einzelnen Seiten steht, wie wir vorgehen, wie viele Sitzungen realistisch sind und wo die Grenzen der TCM liegen.</p>
      </div>
      <div class="card-grid reveal">
        {beschwerden.map(({ slug, c }, i) => (
          <a href={`/beschwerden/${slug}/`} class="svc-card reveal"><div class="svc-photo-top-bar"></div><div class="svc-photo-wrap"><img loading="lazy" decoding="async" src={c.img} alt={`${c.name} mit TCM behandeln in Luzern`} style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;"></div><div class="svc-body"><div class="svc-name">{anchor(i, c.name)}</div><div class="svc-tagline">{c.tagline}</div><div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div></div></a>
        ))}
      </div>
      <div style="text-align:center;margin-top:24px"><a href="/beschwerden/" class="btn-secondary" style="display:inline-flex">Alle Beschwerden ansehen →</a></div>
    </div>
  </section>

  <!-- ── THERAPIEN ── -->
  <section class="section svc-section" style="background:var(--surface)">
    <div class="wrap">
      <div class="svc-header reveal">
        <div>
          <div class="section-label">Unsere Therapien</div>
          <h2 class="section-title">Unsere <em>Therapien</em> in Luzern</h2>
        </div>
        <p class="svc-sub">Dasselbe Spektrum wie an unseren übrigen Standorten. Schröpfen in Luzern und Tuina in Luzern gehören von Anfang an dazu, ebenso die chinesische Kräutertherapie. Was bei dir sinnvoll ist, entscheiden wir nach dem Erstgespräch, nicht vorher.</p>
      </div>
      <div class="svc-grid">
        {therapien.map(({ slug, c, tagline }) => (
          <a href={`/therapien/${slug}/`} class="svc-card reveal"> <div class="svc-photo-wrap"> <img width={c.w} height={c.h} src={c.img} alt={`${c.name} bei TCM.ch`} class="svc-photo" loading="lazy" style={`object-position:${c.objectPos}`}> <div class="svc-photo-top-bar"></div> </div> <div class="svc-body"> <div class="svc-name">{c.name}</div> <div class="svc-tagline">{tagline}</div> <div class="svc-meta"> <span class="svc-badge svc-badge--time"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15.5 14"></polyline></svg>{c.time}</span> <span class="svc-badge svc-badge--ins">{c.ins}</span> </div> <div class="svc-cta">Mehr erfahren <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div> </div> </a>
        ))}
      </div>
      <p style="margin:22px 0 0;font-size:15px;line-height:1.6;color:var(--mid);max-width:72ch">Geht es dir vor allem um Verspannungen und nicht um eine ganze Behandlungsserie? Angebot, Dauer und Preise stehen auf der Seite <a href="/massage-luzern/" style="color:var(--blue);font-weight:700">Massage in Luzern</a>, die Warteliste läuft dort genauso.</p>
    </div>
  </section>

  <!-- ── KRÄUTERTHERAPIE (kt-feature wie St. Gallen) ── -->
  <section class="section kt-wrap" style="background:var(--bg)">
    <div class="wrap">
      <span class="kt-intro-label">Ergänzende Therapie</span>
      <a class="kt-feature" href="/therapien/kraeutertherapie/" aria-label="Kräutertherapie – Mehr erfahren">
        <div class="kt-feature-img">
          <img width="630" height="840" src="/images/img-14a8b7c52ade.webp" alt="Chinesische Kräutertherapie – getrocknete Heilpflanze" loading="lazy">
        </div>
        <div class="kt-feature-body">
          <div class="kt-micro-badges">
            <span class="kt-micro-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"></path><path d="M12 12C12 7.5 7.5 4 3.5 4c0 4.5 3.5 8 8.5 8z"></path><path d="M12 12c0-4.5 4.5-8 8.5-8c0 4.5-3.5 8-8.5 8z"></path></svg>Individuell abgestimmt</span>
            <span class="kt-micro-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>Ergänzende Therapie</span>
          </div>
          <h3 class="kt-headline">Kräutertherapie</h3>
          <p class="kt-desc">Individuelle Rezepturen als Granulat, wenn eine Behandlung über längere Zeit begleitet werden soll. In Luzern ab Eröffnung verfügbar.</p>
          <span class="kt-cta">Mehr erfahren <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
        </div>
      </a>
    </div>
  </section>

  <!-- ── ABLAUF ── -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Ablauf</div>
      <h2 class="section-title">Erstgespräch → Behandlungsplan → Folgetermine</h2>
      <p class="section-sub">So läuft es an allen unseren Standorten ab, und so wird es auch in Luzern laufen.</p>
      <div class="usp-grid" style="margin-top:28px">
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(45,155,111,.1);color:#2D9B6F;font-family:var(--font-sans);font-weight:800;font-size:18px">1</div>
          <div class="usp-title">Erstgespräch &amp; Anamnese, 60 Minuten</div>
          <div class="usp-sub">Wir hören zu, schauen Vorbefunde an und machen die TCM-Diagnostik. Eine erste Behandlung ist meist schon dabei.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(45,155,111,.1);color:#2D9B6F;font-family:var(--font-sans);font-weight:800;font-size:18px">2</div>
          <div class="usp-title">Behandlungsplan</div>
          <div class="usp-sub">Du bekommst eine konkrete Einschätzung: welche Methoden, wie viele Sitzungen, in welchem Abstand und was das kostet.</div>
        </div>
        <div class="usp-card">
          <div class="usp-icon" style="background:rgba(45,155,111,.1);color:#2D9B6F;font-family:var(--font-sans);font-weight:800;font-size:18px">3</div>
          <div class="usp-title">Folgetermine</div>
          <div class="usp-sub">Meist 45 bis 60 Minuten, anfangs wöchentlich. Nach vier bis sechs Sitzungen schauen wir gemeinsam, ob es wirkt.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── KRANKENKASSE ── -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="max-width:820px">
      <div class="section-label">Krankenkasse</div>
      <h2 class="section-title">Was die <em>Zusatzversicherung</em> übernimmt.</h2>
      <p>Akupunktur bei Therapeut:innen läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Damit deine Kasse mitzahlt, muss die behandelnde Person in den Registern <strong>EMR</strong> und <strong>ASCA</strong> anerkannt sein. Das trifft auf unser gesamtes Team zu, und daran ändert sich mit Luzern nichts.</p>
      <p style="margin-top:16px">Bei den meisten Kassen sind damit <strong>80 bis 100 Prozent</strong> gedeckt, abhängig von Modell und Jahreslimite. Verbindlich ist immer deine Police. Schick uns Kasse und Modell, wir prüfen das kostenlos und sagen dir vorher, womit du rechnen musst. Mehr dazu steht auf der Seite <a href="/krankenkassen/">Krankenkasse</a>, die konkreten Zahlen für Luzern findest du unter <a href="/standorte/luzern/kosten/">Kosten &amp; Krankenkasse</a>.</p>
    </div>
  </section>

  <!-- ── WARUM TCM.CH ── -->
