---
// /standorte/luzern/ — Pre-Launch-Standortseite (Eröffnung 2027, Adresse noch offen).
// Bewusst KEIN OneDoc-Widget und KEIN MedicalClinic-Schema: beides erst nach Mietvertrag.
// Statischer Pfad, deshalb greift standorte/[slug].astro hier nicht (Luzern ist nicht in standorte.ts).
export const prerender = true;
import SpaPage from '../../../layouts/SpaPage.astro';

const url = 'https://tcm.ch/standorte/luzern/';
const title = 'Akupunktur & TCM in Luzern | TCM.ch';
const description =
  'Akupunktur und TCM in Luzern: TCM.ch eröffnet 2027 in der Stadt Luzern. EMR-/ASCA-anerkannt, Krankenkasse 80 bis 100% über die Zusatzversicherung. Jetzt auf die Warteliste.';

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';

const beschwerden = [
  { slug: 'rueckenschmerzen', label: 'Rückenschmerzen' },
  { slug: 'nackenschmerzen', label: 'Nackenschmerzen' },
  { slug: 'migraene', label: 'Migräne' },
  { slug: 'schlafstoerungen', label: 'Schlafstörungen' },
  { slug: 'stress-burnout', label: 'Stress & Burnout' },
  { slug: 'kinderwunsch', label: 'Kinderwunsch' },
  { slug: 'ischias', label: 'Ischias' },
  { slug: 'allergien-heuschnupfen', label: 'Heuschnupfen' },
];

const therapien = [
  { slug: 'akupunktur', name: 'Akupunktur', text: 'Der häufigste Grund, warum Leute zu uns kommen. Feine Nadeln, gesetzt nach einer ausführlichen Anamnese.' },
  { slug: 'schroepfen', name: 'Schröpfen', text: 'Gläser auf verspannten Partien, vor allem am Rücken und im Schulterbereich. Oft ergänzend zur Akupunktur.' },
  { slug: 'tuina', name: 'Tuina', text: 'Manuelle Behandlung aus der chinesischen Medizin, kräftiger als eine klassische Entspannungsmassage.' },
  { slug: 'kraeutertherapie', name: 'Kräutertherapie', text: 'Individuelle Rezepturen als Granulat, wenn eine Behandlung über längere Zeit begleitet werden soll.' },
];

const faqs = [
  {
    q: 'Wann eröffnet ihr in Luzern?',
    a: '2027. Ein genaues Datum können wir noch nicht nennen, weil die Räume gerade gesucht werden. Wer auf der Warteliste steht, erfährt den Termin als Erstes und kann sich vor der offiziellen Eröffnung einen Platz sichern.',
  },
  {
    q: 'Was kostet Akupunktur in Luzern?',
    a: 'Eine Sitzung liegt bei rund 130 bis 160 Franken. Abgerechnet wird nach dem anerkannten Tarif 590 nach Behandlungsdauer. Die Erstkonsultation dauert länger, weil die Anamnese Zeit braucht, und liegt entsprechend höher. Alle Zahlen stehen auf unserer Seite zu den Kosten in Luzern.',
  },
  {
    q: 'Zahlt die Krankenkasse die Behandlung?',
    a: 'Akupunktur läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Weil unsere Therapeut:innen EMR- und ASCA-anerkannt sind, beteiligen sich die meisten Zusatzversicherungen mit 80 bis 100 Prozent. Deine Deckung prüfen wir kostenlos, bevor Kosten entstehen.',
  },
  {
    q: 'Wo genau seid ihr in Luzern?',
    a: 'Die Adresse steht noch nicht fest. Klar ist die Lage: zentral in der Stadt Luzern, zu Fuss vom Bahnhof erreichbar und mit dem Bus gut angebunden an Kriens, Emmen und Horw. Sobald der Mietvertrag unterschrieben ist, steht die Adresse hier.',
  },
  {
    q: 'Kann ich schon einen Termin reservieren?',
    a: 'Fix buchen kannst du noch nicht. Auf die Warteliste eintragen schon. Wir melden uns, sobald die Terminvergabe für Luzern startet, und du kommst vor allen anderen dran. Wenn du früher etwas brauchst, behandeln wir dich gerne an einem unserer bestehenden Standorte.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
      { '@type': 'ListItem', position: 2, name: 'Standorte', item: 'https://tcm.ch/standorte/' },
      { '@type': 'ListItem', position: 3, name: 'Luzern', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<SpaPage title={title} description={description} path="/standorte/luzern" body="" schema={schema}>
  <div style="padding-top:68px">

    <section class="section" style="background:var(--green-mint);border-bottom:1px solid var(--border)">
      <div class="wrap" style="max-width:820px">
        <nav class="sg-crumb" style="font-size:13px;color:var(--muted);margin-bottom:14px"><a href="/" style="color:inherit">TCM.ch</a> › <a href="/standorte/" style="color:inherit">Standorte</a> › <span>Luzern</span></nav>
        <div class="section-label">Standort Luzern · Eröffnung 2027</div>
        <h1 class="section-title" style="margin-bottom:20px">Akupunktur &amp; TCM in <em>Luzern</em></h1>

        <div id="warteliste" style="scroll-margin-top:80px;background:#fff;border:1px solid var(--green-mid);border-radius:16px;padding:22px 24px;box-shadow:var(--sh-md)">
          <div style="font-family:var(--font-sans);font-weight:800;font-size:clamp(17px,3.2vw,20px);color:var(--black);line-height:1.3;margin-bottom:6px">Wir eröffnen 2027 in Luzern.</div>
          <p style="font-size:15px;color:var(--mid);line-height:1.6;margin:0 0 16px;max-width:56ch">Trag dich ein und sichere dir einen der ersten Termine. Eine E-Mail genügt, wir melden uns, sobald die Terminvergabe startet.</p>
          <form class="lu-wl-form" data-lu-waitlist novalidate style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-start">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
            <input type="hidden" name="quelle" value="warteliste-luzern" />
            <input type="hidden" name="standort" value="Luzern" />
            <input class="form-input" name="email" type="email" autocomplete="email" required placeholder="deine@email.ch" aria-label="E-Mail-Adresse" style="flex:1 1 260px;min-width:0" />
            <button type="submit" class="btn-primary" style="flex:0 0 auto">Auf die Warteliste</button>
            <div class="cf-turnstile" data-sitekey={turnstileSitekey} data-appearance="interaction-only" style="flex-basis:100%"></div>
            <p class="lu-wl-err" role="alert" hidden style="flex-basis:100%;font-size:13px;color:#c0392b;margin:0"></p>
            <p style="flex-basis:100%;font-size:12.5px;color:var(--muted);margin:0">Keine Werbung, keine Weitergabe. Nur eine Nachricht, wenn Luzern startet.</p>
          </form>
        </div>

        <p class="section-sub" style="margin-top:24px">Bis dahin behandeln wir dich an einem unserer bestehenden Standorte. Alle Praxen findest du in der <a href="/standorte/">Standortübersicht</a>, und was eine Sitzung kostet, steht unter <a href="/standorte/luzern/kosten/">Kosten &amp; Krankenkasse in Luzern</a>.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap" style="max-width:820px">
        <div class="section-label">Einzugsgebiet</div>
        <h2 class="section-title">Wo wir in Luzern <em>erreichbar sein werden.</em></h2>
        <p class="section-sub">Die Praxis entsteht zentral in der Stadt, mit kurzen Wegen aus der Altstadt und der Neustadt. Der Bahnhof liegt in Gehdistanz, damit du nach der Arbeit nicht noch quer durch die Stadt musst.</p>
        <p style="margin-top:16px">Von Kriens bist du in wenigen Minuten da. Wer Akupunktur in Kriens sucht, hat mit uns eine anerkannte Praxis vor der Haustür, ohne Umsteigen und ohne Fahrt nach Zürich. Für Horw und Ebikon gilt dasselbe: beide Gemeinden sind direkt ans Zentrum angebunden.</p>
        <p style="margin-top:16px">Aus Emmen und Emmenbrücke fährt die S-Bahn im dichten Takt. TCM in Emmenbrücke heisst für die meisten ohnehin ein kurzer Weg in die Stadt, und genau dort sind wir ab 2027. Auch aus Littau und Meggen sind es keine weiten Strecken. Kurz: Wenn du im Raum Luzern wohnst, bist du in der Regel in einer Viertelstunde bei uns.</p>
      </div>
    </section>

    <section class="section cl-related" style="background:var(--surface)">
      <div class="wrap reveal">
        <div class="section-label">Beschwerden</div>
        <h2 class="section-title">Womit Patient:innen zu uns <em>kommen.</em></h2>
        <p class="section-sub">Diese Anliegen sehen wir an allen Standorten am häufigsten. Auf den einzelnen Seiten steht, wie wir vorgehen und was die TCM realistisch leisten kann.</p>
        <div class="cl-links">
          {beschwerden.map((b, i) => (
            <a href={`/beschwerden/${b.slug}/`} class="cl-chip">{i % 2 === 0 ? 'Akupunktur' : 'TCM'} bei {b.label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="reveal" style="max-width:60ch;margin-bottom:32px">
          <div class="section-label">Therapien</div>
          <h2 class="section-title">Was wir in Luzern <em>anbieten werden.</em></h2>
          <p class="section-sub">Das gleiche Spektrum wie an unseren übrigen Standorten. Schröpfen in Luzern und Tuina in Luzern gehören von Anfang an dazu, ebenso die chinesische Kräutertherapie. Was bei dir sinnvoll ist, entscheiden wir nach dem Erstgespräch, nicht vorher.</p>
        </div>
        <div class="city-grid">
          {therapien.map((t) => (
            <a class="city-card location-card" href={`/therapien/${t.slug}/`}>
              <div class="location-city">{t.name}</div>
              <div class="location-desc">{t.text}</div>
              <span class="location-link">Mehr dazu →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--surface)">
      <div class="wrap" style="max-width:820px">
        <div class="section-label">Krankenkasse</div>
        <h2 class="section-title">Was die <em>Zusatzversicherung</em> übernimmt.</h2>
        <p>Akupunktur bei Therapeut:innen läuft über die Zusatzversicherung für Komplementärmedizin, nicht über die Grundversicherung. Damit deine Kasse mitzahlt, muss die behandelnde Person in den Registern <strong>EMR</strong> und <strong>ASCA</strong> anerkannt sein. Das trifft auf unser gesamtes Team zu, und daran ändert sich mit Luzern nichts.</p>
        <p style="margin-top:16px">Bei den meisten Kassen sind damit <strong>80 bis 100 Prozent</strong> gedeckt, abhängig von Modell und Jahreslimite. Verbindlich ist immer deine Police. Schick uns Kasse und Modell, wir prüfen das kostenlos und sagen dir vorher, womit du rechnen musst. Mehr dazu steht auf der Seite <a href="/krankenkassen/">Krankenkasse</a>, die konkreten Zahlen für Luzern findest du unter <a href="/standorte/luzern/kosten/">Kosten &amp; Krankenkasse</a>.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap reveal" style="max-width:820px">
        <div class="section-label">Häufige Fragen</div>
        <h2 class="section-title" style="margin-bottom:24px">FAQ zu <em>Akupunktur &amp; TCM in Luzern</em></h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item" style="border-bottom:1px solid var(--border);padding:18px 0">
              <summary style="cursor:pointer;font-size:16.5px;font-weight:600;color:var(--black);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">{f.q}<span style="font-size:20px;color:var(--blue)">+</span></summary>
              <div style="padding-top:14px;font-size:15px;line-height:1.7;color:var(--mid)">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band" style="background:var(--blue);padding:48px 0">
      <div class="wrap" style="text-align:center">
        <h2 style="font-family:var(--font-sans);font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;letter-spacing:-.03em;margin:0 0 8px">Einer der ersten Termine in Luzern?</h2>
        <p style="font-size:15px;color:rgba(255,255,255,.8);margin:0 auto 28px;max-width:52ch">Trag dich mit deiner E-Mail ein. Wir melden uns, sobald die Terminvergabe startet, und du kommst vor allen anderen dran.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a class="btn-white" href="#warteliste" style="display:inline-flex;align-items:center;gap:8px;font-size:15px;padding:14px 32px">Auf die Warteliste</a>
          <a href="/standorte/" style="display:inline-flex;align-items:center;font-family:var(--font-sans);font-weight:700;font-size:15px;color:#fff;text-decoration:none;padding:14px 24px;border:1.5px solid rgba(255,255,255,.4);border-radius:var(--r-btn)">Bestehende Standorte</a>
        </div>
      </div>
    </section>

  </div>

  <script is:inline>
    (function () {
      var f = document.querySelector('[data-lu-waitlist]');
      if (!f) return;
      var btn = f.querySelector('button[type="submit"]');
      var errEl = f.querySelector('.lu-wl-err');
      var showErr = function (m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } };
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errEl) errEl.hidden = true;
        var emailEl = f.querySelector('[name="email"]');
        var email = emailEl ? emailEl.value.trim() : '';
        if (!email || email.indexOf('@') < 1) { showErr('Bitte eine gültige E-Mail-Adresse angeben.'); return; }
        var ts = window.tcmTsToken ? window.tcmTsToken(f)
          : { el: f.querySelector('.cf-turnstile'), token: (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '' };
        if (ts.el && !ts.token) { showErr('Kurz bestätigen, dass du kein Roboter bist, dann nochmal senden.'); return; }
        var data = {
          email: email, standort: 'Luzern', quelle: 'warteliste-luzern',
          website: (f.querySelector('[name="website"]') || {}).value || '',
          zeit: new Date().toISOString(), turnstileToken: ts.token,
        };
        if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'Wird gesendet…'; }
        fetch('/api/anfrage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
          .then(function (r) { if (!r.ok) throw new Error('bad_status'); return r.json().catch(function () { return {}; }); })
          .then(function () {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'formular_senden', form_type: 'warteliste', quelle: 'warteliste-luzern' });
            var ok = document.createElement('div');
            ok.style.cssText = 'font-size:15px;line-height:1.6;color:var(--mid)';
            ok.innerHTML = '<strong style="color:var(--black)">Danke, du stehst auf der Liste.</strong><br>Wir melden uns per E-Mail, sobald die Termine in Luzern freigegeben sind.';
            f.replaceWith(ok);
          })
          .catch(function () {
            if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || 'Auf die Warteliste'; }
            if (window.turnstile && ts.el) { try { window.turnstile.reset(ts.el); } catch (_) {} }
            showErr('Senden fehlgeschlagen. Bitte später nochmal versuchen oder an termine@tcm.ch schreiben.');
          });
      });
    })();
  </script>
</SpaPage>
