---
import LayoutDe from '../layouts/LayoutDe.astro';
import '../styles/de-special-rebrand.css'; // Wave 6 B4: Brand-Präsentation (nur diese Sonderseiten)
import TerminForm from '../components/TerminForm.astro';
import { site } from '../data/site';

const path = '/kontakt';
const url = new URL(path.endsWith('/') ? path : path + '/', site.url).href;
const title = 'Kontakt – Termin anfragen bei TCM.ch';
const description =
  'Termin bei TCM.ch anfragen – per WhatsApp, Telefon oder E-Mail. Wir melden uns persönlich. EMR-/ASCA-anerkannt.';
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich möchte gerne einen Termin anfragen.')}`;
const phone = '+41 77 523 61 22';
const email = 'termine@tcm.ch';

const schema = {
  '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Kontakt', url, inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---

<LayoutDe stickyCta={false} title={`${title} | TCM.ch`} description={description} path={path} schema={schema} turnstile={true}>
  <section class="kontakt-layout-section" aria-labelledby="kontakt-title">
    <div class="wrap kontakt-shell">
      <div class="kontakt-layout">
        <div class="kontakt-intro">
          <p class="kontakt-eyebrow">Kontakt · TCM.ch Kliniken</p>
          <h1 id="kontakt-title">Wir sind für dich da.</h1>
          <p class="kontakt-lead">
            Termin oder Fragen zu TCM? Schreib uns oder ruf an –
            wir helfen dir, die passende Praxis zu finden.
          </p>
        </div>

        <div class="kontakt-methods" aria-label="So erreichst du uns">
          <a class="kontakt-method" href={`mailto:${email}`}>
            <svg class="kontakt-method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
            </svg>
            <span><strong>E-Mail</strong><span>{email}</span></span>
          </a>
          <a class="kontakt-method" href={`tel:${phone.replace(/\s+/g, '')}`}>
            <svg class="kontakt-method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.5v3a2 2 0 0 1-2.2 2A19.4 19.4 0 0 1 2.5 4.2 2 2 0 0 1 4.5 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L7.8 10a16 16 0 0 0 6.2 6.2l1.5-1.6a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2Z"/>
            </svg>
            <span><strong>Telefon</strong><span>{phone}</span></span>
          </a>
          <div class="kontakt-method kontakt-method--info">
            <svg class="kontakt-method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
            </svg>
            <span><strong>Erreichbarkeit</strong><span>Mo–Sa telefonisch erreichbar</span></span>
          </div>
          <a class="kontakt-method" href={waHref} target="_blank" rel="noopener">
            <svg class="kontakt-method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.8 8.8 0 0 1-9.1 9A9.2 9.2 0 0 1 7.5 19L3 20.5l1.5-4.4A9 9 0 1 1 21 11.5Z"/>
              <path d="M8.5 9c.6 2.9 3.2 5.5 6.4 6.4"/>
            </svg>
            <span><strong>WhatsApp</strong><span>Nachricht schreiben <span aria-hidden="true">↗</span></span></span>
          </a>
        </div>

        <div class="kontakt-trust">
          <div class="kontakt-reviewstrip" aria-label="Patientenbewertungen: 4.89 von 5 Sternen, über tausend Rezensionen">
            <div class="kontakt-reviewstrip-label">
              <svg class="kontakt-review-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 7a21 21 0 0 0-8 17 21 21 0 0 0 8 17M34 7a21 21 0 0 1 8 17 21 21 0 0 1-8 17"/>
                <path d="M14 12 8 9m4 10-7-1m7 10-7 2m9 5-5 4M34 12l6-3m-4 10 7-1m-7 10 7 2m-9 5 5 4"/>
                <path d="m24 11 3.8 7.5 8.2 1.2-6 5.8 1.4 8.2L24 30l-7.4 3.7 1.4-8.2-6-5.8 8.2-1.2z"/>
              </svg>
              <strong>Sehr gut bewertete Schweizer TCM-Kliniken</strong>
            </div>
            <div class="kontakt-review-metrics">
              <div class="kontakt-review-metric">
                <strong>4.89</strong>
                <span class="kontakt-review-stars" aria-label="4.89 von 5 Sternen">★★★★★</span>
              </div>
              <div class="kontakt-review-metric kontakt-review-metric--count">
                <strong>1'000+</strong>
                <span>Rezensionen</span>
              </div>
            </div>
          </div>
          <p class="kontakt-insurance-note">EMR-/ASCA-anerkannte Therapeut:innen. Zusatzversicherungen können je nach Police und behandelnder Person Kosten übernehmen.</p>
          <div class="kontakt-support-links">
            <a href="/standorte/">Standorte <span aria-hidden="true">→</span></a>
            <a href="/krankenkassen/">Krankenkasse &amp; Kosten <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="kontakt-form-panel" aria-label="Terminanfrage-Formular">
          {/* Shared TerminForm unchanged: #formular, #terminform, Turnstile and server-confirmed conversion events. */}
          <TerminForm />
        </div>
      </div>
    </div>
  </section>
</LayoutDe>

<style>
  .kontakt-layout-section{
    background:var(--brand-surface,#F6F5F2);
    padding:clamp(24px,3vw,42px) 0 clamp(40px,5vw,66px);
    min-height:600px;
  }
  .kontakt-shell{max-width:1320px}
  .kontakt-layout{
    display:grid;
    grid-template-columns:minmax(0,1.06fr) minmax(430px,.94fr);
    grid-template-areas:"intro form" "methods form" "trust form";
    align-items:start;
    column-gap:clamp(30px,5vw,86px);
    row-gap:clamp(11px,1.4vw,19px);
    align-content:start;
  }
  .kontakt-intro{grid-area:intro;min-width:0}
  .kontakt-eyebrow{
    margin:0 0 10px;
    font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
    color:#496074;
  }
  .kontakt-intro h1{
    max-width:680px;margin:0 0 12px;
    font-family:var(--font-sans);
    font-size:clamp(37px,3.5vw,54px);
    font-weight:850;line-height:1.08;letter-spacing:-.045em;
    color:var(--brand-black,#020B10);
    text-wrap:balance;
  }
  .kontakt-lead{
    max-width:58ch;margin:0;
    font-size:clamp(15px,1.15vw,17px);line-height:1.5;
    color:#52616B;
  }
  .kontakt-methods{
    grid-area:methods;
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
    gap:7px 13px;
    min-width:0;
  }
  .kontakt-method{
    display:flex;align-items:flex-start;gap:12px;min-width:0;
    padding:6px 2px;
    color:var(--brand-black,#020B10);
    text-decoration:none;border-radius:9px;
  }
  .kontakt-method:not(.kontakt-method--info):hover{
    background:rgba(23,105,177,.05);
  }
  .kontakt-method-icon{
    display:block;flex:0 0 22px;width:22px;height:22px;
    margin-top:2px;color:var(--tcm-primary,#1769B1);
  }
  .kontakt-method>span{display:flex;flex-direction:column;gap:3px;min-width:0}
  .kontakt-method strong{
    display:block;font-size:14.5px;font-weight:800;line-height:1.25;
  }
  .kontakt-method>span>span{
    display:block;font-size:13.5px;line-height:1.35;
    color:#52616B;overflow-wrap:anywhere;
  }
  .kontakt-method:not(.kontakt-method--info):hover>span>span{
    color:var(--tcm-primary,#1769B1);text-decoration:underline;text-underline-offset:3px;
  }
  .kontakt-trust{
    grid-area:trust;min-width:0;max-width:640px;
  }
  .kontakt-reviewstrip{
    display:flex;align-items:center;justify-content:space-between;gap:14px;
    box-sizing:border-box;padding:18px 19px;border-radius:16px;
    border:1px solid rgba(35,56,70,.1);background:#fff;
  }
  .kontakt-reviewstrip-label{
    display:flex;align-items:center;gap:10px;min-width:0;flex:1;
    font-size:14px;line-height:1.35;color:var(--brand-black,#020B10);
  }
  .kontakt-reviewstrip-label strong{font-weight:750}
  .kontakt-review-icon{
    display:block;flex:0 0 34px;width:34px;height:34px;
    color:var(--tcm-primary,#1769B1);
  }
  .kontakt-review-metrics{
    display:flex;flex:0 0 auto;align-items:center;gap:0;
  }
  .kontakt-review-metric{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:3px;min-width:67px;text-align:center;
  }
  .kontakt-review-metric--count{
    min-width:87px;margin-left:12px;padding-left:12px;
    border-left:1px solid #DDE5EB;
  }
  .kontakt-review-metric strong{
    font-size:clamp(21px,1.9vw,27px);font-weight:800;
    line-height:1.05;letter-spacing:-.035em;color:var(--brand-black,#020B10);
  }
  .kontakt-review-metric span{
    font-size:11.5px;line-height:1.25;color:#536776;
  }
  .kontakt-review-metric .kontakt-review-stars{
    color:#CE9235;font-size:13px;letter-spacing:1px;white-space:nowrap;
  }
  .kontakt-insurance-note{
    margin:10px 0 2px;font-size:12.5px;line-height:1.45;color:#61717C;
  }
  .kontakt-support-links{display:flex;flex-wrap:wrap;gap:5px 20px}
  .kontakt-support-links a{
    display:inline-flex;align-items:center;min-height:32px;
    color:var(--tcm-primary,#1769B1);font-size:13px;font-weight:750;
    text-decoration:none;
  }
  .kontakt-support-links a:hover{text-decoration:underline;text-underline-offset:4px}
  .kontakt-form-panel{
    grid-area:form;min-width:0;width:100%;max-width:590px;justify-self:end;
  }
  /* Layout overrides ONLY. Original TerminForm and its conversion events remain untouched. */
  :global(.kontakt-form-panel .tf-section){
    padding:0!important;margin:0;scroll-margin-top:105px;
  }
  :global(.kontakt-form-panel .tf-wrap){
    padding:0!important;margin:0!important;
    width:100%;max-width:none!important;
  }
  :global(.kontakt-form-panel .kf.kf--ruhig){
    box-shadow:0 18px 48px rgba(18,39,50,.09);
  }
  :global(.kontakt-layout-section a:focus-visible){
    outline:3px solid #1769B1;outline-offset:3px;
  }
  @media(max-width:1000px){
    .kontakt-layout{
      max-width:730px;margin:0 auto;
      grid-template-columns:minmax(0,1fr);
      grid-template-areas:"intro" "trust" "form" "methods";
      row-gap:20px;
    }
    .kontakt-form-panel{justify-self:stretch;max-width:none}
    .kontakt-intro h1{font-size:clamp(35px,5.2vw,50px);margin-bottom:10px}
    .kontakt-lead{font-size:16px}
  }
  @media(max-width:560px){
    .kontakt-layout-section{padding:34px 0 72px;min-height:0}
    .kontakt-eyebrow{font-size:11px;margin-bottom:12px}
    .kontakt-intro h1{font-size:clamp(34px,8.8vw,42px)}
    .kontakt-lead{font-size:16px;line-height:1.55}
    .kontakt-methods{grid-template-columns:repeat(2,minmax(0,1fr));gap:13px 6px}
    .kontakt-method{gap:7px;padding:8px 1px}
    .kontakt-method-icon{flex-basis:19px;width:19px;height:19px}
    .kontakt-method strong{font-size:13.5px}
    .kontakt-method>span>span{font-size:12.5px}
    .kontakt-reviewstrip{padding:12px 13px;gap:8px}
    .kontakt-reviewstrip-label{gap:7px;font-size:12px}
    .kontakt-review-icon{flex-basis:24px;width:24px;height:24px}
    .kontakt-review-metric{min-width:53px}
    .kontakt-review-metric--count{min-width:67px;margin-left:7px;padding-left:7px}
    .kontakt-review-metric strong{font-size:20px}
    .kontakt-review-metric span{font-size:10px}
    .kontakt-review-metric .kontakt-review-stars{font-size:10.5px;letter-spacing:0}
    .kontakt-insurance-note{font-size:12px}
  }
</style>
