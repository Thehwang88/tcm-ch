---
import LayoutDe from '../layouts/LayoutDe.astro';
import { site } from '../data/site';

const path = '/kontakt';
const url = new URL(path, site.url).href;
const title = 'Kontakt – Termin anfragen bei TCM.ch';
const description =
  'Termin bei TCM.ch anfragen – per WhatsApp, Telefon oder E-Mail. Antwort meist innert 30 Minuten, Termin oft innert 24 Stunden. EMR-/ASCA-anerkannt.';
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich möchte gerne einen Termin anfragen.')}`;
const phone = '+41 77 523 61 22';
const email = 'termine@tcm.ch';

const schema = {
  '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Kontakt', url, inLanguage: 'de-CH',
  isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' },
};
---
<LayoutDe title={`${title} | TCM.ch`} description={description} path={path} schema={schema}>
  <section class="hero">
    <div class="wrap kontakt-hero">
      <div class="eyebrow">Kontakt · TCM.ch</div>
      <h1>Termin anfragen</h1>
      <p class="lead">{description}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap kontakt-wrap">
      <div class="channels">
        <a class="channel channel--primary" href={waHref} target="_blank" rel="noopener">
          <div class="ch-label">Am schnellsten</div>
          <div class="ch-title">Per WhatsApp</div>
          <div class="ch-sub">Schildere kurz dein Anliegen – Antwort meist innert 30 Minuten.</div>
          <span class="ch-go">WhatsApp öffnen →</span>
        </a>
        <a class="channel" href={`tel:${phone.replace(/\s+/g, '')}`}>
          <div class="ch-label">Anrufen</div>
          <div class="ch-title">{phone}</div>
          <div class="ch-sub">Mo–Sa erreichbar. Wir finden gemeinsam den passenden Termin.</div>
          <span class="ch-go">Anrufen →</span>
        </a>
        <a class="channel" href={`mailto:${email}`}>
          <div class="ch-label">E-Mail</div>
          <div class="ch-title">{email}</div>
          <div class="ch-sub">Schreib uns dein Anliegen – wir melden uns zeitnah zurück.</div>
          <span class="ch-go">E-Mail schreiben →</span>
        </a>
      </div>

      <div class="kontakt-foot">
        <p>
          <strong>EMR-/ASCA-anerkannt.</strong> Behandlungen werden in der Regel über die
          Zusatzversicherung für Komplementärmedizin abgerechnet (80–100 %).
        </p>
        <p>
          <a href="/standorte">Alle Standorte ansehen →</a> &nbsp;·&nbsp;
          <a href="/krankenkassen">Krankenkasse &amp; Deckung →</a>
        </p>
      </div>
    </div>
  </section>
</LayoutDe>

<style>
  .kontakt-hero { max-width: 680px; }
  .hero .lead { max-width: 600px; }

  .channels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .channel {
    display: flex; flex-direction: column; height: 100%;
    border: 1px solid var(--border); border-radius: var(--r-card); padding: 24px;
    text-decoration: none; background: var(--white);
    transition: border-color var(--t-fast) ease, box-shadow var(--t-fast) ease, transform var(--t-fast) ease;
  }
  .channel:hover { border-color: var(--blue); box-shadow: var(--sh-card); transform: translateY(-2px); }
  .channel--primary { background: var(--blue); border-color: var(--blue); }
  .channel--primary .ch-label, .channel--primary .ch-sub { color: rgba(255,255,255,.85); }
  .channel--primary .ch-title, .channel--primary .ch-go { color: #fff; }
  .ch-label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue); }
  .ch-title { font-size: 19px; font-weight: 800; color: var(--ink); margin: 6px 0 8px; }
  .ch-sub { font-size: 14.5px; line-height: 1.5; color: var(--mid); flex: 1; }
  .ch-go { margin-top: 16px; font-size: 14px; font-weight: 700; color: var(--blue); }

  .kontakt-foot { margin-top: 28px; border-top: 1px solid var(--border); padding-top: 20px; font-size: 15px; color: var(--mid); }
  .kontakt-foot p { margin: 0 0 10px; }
  .kontakt-foot strong { color: var(--ink); }
  .kontakt-foot a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .kontakt-foot a:hover { text-decoration: underline; }

  @media (max-width: 760px) { .channels { grid-template-columns: 1fr; } }
</style>
