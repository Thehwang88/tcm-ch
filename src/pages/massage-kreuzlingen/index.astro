---
// /massage-kreuzlingen — City-Landingpage für "massage kreuzlingen". Gleiches Muster wie
// /massage-winterthur/ und /massage-st-gallen/: SpaPage + InsuranceBanner +
// MassageAnfrageForm + geteilte .msg-* Styles, lokale Entität mit NAP-Schema.
// Commercial Intent: targetet "massage kreuzlingen", nicht "tuina" (gehört /therapien/tuina/)
// und nicht "tcm kreuzlingen" (gehört /standorte/kreuzlingen/).
import SpaPage from '../../layouts/SpaPage.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import MassageAnfrageForm from '../../components/MassageAnfrageForm.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import bodyRaw from '../../data/massage-kreuzlingen-body.html?raw';
import css from '../../data/massage-city.css?raw';

const [heroPart, restPart] = bodyRaw.split('<!--BANNER-->');

const url = 'https://tcm.ch/massage-kreuzlingen/';
const title = 'Massage Kreuzlingen – Medizinische Massage & Tuina | TCM.ch';
const description = 'Massage Kreuzlingen: medizinische Massage, Tuina, Schröpfen und Gua Sha an der Romanshornerstrasse 1. EMR-/ASCA-anerkannt und über die Zusatzversicherung abrechenbar.';

const faqs = [
  { q: "Zahlt die Krankenkasse eine Massage in Kreuzlingen?", a: "Medizinisch indizierte Massagen bei unseren EMR- und ASCA-anerkannten Therapeut:innen trägt die Zusatzversicherung für Komplementärmedizin in der Regel mit, je nach Modell 50 bis 90 Prozent, oft bis zu einer Jahreslimite. Die Grundversicherung zahlt keine Massagen. Reine Entspannungsmassagen sind Selbstzahlerleistungen. Schick uns Kasse und Modell, wir prüfen die Deckung vorab." },
  { q: "Was ist der Unterschied zu einer Wellnessmassage?", a: "Der Ausgangspunkt. Im Wellnessbereich steht Erholung im Vordergrund, die Behandlung läuft flächig und gleichmässig ab. Bei uns beginnt jede Sitzung mit einer kurzen Befunderhebung, danach wird gezielt an den Strukturen gearbeitet, die Beschwerden machen. Das kann phasenweise unangenehm sein und ist auf ein Ziel hin geplant statt auf ein Wohlgefühl im Moment." },
  { q: "Welche Massage hilft bei Verspannungen im Nacken?", a: "Meist eine Kombination: medizinische Massage, um die Muskulatur zu lösen, dazu Tuina an den Übergängen zu Schulter und Hinterkopf, bei sehr festem Gewebe zusätzlich Schröpfen oder Gua Sha. Was in deinem Fall passt, entscheiden wir nach dem Abtasten, nicht vorher am Telefon." },
  { q: "Wie lange dauert eine Sitzung und was kostet sie?", a: "Eine medizinische Massage oder eine Tuina-Behandlung dauert 45 bis 60 Minuten und kostet rund 130 bis 160 Franken. Kürzere, lokal begrenzte Behandlungen wie Schröpfen oder Gua Sha liegen bei 30 bis 40 Minuten und rund 90 bis 120 Franken. Abgerechnet wird nach Tarif 590 nach tatsächlicher Dauer, in Einheiten von fünf Minuten." },
  { q: "Bekomme ich kurzfristig einen Termin?", a: "Meist innert 24 bis 48 Stunden. Am schnellsten geht es per WhatsApp oder Telefon: Sag uns Wunschtag und Tageszeit, wir melden uns in der Regel innert 30 Minuten mit einem Vorschlag. Wenn es hier eng wird, prüfen wir auch die Termine an unseren übrigen Thurgauer Adressen." },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, url, inLanguage: 'de-CH',
    isPartOf: { '@type': 'WebSite', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'MedicalBusiness', name: 'TCM.ch Massage Kreuzlingen', url,
    address: { '@type': 'PostalAddress', streetAddress: 'Romanshornerstrasse 1', postalCode: '8280', addressLocality: 'Kreuzlingen', addressCountry: 'CH' },
    geo: { '@type': 'GeoCoordinates', latitude: 47.65, longitude: 9.175 },
    telephone: '+41775236122', openingHours: ['Mo-Fr 07:30-19:30', 'Sa 07:30-16:30'],
    areaServed: { '@type': 'City', name: 'Kreuzlingen' }, medicalSpecialty: 'PhysicalTherapy' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Massage', item: 'https://tcm.ch/therapien/massage/' },
    { '@type': 'ListItem', position: 3, name: 'Massage Kreuzlingen', item: url },
  ] },
];
---
<SpaPage title={title} description={description} path="/massage-kreuzlingen" body="" schema={schema}>
  <style set:html={css} is:inline></style>
  <Fragment set:html={heroPart} />
  <InsuranceBanner variant="inline" location="Kreuzlingen" />
  <Fragment set:html={restPart} />
  <MassageAnfrageForm anfrageTyp="massage" quelle="massage-kreuzlingen" />
  <WhatsAppContact name="Brenda" image="/images/brenda-portrait.webp" imageAlt="Brenda, Massage-Team TCM.ch" />
  <InsuranceBanner variant="sticky" />
</SpaPage>
