---
// /tools/bab-navigator/ — interaktiver BAB-Check (transactional/tool_use).
// Informational Owner «berufsausübungsbewilligung tcm» bleibt /regulatorik/berufsausuebungsbewilligung/.
import LayoutDe from '../../layouts/LayoutDe.astro';
import BabNavigator from '../../components/tools/BabNavigator.astro';
import { site } from '../../data/site';
import '../../styles/b2b.css';

const path = '/tools/bab-navigator';
const url = new URL(path + '/', site.url).href;
const title = 'BAB-Navigator TCM Schweiz | TCM.ch';
const description = 'Prüfe die Berufsausübungsbewilligung für TCM, Akupunktur und weitere Methoden nach Kanton und Qualifikation.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'TCM BAB-Navigator', url, description, inLanguage: 'de-CH',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://tcm.ch/tools/' },
    { '@type': 'ListItem', position: 3, name: 'BAB-Navigator', item: url } ] },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <div class="b2">
    <section class="b2-hero" style="padding-bottom:72px">
      <div class="b2-wrap">
        <div class="b2-crumbs" role="navigation" aria-label="Breadcrumb" style="max-width:820px;margin-left:auto;margin-right:auto"><a href="/">TCM.ch</a><span aria-hidden="true">/</span><a href="/tools/">Tools</a><span aria-hidden="true">/</span>BAB-Navigator</div>
        <p class="b2-label" style="max-width:820px;margin:0 auto 8px">BAB für deinen Kanton prüfen</p>
        <BabNavigator />
      </div>
    </section>
    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap b2-narrow">
        <div class="b2-body" style="margin-top:0">
          <h2 style="margin-top:0">Was ist eine Berufsausübungsbewilligung?</h2>
          <p>Die Berufsausübungsbewilligung (BAB) ist die kantonale Erlaubnis, eine bestimmte Tätigkeit im Gesundheitsbereich in eigener fachlicher Verantwortung auszuüben. Sie ist kein Diplom und keine Registrierung, sondern eine Entscheidung des Kantons.</p>
          <h2>Warum unterscheiden sich die Regeln nach Kanton?</h2>
          <p>Die Berufsausübung in der nichtärztlichen Komplementärmedizin regeln die Kantone selbst. Deshalb kann dieselbe Ausbildung in zwei Kantonen zu unterschiedlichen Schritten führen, und innerhalb eines Kantons kann zum Beispiel Akupunktur anders geregelt sein als Tuina.</p>
          <h2>BAB ist nicht dasselbe wie EMR oder ZSR</h2>
          <p>EMR ist ein privates Qualitätslabel, die ZSR-Nummer gehört zur Abrechnung. Beide ersetzen keine kantonale Bewilligung, und die Bewilligung ersetzt sie nicht.</p>
          <p>Mehr dazu: <a href="/regulatorik/berufsausuebungsbewilligung/">Berufsausübungsbewilligung</a> · <a href="/regulatorik/kantone/">Kanton-Navigator</a> · <a href="/regulatorik/emr/">EMR</a> · <a href="/regulatorik/zsr/">ZSR</a> · <a href="/tools/anerkennungs-navigator/">Anerkennungs-Navigator</a></p>
          <p class="b2-note">Der BAB-Navigator dient der Orientierung. Verbindlich sind die aktuellen Vorgaben der zuständigen kantonalen Behörden.</p>
        </div>
      </div>
    </section>
  </div>
</LayoutDe>
