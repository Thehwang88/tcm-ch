---
// /tools/anerkennungs-navigator/ — interaktiver Check (transactional/tool_use).
// Informational Owner für BAB, EMR, ASCA, ZSR usw. bleiben die /regulatorik/-Seiten.
import LayoutDe from '../../layouts/LayoutDe.astro';
import RecognitionNavigator from '../../components/tools/RecognitionNavigator.astro';
import { site } from '../../data/site';
import '../../styles/b2b.css';

const path = '/tools/anerkennungs-navigator';
const url = new URL(path + '/', site.url).href;
const title = 'TCM Anerkennungs-Navigator Schweiz | TCM.ch';
const description = 'Welche Anerkennungen brauchst du als TCM-Therapeut:in? Prüfe BAB, OdA AM, EMR, ASCA, ZSR, EGK, Visana und Tarif 590 Schritt für Schritt.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'TCM Anerkennungs-Navigator', url, description, inLanguage: 'de-CH',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Für Fachpersonen', item: 'https://tcm.ch/fachpersonen/' },
    { '@type': 'ListItem', position: 3, name: 'Anerkennungs-Navigator', item: url } ] },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <div class="b2">
    <section class="b2-hero" style="padding-bottom:72px">
      <div class="b2-wrap">
        <div class="b2-crumbs" role="navigation" aria-label="Breadcrumb" style="max-width:820px;margin-left:auto;margin-right:auto"><a href="/">TCM.ch</a><span aria-hidden="true">/</span><a href="/fachpersonen/">Für Fachpersonen</a><span aria-hidden="true">/</span>Anerkennungs-Navigator</div>
        <RecognitionNavigator />
      </div>
    </section>
    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap b2-narrow">
        <div class="b2-body" style="margin-top:0">
          <h2 style="margin-top:0">Was prüft der Anerkennungs-Navigator?</h2>
          <p>Er ordnet fünf Ebenen, die im Berufsalltag ständig durcheinandergeraten:</p>
          <ul>
            <li><strong>Berufsweg:</strong> Ausbildung, Zertifikat OdA AM, eidgenössisches Diplom oder ausländischer Abschluss.</li>
            <li><strong>Kanton:</strong> ob und wie deine Tätigkeit dort bewilligt werden muss.</li>
            <li><strong>Registrierungen:</strong> EMR und ASCA.</li>
            <li><strong>Versicherer:</strong> EGK und Visana mit eigenen Verfahren.</li>
            <li><strong>Abrechnung:</strong> ZSR-Nummer und Tarif 590.</li>
          </ul>
          <p>Deine Antworten bleiben in deinem Browser. Wir speichern und übertragen nichts.</p>
          <h2>Warum gibt es keine einzige Anerkennung für alles?</h2>
          <p>Weil verschiedene Stellen verschiedene Aufgaben haben. Die OdA AM regelt den Berufsweg bis zum eidgenössischen Diplom. Die Kantone regeln die Berufsausübung. EMR und ASCA vergeben Qualitätslabels, einzelne Versicherer haben eigene Verfahren, und die ZSR gehört zur Abrechnung. Keine dieser Ebenen ersetzt eine andere.</p>
          <p>Mehr dazu: <a href="/regulatorik/oda-am/">OdA AM</a> · <a href="/regulatorik/berufsausuebungsbewilligung/">Berufsausübungsbewilligung</a> · <a href="/regulatorik/emr/">EMR</a> · <a href="/regulatorik/asca/">ASCA</a> · <a href="/regulatorik/zsr/">ZSR</a> · <a href="/regulatorik/tarif-590/">Tarif 590</a></p>
          <p class="b2-note">Der Navigator dient der Orientierung. Verbindlich sind die aktuellen Vorgaben der zuständigen Behörden, Register und Versicherer.</p>
        </div>
      </div>
    </section>
  </div>
</LayoutDe>
