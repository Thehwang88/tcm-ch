---
// /tools/praxis-checkliste/ — personalisierte Praxis-Checkliste (transactional/tool_use).
// Informational Owner «Praxis eröffnen» bleibt /praxiswissen/tcm-praxis-eroeffnen/. Regulatorik nur über bestehende Tools.
import LayoutDe from '../../layouts/LayoutDe.astro';
import PracticeChecklist from '../../components/tools/PracticeChecklist.astro';
import { site } from '../../data/site';
import '../../styles/b2b.css';

const path = '/tools/praxis-checkliste';
const url = new URL(path + '/', site.url).href;
const title = 'TCM Praxis-Checkliste Schweiz | TCM.ch';
const description = 'Deine persönliche Checkliste für den Start einer TCM-Praxis: Berufsausübung, Anerkennung, Abrechnung, Praxisbetrieb und Patientengewinnung.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'TCM.ch Praxis-Checkliste', url, description, inLanguage: 'de-CH',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://tcm.ch/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Praxis-Checkliste', item: url } ] },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <div class="b2">
    <section class="b2-hero" style="padding-bottom:72px">
      <div class="b2-wrap">
        <div class="b2-crumbs" role="navigation" aria-label="Breadcrumb" style="max-width:820px;margin-left:auto;margin-right:auto"><a href="/">TCM.ch</a><span aria-hidden="true">/</span><a href="/tools/">Tools</a><span aria-hidden="true">/</span>Praxis-Checkliste</div>
        <p class="b2-label" style="max-width:820px;margin:0 auto 8px">Praxis-Checkliste</p>
        <PracticeChecklist />
      </div>
    </section>
    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap b2-narrow">
        <div class="b2-body" style="margin-top:0">
          <h2 style="margin-top:0">Was gehört zu einem Praxisstart?</h2>
          <p>Eine eigene Praxis braucht mehr als einen Raum und eine Behandlungsliege. Dazu gehören die kantonale Berufsausübung, Registrierungen für Versicherer, eine funktionierende Abrechnung, ein geordneter Praxisbetrieb mit Terminen, Dokumentation und Buchhaltung und schliesslich ein Weg, über den Patient:innen dich finden.</p>
          <h2>Warum hängt die Reihenfolge vom eigenen Berufsweg ab?</h2>
          <p>Wer noch in Ausbildung ist, braucht zuerst Klarheit über den Abschluss. Wer aus dem Ausland kommt, klärt zuerst die Einordnung. Wer bereits eine Praxis führt, braucht keine Gründungsschritte, sondern saubere Abläufe und Zahlen. Deshalb stellt die Checkliste die Punkte je nach Stand in eine andere Reihenfolge.</p>
          <p>Mehr dazu: <a href="/praxiswissen/tcm-praxis-eroeffnen/">Praxis eröffnen</a> · <a href="/praxiswissen/praxisrechner/">Praxisrechner</a> · <a href="/tools/bab-navigator/">BAB-Navigator</a> · <a href="/tools/anerkennungs-navigator/">Anerkennungs-Navigator</a></p>
          <p class="b2-note">Die Praxis-Checkliste dient der Orientierung und ist keine Rechts- oder Versicherungsberatung. Verbindlich sind die Vorgaben der zuständigen Behörden, Register und Versicherer.</p>
        </div>
      </div>
    </section>
  </div>
</LayoutDe>
