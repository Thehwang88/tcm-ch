---
// /tools/praxiswert-rechner/ — Praxiswert-Check (transactional/tool_use). Kein CHF-Wert, keine Multiples.
// Informational Owner «tcm praxis wert» bleibt /praxiswissen/tcm-praxis-wert/.
import LayoutDe from '../../layouts/LayoutDe.astro';
import PracticeValueCheck from '../../components/tools/PracticeValueCheck.astro';
import { site } from '../../data/site';
import '../../styles/b2b.css';

const path = '/tools/praxiswert-rechner';
const url = new URL(path + '/', site.url).href;
const title = 'Praxiswert-Check für TCM-Praxen | TCM.ch';
const description = 'Welche Faktoren bestimmen den Wert und die Übertragbarkeit einer TCM-Praxis? Prüfe Team, Nachfrage, Prozesse, Umsatzstabilität und Inhaberabhängigkeit.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'TCM.ch Praxiswert-Check', url, description, inLanguage: 'de-CH',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'TCM.ch', url: 'https://tcm.ch/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'TCM.ch', item: 'https://tcm.ch/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://tcm.ch/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Praxiswert-Check', item: url } ] },
];
---
<LayoutDe title={title} description={description} path={path} schema={schema}>
  <div class="b2">
    <section class="b2-hero" style="padding-bottom:72px">
      <div class="b2-wrap">
        <div class="b2-crumbs" role="navigation" aria-label="Breadcrumb" style="max-width:820px;margin-left:auto;margin-right:auto"><a href="/">TCM.ch</a><span aria-hidden="true">/</span><a href="/tools/">Tools</a><span aria-hidden="true">/</span>Praxiswert-Check</div>
        <p class="b2-label" style="max-width:820px;margin:0 auto 8px">Praxiswert-Check</p>
        <PracticeValueCheck />
      </div>
    </section>
    <section class="b2-sec b2-sec--soft">
      <div class="b2-wrap b2-narrow">
        <div class="b2-body" style="margin-top:0">
          <h2 style="margin-top:0">Was bestimmt den Wert einer TCM-Praxis?</h2>
          <p>Wer eine Praxis übernimmt, übernimmt vor allem ihre Zukunft: Patient:innen, die weiter kommen, ein Team, das weiter arbeitet, Abläufe, die funktionieren, und Räume, die bleiben. Je mehr davon auch ohne die bisherige Inhaberin oder den bisherigen Inhaber trägt, desto besser lässt sich eine Praxis übergeben.</p>
          <h2>Warum ist Umsatz allein nicht genug?</h2>
          <p>Eine Praxis kann hohen Umsatz haben und trotzdem schwer übertragbar sein, wenn:</p>
          <ul>
            <li>alles an einer Person hängt</li>
            <li>keine Prozesse dokumentiert sind</li>
            <li>die Nachfrage persönlich gebunden ist</li>
            <li>ein Team fehlt</li>
            <li>der Standort unsicher ist</li>
          </ul>
          <p><a href="/praxiswissen/tcm-praxis-wert/">Mehr über Praxiswert →</a></p>
          <p>Weiter: <a href="/praxiswissen/tcm-praxis-verkaufen/">Praxis verkaufen</a> · <a href="/praxiswissen/tcm-praxis-team-aufbauen/">Team aufbauen</a> · <a href="/praxiswissen/tcm-praxis-kennzahlen/">Kennzahlen</a> · <a href="/partner/praxisnachfolge/">Praxisnachfolge</a></p>
          <p class="b2-note">Der Praxiswert-Check dient der Orientierung. Er ersetzt keine Unternehmens-, Steuer- oder Transaktionsbewertung und stellt kein Kaufangebot dar.</p>
        </div>
      </div>
    </section>
  </div>
</LayoutDe>
