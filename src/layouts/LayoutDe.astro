---
// DE Astro layout for ported/standalone German pages (e.g. /ergebnisse/*).
// Mirrors the DE SPA header/footer style and the shared design tokens.
// lang="de-CH". noindex prop drives the robots meta for draft pages.
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  path: string;          // DE path, e.g. "/ergebnisse/"
  schema?: object;
  noindex?: boolean;
  turnstile?: boolean;   // load Cloudflare Turnstile (pages with a protected form)
}

const { title, description = '', path, schema, noindex = false, turnstile = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich suche eine TCM-Praxis.')}`;
const year = 2026;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site.ogImage} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap"
      rel="stylesheet"
    />

    {turnstile && (
      <>
        <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
      </>
    )}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body>
    <header class="site-nav">
      <div class="site-nav__in">
        <a class="logo" href="/" aria-label="TCM.ch Startseite">
          <div class="logo-text-group">
            <div class="logo-wm">TCM<span class="ch">.ch</span></div>
            <span class="logo-sub">Kliniken<svg viewBox="0 0 32 32" width="1.15em" height="1.15em" style="display:inline-block;vertical-align:middle;margin-left:3px" aria-hidden="true"><rect width="32" height="32" rx="4" fill="#DA291C"/><rect x="6" y="13" width="20" height="6" fill="#fff"/><rect x="13" y="6" width="6" height="20" fill="#fff"/></svg></span>
          </div>
        </a>
        <div class="site-nav__actions">
          <a class="nav-util" href="/zuweisen">Für Fachpersonen</a>
          <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener">Termin anfragen</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap site-foot__row">
        <div>
          <strong>TCM<span style="color:var(--blue)">.ch</span></strong> · Traditionelle Chinesische Medizin in der ganzen Schweiz.<br />
          EMR-/ASCA-anerkannte Therapeut:innen · 12 Kliniken.
        </div>
        <div>
          <a href="/ergebnisse/">Ergebnisse &amp; Transparenz</a> ·
          <a href="/wissen">Wissen</a> ·
          <a href="/krankenkassen/">Krankenkassen</a> ·
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
      <div class="wrap" style="margin-top:14px;font-size:13px;color:var(--muted)">© {year} TCM.ch</div>
    </footer>
  </body>
</html>

<style>
  /* Logo — copied 1:1 from the DE SPA / EN Header wordmark. */
  .logo { display: flex; align-items: flex-start; gap: 10px; text-decoration: none; cursor: pointer; }
  .logo-text-group { display: flex; flex-direction: column; gap: 4px; }
  .logo-wm { font-family: var(--font-accent); font-weight: 900; font-style: italic; font-size: 24px; letter-spacing: -.5px; color: var(--black); line-height: 1; display: flex; align-items: baseline; }
  .logo-wm .ch { font-size: 19px; }
  .logo-sub { font-family: var(--font-sans); font-size: 10px; font-weight: 400; letter-spacing: .06em; color: #666; line-height: 1; white-space: nowrap; text-transform: uppercase; }
  .site-nav__in { justify-content: space-between; }
  .site-nav__actions { margin-left: auto; display: flex; align-items: center; gap: 16px; }
  /* Secondary utility link (referrers / professionals) — not part of the patient nav. */
  .nav-util { font-size: 13.5px; font-weight: 600; color: var(--text-soft); text-decoration: none; white-space: nowrap; transition: color var(--t-fast) ease; }
  .nav-util:hover { color: var(--blue); }
  @media (max-width: 600px) { .nav-util { display: none; } }
  @media (max-width: 520px) {
    .logo-wm { font-size: 20px; }
    .logo-wm .ch { font-size: 15px; }
    .logo-sub { font-size: 9px; letter-spacing: .14em; }
  }
</style>
