---
// DE Astro layout for ported/standalone German pages (e.g. /ergebnisse/*).
// Mirrors the DE SPA header/footer style and the shared design tokens.
// lang="de-CH". noindex prop drives the robots meta for draft pages.
import '../styles/global.css';
import { site } from '../data/site';
import DeHeader from '../components/DeHeader.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  path: string;          // DE path, e.g. "/ergebnisse/"
  schema?: object;
  noindex?: boolean;
  turnstile?: boolean;   // load Cloudflare Turnstile (pages with a protected form)
}

const { title, description = '', path, schema, noindex = false, turnstile = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const year = 2026;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Shared design tokens — single source of truth (also loaded by the DE SPA). -->
    <link rel="stylesheet" href="/styles/tokens.css" />
    <!-- Shared DE header + footer styling (the rich SPA chrome), used on every DE page. -->
    <link rel="stylesheet" href="/header.css" />
    <link rel="stylesheet" href="/footer.css" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site.ogImage} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap"
      rel="stylesheet"
    />

    {turnstile && (
      <>
        <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
      </>
    )}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body>
    <DeHeader />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Shared DE header behaviour (nav routing + burger drawer), used on every DE page. -->
    <script src="/header.js" is:inline defer></script>
  </body>
</html>
