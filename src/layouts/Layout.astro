---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, PAIR_MAP_EN } from '../data/site';

interface Props {
  title: string;
  description?: string;
  path: string; // EN path, e.g. "/en/" or "/en/contact"
  schema?: object;
  noindex?: boolean;
}

const { title, description = '', path, schema, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// hreflang via the shared route-pair map. DE is x-default.
const dePath = PAIR_MAP_EN[path] ?? '/';
const deHref = new URL(dePath, site.url).href;
const enHref = canonical;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- hreflang (shared pair map; DE = x-default) -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="de-CH" href={deHref} />
    <link rel="alternate" hreflang="x-default" href={deHref} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site.ogImage} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Cloudflare Turnstile -->
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

    <!-- Fonts: Figtree + Nunito (brand) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap"
      rel="stylesheet"
    />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body>
    <Header currentPath={path} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
