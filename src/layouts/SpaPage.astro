---
// Reusable layout for faithful 1:1 reproductions of live SPA pages.
// Renders: shared DeHeader + the captured SPA page body (verbatim) + shared header.js/home.js.
// Full SPA CSS via /home.css; Turnstile env-gated. Used for the rich hub/leaf pages.
import DeHeader from '../components/DeHeader.astro';
import Footer from '../components/Footer.astro';
import HeadAnalytics from '../components/HeadAnalytics.astro';
import { SENSIBEL_REFERRER, SENSIBEL_CSP } from '../data/sensibel-head';
import { site, enTwinPath } from '../data/site';
import { upgradeLegacyForms, clinicById } from '../lib/kontakt-form';

interface Props {
  title: string;
  description: string;
  path: string;
  body: string;       // captured SPA page HTML (with __TURNSTILE_SITEKEY__ tokens)
  schema?: object;
  /** Optional per-page OG image (absolute URL); defaults to the site image. */
  ogImage?: string;
  noindex?: boolean;
  /**
   * Kanonische Ziel-URL, wenn diese Seite bewusst auf eine ANDERE Seite konsolidiert
   * (Duplikat-Auflösung, z. B. /beschwerden/schlafstoerungen/ -> /beschwerden/schlafprobleme/).
   * Ist sie gesetzt, entfällt hreflang: die Sprachpaarung gilt dann für die Zielseite.
   * Der Sitemap-Generator lässt solche Seiten automatisch weg (scripts/gen-sitemap.mjs).
   */
  canonicalTo?: string;
  /** Optionaler zweiter Body-Teil: der Slot «body-insert» rendert zwischen body und bodyAfter. */
  bodyAfter?: string;
  /** true = Seite zu einem sensiblen Thema (siehe LayoutDe): kein GTM, Referrer- und Script-Policy, kein
   *  Turnstile (diese Seiten haben kein Formular). Default false: Verhalten unverändert. */
  sensibel?: boolean;
}
const { title, description, path, body, schema, ogImage = site.ogImage, noindex = false, canonicalTo, bodyAfter, sensibel = false } = Astro.props;
const selfUrl = new URL(path.endsWith('/') ? path : path + '/', site.url).href;
const canonical = canonicalTo
  ? new URL(canonicalTo.endsWith('/') ? canonicalTo : canonicalTo + '/', site.url).href
  : selfUrl;
const enTwin = canonicalTo ? null : enTwinPath(path); // EN alternate (null if no built EN twin)

const _branch = (typeof process !== 'undefined' && process.env.CF_PAGES_BRANCH) || '';
const turnstileSitekey = _branch && _branch !== 'main' ? '1x00000000000000000000AA' : '0x4AAAAAADf8GZzWnvFzYvmx';
// Gemeinsames Kontaktformular (15.10.2026): allgemeine Legacy-Karten (Beschwerden, Therapien, Krankenkassen, Kosten-
// und Standort-Landingpages) werden beim Build ersetzt; Massage-Anfragen, Zürich-Funnel und Wartelisten bleiben.
// Standort-Landingpages /akupunktur-tcm-<id>/ erhalten den festen (operativen) Standort, /standorte/<id>/… die Vorauswahl.
const lp = path.match(/^\/akupunktur-tcm-([a-z-]+)\/?$/); const lc = lp ? clinicById(lp[1]) : undefined;
const sp = path.match(/^\/standorte\/([a-z-]+)\//);
const kfFixed = lc?.status === 'operational' ? lc.id : undefined;
const kfCtx = (prefix: string) => ({ path, standortId: kfFixed, instancePrefix: prefix, extra: !kfFixed && sp && clinicById(sp[1]) ? { preselectStandort: sp[1] } : {} });
const html = upgradeLegacyForms(body, kfCtx(kfFixed ? 'standort' : 'leaf')).replace(/__TURNSTILE_SITEKEY__/g, turnstileSitekey);
const htmlAfter = bodyAfter ? upgradeLegacyForms(bodyAfter, kfCtx('leaf-b')).replace(/__TURNSTILE_SITEKEY__/g, turnstileSitekey) : undefined;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {sensibel && <meta name="referrer" content={SENSIBEL_REFERRER} />}
    {sensibel && <meta http-equiv="Content-Security-Policy" content={SENSIBEL_CSP} />}
    <HeadAnalytics marketing={!sensibel} />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/ui.css" />
    <link rel="stylesheet" href="/home.css" />
    <link rel="stylesheet" href="/nav-rebrand.css" />
    <link rel="stylesheet" href="/footer-rebrand.css" />
    <script is:inline>document.documentElement.classList.add('js','ready');</script>
    <style is:inline>html:not(.ready){visibility:visible !important}html:not(.js) .reveal{opacity:1 !important;transform:none !important}
    /* restore the SPA #app{padding-top:68px} offset so full-bleed hub heroes clear the fixed 68px header */
    #page-beschwerden,#page-standorte,#page-therapien{padding-top:68px}
    /* leaf heroes (therapie + symptom) sit full-bleed at y=0 with padding-top:48 < the 68px fixed
       nav, so their breadcrumb was hidden behind it on mobile. Clear it so the crumb is fully
       visible; overflow-wrap guards a long crumb chain from exceeding the container. */
    @media (max-width:768px){
      #therapie-premium-hero.sg-active,#symptom-premium-hero.sg-active{padding-top:84px !important}
      #therapie-premium-hero .sg-crumb,#symptom-premium-hero .sg-crumb{overflow-wrap:anywhere}
    }</style>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {enTwin && <link rel="alternate" hreflang="de-CH" href={canonical} />}
    {enTwin && <link rel="alternate" hreflang="en" href={new URL(enTwin, site.url).href} />}
    {enTwin && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {ogImage === site.ogImage && (<Fragment>
      <meta property="og:image:width" content={site.ogImageWidth} />
      <meta property="og:image:height" content={site.ogImageHeight} />
      <meta property="og:image:type" content={site.ogImageType} />
      <meta property="og:image:alt" content={site.ogImageAlt} />
      <meta name="twitter:image:alt" content={site.ogImageAlt} />
    </Fragment>)}
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap" rel="stylesheet" />
    {!sensibel && <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />}
    {!sensibel && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body>
    <DeHeader />
    <slot />
    <Fragment set:html={html} /><slot name="body-insert" />{htmlAfter && <Fragment set:html={htmlAfter} />}
    <Footer />
    <script src="/header.js" is:inline defer></script>
    <script src="/home.js" is:inline defer></script>
  </body>
</html>
