---
// Minimal shell for the private partner presentations (/partner/[city]/).
// Deliberately no public site nav/footer: this is an unlisted, noindex presentation.
// Shares the brand tokens + fonts with every other Astro page.
import '../styles/partner.css';

interface Props {
  title: string;
  description?: string;
  chapters: { id: string; label: string }[];
}
const { title, description = '', chapters } = Astro.props;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>document.documentElement.classList.add('pp-js')</script>
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Nunito:ital,wght@1,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="pp">
    <a class="pp-skip" href="#kapitel-1">Zum Inhalt</a>
    <header class="pp-bar">
      <div class="pp-bar__in">
        <a class="pp-logo" href="#kapitel-1" aria-label="TCM.ch – zum Anfang">
          <img src="/images/logo/tcm-kliniken-logo-wordmark.svg" alt="TCM.ch" width="82" height="40" />
        </a>
        <nav class="pp-progress" aria-label="Fortschritt" data-names={JSON.stringify(chapters.map((c) => c.label))}>
          <b data-chapter-num>01</b>
          <span class="pp-progress__track" aria-hidden="true"><span data-progress-fill></span></span>
          <span class="pp-progress__total">{String(chapters.length).padStart(2, '0')}</span>
          <span class="pp-progress__label" data-chapter-name aria-live="polite">{chapters[0].label}</span>
        </nav>
        <div class="pp-mode" role="group" aria-label="Modus">
          <button type="button" data-mode="praesentation" aria-pressed="false">Präsentation</button>
          <button type="button" data-mode="entdecken" aria-pressed="true">Entdecken</button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <button type="button" class="pp-next" data-next hidden aria-label="Nächstes Kapitel">Weiter <span aria-hidden="true">↓</span></button>
  </body>
</html>
