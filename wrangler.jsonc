{
  // tcm-ch-2 Worker: serves the static Astro build (dist/) AND runs the Pages
  // Functions in functions/ (compiled to worker/ at build time). run_worker_first
  // replicates Pages routing (middleware + functions run before static assets).
  "name": "tcm-ch-2",
  "compatibility_date": "2026-06-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
